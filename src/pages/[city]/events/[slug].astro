---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const events = await getCollection("events");
  return events.map(e => {
    const city = e.data.city ?? e.slug.split("/")[0];
    const slug = e.slug.split("/").pop();
    return { params: { city, slug }, props: { event: e } };
  });
}

const { event } = Astro.props;
const { data } = event;
const city = data.city ?? event.slug.split("/")[0];
const cityCap = city.charAt(0).toUpperCase() + city.slice(1);

const d = new Date(data.eventDate);
const dateLabel = d.toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric" });

let endLabel = "";
if (data.endDate) {
  const end = new Date(data.endDate);
  if (end.toDateString() !== d.toDateString()) {
    endLabel = end.toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric" });
  }
}

const { Content } = await event.render();

function addUtm(url) {
  if (!url) return url;
  try {
    const u = new URL(url);
    u.searchParams.set("utm_source", "gododaytona");
    return u.toString();
  } catch {
    const sep = url.includes("?") ? "&" : "?";
    return `${url}${sep}utm_source=gododaytona`;
  }
}

/* ── Related events: same category or same city, upcoming, ≤4 ── */
const today = new Date();
today.setHours(0, 0, 0, 0);

let allEvents = [];
try { allEvents = await getCollection("events"); } catch { allEvents = []; }

const relatedEvents = allEvents
  .filter(e => {
    const eDate = new Date(e.data.eventDate);
    eDate.setHours(0, 0, 0, 0);
    return (
      e.slug !== event.slug &&
      eDate >= today &&
      (e.data.category === data.category ||
        (e.data.city ?? e.slug.split("/")[0]).toLowerCase() === city.toLowerCase())
    );
  })
  .sort((a, b) => new Date(a.data.eventDate).getTime() - new Date(b.data.eventDate).getTime())
  .slice(0, 4);

/* ── Related guides for this city ── */
let allGuides = [];
try { allGuides = await getCollection("guides"); } catch { allGuides = []; }
const relatedGuides = allGuides
  .filter(g => g.data.city?.toLowerCase() === city.toLowerCase())
  .slice(0, 3);
---

<Base title={data.title} subtitle={data.description ?? `${data.title} — GoDo ${cityCap}`} cityBase={city}>

  {/* ── HERO IMAGE ── */}
  {data.image && (
    <div class="evHero">
      <img class="evHeroImg" src={data.image} alt={data.title} loading="eager" decoding="async" />
      <div class="evHeroGrad" aria-hidden="true"></div>
      {data.category && <span class="evHeroCat">{data.category}</span>}
    </div>
  )}

  <section class="section">
    <div class="container">
      <div class="evLayout">

        {/* ── MAIN COLUMN ── */}
        <div class="evMain">

          <div class="eventDetail">
            <div class="eventHeader">
              {!data.image && data.category && <span class="catPill">{data.category}</span>}
              <h1 class="eventTitle">{data.title}</h1>
              {data.description && <p class="eventDesc">{data.description}</p>}
            </div>

            <div class="eventMeta">
              <div class="metaRow">
                <span class="metaIcon">📅</span>
                <span>{dateLabel}{endLabel ? ` – ${endLabel}` : ""}</span>
              </div>
              <div class="metaRow">
                <span class="metaIcon">📍</span>
                <span>{data.location}{data.address ? `, ${data.address}` : ""}</span>
              </div>
              {data.url && (
                <div class="metaRow">
                  <span class="metaIcon">🔗</span>
                  <a class="metaLink" href={addUtm(data.url)} target="_blank" rel="noopener noreferrer">
                    More info ↗
                  </a>
                </div>
              )}
              {data.url && (
                <div class="metaCtaRow">
                  <a class="metaCtaBtn" href={addUtm(data.url)} target="_blank" rel="noopener noreferrer">
                    Get Tickets / Learn More ↗
                  </a>
                </div>
              )}
            </div>

            <article class="eventBody">
              <Content />
            </article>

            <p class="backLink">
              <a class="pill" href={`/${city}/events/`}>← All {cityCap} events</a>
            </p>
          </div>

        </div>

        {/* ── SIDEBAR ── */}
        <aside class="evSidebar">

          {/* Related guides */}
          {relatedGuides.length > 0 && (
            <div class="sideBlock">
              <div class="sideHead">{cityCap} Guides</div>
              {relatedGuides.map(g => {
                const gSlug = g.slug.split("/").pop();
                return (
                  <a class="sideGuideLink" href={`/${city}/guides/${gSlug}/`}>
                    <span class="sideGuideTitle">{g.data.title}</span>
                    <span class="sideGuideArrow">→</span>
                  </a>
                );
              })}
              <a class="sideMore" href={`/${city}/events/`}>All events →</a>
            </div>
          )}

          {/* Newsletter */}
          <div class="sideNl">
            <div class="sideNlHead"><em>Good News <strong>{cityCap}!</strong></em></div>
            <div class="sideNlSub">Local events and stories, free every morning.</div>
            <form class="sideNlForm" action={`/${city}/subscribe/`} method="get">
              <input class="sideNlInput" type="email" name="email"
                placeholder="your@email.com" required autocomplete="email" />
              <button class="sideNlBtn" type="submit">SIGN UP</button>
            </form>
          </div>

        </aside>

      </div>

      {/* ── MORE LIKE THIS ── */}
      {relatedEvents.length > 0 && (
        <section class="relatedSection" aria-label="More events">
          <div class="relatedHead">
            <span class="relatedLabel">More Events You Might Like</span>
            <a class="relatedAll" href={`/${city}/events/`}>See all →</a>
          </div>
          <div class="relatedGrid">
            {relatedEvents.map(e => {
              const ed = new Date(e.data.eventDate);
              const mon = ed.toLocaleDateString("en-US", { month: "short" }).toUpperCase();
              const day = ed.getDate();
              const dow = ed.toLocaleDateString("en-US", { weekday: "short" }).toUpperCase();
              const eCity = (e.data.city ?? e.slug.split("/")[0]).toLowerCase().trim();
              const eSlug = e.slug.split("/").pop();
              const href = e.data.url ? addUtm(e.data.url) : `/${eCity}/events/${eSlug}/`;
              return (
                <a class="relCard" href={href}
                   target={e.data.url ? "_blank" : "_self"}
                   rel={e.data.url ? "noopener noreferrer" : ""}>
                  <div class="relCardImg">
                    {e.data.image
                      ? <img src={e.data.image} alt={e.data.title} loading="lazy" decoding="async" />
                      : <div class="relCardPlaceholder" aria-hidden="true">📅</div>
                    }
                    {e.data.category && <span class="relCardCat">{e.data.category}</span>}
                  </div>
                  <div class="relCardBody">
                    <div class="relCardDate">
                      <span class="relDow">{dow}</span>
                      <span class="relDay">{mon} {day}</span>
                    </div>
                    <div class="relCardTitle">{e.data.title}</div>
                    {e.data.location && <div class="relCardVenue">{e.data.location}</div>}
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )}

    </div>
  </section>
</Base>

<style>
  /* ── Hero Image ── */
  .evHero {
    position: relative;
    width: 100%;
    max-height: 480px;
    overflow: hidden;
    background: rgba(0,0,0,.8);
  }
  .evHeroImg {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    display: block;
  }
  .evHeroGrad {
    position: absolute;
    inset: auto 0 0 0;
    height: 60%;
    background: linear-gradient(to top, rgba(0,0,0,.7), transparent);
    pointer-events: none;
  }
  .evHeroCat {
    position: absolute;
    bottom: 20px;
    left: 20px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
    background: var(--brand1);
    color: #000;
    padding: 4px 12px;
    border-radius: 999px;
  }

  /* ── Layout: 70/30 ── */
  .evLayout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 48px;
    align-items: start;
    padding: 32px 0 48px;
  }
  @media (max-width: 860px) {
    .evLayout { grid-template-columns: 1fr; gap: 32px; }
  }

  /* ── Detail ── */
  .eventDetail { max-width: 680px; }
  .catPill {
    display: inline-block;
    font-size: 11px; font-weight: 800;
    padding: 3px 10px; border-radius: 999px;
    background: rgba(255,212,74,.12); color: var(--accent);
    margin-bottom: 10px;
    text-transform: uppercase; letter-spacing: .06em;
  }
  .eventTitle {
    font-size: clamp(24px, 3vw, 40px);
    font-weight: 900; line-height: 1.1; margin: 0 0 10px;
  }
  .eventDesc {
    font-size: 17px; color: var(--muted); margin: 0 0 24px; line-height: 1.5;
  }
  .eventMeta {
    display: flex; flex-direction: column; gap: 10px;
    margin-bottom: 28px; padding: 18px 20px;
    border-radius: 14px; border: 1px solid rgba(255,255,255,.08);
    background: rgba(255,255,255,.03);
  }
  .metaRow {
    display: flex; align-items: baseline; gap: 10px;
    font-size: 15px; color: var(--text);
  }
  .metaIcon { font-size: 16px; flex-shrink: 0; }
  .metaLink { color: var(--link); text-decoration: none; font-weight: 700; }
  .metaLink:hover { text-decoration: underline; }
  .metaCtaRow { margin-top: 6px; }
  .metaCtaBtn {
    display: inline-flex; align-items: center;
    height: 44px; padding: 0 22px; border-radius: 999px;
    background: var(--brand1); color: #000;
    font-size: 14px; font-weight: 800; text-decoration: none;
    transition: opacity 140ms;
  }
  .metaCtaBtn:hover { opacity: .84; }

  .eventBody {
    line-height: 1.65; font-size: 16px; margin-bottom: 28px;
  }
  .eventBody :global(p)  { margin: 0 0 1em; }
  .eventBody :global(a)  { color: var(--link); }
  .eventBody :global(strong) { font-weight: 700; }

  .backLink { margin-top: 8px; }
  .pill {
    display: inline-flex; align-items: center;
    height: 34px; padding: 0 14px; border-radius: 999px;
    border: 1px solid rgba(255,255,255,.12);
    color: var(--text); font-size: 13px; font-weight: 700;
    text-decoration: none; transition: border-color 140ms;
  }
  .pill:hover { border-color: var(--brand1); color: var(--brand1); }

  /* ── Sidebar ── */
  .evSidebar { display: grid; gap: 24px; position: sticky; top: 80px; align-self: start; }

  .sideBlock {
    border-radius: 14px; border: 1px solid rgba(255,255,255,.08);
    background: rgba(255,255,255,.02); padding: 20px;
    display: grid; gap: 0;
  }
  .sideHead {
    font-size: 11px; font-weight: 900; letter-spacing: .1em;
    text-transform: uppercase; color: var(--brand1);
    padding-bottom: 10px; margin-bottom: 4px;
    border-bottom: 2px solid var(--brand1);
  }
  .sideGuideLink {
    display: flex; justify-content: space-between; align-items: center;
    padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,.06);
    text-decoration: none; transition: color 120ms;
  }
  .sideGuideLink:last-of-type { border-bottom: none; }
  .sideGuideLink:hover .sideGuideTitle { color: var(--link); }
  .sideGuideTitle { font-size: 14px; font-weight: 700; color: var(--text); }
  .sideGuideArrow { font-size: 14px; color: var(--brand1); flex-shrink: 0; }
  .sideMore {
    display: inline-block; margin-top: 12px;
    font-size: 13px; font-weight: 700; color: var(--link);
    text-decoration: none;
  }
  .sideMore:hover { text-decoration: underline; }

  .sideNl {
    padding: 28px 22px; border-radius: 16px; background: var(--brand1);
    display: flex; flex-direction: column; gap: 10px;
  }
  .sideNlHead { font-size: 22px; font-weight: 900; font-style: italic; color: #000; line-height: 1.1; }
  .sideNlHead strong { font-weight: 900; }
  .sideNlSub  { font-size: 14px; color: rgba(0,0,0,.75); line-height: 1.4; }
  .sideNlForm { display: flex; flex-direction: column; gap: 8px; margin-top: 4px; }
  .sideNlInput {
    width: 100%; box-sizing: border-box;
    padding: 12px 14px; border-radius: 10px;
    border: none; background: #fff;
    font-size: 14px; color: #111;
    outline: 2px solid transparent; transition: outline-color 150ms;
  }
  .sideNlInput:focus { outline-color: #000; }
  .sideNlBtn {
    width: 100%; padding: 12px 0; border-radius: 999px;
    border: none; background: #000; color: #f9d900;
    font-size: 14px; font-weight: 900; letter-spacing: .08em;
    cursor: pointer; transition: opacity 150ms; font-family: inherit;
  }
  .sideNlBtn:hover { opacity: .82; }

  /* ── More Like This / Related ── */
  .relatedSection {
    padding: 40px 0 56px;
    border-top: 2px solid var(--brand1);
    margin-top: 0;
  }
  .relatedHead {
    display: flex; align-items: baseline; justify-content: space-between;
    margin-bottom: 20px;
  }
  .relatedLabel { font-size: 18px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; color: var(--text); }
  .relatedAll   { font-size: 13px; font-weight: 700; color: var(--link); text-decoration: none; }
  .relatedAll:hover { text-decoration: underline; }

  .relatedGrid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  @media (max-width: 860px)  { .relatedGrid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px)  { .relatedGrid { grid-template-columns: 1fr; } }

  .relCard {
    border-radius: 12px; overflow: hidden;
    border: 1px solid rgba(255,255,255,.07);
    background: rgba(255,255,255,.02);
    text-decoration: none;
    transition: border-color 140ms, transform 140ms;
    display: flex; flex-direction: column;
  }
  .relCard:hover { border-color: var(--brand1); transform: translateY(-2px); }

  .relCardImg {
    position: relative; height: 130px;
    background: rgba(255,255,255,.04); overflow: hidden; flex-shrink: 0;
  }
  .relCardImg img { width: 100%; height: 100%; object-fit: cover; }
  .relCardPlaceholder {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center; font-size: 32px;
  }
  .relCardCat {
    position: absolute; bottom: 6px; left: 6px;
    font-size: 9px; font-weight: 800; letter-spacing: .05em;
    background: rgba(0,0,0,.65); color: var(--brand1);
    padding: 2px 7px; border-radius: 999px;
    backdrop-filter: blur(4px);
  }

  .relCardBody { padding: 10px 12px 12px; flex: 1; display: flex; flex-direction: column; gap: 3px; }
  .relCardDate { display: flex; align-items: center; gap: 5px; }
  .relDow { font-size: 9px; font-weight: 900; color: var(--brand1); text-transform: uppercase; letter-spacing: .06em; }
  .relDay { font-size: 11px; font-weight: 700; color: var(--muted); }
  .relCardTitle { font-size: 13px; font-weight: 800; color: var(--text); line-height: 1.3; }
  .relCardVenue { font-size: 11px; color: var(--faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>
