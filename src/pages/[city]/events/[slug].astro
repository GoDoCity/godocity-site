---
import Base from "../../../layouts/Base.astro";
import InteractiveMap from "../../../components/InteractiveMap.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const events = await getCollection("events");
  return events.map(e => {
    const city = e.data.city ?? e.slug.split("/")[0];
    const slug = e.slug.split("/").pop();
    return { params: { city, slug }, props: { event: e } };
  });
}

const { event } = Astro.props;
const { data } = event;
const city = data.city ?? event.slug.split("/")[0];
const cityCap = city.charAt(0).toUpperCase() + city.slice(1);

/* ── Date labels ── */
const d = new Date(data.eventDate);
const dateLabel = d.toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric" });

let endLabel = "";
if (data.endDate) {
  const end = new Date(data.endDate);
  if (end.toDateString() !== d.toDateString()) {
    endLabel = end.toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric" });
  }
}

const { Content } = await event.render();

function addUtm(url) {
  if (!url) return url;
  try {
    const u = new URL(url);
    u.searchParams.set("utm_source", "gododaytona");
    return u.toString();
  } catch {
    const sep = url.includes("?") ? "&" : "?";
    return `${url}${sep}utm_source=gododaytona`;
  }
}

/* ── Google Calendar link ── */
function gcalDate(dt) {
  const pad = (n) => String(n).padStart(2, "0");
  return `${dt.getFullYear()}${pad(dt.getMonth() + 1)}${pad(dt.getDate())}`;
}
const gcalStart = gcalDate(d);
const gcalEnd   = data.endDate ? gcalDate(new Date(data.endDate)) : gcalDate(d);
const gcalUrl   = `https://calendar.google.com/calendar/render?action=TEMPLATE`
  + `&text=${encodeURIComponent(data.title)}`
  + `&dates=${gcalStart}/${gcalEnd}`
  + `&details=${encodeURIComponent(data.description ?? "")}`
  + `&location=${encodeURIComponent((data.location ?? "") + (data.address ? ", " + data.address : ""))}`;

/* ── iCal data URI ── */
function pad(n) { return String(n).padStart(2, "0"); }
function icsDate(dt) {
  return `${dt.getFullYear()}${pad(dt.getMonth() + 1)}${pad(dt.getDate())}`;
}
const icsContent = [
  "BEGIN:VCALENDAR",
  "VERSION:2.0",
  "PRODID:-//GoDoDaytona//EN",
  "BEGIN:VEVENT",
  `DTSTART;VALUE=DATE:${icsDate(d)}`,
  `DTEND;VALUE=DATE:${data.endDate ? icsDate(new Date(data.endDate)) : icsDate(d)}`,
  `SUMMARY:${data.title}`,
  `DESCRIPTION:${(data.description ?? "").replace(/\n/g, "\\n")}`,
  `LOCATION:${(data.location ?? "") + (data.address ? ", " + data.address : "")}`,
  data.url ? `URL:${data.url}` : "",
  "END:VEVENT",
  "END:VCALENDAR",
].filter(Boolean).join("\r\n");
const icsUri = `data:text/calendar;charset=utf-8,${encodeURIComponent(icsContent)}`;

/* ── Venue map pin ── */
const CITY_CENTERS = {
  "daytona":              { lat: 29.2108, lng: -81.0228 },
  "daytona beach":        { lat: 29.2108, lng: -81.0228 },
  "ormond beach":         { lat: 29.2866, lng: -81.0559 },
  "port orange":          { lat: 29.1380, lng: -81.0045 },
  "daytona beach shores": { lat: 29.1994, lng: -80.9969 },
  "south daytona":        { lat: 29.1680, lng: -81.0027 },
  "holly hill":           { lat: 29.2497, lng: -81.0370 },
  "new smyrna beach":     { lat: 29.0258, lng: -80.9270 },
  "flagler beach":        { lat: 29.4730, lng: -81.1267 },
};
const cityKey = city.toLowerCase().trim();
const center  = CITY_CENTERS[cityKey] ?? { lat: 29.2108, lng: -81.0228 };
const pinLat  = data.lat ?? center.lat;
const pinLng  = data.lng ?? center.lng;
const mapPin  = [{ label: data.title, address: data.location + (data.address ? `, ${data.address}` : ""), lat: pinLat, lng: pinLng }];

/* ── Related events ── */
const today = new Date();
today.setHours(0, 0, 0, 0);

let allEvents = [];
try { allEvents = await getCollection("events"); } catch { allEvents = []; }

const relatedEvents = allEvents
  .filter(e => {
    const eDate = new Date(e.data.eventDate);
    eDate.setHours(0, 0, 0, 0);
    return (
      e.slug !== event.slug &&
      eDate >= today &&
      (e.data.category === data.category ||
        (e.data.city ?? e.slug.split("/")[0]).toLowerCase() === city.toLowerCase())
    );
  })
  .sort((a, b) => new Date(a.data.eventDate).getTime() - new Date(b.data.eventDate).getTime())
  .slice(0, 4);

/* ── Related guides ── */
let allGuides = [];
try { allGuides = await getCollection("cityGuides"); } catch { allGuides = []; }
const relatedGuides = allGuides
  .filter(g => g.data.city?.toLowerCase() === city.toLowerCase())
  .slice(0, 3);

/* ── Page URL for sharing ── */
const pageUrl = Astro.url.href;
---

<Base title={data.title} cityBase={city}>

  {/* ── HERO IMAGE ── */}
  {data.image && (
    <div class="evHero">
      <img class="evHeroImg" src={data.image} alt={data.title} loading="eager" decoding="async" />
      <div class="evHeroGrad" aria-hidden="true"></div>
      {data.category && <span class="evHeroCat">{data.category}</span>}
    </div>
  )}

  <section class="section">
    <div class="container">
      <div class="evLayout">

        {/* ── MAIN COLUMN ── */}
        <div class="evMain">

          <div class="eventDetail">

            {/* Header */}
            <div class="eventHeader">
              {!data.image && data.category && <span class="catPill">{data.category}</span>}
              <h1 class="eventTitle">{data.title}</h1>
              {data.description && <p class="eventDesc">{data.description}</p>}
            </div>

            {/* Meta block */}
            <div class="eventMeta">
              <div class="metaRow">
                <span class="metaIcon">📅</span>
                <span>{dateLabel}{endLabel ? ` – ${endLabel}` : ""}</span>
              </div>
              <div class="metaRow">
                <span class="metaIcon">📍</span>
                <span>{data.location}{data.address ? `, ${data.address}` : ""}</span>
              </div>
              {data.url && (
                <div class="metaRow">
                  <span class="metaIcon">🔗</span>
                  <a class="metaLink" href={addUtm(data.url)} target="_blank" rel="noopener noreferrer">
                    Visit event website ↗
                  </a>
                </div>
              )}
            </div>

            {/* ── ACTION ROW — Ticket, Calendar, Share ── */}
            <div class="actionRow">
              {data.url && (
                <a class="actionTicket" href={addUtm(data.url)} target="_blank" rel="noopener noreferrer">
                  Get Tickets / More Info ↗
                </a>
              )}
              <div class="actionSecondary">
                {/* Add to Calendar dropdown */}
                <div class="calDrop" id="calDrop">
                  <button class="actionBtn calTrigger" type="button" id="calTrigger" aria-expanded="false" aria-haspopup="true">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="1" y="3" width="14" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M5 1v3M11 1v3M1 7h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    Add to Calendar
                  </button>
                  <div class="calMenu" id="calMenu" role="menu" aria-label="Add to calendar options">
                    <a class="calOption" href={gcalUrl} target="_blank" rel="noopener noreferrer" role="menuitem">
                      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="1" y="3" width="14" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M5 1v3M11 1v3M1 7h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                      Google Calendar
                    </a>
                    <a class="calOption" href={icsUri} download={`${data.title.replace(/[^a-z0-9]/gi, "-")}.ics`} role="menuitem">
                      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="1" y="3" width="14" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M5 1v3M11 1v3M1 7h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                      Apple / Outlook (.ics)
                    </a>
                  </div>
                </div>

                {/* Share Event */}
                <button class="actionBtn" type="button" id="shareBtn"
                        data-title={data.title} data-url={pageUrl}>
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="13" cy="3" r="2" stroke="currentColor" stroke-width="1.5"/><circle cx="3" cy="8" r="2" stroke="currentColor" stroke-width="1.5"/><circle cx="13" cy="13" r="2" stroke="currentColor" stroke-width="1.5"/><path d="M5 7l6-3M5 9l6 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                  Share Event
                </button>
              </div>
            </div>

            {/* ── VENUE MAP — compact inline Leaflet map ── */}
            <div class="venueMapBlock">
              <InteractiveMap locations={mapPin} height="220px" />
            </div>

            {/* Body content */}
            <article class="eventBody">
              <Content />
            </article>

            <p class="backLink">
              <a class="pill" href={`/${city}/events/`}>← All {cityCap} events</a>
            </p>

          </div>
        </div>

        {/* ── SIDEBAR ── */}
        <aside class="evSidebar">
          {relatedGuides.length > 0 && (
            <div class="sideBlock">
              <div class="sideHead">{cityCap} Guides</div>
              {relatedGuides.map(g => {
                const gSlug = g.slug.split("/").pop();
                return (
                  <a class="sideGuideLink" href={`/${city}/guides/${gSlug}/`}>
                    <span class="sideGuideTitle">{g.data.title}</span>
                    <span class="sideGuideArrow">→</span>
                  </a>
                );
              })}
              <a class="sideMore" href={`/${city}/guides/`}>All guides →</a>
            </div>
          )}

          <div class="sideNl">
            <div class="sideNlHead"><em>Good News <strong>{cityCap}!</strong></em></div>
            <div class="sideNlSub">Join GoDo{cityCap} for the daily brief on local news, fresh openings, and must-see events.</div>
            <form class="sideNlForm" action={`/${city}/subscribe/`} method="get">
              <input class="sideNlInput" type="email" name="email"
                placeholder="your@email.com" required autocomplete="email" />
              <button class="sideNlBtn" type="submit">SIGN UP</button>
            </form>
          </div>
        </aside>

      </div>

      {/* ── MORE LIKE THIS ── */}
      {relatedEvents.length > 0 && (
        <section class="relatedSection" aria-label="More events">
          <div class="relatedHead">
            <span class="relatedLabel">More Events You Might Like</span>
            <a class="relatedAll" href={`/${city}/events/`}>See all →</a>
          </div>
          <div class="relatedGrid">
            {relatedEvents.map(e => {
              const ed  = new Date(e.data.eventDate);
              const mon = ed.toLocaleDateString("en-US", { month: "short" }).toUpperCase();
              const day = ed.getDate();
              const dow = ed.toLocaleDateString("en-US", { weekday: "short" }).toUpperCase();
              const eCity = (e.data.city ?? e.slug.split("/")[0]).toLowerCase().trim();
              const eSlug = e.slug.split("/").pop();
              const href = e.data.url
                ? addUtm(e.data.url)
                : `/${eCity}/events/${eSlug}/`;
              return (
                <a class="relCard" href={href}
                   target={e.data.url ? "_blank" : "_self"}
                   rel={e.data.url ? "noopener noreferrer" : ""}>
                  <div class="relCardImg">
                    {e.data.image
                      ? <img src={e.data.image} alt={e.data.title} loading="lazy" decoding="async" />
                      : <div class="relCardPlaceholder" aria-hidden="true">📅</div>
                    }
                    {e.data.category && <span class="relCardCat">{e.data.category}</span>}
                  </div>
                  <div class="relCardBody">
                    <div class="relCardDate">
                      <span class="relDow">{dow}</span>
                      <span class="relDay">{mon} {day}</span>
                    </div>
                    <div class="relCardTitle">{e.data.title}</div>
                    {e.data.location && <div class="relCardVenue">{e.data.location}</div>}
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )}

    </div>
  </section>
</Base>

<script is:inline>
(function () {
  /* ── Add to Calendar dropdown ── */
  var trigger = document.getElementById("calTrigger");
  var menu    = document.getElementById("calMenu");
  if (trigger && menu) {
    trigger.addEventListener("click", function () {
      var open = menu.classList.toggle("calMenu--open");
      trigger.setAttribute("aria-expanded", open ? "true" : "false");
    });
    document.addEventListener("click", function (e) {
      if (!document.getElementById("calDrop").contains(e.target)) {
        menu.classList.remove("calMenu--open");
        trigger.setAttribute("aria-expanded", "false");
      }
    });
  }

  /* ── Share Event ── */
  var shareBtn = document.getElementById("shareBtn");
  if (shareBtn) {
    shareBtn.addEventListener("click", function () {
      var title = shareBtn.getAttribute("data-title");
      var url   = shareBtn.getAttribute("data-url") || window.location.href;
      if (navigator.share) {
        navigator.share({ title: title, url: url }).catch(function () {});
      } else {
        navigator.clipboard.writeText(url).then(function () {
          var orig = shareBtn.innerHTML;
          shareBtn.textContent = "✓ Link copied!";
          setTimeout(function () { shareBtn.innerHTML = orig; }, 2200);
        }).catch(function () {
          /* clipboard not available — silently do nothing */
        });
      }
    });
  }
})();
</script>

<style>
  /* ── Hero Image ── */
  .evHero {
    position: relative; width: 100%; max-height: 480px;
    overflow: hidden; background: rgba(0,0,0,.8);
  }
  .evHeroImg { width: 100%; max-height: 480px; object-fit: cover; display: block; }
  .evHeroGrad {
    position: absolute; inset: auto 0 0 0; height: 60%;
    background: linear-gradient(to top, rgba(0,0,0,.7), transparent);
    pointer-events: none;
  }
  .evHeroCat {
    position: absolute; bottom: 20px; left: 20px;
    font-size: 11px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
    background: var(--brand1); color: #fff;
    padding: 4px 12px; border-radius: 999px;
  }

  /* ── 70/30 Layout ── */
  .evLayout {
    display: grid; grid-template-columns: minmax(0, 1fr) 280px;
    gap: 48px; align-items: start; padding: 32px 0 48px;
  }
  @media (max-width: 860px) { .evLayout { grid-template-columns: 1fr; gap: 32px; } }

  /* ── Detail ── */
  .eventDetail { max-width: 680px; }
  .catPill {
    display: inline-block; font-size: 11px; font-weight: 800;
    padding: 3px 10px; border-radius: 999px;
    background: rgba(0,0,0,.05); color: var(--text);
    margin-bottom: 10px; text-transform: uppercase; letter-spacing: .06em;
  }
  .eventTitle { font-size: clamp(24px, 3vw, 40px); font-weight: 900; line-height: 1.1; margin: 0 0 10px; }
  .eventDesc  { font-size: 17px; color: var(--muted); margin: 0 0 24px; line-height: 1.5; }

  .eventMeta {
    display: flex; flex-direction: column; gap: 10px;
    margin-bottom: 20px; padding: 16px 18px;
    border-radius: 14px; border: 1px solid rgba(255,255,255,.08);
    background: rgba(255,255,255,.03);
  }
  .metaRow { display: flex; align-items: baseline; gap: 10px; font-size: 15px; color: var(--text); }
  .metaIcon { font-size: 15px; flex-shrink: 0; }
  .metaLink { color: var(--link); text-decoration: none; font-weight: 700; }
  .metaLink:hover { text-decoration: underline; }

  /* ── ACTION ROW ── */
  .actionRow {
    display: flex; align-items: center; gap: 10px;
    flex-wrap: wrap; margin-bottom: 28px;
  }

  /* Ticket button */
  .actionTicket {
    display: inline-flex; align-items: center;
    height: 48px; padding: 0 26px; border-radius: 999px;
    background: var(--theme-gradient); color: #fff;
    font-size: 15px; font-weight: 900; letter-spacing: .02em;
    text-decoration: none; white-space: nowrap;
    transition: opacity 140ms, transform 140ms;
    box-shadow: 0 2px 12px rgba(0,119,190,.30);
  }
  .actionTicket:hover { opacity: .88; transform: translateY(-1px); }

  .actionSecondary { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }

  /* Ghost action buttons (Calendar, Share) */
  .actionBtn {
    display: inline-flex; align-items: center; gap: 6px;
    height: 40px; padding: 0 16px; border-radius: 999px;
    border: 1px solid rgba(255,255,255,.15);
    background: transparent; color: var(--text);
    font-size: 13px; font-weight: 700; font-family: inherit;
    cursor: pointer; white-space: nowrap;
    transition: border-color 140ms, background 140ms;
    text-decoration: none;
  }
  .actionBtn:hover { border-color: var(--brand1); background: rgba(0,119,190,.06); color: var(--text); }

  /* Calendar dropdown */
  .calDrop { position: relative; }
  .calMenu {
    display: none; position: absolute; top: calc(100% + 6px); left: 0; z-index: 40;
    min-width: 190px; border-radius: 12px;
    border: 1px solid rgba(255,255,255,.12);
    background: #1e1e1e; box-shadow: 0 8px 24px rgba(0,0,0,.4);
    overflow: hidden;
  }
  .calMenu--open { display: block; }
  .calOption {
    display: flex; align-items: center; gap: 8px;
    padding: 11px 16px; font-size: 13px; font-weight: 700;
    color: var(--text); text-decoration: none;
    transition: background 100ms;
  }
  .calOption:hover { background: rgba(255,255,255,.06); }

  /* ── Venue Map ── */
  .venueMapBlock { margin-bottom: 28px; }

  /* ── Event body ── */
  .eventBody { line-height: 1.65; font-size: 16px; margin-bottom: 28px; }
  .eventBody :global(p)      { margin: 0 0 1em; }
  .eventBody :global(a)      { color: var(--link); }
  .eventBody :global(strong) { font-weight: 700; }

  .backLink { margin-top: 8px; }
  .pill {
    display: inline-flex; align-items: center;
    height: 34px; padding: 0 14px; border-radius: 999px;
    border: 1px solid rgba(255,255,255,.12);
    color: var(--text); font-size: 13px; font-weight: 700;
    text-decoration: none; transition: border-color 140ms;
  }
  .pill:hover { border-color: var(--brand1); color: var(--brand1); }

  /* ── Sidebar ── */
  .evSidebar { display: grid; gap: 24px; position: sticky; top: 80px; align-self: start; }

  .sideBlock {
    border-radius: 14px; border: 1px solid rgba(255,255,255,.08);
    background: rgba(255,255,255,.02); padding: 20px; display: grid; gap: 0;
  }
  .sideHead {
    font-size: 11px; font-weight: 900; letter-spacing: .1em; text-transform: uppercase;
    color: var(--brand1); padding-bottom: 10px; margin-bottom: 4px;
    border-bottom: 2px solid var(--brand1);
  }
  .sideGuideLink {
    display: flex; justify-content: space-between; align-items: center;
    padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,.06);
    text-decoration: none;
  }
  .sideGuideLink:last-of-type { border-bottom: none; }
  .sideGuideLink:hover .sideGuideTitle { color: var(--link); }
  .sideGuideTitle { font-size: 14px; font-weight: 700; color: var(--text); }
  .sideGuideArrow { font-size: 14px; color: var(--brand1); flex-shrink: 0; }
  .sideMore {
    display: inline-block; margin-top: 12px;
    font-size: 13px; font-weight: 700; color: var(--link); text-decoration: none;
  }
  .sideMore:hover { text-decoration: underline; }

  .sideNl {
    padding: 2rem; border-radius: 16px;
    background: var(--theme-gradient); border: 1px solid rgba(0,0,0,.25);
    display: flex; flex-direction: column; align-items: center; gap: 10px;
    text-align: center; box-sizing: border-box; width: 100%;
  }
  .sideNlHead  { font-size: 22px; font-weight: 900; font-style: italic; color: #fff; line-height: 1.1; text-shadow: 0 1px 3px rgba(0,0,0,.4); width: 100%; margin: 0 auto; text-align: center; }
  .sideNlHead strong { font-weight: 900; }
  .sideNlSub   { font-size: 1.1rem; font-weight: 400; color: rgba(255,255,255,.88); line-height: 1.4; text-shadow: 0 1px 2px rgba(0,0,0,.3); text-align: center; max-width: 280px; margin: 0 auto; }
  .sideNlForm  { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; width: 100%; box-sizing: border-box; }
  .sideNlInput {
    width: 100%; box-sizing: border-box; padding: 12px 14px; border-radius: 10px;
    border: none; background: #fff; font-size: 14px; color: #111;
    outline: 2px solid transparent; transition: outline-color 150ms;
    margin: 0 auto; display: block;
  }
  .sideNlInput:focus { outline-color: #000; }
  .sideNlBtn {
    width: 100%; padding: 12px 0; border-radius: 999px;
    border: none; background: #000; color: #fff;
    font-size: 14px; font-weight: 900; letter-spacing: .08em;
    cursor: pointer; transition: opacity 150ms; font-family: inherit;
    box-sizing: border-box; margin: 0 auto; display: block;
  }
  .sideNlBtn:hover { opacity: .82; }

  /* ── Newsletter sidebar: mobile-safe overrides (< 768px) ── */
  @media (max-width: 767px) {
    .sideNl {
      width: 100% !important;
      padding: 24px 16px !important;
      box-sizing: border-box !important;
      margin: 0 auto !important;
    }
    .sideNlHead, .sideNlSub, .sideNlForm {
      width: 100% !important;
      margin: 0 auto !important;
      box-sizing: border-box !important;
    }
    .sideNlInput, .sideNlBtn {
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 auto !important;
      display: block !important;
      box-sizing: border-box !important;
    }
  }

  /* ── More Like This ── */
  .relatedSection { padding: 40px 0 56px; border-top: 2px solid var(--brand1); }
  .relatedHead {
    display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 20px;
  }
  .relatedLabel { font-size: 18px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; color: var(--text); }
  .relatedAll   { font-size: 13px; font-weight: 700; color: var(--link); text-decoration: none; }
  .relatedAll:hover { text-decoration: underline; }

  .relatedGrid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px;
  }
  @media (max-width: 860px)  { .relatedGrid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px)  { .relatedGrid { grid-template-columns: 1fr; } }

  .relCard {
