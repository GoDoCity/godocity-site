---
/**
 * src/pages/[city]/events/index.astro
 * Generic events listing for city slugs NOT yet on the unified GoDoEVENTS hub.
 * Daytona is excluded: its feed lives at godoevents-site.pages.dev/daytona/events/
 * (see public/_redirects) so the retired local layout can never resurface.
 */
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { getCityEvents, cityDisplayName } from "../../../lib/events.js";
import { allCitySlugs, getDisplayName, getCityConfig } from "../../../lib/cityConfigs.js";
import NewsletterBanner from "../../../components/NewsletterBanner.astro";

export async function getStaticPaths() {
  // Daytona's events listing is served by the unified GoDoEVENTS hub —
  // skip it here so no local /daytona/events/ page is ever emitted again.
  return allCitySlugs
    .filter(slug => slug !== "daytona")
    .map(slug => ({ params: { city: slug } }));
}

const { city } = Astro.params;
const displayName = getDisplayName(city);
const config = getCityConfig(city);
const mapCenter = config?.mapCenter ?? { lat: 0, lng: 0 };

let events: any[] = [];
try { events = await getCityEvents(city); } catch { events = []; }

/* Pull local CMS (Sveltia) events for this city and normalise featured→sponsored */
let localCmsEvents: any[] = [];
try {
  const regionCities = config?.regionCities ?? new Set([String(city).toLowerCase()]);
  const allLocal = await getCollection("events");
  localCmsEvents = (allLocal as any[])
    .filter((e: any) => {
      const evCity = (e.data.city ?? "").toLowerCase().trim();
      return regionCities.has(evCity);
    })
    .map((e: any) => ({
      ...e,
      data: { ...e.data, sponsored: e.data.sponsored === true || e.data.featured === true },
    }));
} catch {}

/* Ticker: local sponsored CMS events first, then engine/sheet sponsored events */
const tickerEvents = [
  ...localCmsEvents.filter((e: any) => e.data.sponsored === true),
  ...events.filter(e => e.data.sponsored === true),
].slice(0, 4);

const sponsored  = events.filter(e => e.data.sponsored === true).slice(0, 5);
const regular    = events.filter(e => !e.data.sponsored);

const PAGE_SIZE = 20;

const FALLBACK_IMG = "https://images.unsplash.com/photo-1492684223066-81342ee5ff30?w=800&q=75";
const CATEGORY_IMG: Record<string, string> = {
  "Music & Nightlife":    "https://images.unsplash.com/photo-1514320291840-2e0a9bf2a9ae?w=800&q=75",
  "Food & Drink":         "https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=800&q=75",
  "Arts & Culture":       "https://images.unsplash.com/photo-1578321272176-b7bbc0679853?w=800&q=75",
  "Markets & Fairs":      "https://images.unsplash.com/photo-1488459716781-0a04a8a37e6e?w=800&q=75",
  "Outdoors & Sports":    "https://images.unsplash.com/photo-1530549387789-4c161668b269?w=800&q=75",
};
---

<Base title={`Events in ${displayName}`} subtitle={`Upcoming events in ${displayName} and surrounding areas`} cityBase={city}>
  <NewsletterBanner city={displayName} vibeCheckText={config?.vibeCheckText} accentColor={config?.accentColor} />
  <section class="section">
    <div class="evContainer">

      <div class="evHeader">
        <h1 class="evTitle">Events in {displayName}</h1>
        <div class="evActions">
          <a class="evBtn" href={`/${city}/advertise/`}>Advertise With Us</a>
          <a class="evBtn evBtn--add" href={`https://godoevents-site.pages.dev/${city}/events/submit`}>+ Add Event</a>
        </div>
      </div>

      {tickerEvents.length > 0 && (
        <section class="tbt" id="tbt" aria-label="Top-billed featured events">
          <div class="tbtTrack">
            {(tickerEvents as any[]).map((e: any, idx: number) => {
              const d    = new Date(e.data.eventDate);
              const mon  = isNaN(d.getTime()) ? "???" : d.toLocaleDateString("en-US", { month: "short" }).toUpperCase();
              const day  = isNaN(d.getTime()) ? "??" : d.getDate();
              const dow  = isNaN(d.getTime()) ? "" : d.toLocaleDateString("en-US", { weekday: "long" });
              const slug = e.slug.split("/").pop();
              const href = e.data.url ?? `/${city}/events/${slug}/`;
              const isExt = !!e.data.url;
              const img  = e.data.image || FALLBACK_IMG;
              return (
                <div class={`tbtSlide${idx === 0 ? " tbtSlide--active" : ""}`} data-idx={String(idx)}>
                  <img class="tbtImg" src={img} alt={e.data.title}
                       loading={idx === 0 ? "eager" : "lazy"} decoding="async" />
                  <div class="tbtGrad" aria-hidden="true" />
                  <div class="tbtContent">
                    <div class="tbtDateBox">
                      <div class="tbtMon">{mon}</div>
                      <div class="tbtDay">{day}</div>
                      <div class="tbtDow">{dow}</div>
                    </div>
                    <div class="tbtText">
                      <span class="tbtBadge">FEATURED</span>
                      <h2 class="tbtTitle">{e.data.title}</h2>
                      {e.data.location && <p class="tbtLoc">{e.data.location}</p>}
                    </div>
                    <a class="tbtCta" href={href}
                       target={isExt ? "_blank" : "_self"}
                       rel={isExt ? "noopener noreferrer" : ""}>
                      See Details →
                    </a>
                  </div>
                </div>
              );
            })}
          </div>
          {tickerEvents.length > 1 && (
            <div class="tbtDots" id="tbtDots">
              {(tickerEvents as any[]).map((_: any, idx: number) => (
                <button class={`tbtDot${idx === 0 ? " tbtDot--active" : ""}`}
                        data-dot={String(idx)} type="button"
                        aria-label={`Go to slide ${idx + 1}`} />
              ))}
            </div>
          )}
        </section>
      )}

      {sponsored.length > 0 && (
        <div class="featuredSection">
          <div class="featuredLabel">Featured Events</div>
          <div class="featuredGrid">
            {sponsored.map((e, idx) => {
              const d   = new Date(e.data.eventDate);
              const mon = isNaN(d.getTime()) ? "???" : d.toLocaleDateString("en-US", { month: "short" }).toUpperCase();
              const day = isNaN(d.getTime()) ? "??" : d.getDate();
              const evCity = (e.data.city ?? "").toLowerCase().trim();
              const evSlug = e.slug.split("/").pop();
              const href   = e.data.url ?? `/${city}/events/${evSlug}/`;
              const isExt  = !!e.data.url;
              return (
                <a class="fcCard" href={href}
                   target={isExt ? "_blank" : "_self"}
                   rel={isExt ? "noopener noreferrer" : ""}>
                  <div class="fcImgWrap">
                    <img class="fcImg"
                      src={e.data.image || CATEGORY_IMG[e.data.category ?? ""] || FALLBACK_IMG}
                      alt={e.data.title} loading={idx === 0 ? "eager" : "lazy"} />
                    <span class="fcBadge">SPONSORED</span>
                    <div class="fcOverlay">
                      <div class="fcDate">{mon} {day}</div>
                      <div class="fcTitle">{e.data.title}</div>
                      <div class="fcPlace">{cityDisplayName(evCity) || evCity}</div>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )}

      <div class="filterBar">
        <span class="filterCount" id="filterCount">
          {regular.length} event{regular.length !== 1 ? "s" : ""}
        </span>
      </div>

      <div class="evList" id="evList">
        {regular.slice(0, PAGE_SIZE).map((e, i) => {
          const d      = new Date(e.data.eventDate);
          const dow    = isNaN(d.getTime()) ? "???" : d.toLocaleDateString("en-US", { weekday: "short" }).toUpperCase();
          const day    = isNaN(d.getTime()) ? "??" : d.getDate();
          const mon    = isNaN(d.getTime()) ? "???" : d.toLocaleDateString("en-US", { month: "short" }).toUpperCase();
          const evCity = (e.data.city ?? "").toLowerCase().trim();
          const evSlug = e.slug.split("/").pop();
          const href   = e.data.url ?? `/${city}/events/${evSlug}/`;
          const isExt  = !!e.data.url;
          const img    = e.data.image || CATEGORY_IMG[e.data.category ?? ""] || FALLBACK_IMG;
          return (
            <a class={`evCard${i >= PAGE_SIZE ? " evCardHidden" : ""}`}
               href={href}
               target={isExt ? "_blank" : "_self"}
               rel={isExt ? "noopener noreferrer" : ""}>
              <div class="evCardDate">
                <div class="evCardDow">{dow}</div>
                <div class="evCardDay">{day}</div>
                <div class="evCardMon">{mon}</div>
              </div>
              <div class="evCardImg">
                <img src={img} alt={e.data.title} loading="lazy" />
              </div>
              <div class="evCardBody">
                <div class="evCardTitle">{e.data.title}</div>
                {e.data.location && <div class="evCardVenue">{e.data.location}</div>}
                {e.data.city && <div class="evCardCity">{cityDisplayName(evCity) || evCity}</div>}
              </div>
            </a>
          );
        })}
      </div>

      {regular.length > PAGE_SIZE && (
        <button class="loadMoreBtn" id="loadMoreBtn" type="button">
          Show more events
        </button>
      )}

      {events.length === 0 && (
        <p class="emptyMsg">No upcoming events — check back soon.</p>
      )}

    </div>
  </section>
</Base>

<style>
  .evContainer {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
  }
  .evHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
  }
  .evTitle {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 950;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .evActions { display: flex; gap: 10px; flex-wrap: wrap; }
  .evBtn {
    padding: 8px 18px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,.18);
    background: rgba(255,255,255,.05);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    color: inherit;
    transition: background 140ms, border-color 140ms;
  }
  .evBtn:hover { background: rgba(255,255,255,.10); border-color: var(--brand1); }
  .evBtn--add { background: var(--brand1); color: #fff; border-color: var(--brand1); }
  .evBtn--add:hover { opacity: .88; }

  .featuredSection { margin-bottom: 28px; }
  .featuredLabel {
    font-size: 12px; font-weight: 900; letter-spacing: .10em;
    text-transform: uppercase; opacity: .65; margin-bottom: 10px;
  }
  .featuredGrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }
  .fcCard { border-radius: 14px; overflow: hidden; text-decoration: none; display: block; }
  .fcImgWrap { position: relative; aspect-ratio: 4/3; overflow: hidden; }
  .fcImg { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fcBadge {
    position: absolute; top: 8px; left: 8px;
    font-size: 9px; font-weight: 900; letter-spacing: .08em;
    background: var(--brand1); color: #fff;
    padding: 3px 8px; border-radius: 999px;
  }
  .fcOverlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,.72) 0%, transparent 55%);
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: 10px;
  }
  .fcDate { font-size: 11px; font-weight: 700; color: rgba(255,255,255,.75); }
  .fcTitle { font-size: 14px; font-weight: 900; color: #fff; line-height: 1.2; }
  .fcPlace { font-size: 12px; color: rgba(255,255,255,.70); margin-top: 2px; }

  .filterBar {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(255,255,255,.08);
  }
  .filterCount { font-size: 13px; opacity: .65; }

  .evList { display: grid; gap: 10px; }
  .evCardHidden { display: none; }
  .evCard {
    display: grid;
    grid-template-columns: 52px 72px 1fr;
    gap: 14px;
    align-items: center;
    padding: 12px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.08);
    background: rgba(255,255,255,.03);
    text-decoration: none;
    color: inherit;
    transition: background 140ms, border-color 140ms;
  }
  .evCard:hover { background: rgba(255,255,255,.06); border-color: rgba(0,119,190,.28); }
  .evCardDate {
    width: 52px; height: 52px;
    border-radius: 10px;
    border: 1px solid var(--brand1);
    display: grid; place-items: center;
    text-align: center; line-height: 1;
  }
  .evCardDow { font-size: 9px; font-weight: 700; letter-spacing: .08em; color: var(--brand1); text-transform: uppercase; }
  .evCardDay { font-size: 20px; font-weight: 700; color: var(--brand1); margin-top: 1px; }
  .evCardMon { font-size: 8px; font-weight: 700; color: var(--brand1); text-transform: uppercase; letter-spacing: .06em; }
  .evCardImg {
    width: 72px; height: 52px;
    border-radius: 8px; overflow: hidden;
    background: rgba(255,255,255,.04);
    flex-shrink: 0;
  }
  .evCardImg img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .evCardBody { min-width: 0; }
  .evCardTitle { font-weight: 800; font-size: 15px; line-height: 1.2; }
  .evCardVenue { font-size: 13px; opacity: .72; margin-top: 3px; }
  .evCardCity { font-size: 12px; color: var(--brand1); margin-top: 2px; }

  .loadMoreBtn {
    display: block; width: 100%; margin-top: 14px;
    padding: 13px; border-radius: 14px;
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.04);
    color: inherit; font-weight: 800; font-size: 14px;
    cursor: pointer; transition: background 140ms, border-color 140ms;
  }
  .loadMoreBtn:hover { background: rgba(255,255,255,.08); border-color: var(--brand1); }

  .emptyMsg { opacity: .65; font-size: 15px; padding: 32px 0; text-align: center; }

  @media (max-width: 560px) {
    .evCard { grid-template-columns: 48px 1fr; }
    .evCardImg { display: none; }
  }

  /* ── Top-Billing Ticker ── */
  .tbt { position: relative; margin-bottom: 32px; border-radius: 16px; overflow: hidden;
         box-shadow: 0 8px 32px rgba(0,119,190,.16), 0 2px 8px rgba(0,0,0,.10);
         border: 2px solid color-mix(in srgb, var(--brand1, #0077be) 35%, transparent); }
  .tbtTrack { position: relative; overflow: hidden; height: 230px; }
  .tbtSlide { position: absolute; inset: 0; display: flex; align-items: flex-end;
              opacity: 0; transition: opacity 600ms ease; pointer-events: none; }
  .tbtSlide--active { opacity: 1; pointer-events: auto; z-index: 1; }
  .tbtImg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .tbtGrad { position: absolute; inset: 0;
             background: linear-gradient(90deg, rgba(0,0,0,.82) 0%, rgba(0,0,0,.55) 55%, rgba(0,0,0,.18) 100%);
             pointer-events: none; }
  .tbtContent { position: relative; z-index: 1; width: 100%; display: flex; align-items: center;
                gap: 14px; padding: 20px 24px; flex-wrap: nowrap; }
  .tbtDateBox { flex-shrink: 0; background: var(--brand1, #0077be); color: #fff;
                border-radius: 10px; padding: 7px 11px; text-align: center; min-width: 50px;
                box-shadow: 0 2px 10px rgba(0,0,0,.3); }
  .tbtMon { font-size: 9px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.8); line-height: 1; }
  .tbtDay { font-size: 24px; font-weight: 900; line-height: 1.1; letter-spacing: -0.02em; color: #fff; }
  .tbtDow { font-size: 8px; color: rgba(255,255,255,.65); font-weight: 700; margin-top: 1px; }
  .tbtText { flex: 1; min-width: 0; }
  .tbtBadge { display: inline-block; background: rgba(0,119,190,.85); color: #fff; font-size: 8.5px;
              font-weight: 900; letter-spacing: .12em; text-transform: uppercase; padding: 2px 8px;
              border-radius: 999px; margin-bottom: 6px; }
  .tbtTitle { font-size: clamp(14px, 2vw, 20px); font-weight: 900; color: #fff; line-height: 1.2;
              margin: 0 0 4px; overflow: hidden; display: -webkit-box;
              -webkit-line-clamp: 2; -webkit-box-orient: vertical; text-shadow: 0 1px 4px rgba(0,0,0,.4); }
  .tbtLoc { font-size: 12px; color: rgba(255,255,255,.65); margin: 0; overflow: hidden;
            text-overflow: ellipsis; white-space: nowrap; }
  .tbtCta { flex-shrink: 0; padding: 9px 18px; background: var(--brand1, #0077be); color: #fff;
            font-size: 12px; font-weight: 800; border-radius: 999px; text-decoration: none;
            white-space: nowrap; transition: background 130ms; box-shadow: 0 2px 12px rgba(0,119,190,.4); }
  .tbtCta:hover { background: #005fa3; }
  .tbtDots { position: absolute; bottom: 10px; right: 16px; display: flex; gap: 6px; z-index: 2; }
  .tbtDot { width: 7px; height: 7px; border-radius: 50%; border: none; padding: 0;
            background: rgba(255,255,255,.4); cursor: pointer; transition: background 200ms, transform 200ms; }
  .tbtDot--active { background: #fff; transform: scale(1.3); }
  @media (max-width: 560px) {
    .tbtTrack { height: 185px; }
    .tbtContent { padding: 12px; gap: 8px; flex-wrap: wrap; }
    .tbtCta { font-size: 11px; padding: 7px 13px; }
    .tbt { border-radius: 12px; margin-bottom: 22px; }
  }
</style>

<script is:inline>
/* ── Top-Billing Ticker ── */
(function () {
  var ticker = document.getElementById("tbt");
  if (!ticker) return;
  var slides   = Array.prototype.slice.call(ticker.querySelectorAll(".tbtSlide"));
  var dotsWrap = document.getElementById("tbtDots");
  var dots     = dotsWrap ? Array.prototype.slice.call(dotsWrap.querySelectorAll(".tbtDot")) : [];
  var total    = slides.length;
  var current  = 0;
  if (total <= 1) return;
  function goTo(idx) {
    slides[current].classList.remove("tbtSlide--active");
    if (dots[current]) dots[current].classList.remove("tbtDot--active");
    current = (idx + total) % total;
    slides[current].classList.add("tbtSlide--active");
    if (dots[current]) dots[current].classList.add("tbtDot--active");
  }
  var timer = setInterval(function () { goTo(current + 1); }, 4500);
  dots.forEach(function (dot, i) {
    dot.addEventListener("click", function () {
      clearInterval(timer); goTo(i);
      timer = setInterval(function () { goTo(current + 1); }, 4500);
    });
  });
  ticker.addEventListener("mouseenter", function () { clearInterval(timer); });
  ticker.addEventListener("mouseleave", function () { timer = setInterval(function () { goTo(current + 1); }, 4500); });
})();

/* ── Load More ── */
(function () {
  var remaining = [];
  var PAGE_SIZE = 20;

  document.querySelectorAll(".evCardHidden").forEach(function (el) {
    remaining.push(el);
  });

  var btn = document.getElementById("loadMoreBtn");
  if (btn) {
    btn.addEventListener("click", function () {
      remaining.splice(0, PAGE_SIZE).forEach(function (el) {
        el.classList.remove("evCardHidden");
      });
      if (remaining.length === 0) btn.style.display = "none";
    });
  }
})();
</script>
