---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";

/* ── Tag helpers ── */
function tagKey(raw) {
  return String(raw ?? "").toLowerCase().trim().replace(/[-_]+/g, " ").replace(/\s+/g, " ");
}
function tagSlug(key) {
  return String(key ?? "").toLowerCase().trim().replace(/&/g, "and").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
}
function tagLabel(key) {
  return key.split(" ").filter(Boolean).map(w => w[0].toUpperCase() + w.slice(1)).join(" ");
}

/* ── Post helpers ── */
function getPostDate(post) {
  return post?.data?.pubDate ?? post?.data?.date ?? post?.data?.published ?? post?.data?.updated ?? null;
}
function isFeatured(post) {
  const v = post?.data?.featured;
  if (v === true || v === 1) return true;
  return ["true", "yes", "1"].includes(String(v ?? "").toLowerCase().trim());
}
function heroImage(post) { return String(post?.data?.heroImage ?? "").trim(); }
function dateText(post) {
  const d = getPostDate(post);
  return d ? new Date(d).toLocaleDateString("en-US") : "";
}
function excerpt(post) { return post?.data?.description ?? ""; }

/* ────────────────────────────────────────────────────────────────────────────
   getStaticPaths
   Builds one page per (city, topic) pair found in the posts collection.
   "events" is excluded — that segment is owned by [city]/events/index.astro.
──────────────────────────────────────────────────────────────────────────── */
export async function getStaticPaths() {
  const all = await getCollection("posts");

  const _tagKey  = (raw) => String(raw ?? "").toLowerCase().trim().replace(/[-_]+/g, " ").replace(/\s+/g, " ");
  const _tagSlug = (key) => String(key ?? "").toLowerCase().trim().replace(/&/g, "and").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

  /* Map: "city|||topicSlug" → topicKey (the normalized tag text) */
  const map = new Map();
  for (const post of all) {
    const city = (post.data.city ?? post.id?.split("/")[0] ?? "").toLowerCase().trim();
    if (!city) continue;
    for (const tag of (Array.isArray(post.data.tags) ? post.data.tags : [])) {
      const key  = _tagKey(tag);
      const slug = _tagSlug(key);
      if (slug && slug !== "events") map.set(`${city}|||${slug}`, key);
    }
  }

  return Array.from(map.entries()).map(([combo, topicKey]) => {
    const [city, topic] = combo.split("|||");
    return { params: { city, topic }, props: { topicKey } };
  });
}

/* ── Page data ── */
const { city, topic } = Astro.params;
const { topicKey } = Astro.props;
const topicLabelStr = tagLabel(topicKey);
const cityCap = city.charAt(0).toUpperCase() + city.slice(1);

const all = await getCollection("posts");
const posts = all
  .filter(post => {
    const postCity = (post.data.city ?? post.id?.split("/")[0] ?? "").toLowerCase().trim();
    return postCity === city;
  })
  .filter(post => (Array.isArray(post.data.tags) ? post.data.tags : []).map(tagKey).includes(topicKey))
  .sort((a, b) => new Date(getPostDate(b) ?? 0).getTime() - new Date(getPostDate(a) ?? 0).getTime());

const hero = posts.find(isFeatured) ?? posts[0] ?? null;
const rest = hero ? posts.filter(p => p.slug !== hero.slug) : posts;

/* ── Live upcoming events for sidebar ── */
const today = new Date();
today.setHours(0, 0, 0, 0);
let allEvents = [];
try { allEvents = await getCollection("events"); } catch { allEvents = []; }
const upcomingEvents = allEvents
  .filter(e => {
    const evCity = (e.data.city ?? e.slug.split("/")[0]).toLowerCase().trim();
    const evDate = new Date(e.data.eventDate);
    evDate.setHours(0, 0, 0, 0);
    return evCity === city && evDate >= today;
  })
  .sort((a, b) => new Date(a.data.eventDate).getTime() - new Date(b.data.eventDate).getTime())
  .slice(0, 3);
---

<Base title={`${topicLabelStr} | GoDo ${cityCap}`} subtitle={topicLabelStr} cityBase={city}>
  <section class="section">
    <div class="container" style="max-width: 1080px;">

      <div class="topicHeader">
        <h1 class="topicTitle">{topicLabelStr}</h1>
        <div class="topicMeta">{posts.length} post{posts.length === 1 ? "" : "s"}</div>
      </div>

      <div class="topicLayout">
        <div class="topicMain">

          {hero && (
            <a class="heroCard" href={`/${city}/posts/${hero.slug}/`}>
              {heroImage(hero) && (
                <div class="heroMedia">
                  <img class="heroImg" src={heroImage(hero)} alt={hero.data.title ?? ""} loading="lazy" decoding="async" />
                </div>
              )}
              <div class="heroBody">
                <div class="heroKicker">{isFeatured(hero) ? "FEATURED" : "TOP STORY"}</div>
                <div class="heroTitle">{hero.data.title}</div>
                {excerpt(hero) && <div class="heroDesc">{excerpt(hero)}</div>}
                <div class="heroMeta">{dateText(hero)}</div>
              </div>
            </a>
          )}

          {rest.length > 0 && (
            <div class="list">
              {rest.map(p => (
                <a class="row" href={`/${city}/posts/${p.slug}/`}>
                  {heroImage(p) ? (
                    <div class="rowThumbWrap">
                      <img class="rowThumb" src={heroImage(p)} alt={p.data.title ?? ""} loading="lazy" decoding="async" />
                    </div>
                  ) : (
                    <div class="rowThumbWrap isEmpty" aria-hidden="true"></div>
                  )}
                  <div class="rowText">
                    <div class="rowTitle">{p.data.title ?? p.slug}</div>
                    {excerpt(p) && <div class="rowDesc">{excerpt(p)}</div>}
                    <div class="rowMeta">{dateText(p)}</div>
                  </div>
                </a>
              ))}
            </div>
          )}

          {posts.length === 0 && (
            <p class="emptyMsg">No posts in this topic yet — check back soon.</p>
          )}

          <p class="topicLinks">
            <a class="pill" href={`/${city}/topics/`}>← All topics</a>
            <a class="pill" href={`/${city}/posts/`}>Latest posts</a>
          </p>

        </div>

        <aside class="topicSidebar">
          <div class="moduleCard newsletterCard">
            <div class="moduleTitle">Good news for {cityCap}</div>
            <div class="moduleSubtext">Get the best local posts and events sent to your inbox, for free.</div>
            <form class="newsletterForm" action={`/${city}/subscribe/`} method="get">
              <input class="newsletterInput" type="email" name="email" placeholder="Enter your email address" aria-label="Email address" />
              <button class="newsletterButton" type="submit">SIGN UP — IT'S FREE!</button>
            </form>
            <div class="moduleFineprint">100% free. Unsubscribe anytime.</div>
          </div>

          <div class="moduleCard eventsCard">
            <div class="moduleTitle">Upcoming Events</div>
            {upcomingEvents.length > 0 ? (
              <div class="eventsList">
                {upcomingEvents.map((e, i) => {
                  const d   = new Date(e.data.eventDate);
                  const dow = d.toLocaleDateString("en-US", { weekday: "short" }).toUpperCase();
                  const day = d.getDate();
                  const mon = d.toLocaleDateString("en-US", { month: "short" }).toUpperCase();
                  const evSlug = e.slug.split("/").pop();
                  return (
                    <>
                      {i > 0 && <div class="eventDivider" aria-hidden="true"></div>}
                      <a class="eventRow"
                         href={e.data.url ?? `/${city}/events/${evSlug}/`}
                         target={e.data.url ? "_blank" : "_self"}
                         rel={e.data.url ? "noopener" : ""}>
                        <div class="eventDate">
                          <div class="eventDow">{dow}</div>
                          <div class="eventNum">{day}</div>
                          <div class="eventMon">{mon}</div>
                        </div>
                        <div class="eventInfo">
                          <div class="eventName">{e.data.title}</div>
                          <div class="eventPlace">{e.data.location}</div>
                        </div>
                      </a>
                    </>
                  );
                })}
              </div>
            ) : (
              <p class="noEvents">No upcoming events — check back soon.</p>
            )}
            <a class="eventsLink" href={`/${city}/events/`}>See all events →</a>
          </div>
        </aside>
      </div>

    </div>
  </section>
</Base>

<style>
  :root {
    --card-radius: 18px;
    --card-border: rgba(255,255,255,.10);
    --card-border-hover: rgba(255,220,80,.22);
    --card-bg: rgba(255,255,255,.035);
    --card-bg-hover: rgba(255,255,255,.05);
    --shadow-soft: 0 10px 30px rgba(0,0,0,.24);
    --lift: translateY(-2px);
    --ease: 160ms ease;
  }

  .topicHeader { margin-bottom: 18px; }
  .topicTitle {
    margin: 8px 0 6px;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .topicMeta { opacity: .72; font-size: 14px; }

  .topicLayout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 18px;
    align-items: start;
  }
  .topicMain { min-width: 0; }
  .topicSidebar {
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: sticky;
    top: 16px;
  }
  @media (max-width: 980px) {
    .topicLayout { grid-template-columns: 1fr; }
    .topicSidebar { position: static; }
  }

  /* Shared card base */
  .heroCard, .row, .moduleCard {
    border-radius: var(--card-radius);
    border: 1px solid var(--card-border);
    background: var(--card-bg);
    transition: transform var(--ease), background var(--ease), border-color var(--ease), box-shadow var(--ease);
    will-change: transform;
  }
  .heroCard:hover, .row:hover, .moduleCard:hover {
    transform: var(--lift);
    background: var(--card-bg-hover);
    border-color: var(--card-border-hover);
    box-shadow: 0 0 0 1px rgba(255,220,80,.08), var(--shadow-soft);
  }

  /* Hero */
  .heroCard {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 0;
    overflow: hidden;
    text-decoration: none;
    margin: 6px 0 18px;
  }
  @media (max-width: 880px) { .heroCard { grid-template-columns: 1fr; } }

  .heroMedia { position: relative; overflow: hidden; background: rgba(255,255,255,.02); }
  .heroMedia::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(0,0,0,0) 55%, rgba(0,0,0,.22) 100%);
  }
  .heroImg { width: 100%; height: 100%; display: block; aspect-ratio: 4/3; object-fit: cover; }
  .heroBody {
    padding: 18px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }
  .heroKicker {
    font-size: 12px; font-weight: 900; letter-spacing: .10em;
    opacity: .78; text-transform: uppercase; margin-bottom: 10px;
  }
  .heroTitle {
    font-weight: 950;
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1.10;
    letter-spacing: -0.015em;
  }
  .heroDesc {
    margin-top: 10px; opacity: .86; line-height: 1.5;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .heroMeta { margin-top: 12px; opacity: .62; font-size: 12.5px; }

  /* List */
  .list { display: grid; gap: 12px; margin-top: 6px; }
  .row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    align-items: center;
    padding: 14px;
    text-decoration: none;
  }
  .rowText { min-width: 0; }
  .rowTitle { font-weight: 900; font-size: 17px; line-height: 1.18; letter-spacing: -0.01em; }
  .rowDesc {
    margin-top: 7px; opacity: .84; font-size: 14px; line-height: 1.45;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .rowMeta { margin-top: 9px; opacity: .58; font-size: 12.5px; }
  .rowThumbWrap {
    width: 118px; height: 86px;
    border-radius: 14px; overflow: hidden;
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.02);
    flex: none;
  }
  .rowThumbWrap.isEmpty { opacity: .25; }
  .rowThumb { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (max-width: 560px) {
    .rowThumbWrap { width: 104px; height: 76px; border-radius: 12px; }
    .row { padding: 12px; gap: 12px; }
    .rowTitle { font-size: 16px; }
  }

  .emptyMsg { opacity: .6; font-size: 15px; padding: 24px 0; }

  .topicLinks { margin-top: 18px; display: flex; gap: 10px; flex-wrap: wrap; }

  /* Sidebar */
  .moduleCard { padding: 16px; }
  .moduleTitle {
    font-weight: 950; font-size: 16px;
    line-height: 1.15; letter-spacing: -0.01em; margin: 0 0 8px;
  }
  .moduleSubtext { opacity: .80; font-size: 13.5px; line-height: 1.35; margin-bottom: 12px; }
  .moduleFineprint { opacity: .62; font-size: 12px; margin-top: 10px; }

  .newsletterCard { padding: 18px 16px 16px; }
  .newsletterForm { display: grid; gap: 10px; margin-top: 10px; }
  .newsletterInput {
    width: 100%; padding: 12px;
    border-radius: 12px; border: 1px solid rgba(255,255,255,.12);
    background: rgba(0,0,0,.25); color: inherit; outline: none;
  }
  .newsletterInput:focus {
    border-color: rgba(255,220,80,.35);
    box-shadow: 0 0 0 3px rgba(255,220,80,.10);
  }
  .newsletterButton {
    width: 100%; padding: 12px;
    border-radius: 12px; border: 1px solid rgba(255,220,80,.35);
    background: rgba(255,220,80,.14); color: rgba(255,220,80,.98);
    font-weight: 900; letter-spacing: .02em; cursor: pointer;
    transition: filter var(--ease), background var(--ease);
  }
  .newsletterButton:hover { filter: brightness(1.06); }

  /* Events sidebar */
  .eventsCard { padding: 16px; }
  .eventsList { margin-top: 10px; display: grid; gap: 8px; }
  .eventRow {
    display: grid; grid-template-columns: 44px 1fr;
    gap: 12px; align-items: center;
    text-decoration: none;
  }
  .eventDate {
    border-radius: 12px; border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.03); padding: 6px 8px;
    text-align: center; line-height: 1.1;
  }
  .eventDow { font-size: 9px; font-weight: 900; letter-spacing: .10em; color: var(--brand1); text-transform: uppercase; }
  .eventNum { font-size: 16px; font-weight: 950; color: var(--text); margin-top: 2px; }
  .eventMon { font-size: 8px; font-weight: 700; color: var(--faint); text-transform: uppercase; letter-spacing: .06em; }
  .eventName { font-weight: 900; font-size: 13.5px; line-height: 1.2; color: var(--text); margin-bottom: 3px; }
  .eventPlace { opacity: .72; font-size: 12px; color: var(--faint); }
  .eventDivider { height: 1px; background: rgba(255,255,255,.08); border-radius: 999px; }
  .noEvents { font-size: 13px; color: var(--faint); padding: 10px 0 4px; margin: 0; }
  .eventsLink {
    display: block; margin-top: 12px;
    font-size: 13px; font-weight: 700; color: var(--link);
    text-decoration: none;
  }
  .eventsLink:hover { text-decoration: underline; }
</style>
