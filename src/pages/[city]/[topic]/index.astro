<script is:inline>
(function () {
  /* Load More */
  var btn = document.getElementById("loadMoreBtn");
  if (btn) {
    btn.addEventListener("click", function () {
      document.querySelectorAll(".rowHidden").forEach(function (el) {
        el.classList.remove("rowHidden");
      });
      btn.style.display = "none";
    });
  }

  /* Carousel scroll */
  var track = document.getElementById("carouselTrack");
  var next = document.getElementById("carouselNext");
  var prev = document.getElementById("carouselPrev");
  if (next && track) next.addEventListener("click", function () { track.scrollBy({ left: track.offsetWidth * 0.85, behavior: "smooth" }); });
  if (prev && track) prev.addEventListener("click", function () { track.scrollBy({ left: -track.offsetWidth * 0.85, behavior: "smooth" }); });

})();
</script>
