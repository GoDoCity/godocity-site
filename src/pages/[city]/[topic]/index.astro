---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";

/* ── Tag helpers ── */
function tagKey(raw) {
  return String(raw ?? "").toLowerCase().trim()
    .replace(/\s*&\s*/g, " ")
    .replace(/[-_]+/g, " ")
    .replace(/\s+/g, " ").trim();
}
function tagSlug(key) {
  return String(key ?? "").toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
}
function tagLabel(key) {
  return key.split(" ").filter(Boolean).map(w => w[0].toUpperCase() + w.slice(1)).join(" ");
}

/* ── Post helpers ── */
function getPostDate(post) {
  return post?.data?.pubDate ?? post?.data?.date ?? post?.data?.published ?? post?.data?.updated ?? null;
}
function isFeatured(post) {
  const v = post?.data?.featured;
  if (v === true || v === 1) return true;
  return ["true", "yes", "1"].includes(String(v ?? "").toLowerCase().trim());
}
function heroImage(post) {
  const v = post?.data?.heroImage ?? post?.data?.heroimage ?? post?.data?.image ?? "";
  return String(v).trim();
}
function thumbImage(post) {
  const v = post?.data?.thumbnail ?? post?.data?.heroImage ?? post?.data?.heroimage ?? post?.data?.image ?? "";
  return String(v).trim();
}
function dateText(post) {
  const d = getPostDate(post);
  return d ? new Date(d).toLocaleDateString("en-US") : "";
}
function excerpt(post) { return post?.data?.description ?? ""; }

/* Kicker parts: { catLabel, catSlug, sub, sponsorLabel }
   catLabel    = UPPERCASED category, used when no tier is active
   catSlug     = URL slug for the category topic page
   sub         = explicit subtopic label (post.data.subtopic)
   sponsorLabel= UPPERCASED tier when active — replaces catLabel in kicker */
function kickerParts(post) {
  const cat = typeof post.data.category === "string" ? post.data.category.trim() : "";
  const catKey = cat ? tagKey(cat) : "";
  const catSlug = catKey ? tagSlug(catKey) : "";
  const catLabel = cat ? cat.toUpperCase() : "";
  const sub = typeof post.data.subtopic === "string" ? post.data.subtopic.trim() : "";
  const tier = typeof post.data.sponsorTier === "string" ? post.data.sponsorTier.trim() : "";
  const sponsorLabel = (tier && tier !== "None") ? tier.toUpperCase() : "";
  return { catLabel, catSlug, sub, sponsorLabel };
}

/* ────────────────────────────────────────────────────────────────────────────
   getStaticPaths
   Always generates the 9 canonical topic pages for every city that has posts,
   so /daytona/biz/ exists even when no posts are tagged "biz" yet.
   Tag-derived topics beyond the known list are also included.
   "events" is excluded — that segment is owned by [city]/events/index.astro.
──────────────────────────────────────────────────────────────────────────── */
export async function getStaticPaths() {
  const all = await getCollection("posts");

  const _tagKey  = (raw) => String(raw ?? "").toLowerCase().trim().replace(/\s*&\s*/g, " ").replace(/[-_]+/g, " ").replace(/\s+/g, " ").trim();
  const _tagSlug = (key) => String(key ?? "").toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

  /* Canonical nav topics — always built for every city with posts */
  const KNOWN = [
    { slug: "business",        key: "business" },
    { slug: "city",            key: "city" },
    { slug: "culture",         key: "culture" },
    { slug: "diy",             key: "diy" },
    { slug: "food",            key: "food" },
    { slug: "history",         key: "history" },
    { slug: "real-estate",     key: "real estate" },
    { slug: "sports",          key: "sports" },
    { slug: "travel-outdoors", key: "travel outdoors" },
    { slug: "wellness",        key: "wellness" },
  ];

  /* Collect all cities that have at least one post */
  const cities = new Set();
  for (const post of all) {
    const city = (post.data.city ?? post.id?.split("/")[0] ?? "").toLowerCase().trim();
    if (city) cities.add(city);
  }

  /* Seed with known topics × all cities */
  const map = new Map();
  for (const city of cities) {
    for (const t of KNOWN) map.set(`${city}|||${t.slug}`, t.key);
  }

  /* Add any additional tag-derived topics not already in the map */
  for (const post of all) {
    const city = (post.data.city ?? post.id?.split("/")[0] ?? "").toLowerCase().trim();
    if (!city) continue;
    for (const tag of (Array.isArray(post.data.tags) ? post.data.tags : [])) {
      const key  = _tagKey(tag);
      const slug = _tagSlug(key);
      if (slug && slug !== "events" && !map.has(`${city}|||${slug}`)) {
        map.set(`${city}|||${slug}`, key);
      }
    }
  }

  return Array.from(map.entries()).map(([combo, topicKey]) => {
    const [city, topic] = combo.split("|||");
    return { params: { city, topic }, props: { topicKey } };
  });
}

/* ── Page data ── */
const { city, topic } = Astro.params;
const { topicKey } = Astro.props;
const topicLabelStr = tagLabel(topicKey);
const cityCap = city.charAt(0).toUpperCase() + city.slice(1);

const all = await getCollection("posts");
const posts = all
  .filter(post => {
    const postCity = (post.data.city ?? post.id?.split("/")[0] ?? "").toLowerCase().trim();
    return postCity === city;
  })
  .filter(post => {
    const tags = Array.isArray(post.data.tags) ? post.data.tags : [];
    if (tags.map(tagKey).includes(topicKey)) return true;
    const cat = typeof post.data.category === "string" ? tagKey(post.data.category) : "";
    return cat === topicKey;
  })
  .sort((a, b) => new Date(getPostDate(b) ?? 0).getTime() - new Date(getPostDate(a) ?? 0).getTime());

const hero = posts.find(isFeatured) ?? posts[0] ?? null;
const rest = hero ? posts.filter(p => p.slug !== hero.slug) : posts;

/* Carousel: recent city posts NOT in the current topic list */
const carouselPosts = all
  .filter(post => {
    const postCity = (post.data.city ?? post.id?.split("/")[0] ?? "").toLowerCase().trim();
    return postCity === city;
  })
  .filter(post => !posts.some(p => p.slug === post.slug))
  .sort((a, b) => new Date(getPostDate(b) ?? 0).getTime() - new Date(getPostDate(a) ?? 0).getTime())
  .slice(0, 8);

/* ── Live upcoming events for sidebar ── */
const today = new Date();
today.setHours(0, 0, 0, 0);
let allEvents = [];
try { allEvents = await getCollection("events"); } catch { allEvents = []; }
const upcomingEvents = allEvents
  .filter(e => {
    const evCity = (e.data.city ?? e.slug.split("/")[0]).toLowerCase().trim();
    const evDate = new Date(e.data.eventDate);
    evDate.setHours(0, 0, 0, 0);
    return evCity === city && evDate >= today;
  })
  .sort((a, b) => new Date(a.data.eventDate).getTime() - new Date(b.data.eventDate).getTime())
  .slice(0, 3);
---

<Base title={`${topicLabelStr} | GoDo ${cityCap}`} subtitle={topicLabelStr} cityBase={city}>
  <section class="section">
    <div class="container" style="max-width: 1080px;">

      <div class="topicHeader">
        <h1 class="topicTitle">{topicLabelStr}</h1>
        <div class="topicMeta">{posts.length} post{posts.length === 1 ? "" : "s"}</div>
      </div>

      <div class="topicLayout">
        <div class="topicMain">

          {hero && (
            <a class={`heroCard${kickerParts(hero).sponsorLabel ? " sponsoredCard" : ""}`} href={`/${city}/posts/${hero.slug}/`}>
              {heroImage(hero) && (
                <div class="heroMedia">
                  <img class="heroImg" src={heroImage(hero)} alt={hero.data.title ?? ""} loading="lazy" decoding="async" />
                </div>
              )}
              <div class="heroBody">
                {(() => { const { catLabel, sub, sponsorLabel } = kickerParts(hero); const kl = sponsorLabel || catLabel; return (kl || isFeatured(hero)) && (
                  <div class={`heroKicker${sponsorLabel ? " sponsorKicker" : ""}`}>
                    {kl || "FEATURED"}{kl && sub ? ` — ${sub}` : ""}
                  </div>
                ); })()}
                <div class="heroTitle">{hero.data.title}</div>
                {excerpt(hero) && <div class="heroDesc">{excerpt(hero)}</div>}
                <div class="heroMeta">{dateText(hero)}</div>
              </div>
            </a>
          )}

          {rest.length > 0 && (
            <div class="list" id="articleList">
              {rest.map((p, idx) => {
                const { catLabel, catSlug, sub, sponsorLabel } = kickerParts(p);
                const isSponsored = !!sponsorLabel;
                const kickerLabel = sponsorLabel || catLabel;
                return (
                  <div class={`row${idx >= 9 ? " rowHidden" : ""}${isSponsored ? " sponsoredRow" : ""}`}>
                    <a class="rowCardLink" href={`/${city}/posts/${p.slug}/`} aria-label={p.data.title ?? p.slug}></a>
                    {thumbImage(p) ? (
                      <div class="rowThumbWrap">
                        <img class="rowThumb" src={thumbImage(p)} alt={p.data.title ?? ""} loading="lazy" decoding="async" />
                      </div>
                    ) : (
                      <div class="rowThumbWrap isEmpty" aria-hidden="true"></div>
                    )}
                    <div class="rowText">
                      {kickerLabel && (
                        <div class="rowKicker">
                          {isSponsored
                            ? <span class="kickerSponsorBadge">{kickerLabel}</span>
                            : <a class="kickerCatLink" href={`/${city}/${catSlug}/`}>{kickerLabel}</a>
                          }
                          {sub && <span class="kickerSub"> — {sub}</span>}
                        </div>
                      )}
                      <div class="rowTitle">{p.data.title ?? p.slug}</div>
                      {excerpt(p) && <div class="rowDesc">{excerpt(p)}</div>}
                      <div class="rowMeta">{dateText(p)}</div>
                    </div>
                  </div>
                );
              })}
            </div>
          )}

          {rest.length > 9 && (
            <button class="loadMoreBtn" id="loadMoreBtn" type="button">
              Load {rest.length - 9} more {rest.length - 9 === 1 ? "post" : "posts"}
            </button>
          )}

          {posts.length === 0 && (
            <p class="emptyMsg">No posts in this topic yet — check back soon.</p>
          )}

          <p class="topicLinks">
            <a class="pill" href={`/${city}/topics/`}>← All topics</a>
            <a class="pill" href={`/${city}/posts/`}>Latest posts</a>
          </p>

          {carouselPosts.length > 0 && (
            <div class="carouselSection">
              <div class="carouselHeader">
                <div class="carouselTitle">More from GoDo {cityCap}</div>
                <button class="carouselNextBtn" id="carouselNext" type="button" aria-label="Scroll right">&#8250;</button>
              </div>
              <div class="carouselTrack" id="carouselTrack">
                {carouselPosts.map(p => {
                  const img = thumbImage(p);
                  const { catLabel } = kickerParts(p);
                  return (
                    <a class="carouselCard" href={`/${city}/posts/${p.slug}/`}>
                      <div class="carouselThumb">
                        {img
                          ? <img class="carouselImg" src={img} alt={p.data.title ?? ""} loading="lazy" decoding="async" />
                          : <div class="carouselImgEmpty" aria-hidden="true" />
                        }
                      </div>
                      <div class="carouselBody">
                        {catLabel && <div class="carouselKicker">{catLabel}</div>}
                        <div class="carouselCardTitle">{p.data.title ?? p.slug}</div>
                        <div class="carouselCardDate">{dateText(p)}</div>
                      </div>
                    </a>
                  );
                })}
              </div>
            </div>
          )}

        </div>

        <aside class="topicSidebar">
          <div class="moduleCard newsletterCard">
            <div class="moduleTitle">Good news for {cityCap}</div>
            <div class="moduleSubtext">Get the best local posts and events sent to your inbox, for free.</div>
            <form class="newsletterForm" action={`/${city}/subscribe/`} method="get">
              <input class="newsletterInput" type="email" name="email" placeholder="Enter your email address" aria-label="Email address" />
              <button class="newsletterButton" type="submit">SIGN UP — IT'S FREE!</button>
            </form>
            <div class="moduleFineprint">100% free. Unsubscribe anytime.</div>
          </div>

          <div class="moduleCard eventsCard">
            <div class="moduleTitle">Upcoming Events</div>
            {upcomingEvents.length > 0 ? (
              <div class="eventsList">
                {upcomingEvents.map((e, i) => {
                  const d   = new Date(e.data.eventDate);
                  const dow = d.toLocaleDateString("en-US", { weekday: "short" }).toUpperCase();
                  const day = d.getDate();
                  const mon = d.toLocaleDateString("en-US", { month: "short" }).toUpperCase();
                  const evSlug = e.slug.split("/").pop();
                  return (
                    <>
                      {i > 0 && <div class="eventDivider" aria-hidden="true"></div>}
                      <a class="eventRow"
                         href={e.data.url ?? `/${city}/events/${evSlug}/`}
                         target={e.data.url ? "_blank" : "_self"}
                         rel={e.data.url ? "noopener" : ""}>
                        <div class="eventDate">
                          <div class="eventDow">{dow}</div>
                          <div class="eventNum">{day}</div>
                          <div class="eventMon">{mon}</div>
                        </div>
                        <div class="eventInfo">
                          <div class="eventName">{e.data.title}</div>
                          <div class="eventPlace">{e.data.location}</div>
                        </div>
                      </a>
                    </>
                  );
                })}
              </div>
            ) : (
              <p class="noEvents">No upcoming events — check back soon.</p>
            )}
            <a class="eventsLink" href={`/${city}/events/`}>See all events →</a>
          </div>
        </aside>
      </div>

    </div>
  </section>
</Base>

<style>
  :root {
    --card-radius: 18px;
    --card-border: rgba(255,255,255,.10);
    --card-border-hover: rgba(255,220,80,.22);
    --card-bg: rgba(255,255,255,.035);
    --card-bg-hover: rgba(255,255,255,.05);
    --shadow-soft: 0 10px 30px rgba(0,0,0,.24);
    --lift: translateY(-2px);
    --ease: 160ms ease;
  }

  .topicHeader { margin-bottom: 18px; }
  .topicTitle {
    margin: 8px 0 6px;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .topicMeta { opacity: .72; font-size: 14px; }

  .topicLayout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 18px;
    align-items: start;
  }
  .topicMain { min-width: 0; }
  .topicSidebar {
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: sticky;
    top: 16px;
  }
  @media (max-width: 980px) {
    .topicLayout { grid-template-columns: 1fr; }
    .topicSidebar { position: static; }
  }

  /* Shared card base */
  .heroCard, .row, .moduleCard {
    border-radius: var(--card-radius);
    border: 1px solid var(--card-border);
    background: var(--card-bg);
    transition: transform var(--ease), background var(--ease), border-color var(--ease), box-shadow var(--ease);
    will-change: transform;
  }
  .heroCard:hover, .row:hover, .moduleCard:hover {
    transform: var(--lift);
    background: var(--card-bg-hover);
    border-color: var(--card-border-hover);
    box-shadow: 0 0 0 1px rgba(255,220,80,.08), var(--shadow-soft);
  }

  /* Hero */
  .heroCard {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 0;
    overflow: hidden;
    text-decoration: none;
    margin: 6px 0 18px;
  }
  @media (max-width: 880px) { .heroCard { grid-template-columns: 1fr; } }

  .heroMedia { position: relative; overflow: hidden; background: rgba(255,255,255,.02); }
  .heroMedia::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(0,0,0,0) 55%, rgba(0,0,0,.22) 100%);
  }
  .heroImg { width: 100%; height: 100%; display: block; aspect-ratio: 4/3; object-fit: cover; }
  .heroBody {
    padding: 18px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }
  .heroKicker {
    font-size: 12px; font-weight: 900; letter-spacing: .10em;
    opacity: .78; text-transform: uppercase; margin-bottom: 10px;
  }
  .heroTitle {
    font-weight: 950;
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1.10;
    letter-spacing: -0.015em;
  }
  .heroDesc {
    margin-top: 10px; opacity: .86; line-height: 1.5;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .heroMeta { margin-top: 12px; opacity: .62; font-size: 12.5px; }

  /* List */
  .list { display: grid; gap: 12px; margin-top: 6px; }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 14px;
    align-items: center;
    padding: 14px;
    cursor: pointer;
  }
  /* Stretched invisible link covers the whole card */
  .rowCardLink {
    position: absolute; inset: 0; z-index: 0;
    border-radius: var(--card-radius);
    text-decoration: none;
  }
  .rowText { min-width: 0; }
  .rowKicker {
    font-size: 10px; font-weight: 800;
    letter-spacing: .10em; text-transform: uppercase;
    margin-bottom: 4px; line-height: 1;
    position: relative; z-index: 1;
  }
  /* Clickable category part of kicker */
  .kickerCatLink {
    color: var(--brand1);
    text-decoration: none;
    font-weight: 800;
    font-size: inherit;
    position: relative; z-index: 1;
  }
  .kickerCatLink:hover { text-decoration: underline; }
  .kickerSub { color: var(--brand1); }
  .rowTitle { font-weight: 900; font-size: 17px; line-height: 1.18; letter-spacing: -0.01em; }
  .rowDesc {
    margin-top: 7px; opacity: .84; font-size: 14px; line-height: 1.45;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .rowMeta { margin-top: 9px; opacity: .58; font-size: 12.5px; }
  .rowThumbWrap {
    aspect-ratio: 4/3;
    border-radius: 14px; overflow: hidden;
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.02);
  }
  .rowThumbWrap.isEmpty { opacity: .25; }
  .rowThumb { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (max-width: 560px) {
    .rowThumbWrap { border-radius: 12px; }
    .row { padding: 12px; gap: 12px; }
    .rowTitle { font-size: 16px; }
  }

  /* Sponsored row/card tint */
  .sponsoredRow {
    background: linear-gradient(90deg, rgba(255,210,50,.07) 0%, rgba(255,220,80,.03) 100%);
    border-left: 2px solid rgba(255,210,50,.28);
    padding-left: calc(var(--gap) - 2px);
  }
  .sponsoredCard {
    border-color: rgba(255,210,50,.28) !important;
    background: linear-gradient(135deg, rgba(255,210,50,.09) 0%, rgba(255,220,80,.04) 100%);
  }
  .sponsorKicker {
    background: rgba(255,200,30,.18);
    color: rgba(255,210,50,1);
    border: 1px solid rgba(255,200,30,.28);
    border-radius: 999px;
    padding: 2px 10px;
    display: inline-block;
  }
  .kickerSponsorBadge {
    display: inline-flex; align-items: center;
    font-size: 9.5px; font-weight: 900; letter-spacing: .09em;
    text-transform: uppercase;
    background: rgba(255,200,30,.16);
    color: rgba(255,210,50,1);
    border: 1px solid rgba(255,200,30,.28);
    border-radius: 999px; padding: 2px 9px;
    position: relative; z-index: 1;
  }

  /* Load More */
  .rowHidden { display: none; }

  .loadMoreBtn {
    display: block;
    width: 100%;
    margin-top: 14px;
    padding: 14px;
    border-radius: var(--card-radius);
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.04);
    color: inherit;
    font-weight: 800;
    font-size: 14px;
    letter-spacing: .02em;
    cursor: pointer;
    transition: background var(--ease), border-color var(--ease);
  }
  .loadMoreBtn:hover {
    background: rgba(255,255,255,.07);
    border-color: rgba(255,220,80,.22);
  }

  /* Carousel */
  .carouselSection { margin-top: 28px; }
  .carouselHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .carouselTitle {
    font-weight: 950;
    font-size: 16px;
    letter-spacing: -0.01em;
  }
  .carouselNextBtn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px; height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,.14);
    background: rgba(255,255,255,.05);
    color: inherit;
    font-size: 22px;
    cursor: pointer;
    flex-shrink: 0;
    transition: background var(--ease), border-color var(--ease);
  }
  .carouselNextBtn:hover {
    background: rgba(255,220,80,.14);
    border-color: rgba(255,220,80,.30);
  }

  .carouselTrack {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 4px;
  }
  .carouselTrack::-webkit-scrollbar { display: none; }

  .carouselCard {
    flex: 0 0 calc(33.33% - 10px);
    min-width: 200px;
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.03);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: transform var(--ease), border-color var(--ease), background var(--ease);
  }
  .carouselCard:hover {
    transform: var(--lift);
    border-color: rgba(255,220,80,.22);
    background: rgba(255,255,255,.05);
  }
  .carouselThumb {
    aspect-ratio: 4/3;
    overflow: hidden;
    background: rgba(255,255,255,.04);
  }
  .carouselImg { width: 100%; height: 100%; object-fit: cover; display: block; }
  .carouselImgEmpty { width: 100%; height: 100%; opacity: .2; }
  .carouselBody { padding: 12px; flex: 1; }
  .carouselKicker {
    font-size: 9px; font-weight: 900; letter-spacing: .10em;
    text-transform: uppercase; color: rgba(255,220,80,.85);
    margin-bottom: 5px;
  }
  .carouselCardTitle {
    font-weight: 900; font-size: 14px; line-height: 1.20;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .carouselCardDate { margin-top: 7px; font-size: 11.5px; opacity: .58; }

  @media (max-width: 560px) {
    .carouselCard { flex: 0 0 72vw; }
  }

  .emptyMsg { opacity: .6; font-size: 15px; padding: 24px 0; }

  .topicLinks { margin-top: 18px; display: flex; gap: 10px; flex-wrap: wrap; }

  /* Sidebar */
  .moduleCard { padding: 16px; }
  .moduleTitle {
    font-weight: 950; font-size: 16px;
    line-height: 1.15; letter-spacing: -0.01em; margin: 0 0 8px;
  }
  .moduleSubtext { opacity: .80; font-size: 13.5px; line-height: 1.35; margin-bottom: 12px; }
