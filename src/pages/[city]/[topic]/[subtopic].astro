---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";
import ArticleSidebar from "../../../components/ArticleSidebar.astro";
import { getDisplayName } from "../../../lib/cityConfigs.js";

/* ── String helpers ── */
function tagKey(raw) {
  return String(raw ?? "").toLowerCase().trim()
    .replace(/\s*&\s*/g, " ")
    .replace(/[-_]+/g, " ")
    .replace(/\s+/g, " ").trim();
}
function tagSlug(key) {
  return String(key ?? "").toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
}
function tagLabel(key) {
  return key.split(" ").filter(Boolean).map(w => w[0].toUpperCase() + w.slice(1)).join(" ");
}
function getPostDate(post) {
  return post?.data?.pubDate ?? post?.data?.date ?? post?.data?.published ?? post?.data?.updated ?? null;
}
function isFeatured(post) {
  const v = post?.data?.featured;
  if (v === true || v === 1) return true;
  return ["true", "yes", "1"].includes(String(v ?? "").toLowerCase().trim());
}
const FALLBACK_IMG = "/images/gododaytona-bg.png";
function heroImage(post) {
  const v = post?.data?.heroImage || post?.data?.heroimage || post?.data?.thumbnail || post?.data?.image || "";
  return String(v).trim() || FALLBACK_IMG;
}
function thumbImage(post) {
  const v = post?.data?.thumbnail || post?.data?.heroImage || post?.data?.heroimage || post?.data?.image || "";
  return String(v).trim() || FALLBACK_IMG;
}
function dateText(post) {
  const d = getPostDate(post);
  return d ? new Date(d).toLocaleDateString("en-US") : "";
}
function excerpt(post) { return post?.data?.description ?? ""; }

/* ─────────────────────────────────────────────────────────────────────────
   getStaticPaths
   Generates one page per unique (city, topicSlug, subtopicSlug) found in
   the posts collection.  DIY subtopics (/city/diy/paint/) are excluded —
   those are handled by [city]/diy/[topic]/index.astro.
   Case-normalised via tagKey so "Festivals" and "festivals" merge to one path.
───────────────────────────────────────────────────────────────────────── */
export async function getStaticPaths() {
  const _tagKey  = (raw) => String(raw ?? "").toLowerCase().trim().replace(/\s*&\s*/g, " ").replace(/[-_]+/g, " ").replace(/\s+/g, " ").trim();
  const _tagSlug = (key) => String(key ?? "").toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

  const allPosts = await getCollection("posts");

  const paths = new Map<string, { city: string; topic: string; subtopic: string }>();

  for (const post of allPosts) {
    const city = (post.data.city ?? post.id?.split("/")[0] ?? "").toLowerCase().trim();
    if (!city) continue;

    const cat = typeof post.data.category === "string" ? post.data.category.trim() : "";
    const sub = typeof post.data.subtopic === "string" ? post.data.subtopic.trim() : "";
    if (!cat || !sub) continue;

    const topicSlug    = _tagSlug(_tagKey(cat));
    const subtopicSlug = _tagSlug(_tagKey(sub));
    if (!topicSlug || !subtopicSlug) continue;

    /* DIY subtopics have their own route: [city]/diy/[topic]/index.astro */
    if (topicSlug === "diy") continue;

    const key = `${city}|||${topicSlug}|||${subtopicSlug}`;
    if (!paths.has(key)) paths.set(key, { city, topic: topicSlug, subtopic: subtopicSlug });
  }

  return Array.from(paths.values()).map(({ city, topic, subtopic }) => ({
    params: { city, topic, subtopic },
    props:  { allPosts },
  }));
}

/* ── Page data ── */
const { city, topic, subtopic } = Astro.params;
/* allPosts passed from getStaticPaths — no second fetch needed */
const { allPosts } = Astro.props;

const topicKey     = tagKey(topic);
const subtopicKey  = tagKey(subtopic);
const topicLabel   = tagLabel(topicKey);
const subtopicLabel = tagLabel(subtopicKey);
const cityCap      = getDisplayName(city);

/* Filter posts: city + category === topic + subtopic === subtopic (case-insensitive) */
const posts = (allPosts as any[])
  .filter(post => {
    const postCity = (post.data.city ?? post.id?.split("/")[0] ?? "").toLowerCase().trim();
    return postCity === city;
  })
  .filter(post => {
    const cat = tagKey(post.data.category ?? "");
    const sub = tagKey(post.data.subtopic ?? "");
    return cat === topicKey && sub === subtopicKey;
  })
  .sort((a, b) => new Date(getPostDate(b) ?? 0).getTime() - new Date(getPostDate(a) ?? 0).getTime());

const hero = posts.find(isFeatured) ?? posts[0] ?? null;
const rest = hero ? posts.filter(p => p.slug !== hero.slug) : posts;

/* Helper: pick the right article URL for the city */
function articleHref(post) {
  const pCity = (post.data.city ?? post.id?.split("/")[0] ?? "").toLowerCase().trim();
  const slug  = post.slug.split("/").pop();
  if (pCity === "daytona") return `/daytona/posts/${slug}/`;
  return `/${pCity}/${slug}/`;
}
---

<Base title={`${subtopicLabel} | ${topicLabel} | GoDo${cityCap}`} cityBase={city}>
  <section class="stSection">
    <div class="stWrap">

      <div class="stHeader">
        <div class="stBreadcrumb">
          <a class="stBreadLink" href={`/${city}/${topic}/`}>{topicLabel}</a>
          <span class="stBreadSep" aria-hidden="true">›</span>
          <span class="stBreadCurrent">{subtopicLabel}</span>
        </div>
        <h1 class="stTitle">{subtopicLabel}</h1>
        <p class="stMeta">
          {posts.length > 0
            ? `${posts.length} article${posts.length === 1 ? "" : "s"}`
            : ""}
        </p>
      </div>

      <div class="stLayout">
        <div class="stMain">

          {/* ── Hero card ── */}
          {hero && (
            <a class="heroCard" href={articleHref(hero)}>
              <div class="heroMedia">
                <img class="heroImg" src={heroImage(hero)} alt={hero.data.title ?? ""}
                  loading="lazy" decoding="async"
                  onerror={`this.src='${FALLBACK_IMG}';this.onerror=null;`} />
              </div>
              <div class="heroBody">
                <div class="heroKicker">{topicLabel} — {subtopicLabel}</div>
                <div class="heroTitle">{hero.data.title}</div>
                {excerpt(hero) && <div class="heroDesc">{excerpt(hero)}</div>}
                <div class="heroMeta">{dateText(hero)}</div>
              </div>
            </a>
          )}

          {/* ── Article list ── */}
          {rest.length > 0 && (
            <div class="stList" id="stList">
              {rest.map((p, idx) => (
                <div class={`stRow${idx >= 9 ? " stRowHidden" : ""}`}>
                  <a class="stRowLink" href={articleHref(p)} aria-label={p.data.title ?? p.slug}></a>
                  <div class="stThumbWrap">
                    <img class="stThumb" src={thumbImage(p)} alt={p.data.title ?? ""}
                      loading="lazy" decoding="async"
                      onerror={`this.src='${FALLBACK_IMG}';this.onerror=null;`} />
                  </div>
                  <div class="stText">
                    <div class="stRowTitle">{p.data.title ?? p.slug}</div>
                    {excerpt(p) && <div class="stRowDesc">{excerpt(p)}</div>}
                    <div class="stRowMeta">{dateText(p)}</div>
                  </div>
                </div>
              ))}
            </div>
          )}

          {rest.length > 9 && (
            <button class="stLoadMore" id="stLoadMore" type="button">
              Load {rest.length - 9} more {rest.length - 9 === 1 ? "article" : "articles"}
            </button>
          )}

          {/* ── Coming Soon empty state ── */}
          {posts.length === 0 && (
            <div class="comingSoon">
              <div class="csIcon" aria-hidden="true">🚧</div>
              <h2 class="csTitle">Coming Soon</h2>
              <p class="csText">
                We're building out our <strong>{subtopicLabel}</strong> coverage.
                Check back soon — or explore all <strong>{topicLabel}</strong> stories now.
              </p>
              <a class="csBtn" href={`/${city}/${topic}/`}>← All {topicLabel} stories</a>
            </div>
          )}

          <p class="stFootLinks">
            <a class="stPill" href={`/${city}/${topic}/`}>← All {topicLabel}</a>
            <a class="stPill" href={`/${city}/topics/`}>All topics</a>
          </p>

        </div>

        <ArticleSidebar city={city} />
      </div>

    </div>
  </section>
</Base>

<style>
  :root {
    --card-radius: 18px;
    --card-border: rgba(255,255,255,.10);
    --card-border-hover: rgba(0,119,190,.30);
    --card-bg: rgba(255,255,255,.035);
    --card-bg-hover: rgba(255,255,255,.05);
    --shadow-soft: 0 10px 30px rgba(0,0,0,.24);
    --lift: translateY(-2px);
    --ease: 160ms ease;
  }

  .stSection { padding: 24px 0 64px; }
  .stWrap { max-width: 1280px; margin: 0 auto; padding: 0 2rem; }
  @media (max-width: 600px) { .stWrap { padding: 0 1rem; } }

  .stHeader { margin-bottom: 20px; }
  .stBreadcrumb {
    display: flex; align-items: center; gap: 6px;
    font-size: 0.8rem; font-weight: 900; letter-spacing: .12em;
    text-transform: uppercase; margin-bottom: 8px;
  }
  .stBreadLink { color: var(--brand1); text-decoration: none; transition: opacity 130ms; }
  .stBreadLink:hover { opacity: .72; }
  .stBreadSep { opacity: .4; font-weight: 400; }
  .stBreadCurrent { color: var(--text); font-weight: 700; }

  .stTitle {
    margin: 0 0 6px;
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 900; line-height: 1.02; letter-spacing: -0.02em;
  }
  .stMeta { opacity: .62; font-size: 14px; margin: 0; }

  .stLayout {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(380px, 3fr);
    gap: 56px;
    align-items: start;
  }
  .stMain { min-width: 0; }
  @media (max-width: 1150px) { .stLayout { grid-template-columns: 1fr; gap: 40px; } }

  /* ── Hero card ── */
  .heroCard {
    display: grid; grid-template-columns: 1.2fr 1fr;
    gap: 0; overflow: hidden; text-decoration: none; margin: 0 0 18px;
    border-radius: var(--card-radius); border: 1px solid var(--card-border);
    background: var(--card-bg);
    transition: transform var(--ease), background var(--ease), border-color var(--ease), box-shadow var(--ease);
  }
  @media (max-width: 880px) { .heroCard { grid-template-columns: 1fr; } }
  .heroCard:hover {
    transform: var(--lift); background: var(--card-bg-hover);
    border-color: var(--card-border-hover);
    box-shadow: 0 0 0 1px rgba(0,119,190,.08), var(--shadow-soft);
  }
  .heroMedia { position: relative; overflow: hidden; background: rgba(255,255,255,.02); }
  .heroImg { width: 100%; height: 100%; display: block; aspect-ratio: 4/3; object-fit: cover; }
  .heroBody { padding: 18px; display: flex; flex-direction: column; justify-content: center; min-width: 0; }
  .heroKicker {
    font-size: 12px; font-weight: 900; letter-spacing: .10em;
    opacity: .78; text-transform: uppercase; margin-bottom: 10px; color: var(--brand1);
  }
  .heroTitle { font-weight: 950; font-size: clamp(20px, 2vw, 28px); line-height: 1.10; letter-spacing: -0.015em; }
  .heroDesc { margin-top: 10px; opacity: .86; line-height: 1.5; font-size: 14px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .heroMeta { margin-top: 12px; opacity: .62; font-size: 12.5px; }

  /* ── Article list ── */
  .stList { display: grid; gap: 12px; margin-top: 6px; }
  .stRow {
    position: relative; display: grid; grid-template-columns: 1fr 2fr;
    gap: 14px; align-items: center; padding: 14px; cursor: pointer;
    border-radius: var(--card-radius); border: 1px solid var(--card-border);
    background: var(--card-bg);
    transition: transform var(--ease), background var(--ease), border-color var(--ease), box-shadow var(--ease);
  }
  .stRow:hover {
    transform: var(--lift); background: var(--card-bg-hover);
    border-color: var(--card-border-hover);
    box-shadow: 0 0 0 1px rgba(0,119,190,.08), var(--shadow-soft);
  }
  .stRowLink { position: absolute; inset: 0; z-index: 0; border-radius: var(--card-radius); text-decoration: none; }
  .stText { min-width: 0; }
  .stRowTitle { font-weight: 900; font-size: 17px; line-height: 1.18; letter-spacing: -0.01em; }
  .stRowDesc { margin-top: 7px; opacity: .84; font-size: 14px; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .stRowMeta { margin-top: 9px; opacity: .58; font-size: 12.5px; }
  .stThumbWrap { aspect-ratio: 4/3; border-radius: 14px; overflow: hidden; border: 1px solid rgba(255,255,255,.10); background: rgba(255,255,255,.02); }
  .stThumb { width: 100%; height: 100%; object-fit: cover; display: block; }

  .stRowHidden { display: none; }
  .stLoadMore {
    display: block; width: 100%; margin-top: 14px; padding: 14px;
    border-radius: var(--card-radius); border: 1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.04); color: inherit;
    font-weight: 800; font-size: 14px; cursor: pointer;
    transition: background var(--ease), border-color var(--ease);
  }
  .stLoadMore:hover { background: rgba(255,255,255,.07); border-color: rgba(0,119,190,.30); }

  /* ── Coming Soon empty state ── */
  .comingSoon {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 64px 32px; gap: 16px;
    border-radius: var(--card-radius); border: 1px solid var(--card-border);
    background: var(--card-bg);
  }
  .csIcon { font-size: 48px; line-height: 1; }
  .csTitle { margin: 0; font-size: 28px; font-weight: 900; letter-spacing: -0.02em; }
  .csText { margin: 0; opacity: .78; font-size: 16px; line-height: 1.6; max-width: 440px; }
  .csBtn {
    display: inline-block; padding: 12px 24px; border-radius: 999px;
    background: var(--brand1); color: #000;
    font-size: 13px; font-weight: 900; letter-spacing: .06em; text-transform: uppercase;
    text-decoration: none; transition: opacity 130ms;
    margin-top: 8px;
  }
  .csBtn:hover { opacity: .85; }

  /* ── Footer links ── */
  .stFootLinks { margin-top: 20px; display: flex; gap: 10px; flex-wrap: wrap; }
  .stPill {
    font-size: 13px; font-weight: 700; color: var(--brand1);
    text-decoration: none; transition: opacity 130ms;
  }
  .stPill:hover { opacity: .75; text-decoration: underline; }
</style>

<script is:inline>
(function () {
  var btn = document.getElementById("stLoadMore");
  if (btn) {
    btn.addEventListener("click", function () {
      document.querySelectorAll(".stRowHidden").forEach(function (el) {
        el.classList.remove("stRowHidden");
      });
      btn.style.display = "none";
    });
  }
})();
</script>
