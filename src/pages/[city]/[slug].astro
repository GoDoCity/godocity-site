---
/**
 * src/pages/[city]/[slug].astro
 * Dynamic Article Template — GoDoCity news & editorial posts v2
 */
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts
    .filter((post) => {
      const city = post.data.city ?? post.slug.split("/")[0];
      return typeof city === "string" && city.length > 0;
    })
    .map((post) => {
      const city = post.data.city ?? post.slug.split("/")[0];
      const slug = post.slug.split("/").pop();
      return { params: { city, slug }, props: { post } };
    });
}

const { post }    = Astro.props;
const { data }    = post;
const { Content } = await render(post);

const city    = data.city ?? post.slug.split("/")[0];
const cityCap = city.charAt(0).toUpperCase() + city.slice(1);

/* ── Helpers ── */
function tagSlugFromRaw(raw) {
  return String(raw ?? "").toLowerCase().trim()
    .replace(/\s*&\s*/g, " ")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
}
function getPostDate(d) {
  return d?.pubDate ?? d?.date ?? d?.published ?? d?.updated ?? null;
}

/* ── CMS field reads — no tag fallbacks ── */
const category   = typeof data.category   === "string" ? data.category.trim()   : "";
const subtopic   = typeof data.subtopic   === "string" ? data.subtopic.trim()   : "";
const authorName = typeof data.author     === "string" && data.author.trim()
                   ? data.author.trim() : "Charles King";
const tierRaw    = typeof data.sponsorTier === "string" ? data.sponsorTier.trim() : "";
const isSponsored = tierRaw !== "" && tierRaw !== "None";

/* Kicker: sponsored tier label OR category — no tag fallback */
const categorySlug   = category ? tagSlugFromRaw(category) : "";
const kickerDisplay  = isSponsored
  ? tierRaw.toUpperCase()
  : category ? category.toUpperCase() : "";

/* ── Byline: "March 5, 2026 — Charles King" ── */
const pubDateRaw = getPostDate(data);
const MONTH_NAMES = ["January","February","March","April","May","June","July","August","September","October","November","December"];
const dateStr = pubDateRaw
  ? (() => { const d = new Date(pubDateRaw); return `${MONTH_NAMES[d.getUTCMonth()]} ${d.getUTCDate()}, ${d.getUTCFullYear()}`; })()
  : "";
const bylineStr = dateStr ? `${dateStr} — ${authorName}` : authorName;

/* ── Hero image ── */
const heroImg = data.heroImage ?? data.heroimage ?? data.image ?? data.thumbnail ?? data.cover ?? "";

let sponsor: {
  brand: string; tagline: string; body: string;
  logo?: string; img?: string; imgAlt?: string;
  ctaText?: string; ctaHref: string;
} | null = null;

try {
  const allGlobal = await getCollection("globalSponsors");
  const activeSponsor = allGlobal
    .filter((s) => s.data.active !== false)
    .filter((s) => s.data.brand)
    .sort((a, b) =>
      new Date(b.data.pubDate ?? 0).getTime() -
      new Date(a.data.pubDate ?? 0).getTime()
    );
  if (activeSponsor.length > 0) sponsor = activeSponsor[0].data;
} catch {
  sponsor = null;
}

// Upcoming events — future only, this city, soonest first
const today = new Date();
today.setHours(0, 0, 0, 0);

let allEvents = [];
try {
  allEvents = await getCollection("events");
} catch {
  allEvents = [];
}

const pageCity = city.toLowerCase().trim();

const upcomingEvents = allEvents
  .filter(e => {
    const evCity = (e.data.city ?? e.slug.split("/")[0]).toLowerCase().trim();
    const evDate = new Date(e.data.eventDate);
    evDate.setHours(0, 0, 0, 0);
    return evCity === pageCity && evDate >= today;
  })
  .sort((a, b) => new Date(a.data.eventDate).getTime() - new Date(b.data.eventDate).getTime())
  .slice(0, 4);

const CK_SRC = "data:image/jpeg;base64,";
---

<Base
  title={`${data.title} | GoDo ${cityCap}`}
  subtitle={`Good news for ${cityCap}`}
  cityBase={city}
>
<div class="pageWrap">
  <div class="container">
    <div class="homeGrid">

      <main class="articleMain">
        <header class="articleHeader">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a class="bcLink" href={`/${city}/`}>{cityCap}</a>
            <span class="bcSep" aria-hidden="true">/</span>
            {categorySlug && <a class="bcLink" href={`/${city}/${categorySlug}/`}>{category}</a>}
            {categorySlug && <span class="bcSep" aria-hidden="true">/</span>}
            <span class="bcCurrent" aria-current="page">{data.title}</span>
          </nav>
          {kickerDisplay && (
            <div class="articleKicker">
              {isSponsored
                ? <span class="kickerSponsored">{kickerDisplay}</span>
                : <a class="kickerLink" href={`/${city}/${categorySlug}/`}>{kickerDisplay}</a>
              }
              {subtopic && <span class="kickerSub"> — {subtopic}</span>}
            </div>
          )}
          <p class="articleByline">{bylineStr}</p>
          <h1 class="articleTitle">{data.title}</h1>
          {data.description && <p class="articleDesc">{data.description}</p>}
        </header>

        {heroImg && (
          <div class="heroWrap">
            <img class="heroImg" src={heroImg} alt={data.title}
              loading="eager" decoding="async"
              onerror="this.closest('.heroWrap').style.display='none'" />
          </div>
        )}

        <div class="articleBody prose">
          <Content />
        </div>

        {sponsor && (
          <div class="articleSponsor" role="complementary"
            aria-label={`Presented by ${sponsor.brand}`}>
            <div class="aSponsorLabel">
              <span class="aSponsorLabelText">Presented by</span>
            </div>
            <div class="aSponsorCard">
              {sponsor.img && (
                <div class="aSponsorImgWrap">
                  <img class="aSponsorImg" src={sponsor.img}
                    alt={sponsor.imgAlt || sponsor.brand} loading="lazy" decoding="async" />
                </div>
              )}
              <div class="aSponsorBody">
                <div class="aSponsorMeta">
                  {sponsor.logo && <img class="aSponsorLogo" src={sponsor.logo} alt={`${sponsor.brand} logo`} loading="lazy" />}
                  <span class="aSponsorBrand">{sponsor.brand}</span>
                </div>
                <div class="aSponsorTagline">{sponsor.tagline}</div>
                <p class="aSponsorText">{sponsor.body}</p>
                <a class="aSponsorCta" href={sponsor.ctaHref} target="_blank" rel="noopener sponsored">
                  {sponsor.ctaText ?? "Learn more"} →
                </a>
              </div>
            </div>
          </div>
        )}

        <div class="relatedSection">
          <div class="relatedHead">More from {cityCap}</div>
          <a class="relatedBack" href={`/${city}/`}>← Back to {cityCap} news</a>
        </div>
      </main>

      <aside class="homeRail">

        <div class="editTeamSection">
          <div class="railHead">
            <span class="railTitle editTeamTitle">GoDoCity Editorial Team</span>
          </div>
          <div class="editTeamRow">
            <img class="editHeadshot" src={CK_SRC} alt="Charles King"
              width="80" height="80" loading="eager"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
            <div class="editHeadshotFallback" aria-hidden="true">CK</div>
            <div class="editTeamInfo">
              <div class="editName">Charles King</div>
              <div class="editTitle">Newsletter Editor</div>
            </div>
          </div>
        </div>

        {/* Upcoming Events */}
        <div class="railSection">
          <div class="railHead">
            <span class="railTitle">Upcoming Events</span>
            <a class="railMore" href={`/${city}/events/`}>See all</a>
          </div>
          <div class="eventList">
            {upcomingEvents.length > 0 ? upcomingEvents.map(e => {
              const d   = new Date(e.data.eventDate);
              const dow = d.toLocaleDateString("en-US", { weekday: "short" }).toUpperCase();
              const day = d.getDate();
              const mon = d.toLocaleDateString("en-US", { month: "short" }).toUpperCase();
              return (
                <a class="eventRow"
                   href={e.data.url ?? `/${city}/events/${e.slug.split("/").pop()}/`}
                   target={e.data.url ? "_blank" : "_self"}
                   rel={e.data.url ? "noopener" : ""}>
                  <div class="eventCal">
                    <div class="eDow">{dow}</div>
                    <div class="eDay">{day}</div>
                    <div class="eMon">{mon}</div>
                  </div>
                  <div class="eventInfo">
                    <div class="eName">{e.data.title}</div>
                    <div class="ePlace">{e.data.location}</div>
                  </div>
                </a>
              );
            }) : (
              <p class="noEvents">No upcoming events.</p>
            )}
          </div>
        </div>

        <div class="displayAdSlot">
          <div class="adSlotLabel">Advertisement</div>
          <a class="displayAdCard" href={`/${city}/advertise/`}>
            <div class="displayAdInner">
              <div class="displayAdIcon">📢</div>
              <div class="displayAdTitle">Your Ad Here</div>
              <div class="displayAdDesc">Reach thousands of {cityCap} locals</div>
              <div class="displayAdCta">Advertise with us →</div>
            </div>
          </a>
        </div>

        <div class="railSection">
          <div class="railHead">
            <span class="railTitle">City Guides</span>
            <a class="railMore" href={`/${city}/guides/`}>See all</a>
          </div>
          <div class="guideList">
            <a class="guideRow" href={`/${city}/guides/live/`}>🏠 Live in {cityCap}</a>
            <a class="guideRow" href={`/${city}/guides/work/`}>💼 Work in {cityCap}</a>
            <a class="guideRow" href={`/${city}/guides/play/`}>🎉 Play in {cityCap}</a>
            <a class="guideRow" href={`/${city}/guides/best-restaurants/`}>🍽️ Best Restaurants</a>
          </div>
        </div>

        <div class="nlBox">
          <div class="nlBoxHead"><em>Good News <strong>{cityCap}!</strong></em></div>
          <div class="nlBoxSub">Free local news in your inbox every morning.</div>
          <a class="nlBoxBtn" href={`/${city}/subscribe/`}>Subscribe free →</a>
        </div>

      </aside>
    </div>
  </div>
</div>

<style>
  :global(html), :global(body) { overflow-x: hidden; width: 100%; position: relative; }
  .pageWrap { min-height: 100vh; overflow-x: hidden; width: 100%; }
  :global(.container) { max-width: 1280px; margin: 0 auto; padding: 0 2.5rem; }
  @media (max-width: 768px) { :global(.container) { max-width: 100%; padding: 0 1.25rem; } }

  .homeGrid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 290px;
    gap: clamp(40px, 4vw, 56px);
    align-items: start;
    padding: 40px 0 56px;
  }
  .homeGrid > * { min-width: 0; overflow: hidden; }
  @media (max-width: 980px) { .homeGrid { grid-template-columns: 1fr; } .homeRail { order: 2; } }

  .breadcrumb { display: flex; align-items: center; flex-wrap: wrap; gap: 4px; margin-bottom: 16px; font-size: 12.5px; font-weight: 600; color: var(--faint); }
  .bcLink { color: var(--link); text-decoration: none; transition: opacity 120ms; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 160px; }
  .bcLink:hover { opacity: .75; }
  .bcSep { color: var(--border); }
  .bcCurrent { color: var(--faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 240px; }

  .articleKicker { display: flex; align-items: baseline; gap: 0; margin-bottom: 8px; font-size: 10.5px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .kickerLink { color: var(--brand1); text-decoration: none; font-weight: 800; transition: opacity 140ms; }
  .kickerLink:hover { opacity: .75; }
  .kickerSub { color: var(--brand1); font-weight: 700; }
  .kickerSponsored { color: var(--brand1); font-weight: 800; font-style: italic; }

  .articleTitle { font-size: clamp(26px, 3.2vw, 36px); font-weight: 900; font-family: "Century Gothic", AppleGothic, Arial, sans-serif; line-height: 1.08; letter-spacing: -0.5px; color: var(--text); margin: 0 0 18px; max-width: 720px; }

  .articleByline { font-size: 13px; color: var(--faint); margin: 0 0 22px; font-weight: 500; }

  .articleDesc { font-size: clamp(15px, 1.15vw, 17px); color: var(--muted); line-height: 1.65; border-left: 3px solid var(--brand1); padding-left: 16px; margin: 0 0 28px; max-width: 660px; }

  .heroWrap { width: 100%; max-width: 100%; max-height: 480px; aspect-ratio: 16/9; border-radius: 14px; overflow: hidden; background: var(--surface2); margin-bottom: 32px; display: block; box-sizing: border-box; }
  .heroImg { width: 100%; max-width: 100%; height: 100%; max-height: 480px; object-fit: cover; object-position: center; display: block; }

  .articleBody img { max-width: 100%; height: auto; display: block; margin: 1.5rem 0; border-radius: 8px; object-fit: cover; }

  .articleBody { font-size: 16px; line-height: 1.75; color: var(--muted); max-width: 680px; padding-bottom: 40px; border-bottom: 1px solid var(--border); }
  .articleBody :global(h2) { font-size: 22px; font-weight: 900; font-family: "Century Gothic", AppleGothic, Arial, sans-serif; color: var(--text); margin: 36px 0 12px; line-height: 1.15; }
  .articleBody :global(h3) { font-size: 18px; font-weight: 800; font-family: "Century Gothic", AppleGothic, Arial, sans-serif; color: var(--text); margin: 28px 0 10px; line-height: 1.2; }
  .articleBody :global(p) { margin: 0 0 1.4em; }
  .articleBody :global(a) { color: var(--link); text-decoration: underline; }
  .articleBody :global(strong) { font-weight: 800; color: var(--text); }
  .articleBody :global(ul), .articleBody :global(ol) { padding-left: 1.4em; margin: 0 0 1.4em; }
  .articleBody :global(li) { margin-bottom: .5em; }
  .articleBody :global(blockquote) { border-left: 3px solid var(--brand1); margin: 1.6em 0; padding: .6em 1em; color: var(--text); font-style: italic; font-size: 17px; }
  .articleBody :global(img) { width: 100%; max-width: 100%; height: auto; border-radius: 10px; margin: 1.4em 0; display: block; }
  .articleBody :global(hr) { border: none; border-top: 1px solid var(--border); margin: 2em 0; }

  .articleSponsor { margin: 40px 0 8px; }
  .aSponsorLabel { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
  .aSponsorLabel::before, .aSponsorLabel::after { content: ""; flex: 1; height: 1px; background: var(--border); }
  .aSponsorLabelText { font-size: 9.5px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--faint); white-space: nowrap; padding: 0 6px; }
  .aSponsorCard { display: grid; grid-template-columns: 240px 1fr; gap: 0; border: 1.5px solid var(--border); border-radius: 16px; overflow: hidden; background: var(--pillBg); transition: border-color 200ms; }
  .aSponsorCard:hover { border-color: var(--brand1); }
  .aSponsorImgWrap { width: 240px; aspect-ratio: 16/10; overflow: hidden; }
  .aSponsorImg { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 360ms ease; will-change: transform; }
  .aSponsorCard:hover .aSponsorImg { transform: scale(1.04); }
  .aSponsorBody { padding: 28px 30px; display: flex; flex-direction: column; gap: 9px; justify-content: center; }
  .aSponsorMeta { display: flex; align-items: center; gap: 10px; }
  .aSponsorLogo { height: 28px; width: auto; object-fit: contain; }
  .aSponsorBrand { font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--faint); }
  .aSponsorTagline { font-size: 22px; font-weight: 900; line-height: 1.12; letter-spacing: -0.3px; color: var(--text); font-family: "Century Gothic", AppleGothic, Arial, sans-serif; }
  .aSponsorText { font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0; max-width: 440px; }
  .aSponsorCta { display: inline-flex; align-items: center; align-self: flex-start; margin-top: 4px; height: 40px; padding: 0 20px; border-radius: 999px; background: var(--brand1); color: var(--accentText); font-size: 13px; font-weight: 800; text-decoration: none; transition: opacity 150ms; }
  .aSponsorCta:hover { opacity: .86; }
  .aSponsorCard:not(:has(.aSponsorImgWrap)) { grid-template-columns: 1fr; }
  .aSponsorCard:not(:has(.aSponsorImgWrap)) .aSponsorBody { padding: 24px 26px; }

  .relatedSection { margin-top: 36px; padding-top: 28px; border-top: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
  .relatedHead { font-size: 16px; font-weight: 900; letter-spacing: .06em; text-transform: uppercase; color: var(--text); }
  .relatedBack { font-size: 13.5px; font-weight: 700; color: var(--link); text-decoration: none; border-bottom: 1.5px solid transparent; transition: border-color 140ms; padding-bottom: 1px; }
  .relatedBack:hover { border-color: var(--link); }

  .homeRail { position: sticky; top: 80px; display: grid; gap: 24px; align-self: start; }
  .railSection { display: grid; gap: 0; }
  .railHead { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 10px; border-bottom: 2px solid var(--brand1); }
  .railTitle { font-size: 16px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; color: var(--text); }
  .editTeamTitle { white-space: nowrap; letter-spacing: -0.02em; }
  .railMore { font-size: 13px; font-weight: 700; color: var(--link); text-decoration: none; }
  .railMore:hover { text-decoration: underline; }

  .editTeamSection { display: grid; gap: 0; }
  .editTeamRow { display: flex; align-items: center; padding-top: 12px; }
  .editHeadshot { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; flex-shrink: 0; margin-right: 15px; background: var(--surface2); border: 2px solid var(--border); }
  .editHeadshotFallback { display: none; width: 80px; height: 80px; border-radius: 50%; background: var(--brand1); color: #000; font-size: 22px; font-weight: 900; align-items: center; justify-content: center; flex-shrink: 0; margin-right: 15px; border: 2px solid var(--border); }
  .editTeamInfo { display: flex; flex-direction: column; justify-content: center; gap: 3px; }
  .editName { font-size: 15px; font-weight: 700; color: var(--text); line-height: 1.2; }
  .editTitle { font-size: 14px; color: var(--faint); line-height: 1.3; }

  .eventList { display: grid; }
  .eventRow { display: grid; grid-template-columns: 48px 1fr; gap: 12px; align-items: center; text-decoration: none; padding: 13px 0; border-bottom: 1px solid var(--border); transition: opacity 140ms; }
  .eventRow:last-child { border-bottom: none; }
  .eventRow:hover { opacity: .76; }
  .eventCal { width: 48px; height: 48px; border-radius: 10px; background: var(--pillBg); border: 1px solid var(--pillBorder); display: grid; place-items: center; text-align: center; line-height: 1; }
  .eDow { font-size: 10px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; color: var(--brand1); }
  .eDay { font-size: 19px; font-weight: 900; color: var(--text); margin-top: 1px; }
  .eMon { font-size: 8px; font-weight: 700; letter-spacing: .08em; color: var(--faint); text-transform: uppercase; }
  .eventInfo { display: flex; flex-direction: column; gap: 2px; }
  .eName { font-weight: 800; font-size: 15px; color: var(--text); line-height: 1.2; }
  .ePlace { font-size: 13px; color: var(--faint); }
  .noEvents { font-size: 13px; color: var(--faint); padding: 12px 0; margin: 0; }

  .displayAdSlot { display: grid; gap: 5px; }
  .adSlotLabel { font-size: 8.5px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--faint); text-align: center; }
  .displayAdCard { display: block; text-decoration: none; border: 1.5px dashed var(--pillBorder); border-radius: 13px; background: var(--pillBg); transition: border-color 140ms; }
  .displayAdCard:hover { border-color: var(--brand1); }
  .displayAdInner { padding: 22px 14px; text-align: center; display: grid; gap: 5px; place-items: center; }
  .displayAdIcon { font-size: 24px; margin-bottom: 2px; }
  .displayAdTitle { font-size: 16px; font-weight: 900; color: var(--text); }
  .displayAdDesc { font-size: 14px; color: var(--muted); line-height: 1.3; }
  .displayAdCta { margin-top: 6px; display: inline-flex; align-items: center; height: 30px; padding: 0 13px; border-radius: 999px; background: var(--brand1); color: var(--accentText); font-size: 11.5px; font-weight: 800; }

  .guideList { display: grid; }
  .guideRow { display: block; text-decoration: none; font-size: 15px; font-weight: 700; color: var(--text); padding: 11px 0; border-bottom: 1px solid var(--border); line-height: 1.3; transition: color 120ms; }
  .guideRow:last-child { border-bottom: none; }
  .guideRow:hover { color: var(--link); }

  .nlBox { padding: 18px 16px; border-radius: 14px; background: var(--brand1); display: flex; flex-direction: column; gap: 7px; }
  .nlBoxHead { font-size: 18px; font-weight: 900; font-style: italic; color: #000; line-height: 1.1; letter-spacing: -0.03em; }
  .nlBoxHead strong { font-weight: 900; }
  .nlBoxSub { font-size: 13px; color: rgba(0,0,0,.7); line-height: 1.35; }
  .nlBoxBtn { display: inline-flex; align-items: center; height: 36px; padding: 0 14px; border-radius: 999px; background: #000; color: #fff; font-size: 12.5px; font-weight: 800; text-decoration: none; align-self: flex-start; margin-top: 2px; transition: opacity 140ms; }
  .nlBoxBtn:hover { opacity: .82; }

  @media (max-width: 768px) {
    .homeGrid { padding: 24px 0 40px; }
    .articleTitle { letter-spacing: -0.3px; }
    .heroWrap { border-radius: 10px; margin-bottom: 24px; }
    .articleBody { font-size: 15px; max-width: 100%; }
    .articleDesc { font-size: 15px; }
    .aSponsorCard { grid-template-columns: 1fr; }
    .aSponsorImgWrap { width: 100%; aspect-ratio: 16/9; }
    .aSponsorBody { padding: 20px 22px; }
    .aSponsorTagline { font-size: 18px; }
  }
  @media (max-width: 480px) {
    .articleTitle { font-size: 22px; }
    .breadcrumb { font-size: 11px; }
    .bcCurrent { max-width: 140px; }
  }
</style>
</Base>
