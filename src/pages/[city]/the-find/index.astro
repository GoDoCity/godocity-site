---
/**
 * src/pages/[city]/the-find/index.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * "The Find" hub — one product-roundup feed per configured city.
 *
 * URL: /[city]/the-find/   (e.g. /daytona/the-find/, /asheville/the-find/)
 *
 * Feed = network-wide roundups (scope: network) + this city's city-specific
 * roundups (scope: city, cityTag: <city>). Network-wide roundups appear on
 * every city automatically — no re-authoring required.
 * ─────────────────────────────────────────────────────────────────────────────
 */
import Base from "../../../layouts/Base.astro";
import ArticleSidebar from "../../../components/ArticleSidebar.astro";
import { getCollection } from "astro:content";
import { allCitySlugs, getShortName } from "../../../lib/cityConfigs.js";
import { roundupInCity } from "../../../lib/theFind.ts";

export async function getStaticPaths() {
  return allCitySlugs.map((slug: string) => ({ params: { city: slug } }));
}

const { city } = Astro.params;
const cityLabel = getShortName(city);
const FALLBACK_IMG = "/images/old-mural-backup.png";

const allRoundups = await getCollection("the-find");
const roundups = allRoundups
  .filter((e) => roundupInCity(e.data, city))
  .sort(
    (a, b) => new Date(b.data.pubDate ?? 0).getTime() - new Date(a.data.pubDate ?? 0).getTime()
  );

function formatDate(d: Date | null | undefined): string {
  if (!d) return "";
  try {
    return new Date(d).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
  } catch {
    return "";
  }
}
---

<Base title={`The Find | GoDo${cityLabel}`} subtitle="Product roundups worth your money — vetted by GoDo editors." cityBase={city}>
  <section class="findLanding">
    <div class="findContainer">

      <div class="findMain">
        <div class="landingKicker">
          <span class="kCity">{cityLabel}</span>
          <span class="kSep">/</span>
          <span class="kCat">The Find</span>
        </div>

        <h1 class="landingTitle">The Find</h1>
        <p class="landingLede">Curated product roundups — the local gear, gifts, and gadgets our editors actually recommend.</p>
        <p class="landingCount">{roundups.length} roundup{roundups.length !== 1 ? "s" : ""}</p>

        {roundups.length === 0 ? (
          <p class="emptyState">No roundups yet for {cityLabel}. Check back soon!</p>
        ) : (
          <ul class="findList">
            {roundups.map((r) => {
              const dateStr = formatDate(r.data.pubDate);
              const count = (r.data.products ?? []).length;
              const img = r.data.coverImage || FALLBACK_IMG;
              const isLocal = r.data.scope === "city";
              return (
                <li class="findCard">
                  <a class="cardLink" href={`/${city}/the-find/${r.slug}/`} aria-label={`Read: ${r.data.title}`}>
                    <div class="cardThumbWrap">
                      <img class="cardThumb" src={img} alt="" loading="lazy" decoding="async"
                        onerror={`this.src='${FALLBACK_IMG}';this.onerror=null;`} />
                    </div>
                    <div class="cardBody">
                      <div class="cardKicker">
                        <span class="kFindPill">THE FIND</span>
                        {isLocal
                          ? <span class="kScope kScopeLocal">LOCAL</span>
                          : <span class="kScope">NETWORK PICK</span>}
                        {count > 0 && <span class="kCount">{count} pick{count !== 1 ? "s" : ""}</span>}
                      </div>
                      <div class="cardTitle">{r.data.title}</div>
                      {dateStr && <div class="cardDate">{dateStr}</div>}
                      {r.data.intro && <div class="cardDesc">{r.data.intro}</div>}
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        )}
      </div>

      <ArticleSidebar city={city} pageType="The Find" />

    </div>
  </section>
</Base>

<style>
  .findLanding { padding: 28px 0 64px; }

  .findContainer {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 48px;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 2rem;
    align-items: start;
  }
  .findMain { min-width: 0; }
  @media (max-width: 1023px) {
    .findContainer { grid-template-columns: 1fr; }
  }

  .landingKicker {
    display: flex; align-items: center; gap: 8px;
    font-size: 11px; font-weight: 900; letter-spacing: .12em;
    text-transform: uppercase; margin-bottom: 12px;
  }
  .kCity { color: var(--pill-find, var(--brand1)); }
  .kSep  { opacity: .35; }
  .kCat  { color: var(--muted); }

  .landingTitle {
    font-size: clamp(28px, 4vw, 48px); font-weight: 900;
    line-height: 1.06; letter-spacing: -0.6px;
    margin: 0 0 10px;
  }
  .landingLede  { font-size: 16px; color: var(--color-text-main); opacity: .85; margin: 0 0 6px; max-width: 640px; }
  .landingCount { font-size: 13px; opacity: .55; margin: 0 0 28px; }

  .emptyState { color: var(--muted); font-size: 16px; margin: 40px 0; }

  .findList {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: 14px;
  }

  .findCard {
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 14px;
    background: rgba(255,255,255,.02);
    overflow: hidden;
    transition: border-color .14s, background .14s;
  }
  .findCard:hover {
    border-color: color-mix(in srgb, var(--pill-find) 40%, transparent);
    background: rgba(255,255,255,.04);
  }

  .cardLink {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 18px;
    align-items: center;
    text-decoration: none;
    color: inherit;
    padding: 14px;
  }

  .cardThumbWrap {
    aspect-ratio: 4/3; border-radius: 10px; overflow: hidden;
    border: 1px solid rgba(255,255,255,.08);
    background: rgba(255,255,255,.03);
  }
  .cardThumb { width: 100%; height: 100%; object-fit: cover; display: block; }

  .cardBody { min-width: 0; }

  .cardKicker { display: flex; gap: 8px; align-items: center; margin-bottom: 7px; flex-wrap: wrap; }
  .kFindPill {
    font-size: 10px; font-weight: 900; letter-spacing: .1em;
    text-transform: uppercase; padding: 2px 8px; border-radius: 999px;
    background: color-mix(in srgb, var(--pill-find) 14%, transparent);
    color: var(--pill-find);
    border: 1px solid color-mix(in srgb, var(--pill-find) 45%, transparent);
  }
  .kScope {
    font-size: 9.5px; font-weight: 900; letter-spacing: .1em;
    text-transform: uppercase; padding: 2px 7px; border-radius: 999px;
    background: rgba(120,120,120,.12); color: var(--muted);
    border: 1px solid rgba(120,120,120,.28);
  }
  .kScopeLocal {
    background: color-mix(in srgb, var(--pill-find) 12%, transparent);
    color: var(--pill-find);
    border-color: color-mix(in srgb, var(--pill-find) 40%, transparent);
  }
  .kCount { font-size: 11px; font-weight: 700; opacity: .55; }

  .cardTitle {
    font-size: 18px; font-weight: 900; line-height: 1.18;
    margin: 0 0 6px; letter-spacing: -0.2px;
  }
  .cardDate {
    font-size: 12px; opacity: .55; font-weight: 700;
    margin-bottom: 6px;
  }
  .cardDesc {
    font-size: 14px; color: var(--color-text-main); line-height: 1.55; opacity: .85;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .cardLink { grid-template-columns: 1fr; }
    .cardThumbWrap { aspect-ratio: 16/9; border-radius: 8px; }
  }
</style>
