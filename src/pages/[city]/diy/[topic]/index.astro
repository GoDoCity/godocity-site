---
/**
 * src/pages/[city]/diy/[topic]/index.astro
 * DIY subtopic feed — merges the `diy` collection AND posts (category:DIY)
 * for the given city and topic slug.
 * URL pattern: /daytona/diy/paint/  /daytona/diy/maintain/
 */
import Base from "../../../../layouts/Base.astro";
import ArticleSidebar from "../../../../components/ArticleSidebar.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const DIY_TOPICS = ["clean", "paint", "body-mind", "maintain", "decorate", "craft", "recipe", "build"];
  const diyEntries  = await getCollection("diy");
  const allPosts    = await getCollection("posts");

  const paths = new Map<string, { city: string; topic: string }>();

  /* Paths from `diy` collection */
  for (const entry of diyEntries) {
    if (!entry.data.topic) continue;
    const topicSlug = entry.data.topic.toLowerCase().trim();
    for (const city of (entry.data.cities ?? [])) {
      paths.set(`${city}/${topicSlug}`, { city, topic: topicSlug });
    }
  }

  /* Paths from `posts` collection where category=DIY and subtopic is set */
  for (const post of allPosts) {
    const cat = String(post.data.category ?? "").toLowerCase().trim();
    if (cat !== "diy") continue;
    const sub  = String(post.data.subtopic ?? "").toLowerCase().trim();
    if (!sub) continue;
    const city = (post.data.city ?? post.id?.split("/")[0] ?? "").toLowerCase().trim();
    if (!city) continue;
    paths.set(`${city}/${sub}`, { city, topic: sub });
  }

  /* Always generate the standard 7 topics for any city that has diy/posts content */
  const citySet = new Set<string>();
  for (const [, { city }] of paths) citySet.add(city);
  for (const city of citySet) {
    for (const topic of DIY_TOPICS) {
      if (!paths.has(`${city}/${topic}`)) paths.set(`${city}/${topic}`, { city, topic });
    }
  }

  return Array.from(paths.values()).map(({ city, topic }) => ({
    params: { city, topic },
    props:  { allPosts, allDiy: diyEntries },
  }));
}

const { city, topic } = Astro.params;
/* allPosts + allDiy passed from getStaticPaths — no second fetch needed */
const { allPosts, allDiy } = Astro.props as { allPosts: any[]; allDiy: any[] };

const cityLabel  = city.charAt(0).toUpperCase() + city.slice(1);
/* Multi-word topic slugs get a friendly display label; others title-case. */
const TOPIC_LABELS: Record<string, string> = { "body-mind": "Body & Mind" };
const topicLabel = TOPIC_LABELS[topic] ?? (topic.charAt(0).toUpperCase() + topic.slice(1));

/* ── Unified data: diy collection + posts (category=DIY, subtopic=topic) ── */

function getPostDate(item: any) {
  return item?.data?.pubDate ?? item?.data?.date ?? item?.data?.published ?? item?.data?.updated ?? null;
}
function formatDate(d: any): string {
  if (!d) return "";
  // pubDate is date-only in frontmatter, so it parses as UTC midnight. Format
  // in UTC — rendering in a negative-offset zone would show the previous day.
  try { return new Date(d).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" }); } catch { return ""; }
}
const FALLBACK_IMG = "/images/old-mural-backup.png";

const diyItems = allDiy
  .filter(e =>
    Array.isArray(e.data.cities) && e.data.cities.includes(city) &&
    String(e.data.topic ?? "").toLowerCase().trim() === topic.toLowerCase()
  )
  .map(e => ({
    title:  e.data.title,
    date:   formatDate(getPostDate(e)),
    ts:     new Date(getPostDate(e) ?? 0).getTime(),
    img:    e.data.heroImage || FALLBACK_IMG,
    desc:   String(e.data.intro ?? "").split(/\n\n+/)[0].substring(0, 160),
    href:   `/diy/${e.slug}/`,
    source: "diy" as const,
  }));

const postItems = allPosts
  .filter(post => {
    const postCity = (post.data.city ?? post.id?.split("/")[0] ?? "").toLowerCase().trim();
    const cat = String(post.data.category ?? "").toLowerCase().trim();
    const sub = String(post.data.subtopic ?? "").toLowerCase().trim();
    return postCity === city && cat === "diy" && sub === topic.toLowerCase();
  })
  .map(post => {
    const slug = post.slug.split("/").pop();
    const href = city === "daytona" ? `/daytona/posts/${slug}/` : `/${city}/${slug}/`;
    const img  = String(post.data.heroImage || post.data.thumbnail || post.data.image || "").trim() || FALLBACK_IMG;
    return {
      title:  post.data.title ?? post.slug,
      date:   formatDate(getPostDate(post)),
      ts:     new Date(getPostDate(post) ?? 0).getTime(),
      img,
      desc:   post.data.description ?? "",
      href,
      source: "post" as const,
    };
  });

/* Merge, deduplicate by href, sort newest first */
const seen = new Set<string>();
const guides = [...diyItems, ...postItems]
  .filter(item => { if (seen.has(item.href)) return false; seen.add(item.href); return true; })
  .sort((a, b) => b.ts - a.ts);
---

<Base
  title={`${topicLabel} DIY | GoDo${cityLabel}`}
  cityBase={city}
>
  <section class="diyTopicLanding">
    <div class="dtWrap">

      {/* ── Page header (full width, above the grid) ── */}
      <div class="stHeader">
        <div class="stBreadcrumb">
          <a class="stBreadLink" href={`/${city}/diy/`}>DIY</a>
          <span class="stBreadSep" aria-hidden="true">›</span>
          <span class="stBreadCurrent">{topicLabel.toUpperCase()}</span>
        </div>
        <h1 class="stTitle">{topicLabel}</h1>
        <p class="stMeta">
          {guides.length > 0
            ? `${guides.length} guide${guides.length !== 1 ? "s" : ""}`
            : ""}
        </p>
      </div>

      {/* ── Two-column layout: main content + sidebar ── */}
      <div class="dtLayout">
        <div class="dtMain">

          {guides.length === 0 ? (
            <div class="comingSoon">
              <div class="csIcon" aria-hidden="true">🚧</div>
              <h2 class="csTitle">Coming Soon</h2>
              <p class="csText">
                We're building out our <strong>{topicLabel}</strong> DIY guides for {cityLabel}.
                Check back soon — or explore all DIY content now.
              </p>
              <a class="csBtn" href={`/${city}/diy/`}>← All DIY guides</a>
            </div>
          ) : (
            <>
              {/* ── Hero card: first guide ── */}
              {guides[0] && (
                <a class="heroCard" href={guides[0].href}>
                  <div class="heroMedia">
                    <img class="heroImg" src={guides[0].img} alt={guides[0].title}
                      loading="lazy" decoding="async"
                      onerror={`this.src='${FALLBACK_IMG}';this.onerror=null;`} />
                  </div>
                  <div class="heroBody">
                    <div class="heroKicker">DIY — {topicLabel}</div>
                    <div class="heroTitle">{guides[0].title}</div>
                    {guides[0].desc && <div class="heroDesc">{guides[0].desc}</div>}
                    {guides[0].date && <div class="heroMeta">{guides[0].date}</div>}
                  </div>
                </a>
              )}

              {/* ── List rows: remaining guides ── */}
              {guides.length > 1 && (
                <ul class="diyList">
                  {guides.slice(1).map((item) => (
                    <li class="diyCard">
                      <a class="cardLink" href={item.href} aria-label={`Read: ${item.title}`}>
                        <div class="cardThumbWrap">
                          <img class="cardThumb" src={item.img} alt=""
                            loading="lazy" decoding="async"
                            onerror={`this.src='${FALLBACK_IMG}';this.onerror=null;`} />
                        </div>
                        <div class="cardBody">
                          <div class="cardKicker">
                            <span class="kTopicPill">DIY — {topicLabel}</span>
                          </div>
                          <div class="cardTitle">{item.title}</div>
                          {item.date && <div class="cardDate">{item.date}</div>}
                          {item.desc && <div class="cardDesc">{item.desc}</div>}
                        </div>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </>
          )}

          <div class="backLink">
            <a href={`/${city}/diy/`}>← All DIY guides</a>
          </div>

        </div>{/* /.dtMain */}

        <ArticleSidebar city={city} />

      </div>{/* /.dtLayout */}

    </div>{/* /.dtWrap */}
  </section>
</Base>

<style>
  .diyTopicLanding { padding: 28px 0 64px; }
  .dtWrap { max-width: 1280px; margin: 0 auto; padding: 0 2rem; }
  @media (max-width: 600px) { .dtWrap { padding: 0 1rem; } }

  /* ── Page header (above grid) ── */
  .stHeader { margin-bottom: 28px; }

  .stBreadcrumb {
    display: flex; align-items: center; gap: 6px;
    font-size: 0.8rem; font-weight: 900; letter-spacing: .12em;
    text-transform: uppercase; margin-bottom: 10px;
  }
  .stBreadLink {
    color: var(--brand1); text-decoration: none; transition: opacity 130ms;
  }
  .stBreadLink:hover { opacity: .72; }
  .stBreadSep { color: var(--faint); opacity: .55; font-weight: 700; letter-spacing: 0; }
  .stBreadCurrent { color: var(--text); }

  .stTitle {
    font-size: clamp(32px, 5vw, 52px); font-weight: 900;
    line-height: 1.02; letter-spacing: -0.02em;
    margin: 0 0 4px;
  }
  .stMeta { font-size: 13px; opacity: .55; margin: 0; }

  /* ── Two-column layout ── */
  .dtLayout {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(380px, 3fr);
    gap: 56px;
    align-items: start;
  }
  @media (max-width: 1150px) { .dtLayout { grid-template-columns: 1fr; gap: 40px; } }

  /* ── Coming Soon ── */
  .comingSoon {
    display: flex; flex-direction: column; align-items: center;
    text-align: center; padding: 64px 32px; gap: 16px;
    border-radius: 18px; border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.035);
  }
  .csIcon  { font-size: 48px; line-height: 1; }
  .csTitle { margin: 0; font-size: 28px; font-weight: 900; letter-spacing: -0.02em; }
  .csText  { margin: 0; opacity: .78; font-size: 16px; line-height: 1.6; max-width: 440px; }
  .csBtn {
    display: inline-block; padding: 12px 24px; border-radius: 999px;
    background: var(--brand1); color: #000;
    font-size: 13px; font-weight: 900; letter-spacing: .06em; text-transform: uppercase;
    text-decoration: none; transition: opacity 130ms; margin-top: 8px;
  }
  .csBtn:hover { opacity: .85; }

  /* ── Hero card (first guide) ── */
  :root {
    --card-radius: 18px;
    --card-border: rgba(255,255,255,.10);
    --card-border-hover: rgba(0,119,190,.30);
    --card-bg: rgba(255,255,255,.035);
    --card-bg-hover: rgba(255,255,255,.05);
    --shadow-soft: 0 10px 30px rgba(0,0,0,.24);
    --lift: translateY(-2px);
    --ease: 160ms ease;
  }
  .heroCard {
    display: grid; grid-template-columns: 1.2fr 1fr;
    gap: 0; overflow: hidden; text-decoration: none; margin: 0 0 18px;
    border-radius: var(--card-radius); border: 1px solid var(--card-border);
    background: var(--card-bg);
    transition: transform var(--ease), background var(--ease), border-color var(--ease), box-shadow var(--ease);
  }
  @media (max-width: 880px) { .heroCard { grid-template-columns: 1fr; } }
  .heroCard:hover {
    transform: var(--lift); background: var(--card-bg-hover);
    border-color: var(--card-border-hover);
    box-shadow: 0 0 0 1px rgba(0,119,190,.08), var(--shadow-soft);
  }
  .heroMedia { position: relative; overflow: hidden; background: rgba(255,255,255,.02); }
  .heroImg { width: 100%; height: 100%; display: block; aspect-ratio: 16/9; object-fit: cover; }
  .heroBody { padding: 18px; display: flex; flex-direction: column; justify-content: center; min-width: 0; }
  .heroKicker {
    font-size: 12px; font-weight: 900; letter-spacing: .10em;
    opacity: .78; text-transform: uppercase; margin-bottom: 10px; color: var(--brand1);
  }
  .heroTitle { font-weight: 950; font-size: clamp(20px, 2vw, 28px); line-height: 1.10; letter-spacing: -0.015em; }
  .heroDesc { margin-top: 10px; opacity: .86; line-height: 1.5; font-size: 14px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .heroMeta { margin-top: 12px; opacity: .62; font-size: 12.5px; }

  /* ── List rows (guides after first) ── */
  .diyList { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .diyCard {
    border-radius: var(--card-radius); border: 1px solid var(--card-border);
    background: var(--card-bg);
    transition: transform var(--ease), background var(--ease), border-color var(--ease), box-shadow var(--ease);
  }
  .diyCard:hover {
    transform: var(--lift); background: var(--card-bg-hover);
    border-color: var(--card-border-hover);
    box-shadow: 0 0 0 1px rgba(0,119,190,.08), var(--shadow-soft);
  }
  .cardLink {
    position: relative; display: grid; grid-template-columns: 1fr 2fr;
    gap: 14px; align-items: center; padding: 14px;
    text-decoration: none; color: inherit;
  }
  .cardThumbWrap {
    aspect-ratio: 16/9; border-radius: 14px; overflow: hidden;
    border: 1px solid rgba(255,255,255,.10); background: rgba(255,255,255,.02);
  }
  .cardThumb { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cardBody  { min-width: 0; }
  .cardKicker { display: flex; gap: 8px; align-items: center; margin-bottom: 7px; }
  .kTopicPill {
    font-size: 10px; font-weight: 900; letter-spacing: .1em;
    text-transform: uppercase; padding: 2px 8px; border-radius: 999px;
    background: var(--pillBg); color: var(--brand1); border: 1px solid var(--pillBorder);
  }
  .cardTitle { font-weight: 900; font-size: 17px; line-height: 1.18; letter-spacing: -0.01em; }
  .cardDate  { margin-top: 9px; opacity: .58; font-size: 12.5px; }
  .cardDesc  {
    margin-top: 7px; opacity: .84; font-size: 14px; line-height: 1.45;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }

  .backLink { margin-top: 32px; }
  .backLink a {
    font-size: 13.5px; font-weight: 800; color: var(--link);
    text-decoration: none; border: 1px solid var(--pillBorder);
    background: var(--pillBg); padding: 9px 22px;
    border-radius: 999px; display: inline-flex; align-items: center;
  }
  .backLink a:hover { background: color-mix(in srgb, var(--brand1) 18%, transparent); }

  @media (max-width: 640px) {
    .cardLink { grid-template-columns: 1fr; }
    .cardThumbWrap { aspect-ratio: 16/9; border-radius: 8px; }
  }
</style>
