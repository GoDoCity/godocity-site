---
/**
 * src/pages/[city]/diy/index.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * DIY hub landing page — lists all DIY guides for a given city.
 *
 * URL pattern:  /daytona/diy/
 *               /orlando/diy/
 *               /[any-city]/diy/
 *
 * Feed merges:
 *   1. diy collection entries where `cities` includes the current city.
 *   2. posts collection entries where category === "DIY" and city matches.
 *
 * New articles appear automatically — no manual list needed.
 * ─────────────────────────────────────────────────────────────────────────────
 */
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";

/* ── Generate one route per city that has at least one DIY guide ─────────── */
export async function getStaticPaths() {
  const diyEntries = await getCollection("diy");
  const citySet = new Set<string>();
  for (const entry of diyEntries) {
    for (const city of entry.data.cities) {
      citySet.add(city);
    }
  }
  return Array.from(citySet).map((city) => ({ params: { city } }));
}

/* ── Per-page data ──────────────────────────────────────────────────────── */
const { city } = Astro.params;
const cityLabel = city.charAt(0).toUpperCase() + city.slice(1);

/* DIY collection guides for this city */
const allDiy = await getCollection("diy");
const diyGuides = allDiy
  .filter((e) => e.data.cities.includes(city))
  .sort((a, b) => new Date(b.data.pubDate ?? 0).getTime() - new Date(a.data.pubDate ?? 0).getTime());

/* DIY-category posts for this city */
const allPosts = await getCollection("posts");
const diyPosts = allPosts.filter((p) => {
  const postCity = String(p?.data?.city ?? "").toLowerCase().trim();
  const isCityMatch =
    postCity === city.toLowerCase() ||
    (typeof p?.id === "string" && p.id.startsWith(`${city}/`));
  const isDiy = String(p?.data?.category ?? "").toLowerCase().trim() === "diy";
  return isCityMatch && isDiy;
}).sort((a, b) => new Date(b.data.pubDate ?? 0).getTime() - new Date(a.data.pubDate ?? 0).getTime());

/* Unified feed — normalise both sources to a common shape */
interface FeedItem {
  title: string;
  description: string;
  href: string;
  date: Date | null;
  heroImage: string;
  type: "diy" | "post";
}

const diyItems: FeedItem[] = diyGuides.map((e) => ({
  title: e.data.title,
  description: e.data.intro.split(/\n\n+/)[0].substring(0, 160),
  href: `/${city}/diy/${e.slug}/`,
  date: e.data.pubDate ?? null,
  heroImage: e.data.heroImage ?? "",
  type: "diy",
}));

const postItems: FeedItem[] = diyPosts.map((p) => ({
  title: p.data.title ?? p.slug,
  description: p.data.description ?? "",
  href: `/${city}/posts/${p.slug}/`,
  date: p.data.pubDate ?? null,
  heroImage: (p.data.heroImage ?? p.data.thumbnail ?? "") as string,
  type: "post",
}));

const allItems: FeedItem[] = [...diyItems, ...postItems].sort(
  (a, b) => new Date(b.date ?? 0).getTime() - new Date(a.date ?? 0).getTime()
);

function formatDate(d: Date | null): string {
  if (!d) return "";
  try {
    return new Date(d).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
  } catch {
    return "";
  }
}
---

<Base
  title={`DIY Guides | GoDo${cityLabel}`}
  cityBase={city}
>
  <section class="diyLanding">
    <div class="container" style="max-width: 980px;">

      <div class="landingKicker">
        <span class="kCity">{cityLabel}</span>
        <span class="kSep">/</span>
        <span class="kCat">DIY</span>
      </div>

      <h1 class="landingTitle">DIY Guides</h1>
      <p class="landingCount">{allItems.length} guide{allItems.length !== 1 ? "s" : ""}</p>

      {allItems.length === 0 ? (
        <p class="emptyState">No DIY guides yet for {cityLabel}. Check back soon!</p>
      ) : (
        <ul class="diyList">
          {allItems.map((item) => {
            const dateStr = formatDate(item.date);
            return (
              <li class="diyCard">
                <a class="cardLink" href={item.href} aria-label={`Read: ${item.title}`}>
                  <div class="cardThumbWrap">
                    {item.heroImage
                      ? <img class="cardThumb" src={item.heroImage} alt="" loading="lazy" decoding="async" />
                      : <div class="cardThumbEmpty" aria-hidden="true" />
                    }
                  </div>
                  <div class="cardBody">
                    <div class="cardKicker">
                      <span class="kCityPill">{cityLabel}</span>
                      <span class="kDiyPill">{item.type === "diy" ? "DIY GUIDE" : "DIY"}</span>
                    </div>
                    <div class="cardTitle">{item.title}</div>
                    {dateStr && <div class="cardDate">{dateStr}</div>}
                    {item.description && <div class="cardDesc">{item.description}</div>}
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      )}

    </div>
  </section>
</Base>

<style>
  .diyLanding { padding: 28px 0 64px; }

  /* Kicker row */
  .landingKicker {
    display: flex; align-items: center; gap: 8px;
    font-size: 11px; font-weight: 900; letter-spacing: .12em;
    text-transform: uppercase; margin-bottom: 12px;
  }
  .kCity { color: var(--brand1); }
  .kSep  { opacity: .35; }
  .kCat  { color: var(--muted); }

  .landingTitle {
    font-size: clamp(28px, 4vw, 48px); font-weight: 900;
    line-height: 1.06; letter-spacing: -0.6px;
    margin: 0 0 10px;
  }
  .landingLede  { font-size: 16px; color: var(--color-text-main); margin: 0 0 4px; }
  .landingCount { font-size: 13px; opacity: .55; margin: 0 0 28px; }

  .emptyState { color: var(--muted); font-size: 16px; margin: 40px 0; }

  /* Card list */
  .diyList {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: 14px;
  }

  .diyCard {
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 14px;
    background: rgba(255,255,255,.02);
    overflow: hidden;
    transition: border-color .14s, background .14s;
  }
  .diyCard:hover {
    border-color: rgba(255,255,255,.16);
    background: rgba(255,255,255,.04);
  }

  .cardLink {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 18px;
    align-items: center;
    text-decoration: none;
    color: inherit;
    padding: 14px;
  }

  .cardThumbWrap {
    aspect-ratio: 4/3; border-radius: 10px; overflow: hidden;
    border: 1px solid rgba(255,255,255,.08);
    background: rgba(255,255,255,.03);
  }
  .cardThumb      { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cardThumbEmpty { width: 100%; height: 100%; }

  .cardBody { min-width: 0; }

  /* Kicker pills */
  .cardKicker { display: flex; gap: 8px; align-items: center; margin-bottom: 7px; }
  .kCityPill, .kDiyPill {
    font-size: 10px; font-weight: 900; letter-spacing: .1em;
    text-transform: uppercase; padding: 2px 8px; border-radius: 999px;
  }
  .kCityPill {
    background: var(--brand1);
    color: var(--accentText, #000);
  }
  .kDiyPill {
    background: var(--pillBg);
    color: var(--brand1);
    border: 1px solid var(--pillBorder);
  }

  .cardTitle {
    font-size: 18px; font-weight: 900; line-height: 1.18;
    margin: 0 0 6px; letter-spacing: -0.2px;
  }
  .cardDate {
    font-size: 12px; opacity: .55; font-weight: 700;
    margin-bottom: 6px;
  }
  .cardDesc {
    font-size: 14px; color: var(--color-text-main); line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .cardLink { grid-template-columns: 1fr; }
    .cardThumbWrap { aspect-ratio: 16/9; border-radius: 8px; }
  }
</style>
