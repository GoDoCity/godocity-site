---
/**
 * src/pages/[city]/index.astro
 * Generic city homepage for any city slug configured in cityConfigs.js.
 * NOTE: src/pages/daytona/index.astro takes priority for /daytona/
 *       (static routes beat dynamic routes in Astro).
 */
import Base from "../../layouts/Base.astro";
import { getCityEvents, cityDisplayName, getEventsUrl } from "../../lib/events.js";
import { allCitySlugs, getDisplayName, getCityConfig, getVibeCheck } from "../../lib/cityConfigs.js";
import { getCollection } from "astro:content";
import NewsletterBanner from "../../components/NewsletterBanner.astro";
import WeatherBanner from "../../components/WeatherBanner.astro";
import SidebarPoll from "../../components/SidebarPoll.astro";
import SidebarTipCallout from "../../components/SidebarTipCallout.astro";

export async function getStaticPaths() {
  return allCitySlugs.map(slug => ({ params: { city: slug } }));
}

const { city } = Astro.params;
const displayName = getDisplayName(city);
const config = getCityConfig(city);
const vibeCheck = getVibeCheck(city);

/* ── Events ── */
let upcomingEvents: any[] = [];
let sponsoredEvents: any[] = [];
try {
  const allEvents = await getCityEvents(city);
  sponsoredEvents = allEvents.filter((e: any) => e.data.sponsored === true).slice(0, 3);
  upcomingEvents  = allEvents.filter((e: any) => !e.data.sponsored).slice(0, 6);
} catch {}

/* ── Posts ── */
let posts: any[] = [];
try {
  const all = await getCollection("posts");
  posts = all
    .filter(p => {
      const c = (p.data.city ?? p.id?.split("/")[0] ?? "").toLowerCase().trim();
      return c === city;
    })
    .sort((a, b) => {
      const da = a.data.pubDate ?? a.data.date ?? a.data.published ?? 0;
      const db = b.data.pubDate ?? b.data.date ?? b.data.published ?? 0;
      return new Date(db as any).getTime() - new Date(da as any).getTime();
    })
    .slice(0, 8);
} catch {}

const FALLBACK_IMG = "/images/old-mural-backup.png";
function heroImage(post: any) {
  const v = post?.data?.heroImage ?? post?.data?.heroimage ?? post?.data?.image ?? "";
  return String(v).trim() || FALLBACK_IMG;
}
function thumbImage(post: any) {
  const v = post?.data?.thumbnail ?? post?.data?.heroImage ?? post?.data?.heroimage ?? post?.data?.image ?? "";
  return String(v).trim() || FALLBACK_IMG;
}
function dateText(post: any) {
  const d = post?.data?.pubDate ?? post?.data?.date ?? post?.data?.published ?? null;
  return d ? new Date(d).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" }) : "";
}
---

<Base title={`GoDo${displayName}`} subtitle={`Local news, events & guides for ${displayName}`} cityBase={city}>
  <NewsletterBanner city={displayName} accentColor={config?.accentColor} vibeCheckText={config?.vibeCheckText} />
  {/* Live weather strip — coordinates resolved from this city's mapCenter config. */}
  <WeatherBanner citySlug={city} />
  <section class="section">
    <div class="cityContainer">

      <div class="cityHero">
        <h1 class="cityHeroTitle">GoDo<span class="cityName">{displayName}</span></h1>
        <p class="cityHeroSub">Local news, events & guides for {displayName} and surrounding areas.</p>
        <div class="cityHeroLinks">
          <a class="heroLink" href={`/${city}/events/`}>Events →</a>
          <a class="heroLink" href={`/${city}/food/`}>Food →</a>
          <a class="heroLink" href={`/${city}/city/`}>City News →</a>
        </div>
      </div>

      <div class="cityLayout">

        <div class="cityMain">

          {posts.length > 0 ? (
            <>
              <h2 class="sectionTitle">Latest in {displayName}</h2>
              <div class="postGrid">
                {posts.map((p, i) => (
                  <a class={`postCard${i === 0 ? " postCard--hero" : ""}`}
                     href={`/${city}/posts/${p.slug.split("/").pop()}/`}>
                    <div class="postThumb">
                      <img src={i === 0 ? heroImage(p) : thumbImage(p)}
                           alt={p.data.title ?? ""}
                           loading={i === 0 ? "eager" : "lazy"} />
                    </div>
                    <div class="postBody">
                      {p.data.category && (
                        <div class="postKicker">{String(p.data.category).toUpperCase()}</div>
                      )}
                      <div class="postTitle">{p.data.title}</div>
                      {p.data.description && i === 0 && (
                        <div class="postDesc">{p.data.description}</div>
                      )}
                      <div class="postDate">{dateText(p)}</div>
                    </div>
                  </a>
                ))}
              </div>
            </>
          ) : (
            <div class="emptyMsg">Content coming soon for {displayName} — check back soon!</div>
          )}

        </div>

        <aside class="citySidebar">

          {upcomingEvents.length > 0 && (
            <div class="sideCard evCard">
              <div class="sideTitle">Upcoming Events</div>
              <div class="evList">
                {upcomingEvents.map((e, i) => {
                  const d   = new Date(e.data.eventDate);
                  const dow = isNaN(d.getTime()) ? "???" : d.toLocaleDateString("en-US", { weekday: "short" }).toUpperCase();
                  const day = isNaN(d.getTime()) ? "??" : d.getDate();
                  const mon = isNaN(d.getTime()) ? "???" : d.toLocaleDateString("en-US", { month: "short" }).toUpperCase();
                  const evSlug = e.slug.split("/").pop();
                  const href   = e.data.url ?? `/${city}/events/${evSlug}/`;
                  const isExt  = !!e.data.url;
                  return (
                    <>
                      {i > 0 && <div class="evDivider" aria-hidden="true"></div>}
                      <a class="evRow"
                         href={href}
                         target={isExt ? "_blank" : "_self"}
                         rel={isExt ? "noopener" : ""}>
                        <div class="evDate">
                          <div class="evDow">{dow}</div>
                          <div class="evDay">{day}</div>
                          <div class="evMon">{mon}</div>
                        </div>
                        <div class="evInfo">
                          <div class="evName">{e.data.title}</div>
                          <div class="evPlace">{e.data.location}</div>
                        </div>
                      </a>
                    </>
                  );
                })}
              </div>
              <a class="evMore" href={getEventsUrl(city)}>See all events →</a>
            </div>
          )}

          {/* SidebarPoll brings its own card chrome — no .sideCard wrapper needed */}
          {vibeCheck && (
            <SidebarPoll
              title="Vibe Check"
              question={vibeCheck.question}
              options={vibeCheck.options}
              pollId={vibeCheck.pollId}
              pageUrl={`/${city}/vibe-check/`}
            />
          )}

          {/* Community tip call-out → /{city}/connect/ */}
          <SidebarTipCallout city={city} />

          <div class="sideCard guideCard">
            <div class="sideTitle">Explore {displayName}</div>
            <div class="guideLinks">
              {[
                { emoji: "🏠", label: "Live Here",    href: `/${city}/guides/live/` },
                { emoji: "💼", label: "Work Here",    href: `/${city}/guides/work/` },
                { emoji: "🎉", label: "Play Here",    href: `/${city}/guides/play/` },
                { emoji: "🏖️", label: "Beach Guide", href: `/${city}/guides/beach/` },
              ].map(g => (
                <a class="guideLink" href={g.href}>
                  <span class="guideEmoji">{g.emoji}</span>
                  <span class="guideLinkLabel">{g.label}</span>
                </a>
              ))}
            </div>
          </div>

        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .cityContainer {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
  }

  .cityHero {
    text-align: center;
    padding: 48px 0 40px;
  }
  .cityHeroTitle {
    font-size: clamp(36px, 6vw, 72px);
    font-weight: 950;
    letter-spacing: -0.03em;
    margin: 0 0 12px;
    line-height: 1.0;
  }
  .cityName { color: var(--brand1); }
  .cityHeroSub {
    font-size: 16px;
    opacity: .75;
    max-width: 480px;
    margin: 0 auto 20px;
    line-height: 1.5;
  }
  .cityHeroLinks { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .heroLink {
    padding: 10px 22px;
    border-radius: 999px;
    border: 1px solid var(--brand1);
    color: var(--brand1);
    font-weight: 800;
    font-size: 14px;
    text-decoration: none;
    transition: background 140ms, color 140ms;
  }
  .heroLink:hover { background: var(--brand1); color: #fff; }

  .cityLayout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 60px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .cityLayout { grid-template-columns: 1fr; }
    .citySidebar { position: static; }
  }
  .citySidebar { position: sticky; top: 16px; display: flex; flex-direction: column; gap: 18px; }

  .sectionTitle {
    font-size: 22px; font-weight: 950; letter-spacing: -0.02em;
    margin: 0 0 16px;
  }

  .postGrid { display: grid; gap: 12px; }
  .postCard {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 14px;
    padding: 14px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.08);
    background: rgba(255,255,255,.03);
    text-decoration: none;
    color: inherit;
    align-items: center;
    transition: background 140ms, border-color 140ms;
  }
  .postCard:hover { background: rgba(255,255,255,.06); border-color: rgba(0,119,190,.25); }
  .postCard--hero {
    grid-template-columns: 1fr;
    padding: 0;
    overflow: hidden;
    margin-bottom: 8px;
  }
  .postThumb { aspect-ratio: 4/3; overflow: hidden; border-radius: 10px; background: rgba(255,255,255,.04); }
  .postCard--hero .postThumb { border-radius: 0; aspect-ratio: 16/7; }
  .postThumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .postBody { min-width: 0; padding: 0; }
  .postCard--hero .postBody { padding: 16px; }
  .postKicker {
    font-size: 10px; font-weight: 900; letter-spacing: .10em;
    color: var(--brand1); margin-bottom: 5px;
  }
  .postTitle { font-weight: 800; font-size: 15px; line-height: 1.2; }
  .postCard--hero .postTitle { font-size: clamp(20px, 3vw, 28px); font-weight: 950; }
  .postDesc { font-size: 14px; opacity: .80; margin-top: 6px; line-height: 1.45; }
  .postDate { font-size: 12px; opacity: .55; margin-top: 8px; }

  .emptyMsg { opacity: .65; font-size: 15px; padding: 32px 0; text-align: center; }

  /* Sidebar cards */
  .sideCard {
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,.09);
    background: rgba(255,255,255,.03);
    padding: 18px;
  }
  .sideTitle {
    font-weight: 950; font-size: 16px;
    letter-spacing: -0.01em; margin: 0 0 8px;
  }
  .sideSub { font-size: 13.5px; opacity: .80; line-height: 1.4; margin-bottom: 12px; }

  /* Events sidebar */
  .evCard { padding: 0; background: none !important; border: none !important; }
  .evList { display: grid; gap: 8px; margin-top: 8px; }
  .evRow {
    display: grid; grid-template-columns: 48px 1fr;
    gap: 12px; align-items: center; text-decoration: none; color: inherit;
  }
  .evDate {
    width: 48px; height: 48px; border-radius: 10px;
    border: 1px solid var(--brand1);
    display: grid; place-items: center; text-align: center; line-height: 1;
  }
  .evDow { font-size: 9px; font-weight: 700; letter-spacing: .08em; color: var(--brand1); text-transform: uppercase; }
  .evDay { font-size: 19px; font-weight: 700; color: var(--brand1); }
  .evMon { font-size: 8px; font-weight: 700; color: var(--brand1); text-transform: uppercase; }
  .evName { font-weight: 800; font-size: 14px; line-height: 1.2; }
  .evPlace { font-size: 12px; opacity: .68; }
  .evDivider { height: 1px; background: rgba(255,255,255,.08); }
  .evMore {
    display: block; margin-top: 12px;
    font-size: 13px; font-weight: 700; color: var(--brand1); text-decoration: none;
  }
  .evMore:hover { text-decoration: underline; }

  /* Guide links */
  .guideLinks { display: grid; gap: 8px; margin-top: 6px; }
  .guideLink {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,.07);
    background: rgba(255,255,255,.02);
    text-decoration: none; color: inherit;
    transition: background 140ms, border-color 140ms;
  }
  .guideLink:hover { background: rgba(0,119,190,.08); border-color: rgba(0,119,190,.25); }
  .guideEmoji { font-size: 18px; flex-shrink: 0; }
  .guideLinkLabel { font-weight: 700; font-size: 14px; }
</style>
