---
/**
 * src/pages/[city]/guides/[slug].astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Dynamic City Guide template — listicle layout, 1–20 ranked items.
 *
 * URL pattern:  /daytona/guides/best-restaurants/
 *               /austin/guides/best-tacos/
 *               /[any-city]/guides/[any-slug]/
 *
 * Content:      src/content/guides/[city]/[slug].md
 * Schema:       src/content/config.ts  (guides collection)
 * ─────────────────────────────────────────────────────────────────────────────
 */
import Base           from "../../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

/* ── Build all static paths from the guides collection ─────────────────── */
export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((guide) => ({
    params: {
      city: guide.data.city,          // "daytona"  → from frontmatter
      slug: guide.slug.split("/").pop(), // "best-restaurants" → from filename
    },
    props: { guide },
  }));
}

/* ── Per-page data ──────────────────────────────────────────────────────── */
const { guide }   = Astro.props;
const { data }    = guide;
const { Content } = await render(guide);   // renders any body markdown

const city     = data.city;
const items    = [...data.items].sort((a, b) => a.rank - b.rank);
const firstHalf  = items.slice(0, Math.ceil(items.length / 2));  // always-visible
const secondHalf = items.slice(Math.ceil(items.length / 2));     // load-more

const moreGuides = data.moreGuides ?? [{'emoji': '🏠', 'label': 'Live in Daytona', 'sub': 'Neighborhoods, housing & moving tips', 'href': '/daytona/guides/live/'}, {'emoji': '💼', 'label': 'Work in Daytona', 'sub': 'Jobs, co-working & local economy', 'href': '/daytona/guides/work/'}, {'emoji': '🎉', 'label': 'Play in Daytona', 'sub': 'Events, nightlife & weekend picks', 'href': '/daytona/guides/play/'}, {'emoji': '🏖️', 'label': 'Beach Guide', 'sub': 'Access, parking & the best stretches', 'href': '/daytona/guides/beach/'}, {'emoji': '🏁', 'label': 'Race Week Guide', 'sub': 'Daytona 500, Bike Week & beyond', 'href': '/daytona/guides/race-week/'}, {'emoji': '🌿', 'label': 'Wellness Guide', 'sub': 'Spas, yoga & healthy eats', 'href': '/daytona/guides/wellness/'}];

/* ── Sponsor resolution ─────────────────────────────────────────────────────
   Priority: localSponsor (guide frontmatter) > newest active globalSponsor
   Result:   `sponsor` is the object to render, or null if nothing is active.
   Placement: injected between list item #3 and #4 in every guide.
────────────────────────────────────────────────────────────────────────────── */
let sponsor: {
  brand: string; tagline: string; body: string;
  logo?: string; img?: string; imgAlt?: string;
  ctaText?: string; ctaHref: string;
  isLocal: boolean;          // true = sold local placement; false = global network
} | null = null;

if (data.localSponsor) {
  /* Local sponsor wins — sold directly to a city business */
  sponsor = { ...data.localSponsor, isLocal: true };
} else {
  /* Fall back to the global network: most recent active campaign.
     Wrapped in try/catch — getCollection throws (not returns []) if the
     globalSponsors folder doesn't exist yet on a fresh repo. */
  try {
    const allGlobal = await getCollection("globalSponsors");
    const active = allGlobal
      .filter((s) => s.data.active !== false)
      .filter((s) => s.data.brand)              // skip incomplete drafts
      .sort((a, b) =>
        new Date(b.data.pubDate ?? 0).getTime() -
        new Date(a.data.pubDate ?? 0).getTime()
      );
    if (active.length > 0) {
      sponsor = { ...active[0].data, isLocal: false };
    }
    // active.length === 0 → sponsor stays null → slot renders nothing
  } catch {
    // Collection missing entirely → render page without sponsor slot
    sponsor = null;
  }
}

const pubDateStr = data.pubDate
  ? new Date(data.pubDate).toLocaleDateString("en-US", {
      month: "long", year: "numeric",
    })
  : "";

/* Charles King headshot — inline base64 so it renders before any CDN */
const CK_SRC = "data:image/jpeg;base64,";
---

<Base
  title={}
  subtitle={}
  cityBase={city}
>
<div class="pageWrap">

  {/* ════════ GUIDE HERO ════════ */}
  <div class="container">
    <header class="guideHero">
      <div class="guideKicker">
        <span class="kPill kCity">{city.charAt(0).toUpperCase() + city.slice(1)}</span>
        <span class="kPill kCat">{data.category ?? "City Guide"}</span>
      </div>
      <h1 class="guideTitle">{data.title}</h1>
      <p  class="guideIntro">{data.intro}</p>
      <div class="guideMeta">
        <span class="gAuthor">By {data.author ?? "Charles King"}</span>
        {pubDateStr && <><span class="gDot" aria-hidden="true">·</span><span class="gDate">{pubDateStr}</span></>}
      </div>
    </header>
  </div>

  {/* ════════ 75/25 GRID ════════ */}
  <div class="container">
    <div class="homeGrid">

      {/* ── MAIN COLUMN ── */}
      <main>

        {/* ── Items 1–3 always visible ── */}
        <ol class="gList" id="listA">
          {firstHalf.slice(0, 3).map((item) => (
            <li class="gItem" id={`spot-${item.rank}`}>
              <div class="iHeader">
                <div class="rankBadge" aria-label={`Number ${item.rank}`}>{item.rank}</div>
                <div class="iMeta">
                  {item.tag && <div class="iTag">{item.tag}</div>}
                  <h2 class="iTitle">
                    {item.href
                      ? <a class="iLink" href={item.href}>{item.title}</a>
                      : item.title
                    }
                  </h2>
                </div>
              </div>
              {item.img && (
                <div class="imgWrap">
                  <img
                    class="itemImg"
                    src={item.img}
                    alt={item.imgAlt || item.title}
                    loading={item.rank <= 2 ? "eager" : "lazy"}
                    decoding="async"
                    onerror="this.closest('.imgWrap').classList.add('imgMissing')"
                  />
                </div>
              )}
              <p class="iBody">{item.body}</p>
              {item.href && (
                <a class="iCta" href={item.href}>Learn more →</a>
              )}
            </li>
          ))}
        </ol>

        {/* ── SPONSOR CARD — between #3 and #4 ───────────────────────────
            Renders when localSponsor (guide frontmatter) OR an active
            globalSponsor is present. Local always wins.
            sponsor.isLocal = true  → sold directly to a city business
            sponsor.isLocal = false → global network campaign (e.g. Nike)
        ─────────────────────────────────────────────────────────────────── */}
        {sponsor && (
          <div class="sponsorWrap" role="complementary"
            aria-label={`Sponsored by ${sponsor.brand}`}>
            <div class="sponsorLabel">
              <span class="sponsorLabelText">
                {sponsor.isLocal ? "Local Sponsor" : "Presented by"}
              </span>
            </div>
            <div class="sponsorCard">
              {sponsor.img && (
                <div class="sponsorImgWrap">
                  <img class="sponsorImg" src={sponsor.img}
                    alt={sponsor.imgAlt || sponsor.brand}
                    loading="lazy" decoding="async" />
                </div>
              )}
              <div class="sponsorBody">
                <div class="sponsorMeta">
                  {sponsor.logo && (
                    <img class="sponsorLogo" src={sponsor.logo}
                      alt={`${sponsor.brand} logo`} loading="lazy" />
                  )}
                  <div class="sponsorBrand">{sponsor.brand}</div>
                </div>
                <div class="sponsorTagline">{sponsor.tagline}</div>
                <p class="sponsorText">{sponsor.body}</p>
                <a class="sponsorCta" href={sponsor.ctaHref}
                  target="_blank" rel="noopener sponsored">
                  {sponsor.ctaText ?? "Learn more"} →
                </a>
              </div>
            </div>
          </div>
        )}

        {/* ── Items 4+ of the always-visible first half ── */}
        {firstHalf.length > 3 && (
          <ol class="gList" id="listA2" start={4}>
            {firstHalf.slice(3).map((item) => (
              <li class="gItem" id={`spot-${item.rank}`}>
                <div class="iHeader">
                  <div class="rankBadge" aria-label={`Number ${item.rank}`}>{item.rank}</div>
                  <div class="iMeta">
                    {item.tag && <div class="iTag">{item.tag}</div>}
                    <h2 class="iTitle">
                      {item.href
                        ? <a class="iLink" href={item.href}>{item.title}</a>
                        : item.title
                      }
                    </h2>
                  </div>
                </div>
                {item.img && (
                  <div class="imgWrap">
                    <img class="itemImg" src={item.img}
                      alt={item.imgAlt || item.title}
                      loading="lazy" decoding="async"
                      onerror="this.closest('.imgWrap').classList.add('imgMissing')"
                    />
                  </div>
                )}
                <p class="iBody">{item.body}</p>
                {item.href && (
                  <a class="iCta" href={item.href}>Learn more →</a>
                )}
              </li>
            ))}
          </ol>
        )}

        {/* Second half — revealed by Load More */}
        {secondHalf.length > 0 && (
          <>
            <ol class="gList gHidden" id="listB"
              start={firstHalf.length + 1} aria-hidden="true">
              {secondHalf.map((item) => (
                <li class="gItem" id={}>
                  <div class="iHeader">
                    <div class="rankBadge" aria-label={}>{item.rank}</div>
                    <div class="iMeta">
                      {item.tag && <div class="iTag">{item.tag}</div>}
                      <h2 class="iTitle">
                        {item.href
                          ? <a class="iLink" href={item.href}>{item.title}</a>
                          : item.title
                        }
                      </h2>
                    </div>
                  </div>
                  {item.img && (
                    <div class="imgWrap">
                      <img
                        class="itemImg"
                        src={item.img}
                        alt={item.imgAlt || item.title}
                        loading="lazy"
                        decoding="async"
                        onerror="this.closest('.imgWrap').classList.add('imgMissing')"
                      />
                    </div>
                  )}
                  <p class="iBody">{item.body}</p>
                  {item.href && (
                    <a class="iCta" href={item.href}>Learn more →</a>
                  )}
                </li>
              ))}
            </ol>

            <div class="loadRow" id="loadRow">
              <button class="loadBtn" id="loadBtn" type="button"
                aria-expanded="false" aria-controls="listB">
                Show spots #{firstHalf.length + 1}–{items.length}
                <svg class="chevron" width="16" height="16" viewBox="0 0 16 16"
                  fill="none" aria-hidden="true">
                  <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2.2"
                    stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </>
        )}

        {/* Optional body markdown (editorial note, disclaimer, etc.) */}
        {guide.body?.trim() && (
          <div class="guideNote prose">
            <Content />
          </div>
        )}

      </main>

      {/* ── SIDEBAR ── */}
      <aside class="homeRail">

        {/* Display ad */}
        <div class="adSlot">
          <div class="adLabel">Advertisement</div>
          <a class="adCard" href={}>
            <div class="adInner">
              <div class="adIcon">📢</div>
              <div class="adTitle">Your Ad Here</div>
              <div class="adDesc">Reach thousands of {city.charAt(0).toUpperCase() + city.slice(1)} locals</div>
              <div class="adCta">Advertise with us →</div>
            </div>
          </a>
        </div>

        {/* More guides */}
        <div class="railSection">
          <div class="railHead">
            <span class="railTitle">City Guides</span>
            <a class="railMore" href={}>See all</a>
          </div>
          <div>
            {moreGuides.slice(0, 5).map((g) => (
              <a class="guideLink" href={g.href}>{g.emoji} {g.label}</a>
            ))}
          </div>
        </div>

        {/* Newsletter CTA */}
        <div class="nlBox">
          <div class="nlBoxHead">
            <em>Good News <strong>{city.charAt(0).toUpperCase() + city.slice(1)}!</strong></em>
          </div>
          <div class="nlBoxSub">Free local news in your inbox every morning.</div>
          <a class="nlBoxBtn" href={}>Subscribe free →</a>
        </div>

      </aside>
    </div>
  </div>

  {/* ════════ MORE GUIDES FOOTER ════════ */}
  <section class="moreSection">
    <div class="container">
      <div class="moreHead">
        <span class="moreLabel">More {city.charAt(0).toUpperCase() + city.slice(1)} Guides</span>
        <a class="moreAll" href={}>Browse all →</a>
      </div>
      <div class="moreGrid">
        {moreGuides.map((g) => (
          <a class="moreCard" href={g.href}>
            <span class="moreEmoji" aria-hidden="true">{g.emoji}</span>
            <div class="moreText">
              <div class="moreCardTitle">{g.label}</div>
              <div class="moreCardSub">{g.sub}</div>
            </div>
            <span class="moreArrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

</div>{/* end .pageWrap */}

{/* ── Load More — vanilla JS, zero deps ── */}
<script is:inline>
(function () {
  var btn  = document.getElementById("loadBtn");
  var list = document.getElementById("listB");
  var row  = document.getElementById("loadRow");
  if (!btn || !list) return;          // guide has ≤ half items, button not rendered
  btn.addEventListener("click", function () {
    list.classList.remove("gHidden");
    list.removeAttribute("aria-hidden");
    btn.setAttribute("aria-expanded", "true");
    row.style.transition = "opacity 280ms ease";
    row.style.opacity = "0";
    setTimeout(function () { row.style.display = "none"; }, 300);
    var first = list.querySelector(".gItem");
    if (first) {
      first.scrollIntoView({ behavior: "smooth", block: "start" });
      setTimeout(function () {
        var lnk = first.querySelector(".iLink");
        if (lnk) lnk.focus();
      }, 420);
    }
  });
})();
</script>

<style>
  /* ── Global reset (matches homepage) ── */
  :global(html), :global(body) { overflow-x: hidden; width: 100%; position: relative; }
  .pageWrap { min-height: 100vh; overflow-x: hidden; width: 100%; }

  :global(.container) { max-width: 1280px; margin: 0 auto; padding: 0 2.5rem; }
  @media (max-width: 768px) { :global(.container) { max-width: 100%; padding: 0 1.25rem; } }

  /* ════ HERO ════ */
  .guideHero {
    padding: 48px 0 36px;
    border-bottom: 2px solid var(--brand1);
    margin-bottom: 40px;
  }
  .guideKicker { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
  .kPill {
    font-size: 10.5px; font-weight: 800; letter-spacing: .11em;
    text-transform: uppercase; padding: 3px 10px; border-radius: 999px;
  }
  .kCity { background: var(--brand1); color: var(--accentText); }
  .kCat  { background: var(--pillBg); color: var(--brand1); border: 1px solid var(--pillBorder); }

  .guideTitle {
    font-size: clamp(26px, 3.6vw, 50px); font-weight: 900;
    line-height: 1.06; letter-spacing: -0.7px; color: var(--text);
    margin: 0 0 18px; max-width: 820px;
  }
  .guideIntro {
    font-size: clamp(15px, 1.2vw, 18px); color: var(--muted);
    line-height: 1.65; max-width: 660px; margin: 0 0 16px;
  }
  .guideMeta { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--faint); }
  .gAuthor   { font-weight: 700; color: var(--text); }
  .gDot      { opacity: .45; }

  /* ════ 75/25 GRID ════ */
  .homeGrid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 290px;
    gap: clamp(40px, 4vw, 56px);
    align-items: start;
    padding-bottom: 48px;
  }
  @media (max-width: 980px) { .homeGrid { grid-template-columns: 1fr; } .homeRail { order: 2; } }

  /* ════ LIST ════ */
  .gList    { list-style: none; margin: 0; padding: 0; }
  .gHidden  { display: none; }

  .gItem {
    padding: 36px 0 40px;
    border-bottom: 1px solid var(--border);
  }
  .gItem:last-child { border-bottom: none; }

  /* Rank + headline row */
  .iHeader { display: flex; align-items: flex-start; gap: 16px; margin-bottom: 20px; }

  .rankBadge {
    flex-shrink: 0; width: 52px; height: 52px; border-radius: 14px;
    background: var(--brand1); color: var(--accentText);
    display: flex; align-items: center; justify-content: center;
    font-family: "Century Gothic", AppleGothic, Arial, sans-serif;
    font-size: 26px; font-weight: 900; letter-spacing: -1px;
    margin-top: 3px;
  }

  .iMeta  { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
  .iTag   {
    font-size: 10px; font-weight: 800; letter-spacing: .1em;
    text-transform: uppercase; color: var(--brand1); line-height: 1;
  }
  .iTitle {
    font-size: 24px; font-weight: 700;        /* 24px Bold Century Gothic */
    line-height: 1.18; letter-spacing: -0.3px;
    color: var(--text); margin: 0;
  }
  .iLink  { color: inherit; text-decoration: none; transition: color 130ms; }
  .iLink:hover { color: var(--link); }

  /* Image */
  .imgWrap {
    width: 100%; aspect-ratio: 16/8; border-radius: 14px;
    overflow: hidden; background: var(--surface2);
    margin-bottom: 20px; position: relative;
  }
  .imgWrap.imgMissing {
    display: flex; align-items: center; justify-content: center;
    color: var(--faint); font-size: 13px; font-weight: 600;
  }
  .imgWrap.imgMissing::after { content: "Photo coming soon"; }
  .itemImg {
    display: block; width: 100%; height: 100%; object-fit: cover;
    transition: transform 340ms ease; will-change: transform;
  }
  .imgWrap:hover .itemImg { transform: scale(1.03); }

  /* Body */
  .iBody {
    font-size: 16px; color: var(--muted);    /* 16px reading font */
    line-height: 1.7; margin: 0 0 16px; max-width: 640px;
  }

  /* CTA */
  .iCta {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 13.5px; font-weight: 700; color: var(--link);
    text-decoration: none; border-bottom: 1.5px solid transparent;
    padding-bottom: 1px; transition: border-color 140ms;
  }
  .iCta:hover { border-color: var(--link); }

  /* Optional editorial note below the list */
  .guideNote {
    margin-top: 32px; padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: 15px; color: var(--muted); line-height: 1.7;
  }
  .guideNote :global(p) { margin: 0 0 1em; }
  .guideNote :global(a) { color: var(--link); }

  /* ════ LOAD MORE ════ */
  .loadRow { padding: 32px 0 8px; display: flex; justify-content: center; }
  .loadBtn {
    display: inline-flex; align-items: center; gap: 8px;
    height: 48px; padding: 0 28px; border-radius: 999px;
    border: 2px solid var(--brand1); background: transparent;
    color: var(--text); cursor: pointer;
    font-family: "Century Gothic", AppleGothic, Arial, sans-serif;
    font-size: 14px; font-weight: 800; letter-spacing: .02em;
    transition: background 160ms, color 160ms;
  }
  .loadBtn:hover { background: var(--brand1); color: var(--accentText); }
  .chevron { transition: transform 200ms; }
  .loadBtn:hover .chevron { transform: translateY(2px); }

  /* ════ SIDEBAR ════ */
  .homeRail { position: sticky; top: 80px; display: grid; gap: 24px; align-self: start; }
  .railHead {
    display: flex; justify-content: space-between; align-items: baseline;
    padding-bottom: 10px; border-bottom: 2px solid var(--brand1);
  }
  .railSection { display: grid; gap: 0; }
  .railTitle {
    font-size: 16px; font-weight: 900; letter-spacing: .08em;
    text-transform: uppercase; color: var(--text);
  }
  .editTitle { white-space: nowrap; letter-spacing: -0.02em; font-size: 14px; }
  .railMore  { font-size: 13px; font-weight: 700; color: var(--link); text-decoration: none; }
  .railMore:hover { text-decoration: underline; }

  /* Charles King */
  .editBlock { display: grid; gap: 0; }
  .editRow   { display: flex; align-items: center; padding-top: 12px; }
  .ckPhoto {
    width: 80px; height: 80px; border-radius: 50%; object-fit: cover;
    flex-shrink: 0; margin-right: 14px;
    background: var(--surface2); border: 2px solid var(--border);
  }
  .ckFallback {
    display: none; width: 80px; height: 80px; border-radius: 50%;
    background: var(--brand1); color: var(--accentText);
    font-size: 22px; font-weight: 900; flex-shrink: 0; margin-right: 14px;
    align-items: center; justify-content: center; border: 2px solid var(--border);
  }
  .ckInfo { display: flex; flex-direction: column; gap: 3px; }
  .ckName { font-size: 15px; font-weight: 700; color: var(--text); line-height: 1.2; }
  .ckRole { font-size: 14px; color: var(--faint); line-height: 1.3; }

  /* Ad slot */
  .adSlot  { display: grid; gap: 5px; }
  .adLabel {
    font-size: 8.5px; font-weight: 700; letter-spacing: .12em;
    text-transform: uppercase; color: var(--faint); text-align: center;
  }
  .adCard {
    display: block; text-decoration: none;
    border: 1.5px dashed var(--pillBorder); border-radius: 13px;
    background: var(--pillBg); transition: border-color 140ms;
  }
  .adCard:hover { border-color: var(--brand1); }
  .adInner { padding: 22px 14px; text-align: center; display: grid; gap: 5px; place-items: center; }
  .adIcon  { font-size: 24px; }
  .adTitle { font-size: 16px; font-weight: 900; color: var(--text); }
  .adDesc  { font-size: 14px; color: var(--muted); line-height: 1.3; }
  .adCta   {
    margin-top: 6px; display: inline-flex; align-items: center;
    height: 30px; padding: 0 13px; border-radius: 999px;
    background: var(--brand1); color: var(--accentText);
    font-size: 11.5px; font-weight: 800;
  }

  .guideLink {
    display: block; text-decoration: none; font-size: 15px; font-weight: 700;
    color: var(--text); padding: 11px 0; border-bottom: 1px solid var(--border);
    transition: color 120ms;
  }
  .guideLink:last-child { border-bottom: none; }
  .guideLink:hover { color: var(--link); }

  /* Sidebar newsletter */
  .nlBox    { padding: 18px 16px; border-radius: 14px; background: var(--brand1); display: flex; flex-direction: column; gap: 7px; }
  .nlBoxHead { font-size: 18px; font-weight: 900; font-style: italic; color: #000; letter-spacing: -0.03em; line-height: 1.1; }
  .nlBoxHead strong { font-weight: 900; }
  .nlBoxSub  { font-size: 13px; color: rgba(0,0,0,.7); line-height: 1.35; }
  .nlBoxBtn  {
    display: inline-flex; align-items: center; height: 36px; padding: 0 14px;
    border-radius: 999px; background: #000; color: #fff;
    font-size: 12.5px; font-weight: 800; text-decoration: none;
    align-self: flex-start; margin-top: 2px; transition: opacity 140ms;
  }
  .nlBoxBtn:hover { opacity: .82; }

  /* ════ MORE GUIDES FOOTER ════ */
  .moreSection { background: var(--surface); border-top: 2px solid var(--brand1); padding: 48px 0 56px; }
