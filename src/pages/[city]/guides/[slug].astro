  .sponsorMeta { display: flex; align-items: center; gap: 10px; }
  .sponsorLogo { height: 28px; width: auto; object-fit: contain; flex-shrink: 0; }
  .sponsorBrand {
    font-size: 11px; font-weight: 800; letter-spacing: .1em;
    text-transform: uppercase; color: var(--faint);
  }

  /* Headline tagline */
  .sponsorTagline {
    font-size: 20px; font-weight: 800; line-height: 1.15;
    letter-spacing: -0.02em; color: var(--text);
    font-family: "Manrope", sans-serif;
  }

  /* Body copy */
  .sponsorText { font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0; max-width: 400px; }

  /* CTA button */
  .sponsorCta {
    display: inline-flex; align-items: center; align-self: flex-start;
    margin-top: 6px; height: 38px; padding: 0 18px; border-radius: 999px;
