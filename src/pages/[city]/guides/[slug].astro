  /* ════ SPONSOR CARD ════════════════════════════════════════════════════════
     Between item #3 and #4 on every guide.
     Local (isLocal=true) vs Global (isLocal=false) differs only in label text.
     sponsor === null → block not rendered, no empty space.
  ══════════════════════════════════════════════════════════════════════════ */
  .sponsorWrap { margin: 8px 0 0; }

  /* Rule line with centred label */
  .sponsorLabel {
    display: flex; align-items: center; gap: 8px; margin-bottom: 10px;
