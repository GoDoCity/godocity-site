---
/**
 * src/pages/[city]/guides/[slug].astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Dynamic City Guide template — listicle layout, 1–20 ranked items.
 *
 * URL pattern:  /daytona/guides/best-restaurants/
 *               /austin/guides/best-tacos/
 *               /[any-city]/guides/[any-slug]/
 *
 * Content:      src/content/cityGuides/[city]/[slug].md
 * Schema:       src/content/config.ts  (cityGuides collection)
 * ─────────────────────────────────────────────────────────────────────────────
 */
import Base           from "../../../layouts/Base.astro";
import InteractiveMap from "../../../components/InteractiveMap.astro";
import { getCollection, render } from "astro:content";

/* ── Build all static paths from both guide collections ────────────────────── */
export async function getStaticPaths() {
  const cityGuidesAll = await getCollection("cityGuides");
  const newGuidesAll  = await getCollection("guides");

  const cityGuidePaths = cityGuidesAll.map((guide) => ({
    params: {
      city: guide.data.city,
      slug: guide.slug.split("/").pop(),
    },
    props: { guide, collectionType: "cityGuide" as const },
  }));

  const newGuidePaths = newGuidesAll.map((guide) => ({
    params: {
      city: guide.slug.split("/")[0],        // "daytona" from "daytona/date-night"
      slug: guide.slug.split("/").pop(),     // "date-night"
    },
    props: { guide, collectionType: "guide" as const },
  }));

  // DEBUG: log all registered guide slugs so we can verify path registration
  console.log("[getStaticPaths] cityGuide slugs:", cityGuidePaths.map(p => `/${p.params.city}/guides/${p.params.slug}/`));
  console.log("[getStaticPaths] guides (new) slugs:", newGuidePaths.map(p => `/${p.params.city}/guides/${p.params.slug}/`));

  return [...cityGuidePaths, ...newGuidePaths];
}

/* ── Per-page data ──────────────────────────────────────────────────────── */
const { guide, collectionType } = Astro.props;
const { data }    = guide;
const { Content } = await render(guide);   // renders any body markdown

const city = collectionType === "cityGuide" ? (data as any).city : (guide.slug.split("/")[0]);
const items    = collectionType === "cityGuide" ? [...((data as any).items ?? [])].sort((a: any, b: any) => a.rank - b.rank) : [];
const firstHalf  = items.slice(0, Math.ceil(items.length / 2));  // always-visible
const secondHalf = items.slice(Math.ceil(items.length / 2));     // load-more

const moreGuides = data.moreGuides ?? [{'emoji': '🏠', 'label': 'Live in Daytona', 'sub': 'Neighborhoods, housing & moving tips', 'href': '/daytona/guides/live/'}, {'emoji': '💼', 'label': 'Work in Daytona', 'sub': 'Jobs, co-working & local economy', 'href': '/daytona/guides/work/'}, {'emoji': '🎉', 'label': 'Play in Daytona', 'sub': 'Events, nightlife & weekend picks', 'href': '/daytona/guides/play/'}, {'emoji': '🏖️', 'label': 'Beach Guide', 'sub': 'Access, parking & the best stretches', 'href': '/daytona/guides/beach/'}, {'emoji': '🏁', 'label': 'Race Week Guide', 'sub': 'Daytona 500, Bike Week & beyond', 'href': '/daytona/guides/race-week/'}, {'emoji': '🌿', 'label': 'Wellness Guide', 'sub': 'Spas, yoga & healthy eats', 'href': '/daytona/guides/wellness/'}];

/* ── Sponsor resolution ─────────────────────────────────────────────────────
   Priority: localSponsor (guide frontmatter) > newest active globalSponsor
   Result:   `sponsor` is the object to render, or null if nothing is active.
   Placement: injected between list item #3 and #4 in every guide.
────────────────────────────────────────────────────────────────────────────── */
let sponsor: {
  brand: string; tagline: string; body: string;
  logo?: string; img?: string; imgAlt?: string;
  ctaText?: string; ctaHref: string;
  isLocal: boolean;          // true = sold local placement; false = global network
} | null = null;

if (data.localSponsor) {
  /* Local sponsor wins — sold directly to a city business */
  sponsor = { ...data.localSponsor, isLocal: true };
} else {
  /* Fall back to the global network: most recent active campaign.
     Wrapped in try/catch — getCollection throws (not returns []) if the
     globalSponsors folder doesn't exist yet on a fresh repo. */
  try {
    const allGlobal = await getCollection("globalSponsors");
    const active = allGlobal
      .filter((s) => s.data.active !== false)
      .filter((s) => s.data.brand)              // skip incomplete drafts
      .sort((a, b) =>
        new Date(b.data.pubDate ?? 0).getTime() -
        new Date(a.data.pubDate ?? 0).getTime()
      );
    if (active.length > 0) {
      sponsor = { ...active[0].data, isLocal: false };
    }
    // active.length === 0 → sponsor stays null → slot renders nothing
  } catch {
    // Collection missing entirely → render page without sponsor slot
    sponsor = null;
  }
}

const rawDate = collectionType === "cityGuide" ? (data as any).pubDate : (data as any).date;
const pubDateStr = rawDate
  ? new Date(rawDate).toLocaleDateString("en-US", {
      month: "long", year: "numeric",
    })
  : "";

const CK_SRC = "/images/charles-king-v2.jpg";
---

<Base
  title={data.title}
  cityBase={city}
>
<div class="pageWrap">

  {/* ════════ HERO: Full-bleed image banner for new guides with image ════════
      Uses data.image as background; Montserrat 900 overlaid title per brand guidelines.
      Falls back to plain text hero for cityGuides or guides without an image.
  ════════════════════════════════════════════════════════════════════════════ */}
  {collectionType === "guide" && (data as any).image ? (
    <div class="articleHero" style={`background-image: url('${(data as any).image}')`}>
      <div class="articleHeroOverlay" />
      <div class="container articleHeroInner">
        <nav class="breadcrumb articleHeroBread" aria-label="Breadcrumb">
          <a class="bcItem bcLink" href={`/${city}/`}>{city.charAt(0).toUpperCase() + city.slice(1)}</a>
          <span class="bcSep" aria-hidden="true">›</span>
          <a class="bcItem bcLink" href={`/${city}/guides/`}>Guides</a>
          <span class="bcSep" aria-hidden="true">›</span>
          <span class="bcItem bcCurrent" aria-current="page">{data.title}</span>
        </nav>
        <div class="guideKicker">
          <span class="kPill kCity">{city.charAt(0).toUpperCase() + city.slice(1)}</span>
          <span class="kPill kCat">{(data as any).topic + " Guide"}</span>
        </div>
        <h1 class="articleHeroTitle">{data.title}</h1>
        <p class="articleHeroDesc">{(data as any).description}</p>
        <div class="guideMeta guideMeta--hero">
          <span class="gAuthor">By Charles King</span>
          {pubDateStr && <><span class="gDot" aria-hidden="true">·</span><span class="gDate">{pubDateStr}</span></>}
        </div>
      </div>
    </div>
  ) : (
    <div class="container">
      <header class="guideHero">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a class="bcItem bcLink" href={`/${city}/`}>{city.charAt(0).toUpperCase() + city.slice(1)}</a>
          <span class="bcSep" aria-hidden="true">›</span>
          <a class="bcItem bcLink" href={`/${city}/guides/`}>Guides</a>
          <span class="bcSep" aria-hidden="true">›</span>
          <span class="bcItem bcCurrent" aria-current="page">{data.title}</span>
        </nav>
        <div class="guideKicker">
          <span class="kPill kCity">{city.charAt(0).toUpperCase() + city.slice(1)}</span>
          <span class="kPill kCat">{collectionType === "guide" ? ((data as any).topic + " Guide") : ((data as any).category ?? "City Guide")}</span>
        </div>
        <h1 class="guideTitle">{data.title}</h1>
        <p  class="guideIntro">{collectionType === "guide" ? (data as any).description : (data as any).intro}</p>
        <div class="guideMeta">
          <span class="gAuthor">By Charles King</span>
          {pubDateStr && <><span class="gDot" aria-hidden="true">·</span><span class="gDate">{pubDateStr}</span></>}
        </div>
      </header>
    </div>
  )}

  {/* ════════ VOTING BANNER ════════
      Shows only when votingEnabled: true AND votingStatus is not "closed".
      Status variants: "open" → Vote Now  |  "tallying" → Counting votes
                       "published" → See the results
  ════════════════════════════════════════════════════════════════════════ */}
  {data.votingEnabled && data.votingStatus !== "closed" && (
    <div class="container">
      <div class={`vBanner vBanner--${data.votingStatus}`}>
        <div class="vBannerLeft">
          <span class="vBannerBadge">
            {data.votingStatus === "open"      && "🗳️ VOTING OPEN"}
            {data.votingStatus === "tallying"  && "⏳ TALLYING VOTES"}
            {data.votingStatus === "published" && "🏆 RESULTS IN"}
          </span>
          <span class="vBannerTitle">
            {data.votingStatus === "open"      && `Vote for the Best in ${city.charAt(0).toUpperCase() + city.slice(1)}!`}
            {data.votingStatus === "tallying"  && "Voting has closed — counting your picks."}
            {data.votingStatus === "published" && "The community has spoken. See who won."}
          </span>
          {data.votingStatus === "open" && data.votingDeadline && (
            <span class="vBannerDeadline">
              Voting closes {new Date(data.votingDeadline).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}
            </span>
          )}
        </div>
        {data.votingStatus === "open" && (
          <a class="vBannerBtn" href="#vote" aria-label="Vote now">
            Vote Now
          </a>
        )}
        {data.votingStatus === "published" && (
          <a class="vBannerBtn vBannerBtn--results" href="#results" aria-label="See results">
            See Results →
          </a>
        )}
      </div>
    </div>
  )}

  {/* ════════ NEW GUIDE: 75/25 layout — body left, ToC + sidebar right ════════
      <Content /> renders the full markdown body (h2, h3, paragraphs, lists).
      The ToC script below queries those headings to build the nav panel.
      Routing note: slugs derived via guide.slug.split("/").pop() preserve the
      -1 suffix that Decap CMS appends to avoid filename collisions — no special
      handling needed here; the path is registered correctly in getStaticPaths().
  ════════════════════════════════════════════════════════════════════════════ */}
  {collectionType === "guide" && (
    <div class="container">
      <div class="homeGrid articleGrid">

        {/* ── Main article column ── */}
        <main>
          <div class="guideMarkdown" id="article-body" data-show-toc={(data as any).showToC !== false ? "true" : "false"}>
            <Content />
          </div>
        </main>

        {/* ── Right sidebar ── */}
        <aside class="homeRail">

          {/* Newsletter */}
          <div class="nlBox">
            <div class="nlBoxHead">
              <em>Good News <strong>{city.charAt(0).toUpperCase() + city.slice(1)}!</strong></em>
            </div>
            <div class="nlBoxSub">Get the best local stories delivered free to your inbox every morning.</div>
            <form class="nlForm" action={`/${city}/subscribe/`} method="get">
              <input class="nlInput" type="email" name="email"
                placeholder="your@email.com" required autocomplete="email" />
              <button class="nlSubmit" type="submit">SIGN UP</button>
            </form>
          </div>

          {/* City Guides links */}
          <div class="railSection">
            <div class="railHead">
              <span class="railTitle">City Guides</span>
              <a class="railMore" href={`/${city}/guides/`}>See all</a>
            </div>
            <div>
              {moreGuides.slice(0, 5).map((g: any) => (
                <a class="guideLink" href={g.href}>{g.emoji} {g.label}</a>
              ))}
            </div>
          </div>

        </aside>
      </div>
    </div>
  )}

  {/* ════════ 75/25 GRID (cityGuide ranked list) ════════ */}
  {collectionType === "cityGuide" && (
  <div class="container">
    <div class="homeGrid">

      {/* ── MAIN COLUMN ── */}
      <main>

        {/* ── Map (renders only when guide has map_locations) ── */}
        {(data as any).map_locations && (data as any).map_locations.length > 0 && (
          <InteractiveMap locations={(data as any).map_locations} height="350px" />
        )}

        {/* ── Items 1–3 always visible ── */}
        <ol class="gList" id="listA">
          {firstHalf.slice(0, 3).map((item: any) => (
            <li class="gItem" id={`spot-${item.rank}`}>
              <div class="iHeader">
                <div class="rankBadge" aria-label={`Number ${item.rank}`}>{item.rank}</div>
                <div class="iMeta">
                  {item.tag && <div class="iTag">{item.tag}</div>}
                  <h2 class="iTitle">
                    {item.href
                      ? <a class="iLink" href={item.href}>{item.title}</a>
                      : item.title
                    }
                  </h2>
                </div>
              </div>
              {item.img && (
                <div class="imgWrap">
                  <img
                    class="itemImg"
                    src={item.img}
                    alt={item.imgAlt || item.title}
                    loading={item.rank <= 2 ? "eager" : "lazy"}
                    decoding="async"
                    onerror="this.closest('.imgWrap').classList.add('imgMissing')"
                  />
                </div>
              )}
              <p class="iBody">{item.body}</p>
              {item.href && (
                <a class="iCta" href={item.href}>Learn more →</a>
              )}
            </li>
          ))}
        </ol>

        {/* ── SPONSOR CARD — between #3 and #4 ───────────────────────────
            Renders when localSponsor (guide frontmatter) OR an active
            globalSponsor is present. Local always wins.
            sponsor.isLocal = true  → sold directly to a city business
            sponsor.isLocal = false → global network campaign (e.g. Nike)
        ─────────────────────────────────────────────────────────────────── */}
        {sponsor && (
          <div class="sponsorWrap" role="complementary"
            aria-label={`Sponsored by ${sponsor.brand}`}>
            <div class="sponsorLabel">
              <span class="sponsorLabelText">
                {sponsor.isLocal ? "Local Sponsor" : "Presented by"}
              </span>
            </div>
            <div class="sponsorCard">
              {sponsor.img && (
                <div class="sponsorImgWrap">
                  <img class="sponsorImg" src={sponsor.img}
                    alt={sponsor.imgAlt || sponsor.brand}
                    loading="lazy" decoding="async" />
                </div>
              )}
              <div class="sponsorBody">
                <div class="sponsorMeta">
                  {sponsor.logo && (
                    <img class="sponsorLogo" src={sponsor.logo}
                      alt={`${sponsor.brand} logo`} loading="lazy" />
                  )}
                  <div class="sponsorBrand">{sponsor.brand}</div>
                </div>
                <div class="sponsorTagline">{sponsor.tagline}</div>
                <p class="sponsorText">{sponsor.body}</p>
                <a class="sponsorCta" href={sponsor.ctaHref}
                  target="_blank" rel="noopener sponsored">
                  {sponsor.ctaText ?? "Learn more"} →
                </a>
              </div>
            </div>
          </div>
        )}

        {/* ── Items 4+ of the always-visible first half ── */}
        {firstHalf.length > 3 && (
          <ol class="gList" id="listA2" start={4}>
            {firstHalf.slice(3).map((item) => (
              <li class="gItem" id={`spot-${item.rank}`}>
                <div class="iHeader">
                  <div class="rankBadge" aria-label={`Number ${item.rank}`}>{item.rank}</div>
                  <div class="iMeta">
                    {item.tag && <div class="iTag">{item.tag}</div>}
                    <h2 class="iTitle">
                      {item.href
                        ? <a class="iLink" href={item.href}>{item.title}</a>
                        : item.title
                      }
                    </h2>
                  </div>
                </div>
                {item.img && (
                  <div class="imgWrap">
                    <img class="itemImg" src={item.img}
                      alt={item.imgAlt || item.title}
                      loading="lazy" decoding="async"
                      onerror="this.closest('.imgWrap').classList.add('imgMissing')"
                    />
                  </div>
                )}
                <p class="iBody">{item.body}</p>
                {item.href && (
                  <a class="iCta" href={item.href}>Learn more →</a>
                )}
              </li>
            ))}
          </ol>
        )}

        {/* Second half — revealed by Load More */}
        {secondHalf.length > 0 && (
          <>
            <ol class="gList gHidden" id="listB"
              start={firstHalf.length + 1} aria-hidden="true">
              {secondHalf.map((item) => (
                <li class="gItem" id={}>
                  <div class="iHeader">
                    <div class="rankBadge" aria-label={}>{item.rank}</div>
                    <div class="iMeta">
                      {item.tag && <div class="iTag">{item.tag}</div>}
                      <h2 class="iTitle">
                        {item.href
                          ? <a class="iLink" href={item.href}>{item.title}</a>
                          : item.title
                        }
                      </h2>
                    </div>
                  </div>
                  {item.img && (
                    <div class="imgWrap">
                      <img
                        class="itemImg"
                        src={item.img}
                        alt={item.imgAlt || item.title}
                        loading="lazy"
                        decoding="async"
                        onerror="this.closest('.imgWrap').classList.add('imgMissing')"
                      />
                    </div>
                  )}
                  <p class="iBody">{item.body}</p>
                  {item.href && (
                    <a class="iCta" href={item.href}>Learn more →</a>
                  )}
                </li>
              ))}
            </ol>

            <div class="loadRow" id="loadRow">
              <button class="loadBtn" id="loadBtn" type="button"
                aria-expanded="false" aria-controls="listB">
                Show spots #{firstHalf.length + 1}–{items.length}
                <svg class="chevron" width="16" height="16" viewBox="0 0 16 16"
                  fill="none" aria-hidden="true">
                  <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2.2"
                    stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </>
        )}

        {/* Optional body markdown (editorial note, disclaimer, etc.) */}
        {guide.body?.trim() && (
          <div class="guideNote prose">
            <Content />
          </div>
        )}

      </main>

      {/* ── SIDEBAR ── */}
      <aside class="homeRail">

        {/* 1 — Email Newsletter Banner (Top) */}
        <div class="nlBox">
          <div class="nlBoxHead">
            <em>Good News <strong>{city.charAt(0).toUpperCase() + city.slice(1)}!</strong></em>
          </div>
          <div class="nlBoxSub">Get the best local stories delivered free to your inbox every morning.</div>
          <form class="nlForm" action={`/${city}/subscribe/`} method="get">
            <input class="nlInput" type="email" name="email"
              placeholder="your@email.com" required autocomplete="email" />
            <button class="nlSubmit" type="submit">SIGN UP</button>
          </form>
        </div>

        {/* 2 — Advertisement */}
        <div class="adSlot">
          <div class="adLabel">Advertisement</div>
          <a class="adCard" href={}>
            <div class="adInner">
              <div class="adIcon">📢</div>
              <div class="adTitle">Your Ad Here</div>
              <div class="adDesc">Reach thousands of {city.charAt(0).toUpperCase() + city.slice(1)} locals</div>
              <div class="adCta">Advertise with us →</div>
            </div>
          </a>
        </div>

        {/* 3 — City Guides */}
        <div class="railSection">
          <div class="railHead">
            <span class="railTitle">City Guides</span>
            <a class="railMore" href={}>See all</a>
          </div>
          <div>
            {moreGuides.slice(0, 5).map((g) => (
              <a class="guideLink" href={g.href}>{g.emoji} {g.label}</a>
            ))}
          </div>
        </div>

      </aside>
    </div>
  </div>
  )}{/* end cityGuide conditional */}

  {/* ════════ MORE GUIDES FOOTER ════════ */}
  <section class="moreSection">
    <div class="container">
      <div class="moreHead">
        <span class="moreLabel">More {city.charAt(0).toUpperCase() + city.slice(1)} Guides</span>
        <a class="moreAll" href={}>Browse all →</a>
      </div>
      <div class="moreGrid">
        {moreGuides.map((g) => (
          <a class="moreCard" href={g.href}>
            <span class="moreEmoji" aria-hidden="true">{g.emoji}</span>
            <div class="moreText">
              <div class="moreCardTitle">{g.label}</div>
              <div class="moreCardSub">{g.sub}</div>
            </div>
            <span class="moreArrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

</div>{/* end .pageWrap */}

{/* ── Load More — vanilla JS, zero deps ── */}
<script is:inline>
(function () {
  var btn  = document.getElementById("loadBtn");
  var list = document.getElementById("listB");
  var row  = document.getElementById("loadRow");
  if (!btn || !list) return;          // guide has ≤ half items, button not rendered
  btn.addEventListener("click", function () {
    list.classList.remove("gHidden");
    list.removeAttribute("aria-hidden");
    btn.setAttribute("aria-expanded", "true");
    row.style.transition = "opacity 280ms ease";
    row.style.opacity = "0";
    setTimeout(function () { row.style.display = "none"; }, 300);
    var first = list.querySelector(".gItem");
    if (first) {
      first.scrollIntoView({ behavior: "smooth", block: "start" });
      setTimeout(function () {
        var lnk = first.querySelector(".iLink");
        if (lnk) lnk.focus();
      }, 420);
    }
  });
})();
</script>

{/* ── Inline ToC builder — repairs buried headings, injects <details> before first <h2> ── */}
<script is:inline>
window.addEventListener('load', function () {
  var article = document.getElementById("article-body");
  if (!article) return;

  /* ── PASS 0: Repair headings buried in ** bold / * italic markers ──────
     Handles: <p><strong>## Section Title</strong></p>
              <p>## Section Title</p>
     e.g. when author writes **## Heading** in Decap CMS editor            */
  var pars = Array.prototype.slice.call(article.querySelectorAll("p"));
  pars.forEach(function (p) {
    var raw = (p.textContent || "").replace(/^\s*\*+\s*/, "").trim();
    var h3m = raw.match(/^###\s+([\s\S]+)/);
    var h2m = !h3m && raw.match(/^##\s+([\s\S]+)/);
    if (!h2m && !h3m) return;
    var level = h3m ? "h3" : "h2";
    var cleanText = ((h3m || h2m)[1] || "").replace(/\*+\s*$/, "").trim();
    if (!cleanText) return;
    var newH = document.createElement(level);
    newH.textContent = cleanText;
    if (p.parentNode) p.parentNode.replaceChild(newH, p);
  });

  /* Skip ToC if disabled in frontmatter */
  if (article.dataset.showToc === "false") return;

  /* ── PASS 1: Build inline <details> ToC ── */
  var headings = Array.prototype.slice.call(article.querySelectorAll("h2, h3"));
  if (!headings.length) return;

  /* Assign slugified IDs */
  headings.forEach(function (h, i) {
    if (!h.id) {
      var slug = (h.textContent || "")
        .toLowerCase().trim()
        .replace(/[^\w\s-]/g, "")
        .replace(/[\s_]+/g, "-")
        .replace(/^-+|-+$/g, "");
      h.id = slug || ("toc-" + i);
    }
  });

  /* Build <details> accordion matching GuideLayout style */
  var details = document.createElement("details");
  details.id        = "guide-toc";
  details.className = "gl-itoc";
  details.open      = window.innerWidth >= 900;

  var summary = document.createElement("summary");
  summary.className = "gl-itoc-summary";
  summary.innerHTML = '<svg class="gl-itoc-hamburger" aria-hidden="true" width="18" height="13" viewBox="0 0 18 13" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="0" y="0" width="18" height="2" rx="1" fill="#ffd24a"/><rect x="0" y="5.5" width="18" height="2" rx="1" fill="#ffd24a"/><rect x="0" y="11" width="18" height="2" rx="1" fill="#ffd24a"/></svg>In this guide <span class="gl-itoc-chevron" aria-hidden="true">&#8250;</span>';
  details.appendChild(summary);

  var list = document.createElement("ul");
  list.className = "gl-itoc-list";

  headings.forEach(function (h) {
    var li = document.createElement("li");
    li.className = h.tagName === "H3" ? "gl-itoc-item gl-itoc-item--sub" : "gl-itoc-item";
    var a = document.createElement("a");
    a.href      = "#" + h.id;
    a.textContent = h.textContent;
    a.className = "gl-itoc-link";
    li.appendChild(a);
    list.appendChild(li);
  });

  details.appendChild(list);

  /* Inject immediately before the first h2 */
  var firstH2 = article.querySelector("h2");
  if (firstH2) {
    article.insertBefore(details, firstH2);
  } else {
    article.insertBefore(details, article.firstChild);
  }
});
</script>

