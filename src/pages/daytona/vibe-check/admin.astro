---
/**
 * /daytona/vibe-check/admin/ — Vibe admin: poll vote adjustments + the
 * Vibe Board approval queue (/api/vibe-posts-admin, functions/api/vibe-posts-admin.js).
 *
 * Static shell; all data comes from /api/vibe-admin (functions/api/vibe-admin.js),
 * which requires the ADMIN_TOKEN. The page itself holds no secrets, so serving
 * it publicly is safe — it's noindexed and does nothing without the token.
 *
 * Adjustments are logged +/- offsets on top of real votes; real votes are never
 * edited. "Undo" posts the opposite offset so the log stays complete.
 */
import { allCitySlugs, getVibeCheck, getDisplayName } from "../../../lib/cityConfigs.js";
import { VIBE_CATEGORIES } from "../../../lib/vibeBoard.js";

const polls = allCitySlugs
  .map((slug) => ({ slug, city: getDisplayName(slug), vc: getVibeCheck(slug) }))
  .filter((p) => p.vc)
  .map((p) => ({
    pollId: p.vc.pollId,
    label: `${p.city} — ${p.vc.question}`,
    options: p.vc.options.map((o) => o.label),
  }));
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Vibe Admin</title>
</head>
<body>
  <main class="wrap">
    <h1>Vibe Admin</h1>

    <section class="panel">
      <label>Admin token
        <input type="password" data-token autocomplete="current-password" />
      </label>
    </section>

    <div class="tabs" role="tablist">
      <button type="button" role="tab" class="tab" data-tab="poll" aria-selected="true">Poll votes</button>
      <button type="button" role="tab" class="tab" data-tab="board" aria-selected="false">Vibe Board queue</button>
    </div>

    <div data-panel="poll">
    <p class="hint">Adjustments are logged offsets on top of real votes. Real votes are never changed.</p>

    <section class="panel" data-auth>
      <label>Poll
        <select data-poll>
          {polls.map((p) => (
            <option value={p.pollId} data-options={JSON.stringify(p.options)}>{p.label} ({p.pollId})</option>
          ))}
          <option value="__custom">Other poll id…</option>
        </select>
      </label>
      <label data-custom-wrap hidden>Poll id
        <input type="text" data-custom-poll placeholder="e.g. ormond-tacos" />
      </label>
      <label data-custom-opts-wrap hidden>Options (one per line)
        <textarea data-custom-opts rows="4"></textarea>
      </label>
      <button type="button" data-load>Load counts</button>
      <p class="msg" data-msg></p>
    </section>

    <section class="panel" data-results hidden>
      <h2>Counts <span class="sub" data-totals></span></h2>
      <table>
        <thead>
          <tr><th>Option</th><th>Real</th><th>Offset</th><th>Shown</th><th>Adjust</th></tr>
        </thead>
        <tbody data-rows></tbody>
      </table>
      <label>Note for this change (optional)
        <input type="text" data-note maxlength="500" placeholder="e.g. removed duplicate votes from one IP" />
      </label>

      <h2>Adjustment log</h2>
      <table>
        <thead>
          <tr><th>When</th><th>Option</th><th>Delta</th><th>Note</th><th></th></tr>
        </thead>
        <tbody data-log></tbody>
      </table>
    </section>
    </div>

    <div data-panel="board" hidden>
      <p class="hint">Community posts from /[city]/vibe/. Nothing appears publicly until it's approved. Emails are private — visible only here.</p>
      <section class="panel">
        <div class="row">
          <label>Show
            <select data-board-status>
              <option value="pending">Pending review</option>
              <option value="approved">Approved (live)</option>
              <option value="rejected">Rejected</option>
            </select>
          </label>
          <label>City
            <select data-board-city>
              <option value="">All cities</option>
              {allCitySlugs.map((slug) => <option value={slug}>{getDisplayName(slug)}</option>)}
            </select>
          </label>
          <button type="button" data-board-load>Load posts</button>
        </div>
        <p class="msg" data-board-msg></p>
      </section>
      <div class="queue" data-board-list data-categories={JSON.stringify(VIBE_CATEGORIES)}></div>
    </div>
  </main>

  <script>
    const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
    const tokenEl = $<HTMLInputElement>("[data-token]");
    const pollEl = $<HTMLSelectElement>("[data-poll]");
    const customPollEl = $<HTMLInputElement>("[data-custom-poll]");
    const customOptsEl = $<HTMLTextAreaElement>("[data-custom-opts]");
    const msgEl = $("[data-msg]");
    const noteEl = $<HTMLInputElement>("[data-note]");

    // Per-tab convenience only — the token is never written to localStorage.
    try { tokenEl.value = sessionStorage.getItem("vibe-admin-token") ?? ""; } catch {}

    pollEl.addEventListener("change", () => {
      const custom = pollEl.value === "__custom";
      $("[data-custom-wrap]").hidden = !custom;
      $("[data-custom-opts-wrap]").hidden = !custom;
    });

    function currentPoll() {
      if (pollEl.value === "__custom") {
        return {
          pollId: customPollEl.value.trim(),
          options: customOptsEl.value.split("\n").map((s) => s.trim()).filter(Boolean),
        };
      }
      const opt = pollEl.selectedOptions[0];
      return { pollId: pollEl.value, options: JSON.parse(opt.dataset.options ?? "[]") as string[] };
    }

    async function api(method: "GET" | "POST", query: string, body?: unknown) {
      const token = tokenEl.value.trim();
      try { sessionStorage.setItem("vibe-admin-token", token); } catch {}
      const res = await fetch(`/api/vibe-admin${query}`, {
        method,
        headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
        body: body ? JSON.stringify(body) : undefined,
      });
      const json = await res.json().catch(() => ({ ok: false, error: `HTTP ${res.status}` }));
      if (!json.ok) throw new Error(json.error ?? `HTTP ${res.status}`);
      return json;
    }

    function cell(text: string | number) {
      const td = document.createElement("td");
      td.textContent = String(text);
      return td;
    }

    async function load() {
      const { pollId, options } = currentPoll();
      if (!pollId) { msgEl.textContent = "Enter a poll id."; return; }
      msgEl.textContent = "Loading…";
      try {
        const qs = new URLSearchParams({ poll: pollId });
        options.forEach((o) => qs.append("option", o));
        const d = await api("GET", `?${qs}`);
        render(pollId, d);
        msgEl.textContent = "";
      } catch (err) {
        msgEl.textContent = `Error: ${(err as Error).message}`;
        $("[data-results]").hidden = true;
      }
    }

    async function adjust(pollId: string, option: string, delta: number, note: string) {
      msgEl.textContent = "Saving…";
      try {
        await api("POST", "", { poll_id: pollId, option_label: option, delta, note });
        noteEl.value = "";
        await load();
      } catch (err) {
        msgEl.textContent = `Error: ${(err as Error).message}`;
      }
    }

    function render(pollId: string, d: any) {
      $("[data-totals]").textContent =
        `— ${d.real_total} real votes · ${d.displayed_total} shown`;

      const rows = $("[data-rows]");
      rows.replaceChildren();
      for (const option of d.options as string[]) {
        const tr = document.createElement("tr");
        const offset = d.offsets[option] ?? 0;
        tr.append(
          cell(option),
          cell(d.real[option] ?? 0),
          cell(offset > 0 ? `+${offset}` : offset),
          cell(d.displayed[option] ?? 0),
        );
        const td = document.createElement("td");
        td.className = "adjust";
        const input = document.createElement("input");
        input.type = "number";
        input.step = "1";
        input.placeholder = "±";
        const btn = document.createElement("button");
        btn.type = "button";
        btn.textContent = "Apply";
        btn.addEventListener("click", () => {
          const delta = Number(input.value);
          if (!Number.isInteger(delta) || delta === 0) { msgEl.textContent = "Enter a non-zero whole number."; return; }
          if (!confirm(`${delta > 0 ? "Add" : "Remove"} ${Math.abs(delta)} vote(s) ${delta > 0 ? "to" : "from"} "${option}"?`)) return;
          adjust(pollId, option, delta, noteEl.value.trim());
        });
        td.append(input, btn);
        tr.append(td);
        rows.append(tr);
      }

      const log = $("[data-log]");
      log.replaceChildren();
      if (!d.adjustments.length) {
        const tr = document.createElement("tr");
        const td = cell("No adjustments yet.");
        td.colSpan = 5;
        tr.append(td);
        log.append(tr);
      }
      for (const a of d.adjustments) {
        const tr = document.createElement("tr");
        tr.append(
          cell(new Date(a.created_at).toLocaleString()),
          cell(a.option_label),
          cell(a.delta > 0 ? `+${a.delta}` : a.delta),
          cell(a.note ?? ""),
        );
        const td = document.createElement("td");
        const undo = document.createElement("button");
        undo.type = "button";
        undo.textContent = "Undo";
        undo.addEventListener("click", () => {
          if (!confirm(`Post a ${-a.delta > 0 ? "+" : ""}${-a.delta} offset to reverse #${a.id}?`)) return;
          adjust(pollId, a.option_label, -a.delta, `undo #${a.id}`);
        });
        td.append(undo);
        tr.append(td);
        log.append(tr);
      }

      $("[data-results]").hidden = false;
    }

    $("[data-load]").addEventListener("click", load);

    // ── Tabs ───────────────────────────────────────────────────────────────
    function showTab(name: string) {
      document.querySelectorAll<HTMLElement>("[data-tab]").forEach((t) =>
        t.setAttribute("aria-selected", String(t.dataset.tab === name)));
      document.querySelectorAll<HTMLElement>("[data-panel]").forEach((p) => { p.hidden = p.dataset.panel !== name; });
      try { sessionStorage.setItem("vibe-admin-tab", name); } catch {}
    }
    document.querySelectorAll<HTMLElement>("[data-tab]").forEach((t) =>
      t.addEventListener("click", () => showTab(t.dataset.tab ?? "poll")));
    try { showTab(sessionStorage.getItem("vibe-admin-tab") ?? "poll"); } catch {}

    // ── Vibe Board approval queue ──────────────────────────────────────────
    const boardList = $("[data-board-list]");
    const boardMsg = $("[data-board-msg]");
    const boardStatus = $<HTMLSelectElement>("[data-board-status]");
    const boardCity = $<HTMLSelectElement>("[data-board-city]");
    const categories: { value: string; label: string; emoji: string }[] =
      JSON.parse(boardList.dataset.categories ?? "[]");

    async function boardApi(method: "GET" | "POST", query: string, body?: unknown) {
      const token = tokenEl.value.trim();
      try { sessionStorage.setItem("vibe-admin-token", token); } catch {}
      const res = await fetch(`/api/vibe-posts-admin${query}`, {
        method,
        headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
        body: body ? JSON.stringify(body) : undefined,
      });
      const json = await res.json().catch(() => ({ ok: false, error: `HTTP ${res.status}` }));
      if (!json.ok) throw new Error(json.error ?? `HTTP ${res.status}`);
      return json;
    }

    function textEl(tag: string, cls: string, text: string) {
      const n = document.createElement(tag);
      n.className = cls;
      n.textContent = text;
      return n;
    }

    // Which moves each view offers: [label, target status, style]
    const ACTIONS: Record<string, [string, string, string][]> = {
      pending:  [["Approve", "approved", "ok"], ["Reject", "rejected", "no"]],
      approved: [["Unpublish", "pending", "muted"], ["Reject", "rejected", "no"]],
      rejected: [["Approve", "approved", "ok"], ["Back to queue", "pending", "muted"]],
    };

    async function loadBoard() {
      boardMsg.textContent = "Loading…";
      try {
        const qs = new URLSearchParams({ status: boardStatus.value });
        if (boardCity.value) qs.set("city", boardCity.value);
        const d = await boardApi("GET", `?${qs}`);
        renderBoard(d.status, d.posts);
        boardMsg.textContent = `${d.posts.length} ${d.posts.length === 1 ? "post" : "posts"}`;
      } catch (err) {
        boardList.replaceChildren();
        boardMsg.textContent = `Error: ${(err as Error).message}`;
      }
    }

    function renderBoard(status: string, posts: any[]) {
      boardList.replaceChildren();
      if (!posts.length) {
        boardList.append(textEl("p", "hint", status === "pending" ? "Queue is clear. 🎉" : "Nothing here."));
        return;
      }
      for (const p of posts) {
        const cat = categories.find((c) => c.value === p.category);
        const item = document.createElement("article");
        item.className = "qItem";
        const meta = document.createElement("div");
        meta.className = "qMeta";
        meta.append(
          textEl("strong", "", `${p.first_name} ${p.last_name}`),
          textEl("span", "", p.email),
          textEl("span", "", cat ? `${cat.emoji} ${cat.label}` : p.category),
          textEl("span", "", p.city),
          textEl("span", "", new Date(p.created_at).toLocaleString()),
        );
        if (p.newsletter_opt_in) meta.append(textEl("span", "pill", "📰 newsletter"));
        if (status === "approved") meta.append(textEl("span", "pill", `❤️ ${p.vibe_count}`));
        item.append(meta, textEl("p", "qMsg", p.message));

        const actions = document.createElement("div");
        actions.className = "qActions";
        for (const [label, target, style] of ACTIONS[status] ?? []) {
          const b = document.createElement("button");
          b.type = "button";
          b.className = `btn-${style}`;
          b.textContent = label;
          b.addEventListener("click", async () => {
            actions.querySelectorAll("button").forEach((x) => (x.disabled = true));
            try {
              await boardApi("POST", "", { id: p.id, status: target });
              item.remove();
              const left = boardList.querySelectorAll(".qItem").length;
              boardMsg.textContent = `${label} ✓ — ${left} left`;
              if (!left) renderBoard(status, []);
            } catch (err) {
              boardMsg.textContent = `Error: ${(err as Error).message}`;
              actions.querySelectorAll("button").forEach((x) => (x.disabled = false));
            }
          });
          actions.append(b);
        }
        item.append(actions);
        boardList.append(item);
      }
    }

    $("[data-board-load]").addEventListener("click", loadBoard);
    boardStatus.addEventListener("change", loadBoard);
    boardCity.addEventListener("change", loadBoard);
  </script>

  <style>
    :root { color-scheme: light dark; --bg: #f6f7f9; --card: #fff; --text: #111827; --muted: #6b7280; --line: #e5e7eb; --accent: #0077be; }
    @media (prefers-color-scheme: dark) {
      :root { --bg: #0f1216; --card: #181c22; --text: #e5e7eb; --muted: #9ca3af; --line: #2a2f37; }
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.5 system-ui, sans-serif; }
    .wrap { max-width: 860px; margin: 0 auto; padding: 32px 16px 64px; }
    h1 { margin: 0 0 4px; font-size: 26px; }
    h2 { font-size: 17px; margin: 24px 0 10px; }
    h2:first-child { margin-top: 0; }
    .sub { font-weight: 500; color: var(--muted); font-size: 14px; }
    .hint { color: var(--muted); margin: 0 0 20px; }
    .panel { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 20px; margin-bottom: 20px; display: grid; gap: 12px; }
    label { display: grid; gap: 4px; font-weight: 600; font-size: 13px; }
    input, select, textarea { font: inherit; padding: 8px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--text); width: 100%; }
    button { font: inherit; font-weight: 700; padding: 8px 14px; border: 0; border-radius: 8px; background: var(--accent); color: #fff; cursor: pointer; justify-self: start; }
    button:hover { opacity: .88; }
    .msg { margin: 0; color: var(--muted); min-height: 1.5em; }
    .panel > table { display: block; overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: middle; }
    th { font-size: 12px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
    td.adjust { display: flex; gap: 6px; }
    td.adjust input { width: 80px; }
    td button { padding: 6px 10px; font-size: 13px; }
    [hidden] { display: none !important; }

    .tabs { display: flex; gap: 4px; margin: 0 0 16px; border-bottom: 1px solid var(--line); }
    .tab { background: transparent; color: var(--muted); border-radius: 8px 8px 0 0; padding: 10px 16px; border-bottom: 2px solid transparent; }
    .tab[aria-selected="true"] { color: var(--text); border-bottom-color: var(--accent); }
    .row { display: flex; flex-wrap: wrap; gap: 12px; align-items: end; }
    .row label { flex: 1 1 180px; }
    .queue { display: grid; gap: 12px; }
    .qItem { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 16px 18px; display: grid; gap: 10px; }
    .qMeta { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 13px; color: var(--muted); align-items: center; }
    .qMeta strong { color: var(--text); font-size: 15px; }
    .qMsg { margin: 0; white-space: pre-line; overflow-wrap: anywhere; }
    .qActions { display: flex; flex-wrap: wrap; gap: 8px; }
    .pill { padding: 1px 8px; border-radius: 999px; border: 1px solid var(--line); }
    .btn-ok { background: #15803d; }
    .btn-no { background: #b91c1c; }
    .btn-muted { background: var(--line); color: var(--text); }
    button:disabled { opacity: .5; cursor: wait; }
  </style>
</body>
</html>
