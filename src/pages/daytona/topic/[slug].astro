---
// src/pages/daytona/topic/[slug].astro
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";

/** Daytona filter */
function isDaytonaPost(post) {
  const city = String(post?.data?.city ?? "daytona").toLowerCase().trim();
  if (city === "daytona") return true;
  return typeof post?.id === "string" && post.id.startsWith("daytona/");
}

/** Featured flag */
function isFeatured(post) {
  const v = post?.data?.featured;
  if (v === true) return true;
  if (v === 1) return true;
  const s = String(v ?? "").toLowerCase().trim();
  return s === "true" || s === "yes" || s === "1";
}

/** Tag normalization */
function tagKey(raw) {
  return String(raw ?? "")
    .toLowerCase()
    .trim()
    .replace(/[-_]+/g, " ")
    .replace(/\s+/g, " ");
}

function tagSlugFromKey(key) {
  return String(key ?? "")
    .toLowerCase()
    .trim()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
}

function tagLabelFromKey(key) {
  const s = String(key ?? "").trim().replace(/\s+/g, " ");
  if (!s) return "";
  return s
    .split(" ")
    .filter(Boolean)
    .map((w) => (w ? w.charAt(0).toUpperCase() + w.slice(1) : ""))
    .join(" ");
}

/** Dates */
function getPostDate(post) {
  return (
    post?.data?.pubDate ??
    post?.data?.date ??
    post?.data?.published ??
    post?.data?.updated ??
    null
  );
}

function sortNewestFirst(a, b) {
  const da = new Date(getPostDate(a) ?? 0).getTime();
  const db = new Date(getPostDate(b) ?? 0).getTime();
  return db - da;
}

/** Topic membership */
function postHasTopic(post, topicKey) {
  const tags = Array.isArray(post?.data?.tags) ? post.data.tags : [];
  const keys = tags.map(tagKey).filter(Boolean);
  return keys.includes(topicKey);
}

/** Optional hero image field */
function heroImage(post) {
  return post?.data?.heroImage ?? "";
}

function dateText(post) {
  const d = getPostDate(post);
  if (!d) return "";
  try {
    return new Date(d).toLocaleDateString("en-US", { month: "long", day: "2-digit", year: "numeric" });
  } catch {
    return "";
  }
}

function excerpt(post) {
  return post?.data?.description ?? "";
}

/**
 * getStaticPaths: build all topic pages from unique tag keys
 * (uses ONLY locally defined helpers)
 */
export async function getStaticPaths() {
  const all = await getCollection("posts");
  const daytona = all.filter(isDaytonaPost);

  const set = new Set();
  for (const p of daytona) {
    const tags = Array.isArray(p?.data?.tags) ? p.data.tags : [];
    for (const t of tags) {
      const k = tagKey(t);
      if (k) set.add(k);
    }
  }

  return Array.from(set).map((key) => ({
    params: { slug: tagSlugFromKey(key) },
    props: { topicKey: key },
  }));
}

/** Page data */
const { topicKey } = Astro.props;
const topicLabel = tagLabelFromKey(topicKey);

const all = await getCollection("posts");
const posts = all
  .filter(isDaytonaPost)
  .filter((p) => postHasTopic(p, topicKey))
  .sort(sortNewestFirst);

/**
 * Decision #2 (hero selection):
 * - first featured post
 * - else newest
 * - do not duplicate hero in list
 */
const hero = posts.find(isFeatured) ?? posts[0] ?? null;
const rest = hero ? posts.filter((p) => p.slug !== hero.slug) : posts;
---

<Base title={`${topicLabel} | GoDo Daytona`} subtitle={`${topicLabel}`} cityBase="daytona" />

<section class="section">
  <div class="container" style="max-width: 1020px;">
    <!-- Decision #1: NO "TOPIC" kicker -->
    <header class="topicHeader">
      <h1 class="topicTitle">{topicLabel}</h1>
      <div class="topicMeta">{posts.length} post{posts.length === 1 ? "" : "s"}</div>
    </header>

    {hero && (
      <a class="heroRow" href={`/daytona/posts/${hero.slug}/`} aria-label={`Open post: ${hero.data.title ?? hero.slug}`}>
        {heroImage(hero) ? (
          <img
            class="heroThumb"
            src={heroImage(hero)}
            alt={hero.data.title ?? "Hero image"}
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="heroThumb heroThumbEmpty" aria-hidden="true"></div>
        )}

        <div class="heroText">
          <div class="heroKicker">{topicLabel}</div>
          <div class="heroTitle">{hero.data.title ?? hero.slug}</div>
          {excerpt(hero) && <div class="heroDesc">{excerpt(hero)}</div>}
          {dateText(hero) && <div class="heroMeta">{dateText(hero)}</div>}
        </div>

        {isFeatured(hero) && <span class="featuredPill">FEATURED</span>}
      </a>
    )}

    <div class="feed">
      {rest.map((p) => (
        <a class="feedItem" href={`/daytona/posts/${p.slug}/`} aria-label={`Open post: ${p.data.title ?? p.slug}`}>
          {heroImage(p) ? (
            <img
              class="feedThumb"
              src={heroImage(p)}
              alt={p.data.title ?? "Thumbnail"}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="feedThumb feedThumbEmpty" aria-hidden="true"></div>
          )}

          <div class="feedText">
            <div class={`feedTitle ${isFeatured(p) ? "isFeatured" : ""}`}>{p.data.title ?? p.slug}</div>
            {excerpt(p) && <div class="feedDesc">{excerpt(p)}</div>}
            {dateText(p) && <div class="feedMeta">{dateText(p)}</div>}
          </div>

          {isFeatured(p) && <span class="feedFeaturedPill">FEATURED</span>}
        </a>
      ))}
    </div>

    <p style="margin-top:18px;display:flex;gap:10px;flex-wrap:wrap;">
      <a class="pill" href="/daytona/topics/">← All topics</a>
      <a class="pill" href="/daytona/posts/">Latest posts</a>
    </p>
  </div>
</section>

<style>
  .topicHeader { margin: 6px 0 18px 0; }
  .topicTitle {
    margin: 0;
    font-size: clamp(34px, 5vw, 62px);
    line-height: 1.03;
    letter-spacing: -0.02em;
  }
  .topicMeta { margin-top: 8px; opacity: .7; }

  /* HERO ROW (NOOGAtoday-ish) */
  .heroRow {
    position: relative;
    display: grid;
    grid-template-columns: minmax(220px, 360px) 1fr;
    gap: 18px;
    align-items: center;
    text-decoration: none;
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.02);
    border-radius: 16px;
    padding: 14px;
    cursor: pointer;
    overflow: hidden;
  }
  .heroRow:hover { background: rgba(255,255,255,.03); border-color: rgba(255,255,255,.14); }

  .heroThumb {
    width: 100%;
    height: 200px;
    border-radius: 14px;
    object-fit: cover;
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.02);
  }
  .heroThumbEmpty { height: 200px; }

  .heroText { min-width: 0; }
  .heroKicker {
    font-weight: 900;
    font-size: 12px;
    letter-spacing: .10em;
    text-transform: uppercase;
    opacity: .75;
    margin-bottom: 10px;
  }
  .heroTitle {
    font-weight: 950;
    font-size: clamp(22px, 2.2vw, 34px);
    line-height: 1.12;
    margin: 0;
  }
  .heroDesc {
    margin-top: 10px;
    opacity: .86;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .heroMeta { margin-top: 12px; opacity: .65; font-size: 13px; }

  .featuredPill {
    position: absolute;
    top: 14px;
    right: 14px;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .04em;
    padding: 6px 10px;
    border-radius: 999px;
    border: 1px solid rgba(255,220,80,.65);
    color: rgba(255,220,80,.95);
    background: rgba(255,220,80,.12);
    white-space: nowrap;
    pointer-events: none;
  }

  /* FEED LIST */
  .feed { margin-top: 18px; display: grid; gap: 14px; }

  .feedItem {
    position: relative;
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: 16px;
    align-items: center;
    text-decoration: none;
    border: 1px solid rgba(255,255,255,.08);
    background: rgba(255,255,255,.015);
    border-radius: 14px;
    padding: 12px;
    cursor: pointer;
    overflow: hidden;
  }
  .feedItem:hover { background: rgba(255,255,255,.02); border-color: rgba(255,255,255,.12); }

  .feedThumb {
    width: 100%;
    height: 120px;
    border-radius: 12px;
    object-fit: cover;
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.02);
  }
  .feedThumbEmpty { height: 120px; }

  .feedText { min-width: 0; }
  .feedTitle {
    font-weight: 950;
    font-size: 18px;
    line-height: 1.15;
    margin: 0;
  }
  /* Featured headings 15% larger */
  .feedTitle.isFeatured { font-size: calc(18px * 1.15); }

  .feedDesc {
    margin-top: 8px;
    opacity: .82;
    font-size: 14px;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .feedMeta { margin-top: 10px; opacity: .6; font-size: 13px; }

  .feedFeaturedPill {
    position: absolute;
    top: 12px;
    right: 12px;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .04em;
    padding: 6px 10px;
    border-radius: 999px;
    border: 1px solid rgba(255,220,80,.55);
    color: rgba(255,220,80,.95);
    background: rgba(255,220,80,.10);
    white-space: nowrap;
    pointer-events: none;
  }

  @media (max-width: 820px) {
    .heroRow { grid-template-columns: 1fr; }
    .heroThumb, .heroThumbEmpty { height: 220px; }
    .feedItem { grid-template-columns: 1fr; }
    .feedThumb, .feedThumbEmpty { height: 200px; }
  }
</style>
