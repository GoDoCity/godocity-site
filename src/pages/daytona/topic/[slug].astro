---
import Base from "../../../layouts/Base.astro";
import ArticleSidebar from "../../../components/ArticleSidebar.astro";
import { getCollection } from "astro:content";

/** Daytona filter */
function isDaytonaPost(post) {
  const city = String(post?.data?.city ?? "daytona").toLowerCase().trim();
  if (city === "daytona") return true;
  return typeof post?.id === "string" && post.id.startsWith("daytona/");
}

/** Featured flag */
function isFeatured(post) {
  const v = post?.data?.featured;
  if (v === true) return true;
  if (v === 1) return true;
  const s = String(v ?? "").toLowerCase().trim();
  return s === "true" || s === "yes" || s === "1";
}

/** Tag normalization */
function tagKey(raw) {
  return String(raw ?? "")
    .toLowerCase()
    .trim()
    .replace(/[-_]+/g, " ")
    .replace(/\s+/g, " ");
}

function tagSlugFromKey(key) {
  return String(key ?? "")
    .toLowerCase()
    .trim()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
}

function tagLabelFromKey(key) {
  const s = String(key ?? "").trim().replace(/\s+/g, " ");
  if (!s) return "";
  return s
    .split(" ")
    .filter(Boolean)
    .map((w) => (w ? w.charAt(0).toUpperCase() + w.slice(1) : ""))
    .join(" ");
}

/** Dates */
function getPostDate(post) {
  return (
    post?.data?.pubDate ??
    post?.data?.date ??
    post?.data?.published ??
    post?.data?.updated ??
    null
  );
}

function sortNewestFirst(a, b) {
  const da = new Date(getPostDate(a) ?? 0).getTime();
  const db = new Date(getPostDate(b) ?? 0).getTime();
  return db - da;
}

/** Topic membership */
function postHasTopic(post, topicKey) {
  const tags = Array.isArray(post?.data?.tags) ? post.data.tags : [];
  const keys = tags.map(tagKey).filter(Boolean);
  return keys.includes(topicKey);
}

/** Optional hero image field */
function heroImage(post) {
  return post?.data?.heroImage ?? "";
}

function dateText(post) {
  const d = getPostDate(post);
  return d ? new Date(d).toLocaleDateString("en-US") : "";
}

function excerpt(post) {
  return post?.data?.description ?? "";
}

function postKicker(post) {
  const cat = post?.data?.category;
  if (typeof cat === "string" && cat.trim()) return cat.trim().toUpperCase();
  const tags = Array.isArray(post?.data?.tags) ? post.data.tags : [];
  const first = tags[0];
  if (typeof first === "string" && first.trim()) return first.trim().toUpperCase();
  return "";
}

/**
 * getStaticPaths: build all topic pages from unique tag keys
 * BUILD-SAFE: inline Daytona filter + tag normalization here
 * (avoids "isDaytonaPost is not defined" during build)
 */
export async function getStaticPaths() {
  const all = await getCollection("posts");

  const daytona = all.filter((post) => {
    const city = String(post?.data?.city ?? "daytona").toLowerCase().trim();
    if (city === "daytona") return true;
    return typeof post?.id === "string" && post.id.startsWith("daytona/");
  });

  const _tagKey = (raw) =>
    String(raw ?? "")
      .toLowerCase()
      .trim()
      .replace(/[-_]+/g, " ")
      .replace(/\s+/g, " ");

  const _tagSlugFromKey = (key) =>
    String(key ?? "")
      .toLowerCase()
      .trim()
      .replace(/&/g, "and")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/(^-|-$)/g, "");

  const set = new Set();
  for (const p of daytona) {
    const tags = Array.isArray(p?.data?.tags) ? p.data.tags : [];
    for (const t of tags) {
      const k = _tagKey(t);
      if (k) set.add(k);
    }
  }

  return Array.from(set).map((key) => ({
    params: { slug: _tagSlugFromKey(key) },
    props: { topicKey: key },
  }));
}

/** Page data */
const { topicKey } = Astro.props;
const topicLabel = tagLabelFromKey(topicKey);

const all = await getCollection("posts");
const posts = all
  .filter(isDaytonaPost)
  .filter((p) => postHasTopic(p, topicKey))
  .sort(sortNewestFirst);

/**
 * Hero selection (unchanged):
 * - first featured post
 * - else newest
 * - do not duplicate hero in list
 */
const hero = posts.find(isFeatured) ?? posts[0] ?? null;
const rest = hero ? posts.filter((p) => p.slug !== hero.slug) : posts;
---

<Base title={`${topicLabel} | GoDoDaytona`} subtitle={`${topicLabel}`} cityBase="daytona">

<section class="section">
  <div class="pageWrap">

    <div class="topicHeader">
      <h1 class="topicTitle">{topicLabel}</h1>
      <div class="topicMeta">{posts.length} article{posts.length === 1 ? "" : "s"}</div>
    </div>

    <div class="topicLayout">
      <div class="topicMain">

        {/* ── Featured Hero ── */}
        {hero && (
          <a class="heroCard" href={`/daytona/posts/${hero.slug.split("/").pop()}/`}>
            {heroImage(hero) && (
              <div class="heroMedia">
                <img
                  class="heroImg"
                  src={heroImage(hero)}
                  alt={hero.data.title ?? "Hero image"}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
            <div class="heroBody">
              <div class="heroKicker">{isFeatured(hero) ? "FEATURED" : "TOP STORY"}</div>
              <div class="heroTitle">{hero.data.title}</div>
              {excerpt(hero) && <div class="heroDesc">{excerpt(hero)}</div>}
              <div class="heroMeta">{dateText(hero)}</div>
            </div>
          </a>
        )}

        {/* ── 3-Column Card Grid ── */}
        {rest.length > 0 && (
          <div class="cardGrid">
            {rest.map((p) => {
              const img = heroImage(p);
              const kicker = postKicker(p);
              return (
                <a class="mfCard" href={`/daytona/posts/${p.slug.split("/").pop()}/`}>
                  <div class="mfImgWrap">
                    {img
                      ? <img class="mfImg" src={img} alt="" loading="lazy" decoding="async" />
                      : <div class="mfImg mfImgFallback" aria-hidden="true" />
                    }
                  </div>
                  <div class="mfBody">
                    {kicker && <div class="mfKicker">{kicker}</div>}
                    <div class="mfTitle">{p.data.title ?? p.slug}</div>
                    <div class="mfMeta">{dateText(p)}</div>
                  </div>
                </a>
              );
            })}
          </div>
        )}

        <p class="topicLinks">
          <a class="pill" href="/daytona/topics/">← All topics</a>
          <a class="pill" href="/daytona/posts/">Latest posts</a>
        </p>

      </div>

      {/* ── RIGHT: production sidebar — identical to DIY and News post pages ── */}
      <ArticleSidebar city="daytona" pageType="Topics" />

    </div>

  </div>
</section>

</Base>

<style>
  /* ── Layout tokens (scoped — not :root) ── */
  .topicLayout, .topicHeader, .topicMain, .pageWrap {
    --card-radius: 18px;
    --card-border: rgba(255,255,255,.10);
    --card-border-hover: rgba(255,220,80,.22);
    --card-bg: rgba(255,255,255,.035);
    --card-bg-hover: rgba(255,255,255,.05);
    --shadow-soft: 0 10px 30px rgba(0,0,0,.24);
    --lift: translateY(-2px);
    --ease: 160ms ease;
  }

  /* ── Page header ── */
  .topicHeader { margin-bottom: 18px; }
  .topicTitle {
    margin: 8px 0 6px;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .topicMeta { opacity: .72; font-size: 14px; }

  /* ── Wrapper: matches DiyPill and posts pages exactly ── */
  .pageWrap { max-width: 1280px; margin: 0 auto; padding: 0 2rem; }
  @media (max-width: 600px) { .pageWrap { padding: 0 1rem; } }

  /* ── Two-column layout: 7fr/3fr — identical to DiyPill and GuideLayout ── */
  .topicLayout {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(380px, 3fr);
    gap: 56px;
    align-items: start;
  }
  .topicMain { min-width: 0; }
  @media (max-width: 1150px) {
    .topicLayout { grid-template-columns: 1fr; gap: 40px; }
  }

  /* ── Hero card ── */
  .heroCard {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 0;
    border-radius: var(--card-radius);
    border: 1px solid var(--card-border);
    background: var(--card-bg);
    overflow: hidden;
    text-decoration: none;
    margin: 6px 0 22px;
    transition: transform var(--ease), background var(--ease), border-color var(--ease), box-shadow var(--ease);
    will-change: transform;
  }
  @media (max-width: 700px) { .heroCard { grid-template-columns: 1fr; } }
  .heroCard:hover {
    transform: var(--lift);
    background: var(--card-bg-hover);
    border-color: var(--card-border-hover);
    box-shadow: 0 0 0 1px rgba(255,220,80,.08), var(--shadow-soft);
  }

  .heroMedia { position: relative; overflow: hidden; background: rgba(255,255,255,.02); }
  .heroMedia::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(0,0,0,0) 55%, rgba(0,0,0,.18) 100%);
  }
  .heroImg {
    width: 100%;
    height: 100%;
    display: block;
    aspect-ratio: 4/3;
    object-fit: cover;
    transform: scale(1.01);
    transition: transform 320ms ease;
  }
  .heroCard:hover .heroImg { transform: scale(1.04); }

  .heroBody {
    padding: 18px 16px 16px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }
  .heroKicker {
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .10em;
    text-transform: uppercase;
    color: var(--brand1);
    margin-bottom: 10px;
  }
  .heroTitle {
    font-weight: 950;
    font-size: clamp(20px, 2.2vw, 28px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color 130ms, color 130ms;
  }
  .heroCard:hover .heroTitle {
    color: var(--brand1);
    text-decoration-color: var(--brand1);
  }
  .heroDesc {
    margin-top: 10px;
    opacity: .86;
    font-size: 14px;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--color-text-main);
  }
  .heroMeta { margin-top: 12px; opacity: .60; font-size: 12px; color: var(--faint); }

  /* ── 3-column card grid ── */
  .cardGrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 8px;
  }
  @media (max-width: 700px) { .cardGrid { grid-template-columns: repeat(2, 1fr); gap: 14px; } }
  @media (max-width: 480px) { .cardGrid { grid-template-columns: 1fr; } }

  .mfCard {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: opacity 140ms;
  }
  .mfCard:hover { opacity: .88; }

  .mfImgWrap {
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 10px;
    background: var(--surface2);
  }
  .mfImg {
    display: block;
    width: 100%;
    aspect-ratio: 16/10;
    object-fit: cover;
    transition: transform 280ms ease;
  }
  .mfCard:hover .mfImg { transform: scale(1.03); }
  .mfImgFallback { aspect-ratio: 16/10; }

  .mfBody { display: flex; flex-direction: column; gap: 5px; }
  .mfKicker {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .09em;
    text-transform: uppercase;
    color: var(--brand1);
  }
  .mfTitle {
    font-size: 15px;
    font-weight: 800;
    line-height: 1.22;
    letter-spacing: -0.1px;
    color: var(--text);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 2px;
    transition: color 130ms, text-decoration-color 130ms;
  }
  .mfCard:hover .mfTitle {
    color: var(--brand1);
    text-decoration-color: var(--brand1);
  }
  .mfMeta { font-size: 11.5px; color: var(--faint); }

  /* ── Topic nav pills ── */
  .topicLinks {
    margin-top: 24px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* sidebar styles live in ArticleSidebar.astro */
</style>
