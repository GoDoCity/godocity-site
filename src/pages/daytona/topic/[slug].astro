---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";

/** Daytona filter (MUST be module-scope + hoisted for getStaticPaths build) */
function isDaytonaPost(post) {
  const city = String(post?.data?.city ?? "daytona").toLowerCase().trim();
  if (city === "daytona") return true;
  return typeof post?.id === "string" && post.id.startsWith("daytona/");
}

/** Featured flag */
function isFeatured(post) {
  const v = post?.data?.featured;
  if (v === true) return true;
  if (v === 1) return true;
  const s = String(v ?? "").toLowerCase().trim();
  return s === "true" || s === "yes" || s === "1";
}

/** Tag normalization */
function tagKey(raw) {
  return String(raw ?? "")
    .toLowerCase()
    .trim()
    .replace(/[-_]+/g, " ")
    .replace(/\s+/g, " ");
}

function tagSlugFromKey(key) {
  return String(key ?? "")
    .toLowerCase()
    .trim()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
}

function tagLabelFromKey(key) {
  const s = String(key ?? "").trim().replace(/\s+/g, " ");
  if (!s) return "";
  return s
    .split(" ")
    .filter(Boolean)
    .map((w) => (w ? w.charAt(0).toUpperCase() + w.slice(1) : ""))
    .join(" ");
}

/** Dates */
function getPostDate(post) {
  return (
    post?.data?.pubDate ??
    post?.data?.date ??
    post?.data?.published ??
    post?.data?.updated ??
    null
  );
}

function sortNewestFirst(a, b) {
  const da = new Date(getPostDate(a) ?? 0).getTime();
  const db = new Date(getPostDate(b) ?? 0).getTime();
  return db - da;
}

/** Topic membership */
function postHasTopic(post, topicKey) {
  const tags = Array.isArray(post?.data?.tags) ? post.data.tags : [];
  const keys = tags.map(tagKey).filter(Boolean);
  return keys.includes(topicKey);
}

/** Optional hero image field */
function heroImage(post) {
  return post?.data?.heroImage ?? "";
}

function dateText(post) {
  const d = getPostDate(post);
  return d ? new Date(d).toLocaleDateString("en-US") : "";
}

function excerpt(post) {
  return post?.data?.description ?? "";
}

/**
 * getStaticPaths: build all topic pages from unique tag keys
 * NOTE: build-safe: only references module-scope helpers
 */
export async function getStaticPaths() {
  const all = await getCollection("posts");
  const daytona = all.filter(isDaytonaPost);

  const set = new Set();
  for (const p of daytona) {
    const tags = Array.isArray(p?.data?.tags) ? p.data.tags : [];
    for (const t of tags) {
      const k = tagKey(t);
      if (k) set.add(k);
    }
  }

  return Array.from(set).map((key) => ({
    params: { slug: tagSlugFromKey(key) },
    props: { topicKey: key },
  }));
}

/** Page data */
const { topicKey } = Astro.props;
const topicLabel = tagLabelFromKey(topicKey);

const all = await getCollection("posts");
const posts = all
  .filter(isDaytonaPost)
  .filter((p) => postHasTopic(p, topicKey))
  .sort(sortNewestFirst);

/**
 * Hero selection (keep exactly):
 * - first featured post
 * - else newest
 * - do not duplicate hero in list
 */
const hero = posts.find(isFeatured) ?? posts[0] ?? null;
const rest = hero ? posts.filter((p) => p.slug !== hero.slug) : posts;
---

<Base title={`${topicLabel} | GoDo Daytona`} subtitle={`${topicLabel}`} cityBase="daytona" />

<section class="section">
  <div class="container" style="max-width: 1080px;">

    <!-- Header stays full-width -->
    <div class="topicHeader">
      <h1 class="topicTitle">{topicLabel}</h1>
      <div class="topicMeta">{posts.length} post{posts.length === 1 ? "" : "s"}</div>
    </div>

    <!-- Layout: main + sidebar (CSS only, safe) -->
    <div class="topicLayout">
      <div class="topicMain">

        {hero && (
          <a class="heroCard" href={`/daytona/posts/${hero.slug}/`}>
            {heroImage(hero) && (
              <div class="heroMedia">
                <img
                  class="heroImg"
                  src={heroImage(hero)}
                  alt={hero.data.title ?? "Hero image"}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}

            <div class="heroBody">
              <div class="heroKicker">{isFeatured(hero) ? "FEATURED" : "TOP STORY"}</div>
              <div class="heroTitle">{hero.data.title}</div>
              {excerpt(hero) && <div class="heroDesc">{excerpt(hero)}</div>}
              <div class="heroMeta">{dateText(hero)}</div>
            </div>
          </a>
        )}

        <div class="list">
          {rest.map((p) => (
            <a class="row" href={`/daytona/posts/${p.slug}/`}>
              {heroImage(p) ? (
                <div class="rowThumbWrap">
                  <img
                    class="rowThumb"
                    src={heroImage(p)}
                    alt={p.data.title ?? "Thumbnail"}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              ) : (
                <div class="rowThumbWrap isEmpty" aria-hidden="true"></div>
              )}

              <div class="rowText">
                <div class="rowTitle">{p.data.title ?? p.slug}</div>
                {excerpt(p) && <div class="rowDesc">{excerpt(p)}</div>}
                <div class="rowMeta">{dateText(p)}</div>
              </div>
            </a>
          ))}
        </div>

        <p class="topicLinks">
          <a class="pill" href="/daytona/topics/">← All topics</a>
          <a class="pill" href="/daytona/posts/">Latest posts</a>
        </p>

      </div>

      <!-- Sidebar (standard wrappers you requested) -->
      <aside class="topicSidebar">
        <div class="moduleCard newsletterCard">
          <div class="moduleTitle">Good news for Daytona</div>
          <div class="moduleSubtext">Get the best local posts and events sent to your inbox, for free.</div>

          <div class="newsletterForm">
            <input class="newsletterInput" type="email" placeholder="Enter your email address" aria-label="Email address" />
            <button class="newsletterButton" type="button">SIGN UP — IT’S FREE!</button>
          </div>

          <div class="moduleFineprint">100% free. Unsubscribe anytime.</div>
        </div>

        <div class="moduleCard eventsCard">
          <div class="moduleTitle">Upcoming Events</div>

          <div class="eventsList" role="list">
            <div class="eventRow" role="listitem">
              <div class="eventDate">
                <div class="eventDay">SAT</div>
                <div class="eventNum">15</div>
              </div>
              <div class="eventInfo">
                <div class="eventName">Add your first event</div>
                <div class="eventPlace">Daytona Beach</div>
              </div>
            </div>

            <div class="eventDivider" aria-hidden="true"></div>

            <div class="eventRow" role="listitem">
              <div class="eventDate">
                <div class="eventDay">SUN</div>
                <div class="eventNum">16</div>
              </div>
              <div class="eventInfo">
                <div class="eventName">Second event placeholder</div>
                <div class="eventPlace">Ormond Beach</div>
              </div>
            </div>
          </div>
        </div>
      </aside>

    </div>

  </div>
</section>

<style>
  /* ----------------------------
     Premium card system (v3)
     ---------------------------- */
  :root{
    --card-radius: 18px;
    --card-border: rgba(255,255,255,.10);
    --card-border-hover: rgba(255,220,80,.22);
    --card-bg: rgba(255,255,255,.035);
    --card-bg-hover: rgba(255,255,255,.05);
    --shadow-soft: 0 10px 30px rgba(0,0,0,.24);
    --lift: translateY(-2px);
    --ease: 160ms ease;
  }

  /* Header */
  .topicHeader { margin-bottom: 18px; }
  .topicTitle{
    margin: 8px 0 6px 0;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .topicMeta{
    opacity: .72;
    font-size: 14px;
    line-height: 1.2;
  }

  /* Layout */
  .topicLayout{
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 18px;
    align-items: start;
  }
  .topicMain{ min-width: 0; }
  .topicSidebar{
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: sticky;
    top: 16px;
  }

  @media (max-width: 980px){
    .topicLayout{ grid-template-columns: 1fr; }
    .topicSidebar{ position: static; }
  }

  /* Shared card base */
  .heroCard, .row, .moduleCard{
    border-radius: var(--card-radius);
    border: 1px solid var(--card-border);
    background: var(--card-bg);
    transition: transform var(--ease), background var(--ease), border-color var(--ease), box-shadow var(--ease), filter var(--ease);
    will-change: transform;
  }

  .heroCard:hover, .row:hover, .moduleCard:hover{
    transform: var(--lift);
    background: var(--card-bg-hover);
    border-color: var(--card-border-hover);
    box-shadow: 0 0 0 1px rgba(255,220,80,.08), var(--shadow-soft);
  }

  /* ----------------------------
     Hero (editorial crop + gradient anchor)
     ---------------------------- */
  .heroCard{
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 0;
    overflow: hidden;
    text-decoration: none;
    margin: 6px 0 18px;
  }

  @media (max-width: 880px){
    .heroCard{ grid-template-columns: 1fr; }
  }

  .heroMedia{
    position: relative;
    overflow: hidden;
    background: rgba(255,255,255,.02);
  }

  /* subtle bottom gradient overlay (anchored title feel, not heavy darkening) */
  .heroMedia::after{
    content:"";
    position:absolute;
    inset: 0;
    pointer-events:none;
    background: linear-gradient(to bottom,
      rgba(0,0,0,0) 55%,
      rgba(0,0,0,.18) 78%,
      rgba(0,0,0,.26) 100%);
  }

  .heroImg{
    width: 100%;
    height: 100%;
    display: block;
    aspect-ratio: 4 / 3; /* slightly taller, more magazine-like */
    object-fit: cover;
    transform: scale(1.01);
  }

  .heroBody{
    padding: 18px 18px 16px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .heroKicker{
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .10em;
    opacity: .78;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .heroTitle{
    font-weight: 950;
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1.10;
    letter-spacing: -0.015em;
  }

  .heroDesc{
    margin-top: 10px;
    opacity: .86;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .heroMeta{
    margin-top: 12px;
    opacity: .62;
    font-size: 12.5px;
    line-height: 1.2;
  }

  /* ----------------------------
     List (NOOGAtoday-ish: bigger thumbs, tighter alignment)
     ---------------------------- */
  .list{
    display: grid;
    gap: 12px; /* slightly more air between rows */
    margin-top: 6px;
  }

  .row{
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    align-items: center;
    padding: 14px 14px;
    text-decoration: none;
    cursor: pointer;
  }

  .rowText{ min-width: 0; }

  .rowTitle{
    font-weight: 900;
    font-size: 17px;
    line-height: 1.18;
    letter-spacing: -0.01em;
  }

  .rowDesc{
    margin-top: 7px;
    opacity: .84;
    font-size: 14px;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rowMeta{
    margin-top: 9px;
    opacity: .58; /* softer */
    font-size: 12.5px;
    line-height: 1.2;
  }

  .rowThumbWrap{
    width: 118px;
    height: 86px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.02);
    flex: none;
  }

  .rowThumbWrap.isEmpty{
    opacity: .25;
  }

  .rowThumb{
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(.98) contrast(1.02);
    transition: filter var(--ease);
  }

  /* v3 row hover polish: subtle glow + thumb brighten */
  .row:hover{
    box-shadow: 0 0 0 1px rgba(255,220,80,.10), var(--shadow-soft);
  }
  .row:hover .rowThumb{
    filter: brightness(1.06) contrast(1.03);
  }

  @media (max-width: 560px){
    .rowThumbWrap{ width: 104px; height: 76px; border-radius: 12px; }
    .row{ padding: 12px 12px; gap: 12px; }
    .rowTitle{ font-size: 16px; }
  }

  /* Links */
  .topicLinks{
    margin-top: 18px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* ----------------------------
     Sidebar (typography polish + widget feel)
     ---------------------------- */
  .moduleCard{
    padding: 16px 16px;
  }

  .moduleTitle{
    font-weight: 950;
    font-size: 16px; /* slightly larger */
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0 0 8px 0;
  }

  .moduleSubtext{
    opacity: .80;
    font-size: 13.5px;
    line-height: 1.35; /* tighter */
    margin-bottom: 12px;
  }

  .moduleFineprint{
    opacity: .62;
    font-size: 12px;
    line-height: 1.25;
    margin-top: 10px;
  }

  .newsletterCard{
    padding: 18px 16px 16px; /* slightly taller/airier */
  }

  .newsletterForm{
    display: grid;
    gap: 10px;
    margin-top: 10px;
  }

  .newsletterInput{
    width: 100%;
    padding: 12px 12px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(0,0,0,.25);
    color: inherit;
    outline: none;
  }

  .newsletterInput:focus{
    border-color: rgba(255,220,80,.35);
    box-shadow: 0 0 0 3px rgba(255,220,80,.10);
  }

  .newsletterButton{
    width: 100%;
    padding: 12px 12px;
    border-radius: 12px;
    border: 1px solid rgba(255,220,80,.35);
    background: rgba(255,220,80,.14);
    color: rgba(255,220,80,.98);
    font-weight: 900;
    letter-spacing: .02em;
    cursor: pointer;
    transition: transform var(--ease), filter var(--ease), background var(--ease), border-color var(--ease);
  }

  .newsletterButton:hover{
    filter: brightness(1.06);
    border-color: rgba(255,220,80,.45);
  }

  .eventsCard{
    padding: 16px 16px;
  }

  .eventsList{
    margin-top: 10px;
    display: grid;
    gap: 10px;
  }

  .eventRow{
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 12px;
    align-items: center;
  }

  .eventDate{
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.03);
    padding: 8px 8px;
    text-align: center;
    line-height: 1.05;
  }

  .eventDay{
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .10em;
    opacity: .78;
  }

  .eventNum{
    margin-top: 4px;
    font-size: 16px;
    font-weight: 950;
  }

  .eventName{
    font-weight: 900;
    font-size: 13.8px;
    line-height: 1.2;
    margin-bottom: 4px;
  }

  .eventPlace{
    opacity: .72;
    font-size: 12.5px;
    line-height: 1.2;
  }

  .eventDivider{
    height: 1px;
    background: rgba(255,255,255,.08);
    border-radius: 999px;
    margin: 2px 0;
  }
</style>
