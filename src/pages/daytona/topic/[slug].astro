---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";

/** Daytona filter */
function isDaytonaPost(post) {
  const city = String(post?.data?.city ?? "daytona").toLowerCase().trim();
  if (city === "daytona") return true;
  return typeof post?.id === "string" && post.id.startsWith("daytona/");
}

/** Featured flag */
function isFeatured(post) {
  const v = post?.data?.featured;
  if (v === true) return true;
  if (v === 1) return true;
  const s = String(v ?? "").toLowerCase().trim();
  return s === "true" || s === "yes" || s === "1";
}

/** Tag normalization */
function tagKey(raw) {
  return String(raw ?? "")
    .toLowerCase()
    .trim()
    .replace(/[-_]+/g, " ")
    .replace(/\s+/g, " ");
}

function tagSlugFromKey(key) {
  return String(key ?? "")
    .toLowerCase()
    .trim()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
}

function tagLabelFromKey(key) {
  const s = String(key ?? "").trim().replace(/\s+/g, " ");
  if (!s) return "";
  return s
    .split(" ")
    .filter(Boolean)
    .map((w) => (w ? w.charAt(0).toUpperCase() + w.slice(1) : ""))
    .join(" ");
}

/** Dates */
function getPostDate(post) {
  return (
    post?.data?.pubDate ??
    post?.data?.date ??
    post?.data?.published ??
    post?.data?.updated ??
    null
  );
}

function sortNewestFirst(a, b) {
  const da = new Date(getPostDate(a) ?? 0).getTime();
  const db = new Date(getPostDate(b) ?? 0).getTime();
  return db - da;
}

/** Topic membership */
function postHasTopic(post, topicKey) {
  const tags = Array.isArray(post?.data?.tags) ? post.data.tags : [];
  const keys = tags.map(tagKey).filter(Boolean);
  return keys.includes(topicKey);
}

/** Optional hero image field */
function heroImage(post) {
  return post?.data?.heroImage ?? "";
}

function dateText(post) {
  const d = getPostDate(post);
  if (!d) return "";
  try {
    return new Date(d).toLocaleDateString("en-US", {
      month: "long",
      day: "2-digit",
      year: "numeric",
    });
  } catch {
    return "";
  }
}

function excerpt(post) {
  return post?.data?.description ?? "";
}

/**
 * getStaticPaths: build all topic pages from unique tag keys
 * (uses ONLY locally defined helpers)
 */
export async function getStaticPaths() {
  const all = await getCollection("posts");
  const daytona = all.filter(isDaytonaPost);

  const set = new Set();
  for (const p of daytona) {
    const tags = Array.isArray(p?.data?.tags) ? p.data.tags : [];
    for (const t of tags) {
      const k = tagKey(t);
      if (k) set.add(k);
    }
  }

  return Array.from(set).map((key) => ({
    params: { slug: tagSlugFromKey(key) },
    props: { topicKey: key },
  }));
}

/** Page data */
const { topicKey } = Astro.props;
const topicLabel = tagLabelFromKey(topicKey);

const all = await getCollection("posts");
const posts = all
  .filter(isDaytonaPost)
  .filter((p) => postHasTopic(p, topicKey))
  .sort(sortNewestFirst);

/**
 * Decision #2 (hero selection):
 * - first featured post
 * - else newest
 * - do not duplicate hero in list
 */
const hero = posts.find(isFeatured) ?? posts[0] ?? null;
const rest = hero ? posts.filter((p) => p.slug !== hero.slug) : posts;
---

<Base title={`${topicLabel} | GoDo Daytona`} subtitle={`${topicLabel}`} cityBase="daytona" />

<section class="section">
  <div class="topicWrap">
    <!-- Decision #1: NO "TOPIC" kicker -->
    <header class="topicTop">
      <h1 class="topicH1">{topicLabel}</h1>
      <div class="topicCount">{posts.length} post{posts.length === 1 ? "" : "s"}</div>
    </header>

    <div class="layout">
      <!-- MAIN -->
      <main class="main">
        {hero && (
          <a class="heroRow" href={`/daytona/posts/${hero.slug}/`}>
            <div class="heroMedia">
              {heroImage(hero) ? (
                <img
                  src={heroImage(hero)}
                  alt={hero.data.title ?? "Hero image"}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="heroPlaceholder" aria-hidden="true"></div>
              )}
            </div>

            <div class="heroText">
              <div class="heroKicker">{isFeatured(hero) ? "Featured" : "Top story"}</div>
              <div class="heroTitle">{hero.data.title ?? hero.slug}</div>
              {excerpt(hero) && <div class="heroDesc">{excerpt(hero)}</div>}
              <div class="heroMeta">{dateText(hero)}</div>
            </div>
          </a>
        )}

        <div class="feed">
          {rest.map((p) => (
            <a class="feedItem" href={`/daytona/posts/${p.slug}/`}>
              <div class="thumb">
                {heroImage(p) ? (
                  <img
                    src={heroImage(p)}
                    alt={p.data.title ?? "Thumbnail"}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="thumbPlaceholder" aria-hidden="true"></div>
                )}
              </div>

              <div class="feedText">
                <div class="feedTitle">{p.data.title ?? p.slug}</div>
                {excerpt(p) && <div class="feedDesc">{excerpt(p)}</div>}
                <div class="feedMeta">{dateText(p)}</div>
              </div>
            </a>
          ))}
        </div>

        <div class="bottomLinks">
          <a class="pill" href="/daytona/topics/">← All topics</a>
          <a class="pill" href="/daytona/posts/">Latest posts</a>
        </div>
      </main>

      <!-- SIDEBAR (visual match to NOOGAtoday; functionality optional) -->
      <aside class="side">
        <div class="sideCard subscribe">
          <div class="sideTitle">Good news for Daytona</div>
          <div class="sideSub">Get the best local posts and events sent to your inbox, for free.</div>

          <form class="subForm" onsubmit="return false;">
            <input class="subInput" type="email" placeholder="Enter your email address" />
            <button class="subBtn" type="submit">SIGN UP — IT’S FREE!</button>
          </form>

          <div class="sideFine">100% free. Unsubscribe anytime.</div>
        </div>

        <div class="sideCard events">
          <div class="eventsHeader">Upcoming Events</div>

          <!-- Placeholder list (swap to real data later) -->
          <div class="eventRow">
            <div class="eventDate">
              <div class="d1">SAT</div>
              <div class="d2">15</div>
            </div>
            <div class="eventInfo">
              <div class="eventTitle">Add your first event</div>
              <div class="eventMeta">Daytona Beach</div>
            </div>
          </div>

          <div class="eventRow">
            <div class="eventDate">
              <div class="d1">SUN</div>
              <div class="d2">16</div>
            </div>
            <div class="eventInfo">
              <div class="eventTitle">Second event placeholder</div>
              <div class="eventMeta">Ormond Beach</div>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  /* Page width like NOOGAtoday */
  .topicWrap{
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 18px;
  }

  .topicTop{
    text-align: center;
    margin: 12px 0 22px;
  }
  .topicH1{
    margin: 0;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .topicCount{
    margin-top: 10px;
    opacity: .7;
    font-weight: 700;
  }

  .layout{
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 22px;
    align-items: start;
  }

  /* Hero row */
  .heroRow{
    display: grid;
    grid-template-columns: 360px minmax(0, 1fr);
    gap: 16px;
    text-decoration: none;
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.03);
    border-radius: 14px;
    overflow: hidden;
  }
  .heroMedia{
    background: rgba(255,255,255,.02);
    min-height: 210px;
  }
  .heroMedia img{
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    aspect-ratio: 16/9;
  }
  .heroPlaceholder{
    width: 100%;
    height: 100%;
    min-height: 210px;
    background: rgba(255,255,255,.04);
  }
  .heroText{
    padding: 14px 16px 14px 0;
    align-self: center;
  }
  .heroKicker{
    font-weight: 900;
    font-size: 12px;
    letter-spacing: .08em;
    text-transform: uppercase;
    opacity: .8;
    margin-bottom: 8px;
  }
  .heroTitle{
    font-weight: 900;
    font-size: 28px;
    line-height: 1.12;
  }
  .heroDesc{
    margin-top: 10px;
    opacity: .85;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .heroMeta{
    margin-top: 10px;
    opacity: .65;
    font-size: 13px;
  }

  /* Feed list like NOOGAtoday (thumb left, text right) */
  .feed{
    margin-top: 18px;
    display: grid;
    gap: 14px;
  }
  .feedItem{
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    text-decoration: none;
    border-top: 1px solid rgba(255,255,255,.10);
    padding-top: 14px;
  }
  .feedItem:first-child{
    border-top: none;
    padding-top: 0;
  }

  .thumb{
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.02);
  }
  .thumb img{
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    aspect-ratio: 16/9;
  }
  .thumbPlaceholder{
    width: 100%;
    aspect-ratio: 16/9;
    background: rgba(255,255,255,.04);
  }

  .feedTitle{
    font-weight: 900;
    font-size: 20px;
    line-height: 1.18;
  }
  .feedDesc{
    margin-top: 8px;
    opacity: .84;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .feedMeta{
    margin-top: 10px;
    opacity: .65;
    font-size: 13px;
  }

  .bottomLinks{
    margin-top: 22px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* Sidebar cards */
  .side{
    position: sticky;
    top: 14px;
    display: grid;
    gap: 14px;
  }
  .sideCard{
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.03);
    padding: 14px;
  }

  .subscribe{
    background: linear-gradient(180deg, rgba(60,160,60,.25), rgba(60,160,60,.10));
    border-color: rgba(120,255,120,.20);
  }
  .sideTitle{
    font-weight: 900;
    font-size: 20px;
    line-height: 1.15;
  }
  .sideSub{
    margin-top: 8px;
    opacity: .9;
    line-height: 1.4;
  }
  .subForm{
    margin-top: 12px;
    display: grid;
    gap: 10px;
  }
  .subInput{
    width: 100%;
    padding: 11px 12px;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,.14);
    background: rgba(0,0,0,.20);
    color: inherit;
  }
  .subBtn{
    padding: 11px 12px;
    border-radius: 10px;
    border: 1px solid rgba(0,0,0,.25);
    background: rgba(0,0,0,.55);
    color: #fff;
    font-weight: 900;
    letter-spacing: .02em;
    cursor: pointer;
  }
  .sideFine{
    margin-top: 10px;
    opacity: .75;
    font-size: 12px;
  }

  .eventsHeader{
    font-weight: 900;
    font-size: 16px;
    margin-bottom: 10px;
  }
  .eventRow{
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr);
    gap: 10px;
    padding: 10px 0;
    border-top: 1px solid rgba(255,255,255,.10);
  }
  .eventRow:first-of-type{ border-top: none; padding-top: 0; }
  .eventDate{
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.03);
    text-align: center;
    padding: 6px 0;
  }
  .d1{ font-size: 11px; font-weight: 900; opacity: .8; }
  .d2{ font-size: 16px; font-weight: 900; }
  .eventTitle{ font-weight: 900; line-height: 1.2; }
  .eventMeta{ margin-top: 4px; opacity: .75; font-size: 12px; }

  /* Responsive */
  @media (max-width: 980px){
    .layout{ grid-template-columns: 1fr; }
    .side{ position: static; }
  }
  @media (max-width: 760px){
    .heroRow{ grid-template-columns: 1fr; }
    .heroText{ padding: 14px; }
    .feedItem{ grid-template-columns: 1fr; }
    .thumb{ max-width: 100%; }
  }
</style>
