---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";

/** Daytona filter */
function isDaytonaPost(post) {
  const city = String(post?.data?.city ?? "daytona").toLowerCase().trim();
  if (city === "daytona") return true;
  return typeof post?.id === "string" && post.id.startsWith("daytona/");
}

/** Featured flag */
function isFeatured(post) {
  const v = post?.data?.featured;
  if (v === true) return true;
  if (v === 1) return true;
  const s = String(v ?? "").toLowerCase().trim();
  return s === "true" || s === "yes" || s === "1";
}

/** Tag normalization */
function tagKey(raw) {
  return String(raw ?? "")
    .toLowerCase()
    .trim()
    .replace(/[-_]+/g, " ")
    .replace(/\s+/g, " ");
}

function tagSlugFromKey(key) {
  return String(key ?? "")
    .toLowerCase()
    .trim()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
}

function tagLabelFromKey(key) {
  const s = String(key ?? "").trim().replace(/\s+/g, " ");
  if (!s) return "";
  return s
    .split(" ")
    .filter(Boolean)
    .map((w) => (w ? w.charAt(0).toUpperCase() + w.slice(1) : ""))
    .join(" ");
}

/** Dates */
function getPostDate(post) {
  return (
    post?.data?.pubDate ??
    post?.data?.date ??
    post?.data?.published ??
    post?.data?.updated ??
    null
  );
}

function sortNewestFirst(a, b) {
  const da = new Date(getPostDate(a) ?? 0).getTime();
  const db = new Date(getPostDate(b) ?? 0).getTime();
  return db - da;
}

/** Topic membership */
function postHasTopic(post, topicKey) {
  const tags = Array.isArray(post?.data?.tags) ? post.data.tags : [];
  const keys = tags.map(tagKey).filter(Boolean);
  return keys.includes(topicKey);
}

/** Optional hero image field */
function heroImage(post) {
  return post?.data?.heroImage ?? "";
}

function dateText(post) {
  const d = getPostDate(post);
  return d ? new Date(d).toLocaleDateString("en-US") : "";
}

function excerpt(post) {
  return post?.data?.description ?? "";
}

/**
 * getStaticPaths: build all topic pages from unique tag keys
 * (uses ONLY locally defined helpers)
 */
export async function getStaticPaths() {
  const all = await getCollection("posts");
  const daytona = all.filter(isDaytonaPost);

  const set = new Set();
  for (const p of daytona) {
    const tags = Array.isArray(p?.data?.tags) ? p.data.tags : [];
    for (const t of tags) {
      const k = tagKey(t);
      if (k) set.add(k);
    }
  }

  return Array.from(set).map((key) => ({
    params: { slug: tagSlugFromKey(key) },
    props: { topicKey: key },
  }));
}

/** Page data */
const { topicKey } = Astro.props;
const topicLabel = tagLabelFromKey(topicKey);

const all = await getCollection("posts");
const posts = all
  .filter(isDaytonaPost)
  .filter((p) => postHasTopic(p, topicKey))
  .sort(sortNewestFirst);

/**
 * Decision #2 (hero selection):
 * - first featured post
 * - else newest
 * - do not duplicate hero in list
 */
const hero = posts.find(isFeatured) ?? posts[0] ?? null;
const rest = hero ? posts.filter((p) => p.slug !== hero.slug) : posts;
---

<Base title={`${topicLabel} | GoDo Daytona`} subtitle={`${topicLabel}`} cityBase="daytona" />

<section class="section">
  <div class="container topicShell">
    <div class="topicMain">
      <!-- Decision #1: NO "TOPIC" kicker, only the big topic name -->
      <div class="topicHeader">
        <h1 class="topicTitle">{topicLabel}</h1>
        <div class="topicMeta">{posts.length} post{posts.length === 1 ? "" : "s"}</div>
      </div>

      {hero && (
        <a class="heroCard card" href={`/daytona/posts/${hero.slug}/`}>
          {heroImage(hero) && (
            <div class="heroMedia">
              <img
                class="heroImg"
                src={heroImage(hero)}
                alt={hero.data.title ?? "Hero image"}
                loading="lazy"
                decoding="async"
              />
            </div>
          )}

          <div class="heroBody">
            <div class="heroKicker">Featured</div>
            <div class="heroTitle">{hero.data.title}</div>
            {excerpt(hero) && <div class="heroDesc">{excerpt(hero)}</div>}
            <div class="heroMeta">{dateText(hero)}</div>
          </div>
        </a>
      )}

      <div class="list">
        {rest.map((p) => (
          <a class="row card" href={`/daytona/posts/${p.slug}/`}>
            {heroImage(p) ? (
              <img
                class="rowThumb"
                src={heroImage(p)}
                alt={p.data.title ?? "Thumbnail"}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="rowThumb rowThumbPlaceholder" aria-hidden="true"></div>
            )}

            <div class="rowText">
              <div class="rowTitle">{p.data.title ?? p.slug}</div>
              {excerpt(p) && <div class="rowDesc">{excerpt(p)}</div>}
              <div class="rowMeta">{dateText(p)}</div>
            </div>
          </a>
        ))}
      </div>

      <p class="topicNav">
        <a class="pill" href="/daytona/topics/">← All topics</a>
        <a class="pill" href="/daytona/posts/">Latest posts</a>
      </p>
    </div>

    {/* Sidebar: standardized wrapper + module classes (no hunting class names) */}
    <aside class="topicSidebar">
      <div class="moduleCard newsletterCard card">
        <div class="moduleHeader">
          <div class="moduleTitle">Good news for Daytona</div>
          <div class="moduleSub">Get the best local posts and events sent to your inbox, for free.</div>
        </div>

        <div class="newsletterForm">
          <label class="srOnly" for="topicNewsletterEmail">Email address</label>
          <input id="topicNewsletterEmail" class="newsletterInput" type="email" placeholder="Enter your email address" />
          <button class="newsletterButton" type="button">SIGN UP — IT’S FREE!</button>
          <div class="newsletterFine">100% free. Unsubscribe anytime.</div>
        </div>
      </div>

      <div class="moduleCard eventsCard card">
        <div class="moduleHeader">
          <div class="moduleTitle">Upcoming Events</div>
        </div>

        <div class="eventsList" role="list">
          <div class="eventRow" role="listitem">
            <div class="eventDate">
              <div class="eventDow">SAT</div>
              <div class="eventDay">15</div>
            </div>
            <div class="eventText">
              <div class="eventName">Add your first event</div>
              <div class="eventMeta">Daytona Beach</div>
            </div>
          </div>

          <div class="eventRow" role="listitem">
            <div class="eventDate">
              <div class="eventDow">SUN</div>
              <div class="eventDay">16</div>
            </div>
            <div class="eventText">
              <div class="eventName">Second event placeholder</div>
              <div class="eventMeta">Ormond Beach</div>
            </div>
          </div>
        </div>

        <div class="moduleFooter">
          <a class="moduleLink" href="/daytona/events/">View all events →</a>
        </div>
      </div>
    </aside>
  </div>
</section>

<style>
  /* =========================
     Premium card system (v2)
     ========================= */
  :global(:root) {
    --card-radius: 18px;
    --card-border: rgba(255,255,255,.10);
    --card-border-soft: rgba(255,255,255,.08);
    --card-bg: rgba(255,255,255,.035);
    --card-bg-hover: rgba(255,255,255,.05);
    --card-shadow: 0 10px 30px rgba(0,0,0,.20);
    --card-shadow-hover: 0 16px 42px rgba(0,0,0,.28);
    --card-pad: 16px;
    --card-pad-lg: 18px;
    --ease: 160ms ease;

    --text-strong: rgba(255,255,255,.96);
    --text: rgba(255,255,255,.88);
    --text-soft: rgba(255,255,255,.70);
    --text-faint: rgba(255,255,255,.58);
  }

  /* Shell layout */
  .topicShell {
    max-width: 1120px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
  }
  @media (min-width: 980px) {
    .topicShell {
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 22px;
      align-items: start;
    }
    .topicSidebar {
      position: sticky;
      top: 18px;
      align-self: start;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
  }
  @media (max-width: 979px) {
    .topicSidebar {
      display: grid;
      gap: 12px;
      margin-top: 16px;
    }
  }

  /* Shared card behavior */
  .card {
    border-radius: var(--card-radius);
    border: 1px solid var(--card-border-soft);
    background: var(--card-bg);
    box-shadow: 0 0 0 1px rgba(0,0,0,.10) inset;
    transition: transform var(--ease), background var(--ease), border-color var(--ease), box-shadow var(--ease);
    will-change: transform;
  }
  .card:hover {
    transform: translateY(-2px);
    background: var(--card-bg-hover);
    border-color: var(--card-border);
    box-shadow: var(--card-shadow-hover);
  }

  /* Header */
  .topicHeader {
    margin-bottom: 18px; /* more air before hero */
  }
  .topicTitle {
    margin: 10px 0 6px 0;
    font-size: clamp(40px, 5.2vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--text-strong);
  }
  .topicMeta {
    opacity: .72;
    font-size: 13px;
    letter-spacing: .02em;
    color: var(--text-soft);
  }

  /* =========================
     Hero (magazine-like)
     ========================= */
  .heroCard {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 0;
    overflow: hidden;
    text-decoration: none;
    cursor: pointer;
    margin: 0 0 18px; /* more air before list */
  }
  .heroMedia {
    position: relative;
    background: rgba(255,255,255,.02);
  }
  .heroImg {
    width: 100%;
    height: 100%;
    display: block;
    /* Taller than 16:9 */
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transform: scale(1.01);
  }
  .heroBody {
    padding: 18px 18px 16px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100%;
  }
  .heroKicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: rgba(255,220,80,.90);
    margin-bottom: 10px;
  }
  .heroTitle {
    font-weight: 950;
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--text-strong);
  }
  .heroDesc {
    margin-top: 10px;
    color: var(--text);
    opacity: .9;
    line-height: 1.52;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .heroMeta {
    margin-top: 12px;
    font-size: 12.5px;
    color: var(--text-faint);
  }

  @media (max-width: 860px) {
    .heroCard {
      grid-template-columns: 1fr;
    }
    .heroBody {
      padding: 16px 16px 14px;
    }
    .heroImg {
      aspect-ratio: 16 / 10; /* still a touch taller than 16:9 on mobile */
    }
  }

  /* =========================
     List rows (NOOGAtoday-ish)
     ========================= */
  .list {
    display: grid;
    gap: 12px; /* slightly more separation */
    margin-top: 2px;
  }

  .row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    align-items: center;
    text-decoration: none;
    padding: var(--card-pad-lg);
    cursor: pointer;
  }

  .rowThumb {
    width: 128px;
    height: 88px;
    border-radius: 14px;
    object-fit: cover;
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.03);
    flex: 0 0 auto;
  }
  .rowThumbPlaceholder {
    background: rgba(255,255,255,.02);
  }

  .rowText {
    min-width: 0;
  }

  .rowTitle {
    font-weight: 900;
    font-size: 17px;       /* slightly larger */
    line-height: 1.18;     /* tighter */
    letter-spacing: -0.01em;
    color: var(--text-strong);
  }

  .rowDesc {
    margin-top: 7px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--text);
    opacity: .86;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rowMeta {
    margin-top: 9px;
    font-size: 12.5px;
    color: var(--text-faint);
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: 108px 1fr;
      gap: 12px;
      padding: 14px;
    }
    .rowThumb {
      width: 108px;
      height: 76px;
      border-radius: 12px;
    }
    .rowTitle { font-size: 16px; }
  }

  /* =========================
     Sidebar modules (balanced)
     ========================= */
  .moduleCard {
    padding: 18px;
  }

  .moduleHeader {
    margin-bottom: 12px;
  }
  .moduleTitle {
    font-weight: 950;
    font-size: 16px;
    letter-spacing: -0.01em;
    color: var(--text-strong);
  }
  .moduleSub {
    margin-top: 8px;
    color: var(--text);
    opacity: .82;
    line-height: 1.45;
    font-size: 13.5px;
  }

  /* Newsletter */
  .newsletterCard {
    min-height: 260px; /* helps balance with hero presence */
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .newsletterForm {
    display: grid;
    gap: 10px;
    margin-top: 10px;
  }
  .newsletterInput {
    width: 100%;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.03);
    padding: 12px 12px;
    color: rgba(255,255,255,.92);
    outline: none;
  }
  .newsletterInput:focus {
    border-color: rgba(255,220,80,.35);
    box-shadow: 0 0 0 3px rgba(255,220,80,.12);
  }
  .newsletterButton {
    border-radius: 12px;
    border: 1px solid rgba(255,220,80,.55);
    background: rgba(255,220,80,.14);
    color: rgba(255,220,80,.95);
    font-weight: 950;
    letter-spacing: .02em;
    padding: 12px 12px;
    cursor: pointer;
    transition: transform var(--ease), filter var(--ease), background var(--ease), border-color var(--ease);
  }
  .newsletterButton:hover {
    transform: translateY(-1px);
    filter: brightness(1.03);
    background: rgba(255,220,80,.18);
    border-color: rgba(255,220,80,.65);
  }
  .newsletterFine {
    margin-top: 2px;
    font-size: 12px;
    color: var(--text-faint);
  }

  /* Events widget */
  .eventsCard .moduleHeader {
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255,255,255,.08); /* subtle divider module feel */
    margin-bottom: 12px;
  }
  .eventsList {
    display: grid;
    gap: 12px;
    margin-top: 4px;
  }
  .eventRow {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 12px;
    align-items: center;
    padding: 10px 10px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.08);
    background: rgba(255,255,255,.02);
  }
  .eventDate {
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(0,0,0,.18);
    padding: 8px 6px;
    text-align: center;
    line-height: 1.05;
  }
  .eventDow {
    font-size: 10px;
    font-weight: 950;
    letter-spacing: .12em;
    opacity: .8;
  }
  .eventDay {
    margin-top: 5px;
    font-size: 16px;
    font-weight: 950;
    color: var(--text-strong);
  }
  .eventName {
    font-weight: 900;
    font-size: 14px;
    line-height: 1.22;
    color: var(--text-strong);
  }
  .eventMeta {
    margin-top: 6px;
    font-size: 12.5px;
    color: var(--text-faint);
  }
  .moduleFooter {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid rgba(255,255,255,.08);
  }
  .moduleLink {
    text-decoration: none;
    font-weight: 900;
    color: rgba(255,220,80,.92);
  }
  .moduleLink:hover { filter: brightness(1.05); }

  /* Nav pills area */
  .topicNav {
    margin-top: 18px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* Accessibility helper */
  .srOnly {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }
</style>
