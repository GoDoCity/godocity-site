---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";

/** Daytona filter */
function isDaytonaPost(post) {
  const city = String(post?.data?.city ?? "daytona").toLowerCase().trim();
  if (city === "daytona") return true;
  return typeof post?.id === "string" && post.id.startsWith("daytona/");
}

/** Featured flag */
function isFeatured(post) {
  const v = post?.data?.featured;
  if (v === true) return true;
  if (v === 1) return true;
  const s = String(v ?? "").toLowerCase().trim();
  return s === "true" || s === "yes" || s === "1";
}

/** Tag normalization */
function tagKey(raw) {
  return String(raw ?? "")
    .toLowerCase()
    .trim()
    .replace(/[-_]+/g, " ")
    .replace(/\s+/g, " ");
}

function tagSlugFromKey(key) {
  return String(key ?? "")
    .toLowerCase()
    .trim()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
}

function tagLabelFromKey(key) {
  const s = String(key ?? "").trim().replace(/\s+/g, " ");
  if (!s) return "";
  return s
    .split(" ")
    .filter(Boolean)
    .map((w) => (w ? w.charAt(0).toUpperCase() + w.slice(1) : ""))
    .join(" ");
}

/** Dates */
function getPostDate(post) {
  return (
    post?.data?.pubDate ??
    post?.data?.date ??
    post?.data?.published ??
    post?.data?.updated ??
    null
  );
}

function sortNewestFirst(a, b) {
  const da = new Date(getPostDate(a) ?? 0).getTime();
  const db = new Date(getPostDate(b) ?? 0).getTime();
  return db - da;
}

/** Topic membership */
function postHasTopic(post, topicKey) {
  const tags = Array.isArray(post?.data?.tags) ? post.data.tags : [];
  const keys = tags.map(tagKey).filter(Boolean);
  return keys.includes(topicKey);
}

/** Optional hero image field */
function heroImage(post) {
  return post?.data?.heroImage ?? "";
}

function dateText(post) {
  const d = getPostDate(post);
  return d ? new Date(d).toLocaleDateString("en-US") : "";
}

function excerpt(post) {
  return post?.data?.description ?? "";
}

/**
 * getStaticPaths: MUST be build-safe in Cloudflare.
 * Make it fully self-contained: no references to helper functions outside this scope.
 * Behavior stays identical.
 */
export async function getStaticPaths() {
  const all = await getCollection("posts");

  // inline Daytona filter (same logic)
  const daytona = all.filter((post) => {
    const city = String(post?.data?.city ?? "daytona").toLowerCase().trim();
    if (city === "daytona") return true;
    return typeof post?.id === "string" && post.id.startsWith("daytona/");
  });

  // inline tag normalizer (same logic as tagKey)
  const keyOf = (raw) =>
    String(raw ?? "")
      .toLowerCase()
      .trim()
      .replace(/[-_]+/g, " ")
      .replace(/\s+/g, " ");

  // inline slugify (same logic as tagSlugFromKey)
  const slugOf = (key) =>
    String(key ?? "")
      .toLowerCase()
      .trim()
      .replace(/&/g, "and")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/(^-|-$)/g, "");

  const set = new Set();
  for (const p of daytona) {
    const tags = Array.isArray(p?.data?.tags) ? p.data.tags : [];
    for (const t of tags) {
      const k = keyOf(t);
      if (k) set.add(k);
    }
  }

  return Array.from(set).map((key) => ({
    params: { slug: slugOf(key) },
    props: { topicKey: key },
  }));
}

/** Page data */
const { topicKey } = Astro.props;
const topicLabel = tagLabelFromKey(topicKey);

const all = await getCollection("posts");
const posts = all
  .filter(isDaytonaPost)
  .filter((p) => postHasTopic(p, topicKey))
  .sort(sortNewestFirst);

/**
 * Decision #2 (hero selection):
 * - first featured post
 * - else newest
 * - do not duplicate hero in list
 */
const hero = posts.find(isFeatured) ?? posts[0] ?? null;
const rest = hero ? posts.filter((p) => p.slug !== hero.slug) : posts;
---

<Base title={`${topicLabel} | GoDo Daytona`} subtitle={`${topicLabel}`} cityBase="daytona" />

<section class="section">
  <div class="container topicLayout" style="max-width: 1100px;">
    <div class="topicMain">
      <div class="topicHeader">
        <h1 class="topicTitle">{topicLabel}</h1>
        <div class="topicMeta">{posts.length} post{posts.length === 1 ? "" : "s"}</div>
      </div>

      {hero && (
        <a class="heroCard moduleCard" href={`/daytona/posts/${hero.slug}/`}>
          {heroImage(hero) && (
            <img
              class="heroImg"
              src={heroImage(hero)}
              alt={hero.data.title ?? "Hero image"}
              loading="lazy"
              decoding="async"
            />
          )}

          <div class="heroBody">
            <div class="heroTitle">{hero.data.title}</div>
            {excerpt(hero) && <div class="heroDesc">{excerpt(hero)}</div>}
            <div class="heroMeta">{dateText(hero)}</div>
          </div>
        </a>
      )}

      <div class="list">
        {rest.map((p) => (
          <a class="row moduleCard" href={`/daytona/posts/${p.slug}/`}>
            {heroImage(p) && (
              <img
                class="rowThumb"
                src={heroImage(p)}
                alt={p.data.title ?? "Thumbnail"}
                loading="lazy"
                decoding="async"
              />
            )}

            <div class="rowText">
              <div class="rowTitle">{p.data.title ?? p.slug}</div>
              {excerpt(p) && <div class="rowDesc">{excerpt(p)}</div>}
              <div class="rowMeta">{dateText(p)}</div>
            </div>
          </a>
        ))}
      </div>

      <p style="margin-top:18px;display:flex;gap:10px;flex-wrap:wrap;">
        <a class="pill" href="/daytona/topics/">← All topics</a>
        <a class="pill" href="/daytona/posts/">Latest posts</a>
      </p>
    </div>

    <aside class="topicSidebar" aria-label="Sidebar">
      <div class="moduleCard newsletterCard">
        <div class="moduleTitle">Good news for Daytona</div>
        <div class="moduleSub">
          Get the best local posts and events sent to your inbox, for free.
        </div>

        <label class="srOnly" for="newsletterEmail">Email address</label>
        <input id="newsletterEmail" class="moduleInput" type="email" placeholder="Enter your email address" />

        <button class="moduleButton" type="button">SIGN UP — IT’S FREE!</button>
        <div class="moduleFine">100% free. Unsubscribe anytime.</div>
      </div>

      <div class="moduleCard eventsCard">
        <div class="moduleTitle">Upcoming Events</div>

        <div class="eventRow">
          <div class="eventDate">
            <div class="eventDow">SAT</div>
            <div class="eventDay">15</div>
          </div>
          <div class="eventInfo">
            <div class="eventName">Add your first event</div>
            <div class="eventPlace">Daytona Beach</div>
          </div>
        </div>

        <div class="eventRow">
          <div class="eventDate">
            <div class="eventDow">SUN</div>
            <div class="eventDay">16</div>
          </div>
          <div class="eventInfo">
            <div class="eventName">Second event placeholder</div>
            <div class="eventPlace">Ormond Beach</div>
          </div>
        </div>
      </div>
    </aside>
  </div>
</section>

<style>
  :root {
    --card-radius: 16px;
    --card-border: rgba(255,255,255,.10);
    --card-border-hover: rgba(255,255,255,.16);
    --card-bg: rgba(255,255,255,.035);
    --card-bg-hover: rgba(255,255,255,.05);
    --card-shadow-hover: 0 14px 34px rgba(0,0,0,.34);

    --title-color: rgba(255,255,255,.96);
    --text-color: rgba(255,255,255,.88);
    --meta-color: rgba(255,255,255,.62);

    --space-3: 16px;
    --space-4: 22px;
    --space-5: 28px;

    --ease: 160ms ease;
  }

  .topicLayout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 22px;
    align-items: start;
  }
  .topicMain { min-width: 0; }
  .topicSidebar { display: flex; flex-direction: column; gap: 14px; }

  @media (max-width: 980px) {
    .topicLayout { grid-template-columns: 1fr; }
    .topicSidebar { margin-top: 18px; }
  }

  .topicHeader { margin: 8px 0 var(--space-4); }
  .topicTitle {
    margin: 10px 0 6px;
    font-size: clamp(36px, 4.6vw, 56px);
    line-height: 1.02;
    font-weight: 950;
    letter-spacing: -0.02em;
    color: var(--title-color);
  }
  .topicMeta {
    margin-top: 2px;
    font-size: 12px;
    letter-spacing: .02em;
    color: var(--meta-color);
  }

  .moduleCard {
    border-radius: var(--card-radius);
    border: 1px solid var(--card-border);
    background: var(--card-bg);
    transition: transform var(--ease), background var(--ease), border-color var(--ease), box-shadow var(--ease);
  }
  .moduleCard:hover {
    transform: translateY(-2px);
    border-color: var(--card-border-hover);
    background: var(--card-bg-hover);
    box-shadow: var(--card-shadow-hover);
  }

  .heroCard {
    display: block;
    text-decoration: none;
    overflow: hidden;
    cursor: pointer;
    margin: 0 0 var(--space-5);
  }
  .heroImg {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: rgba(255,255,255,.02);
  }
  .heroBody { padding: 18px 18px 16px; }
  .heroTitle {
    font-weight: 950;
    font-size: 24px;
    line-height: 1.14;
    letter-spacing: -0.01em;
    color: var(--title-color);
  }
  .heroDesc {
    margin-top: 10px;
    color: var(--text-color);
    line-height: 1.45;
    opacity: .88;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .heroMeta {
    margin-top: 12px;
    font-size: 12px;
    letter-spacing: .02em;
    color: var(--meta-color);
  }

  .list {
    display: grid;
    gap: 12px;
    margin-top: var(--space-3);
  }

  .row {
    display: grid;
    grid-template-columns: 148px 1fr;
    gap: 16px;
    align-items: center;
    text-decoration: none;
    cursor: pointer;
    padding: 16px 16px;
  }

  .rowThumb {
    width: 148px;
    height: 104px;
    border-radius: 14px;
    object-fit: cover;
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.02);
  }

  .rowText { min-width: 0; }

  .rowTitle {
    font-weight: 950;
    font-size: 18px;
    line-height: 1.16;
    letter-spacing: -0.01em;
    color: var(--title-color);
  }

  .rowDesc {
    margin-top: 7px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--text-color);
    opacity: .86;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rowMeta {
    margin-top: 10px;
    font-size: 12px;
    letter-spacing: .02em;
    color: var(--meta-color);
  }

  @media (max-width: 640px) {
    .row { grid-template-columns: 1fr; }
    .rowThumb { width: 100%; height: auto; aspect-ratio: 16/9; }
  }

  .newsletterCard,
  .eventsCard { padding: 20px; }

  .moduleTitle {
    margin: 0 0 10px 0;
    font-size: 13px;
    letter-spacing: .06em;
    text-transform: uppercase;
    font-weight: 900;
    color: rgba(255,255,255,.86);
  }
  .moduleSub {
    margin-top: 2px;
    color: rgba(255,255,255,.82);
    line-height: 1.45;
  }
  .moduleInput {
    width: 100%;
    margin-top: 12px;
    padding: 12px 12px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(0,0,0,.20);
    color: rgba(255,255,255,.92);
    outline: none;
  }
  .moduleButton {
    width: 100%;
    margin-top: 12px;
    padding: 12px 12px;
    border-radius: 12px;
    font-weight: 950;
    letter-spacing: .02em;
    cursor: pointer;
  }
  .moduleFine {
    margin-top: 10px;
    font-size: 12px;
    color: rgba(255,255,255,.62);
  }

  .eventsCard { position: relative; }
  .eventsCard::before {
    content: "";
    position: absolute;
    top: -10px;
    left: 14px;
    right: 14px;
    height: 1px;
    background: rgba(255,255,255,.08);
  }

  .eventRow {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 12px;
    align-items: center;
    padding: 12px 0;
    border-top: 1px solid rgba(255,255,255,.08);
  }
  .eventRow:first-of-type { border-top: 0; padding-top: 6px; }

  .eventDate {
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.03);
    border-radius: 12px;
    padding: 10px 0;
    text-align: center;
    line-height: 1.05;
  }
  .eventDow {
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .06em;
    opacity: .75;
  }
  .eventDay {
    margin-top: 4px;
    font-size: 18px;
    font-weight: 950;
    color: rgba(255,255,255,.92);
  }

  .eventName {
    font-weight: 900;
    font-size: 14px;
    line-height: 1.2;
    color: rgba(255,255,255,.92);
  }
  .eventPlace {
    margin-top: 6px;
    font-size: 12px;
    color: rgba(255,255,255,.62);
  }

  .srOnly {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }
</style>
