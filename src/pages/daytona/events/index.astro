<script is:inline>
(function () {
  /* ── Pagination + filter ── */
  var PAGE_SIZE = 20;
  var shown     = PAGE_SIZE;
  var filter    = "all";

  function init() {
    var grid      = document.getElementById("eventGrid");
    var filterSel = document.getElementById("monthFilter");
    var countEl   = document.getElementById("filterCount");
    var moreBtn   = document.getElementById("loadMoreBtn");
    var moreCount = document.getElementById("loadMoreCount");

    if (grid) {
      var allCards = Array.prototype.slice.call(grid.querySelectorAll(".evCard"));

      function visibleCards() {
        return allCards.filter(function (c) {
          return filter === "all" || c.getAttribute("data-month") === filter;
        });
      }

      function applyState() {
        var visible   = visibleCards();
        var total     = visible.length;
        allCards.forEach(function (c) { c.classList.add("evCard--hidden"); });
        visible.slice(0, shown).forEach(function (c) { c.classList.remove("evCard--hidden"); });
        if (countEl) countEl.textContent = total + " event" + (total !== 1 ? "s" : "");
        if (moreBtn) {
          var remaining = total - shown;
          if (remaining > 0) {
            moreBtn.style.display = "";
            if (moreCount) moreCount.textContent = "(" + remaining + " more)";
          } else {
            moreBtn.style.display = "none";
          }
        }
      }

      if (filterSel) {
        filterSel.addEventListener("change", function () {
          filter = filterSel.value; shown = PAGE_SIZE; applyState();
        });
      }
      if (moreBtn) {
        moreBtn.addEventListener("click", function () { shown += PAGE_SIZE; applyState(); });
      }
      applyState();
    }
  } // end init()

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }

  /* ── Social action buttons ── */
  document.querySelectorAll(".laBtn--cal").forEach(function (btn) {
    btn.addEventListener("click", function (e) {
      e.stopPropagation();
      var title    = btn.getAttribute("data-title") || "Event";
      var dateIso  = btn.getAttribute("data-date") || "";
      var location = btn.getAttribute("data-location") || "";
      if (!dateIso) return;
      var start = dateIso.replace(/[-:]/g, "").replace(/\.\d{3}/, "").replace("Z", "Z");
      var d     = new Date(dateIso);
      var end   = new Date(d.getTime() + 2 * 60 * 60 * 1000)
        .toISOString().replace(/[-:]/g, "").replace(/\.\d{3}/, "").replace("Z", "Z");
      var gcUrl = "https://calendar.google.com/calendar/render?action=TEMPLATE"
        + "&text=" + encodeURIComponent(title)
        + "&dates=" + start + "/" + end
        + "&location=" + encodeURIComponent(location)
        + "&details=" + encodeURIComponent("Via GoDoDaytona — " + window.location.href);
      window.open(gcUrl, "_blank", "noopener,noreferrer");
    });
  });

  document.querySelectorAll(".laBtn--share").forEach(function (btn) {
    btn.addEventListener("click", function (e) {
      e.stopPropagation();
      var url   = btn.getAttribute("data-url") || window.location.href;
      var title = btn.getAttribute("data-title") || "Check this out on GoDoDaytona";
      var absUrl = url.startsWith("http") ? url : window.location.origin + url;
      if (navigator.share) {
        navigator.share({ title: title, url: absUrl }).catch(function () {});
      } else {
        navigator.clipboard.writeText(absUrl).then(function () {
          var orig = btn.getAttribute("title");
          btn.setAttribute("title", "Copied!");
          btn.classList.add("laBtn--copied");
          setTimeout(function () {
            btn.setAttribute("title", orig || "Share");
            btn.classList.remove("laBtn--copied");
          }, 1800);
        });
      }
    });
  });

  /* ── Link validator: catch dead external URLs → Google Search fallback ── */
  document.querySelectorAll("[data-external='true']").forEach(function (el) {
    var fallback = el.getAttribute("data-fallback");
    if (!fallback) return;
    el.addEventListener("click", function () {
      var ctrl = typeof AbortController !== "undefined" ? new AbortController() : null;
      var timer = ctrl ? setTimeout(function () { ctrl.abort(); }, 5000) : null;
      var opts = { mode: "no-cors" };
      if (ctrl) opts.signal = ctrl.signal;
      fetch(el.href, opts)
        .then(function () { if (timer) clearTimeout(timer); })
        .catch(function () {
          if (timer) clearTimeout(timer);
          window.open(fallback, "_blank", "noopener,noreferrer");
        });
    });
  });
})();
</script>

