---
import Base from "../../../layouts/Base.astro";
import InteractiveMap from "../../../components/InteractiveMap.astro";
import { getCollection } from "astro:content";
import manualFeedData from "../../../data/manual-events.json";
import {
  getAllSheetEvents,
  GREATER_DAYTONA,
  CITY_DISPLAY,
  cityDisplayName,
  isStrictlyFuture,
  HARD_CUTOFF,
} from "../../../lib/events.js";

/* ── City centres for distance label (events page only) ──────────────── */
const CITY_CENTERS = {
  "daytona":              { lat: 29.2108, lng: -81.0228 },
  "daytona beach":        { lat: 29.2108, lng: -81.0228 },
  "ormond beach":         { lat: 29.2866, lng: -81.0559 },
  "ormond":               { lat: 29.2866, lng: -81.0559 },
  "port orange":          { lat: 29.1380, lng: -81.0045 },
  "daytona beach shores": { lat: 29.1994, lng: -80.9969 },
  "south daytona":        { lat: 29.1680, lng: -81.0027 },
  "holly hill":           { lat: 29.2497, lng: -81.0370 },
  "new smyrna beach":     { lat: 29.0258, lng: -80.9270 },
  "new smyrna":           { lat: 29.0258, lng: -80.9270 },
  "flagler beach":        { lat: 29.4730, lng: -81.1267 },
  "flagler":              { lat: 29.4730, lng: -81.1267 },
};

/* ── Haversine distance from Daytona Beach center ── */
const CENTER_LAT = 29.2108;
const CENTER_LNG = -81.0228;
function distanceMiles(lat, lng) {
  const R = 3958.8;
  const dLat = (lat - CENTER_LAT) * Math.PI / 180;
  const dLng = (lng - CENTER_LNG) * Math.PI / 180;
  const a = Math.sin(dLat / 2) ** 2 +
    Math.cos(CENTER_LAT * Math.PI / 180) * Math.cos(lat * Math.PI / 180) *
    Math.sin(dLng / 2) ** 2;
  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
}
function distLabel(lat, lng) {
  if (lat == null || lng == null) return null;
  const d = distanceMiles(lat, lng);
  return d < 0.1 ? "< 0.1 mi" : `${d.toFixed(1)} mi`;
}

function addUtm(url) {
  if (!url) return url;
  try {
    const u = new URL(url);
    u.searchParams.set("utm_source", "gododaytona");
    return u.toString();
  } catch {
    return url + (url.includes("?") ? "&" : "?") + "utm_source=gododaytona";
  }
}

let allEvents = [];
try { allEvents = await getCollection("events"); } catch { allEvents = []; }
console.log(`[CLEANUP] Markdown directory is empty: ${allEvents.length === 0}`);

/* ── Sheet events — normalised, deduped, date-filtered by events.js ─────────
   getAllSheetEvents() uses the module-level singleton, so importFromSheet()
   runs only ONCE per build regardless of how many pages import this module.   */
let sheetEvents: any[] = [];
try { sheetEvents = await getAllSheetEvents(); } catch { sheetEvents = []; }
const scrapedCount = 0; // scraper permanently disabled

/* ── Manual Quick-Entry feed (src/data/manual-events.json) ──────────────────
   Paste event objects here as a fallback when scrapers are blocked.
   Manual entries are processed first and win over scraped data on dedup.   */
const manualEvents = ((manualFeedData as any).quickEntry ?? [])
  .filter((e: any) => e.title && e.eventDate && !e._note)
  .map((e: any) => ({
    slug: `${String(e.city ?? "daytona").replace(/\s+/g, "-")}/manual-${String(e.title ?? "").toLowerCase().replace(/[^a-z0-9]+/g, "-").slice(0, 40)}`,
    data: {
      title:     e.title,
      eventDate: e.eventDate,
      endDate:   e.endDate   ?? null,
      location:  e.location  ?? "",
      city:      e.city      ?? "daytona beach",
      url:       e.url       ?? null,
      image:     e.image     ?? null,
      category:  e.category  ?? null,
      lat:       e.lat       ?? null,
      lng:       e.lng       ?? null,
      sponsored: e.sponsored ?? false,
    },
  }));

/* ── Sort key: date string → lexicographic (NaN-safe) ── */
function sortKey(e: any): string {
  return String(e.data?.eventDate ?? "").split("T")[0] || "9999-99-99";
}

/* Merge: markdown → manual → sheet (coord overrides already applied in events.js) */
const allEventsWithLive = [...allEvents, ...manualEvents, ...sheetEvents];

/* ── Filter: Greater Daytona area + strictly after HARD_CUTOFF ── */
const upcomingEvents = allEventsWithLive
  .filter(e => {
    const evCity = (e.data.city ?? e.slug.split("/")[0]).toLowerCase().trim();
    if (!GREATER_DAYTONA.has(evCity)) return false;
    // For multi-day events, keep if endDate is still in the future
    const dateStr    = String(e.data.eventDate ?? "").split("T")[0];
    const endDateStr = e.data.endDate ? String(e.data.endDate).split("T")[0] : null;
    return dateStr > HARD_CUTOFF || (endDateStr !== null && endDateStr > HARD_CUTOFF);
  })
  .sort((a, b) => sortKey(a) < sortKey(b) ? -1 : sortKey(a) > sortKey(b) ? 1 : 0);

console.log(
  `[events] Markdown: ${allEvents.length} | Manual: ${manualEvents.length} | ` +
  `Sheet: ${sheetEvents.length} | Scraped: ${scrapedCount} | Total upcoming: ${upcomingEvents.length}`
);

// Warn about events with no usable coordinates (will be excluded from map)
upcomingEvents
  .filter(e => e.data.lat == null || e.data.lng == null || (e.data.lat === 0 && e.data.lng === 0))
  .forEach(e => console.warn(
    `[events] missing coords: "${e.data.title}" (${e.data.eventDate}) — add lat/lng to pin on map`
  ));

/* Featured slider: top 5 sponsored events — auto-cycles every 5 seconds.
   Sponsored events are NEVER placed in the regular feed — text from a
   sponsored card must never bleed into a non-sponsored event row. */
const allSponsored    = upcomingEvents.filter(e => e.data.sponsored === true);
const sponsoredEvents = allSponsored.slice(0, 5);
const regularEvents   = upcomingEvents.filter(e => !e.data.sponsored);

/* ── Map pins — Hide & Seek filter ───────────────────────────────────────────
   We only plot a pin when we're confident in the coordinates:
     • Markdown / manual events (no `source` field) — author-provided, trusted
     • Scraped events with coordSource "hardlock"    — SCRAPER_COORD_OVERRIDES
     • Scraped events with coordSource "known_venue" — KNOWN_VENUES table
   Scraped events where coordSource is "schema" are excluded — those coords
   come from the venue's own JSON-LD and often resolve to city-centre or
   river-adjacent defaults, producing noisy river/parking-lot pins.
   ─────────────────────────────────────────────────────────────────────────── */
const mapPins = upcomingEvents
  .filter(e => {
    if (e.data.lat == null || e.data.lng == null) return false;
    if (e.data.lat === 0 && e.data.lng === 0)     return false;
    // Scraped (legacy) events require verified coords; sheet + discovered events are trusted
    const isEventbriteSource = e.data.source === "eventbrite-sheet" || e.data.source === "eventbrite-discovered";
    if (e.data.source && !isEventbriteSource) {
      return e.data.coordSource === "hardlock" || e.data.coordSource === "known_venue";
    }
    return true; // markdown / manual / sheet / discovered: trust API-sourced or COORD_OVERRIDES coords
  })
  .map(e => {
    const d = new Date(e.data.eventDate);
    const dateStr = d.toLocaleDateString("en-US", { month: "short", day: "numeric" });
    return {
      label:   e.data.title,
      address: `${dateStr} · ${e.data.location}`,
      lat:     e.data.lat,
      lng:     e.data.lng,
      image:   e.data.image ?? "/images/daytona-placeholder.jpg",
      url:     e.data.url ?? null,
    };
  });

/* Log every pin so water-pin origins are visible in Cloudflare build logs */
mapPins.forEach(p =>
  console.log(`[MAP PIN] "${p.label}" → ${p.lat}, ${p.lng}`)
);

/* ── Month filter options ── */
const monthKeys = [...new Set(
  upcomingEvents.map(e => {
    const d = new Date(e.data.eventDate);
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`;
  })
)];
const monthOptions = monthKeys.map(k => {
  const [y, m] = k.split("-");
  const label = new Date(+y, +m - 1, 1).toLocaleDateString("en-US", { month: "long", year: "numeric" });
  return { key: k, label };
});

const PAGE_SIZE = 20;

/* ── Unsplash category fallback images ── */
const CATEGORY_IMG: Record<string, string> = {
  "Music & Nightlife":    "https://images.unsplash.com/photo-1514320291840-2e0a9bf2a9ae?w=800&q=75",
  "Food & Drink":         "https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=800&q=75",
  "Arts & Culture":       "https://images.unsplash.com/photo-1578321272176-b7bbc0679853?w=800&q=75",
  "Markets & Fairs":      "https://images.unsplash.com/photo-1488459716781-0a04a8a37e6e?w=800&q=75",
  "Racing & Motorsports": "https://images.unsplash.com/photo-1461896836934-ffe607ba8211?w=800&q=75",
  "Outdoors & Sports":    "https://images.unsplash.com/photo-1530549387789-4c161668b269?w=800&q=75",
};
const FALLBACK_IMG = "https://images.unsplash.com/photo-1492684223066-81342ee5ff30?w=800&q=75";
---

<Base
  title="Events — Greater Daytona Beach Area"
  subtitle="GoDoDaytona — local events worth knowing about."
  cityBase="daytona"
>
  <section class="section">
    <div class="eventsContainer">

      {/* ── NEWSLETTER — full-bleed slim band, edge-to-edge, no curves ── */}
      <form name="newsletter-signup" data-netlify="true" netlify-honeypot="nl-bot" style="display:none" aria-hidden="true">
        <input name="form-name" value="newsletter-signup" /><input name="nl-bot" /><input name="email" />
      </form>
      <div class="nlWrap">
        <div class="nlCard">
          <div class="nlContent" id="nlContent">
            <div class="nlHead"><em>Good News <span class="nlCity">Daytona</span>!</em></div>
            <div class="nlSub">Get the best local events sent to your inbox, <strong>for free.</strong></div>
            <form class="nlForm" id="nlForm" novalidate>
              <input type="hidden" name="form-name" value="newsletter-signup" />
              <p style="display:none" aria-hidden="true"><label>Leave empty: <input name="nl-bot" id="nlBot" /></label></p>
              <div class="nlRow">
                <input class="nlInput" id="nlEmail" name="email" type="email"
                  placeholder="Enter your email address" autocomplete="email" required />
                <button class="nlBtn" id="nlBtn" type="submit">SIGN UP, IT'S FREE!</button>
              </div>
            </form>
          </div>
          <div class="nlThanks" id="nlThanks" aria-live="polite" style="display:none">
            Thank you! You're on the list. ✓
          </div>
        </div>
      </div>

      {/* ── FEATURED GRID — 3-column static row, horizontal scroll if >3 ── */}
      {sponsoredEvents.length > 0 && (
        <div class="container">
          <div class="featuredSection">
            <div class="featuredHeadRow">
              <span class="featuredSectionTitle">Featured Events</span>
              <div class="featuredActions">
                <a class="featuredActionBtn" href="/daytona/advertise/">Advertise With Us</a>
                <a class="featuredActionBtn featuredActionBtn--add" href="/submit-event/">+ Add Event</a>
              </div>
            </div>
            <div class="featuredGrid">
              {sponsoredEvents.map((e, idx) => {
                const d      = new Date(e.data.eventDate);
                const mon    = isNaN(d) ? "???" : d.toLocaleDateString("en-US", { month: "short" }).toUpperCase();
                const day    = isNaN(d) ? "??" : d.getDate();
                const evCity = (e.data.city ?? e.slug.split("/")[0]).toLowerCase().trim();
                const evSlug = e.slug.split("/").pop();
                const href   = e.data.url ? addUtm(e.data.url) : `/${e.data.city ?? evCity}/events/${evSlug}/`;
                const isExt  = !!e.data.url;
                const fbUrl  = `https://www.google.com/search?q=${encodeURIComponent(e.data.title + " Daytona")}`;
                return (
                  <a class="featuredCard"
                     href={href}
                     target={isExt ? "_blank" : "_self"}
                     rel={isExt ? "noopener noreferrer" : ""}
                     data-external={isExt ? "true" : undefined}
                     data-fallback={isExt ? fbUrl : undefined}>
                    <div class="fcImgWrap">
                      <img class="fcImg"
                        src={e.data.image || CATEGORY_IMG[e.data.category ?? ""] || FALLBACK_IMG}
                        alt={e.data.title} loading={idx === 0 ? "eager" : "lazy"} />
                      <span class="fcSponsorBadge">SPONSORED</span>
                      <div class="fcImgOverlay" aria-hidden="true"></div>
                      <div class="fcOverlayCopy">
                        <div class="fcDate">{mon} {day}</div>
                        <div class="fcTitle">{e.data.title}</div>
                        <div class="fcCity">{cityDisplayName(evCity)}</div>
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        </div>
      )}

      <div class="container">

        {/* ── MAP ── */}
        {mapPins.length > 0 && (
          <div class="mapBlock">
            <InteractiveMap locations={mapPins} height="300px" center={[29.2108, -81.0228]} />
          </div>
        )}

        {/* ── FILTER BAR ── */}
        <div class="filterBar">
          <label class="filterLabel" for="monthFilter">Filter:</label>
          <select class="filterSelect" id="monthFilter">
            <option value="all">All upcoming</option>
            {monthOptions.map(o => (
              <option value={o.key}>{o.label}</option>
            ))}
          </select>
          <span class="filterCount" id="filterCount">
            {regularEvents.length} event{regularEvents.length !== 1 ? "s" : ""}
          </span>
        </div>

        {/* ── Scraper fallback notice — shown when live fetch returned nothing ── */}
        {scrapedCount === 0 && (
          <div class="scrapeNotice">
            Local events are loading — check back in 5 minutes.
          </div>
        )}

        {/* ── EVENT FEED — slim horizontal rows, 125×82px thumbnails ── */}
        {regularEvents.length === 0 ? (
          <p class="noEvents">No upcoming events — <a href="/submit-event/">submit one</a>.</p>
        ) : (
          <>
            <div class="eventFeed" id="eventGrid">
              {regularEvents.map((e, idx) => {
                const d        = new Date(e.data.eventDate);
                const mon      = isNaN(d) ? "???" : d.toLocaleDateString("en-US", { month: "short" }).toUpperCase();
                const day      = isNaN(d) ? "??" : d.getDate();
                const dow      = isNaN(d) ? "???" : d.toLocaleDateString("en-US", { weekday: "short" }).toUpperCase();
                const monthKey = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`;
                const evCity   = (e.data.city ?? e.slug.split("/")[0]).toLowerCase().trim();
                const evSlug   = e.slug.split("/").pop();
                const href     = e.data.url ? addUtm(e.data.url) : `/${e.data.city ?? evCity}/events/${evSlug}/`;
                const isExt    = !!e.data.url;
                const hidden   = idx >= PAGE_SIZE;
                const evLat    = e.data.lat ?? CITY_CENTERS[evCity]?.lat;
                const evLng    = e.data.lng ?? CITY_CENTERS[evCity]?.lng;
                const dist     = distLabel(evLat, evLng);
                const fbUrl    = `https://www.google.com/search?q=${encodeURIComponent(e.data.title + " " + cityDisplayName(evCity))}`;
                return (
                  <a
                    class={`evCard${hidden ? " evCard--hidden" : ""}`}
                    href={href}
                    target={isExt ? "_blank" : "_self"}
                    rel={isExt ? "noopener noreferrer" : ""}
                    data-month={monthKey}
                    data-idx={String(idx)}
                    data-external={isExt ? "true" : undefined}
                    data-fallback={isExt ? fbUrl : undefined}
                  >
                    {/* 100×65 thumbnail */}
                    <div class="evCardImg">
                      <img
                        src={e.data.image || CATEGORY_IMG[e.data.category ?? ""] || FALLBACK_IMG}
                        alt={e.data.title} loading="lazy" decoding="async" />
                    </div>

                    {/* Date column — sits between thumb and text */}
                    <div class="evCardDate" aria-label={`${mon} ${day}`}>
                      <span class="evCardMon">{mon}</span>
                      <span class="evCardDay">{day}</span>
                    </div>

                    {/* Title + venue + meta */}
                    <div class="evCardBody">
                      <div class="evCardTitle">
                        {e.data.title}
                        {isExt && <span class="evCardExt" aria-label="External link">↗</span>}
                      </div>
                      {e.data.location && (
                        <div class="evCardVenue">{e.data.location}</div>
                      )}
                      <div class="evCardMeta">
                        <span class="evCardCity">{cityDisplayName(evCity)}</span>
                        {dist && <span class="evCardDist">{dist}</span>}
                        {/* Badge only for explicitly sponsored events — no auto-tags */}
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>

            {regularEvents.length > PAGE_SIZE && (
              <div class="loadMoreRow">
                <button class="loadMoreBtn" id="loadMoreBtn" type="button">
                  Load more events
                  <span class="loadMoreCount" id="loadMoreCount">
                    ({Math.min(PAGE_SIZE, regularEvents.length - PAGE_SIZE)} more)
                  </span>
                </button>
              </div>
            )}
          </>
        )}

        {/* ── SUGGEST AN EVENT CTA ── */}
        <div class="suggestRow">
          <p class="suggestText">Know about an event we're missing?</p>
          <a class="suggestBtn" href="/submit-event/">Suggest an Event →</a>
        </div>

        </div>{/* /.container (map + feed) */}

      {/* ── OWN THE CITY CTA ── */}
      <div class="container ctaOuter">
        <div class="ctaBox">
          <h2 class="ctaHeadline">Own the City.</h2>
          <p class="ctaBody">
            GoDoDaytona is built by locals, for locals. If you're a business owner or event
            organizer, we want to help you grow. Submit your event for free, or ask about our
            Sponsored Featured spots to stay at the top of the list all week long.
          </p>
          <a class="ctaBtn" href="/daytona/advertise/">Get Featured</a>
        </div>
      </div>

    </div>{/* /.eventsContainer */}
  </section>
</Base>

<script is:inline>
(function () {
  /* ── Pagination + filter ── */
  var PAGE_SIZE = 20;
  var shown     = PAGE_SIZE;
  var filter    = "all";

  var grid      = document.getElementById("eventGrid");
  var filterSel = document.getElementById("monthFilter");
  var countEl   = document.getElementById("filterCount");
  var moreBtn   = document.getElementById("loadMoreBtn");
  var moreCount = document.getElementById("loadMoreCount");

  if (grid) {
    var allCards = Array.prototype.slice.call(grid.querySelectorAll(".evCard"));

    function visibleCards() {
      return allCards.filter(function (c) {
        return filter === "all" || c.getAttribute("data-month") === filter;
      });
    }

    function applyState() {
      var visible = visibleCards();
      var total   = visible.length;
      allCards.forEach(function (c) { c.classList.add("evCard--hidden"); });
      visible.slice(0, shown).forEach(function (c) { c.classList.remove("evCard--hidden"); });
      if (countEl) countEl.textContent = total + " event" + (total !== 1 ? "s" : "");
      if (moreBtn) {
        var remaining = total - shown;
        if (remaining > 0) {
          moreBtn.style.display = "";
          if (moreCount) moreCount.textContent = "(" + Math.min(PAGE_SIZE, remaining) + " more)";
        } else {
          moreBtn.style.display = "none";
        }
      }
    }

    if (filterSel) {
      filterSel.addEventListener("change", function () {
        filter = filterSel.value; shown = PAGE_SIZE; applyState();
      });
    }
    if (moreBtn) {
      moreBtn.addEventListener("click", function () { shown += PAGE_SIZE; applyState(); });
    }
    applyState();
  }

  /* ── Newsletter signup ── */
  var nlForm    = document.getElementById("nlForm");
  var nlBtn     = document.getElementById("nlBtn");
  var nlEmail   = document.getElementById("nlEmail");
  var nlContent = document.getElementById("nlContent");
  var nlThanks  = document.getElementById("nlThanks");

  if (nlForm) {
    nlForm.addEventListener("submit", function (e) {
      e.preventDefault();

      var email = (nlEmail ? nlEmail.value : "").trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        if (nlEmail) nlEmail.focus();
        return;
      }

      nlBtn.disabled    = true;
      nlBtn.textContent = "SIGNING UP…";

      var botVal = document.getElementById("nlBot") ? document.getElementById("nlBot").value : "";
      var body   = "form-name=newsletter-signup&email=" + encodeURIComponent(email);
      if (botVal) body += "&nl-bot=" + encodeURIComponent(botVal);

      fetch("/", {
        method:  "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body:    body,
      })
        .then(function (res) {
          if (res.ok || res.status === 303) {
            if (nlContent) nlContent.style.display = "none";
            if (nlThanks)  nlThanks.style.display  = "";
          } else {
            throw new Error(res.status);
          }
        })
        .catch(function () {
          nlBtn.disabled    = false;
          nlBtn.textContent = "SIGN UP, IT'S FREE!";
        });
    });
  }

  /* ── Link validator: catch dead external URLs → Google Search fallback ── */
  document.querySelectorAll("[data-external='true']").forEach(function (el) {
    var fallback = el.getAttribute("data-fallback");
    if (!fallback) return;
    el.addEventListener("click", function () {
      var ctrl = typeof AbortController !== "undefined" ? new AbortController() : null;
      var timer = ctrl ? setTimeout(function () { ctrl.abort(); }, 5000) : null;
      var opts = { mode: "no-cors" };
      if (ctrl) opts.signal = ctrl.signal;
      fetch(el.href, opts)
        .then(function () { if (timer) clearTimeout(timer); })
        .catch(function () {
          if (timer) clearTimeout(timer);
          window.open(fallback, "_blank", "noopener,noreferrer");
        });
    });
  });
})();
</script>

<style>
  /* overflow-x:clip prevents the 100vw negative-margin from creating a scrollbar
     without creating a new block-formatting context (unlike overflow:hidden) */
  .eventsContainer { padding-bottom: 64px; overflow-x: clip; }

  /* ── Newsletter — full-bleed slim band, strict 180px, no curves ── */
  .nlWrap {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-bottom: 28px;
  }
  .nlCard {
    background: linear-gradient(135deg, var(--brand1), var(--brand2));
    /* No border-radius — hard edge to edge */
    height: 180px;
    max-height: 180px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 1.5rem;
  }
  .nlContent {
    max-width: 520px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 6px;
  }
  .nlHead {
    font-size: clamp(26px, 3.2vw, 38px);
    font-weight: 900;
    font-style: italic;
    color: var(--accentText);
    line-height: 1.0;
    letter-spacing: -0.04em;
    margin: 0;
  }
  .nlCity { font-style: italic; font-weight: 900; }
  .nlSub {
    font-size: 16px;
    font-weight: 400;
    color: var(--accentText);
    opacity: .85;
    line-height: 1.3;
    margin: 0;
  }
  .nlSub strong { font-weight: 900; opacity: 1; }
