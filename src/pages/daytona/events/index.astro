---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";
import manualFeedData from "../../../data/manual-events.json";
import {
  getAllSheetEvents,
  GREATER_DAYTONA,
  CITY_DISPLAY,
  cityDisplayName,
  isStrictlyFuture,
  HARD_CUTOFF,
} from "../../../lib/events.js";
import { getCityConfig } from "../../../lib/cityConfigs.js";
const daytonaConfig = getCityConfig("daytona");

/* ── City centres for distance label (events page only) ──────────────── */
const CITY_CENTERS = {
  "daytona":              { lat: 29.2108, lng: -81.0228 },
  "daytona beach":        { lat: 29.2108, lng: -81.0228 },
  "ormond beach":         { lat: 29.2866, lng: -81.0559 },
  "ormond":               { lat: 29.2866, lng: -81.0559 },
  "port orange":          { lat: 29.1380, lng: -81.0045 },
  "daytona beach shores": { lat: 29.1994, lng: -80.9969 },
  "south daytona":        { lat: 29.1680, lng: -81.0027 },
  "holly hill":           { lat: 29.2497, lng: -81.0370 },
  "new smyrna beach":     { lat: 29.0258, lng: -80.9270 },
  "new smyrna":           { lat: 29.0258, lng: -80.9270 },
  "flagler beach":        { lat: 29.4730, lng: -81.1267 },
  "flagler":              { lat: 29.4730, lng: -81.1267 },
};

/* ── Haversine distance from Daytona Beach center ── */
const CENTER_LAT = 29.2108;
const CENTER_LNG = -81.0228;
function distanceMiles(lat, lng) {
  const R = 3958.8;
  const dLat = (lat - CENTER_LAT) * Math.PI / 180;
  const dLng = (lng - CENTER_LNG) * Math.PI / 180;
  const a = Math.sin(dLat / 2) ** 2 +
    Math.cos(CENTER_LAT * Math.PI / 180) * Math.cos(lat * Math.PI / 180) *
    Math.sin(dLng / 2) ** 2;
  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
}
function distLabel(lat, lng) {
  if (lat == null || lng == null) return null;
  const d = distanceMiles(lat, lng);
  return d < 0.1 ? "< 0.1 mi" : `${d.toFixed(1)} mi`;
}

function addUtm(url) {
  if (!url) return url;
  try {
    const u = new URL(url);
    u.searchParams.set("utm_source", "gododaytona");
    return u.toString();
  } catch {
    return url + (url.includes("?") ? "&" : "?") + "utm_source=gododaytona";
  }
}

let allEvents = [];
try { allEvents = await getCollection("events"); } catch { allEvents = []; }
console.log(`[CLEANUP] Markdown directory is empty: ${allEvents.length === 0}`);

/* ── Sheet events — normalised, deduped, date-filtered by events.js ─────────
   getAllSheetEvents() uses the module-level singleton, so importFromSheet()
   runs only ONCE per build regardless of how many pages import this module.   */
let sheetEvents: any[] = [];
try { sheetEvents = await getAllSheetEvents(); } catch { sheetEvents = []; }
const scrapedCount = 0; // scraper permanently disabled

/* ── Manual Quick-Entry feed (src/data/manual-events.json) ──────────────────
   Paste event objects here as a fallback when scrapers are blocked.
   Manual entries are processed first and win over scraped data on dedup.   */
const manualEvents = ((manualFeedData as any).quickEntry ?? [])
  .filter((e: any) => e.title && e.eventDate && !e._note)
  .map((e: any) => ({
    slug: `${String(e.city ?? "daytona").replace(/\s+/g, "-")}/manual-${String(e.title ?? "").toLowerCase().replace(/[^a-z0-9]+/g, "-").slice(0, 40)}`,
    data: {
      title:     e.title,
      eventDate: e.eventDate,
      endDate:   e.endDate   ?? null,
      location:  e.location  ?? "",
      city:      e.city      ?? "daytona beach",
      url:       e.url       ?? null,
      image:     e.image     ?? null,
      category:  e.category  ?? null,
      lat:       e.lat       ?? null,
      lng:       e.lng       ?? null,
      sponsored:    e.sponsored    ?? false,
      isHighImpact: e.isHighImpact ?? false,
    },
  }));

/* ── Sort key: date string → lexicographic (NaN-safe) ── */
function sortKey(e: any): string {
  return String(e.data?.eventDate ?? "").split("T")[0] || "9999-99-99";
}

/* Merge: markdown → manual → sheet (coord overrides already applied in events.js) */
const allEventsWithLive = [...allEvents, ...manualEvents, ...sheetEvents];

/* ── Filter: Greater Daytona area + date >= yesterday, with sponsor override ── */
const upcomingEvents = allEventsWithLive
  .filter(e => {
    const evCity = (e.data.city ?? e.slug.split("/")[0]).toLowerCase().trim();
    if (!GREATER_DAYTONA.has(evCity)) return false;
    // Sponsored events always show (extra visibility window)
    if (e.data.sponsored === true) return true;
    // For multi-day events, keep if endDate is still in the future
    const dateStr    = String(e.data.eventDate ?? "").split("T")[0];
    const endDateStr = e.data.endDate ? String(e.data.endDate).split("T")[0] : null;
    return dateStr >= HARD_CUTOFF || (endDateStr !== null && endDateStr >= HARD_CUTOFF);
  })
  .sort((a, b) => sortKey(a) < sortKey(b) ? -1 : sortKey(a) > sortKey(b) ? 1 : 0);

console.log(
  `[events] Markdown: ${allEvents.length} | Manual: ${manualEvents.length} | ` +
  `Sheet: ${sheetEvents.length} | Scraped: ${scrapedCount} | Total upcoming: ${upcomingEvents.length}`
);

// Warn about events with no usable coordinates (will be excluded from map)
upcomingEvents
  .filter(e => e.data.lat == null || e.data.lng == null || (e.data.lat === 0 && e.data.lng === 0))
  .forEach(e => console.warn(
    `[events] missing coords: "${e.data.title}" (${e.data.eventDate}) — add lat/lng to pin on map`
  ));

/* Featured slider: top 5 sponsored events — auto-cycles every 5 seconds.
   Sponsored events are NEVER placed in the regular feed — text from a
   sponsored card must never bleed into a non-sponsored event row. */
const allSponsored    = upcomingEvents.filter(e => e.data.sponsored === true);
const sponsoredEvents = allSponsored.slice(0, 5);
const regularEvents   = upcomingEvents.filter(e => !e.data.sponsored);

/* ── Map pins — Hide & Seek filter ───────────────────────────────────────────
   We only plot a pin when we're confident in the coordinates:
     • Markdown / manual events (no `source` field) — author-provided, trusted
     • Scraped events with coordSource "hardlock"    — SCRAPER_COORD_OVERRIDES
     • Scraped events with coordSource "known_venue" — KNOWN_VENUES table
   Scraped events where coordSource is "schema" are excluded — those coords
   come from the venue's own JSON-LD and often resolve to city-centre or
   river-adjacent defaults, producing noisy river/parking-lot pins.
   ─────────────────────────────────────────────────────────────────────────── */
const mapPins = upcomingEvents
  .filter(e => {
    if (e.data.lat == null || e.data.lng == null) return false;
    if (e.data.lat === 0 && e.data.lng === 0)     return false;
    // Scraped (legacy) events require verified coords; sheet + discovered events are trusted
    const isEventbriteSource = e.data.source === "eventbrite-sheet" || e.data.source === "eventbrite-discovered";
    if (e.data.source && !isEventbriteSource) {
      return e.data.coordSource === "hardlock" || e.data.coordSource === "known_venue";
    }
    return true; // markdown / manual / sheet / discovered: trust API-sourced or COORD_OVERRIDES coords
  })
  .map(e => {
    const d = new Date(e.data.eventDate);
    const dateStr = d.toLocaleDateString("en-US", { month: "short", day: "numeric" });
    return {
      label:   e.data.title,
      address: `${dateStr} · ${e.data.location}`,
      lat:     e.data.lat,
      lng:     e.data.lng,
      image:   e.data.image ?? "/images/daytona-placeholder.jpg",
      url:     e.data.url ?? null,
    };
  });

/* Log every pin so water-pin origins are visible in Cloudflare build logs */
mapPins.forEach(p =>
  console.log(`[MAP PIN] "${p.label}" → ${p.lat}, ${p.lng}`)
);

/* ── Month filter options ── */
const monthKeys = [...new Set(
  upcomingEvents.map(e => {
    const d = new Date(e.data.eventDate);
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`;
  })
)];
const monthOptions = monthKeys.map(k => {
  const [y, m] = k.split("-");
  const label = new Date(+y, +m - 1, 1).toLocaleDateString("en-US", { month: "long", year: "numeric" });
  return { key: k, label };
});

const PAGE_SIZE = 20;

/* ── Unsplash category fallback images ── */
const CATEGORY_IMG: Record<string, string> = {
  "Music & Nightlife":    "https://images.unsplash.com/photo-1514320291840-2e0a9bf2a9ae?w=800&q=75",
  "Food & Drink":         "https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=800&q=75",
  "Arts & Culture":       "https://images.unsplash.com/photo-1578321272176-b7bbc0679853?w=800&q=75",
  "Markets & Fairs":      "https://images.unsplash.com/photo-1488459716781-0a04a8a37e6e?w=800&q=75",
  "Racing & Motorsports": "https://images.unsplash.com/photo-1461896836934-ffe607ba8211?w=800&q=75",
  "Outdoors & Sports":    "https://images.unsplash.com/photo-1530549387789-4c161668b269?w=800&q=75",
};
const FALLBACK_IMG = "https://images.unsplash.com/photo-1492684223066-81342ee5ff30?w=800&q=75";

function vibeTag(category?: string): { label: string; type: string } | null {
  const c = (category ?? "").toLowerCase();
  if (c.includes("music") || c.includes("nightlife")) return { label: "Live Music", type: "music" };
  if (c.includes("trivia") || c.includes("game"))     return { label: "Trivia / Games", type: "games" };
  if (c.includes("food") || c.includes("drink"))       return { label: "Food / Drink", type: "food" };
  if (c.includes("community") || c.includes("family")) return { label: "Community", type: "community" };
  if (c.includes("arts") || c.includes("culture"))     return { label: "Arts", type: "arts" };
  if (c.includes("sport") || c.includes("outdoor") || c.includes("racing")) return { label: "Sports", type: "sports" };
  if (c.includes("market") || c.includes("fair"))      return { label: "Markets", type: "community" };
  return null;
}
---

<Base
  title="Events | GoDoDaytona"
  subtitle="Curated picks, local happenings, and everything worth showing up for in Daytona Beach and Volusia County."
  cityBase="daytona"
>

  <!-- ── Sticky "Add Your Event" button ── -->
  <div class="evStickyBtn">
    <a href="/daytona/advertise/" class="evStickyLink">
      <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
        <path d="M6.5 1v11M1 6.5h11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      Add Your Event
    </a>
  </div>

  <!-- ── Concert/Nightlife Hero ── -->
  <section class="evHero">
    <div class="evHeroOverlay" aria-hidden="true"></div>
    <div class="evHeroInner">
      <p class="evHeroEyebrow">Daytona Beach · Live Events Guide</p>
      <h1 class="evHeroTitle">
        <span class="evHeroAccent">Events</span><br>
        Worth Showing Up For.
      </h1>
      <p class="evHeroSub">GoDo Picks, daily listings, and everything worth showing up for — curated by locals, for locals.</p>
      <div class="evHeroCtas">
        <a href="#lineup" class="evBtnBlue">Browse All Events ↓</a>
        <a href="/daytona/advertise/" class="evBtnGhost">Promote Your Event</a>
      </div>
    </div>
  </section>

  <!-- ── Main Hub Layout ── -->
  <div class="evHub">
    <div class="evHubLayout">

      <!-- ══════════════════════════════════════════
           MAIN COLUMN
      ══════════════════════════════════════════ -->
      <main class="evHubMain">

        <!-- ── SECTION 1: GoDo Picks (VIP Row) ── -->
        {sponsoredEvents.length > 0 && (
          <section class="evSection godoPicks" aria-label="GoDo Picks">
            <div class="evSectionHead">
              <div>
                <span class="evEyebrow">Curated by GoDoDaytona</span>
                <h2 class="evSectionTitle">GoDo Picks.</h2>
              </div>
              <a href="/daytona/advertise/" class="evSectionAction">Feature Your Event →</a>
            </div>
            <div class="godoPicksGrid">
              {sponsoredEvents.slice(0, 3).map((e, idx) => {
                const d      = new Date(e.data.eventDate);
                const mon    = isNaN(d) ? "???" : d.toLocaleDateString("en-US", { month: "short" }).toUpperCase();
                const day    = isNaN(d) ? "??" : d.getDate();
                const dow    = isNaN(d) ? "" : d.toLocaleDateString("en-US", { weekday: "long" });
                const evCity = (e.data.city ?? e.slug.split("/")[0]).toLowerCase().trim();
                const evSlug = e.slug.split("/").pop();
                const href   = e.data.url ? addUtm(e.data.url) : `/${e.data.city ?? evCity}/events/${evSlug}/`;
                const isExt  = !!e.data.url;
                const fbUrl  = `https://www.google.com/search?q=${encodeURIComponent(e.data.title + " Daytona")}`;
                const mockViews = [142, 89, 214][idx] ?? 100;
                return (
                  <a
                    class="godoPickCard"
                    href={href}
                    target={isExt ? "_blank" : "_self"}
                    rel={isExt ? "noopener noreferrer" : ""}
                    data-external={isExt ? "true" : undefined}
                    data-fallback={isExt ? fbUrl : undefined}
                  >
                    <div class="gpcImgWrap">
                      <img
                        class="gpcImg"
                        src={e.data.image || CATEGORY_IMG[e.data.category ?? ""] || FALLBACK_IMG}
                        alt={e.data.title}
                        loading={idx === 0 ? "eager" : "lazy"}
                      />
                      <div class="gpcPosterGrad" aria-hidden="true"></div>
                      <span class="gcBadge">
                        <svg width="9" height="9" viewBox="0 0 9 9" fill="none" aria-hidden="true">
                          <path d="M4.5 1l1 2.3L8 3.7l-2 1.8.6 2.5L4.5 6.8 2 8l.6-2.5-2-1.8 2.5-.4L4.5 1z" fill="currentColor"/>
                        </svg>
                        Editor's Choice
                      </span>
                      <span class="gcAnalytics" aria-label={`${mockViews} views`}>
                        <svg width="9" height="9" viewBox="0 0 9 9" fill="none" aria-hidden="true">
                          <path d="M1 7L3 4.5l1.5 1.5L6.5 3 8 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        {mockViews} views
                      </span>
                      <div class="gpcOverlay">
                        {(() => { const vt = vibeTag(e.data.category); return vt ? <span class={`vibTag vibTag--${vt.type}`}>{vt.label}</span> : null; })()}
                        <div class="gpcDateRow">
                          <span class="gpcMon">{mon}</span>
                          <span class="gpcDay">{day}</span>
                          {dow && <span class="gpcDow">{dow}</span>}
                        </div>
                        <h3 class="gpcTitle">{e.data.title}</h3>
                        {e.data.location && <p class="gpcLoc">{e.data.location}</p>}
                      </div>
                    </div>
                    {/* Mobile horizontal body — shown only at < 768px */}
                    <div class="gpcBody">
                      {(() => { const vt = vibeTag(e.data.category); return vt ? <span class={`vibTag vibTag--${vt.type}`}>{vt.label}</span> : null; })()}
                      <div class="gpcDateRow">
                        <span class="gpcMon">{mon}</span>
                        <span class="gpcDay">{day}</span>
                        {dow && <span class="gpcDow">{dow}</span>}
                      </div>
                      <h3 class="gpcTitle">{e.data.title}</h3>
                      {e.data.location && <p class="gpcLoc">{e.data.location}</p>}
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        )}

        <!-- ── SECTION 2: The Daily Lineup ── -->
        <section class="evSection lineupSection" id="lineup" aria-label="Daily Lineup">
          <div class="evSectionHead lineupHead">
            <div>
              <span class="evEyebrow">Every Event, Every Day</span>
              <h2 class="evSectionTitle">The Daily Lineup.</h2>
            </div>
            <div class="lineupFilters">
              <label class="filterLabel" for="monthFilter">Filter:</label>
              <select class="filterSelect" id="monthFilter">
                <option value="all">All upcoming</option>
                {monthOptions.map(o => (
                  <option value={o.key}>{o.label}</option>
                ))}
              </select>
              <span class="filterCount" id="filterCount">
                {regularEvents.length} event{regularEvents.length !== 1 ? "s" : ""}
              </span>
            </div>
          </div>

          {regularEvents.length === 0 ? (
            <p class="noEvents">No upcoming events — <a href="/submit-event/">submit one</a>.</p>
          ) : (
            <>
              <div class="lineupFeed" id="eventGrid">
                {regularEvents.map((e, idx) => {
                  const d        = new Date(e.data.eventDate);
                  const mon      = isNaN(d) ? "???" : d.toLocaleDateString("en-US", { month: "short" }).toUpperCase();
                  const day      = isNaN(d) ? "??" : d.getDate();
                  const timeStr  = isNaN(d) ? "" : d.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit", hour12: true });
                  const monthKey = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`;
                  const evCity   = (e.data.city ?? e.slug.split("/")[0]).toLowerCase().trim();
                  const evSlug   = e.slug.split("/").pop();
                  const href     = e.data.url ? addUtm(e.data.url) : `/${e.data.city ?? evCity}/events/${evSlug}/`;
                  const isExt    = !!e.data.url;
                  const hidden   = idx >= PAGE_SIZE;
                  const evLat    = e.data.lat ?? CITY_CENTERS[evCity]?.lat;
                  const evLng    = e.data.lng ?? CITY_CENTERS[evCity]?.lng;
                  const dist     = distLabel(evLat, evLng);
                  const fbUrl    = `https://www.google.com/search?q=${encodeURIComponent(e.data.title + " " + cityDisplayName(evCity))}`;
                  const showTime    = timeStr && !isNaN(d) && timeStr !== "12:00 AM";
                  const isHighImpact = !!e.data.isHighImpact;
                  const evImg        = e.data.image || CATEGORY_IMG[e.data.category ?? ""] || FALLBACK_IMG;
                  /* Shared social SVGs as inline helpers */
                  const calSvg = (
                    <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                      <rect x="1.5" y="3" width="12" height="10.5" rx="2" stroke="currentColor" stroke-width="1.3"/>
                      <path d="M5 1.5v3M10 1.5v3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                      <path d="M1.5 6.5h12" stroke="currentColor" stroke-width="1.3"/>
                      <path d="M7.5 9v3M6 10.5h3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                    </svg>
                  );
                  const shareSvg = (
                    <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                      <circle cx="11.5" cy="3"   r="1.8" stroke="currentColor" stroke-width="1.3"/>
                      <circle cx="11.5" cy="12"  r="1.8" stroke="currentColor" stroke-width="1.3"/>
                      <circle cx="3"    cy="7.5" r="1.8" stroke="currentColor" stroke-width="1.3"/>
                      <path d="M4.7 6.6l5 -2.7M4.7 8.4l5 2.7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                    </svg>
                  );
                  const metaBlock = (
                    <div class="lineupMeta">
                      {showTime && (
                        <span class="lineupTime">
                          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                            <circle cx="5" cy="5" r="4" stroke="currentColor" stroke-width="1.2"/>
                            <path d="M5 2.5v2.5l1.5 1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                          </svg>
                          {timeStr}
                        </span>
                      )}
                      {e.data.location && (
                        <span class="lineupLoc">
                          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                            <path d="M5 1C3.3 1 2 2.3 2 4c0 2.5 3 5.5 3 5.5S8 6.5 8 4C8 2.3 6.7 1 5 1z" stroke="currentColor" stroke-width="1.2"/>
                            <circle cx="5" cy="4" r="1" fill="currentColor"/>
                          </svg>
                          {e.data.location}
                        </span>
                      )}
                      {dist && <span class="lineupDist">{dist}</span>}
                      <span class="lineupCity">{cityDisplayName(evCity)}</span>
                    </div>
                  );
                  const actionBtns = (
                    <div class="lineupActions">
                      <button class="laBtn laBtn--cal" type="button" title="Add to Calendar"
                        data-title={e.data.title} data-date={isNaN(d) ? "" : d.toISOString()}
                        data-location={e.data.location ?? ""} aria-label="Add to Calendar">
                        {calSvg}
                      </button>
                      <button class="laBtn laBtn--share" type="button" title="Share this event"
                        data-url={href} data-title={e.data.title} aria-label="Share this event">
                        {shareSvg}
                      </button>
                    </div>
                  );
                  const ctaLink = (extraClass?: string) => (
                    <a href={href} class={`lineupCta${extraClass ? " " + extraClass : ""}`}
                      target={isExt ? "_blank" : "_self"}
                      rel={isExt ? "noopener noreferrer" : ""}
                      data-external={isExt ? "true" : undefined}
                      data-fallback={isExt ? fbUrl : undefined}>
                      {isExt ? "Get Tickets" : "More Info"}
                      <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
                        <path d="M2 5.5h7M5.5 2l3.5 3.5-3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </a>
                  );
                  return (
                    <>
                    <div
                      class={`lineupRow evCard${hidden ? " lineupRow--hidden evCard--hidden" : ""}${isHighImpact ? " lineupRow--hiImpact" : ""}`}
                      data-month={monthKey}
                      data-idx={String(idx)}
                    >
                      {isHighImpact ? (
                        /* ── High-Impact variant: full-width 16:9 card ── */
                        <>
                          <div class="hiImgWrap">
                            <img class="hiImg" src={evImg} alt={e.data.title} loading="lazy" decoding="async" />
                            <div class="hiImgGrad" aria-hidden="true"></div>
                            <span class="hiBadge">
                              <svg width="9" height="9" viewBox="0 0 9 9" fill="none" aria-hidden="true">
                                <path d="M4.5 1l1 2.3L8 3.7l-2 1.8.6 2.5L4.5 6.8 2 8l.6-2.5-2-1.8 2.5-.4L4.5 1z" fill="currentColor"/>
                              </svg>
                              High Impact
                            </span>
                            <div class="hiDateOverlay">
                              <span class="ldbMon">{mon}</span>
                              <span class="ldbDay">{day}</span>
                            </div>
                          </div>
                          <div class="hiBody">
                            <div class="hiBodyLeft">
                              {(() => { const vt = vibeTag(e.data.category); return vt ? <span class={`vibTag vibTag--${vt.type}`}>{vt.label}</span> : null; })()}
                              <h3 class="hiTitle">{e.data.title}</h3>
                              {metaBlock}
                            </div>
                            <div class="hiBodyRight">
                              {actionBtns}
