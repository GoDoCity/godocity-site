    .gpcBody .gpcMon { font-size: 8px; font-weight: 900; letter-spacing:.14em; text-transform:uppercase; color: var(--brand1,#0077be); }
    .gpcBody .gpcDay { font-size: 14px; font-weight: 900; color: #111; line-height: 1; }
    .gpcBody .gpcDow { color: #aaa; font-size: 9px; }
    .gpcBody .gpcTitle {
      font-size: 12.5px; font-weight: 800; color: #111; line-height: 1.3; margin: 2px 0 0;
      white-space: normal;
      display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
    }
    .gpcBody .gpcLoc { font-size: 10.5px; color: #888; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    /* ── Standard lineup row: fixed 110px grid ── */
    .lineupRow:not(.lineupRow--hiImpact) {
      display: grid !important;
      grid-template-columns: 110px 1fr !important;
      grid-template-rows: 1fr auto !important;
