---
import Base from "../../layouts/Base.astro";
import SidebarPoll from "../../components/SidebarPoll.astro";
---

<Base title="Vibe Check | GoDo Daytona" subtitle="Community polls for Daytona" cityBase="daytona">
  <div class="vibeWrap">

    <section class="vibe-hero">
      <div class="vibe-hero__inner">
        <span class="vibe-hero__eyebrow">COMMUNITY PULSE</span>
        <h1 class="vibe-hero__title">Vibe Check</h1>
        <p class="vibe-hero__dek">
          Vote on what Daytona is talking about. <br class="mobile-break" />
          New results every week.
        </p>
        <div class="vibe-hero__divider"></div>
      </div>
    </section>

    <div class="vibeContainer">

      {/* ── CURRENT POLL ── */}
      <section class="vibeSection" aria-label="Current poll">
        <div class="vibeSectionHead">
          <span class="vibeSectionLabel">🗳️ Current Poll</span>
        </div>
        <div class="vibePollWrap">
          <SidebarPoll
            title="Vibe Check: Best of Ormond"
            question="Who has the best tacos in Ormond?"
            options={[
              { label: "La Fiesta",         votes: 148 },
              { label: "Tortilla Republic",  votes: 122 },
              { label: "Cabo's Mexican",     votes: 134 },
              { label: "Other",              votes: 97  },
            ]}
            pollId="ormond-tacos"
          />
        </div>
      </section>

      {/* ── PAST POLLS ── */}
      <section class="vibeSection vibeSection--past" aria-label="Past polls">
        <div class="vibeSectionHead">
          <span class="vibeSectionLabel">📊 Past Results</span>
        </div>
        <div class="vibePastGrid">
          <div class="vibePastCard">
            <div class="vibePastQ">Best brunch spot in Daytona Beach?</div>
            <div class="vibePastWinner">🏆 Café on the Beach — 41% of votes</div>
            <div class="vibePastMeta">502 votes · March 2026</div>
          </div>
          <div class="vibePastCard">
            <div class="vibePastQ">Which Daytona neighbourhood is most up-and-coming?</div>
            <div class="vibePastWinner">🏆 Midtown — 38% of votes</div>
            <div class="vibePastMeta">389 votes · February 2026</div>
          </div>
          <div class="vibePastCard">
            <div class="vibePastQ">Best beach for families in the greater Daytona area?</div>
            <div class="vibePastWinner">🏆 New Smyrna Beach — 47% of votes</div>
            <div class="vibePastMeta">611 votes · January 2026</div>
          </div>
        </div>
      </section>

    </div>
  </div>
</Base>

<style>
  .vibeWrap {
    min-height: 100vh;
  }

  /* ── Hero Banner ── */
  .vibe-hero {
    background:
      radial-gradient(circle at 50% 0%, rgba(58, 77, 101, 0.4) 0%, transparent 70%),
      linear-gradient(180deg, #3A4D65 0%, #2E3E52 100%);
    padding: 58px 24px 50px;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    border-bottom: 1px solid rgba(255, 210, 74, 0.1);
  }
  .vibe-hero__inner {
    max-width: 800px;
    width: 100%;
  }
  .vibe-hero__eyebrow {
    display: block;
    font-family: 'Manrope', sans-serif;
    font-size: 21px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #FFD24A;
    margin-bottom: 16px;
  }
  .vibe-hero__title {
    font-family: 'Manrope', sans-serif;
    font-size: 64px;
    font-weight: 800;
    line-height: 1.0;
    color: #F5F7FA;
    margin: 0 auto 24px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .vibe-hero__dek {
    font-family: 'Manrope', sans-serif;
    font-size: 22px;
    font-weight: 500;
    color: rgba(232, 237, 244, 0.88);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.5;
  }
  .vibe-hero__divider {
    width: 40px;
    height: 3px;
    background: #FFD24A;
    margin: 32px auto 0;
    border-radius: 2px;
  }
  @media (max-width: 1024px) {
    .vibe-hero {
      padding: 50px 20px 44px;
    }
    .vibe-hero__title {
      font-size: 44px;
    }
  }
  @media (max-width: 768px) {
    .vibe-hero {
      padding: 44px 16px 36px;
    }
    .vibe-hero__eyebrow {
      font-size: 16px;
    }
    .vibe-hero__title {
      font-size: 38px;
    }
    .vibe-hero__dek {
      font-size: 18px;
    }
    .mobile-break {
      display: none;
    }
  }

  /* ── Main container ── */
  .vibeContainer {
    max-width: 720px;
    margin: 0 auto;
    padding: 48px 24px 80px;
    display: grid;
    gap: 56px;
  }

  /* ── Section ── */
  .vibeSection { display: grid; gap: 20px; }
  .vibeSectionHead {
    border-bottom: 2px solid var(--brand1);
    padding-bottom: 10px;
  }
  .vibeSectionLabel {
    font-size: 13px;
    font-weight: 900;
    letter-spacing: .10em;
    text-transform: uppercase;
    color: var(--text);
  }

  /* ── Current poll wrapper ── */
  .vibePollWrap {
    max-width: 480px;
  }

  /* ── Past polls grid ── */
  .vibePastGrid {
    display: grid;
    gap: 14px;
  }
  .vibePastCard {
    padding: 18px 20px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--pillBg);
    display: grid;
    gap: 6px;
  }
  .vibePastQ {
    font-weight: 800;
    font-size: 15px;
    color: var(--text);
    line-height: 1.3;
  }
  .vibePastWinner {
    font-size: 14px;
    font-weight: 700;
    color: var(--brand1);
  }
  .vibePastMeta {
    font-size: 12px;
    color: var(--faint);
  }
</style>
