---
import Base from "../../layouts/Base.astro";
import SidebarPoll from "../../components/SidebarPoll.astro";
import { getGreaterDaytonaEvents, cityDisplayName } from "../../lib/events.js";

const allEvents      = await getGreaterDaytonaEvents();
const sponsoredSlides = allEvents.filter((e: any) => e.data.sponsored === true).slice(0, 5);
const regularList     = allEvents.filter((e: any) => !e.data.sponsored).slice(0, 4);
const hasSlider  = sponsoredSlides.length > 0;
const hasList    = regularList.length > 0;
const hasEvents  = hasSlider || hasList;
---

<Base title="Vibe Check | GoDo Daytona" subtitle="Community polls for Daytona" cityBase="daytona">
  <div class="vibeWrap">

    <section class="vibe-hero">
      <div class="vibe-hero__inner">
        <span class="vibe-hero__eyebrow">COMMUNITY PULSE</span>
        <h1 class="vibe-hero__title">Vibe Check</h1>
        <p class="vibe-hero__dek">
          Vote on what Daytona is talking about. <br class="mobile-break" />
          New results every week.
        </p>
        <div class="vibe-hero__divider"></div>
      </div>
    </section>

    <!-- ── Two-column page layout ── -->
    <div class="vibePageLayout">

      <!-- ── MAIN COLUMN: Polls ── -->
      <div class="vibeMain">
        <div class="vibeContainer">

          {/* ── CURRENT POLL ── */}
          <section class="vibeSection" aria-label="Current poll">
            <div class="vibeSectionHead">
              <span class="vibeSectionLabel">🗳️ Current Poll</span>
            </div>
            <div class="vibePollWrap">
              <SidebarPoll
                title="Vibe Check: Best of Ormond"
                question="Who has the best tacos in Ormond?"
                options={[
                  { label: "La Fiesta" },
                  { label: "Tortilla Republic" },
                  { label: "Cabo's Mexican" },
                  { label: "Other" },
                ]}
                pollId="ormond-tacos"
              />
            </div>
          </section>

          {/* ── PAST POLLS ── */}
          <section class="vibeSection vibeSection--past" aria-label="Past polls">
            <div class="vibeSectionHead">
              <span class="vibeSectionLabel">📊 Past Results</span>
            </div>
            <div class="vibePastGrid">
              <div class="vibePastCard">
                <div class="vibePastQ">Best brunch spot in Daytona Beach?</div>
                <div class="vibePastWinner">🏆 Café on the Beach — 41% of votes</div>
                <div class="vibePastMeta">502 votes · March 2026</div>
              </div>
              <div class="vibePastCard">
                <div class="vibePastQ">Which Daytona neighbourhood is most up-and-coming?</div>
                <div class="vibePastWinner">🏆 Midtown — 38% of votes</div>
                <div class="vibePastMeta">389 votes · February 2026</div>
              </div>
              <div class="vibePastCard">
                <div class="vibePastQ">Best beach for families in the greater Daytona area?</div>
                <div class="vibePastWinner">🏆 New Smyrna Beach — 47% of votes</div>
                <div class="vibePastMeta">611 votes · January 2026</div>
              </div>
            </div>
          </section>

        </div>
      </div>

      <!-- ── SIDEBAR ── -->
      <aside class="vibeSideCol">

        <!-- Newsletter signup -->
        <div class="vnlBox">
          <div class="vnlHead"><em>Good News <strong>Daytona!</strong></em></div>
          <div class="vnlSub">Get the best local stories delivered free every morning.</div>
          <form class="vnlForm" action="/daytona/subscribe/" method="get">
            <input class="vnlInput" type="email" name="email"
              placeholder="your@email.com" required autocomplete="email" />
            <button class="vnlSubmit" type="submit">SIGN UP</button>
          </form>
        </div>

        <!-- Pulse Partners -->
        <div class="vPulsePartner">
          <div class="vppLabel">Community Partner</div>
          <a class="vppCard" href="https://godocity.com/" target="_blank" rel="noopener">
            <div class="vppLogoWrap">
              <img class="vppLogo" src="/images/gododaytona-bg.png" alt="Partner logo" loading="lazy" />
              <!-- Badge options: "Local Tip" | "Pro Tip" | "Sponsor Spotlight" -->
              <div class="vppTipBadge">Local Tip</div>
            </div>
            <div class="vppBody">
              <div class="vppTip">Best sunset views are at Ponce Inlet Lighthouse — arrive 30 min early for the best spot.</div>
            </div>
          </a>
        </div>

        <!-- Upcoming Events -->
        <div class="vRailSection">
          <div class="vRailHead">
            <span class="vRailTitle">Upcoming Events</span>
            <a class="vRailMore" href="/daytona/events/">See all</a>
          </div>

          {!hasEvents ? (
            <p class="vNoEvents">No upcoming events yet.</p>
          ) : (
            <div class="vEventList">

              {hasSlider && (
                <div class="vEvSlider" id="vcSlider" aria-label="Featured sponsored events">
                  {sponsoredSlides.map((e: any, idx: number) => {
                    const d       = new Date(e.data.eventDate);
                    const dow     = d.toLocaleDateString("en-US", { weekday: "short" }).toUpperCase();
                    const day     = d.getDate();
                    const eMon    = d.toLocaleDateString("en-US", { month: "short" }).toUpperCase();
                    const mon     = d.toLocaleDateString("en-US", { month: "short" });
                    const evCity  = (e.data.city ?? e.slug.split("/")[0]).toLowerCase().trim();
                    const cityLabel = cityDisplayName(evCity);
                    return (
                      <a class={`vEvSlide${idx === 0 ? " vEvSlide--active" : ""}`}
                         href={e.data.url ?? `/${e.data.city ?? evCity}/events/${e.slug.split("/").pop()}/`}
                         target={e.data.url ? "_blank" : "_self"}
                         rel={e.data.url ? "noopener" : ""}
                         aria-hidden={idx !== 0 ? "true" : undefined}
                         data-vc-slide-idx={String(idx)}>
                        <div class="vEventCal">
                          <div class="veDow">{dow}</div>
                          <div class="veDay">{day}</div>
                          <div class="veMon">{eMon}</div>
                        </div>
                        <div class="veInfo">
                          <div class="veName">{e.data.title}</div>
                          <div class="vePlace">
                            <span>{mon} {day}</span>
                            <span class="veCSep">|</span>
                            <span class="veCityName">{cityLabel}</span>
                            <span class="veSponBadge">SPONSORED</span>
                          </div>
                        </div>
                      </a>
                    );
                  })}
                  {sponsoredSlides.length > 1 && (
                    <div class="vcDots" id="vcDots">
                      {sponsoredSlides.map((_: any, idx: number) => (
                        <button
                          class={`vcDot${idx === 0 ? " vcDot--active" : ""}`}
                          aria-label={`Go to slide ${idx + 1}`}
                          data-vc-dot={String(idx)}
                          type="button"
                        ></button>
                      ))}
                    </div>
                  )}
                </div>
              )}

              {hasList && regularList.map((e: any) => {
                const d       = new Date(e.data.eventDate);
                const dow     = d.toLocaleDateString("en-US", { weekday: "short" }).toUpperCase();
                const day     = d.getDate();
                const eMon    = d.toLocaleDateString("en-US", { month: "short" }).toUpperCase();
                const mon     = d.toLocaleDateString("en-US", { month: "short" });
                const evCity  = (e.data.city ?? e.slug.split("/")[0]).toLowerCase().trim();
                const cityLabel = cityDisplayName(evCity);
                return (
                  <a class="vEventRow"
                     href={e.data.url ?? `/${e.data.city ?? evCity}/events/${e.slug.split("/").pop()}/`}
                     target={e.data.url ? "_blank" : "_self"}
                     rel={e.data.url ? "noopener" : ""}>
                    <div class="vEventCal">
                      <div class="veDow">{dow}</div>
                      <div class="veDay">{day}</div>
                      <div class="veMon">{eMon}</div>
                    </div>
                    <div class="veInfo">
                      <div class="veName">{e.data.title}</div>
                      <div class="vePlace">
                        <span>{mon} {day}</span>
                        <span class="veCSep">|</span>
                        <span class="veCityName">{cityLabel}</span>
                      </div>
                    </div>
                  </a>
                );
              })}

            </div>
          )}
          <a class="vSubmitEventLink" href="/submit-event/">+ Submit an event →</a>
        </div>

      </aside>
    </div>

  </div>
</Base>

<script>
  /* ── Vibe Check page sidebar slider ── */
  (function () {
    var slider = document.getElementById("vcSlider");
    if (!slider) return;
    var slides  = Array.prototype.slice.call(slider.querySelectorAll(".vEvSlide"));
    var dotsEl  = document.getElementById("vcDots");
    var dots    = dotsEl ? Array.prototype.slice.call(dotsEl.querySelectorAll(".vcDot")) : [];
    var current = 0;
    var total   = slides.length;
    var timer: ReturnType<typeof setInterval> | null = null;
    if (total <= 1) return;
    function goTo(idx: number) {
      slides[current].classList.remove("vEvSlide--active");
      slides[current].setAttribute("aria-hidden", "true");
      if (dots[current]) dots[current].classList.remove("vcDot--active");
      current = (idx + total) % total;
      slides[current].classList.add("vEvSlide--active");
      slides[current].removeAttribute("aria-hidden");
      if (dots[current]) dots[current].classList.add("vcDot--active");
    }
    function startAuto() { timer = setInterval(function () { goTo(current + 1); }, 5000); }
    function resetAuto() { if (timer) clearInterval(timer); startAuto(); }
    dots.forEach(function (dot, i) { dot.addEventListener("click", function () { goTo(i); resetAuto(); }); });
    slider.addEventListener("mouseenter", function () { if (timer) clearInterval(timer); });
    slider.addEventListener("mouseleave", startAuto);
    startAuto();
  })();
</script>

<style>
  .vibeWrap {
    min-height: 100vh;
  }

  /* ── Hero Banner ── */
  .vibe-hero {
    background:
      radial-gradient(circle at 50% 0%, rgba(58, 77, 101, 0.4) 0%, transparent 70%),
      linear-gradient(180deg, #3A4D65 0%, #2E3E52 100%);
    padding: 21px 15px 18px;
    margin-top: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    width: 100%;
    box-sizing: border-box;
    position: relative;
  }
  /* Full-bleed yellow framing lines spanning the entire banner width */
  .vibe-hero::before,
  .vibe-hero::after {
    content: "";
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: #FFD24A;
  }
  .vibe-hero::before { top: 0; }
  .vibe-hero::after  { bottom: 0; }
  .vibe-hero__inner {
    max-width: 800px;
    width: 100%;
  }
  .vibe-hero__eyebrow {
    display: block;
    font-family: 'Manrope', sans-serif;
    font-size: 21px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .vibe-hero__title {
    font-family: 'Manrope', sans-serif;
    font-size: 64px;
    font-weight: 800;
    line-height: 1.0;
    color: #F5F7FA;
    margin: 0 auto 16px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    -webkit-text-stroke: 1px #000;
    paint-order: stroke fill;
  }
  .vibe-hero__dek {
    font-family: 'Manrope', sans-serif;
    font-size: 22px;
    font-weight: 500;
    color: rgba(232, 237, 244, 0.88);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.5;
  }
  .vibe-hero__divider {
    width: 40px;
    height: 3px;
    background: #FFD24A;
    margin: 20px auto 0;
    border-radius: 2px;
  }
  @media (max-width: 1024px) {
    .vibe-hero {
      padding: 18px 13px 16px;
    }
    .vibe-hero__title {
      font-size: 44px;
    }
  }
  @media (max-width: 768px) {
    .vibe-hero {
      padding: 16px 10px 13px;
    }
    .vibe-hero__eyebrow {
      font-size: 16px;
    }
    .vibe-hero__title {
      font-size: 38px;
    }
    .vibe-hero__dek {
      font-size: 18px;
    }
    .mobile-break {
      display: none;
    }
  }

  /* ── Two-column page layout ── */
  .vibePageLayout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 32px;
    max-width: 1260px;
    margin: 0 auto;
    padding: 0 18px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .vibePageLayout {
      grid-template-columns: 1fr;
    }
    .vibeSideCol {
      order: 2;
    }
  }

  /* ── Main column container ── */
  .vibeMain {
    min-width: 0;
  }
  .vibeContainer {
    padding: 40px 0 80px;
    display: grid;
    gap: 48px;
  }

  /* ── Section ── */
  .vibeSection { display: grid; gap: 20px; }
  .vibeSectionHead {
    border-bottom: 2px solid var(--brand1);
    padding-bottom: 10px;
    max-width: 680px;
  }
  .vibeSectionLabel {
    font-size: 13px;
    font-weight: 900;
    letter-spacing: .10em;
    text-transform: uppercase;
    color: var(--text);
  }

  /* ── Current poll wrapper ── */
  .vibePollWrap {
    max-width: 680px;
  }

  /* ── Past polls grid ── */
  .vibePastGrid {
    display: grid;
    gap: 14px;
    max-width: 680px;
  }
  .vibePastCard {
    padding: 18px 20px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--pillBg);
    display: grid;
    gap: 6px;
  }
  .vibePastQ {
    font-weight: 800;
    font-size: 15px;
    color: var(--text);
    line-height: 1.3;
  }
  .vibePastWinner {
    font-size: 14px;
    font-weight: 700;
    color: var(--brand1);
  }
  .vibePastMeta {
    font-size: 12px;
    color: var(--faint);
  }

  /* ── Sidebar column ── */
  .vibeSideCol {
    display: grid;
    gap: 28px;
    align-self: start;
    padding-top: 40px;
    min-width: 0;
  }

  /* ── Newsletter box ── */
  .vnlBox {
    padding: 32px 22px;
    border-radius: 16px;
    background: #f0f7ff;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .vnlHead {
    font-size: 26px; font-weight: 900; font-style: italic;
    color: #0b1a2e; line-height: 1.05; letter-spacing: -0.04em;
  }
  .vnlHead strong { font-weight: 900; }
  .vnlSub { font-size: 14px; color: rgba(11,26,46,.8); line-height: 1.45; }
  .vnlForm { display: flex; flex-direction: column; gap: 8px; margin-top: 4px; }
  .vnlInput {
    width: 100%; box-sizing: border-box;
    padding: 12px 14px; border-radius: 10px;
    border: none; background: #fff;
    font-size: 14px; color: #111;
    box-shadow: 0 2px 8px rgba(0,0,0,.12);
    outline: 2px solid transparent; transition: outline-color 150ms;
  }
  .vnlInput:focus { outline-color: #0077be; }
  .vnlInput::placeholder { color: #aaa; }
  .vnlSubmit {
    width: 100%; padding: 12px 0; border-radius: 999px;
    border: none; background: #0077be; color: #fff;
    font-family: "Century Gothic", AppleGothic, Arial, sans-serif;
    font-size: 14px; font-weight: 900; letter-spacing: .08em;
    cursor: pointer; transition: opacity 150ms;
  }
  .vnlSubmit:hover { opacity: .82; }

  /* ── Rail sections (events) ── */
  .vRailSection { display: grid; gap: 0; }
  .vRailHead {
    display: flex; justify-content: space-between; align-items: baseline;
    padding-bottom: 10px; border-bottom: 2px solid var(--brand1);
  }
  .vRailTitle {
    font-size: 14px; font-weight: 900; letter-spacing: .08em;
    text-transform: uppercase; color: var(--text);
  }
  .vRailMore { font-size: 13px; font-weight: 700; color: var(--link); text-decoration: none; }
  .vRailMore:hover { text-decoration: underline; }

  /* ── Events list ── */
  .vEventList { display: grid; }

  /* ── Sponsored slider ── */
  .vEvSlider {
    display: grid;
    grid-template-columns: 1fr;
    margin-bottom: 4px;
    border-bottom: 1px solid var(--border);
  }
  .vEvSlide {
    grid-row: 1;
    grid-column: 1;
    display: grid; grid-template-columns: 44px 1fr; gap: 10px;
    align-items: center; text-decoration: none;
    padding: 12px 8px;
    background: rgba(249,217,0,.06);
    border-radius: 8px;
    margin: 8px -6px 0;
    opacity: 0;
    transition: opacity 500ms ease;
    pointer-events: none;
  }
  .vEvSlide--active { opacity: 1; pointer-events: auto; }
  .vcDots { grid-row: 2; grid-column: 1; display: flex; gap: 5px; justify-content: center; padding: 8px 0 4px; }
  .vcDot {
    width: 6px; height: 6px; border-radius: 50%;
    border: none; padding: 0;
    background: var(--border, rgba(255,255,255,.25));
    cursor: pointer; transition: background 200ms, transform 200ms;
  }
  .vcDot--active { background: var(--brand1); transform: scale(1.3); }

  /* ── Regular event rows ── */
  .vEventRow {
    display: grid; grid-template-columns: 44px 1fr; gap: 10px;
    align-items: center; text-decoration: none;
    padding: 12px 0; border-bottom: 1px solid var(--border);
    transition: opacity 140ms;
  }
  .vEventRow:last-child { border-bottom: none; }
  .vEventRow:hover { opacity: .76; }

  .vEventCal {
    width: 44px; height: 44px; border-radius: 10px;
    background: var(--pillBg); border: 1px solid var(--pillBorder);
    display: grid; place-items: center; text-align: center; line-height: 1;
    flex-shrink: 0;
  }
  .veDow { font-size: 9px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; color: var(--brand1); }
  .veDay { font-size: 17px; font-weight: 900; color: var(--text); margin-top: 1px; }
  .veMon { font-size: 7px; font-weight: 700; letter-spacing: .08em; color: var(--faint); text-transform: uppercase; }
  .veInfo { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .veName { font-weight: 800; font-size: 14px; color: var(--text); line-height: 1.2; }
  .vePlace { font-size: 11px; color: var(--faint); display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
  .veCSep { opacity: .4; }
  .veCityName { color: var(--brand1); font-weight: 700; }
  .vNoEvents { font-size: 13px; color: var(--faint); padding: 12px 0; margin: 0; }
  .veSponBadge {
    display: inline-block;
    font-size: 8px; font-weight: 900; letter-spacing: .08em;
    background: rgba(249,217,0,.18); color: var(--brand1);
    border: 1px solid rgba(249,217,0,.35);
    padding: 1px 5px; border-radius: 999px;
    white-space: nowrap;
  }
  .vSubmitEventLink {
    display: block; margin-top: 10px;
    font-size: 12px; font-weight: 700;
    color: var(--brand1); text-decoration: none;
    opacity: .85; transition: opacity 120ms;
  }
  .vSubmitEventLink:hover { opacity: 1; }

  /* ── Pulse Partners ── */
  .vPulsePartner { display: grid; gap: 0; }
  .vppLabel {
    font-size: 12.5px; font-weight: 700; letter-spacing: .12em;
    text-transform: uppercase; color: var(--faint);
    text-align: center; margin-bottom: 6px;
  }
  .vppCard {
    display: grid; gap: 12px;
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    background: var(--pillBg);
    transition: border-color 140ms, box-shadow 140ms;
  }
  .vppCard:hover {
    border-color: var(--brand1);
    box-shadow: 0 0 0 1px rgba(255, 210, 74, 0.15), 0 6px 20px rgba(0,0,0,.25);
  }
  .vppLogoWrap {
    width: 100%; aspect-ratio: 16/7; overflow: hidden;
    border-bottom: 1px solid var(--border);
    position: relative;
  }
  .vppLogo {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .vppTipBadge {
    position: absolute; top: 8px; right: 10px;
    display: inline-flex; align-items: center;
    padding: 2px 8px; border-radius: 999px;
    font-size: 11px; font-weight: 900; letter-spacing: .08em;
    background: rgba(11, 13, 16, 0.72); color: var(--brand1);
    border: 1px solid rgba(255, 210, 74, 0.45);
    backdrop-filter: blur(4px);
    width: fit-content;
  }
  .vppBody { padding: 4px 12px !important; min-height: 0; display: grid; gap: 6px; }
  .vppTip {
    font-size: 14px; font-weight: 600; color: var(--text);
    line-height: 1.4;
  }

  /* ══════════════════════════════════════════════════════════════════
     CLEAN WHITE THEME — fix yellow-on-white text contrast
     ══════════════════════════════════════════════════════════════════ */

  /* Section header accent lines → light grey */
  :global(html[data-theme="clean-white"]) .vibeSectionHead { border-bottom-color: #E5E7EB; }
  :global(html[data-theme="clean-white"]) .vRailHead { border-bottom-color: #E5E7EB; }

  /* Past poll winner text → Deep Slate instead of yellow */
  :global(html[data-theme="clean-white"]) .vibePastWinner { color: #374151; }

  /* Sidebar event calendar day-of-week + city name → Deep Slate */
  :global(html[data-theme="clean-white"]) .veDow { color: #374151; }
  :global(html[data-theme="clean-white"]) .veCityName { color: #374151; }

  /* Sponsored badge → legible on white */
  :global(html[data-theme="clean-white"]) .veSponBadge {
    background: rgba(55,65,81,.08);
    color: #374151;
    border-color: rgba(55,65,81,.25);
  }

  /* "Submit an event" link → Deep Slate */
  :global(html[data-theme="clean-white"]) .vSubmitEventLink { color: #374151; }

  /* Pulse partner hover ring → neutral instead of yellow glow */
  :global(html[data-theme="clean-white"]) .vppCard:hover {
    border-color: #374151;
    box-shadow: 0 0 0 1px rgba(55,65,81,.12), 0 6px 20px rgba(0,0,0,.12);
  }

  /* Sidebar newsletter box (yellow bg) → add dark border for definition on white page */
  :global(html[data-theme="clean-white"]) .vnlBox {
    border: 1px solid #111111;
  }

  /* "Good News Daytona!" headline inside sidebar box — enforce black */
  :global(html[data-theme="clean-white"]) .vnlHead { color: #000000; }
</style>
