
---
import Base from "../../../layouts/Base.astro";
const title = "Advertise";
---
<Base title={title} cityBase="daytona" />

<section class="section">
  <div class="container">
    <h1 class="advertise-heading">Advertise with GoDo Daytona</h1>

    <div class="card card-pad" style="margin-top:14px;">
      <div class="kicker">Contact</div>
      <p class="lede" style="margin:8px 0 0;">
        Email: <a href="mailto:ads@godocity.com">ads@godocity.com</a>
      </p>
    </div>
  </div>
</section>

<style>
  .advertise-heading {
    font-size: 3.5rem;
    font-weight: 900 !important;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
</style>
