<script is:inline>
(function () {
  var btn = document.getElementById('routerBtn');
  if (!btn) return;

  var ROUTES = [
    { who: 'venue',    goal: 'event',      card: 'card-godo-vip',      label: 'GoDo VIP Headliner' },
    { who: 'regional', goal: 'event',      card: 'card-godo-vip',      label: 'GoDo VIP Headliner' },
    { who: 'business', goal: 'event',      card: 'card-high-impact',   label: 'High-Impact Listing' },
    { who: 'nonprofit',goal: 'event',      card: 'card-event-spotlight',label: 'Event Spotlight' },
    { who: 'venue',    goal: 'awareness',  card: 'card-high-impact',   label: 'High-Impact Listing' },
    { who: 'business', goal: 'awareness',  card: 'card-high-impact',   label: 'High-Impact Listing' },
    { who: 'regional', goal: 'awareness',  card: 'card-high-impact',   label: 'High-Impact Listing' },
    { who: 'nonprofit',goal: 'awareness',  card: 'card-event-spotlight',label: 'Event Spotlight' },
    { who: 'venue',    goal: 'newsletter', card: 'card-local-pack',    label: 'GoDo Local Pack' },
    { who: 'business', goal: 'newsletter', card: 'card-local-pack',    label: 'GoDo Local Pack' },
    { who: 'regional', goal: 'newsletter', card: 'card-local-pack',    label: 'GoDo Local Pack' },
    { who: 'nonprofit',goal: 'newsletter', card: 'card-local-pack',    label: 'GoDo Local Pack' },
  ];

  btn.addEventListener('click', function () {
    var who  = document.getElementById('routerWho').value;
    var goal = document.getElementById('routerGoal').value;
    var result = document.getElementById('routerResult');

    if (!who || !goal) {
      if (result) result.textContent = 'Please select both options above.';
      return;
    }

    var match = ROUTES.find(function (r) { return r.who === who && r.goal === goal; });
    if (!match) {
      if (result) result.textContent = 'Contact us and we\'ll find the right fit.';
      return;
    }

    var card = document.getElementById(match.card);
    if (!card) return;

    // Remove any existing highlight
    document.querySelectorAll('.catalogCard--highlight').forEach(function (el) {
      el.classList.remove('catalogCard--highlight');
      void el.offsetWidth; // reflow to restart animation
    });

    card.classList.add('catalogCard--highlight');
    card.scrollIntoView({ behavior: 'smooth', block: 'center' });

    if (result) result.textContent = '✓ Best match: ' + match.label + ' — see it highlighted below.';
  });
})();
</script>

