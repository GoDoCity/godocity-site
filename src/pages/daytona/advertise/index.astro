---
import Base from "../../../layouts/Base.astro";
import AdSlot from "../../../components/AdSlot.astro";
import LegalDisclaimer from "../../../components/LegalDisclaimer.astro";
---

<Base
  title="Advertise with GoDoDaytona | 2026 Media Kit"
  subtitle="Partner with Daytona Beach's most engaged local audience."
  cityBase="daytona"
>

  <!-- ═══════════════════════════════════════════
       1. HERO — The Mission
  ═══════════════════════════════════════════ -->
  <section class="adHero">
    <div class="adHeroOverlay" aria-hidden="true"></div>
    <div class="adHeroInner">
      <p class="adHeroEyebrow">Media &amp; Partnership Opportunities</p>
      <h1 class="adHeroTitle">Connect with Daytona's<br>Most Engaged Audience.</h1>
      <p class="adHeroSub">We help local brands tell their stories to the people who make this city move.</p>
      <div class="adHeroCtas">
        <a href="#contact" class="adBtnBlack">Request Our 2026 Media Kit</a>
        <a href="#products" class="adBtnGhost">View Partnership Options ↓</a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       INTERACTIVE PLACEMENT ROUTER
  ══════════════════════════════════════════ -->
  <div class="adRouter" id="placement-router">
    <div class="adRouterInner">
      <p class="adRouterLabel">Find the right placement in seconds</p>
      <div class="adRouterFields">
        <div class="adRouterField">
          <label class="adRouterFieldLabel" for="routerWho">I am a…</label>
          <select class="adRouterSelect" id="routerWho">
            <option value="">Select type</option>
            <option value="venue">Concert Promoter or Venue</option>
            <option value="business">Local Business</option>
            <option value="nonprofit">Non-Profit</option>
            <option value="regional">Regional Brand</option>
          </select>
        </div>
        <div class="adRouterField">
          <label class="adRouterFieldLabel" for="routerGoal">I want to…</label>
          <select class="adRouterSelect" id="routerGoal">
            <option value="">Select goal</option>
            <option value="event">Promote an Event</option>
            <option value="awareness">Build Brand Awareness</option>
            <option value="newsletter">Sponsor a Newsletter</option>
          </select>
        </div>
        <button class="adRouterBtn" id="routerBtn" type="button">Find My Placement →</button>
      </div>
      <p class="adRouterResult" id="routerResult"></p>
    </div>
  </div>

  <!-- ══════════════════════════════════════════
       PREMIUM BUNDLE — GoDo Local Pack
  ══════════════════════════════════════════ -->
  <div class="adBundleBar">
    <div class="adBundleBarInner">
      <div class="adBundleBarLabel">
        <span class="adBundleEyebrow">Best Value · Bundle</span>
        <h2 class="adBundleTitle">The GoDo Local Pack</h2>
        <p class="adBundleSub">1 GoDo VIP Pick + 2 Newsletter Mentions — full-funnel weekly coverage at a bundled rate.</p>
      </div>
      <div class="adBundleCards">

        <div class="adBundleLineItem">
          <span class="adBundleItemIcon" aria-hidden="true">★</span>
          <div class="adBundleItemBody">
            <strong class="adBundleItemName">GoDo VIP Headliner</strong>
            <span class="adBundleItemNote">Events Hub · GoDo Picks Top Slot</span>
          </div>
          <span class="adBundleItemVal">$375 value</span>
        </div>

        <div class="adBundleLineItem">
          <span class="adBundleItemIcon" aria-hidden="true">✉</span>
          <div class="adBundleItemBody">
            <strong class="adBundleItemName">2× Newsletter Mentions</strong>
            <span class="adBundleItemNote">Native editorial integration · 5,000+ inboxes</span>
          </div>
          <span class="adBundleItemVal">$300 value</span>
        </div>

        <div class="adBundleDivider" aria-hidden="true"></div>

        <div class="adBundleTotal">
          <span class="adBundleTotalLabel">Bundle Price</span>
          <span class="adBundleTotalPrice">$450 <em>/ month</em></span>
          <span class="adBundleSaving">Save $225 vs. buying separately</span>
        </div>

      </div>
      <a href="/products/godo-local-pack" class="adBundleCta">See Full Package Details →</a>
    </div>
  </div>

  <div class="adBody">

    <!-- ═══════════════════════════════════════════
         2. WHO WE ARE — Three Pillars
    ═══════════════════════════════════════════ -->
    <section class="adSection">
      <div class="adWrap">
        <div class="adSectionHead">
          <span class="adEyebrow">Who We Are</span>
          <h2 class="adTitle">Three platforms. One community.</h2>
        </div>
        <div class="pillarsGrid">

          <div class="pillarCard">
            <div class="pillarIcon">
              <!-- Newspaper / morning briefing -->
              <svg width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="2" y="3" width="20" height="24" rx="3" stroke="currentColor" stroke-width="2"/>
                <rect x="7" y="9" width="10" height="2" rx="1" fill="currentColor"/>
                <rect x="7" y="14" width="10" height="1.5" rx=".75" fill="currentColor" opacity=".55"/>
                <rect x="7" y="18" width="7" height="1.5" rx=".75" fill="currentColor" opacity=".55"/>
                <path d="M22 7h5a1 1 0 0 1 1 1v14a3 3 0 0 1-3 3H22" stroke="currentColor" stroke-width="2"/>
              </svg>
            </div>
            <h3 class="pillarName">The Daily</h3>
            <p class="pillarDesc">Your essential morning briefing — curated Daytona news and stories delivered fresh every weekday to thousands of engaged inboxes.</p>
          </div>

          <div class="pillarCard">
            <div class="pillarIcon">
              <!-- Globe / digital -->
              <svg width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="15" cy="15" r="12" stroke="currentColor" stroke-width="2"/>
                <ellipse cx="15" cy="15" rx="5" ry="12" stroke="currentColor" stroke-width="2"/>
                <line x1="3" y1="15" x2="27" y2="15" stroke="currentColor" stroke-width="2"/>
                <line x1="5" y1="9.5" x2="25" y2="9.5" stroke="currentColor" stroke-width="1.6" opacity=".45"/>
                <line x1="5" y1="20.5" x2="25" y2="20.5" stroke="currentColor" stroke-width="1.6" opacity=".45"/>
              </svg>
            </div>
            <h3 class="pillarName">The Digital</h3>
            <p class="pillarDesc">Real-time city guides, local news, and evergreen content — built for search and social, reaching Daytona Beach around the clock.</p>
          </div>

          <div class="pillarCard">
            <div class="pillarIcon">
              <!-- Community / people -->
              <svg width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="15" cy="9.5" r="4.5" stroke="currentColor" stroke-width="2"/>
                <path d="M6 27c0-4.97 4.03-9 9-9s9 4.03 9 9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <circle cx="5.5" cy="11" r="3" stroke="currentColor" stroke-width="1.8" opacity=".55"/>
                <path d="M1 25c0-3.1 2.01-5.74 4.78-6.66" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" opacity=".55"/>
                <circle cx="24.5" cy="11" r="3" stroke="currentColor" stroke-width="1.8" opacity=".55"/>
                <path d="M29 25c0-3.1-2.01-5.74-4.78-6.66" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" opacity=".55"/>
              </svg>
            </div>
            <h3 class="pillarName">The Community</h3>
            <p class="pillarDesc">Deeply local, highly engaged followers who live, work, and play in Daytona Beach and the surrounding Volusia County region.</p>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         3. AUDIENCE DEMOGRAPHICS — Who You'll Reach
    ═══════════════════════════════════════════ -->
    <section class="adSection adSection--tinted">
      <div class="adWrap">
        <div class="adSectionHead">
          <span class="adEyebrow">Our Audience</span>
          <h2 class="adTitle">Who You'll Reach</h2>
          <p class="adSubtitle">A highly engaged, hyperlocal audience in the heart of Volusia County.</p>
        </div>

        <div class="demoGrid">

          <div class="demoCard">
            <div class="demoIconWrap" aria-hidden="true">
              <svg width="26" height="26" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="13" cy="13" r="11" stroke="currentColor" stroke-width="2"/>
                <path d="M13 7v6l3.5 2.2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="demoValue">25–54</div>
            <div class="demoLabel">Age Range</div>
            <div class="demoNote">Targeting the active workforce</div>
          </div>

          <div class="demoCard">
            <div class="demoIconWrap" aria-hidden="true">
              <svg width="26" height="26" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="13" cy="10.5" r="6" stroke="currentColor" stroke-width="2"/>
                <line x1="13" y1="16.5" x2="13" y2="24" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <line x1="9.5" y1="20" x2="16.5" y2="20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="demoValue">Balanced</div>
            <div class="demoLabel">Gender Split</div>
            <div class="demoNote">Representative local audience</div>
          </div>

          <div class="demoCard">
            <div class="demoIconWrap" aria-hidden="true">
              <!-- Fork & knife / Dining -->
              <svg width="26" height="26" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M7 3v8a4 4 0 0 0 8 0V3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <line x1="11" y1="3" x2="11" y2="23" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <path d="M17 3c0 0 2 3 2 7s-2 6-2 6v7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="demoValue">Dining</div>
            <div class="demoLabel">Interest</div>
            <div class="demoNote">Restaurants &amp; local food</div>
          </div>

          <div class="demoCard">
            <div class="demoIconWrap" aria-hidden="true">
              <!-- Landmark / History -->
              <svg width="26" height="26" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="12" width="20" height="11" rx="2" stroke="currentColor" stroke-width="2"/>
                <path d="M1 12l12-8 12 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <rect x="10" y="16" width="6" height="7" rx="1" fill="currentColor" opacity=".38"/>
              </svg>
            </div>
            <div class="demoValue">History</div>
            <div class="demoLabel">Interest</div>
            <div class="demoNote">Local heritage &amp; culture</div>
          </div>

          <div class="demoCard">
            <div class="demoIconWrap" aria-hidden="true">
              <!-- Calendar / Events -->
              <svg width="26" height="26" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="2" y="5" width="22" height="18" rx="3" stroke="currentColor" stroke-width="2"/>
                <line x1="2" y1="11" x2="24" y2="11" stroke="currentColor" stroke-width="2"/>
                <line x1="8" y1="2" x2="8" y2="8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <line x1="18" y1="2" x2="18" y2="8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <rect x="7" y="15" width="4" height="4" rx="1" fill="currentColor" opacity=".45"/>
                <rect x="15" y="15" width="4" height="4" rx="1" fill="currentColor" opacity=".45"/>
              </svg>
            </div>
            <div class="demoValue">Events</div>
            <div class="demoLabel">Interest</div>
            <div class="demoNote">Races, festivals &amp; community</div>
          </div>

          <div class="demoCard">
            <div class="demoIconWrap" aria-hidden="true">
              <!-- Wrench / DIY -->
              <svg width="26" height="26" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5 21L17 9a4 4 0 0 1 5.66 5.66L10.66 26.66" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <path d="M15 7.5l3.5 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <circle cx="4.5" cy="21.5" r="1.5" fill="currentColor"/>
              </svg>
            </div>
            <div class="demoValue">DIY</div>
            <div class="demoLabel">Interest</div>
            <div class="demoNote">Home, craft &amp; repair</div>
          </div>

          <div class="demoCard">
            <div class="demoIconWrap" aria-hidden="true">
              <!-- Heart + check / Wellness -->
              <svg width="26" height="26" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M13 22S3 15.5 3 9a6 6 0 0 1 10-4.47A6 6 0 0 1 23 9c0 6.5-10 13-10 13z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                <path d="M9 12l2.5 2.5 5.5-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="demoValue">Wellness</div>
            <div class="demoLabel">Interest</div>
            <div class="demoNote">Health, fitness &amp; outdoors</div>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         4. PERFORMANCE STATS — The Proof
    ═══════════════════════════════════════════ -->
    <section class="adSection adSection--dark">
      <div class="adWrap">
        <div class="adSectionHead adSectionHead--center adSectionHead--onDark">
          <span class="adEyebrow adEyebrow--onDark">The Proof</span>
          <h2 class="adTitle adTitle--onDark">Numbers that move the needle.</h2>
        </div>
        <div class="statsGrid">

          <div class="statCard">
            <div class="statNum">25,000+</div>
            <div class="statLabel">Monthly Active Readers</div>
            <div class="statNote">Across email, web &amp; social</div>
          </div>

          <div class="statCard statCard--featured">
            <div class="statFeaturedLabel">Star Metric</div>
            <div class="statNum">42%</div>
            <div class="statLabel">Average Open Rate</div>
            <div class="statNote">2× the industry average of 21%</div>
          </div>

          <div class="statCard">
            <div class="statNum">10,000+</div>
            <div class="statLabel">Social Media Followers</div>
            <div class="statNote">Highly engaged local community</div>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         5. PARTNERSHIP PRODUCTS — 4 Cards
    ═══════════════════════════════════════════ -->
    <section class="adSection" id="products">
      <div class="adWrap">
        <div class="adSectionHead">
          <span class="adEyebrow">Partnership Opportunities</span>
          <h2 class="adTitle">Find the right fit for your brand.</h2>
          <p class="adSubtitle">Every package is customizable. We'll build something that fits your goals and your budget.</p>
        </div>
        <div class="productsGrid">

          <div class="productCard">
            <div class="productTop">
              <div class="productIconBox" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="1" y="3" width="20" height="16" rx="3" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M1 7l10 7 10-7" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                </svg>
              </div>
              <span class="productBadge">Most Popular</span>
            </div>
            <h3 class="productName">Own the Morning</h3>
            <p class="productDesc">Your brand in the inbox before the first coffee. Our daily briefing reaches thousands of local readers right as they start their day — primed, present, and ready to engage.</p>
            <div class="productBestFor"><strong>Best for:</strong> Brand awareness &amp; direct response</div>
            <div class="productSlotPreview">
              <span class="slotLabel">Slot Preview</span>
              <div class="slotDemo slotDemo--email">
                <div class="sdLabel">SPONSORED</div>
                <div class="sdEmailRow">
                  <div class="sdEmailThumb"></div>
                  <div class="sdEmailLines">
                    <div class="sdLine sdLine--wide"></div>
                    <div class="sdLine sdLine--med"></div>
                  </div>
                </div>
              </div>
            </div>
            <a href="/daytona/advertise/products/daily-mention/" class="productLink">View placement →</a>
          </div>

          <div class="productCard">
            <div class="productTop">
              <div class="productIconBox" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M14.06 6.19l3.75 3.75 2.19-2.19a2.652 2.652 0 0 0-3.75-3.75L14.06 6.19z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <span class="productBadge productBadge--hidden" aria-hidden="true"></span>
            </div>
            <h3 class="productName">Stories that Stick</h3>
            <p class="productDesc">Your story, told the GoDo way — authentic, local, and built for discovery. Long-form editorial that earns clicks and holds rank long after it publishes.</p>
            <div class="productBestFor"><strong>Best for:</strong> Storytelling &amp; SEO authority</div>
            <div class="productSlotPreview">
              <span class="slotLabel">Slot Preview</span>
              <div class="slotDemo slotDemo--article">
                <div class="sdLabel">SPONSORED</div>
                <div class="sdArticleHero"></div>
                <div class="sdArticleLines">
                  <div class="sdLine sdLine--wide"></div>
                  <div class="sdLine sdLine--med"></div>
                  <div class="sdLine sdLine--narrow"></div>
                </div>
              </div>
            </div>
            <a href="/daytona/advertise/products/deep-dive/" class="productLink">View placement →</a>
          </div>

          <div class="productCard">
            <div class="productTop">
              <div class="productIconBox" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="18" cy="5" r="3" stroke="currentColor" stroke-width="1.8"/>
                  <circle cx="18" cy="17" r="3" stroke="currentColor" stroke-width="1.8"/>
                  <circle cx="4" cy="11" r="3" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M6.9 9.5l8.2-3M6.9 12.5l8.2 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </div>
              <span class="productBadge productBadge--hidden" aria-hidden="true"></span>
            </div>
            <h3 class="productName">Light Up the Feed</h3>
            <p class="productDesc">Purpose-built social posts that make your brand look like the local favorite it is. Original creative, real engagement, put directly in front of our most active followers.</p>
            <div class="productBestFor"><strong>Best for:</strong> Rapid reach &amp; event promotion</div>
            <div class="productSlotPreview">
              <span class="slotLabel">Slot Preview</span>
              <div class="slotDemo slotDemo--social">
                <div class="sdLabel">SPONSORED</div>
                <div class="sdSocialRow">
                  <div class="sdAvatar"></div>
                  <div class="sdSocialLines">
                    <div class="sdLine sdLine--wide"></div>
                    <div class="sdLine sdLine--med"></div>
                  </div>
                </div>
                <div class="sdSocialImg"></div>
              </div>
            </div>
            <a href="/daytona/advertise/products/local-feed/" class="productLink">View placement →</a>
          </div>

          <div class="productCard">
            <div class="productTop">
              <div class="productIconBox" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="2" y="3" width="18" height="17" rx="2" stroke="currentColor" stroke-width="1.8"/>
                  <line x1="2" y1="8" x2="20" y2="8" stroke="currentColor" stroke-width="1.8"/>
                  <line x1="7" y1="1" x2="7" y2="5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  <line x1="15" y1="1" x2="15" y2="5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  <path d="M7 13l2.5 2.5 5.5-5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <span class="productBadge productBadge--hidden" aria-hidden="true"></span>
            </div>
            <h3 class="productName">The Full Rollout</h3>
            <p class="productDesc">Co-present your event with GoDo from announcement to recap. Editorial coverage, newsletter slots, social amplification — the whole playbook, before, during, and after.</p>
            <div class="productBestFor"><strong>Best for:</strong> Events, launches &amp; activations</div>
            <div class="productSlotPreview">
              <span class="slotLabel">Slot Preview</span>
              <div class="slotDemo slotDemo--infeed">
                <div class="sdLabel">SPONSORED</div>
                <div class="sdInFeedRow">
                  <div class="sdThumb"></div>
                  <div class="sdInFeedLines">
                    <div class="sdLine sdLine--wide"></div>
                    <div class="sdLine sdLine--med"></div>
                    <div class="sdLine sdLine--narrow"></div>
                  </div>
                </div>
              </div>
            </div>
            <a href="/daytona/advertise/products/market-takeover/" class="productLink">View placement →</a>
          </div>

          <div class="productCard productCard--featured">
            <div class="productTop">
              <div class="productIconBox" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="2" y="3" width="18" height="17" rx="2" stroke="currentColor" stroke-width="1.8"/>
                  <line x1="2" y1="8" x2="20" y2="8" stroke="currentColor" stroke-width="1.8"/>
                  <line x1="7" y1="1" x2="7" y2="5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  <line x1="15" y1="1" x2="15" y2="5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  <path d="M11 12l1.5 3 3.5.5-2.5 2.5.6 3.5L11 20l-3.1 1.5.6-3.5L6 15.5l3.5-.5L11 12z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                </svg>
              </div>
              <span class="productBadge productBadge--new">New</span>
            </div>
            <div class="featuredCardInner">
              <div class="featuredCardText">
                <h3 class="productName">Featured Event Spotlight</h3>
                <p class="featuredCardSub">Center Stage</p>
                <p class="productDesc">Put your event center stage. A dedicated spotlight card pinned to the absolute top of the Upcoming Events widget — the first thing every reader sees on every article across our site, every single day it runs.</p>
                <div class="productBestFor"><strong>Best for:</strong> Ticket sales &amp; attendance</div>
                <a href="#contact" class="productLink">Get started →</a>
              </div>
              <div class="productSlotPreview featuredSlotPreview">
                <span class="slotLabel">Sidebar Preview</span>
                <div class="slotDemo slotDemo--featEvent">
                  <div class="sdFeatHeader">
                    <span class="sdFeatBadge">FEATURED</span>
                  </div>
                  <div class="sdFeatRow">
                    <div class="sdFeatCal">
