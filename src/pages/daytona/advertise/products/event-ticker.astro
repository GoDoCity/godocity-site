---
import Base from "../../../../layouts/Base.astro";
---

<Base
  title="Top-Billing Event Ticker | GoDoDaytona Advertising"
  subtitle="The absolute first thing every Events Hub visitor sees — your event, center stage, above everything."
  cityBase="daytona"
>

  <!-- ── BREADCRUMB ── -->
  <nav class="ppBreadcrumb" aria-label="Breadcrumb">
    <div class="ppWrap">
      <a href="/daytona/advertise/">Advertise</a>
      <span aria-hidden="true">›</span>
      <a href="/daytona/advertise/#self-service">All Products</a>
      <span aria-hidden="true">›</span>
      <span>Top-Billing Event Ticker</span>
    </div>
  </nav>

  <!-- ── HERO ── -->
  <section class="tpHero">
    <div class="tpHeroOverlay" aria-hidden="true"></div>
    <div class="tpWrap tpHeroInner">
      <div class="tpHeroLeft">
        <p class="tpHeroEyebrow">Events Hub · Ultra-Premium Carousel</p>
        <span class="tpHeroBadge">Ultra-Premium · Max 4 Slots</span>
        <h1 class="tpHeroTitle">Top-Billing<br>Event Ticker</h1>
        <p class="tpHeroHook">The absolute first thing every visitor sees when they open Daytona's premier events page — a full-width immersive carousel that overrides the raw API feed and pins your event to the top of the entire discovery experience.</p>
        <div class="tpHeroCtas">
          <a href="/daytona/advertise/#contact" class="tpBtnWhite">Check Availability</a>
          <a href="#how-it-works" class="tpBtnGhost">See How It Works ↓</a>
        </div>
      </div>
      <div class="tpHeroRight" aria-hidden="true">
        <div class="tpHeroStats">
          <div class="tpHeroStat">
            <span class="tpHeroStatNum">76k+</span>
            <span class="tpHeroStatLabel">Monthly Impressions</span>
          </div>
          <div class="tpHeroStatDivider"></div>
          <div class="tpHeroStat">
            <span class="tpHeroStatNum">$500</span>
            <span class="tpHeroStatLabel">per week</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="tpBody">

    <!-- ── SPECS ── -->
    <section class="tpSection tpSection--specs">
      <div class="tpWrap">
        <div class="tpSpecsRow">

          <div class="tpSpecCard">
            <div class="tpSpecIcon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
                <circle cx="11" cy="11" r="9" stroke="currentColor" stroke-width="1.8"/>
                <circle cx="11" cy="11" r="5" stroke="currentColor" stroke-width="1.8"/>
                <circle cx="11" cy="11" r="1.5" fill="currentColor"/>
              </svg>
            </div>
            <div class="tpSpecContent">
              <div class="tpSpecValue">76k+ Monthly</div>
              <div class="tpSpecLabel">Impressions</div>
            </div>
          </div>

          <div class="tpSpecCard">
            <div class="tpSpecIcon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
                <rect x="2" y="3" width="18" height="14" rx="3" stroke="currentColor" stroke-width="1.8"/>
                <path d="M2 8h18" stroke="currentColor" stroke-width="1.8"/>
                <rect x="5" y="11" width="12" height="2" rx="1" fill="currentColor" opacity=".5"/>
              </svg>
            </div>
            <div class="tpSpecContent">
              <div class="tpSpecValue">Above All Content</div>
              <div class="tpSpecLabel">Placement</div>
            </div>
          </div>

          <div class="tpSpecCard">
            <div class="tpSpecIcon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
                <circle cx="11" cy="11" r="9" stroke="currentColor" stroke-width="1.8"/>
                <path d="M11 6v5l3.5 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="tpSpecContent">
              <div class="tpSpecValue">48 Hours</div>
              <div class="tpSpecLabel">Lead Time</div>
            </div>
          </div>

          <div class="tpSpecCard">
            <div class="tpSpecIcon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
                <path d="M11 2l2.4 5.5H19l-4.7 3.4 1.8 5.7L11 13.2l-5.1 3.4 1.8-5.7L3 7.5h5.6L11 2z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="tpSpecContent">
              <div class="tpSpecValue">Max 4 Slots</div>
              <div class="tpSpecLabel">Limited Availability</div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ── LIVE VIEW ── -->
    <section class="tpSection tpSection--lv">
      <div class="tpWrap">

        <div class="lvHdr">
          <span class="tpEyebrow">Live View</span>
          <h2 class="lvTitle">See exactly where your brand appears.</h2>
          <p class="lvSub">Your creative, in context — this is how the <strong>Top-Billing Event Ticker</strong> placement looks to every GoDoDaytona Events Hub visitor.</p>
        </div>

        <div class="lvDevToggle" id="lvDevToggle">
          <button class="lvDevBtn lvDevBtn--on" data-target="mobile" aria-pressed="true">
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
              <rect x="2" y="1" width="9" height="11" rx="2" stroke="currentColor" stroke-width="1.4"/>
              <circle cx="6.5" cy="10" r=".8" fill="currentColor"/>
            </svg>
            Mobile
          </button>
          <button class="lvDevBtn" data-target="desktop" aria-pressed="false">
            <svg width="14" height="13" viewBox="0 0 14 13" fill="none" aria-hidden="true">
              <rect x="1" y="1" width="12" height="8" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
              <path d="M4.5 12h5M7 9v3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
            Desktop
          </button>
        </div>

        <div class="lvLayout">

          <div class="lvStage">

            <!-- ── MOBILE ── -->
            <div class="lvPhone" data-lvview="mobile">
              <div class="lvPhoneNotch"></div>
              <div class="lvPhoneScreen">
                <!-- site header -->
                <div class="lvSiteHdr">
                  <div class="lvLogo">G</div>
                  <span class="lvSiteName">Events Hub</span>
                </div>
                <!-- ★ TICKER — first element, above all content ★ -->
                <div class="lvTicker">
                  <div class="lvTickerBg" aria-hidden="true"></div>
                  <div class="lvTickerInner">
                    <div class="lvTickerDate">
                      <div class="lvTkMon">JUL</div>
                      <div class="lvTkDay">4</div>
                    </div>
                    <div class="lvTickerText">
                      <span class="lvTickerBadge">FEATURED</span>
                      <div class="lvTickerTitle">Your Event Here</div>
                    </div>
                    <div class="lvTickerCta">Details →</div>
                  </div>
                  <div class="lvDots">
                    <span class="lvDot lvDot--on"></span>
                    <span class="lvDot"></span>
                    <span class="lvDot"></span>
                  </div>
                </div>
                <!-- category filter pills — below the ticker -->
                <div class="lvFilterRow">
                  <span class="lvPill lvPill--on">All</span>
                  <span class="lvPill">Music</span>
                  <span class="lvPill">Arts</span>
                  <span class="lvPill">Sports</span>
                </div>
                <!-- event list rows — below filter -->
                <div class="lvEvRows">
                  <div class="lvEvRow"></div>
                  <div class="lvEvRow"></div>
                  <div class="lvEvRow"></div>
                </div>
              </div>
            </div>

            <!-- ── DESKTOP ── -->
            <div class="lvDesk" data-lvview="desktop" hidden>
              <div class="lvDeskBar">
                <div class="lvDeskDots">
                  <span class="lvDot--r"></span>
                  <span class="lvDot--y"></span>
                  <span class="lvDot--g"></span>
                </div>
                <div class="lvDeskUrl">gododaytona.com/daytona/events</div>
              </div>
              <div class="lvDeskSiteHdr">
                <div class="lvLogo lvLogo--sm">G</div>
                <span class="lvSiteName lvSiteName--desk">GoDoDaytona</span>
                <div class="lvNav">
                  <span>News</span><span>Dining</span><span class="lvNavActive">Events</span>
                </div>
              </div>
              <!-- ★ TICKER spanning full content width ★ -->
              <div class="lvDeskTicker">
                <div class="lvTickerBg" aria-hidden="true"></div>
                <div class="lvDeskTickerInner">
                  <div class="lvTickerDate lvTickerDate--sm">
                    <div class="lvTkMon">JUL</div>
                    <div class="lvTkDay">4</div>
                  </div>
                  <div class="lvTickerText">
                    <span class="lvTickerBadge">FEATURED</span>
                    <div class="lvTickerTitle">Your Event Here</div>
                  </div>
                  <div class="lvDeskTickerCta">See Details →</div>
                </div>
                <div class="lvDots lvDots--desk">
                  <span class="lvDot lvDot--on"></span>
                  <span class="lvDot"></span>
                  <span class="lvDot"></span>
                </div>
              </div>
              <!-- below ticker: filter + event rows + sidebar -->
              <div class="lvDeskBody">
                <div class="lvDeskMain">
                  <div class="lvDeskFilterRow">
                    <span class="lvPill lvPill--on lvPill--sm">All</span>
                    <span class="lvPill lvPill--sm">Music</span>
                    <span class="lvPill lvPill--sm">Sports</span>
                    <span class="lvPill lvPill--sm">Arts</span>
                  </div>
                  <div class="lvDeskEvRows">
                    <div class="lvEvRow"></div>
                    <div class="lvEvRow"></div>
                    <div class="lvEvRow lvEvRow--faint"></div>
                  </div>
                </div>
                <div class="lvDeskSidebar">
                  <div class="lvSkel lvSkel--full"></div>
                  <div class="lvSkel lvSkel--80"></div>
                  <div class="lvSkel lvSkel--60"></div>
                </div>
              </div>
            </div>

          </div>{/* /.lvStage */}

          <!-- annotation callouts -->
          <div class="lvAnnots">

            <div class="lvAnnot lvAnnot--primary">
              <div class="lvDot2 lvDot2--lg"></div>
              <div>
                <strong class="lvAnnotTitle">#1 above every other element</strong>
                <p class="lvAnnotBody">The ticker renders before GoDo Picks, before the category filters, and before every listing in the Daily Lineup — there is no higher position on this page.</p>
              </div>
            </div>

            <div class="lvAnnot">
              <div class="lvDot2"></div>
              <div>
                <strong class="lvAnnotTitle">Full-width, edge-to-edge carousel</strong>
                <p class="lvAnnotBody">Your event imagery fills 100% of the content column. No sidebar, no gutters, no competing creative — just your brand at full scale.</p>
              </div>
            </div>

            <div class="lvAnnot">
              <div class="lvDot2"></div>
              <div>
                <strong class="lvAnnotTitle">Category filters can't move it</strong>
                <p class="lvAnnotBody">When a visitor switches to Music, Sports, or any other filter, the ticker stays locked at the top — it renders completely outside the filtered zone.</p>
              </div>
            </div>

          </div>{/* /.lvAnnots */}

        </div>{/* /.lvLayout */}
      </div>
    </section>

    <!-- ── WHAT YOU GET ── -->
    <section class="tpSection" id="how-it-works">
      <div class="tpWrap">
        <div class="tpSectionHead">
          <span class="tpEyebrow">The Placement</span>
          <h2 class="tpSectionTitle">Built for maximum first-impression impact.</h2>
        </div>
        <div class="tpDescGrid">

          <div class="tpDescBlock">
            <div class="tpDescIcon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <rect x="1" y="3" width="22" height="16" rx="3" stroke="currentColor" stroke-width="1.8"/>
                <rect x="1" y="3" width="22" height="16" rx="3" fill="currentColor" opacity=".05"/>
                <path d="M5 11h14M9 7l-3 4 3 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="18" cy="8" r="2" fill="currentColor" opacity=".6"/>
                <circle cx="18" cy="14" r="2" fill="currentColor" opacity=".3"/>
              </svg>
            </div>
            <h3 class="tpDescTitle">#1 Position on the Page</h3>
            <p class="tpDescText">The Top-Billing Ticker is the absolute first layout element inside the Events Hub main content area — above the GoDo Picks editorial row, above the Daily Lineup, above every filter, every category tab, and every other sponsored unit on the page. There is no higher-visibility placement on GoDoDaytona's events experience.</p>
          </div>

          <div class="tpDescBlock">
            <div class="tpDescIcon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <rect x="2" y="4" width="20" height="14" rx="3" stroke="currentColor" stroke-width="1.8"/>
                <path d="M8 18v3M16 18v3M5 21h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                <path d="M7 11h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity=".4"/>
                <circle cx="7" cy="18" r="1.2" fill="currentColor" opacity=".7"/>
                <circle cx="12" cy="18" r="1.2" fill="currentColor" opacity=".35"/>
                <circle cx="17" cy="18" r="1.2" fill="currentColor" opacity=".2"/>
              </svg>
            </div>
            <h3 class="tpDescTitle">Auto-Cycling Immersive Carousel</h3>
            <p class="tpDescText">The ticker displays full-width event cards that auto-advance every 4.5 seconds using smooth client-side CSS opacity fade transitions. Dot navigation lets readers browse manually. The carousel pauses on hover so engaged visitors always have time to read before the next slide appears. Up to 4 featured events share the rotation — your slot is never hidden, never buried, and cycles back continuously for the entire session.</p>
          </div>

          <div class="tpDescBlock">
            <div class="tpDescIcon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M12 2l3 7h7l-5.7 4.1 2.2 6.9L12 16l-6.5 4 2.2-6.9L2 9h7L12 2z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3 class="tpDescTitle">Raw API Override — Your Event Leads</h3>
            <p class="tpDescText">GoDoDaytona's Events Hub fetches live event data from a backend engine that aggregates Ticketmaster, Eventbrite, and CitySpark. Normally, that algorithmic stream determines what ranks first. When your event is active in the Top-Billing Ticker, it is injected at the absolute front of the combined array — before the engine data is even processed — so your event leads the page regardless of what the API returns. No algorithm. No competition. Your event, first.</p>
          </div>

          <div class="tpDescBlock">
            <div class="tpDescIcon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" stroke="currentColor" stroke-width="1.8"/>
                <circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="1.6"/>
              </svg>
            </div>
            <h3 class="tpDescTitle">Across All Views &amp; Category Filters</h3>
            <p class="tpDescText">The ticker is rendered above the category filter UI and the pagination stack. Whether a visitor is browsing the full event feed, filtering by Music, Food &amp; Drink, or Arts, or loading more events via the "Load More" button — your ticker remains the first visible content element throughout the entire session. No filter can hide it; no scroll can push it away before it's seen.</p>
          </div>

        </div>
      </div>
    </section>

    <!-- ── MAP PIN INTEGRATION ── -->
    <section class="tpSection tpSection--map">
      <div class="tpWrap">
        <div class="tpMapInner">

          <div class="tpMapText">
            <span class="tpMapBadge">Included at $500/wk</span>
            <h2 class="tpMapTitle">Interactive Map Placement &amp; Branded Pin</h2>
            <p class="tpMapDesc">Every Top-Billing Ticker purchase automatically activates your business on our regional interactive event and guide maps — a premium geographic presence layer that runs 24/7 for the full duration of your weekly campaign.</p>

            <ul class="tpMapBullets">
              <li>
                <span class="tpMapCheck" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2.5 7L5.5 10L11.5 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <div>
                  <strong>24/7 Map Visibility</strong> — Your business is pinned directly onto our regional event and guide maps with a high-contrast branded marker, visible on every map interaction across the site.
                </div>
              </li>
              <li>
                <span class="tpMapCheck" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2.5 7L5.5 10L11.5 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <div>
                  <strong>Pulsing Radar Animation</strong> — Premium map markers feature an eye-catching animated radar pulse that draws the user's gaze naturally during map scans, making your pin impossible to overlook in a crowded event area.
                </div>
              </li>
              <li>
                <span class="tpMapCheck" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2.5 7L5.5 10L11.5 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <div>
                  <strong>Custom Brand Tailoring</strong> — Upgrade to feature your venue logo or custom thumbnail floating inside our high-contrast GoDo brand frame. Available at no extra charge for verified local businesses.
                </div>
              </li>
              <li>
                <span class="tpMapCheck" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2.5 7L5.5 10L11.5 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <div>
                  <strong>Runs Across All City Maps</strong> — Event maps, guide maps, and neighborhood maps across the Daytona Beach metro — the same map users consult before deciding where to go.
                </div>
              </li>
            </ul>
          </div>

          <div class="tpMapDiagram" aria-hidden="true">
            <div class="tpMapMockBg">
              <div class="tpMapGrid">
                <div class="tpMapLine tpMapLine--h" style="top: 30%"></div>
                <div class="tpMapLine tpMapLine--h" style="top: 60%"></div>
                <div class="tpMapLine tpMapLine--v" style="left: 35%"></div>
                <div class="tpMapLine tpMapLine--v" style="left: 70%"></div>
              </div>
              <div class="tpMapPin">
                <div class="tpMapPulse tpMapPulse--1"></div>
                <div class="tpMapPulse tpMapPulse--2"></div>
                <div class="tpMapPinCore">
                  <span class="tpMapStar">★</span>
                </div>
              </div>
              <div class="tpMapCallout">
                <span class="tpMapCalloutDot"></span>
                <span>Your Brand · Open Now</span>
              </div>
            </div>
            <span class="tpMapCaption">Live Interactive Map Pin Preview</span>
          </div>

        </div>
      </div>
    </section>

    <!-- ── PRICING + CTA ── -->
    <section class="tpSection tpSection--pricing">
      <div class="tpWrap">
        <div class="tpPricingBox">
          <div class="tpPricingLeft">
            <span class="tpPricingEyebrow">Weekly Investment</span>
            <div class="tpPricingAmount">$500 <span class="tpPricingUnit">/ week</span></div>
            <p class="tpPricingNote">Includes Interactive Map Placement &amp; Branded Pin. Billed weekly. Cancel any time. Minimum 1-week run.</p>
          </div>
          <div class="tpPricingRight">
            <ul class="tpPricingChecklist">
              <li>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7l3.5 3.5 6.5-6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                #1 placement — above the entire Events Hub
              </li>
              <li>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7l3.5 3.5 6.5-6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Full-width auto-cycling carousel, 4.5-second rotation
              </li>
              <li>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7l3.5 3.5 6.5-6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Raw API feed override — you always rank first
              </li>
              <li>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7l3.5 3.5 6.5-6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Persists across all category filters &amp; pagination
              </li>
              <li>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7l3.5 3.5 6.5-6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Interactive Map Pin with pulsing radar animation
              </li>
              <li>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7l3.5 3.5 6.5-6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                76k+ monthly local impressions
              </li>
            </ul>
            <a href="/daytona/advertise/#contact" class="tpPricingCta">Reserve My Slot →</a>
            <p class="tpPricingScarcity">
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><circle cx="5" cy="5" r="4" fill="#ef4444"/></svg>
              Max 4 slots available — limited weekly
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── BACK LINK ── -->
    <div class="tpBack">
      <div class="tpWrap">
        <a href="/daytona/advertise/#self-service" class="tpBackLink">← View all ad products</a>
      </div>
    </div>

  </div>

</Base>

<style>
  :root {
    --tp-brand: var(--brand1, #0077be);
    --tp-dark: #080c18;
    --tp-card: rgba(255,255,255,.04);
    --tp-border: rgba(255,255,255,.10);
  }

  /* ── Breadcrumb ── */
  .ppBreadcrumb { padding: 14px 0; border-bottom: 1px solid var(--tp-border); }
  .ppWrap, .tpWrap { max-width: 1160px; margin: 0 auto; padding: 0 2rem; }
  @media (max-width: 640px) { .ppWrap, .tpWrap { padding: 0 1.25rem; } }
  .ppBreadcrumb .ppWrap { display: flex; align-items: center; gap: 8px; font-size: 13px; opacity: .65; }
  .ppBreadcrumb a { color: inherit; text-decoration: none; }
  .ppBreadcrumb a:hover { opacity: 1; text-decoration: underline; }

  /* ── Hero ── */
  .tpHero {
    position: relative;
    background: linear-gradient(135deg, #05101f 0%, #0b1835 40%, #0e2244 100%);
    padding: 72px 0 60px;
    overflow: hidden;
  }
  .tpHeroOverlay {
    position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(ellipse 90% 80% at 70% 50%, rgba(0,119,190,.12) 0%, transparent 70%);
  }
  .tpHeroInner {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: 1fr 280px;
    gap: 48px; align-items: center;
  }
  @media (max-width: 900px) { .tpHeroInner { grid-template-columns: 1fr; } }
  .tpHeroEyebrow {
    font-size: 11px; font-weight: 900; letter-spacing: .14em; text-transform: uppercase;
    color: var(--tp-brand); margin: 0 0 12px;
