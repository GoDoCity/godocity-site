<script is:inline>
(function () {
  var toggle = document.getElementById("lvDevToggle");
  if (!toggle) return;
  toggle.addEventListener("click", function (e) {
    var btn = e.target.closest(".lvDevBtn");
    if (!btn) return;
    toggle.querySelectorAll(".lvDevBtn").forEach(function (b) {
      b.classList.toggle("lvDevBtn--on", b === btn);
      b.setAttribute("aria-pressed", b === btn ? "true" : "false");
    });
    var target = btn.getAttribute("data-target");
    document.querySelectorAll("[data-lvview]").forEach(function (el) {
      el.hidden = el.getAttribute("data-lvview") !== target;
    });
  });
})();
</script>
