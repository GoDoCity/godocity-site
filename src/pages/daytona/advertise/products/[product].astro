---
import Base from "../../../../layouts/Base.astro";

interface Product {
  slug: string;
  name: string;
  subtitle: string;
  valueHook: string;
  badge?: string;
  specs: { reach: string; placement: string; leadTime: string };
  description: string[];
  mockupType: string;
  startingAt: string;
  startingUnit: string;
}

export function getStaticPaths() {
  const PRODUCTS: {
    slug: string; name: string; subtitle: string; valueHook: string;
    badge?: string;
    specs: { reach: string; placement: string; leadTime: string };
    description: string[]; mockupType: string; startingAt: string; startingUnit: string;
  }[] = [
    {
      slug: "daily-mention",
      name: "The Daily Mention",
      subtitle: "Newsletter Text Ad",
      valueHook: "Seamlessly integrate your brand into the morning routine Daytona trusts.",
      badge: "Most Accessible",
      specs: {
        reach: "5,000+ Subscribers",
        placement: "Morning Inbox",
        leadTime: "3 Business Days",
      },
      description: [
        "The Daily Mention is the most native placement in the GoDoDaytona newsletter — a single, well-crafted line of text embedded directly in the editorial body of our weekday morning briefing. No banner blindness. No skipped scrolls. Just your name, your offer, and a link, sitting exactly where readers are already paying attention.",
        "Our subscribers open this email because they trust what's inside. The Daily Mention borrows that trust completely. It reads the way a local recommendation feels: organic, relevant, and frictionless. For the business owner who wants to be part of the conversation rather than interrupting it, this is the right starting point.",
        "Flexible enough to run once or every day of the week. Ideal for event promotions, limited-time offers, new business announcements, and any brand that wants to stay top-of-mind in the Daytona community without a large creative budget.",
      ],
      mockupType: "email-text",
      startingAt: "$150",
      startingUnit: "per insertion",
    },
    {
      slug: "top-line",
      name: "The Top Line",
      subtitle: "Email Header Ad",
      valueHook: "Command immediate attention as the first brand our readers see every morning.",
      badge: "Highest Visibility",
      specs: {
        reach: "5,000+ Subscribers",
        placement: "Email Header — First Seen",
        leadTime: "5 Business Days",
      },
      description: [
        "The Top Line occupies the single most valuable position in the entire morning briefing: the full-width creative slot that renders the moment the email opens. Before any headline, any story, any editorial content — readers see your brand. That window is measured in seconds, and this placement owns every one of them.",
        "At 600×200 px, it's large enough to make a statement and clean enough to feel editorial. Supply your image and headline; our team handles formatting, testing, and delivery. The placement is limited to one advertiser per send date, which means on the day you run, you're the only brand that matters.",
        "Best deployed for grand openings, seasonal campaigns, new location announcements, and moments when visibility is the entire strategy. If you need Daytona to notice you today, this is how.",
      ],
      mockupType: "email-header",
      startingAt: "$275",
      startingUnit: "per insertion",
    },
    {
      slug: "anchor",
      name: "The Anchor",
      subtitle: "Email Banner Ad",
      valueHook: "High-impact visual placement positioned in the heart of our daily conversation.",
      specs: {
        reach: "5,000+ Subscribers",
        placement: "Mid-Email — After Lead Story",
        leadTime: "3 Business Days",
      },
      description: [
        "The Anchor runs between editorial sections, right after our lead story — the point in the briefing where readers who are engaged have confirmed they're staying. They didn't open and close. They read the first story. Now they're seeing your brand.",
        "At 600×150 px, it's a clean, horizontal format that renders consistently across every major email client, on desktop and mobile alike. Its position mid-scroll makes it a natural resting point in the reading experience — not an interruption, but a pause. A moment where a well-timed offer from a local business feels like a good idea.",
        "The Anchor is the workhorse of the newsletter lineup. It performs reliably across industries, pairs well with promotional offers, and is available as a one-time run or on a recurring schedule. For businesses that want sustained presence without the premium price of the header slot, this is the play.",
      ],
      mockupType: "email-banner",
      startingAt: "$175",
      startingUnit: "per insertion",
    },
    {
      slug: "high-impact-showcase",
      name: "The High-Impact Showcase",
      subtitle: "Premium Email Banner Ad",
      valueHook: "Large-format storytelling designed for maximum brand recall.",
      badge: "Maximum Format",
      specs: {
        reach: "5,000+ Subscribers",
        placement: "Premium Mid-Email — Below Lead Story",
        leadTime: "5 Business Days",
      },
      description: [
        "The High-Impact Showcase is the largest single creative unit in the newsletter — a 600×300 px full-bleed image positioned just below the lead editorial section, where readers linger longest. It's not a banner; it's a canvas. Room for a hero photograph, a lifestyle image, a visual identity statement that goes beyond a tagline.",
        "This placement is exclusive by design. Only one brand runs it per send date. No adjacent ads, no competing creative, no shared attention. Your image occupies the entire viewport of the most-read section of the most-opened local email in Daytona Beach.",
        "Plan your campaign in advance — dates at this tier fill weeks out. The investment reflects the exclusivity: this is the placement you book when the moment genuinely matters, and you need the entire local community to know about it.",
      ],
      mockupType: "email-premium",
      startingAt: "$350",
      startingUnit: "per insertion",
    },
    {
      slug: "local-spotlight",
      name: "The Local Spotlight",
      subtitle: "Mini Article",
      valueHook: "A concise, powerful feature that puts your business front-and-center.",
      specs: {
        reach: "10,000+ Monthly Readers",
        placement: "Editorial Content Stream",
        leadTime: "5 Business Days",
      },
      description: [
        "The Local Spotlight is a 100–150 word branded story published on GoDoDaytona.com — written in our editorial voice, shaped around your message, and dropped into the same content stream where locals discover new restaurants, upcoming events, and neighborhood news. It reads like journalism because it's crafted like journalism.",
        "Unlike a display ad, this placement earns its position in organic search. It carries your business name, your value statement, and a clear call to action, and it stays on the site indefinitely — accumulating traffic, clicks, and credibility long after the campaign ends. A banner disappears when the run date passes. A Local Spotlight keeps working.",
        "Ideal for new openings, seasonal offers, event announcements, and any brand that has something worth saying but not a full editorial budget to say it. Fast turnaround, GoDo voice, lasting local reach.",
      ],
      mockupType: "article-mini",
      startingAt: "$325",
      startingUnit: "per article",
    },
    {
      slug: "deep-dive",
      name: "The Deep Dive",
      subtitle: "Feature Article",
      badge: "Best for Authority",
      valueHook: "Your brand's full story, told through premium editorial that builds lasting community trust.",
      specs: {
        reach: "10,000+ Monthly Readers",
        placement: "Featured Editorial — With Social Amplification",
        leadTime: "7 Business Days",
      },
      description: [
        "The Deep Dive is a full-length editorial story — 400 to 600 words — researched, written, and published by the GoDo editorial team, built entirely around your brand. Think neighborhood spotlights, business origin stories, 'best of Daytona' features, event previews with deep local context. Content that your customers want to read and your competitors can't replicate.",
        "Every Deep Dive is search-optimized from the first keystroke. We target the longtail keywords your customers actually type — 'best seafood on the Halifax River,' 'top general contractors Ormond Beach' — and we build the article to rank for months. The content carries a clear 'Sponsored' designation per our editorial standards, but the quality is indistinguishable from our organic work. Readers engage with it as a story, not an ad.",
        "You review the draft before it publishes. Approved pieces are promoted across our social channels and included in the newsletter on launch day, giving you a coordinated moment of local visibility that no banner can replicate. This is how you build lasting local authority.",
      ],
      mockupType: "article-feature",
      startingAt: "$850",
      startingUnit: "per article",
    },
    {
      slug: "local-feed",
      name: "The Local Feed",
      subtitle: "Social Feed Post",
      valueHook: "Extend your reach into the social flow of Daytona's most active locals.",
      specs: {
        reach: "10,000+ Followers",
        placement: "Instagram & Facebook Feed",
        leadTime: "3 Business Days",
      },
      description: [
        "The Local Feed is a dedicated, purpose-built post published natively to GoDoDaytona's Instagram and Facebook accounts. Our audience follows us because we surface Daytona's best — the spots worth visiting, the events worth attending, the businesses worth knowing. When your brand appears in that feed, it's introduced as exactly that kind of discovery.",
        "We write the caption in the GoDo editorial voice, design or format your creative to match our feed aesthetic, and publish at peak engagement hours for the Volusia County market. The post tags your account directly, links to your booking page or website, and can be paired with paid social boosting for extended reach into targeted Daytona demographics.",
        "One post. Two platforms. An audience that has already opted in to local recommendations. This format works especially well for food, retail, events, and any visual business that benefits from a strong image moment placed in front of people who are actively looking to spend locally.",
      ],
      mockupType: "social",
      startingAt: "$225",
      startingUnit: "per post",
    },
    {
      slug: "market-takeover",
      name: "The Market Takeover",
      subtitle: "Digital Display Bundle",
      badge: "Full Omnichannel",
      valueHook: "Complete digital dominance across all GoDoDaytona channels for maximum saturation.",
      specs: {
        reach: "25,000+ Monthly Pageviews",
        placement: "Run-of-Site: Leaderboard + Sidebar + In-Feed",
        leadTime: "5 Business Days",
      },
      description: [
        "The Market Takeover puts your brand in three simultaneous positions across GoDoDaytona.com: the leaderboard above every article, the sidebar alongside it, and an in-feed unit between editorial blocks. No matter what a reader clicks, what section they visit, or what story they follow — your creative is there. That is not exposure; it is presence.",
        "Choose run-of-site distribution to reach the full breadth of our local audience, or select a specific category — Food & Drink, Real Estate, Events — for tighter contextual alignment with your customer. Both options include real-time impression reporting so your team can see exactly what's working and make mid-campaign adjustments.",
        "Creative updates between weekly cycles are included at no additional charge. This bundle delivers the highest volume of local digital impressions available on GoDoDaytona.com, at the lowest effective cost-per-impression of any placement we offer. For brands that want to own the Daytona conversation, this is the package that makes it happen.",
      ],
      mockupType: "display",
      startingAt: "$550",
      startingUnit: "per week",
    },
  ];

  return PRODUCTS.map((p) => ({ params: { product: p.slug }, props: { product: p } }));
}

const { product } = Astro.props as { product: Product };
---

<Base
  title={`${product.name} | GoDoDaytona Advertising`}
  subtitle={product.valueHook}
  cityBase="daytona"
>

  <!-- ── BREADCRUMB ── -->
  <nav class="ppBreadcrumb" aria-label="Breadcrumb">
    <div class="ppWrap">
      <a href="/daytona/advertise/">Advertise</a>
      <span aria-hidden="true">›</span>
      <a href="/daytona/advertise/#self-service">All Products</a>
      <span aria-hidden="true">›</span>
      <span>{product.name}</span>
    </div>
  </nav>

  <!-- ── HERO ── -->
  <section class="ppHero">
    <div class="ppHeroOverlay" aria-hidden="true"></div>
    <div class="ppWrap ppHeroInner">
      <div class="ppHeroLeft">
        <p class="ppHeroEyebrow">{product.subtitle}</p>
        {product.badge && <span class="ppHeroBadge">{product.badge}</span>}
        <h1 class="ppHeroTitle">{product.name}</h1>
        <p class="ppHeroHook">{product.valueHook}</p>
        <div class="ppHeroCtas">
          <a href="/daytona/advertise/#contact" class="ppBtnWhite">Check Availability</a>
          <a href="#live-view" class="ppBtnGhost">See the Placement ↓</a>
        </div>
      </div>
      <div class="ppHeroRight" aria-hidden="true">
        <div class="ppHeroStats">
          <div class="ppHeroStat">
            <span class="ppHeroStatNum">{product.specs.reach.split(' ')[0]}</span>
            <span class="ppHeroStatLabel">{product.specs.reach.split(' ').slice(1).join(' ')}</span>
          </div>
          <div class="ppHeroStatDivider"></div>
          <div class="ppHeroStat">
            <span class="ppHeroStatNum">{product.startingAt}</span>
            <span class="ppHeroStatLabel">{product.startingUnit}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="ppBody">

    <!-- ── MARKET SELECTOR BAR ── -->
    <div class="ppMarketBar">
      <div class="ppWrap ppMarketBarInner">
        <span class="ppMarketBarLabel">Viewing rates for</span>
        <details class="ppMarketSelect">
          <summary class="ppMarketSelectTrigger">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.5"/>
              <path d="M7 3.5v3.5l2 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            Daytona Beach, FL
            <svg class="ppChevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </summary>
          <div class="ppMarketDropdown">
            <div class="ppMarketOption ppMarketOption--active">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              Daytona Beach, FL
            </div>
            <div class="ppMarketComingSoon">More markets coming soon</div>
          </div>
        </details>
      </div>
    </div>

    <!-- ── EFFICIENCY SPECS ── -->
    <section class="ppSection ppSection--specs">
      <div class="ppWrap">
        <div class="ppSpecsRow">

          <div class="ppSpecCard">
            <div class="ppSpecIcon ppSpecIcon--reach" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
                <circle cx="11" cy="11" r="9" stroke="currentColor" stroke-width="1.8"/>
                <circle cx="11" cy="11" r="5" stroke="currentColor" stroke-width="1.8"/>
                <circle cx="11" cy="11" r="1.5" fill="currentColor"/>
              </svg>
            </div>
            <div class="ppSpecContent">
              <div class="ppSpecValue">{product.specs.reach}</div>
              <div class="ppSpecLabel">Reach</div>
            </div>
          </div>

          <div class="ppSpecCard">
            <div class="ppSpecIcon ppSpecIcon--placement" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
                <rect x="2" y="3" width="18" height="14" rx="3" stroke="currentColor" stroke-width="1.8"/>
                <path d="M2 8h18" stroke="currentColor" stroke-width="1.8"/>
                <rect x="5" y="11" width="5" height="3" rx="1" fill="currentColor" opacity=".35"/>
              </svg>
            </div>
            <div class="ppSpecContent">
              <div class="ppSpecValue">{product.specs.placement}</div>
              <div class="ppSpecLabel">Placement</div>
            </div>
          </div>

          <div class="ppSpecCard">
            <div class="ppSpecIcon ppSpecIcon--lead" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
                <circle cx="11" cy="11" r="9" stroke="currentColor" stroke-width="1.8"/>
                <path d="M11 6v5l3.5 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="ppSpecContent">
              <div class="ppSpecValue">{product.specs.leadTime}</div>
              <div class="ppSpecLabel">Lead Time</div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ── LIVE VIEW MOCKUP ── -->
    <section class="ppSection ppSection--mockup" id="live-view">
      <div class="ppWrap">
        <div class="ppMockupHeader">
          <span class="ppMockupEyebrow">Live View</span>
          <h2 class="ppMockupTitle">See exactly where your brand appears.</h2>
          <p class="ppMockupSub">Your creative, in context — this is how the <strong>{product.subtitle}</strong> placement looks to our Daytona audience.</p>
        </div>

        {/* Device toggle — shown for email-header, email-premium, and display */}
        {(product.mockupType === "email-header" || product.mockupType === "email-premium" || product.mockupType === "display") && (
          <div class="ppDeviceToggle" id="ppDevToggle">
            <button class="ppDevBtn ppDevBtn--on" data-target="mobile" aria-pressed="true">
              <svg width="12" height="14" viewBox="0 0 12 14" fill="none" aria-hidden="true">
                <rect x="1" y="0.5" width="10" height="13" rx="2.5" stroke="currentColor" stroke-width="1.5"/>
                <rect x="4" y="11" width="4" height="1" rx=".5" fill="currentColor"/>
              </svg>
              Mobile
            </button>
            <button class="ppDevBtn" data-target="desktop" aria-pressed="false">
              <svg width="15" height="12" viewBox="0 0 15 12" fill="none" aria-hidden="true">
                <rect x="1" y="1" width="13" height="8" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
                <path d="M5.5 9v2m4-2v2M3 11h9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              Desktop
            </button>
          </div>
        )}

        <div class="ppLiveViewLayout">
          {/* ─── MOCKUP STAGE ─── */}
          <div class="ppMockupStage">

            {/* ══ THE DAILY MENTION — email-text ══ */}
            {product.mockupType === "email-text" && (
              <div class="ppPhoneShell">
                <div class="ppPhoneNotch"></div>
                <div class="ppPhoneScreen ppNLScreen">
                  <div class="ppNLHead">
                    <div class="ppNLLogo" aria-hidden="true">G</div>
                    <div class="ppNLTitleGroup">
                      <span class="ppNLName">GoDoDaytona</span>
                      <span class="ppNLSub">Your Morning Briefing</span>
                    </div>
                    <span class="ppNLDate">Mon, May 12</span>
                  </div>
                  <div class="ppNLBar"></div>
                  <div class="ppNLStory">
                    <span class="ppNLCat">DAYTONA TODAY</span>
                    <div class="ppNLHL">Beachside Market Expansion Draws Record Summer Crowds to Main Street</div>
                    <div class="ppSkel ppSkel--90 ppSkel--xs" style="margin-top:4px"></div>
                    <div class="ppSkel ppSkel--80 ppSkel--xs"></div>
                    <div class="ppSkel ppSkel--65 ppSkel--xs"></div>
                  </div>
                  <div class="ppAdZone ppAdZone--nlText">
                    <span class="ppSponsorTag">SPONSORED</span>
                    <p class="ppNLTextMention">
                      <strong class="ppNLTextBiz">Your Business Name</strong>
                      <span class="ppNLTextMsg"> — Your offer in one compelling sentence that feels like a natural recommendation.</span>
                      <a class="ppNLTextLink">Learn more →</a>
                    </p>
                    <div class="ppAdBadge">YOUR BRAND HERE</div>
                  </div>
                  <div class="ppNLStory ppNLStory--sm">
                    <span class="ppNLCat">COMMUNITY</span>
                    <div class="ppNLHL ppNLHL--sm">Volusia Arts Week Returns with 40+ Local Events Citywide</div>
                    <div class="ppSkel ppSkel--80 ppSkel--xs" style="margin-top:3px"></div>
                  </div>
                </div>
              </div>
            )}

            {/* ══ THE TOP LINE — email-header ══ */}
            {product.mockupType === "email-header" && (
              <div class="ppDualView">
                {/* MOBILE */}
                <div class="ppPhoneShell" data-view="mobile">
                  <div class="ppPhoneNotch"></div>
                  <div class="ppPhoneScreen ppNLScreen">
                    <div class="ppNLHead">
                      <div class="ppNLLogo" aria-hidden="true">G</div>
                      <div class="ppNLTitleGroup">
                        <span class="ppNLName">GoDoDaytona</span>
                        <span class="ppNLSub">Morning Briefing</span>
                      </div>
                    </div>
                    <div class="ppNLBar"></div>
                    <div class="ppAdZone ppAdZone--nlHeader">
                      <span class="ppSponsorTag ppSponsorTag--top">PRESENTING PARTNER</span>
                      <div class="ppNLHeaderImg">
                        <div class="ppAdBadge">YOUR BRAND HERE</div>
                      </div>
                    </div>
                    <div class="ppNLStory ppNLStory--sm" style="margin-top:8px">
                      <span class="ppNLCat">DAYTONA TODAY</span>
                      <div class="ppNLHL ppNLHL--sm">Beachside Market Expansion Draws Record Summer Crowds</div>
                      <div class="ppSkel ppSkel--85 ppSkel--xs" style="margin-top:3px"></div>
                      <div class="ppSkel ppSkel--65 ppSkel--xs"></div>
                    </div>
                  </div>
                </div>
                {/* DESKTOP */}
                <div class="ppDesktopShell" data-view="desktop" hidden>
                  <div class="ppDesktopBar">
                    <div class="ppBrowserDots"><span></span><span></span><span></span></div>
                    <div class="ppDesktopUrl">mail.google.com · GoDoDaytona Morning Briefing</div>
                  </div>
                  <div class="ppDesktopMeta">
                    <span class="ppDMFrom"><strong>From:</strong> GoDoDaytona &lt;hello@gododaytona.com&gt;</span>
                    <span class="ppDMSubj"><strong>Subject:</strong> Your Daytona Briefing — Monday, May 12</span>
                  </div>
                  <div class="ppDesktopNL">
                    <div class="ppNLHead ppNLHead--wide">
                      <div class="ppNLLogo" aria-hidden="true">G</div>
                      <div class="ppNLTitleGroup">
                        <span class="ppNLName">GoDoDaytona</span>
                        <span class="ppNLSub">Your Morning Briefing</span>
                      </div>
                      <span class="ppNLDate">Mon, May 12</span>
                    </div>
                    <div class="ppNLBar"></div>
                    <div class="ppAdZone ppAdZone--nlHeaderDesk">
                      <span class="ppSponsorTag ppSponsorTag--top">PRESENTING PARTNER</span>
                      <div class="ppNLHeaderImgDesk">
                        <div class="ppAdBadge">YOUR BRAND HERE</div>
                      </div>
                    </div>
                    <div class="ppDesktopStory">
                      <span class="ppNLCat">DAYTONA TODAY</span>
                      <div class="ppNLHL ppNLHL--desk">Beachside Market Expansion Draws Record Summer Crowds to Main Street District</div>
                      <div class="ppSkel ppSkel--90 ppSkel--xs" style="margin-top:4px"></div>
                      <div class="ppSkel ppSkel--75 ppSkel--xs"></div>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {/* ══ THE ANCHOR — email-banner ══ */}
            {product.mockupType === "email-banner" && (
              <div class="ppPhoneShell">
                <div class="ppPhoneNotch"></div>
                <div class="ppPhoneScreen ppNLScreen">
                  <div class="ppNLHead">
                    <div class="ppNLLogo" aria-hidden="true">G</div>
                    <div class="ppNLTitleGroup">
                      <span class="ppNLName">GoDoDaytona</span>
                      <span class="ppNLSub">Morning Briefing</span>
                    </div>
                    <span class="ppNLDate">Mon, May 12</span>
                  </div>
                  <div class="ppNLBar"></div>
                  <div class="ppNLStory">
                    <span class="ppNLCat">DAYTONA TODAY</span>
                    <div class="ppNLHL">Beachside Market Draws Record Crowds to Main Street</div>
                    <div class="ppSkel ppSkel--90 ppSkel--xs" style="margin-top:4px"></div>
                    <div class="ppSkel ppSkel--80 ppSkel--xs"></div>
                    <div class="ppSkel ppSkel--70 ppSkel--xs"></div>
                    <span class="ppNLReadMore">Read more →</span>
                  </div>
                  <div class="ppAdZone ppAdZone--nlBanner">
                    <span class="ppSponsorTag">SPONSORED</span>
                    <div class="ppNLBannerImg">
                      <div class="ppAdBadge">YOUR BRAND HERE</div>
                    </div>
                  </div>
                  <div class="ppNLStory ppNLStory--sm">
                    <span class="ppNLCat">COMMUNITY</span>
                    <div class="ppNLHL ppNLHL--sm">Volusia Arts Week Returns with 40+ Local Events</div>
                    <div class="ppSkel ppSkel--75 ppSkel--xs" style="margin-top:3px"></div>
                  </div>
                </div>
              </div>
            )}

            {/* ══ THE HIGH-IMPACT SHOWCASE — email-premium ══ */}
            {product.mockupType === "email-premium" && (
              <div class="ppDualView">
                {/* MOBILE */}
                <div class="ppPhoneShell" data-view="mobile">
                  <div class="ppPhoneNotch"></div>
                  <div class="ppPhoneScreen ppNLScreen">
                    <div class="ppNLHead">
                      <div class="ppNLLogo" aria-hidden="true">G</div>
                      <div class="ppNLTitleGroup">
                        <span class="ppNLName">GoDoDaytona</span>
                        <span class="ppNLSub">Morning Briefing</span>
                      </div>
                    </div>
                    <div class="ppNLBar"></div>
                    <div class="ppNLStory ppNLStory--sm">
                      <span class="ppNLCat">DAYTONA TODAY</span>
                      <div class="ppNLHL ppNLHL--sm">Beachside Market Draws Summer Crowds</div>
                      <div class="ppSkel ppSkel--80 ppSkel--xs" style="margin-top:3px"></div>
                    </div>
                    <div class="ppAdZone ppAdZone--nlPremium">
                      <span class="ppPremiumTag">PREMIUM PARTNER</span>
                      <div class="ppNLPremiumImg">
                        <div class="ppAdBadge">YOUR BRAND HERE</div>
                        <div class="ppPremiumSize">600 × 300 px</div>
