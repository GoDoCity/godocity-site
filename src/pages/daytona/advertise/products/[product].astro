<script>
  const toggle = document.getElementById('ppDevToggle');
  if (toggle) {
    toggle.addEventListener('click', (e: Event) => {
      const btn = (e.target as Element).closest('.ppDevBtn') as HTMLElement | null;
      if (!btn) return;
      const target = btn.dataset.target;
      toggle.querySelectorAll<HTMLElement>('.ppDevBtn').forEach(b => {
        b.classList.toggle('ppDevBtn--on', b === btn);
        b.setAttribute('aria-pressed', String(b === btn));
      });
      const section = toggle.closest('.ppSection--mockup');
      if (!section) return;
      section.querySelectorAll<HTMLElement>('[data-view]').forEach(el => {
        el.hidden = el.dataset.view !== target;
      });
    });
  }
</script>
