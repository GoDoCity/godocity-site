<style>
  .lgWrap { max-width: 760px; margin: 0 auto; padding: 56px 2rem 96px; }
  @media (max-width: 600px) { .lgWrap { padding: 40px 1.25rem 72px; } }

  .lgBread {
    font-size: 13px; color: #888; margin-bottom: 32px;
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
  }
  .lgBread a { color: var(--brand1, #0077be); text-decoration: none; font-weight: 600; }
  .lgBread a:hover { text-decoration: underline; }
  .lgBread span[aria-hidden] { color: #ccc; }

  .lgEyebrow {
    display: block; font-size: 11px; font-weight: 900; letter-spacing: .16em;
    text-transform: uppercase; color: var(--brand1, #0077be); margin-bottom: 10px;
  }
  .lgTitle {
    font-size: clamp(28px, 5vw, 42px); font-weight: 900;
    letter-spacing: -0.025em; color: #111; margin: 0 0 16px; line-height: 1.1;
  }
  .lgMeta {
    font-size: 13px; color: #888; margin-bottom: 28px;
    display: flex; gap: 24px; flex-wrap: wrap;
  }
  .lgDivider { height: 1px; background: #e5e7eb; margin: 0 0 32px; }

  .lgNotice {
    background: color-mix(in srgb, var(--brand1, #0077be) 6%, white);
    border: 1px solid color-mix(in srgb, var(--brand1, #0077be) 20%, transparent);
    border-radius: 10px; padding: 16px 18px; margin-bottom: 32px;
  }
  .lgNotice p { margin: 0; font-size: 14px; line-height: 1.65; color: #333; }

  .lgToc {
    background: #f9f9fb; border: 1px solid #e5e7eb;
    border-radius: 12px; padding: 20px 24px; margin-bottom: 52px;
  }
  .lgTocTitle {
    font-size: 11px; font-weight: 900; letter-spacing: .12em;
    text-transform: uppercase; color: #888; margin: 0 0 14px;
  }
  .lgTocList {
    list-style: decimal; padding-left: 18px; margin: 0;
    display: flex; flex-direction: column; gap: 7px;
  }
  .lgTocList a { font-size: 13px; font-weight: 700; color: #333; text-decoration: none; }
  .lgTocList a:hover { color: var(--brand1, #0077be); text-decoration: underline; }

  .lgSection { margin-bottom: 52px; }
  .lgSection h2 {
    font-size: clamp(17px, 2.5vw, 21px); font-weight: 900;
    letter-spacing: -0.01em; color: #111;
    margin: 0 0 18px; padding-bottom: 10px;
    border-bottom: 2px solid var(--brand1, #0077be);
  }
  .lgSection h3 { font-size: 15px; font-weight: 800; color: #111; margin: 22px 0 8px; }
  .lgSection p { font-size: 15px; line-height: 1.78; color: #444; margin: 0 0 14px; }
  .lgSection p:last-child { margin-bottom: 0; }
  .lgSection ul, .lgSection ol { padding-left: 22px; margin: 0 0 16px; }
  .lgSection li { font-size: 15px; line-height: 1.72; color: #444; margin-bottom: 7px; }
  .lgSection a { color: var(--brand1, #0077be); text-decoration: underline; text-underline-offset: 2px; }
  .lgSection strong { color: #111; }

  @media print {
    .lgWrap { padding: 0; }
    .lgBread { display: none; }
  }
</style>
