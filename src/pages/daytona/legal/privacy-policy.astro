import LegalLayout from "../../../layouts/LegalLayout.astro";

const toc = [
  { id: "overview",      label: "Overview & Scope" },
  { id: "collection",    label: "Information We Collect" },
  { id: "use",           label: "How We Use Information" },
  { id: "sharing",       label: "How We Share Information" },
  { id: "cookies",       label: "Cookies & Tracking Technologies" },
  { id: "advertising",   label: "Advertising & Analytics" },
  { id: "retention",     label: "Data Retention" },
  { id: "security",      label: "Data Security" },
  { id: "children",      label: "Children's Privacy" },
  { id: "ccpa",          label: "California Rights (CCPA/CPRA)" },
  { id: "vcdpa",         label: "Virginia Rights (VCDPA)" },
