---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";
import ArticleSidebar from "../../../components/ArticleSidebar.astro";

/* Featured flag normalization */
function isFeatured(post) {
  const v = post?.data?.featured;
  if (v === true) return true;
  if (v === 1) return true;
  const s = String(v ?? "").toLowerCase().trim();
  return s === "true" || s === "yes" || s === "1";
}

/* Tag normalization */
function tagKey(raw) {
  return String(raw ?? "").toLowerCase().trim().replace(/[-_]+/g, " ").replace(/\s+/g, " ");
}
function tagSlugFromKey(key) {
  return String(key ?? "").toLowerCase().trim().replace(/&/g, "and").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
}
function tagLabelFromKey(key) {
  const s = String(key ?? "").trim().replace(/\s+/g, " ");
  if (!s) return "";
  return s.split(" ").filter(Boolean).map((w) => (w ? w.charAt(0).toUpperCase() + w.slice(1) : "")).join(" ");
}

/* Safe date getter */
function getPostDate(post) {
  return post?.data?.pubDate ?? post?.data?.date ?? post?.data?.published ?? post?.data?.updated ?? null;
}
function sortNewestFirst(a, b) {
  return new Date(getPostDate(b) ?? 0).getTime() - new Date(getPostDate(a) ?? 0).getTime();
}

/* Hero image field — checks all common frontmatter aliases */
const FALLBACK_IMG = "/images/old-mural-backup.png";
function heroImage(post) {
  const v = post?.data?.heroImage ?? post?.data?.heroimage ?? post?.data?.image ?? post?.data?.thumbnail ?? "";
  return String(v).trim() || FALLBACK_IMG;
}

/* Related posts */
const RELATED_LIMIT = 12;

function normalizeTags(post) {
  const raw = Array.isArray(post?.data?.tags) ? post.data.tags : [];
  return Array.from(new Set(raw.map(tagKey).filter(Boolean)));
}
function sharedTagScore(aKeys, bKeys) {
  if (!aKeys.length || !bKeys.length) return 0;
  const set = new Set(aKeys);
  let score = 0;
  for (const k of bKeys) if (set.has(k)) score++;
  return score;
}
function buildRelatedPosts(currentPost, allCityPosts) {
  const currentSlug = currentPost?.slug;
  const currentKeys = normalizeTags(currentPost);
  return allCityPosts
    .filter((p) => p?.slug && p.slug !== currentSlug)
    .map((p) => ({
      p,
      score: sharedTagScore(currentKeys, normalizeTags(p)),
      date: new Date(getPostDate(p) ?? 0).getTime(),
    }))
    .sort((a, b) => b.score !== a.score ? b.score - a.score : b.date - a.date)
    .slice(0, RELATED_LIMIT)
    .map((c) => c.p);
}

/* Build-safe getStaticPaths */
export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const daytonaPosts = posts
    .filter((post) => {
      const city = String(post?.data?.city ?? "daytona").toLowerCase().trim();
      if (city === "daytona") return true;
      return typeof post?.id === "string" && post.id.startsWith("daytona/");
    })
    .sort((a, b) => {
      const da = new Date(a?.data?.pubDate ?? a?.data?.date ?? a?.data?.published ?? a?.data?.updated ?? 0).getTime();
      const db = new Date(b?.data?.pubDate ?? b?.data?.date ?? b?.data?.published ?? b?.data?.updated ?? 0).getTime();
      return db - da;
    });
  return daytonaPosts.map((post) => {
    const parts = post.slug.split("/");
    const cleanSlug = parts.length > 1 && parts[0] === "daytona"
      ? parts.slice(1).join("/")
      : post.slug;
    return { params: { slug: cleanSlug }, props: { post } };
  });
}

/* Page data */
const { post } = Astro.props;
const title = post.data.title;
const subtitle = "Good news for Daytona";
const { Content } = await post.render();

const all = await getCollection("posts");
const daytonaPosts = all
  .filter((p) => {
    const city = String(p?.data?.city ?? "daytona").toLowerCase().trim();
    if (city === "daytona") return true;
    return typeof p?.id === "string" && p.id.startsWith("daytona/");
  })
  .sort(sortNewestFirst);

const rawTags = Array.isArray(post.data?.tags) ? post.data.tags : [];
const uniqueKeySet = new Set(rawTags.map(tagKey).filter(Boolean));
const tagItems = Array.from(uniqueKeySet).map((key) => ({
  key, label: tagLabelFromKey(key), slug: tagSlugFromKey(key),
}));

const relatedPosts = buildRelatedPosts(post, daytonaPosts);

const pub = getPostDate(post);
const pubText = pub
  ? new Date(pub).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })
  : "";
const featured = isFeatured(post);
const hero = heroImage(post);
/* ToC toggle — defaults on; authors disable per-post via Sveltia frontmatter */
const showTableOfContents = post.data.showTableOfContents !== false;
const author = typeof post.data.author === "string" && post.data.author.trim()
  ? post.data.author.trim() : "Charles King";
const authorSlug = author.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

const categoryRaw = typeof post.data.category === "string" && post.data.category.trim()
  ? post.data.category.trim()
  : rawTags[0] ?? "";
const categoryKey   = tagKey(categoryRaw);
const categorySlug  = tagSlugFromKey(categoryKey);
const categoryLabel = tagLabelFromKey(categoryKey).toUpperCase();

const subtopicRaw   = typeof post.data.subtopic === "string" ? post.data.subtopic.trim() : "";
const subtopicKey   = tagKey(subtopicRaw);
const subtopicSlug  = tagSlugFromKey(subtopicKey);
const subtopicLabel = tagLabelFromKey(subtopicKey).toUpperCase();

---

<Base title={title} subtitle={subtitle} cityBase="daytona">
  <section class="section">
    <div class="pageWrap">
      <div class="postLayout">

        <div class="postMain">
          {categoryLabel && (
            <div class="catKicker">
              <a class="catCrumb" href={`/daytona/${categorySlug}/`}>{categoryLabel}</a>
              {subtopicLabel && (
                <>
                  <span class="catDash" aria-hidden="true"> — </span>
                  <a class="catCrumb" href={`/daytona/${categorySlug}/${subtopicSlug}/`}>{subtopicLabel}</a>
                </>
              )}
            </div>
          )}
          <h1 class={`postTitle ${featured ? "isFeatured" : ""}`}>{title}</h1>

          <p class="byline">
            {pubText && <span class="bylineDate">{pubText}</span>}
            {pubText && <span class="bylineSep" aria-hidden="true"> | </span>}
            <a class="bylineAuthor" href={`/daytona/journalists/${authorSlug}/`}>{author}</a>
          </p>

          {post.data.description && (
            <p class="postDek">{post.data.description}</p>
          )}

          <figure class="heroFigure">
            <img class="heroFull" src={hero} alt={post.data.title ?? "Post image"} loading="eager" decoding="async"
              onerror={`this.src='${FALLBACK_IMG}';this.onerror=null;`} />
          </figure>

          <article class="postBody" id="post-body" data-toc={showTableOfContents ? "true" : "false"}>
            <Content />
          </article>

          {relatedPosts.length > 0 && (
            <div class="relatedWrap">
              <div class="relatedHeader">
                <h3 class="relatedHead">More Stories</h3>
                <div class="relatedArrows">
                  <button class="relatedBtn" aria-label="Scroll left" onclick="this.closest('.relatedWrap').querySelector('.relatedScroll').scrollBy({left:-300,behavior:'smooth'})">&#8592;</button>
                  <button class="relatedBtn" aria-label="Scroll right" onclick="this.closest('.relatedWrap').querySelector('.relatedScroll').scrollBy({left:300,behavior:'smooth'})">&#8594;</button>
                </div>
              </div>
              <div class="relatedScroll">
                {relatedPosts.map((p) => {
                  const t = p.data.title ?? p.slug;
                  const img = heroImage(p);
                  return (
                    <a class="relatedCard" href={`/daytona/posts/${p.slug.split("/").pop()}/`}>
                      <div class="relatedCardThumb">
                        <img src={img} alt={t} loading="lazy" decoding="async"
                          onerror={`this.src='${FALLBACK_IMG}';this.onerror=null;`} />
                      </div>
                      <div class="relatedCardTitle">{t}</div>
                    </a>
                  );
                })}
              </div>
            </div>
          )}

          <p class="postLinks">
            <a class="pill" href="/daytona/posts/">← All posts</a>
            <a class="pill" href="/daytona/topics/">Topics</a>
          </p>
        </div>

        <ArticleSidebar city="daytona" />

      </div>
    </div>
  </section>

</Base>

<!-- ══ GLOBAL styles: inline ToC box (ported 1:1 from GuideLayout) ═══════════
     Pure-white text on the brand-blue theme accent. is:global is required so
     the runtime-injected #guide-toc (built after hydration) is styled — Astro's
     scoped styles never reach JS-created nodes. ══════════════════════════════ -->
<style is:global>
  /* ── Inline collapsible ToC ── */
  #guide-toc.gl-itoc {
    background-color: var(--theme-accent) !important;
    border: 2px solid var(--line) !important;
    border-radius: 12px;
    padding: 20px 24px;
    margin-bottom: 32px;
    width: 100%;
    box-sizing: border-box;
    color: #ffffff;
  }

  /* Sit the ToC directly under the featured image as one cohesive block.
     .heroFigure carries a 32px (2rem) bottom margin; -18px pulls the ToC up to
     a clean 14px gap. */
  .heroFigure + #guide-toc.gl-itoc {
    margin-top: -18px;
  }

  .gl-itoc-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #ffffff;
    cursor: pointer;
    list-style: none;
    user-select: none;
    gap: 8px;
  }
  .gl-itoc-summary::-webkit-details-marker { display: none !important; }
  summary.gl-itoc-summary::-webkit-details-marker { display: none !important; }
  .gl-itoc-summary::marker { display: none !important; }
  summary.gl-itoc-summary { list-style: none; }

  .gl-itoc-hamburger {
    display: inline-block;
    width: 18px;
    height: 13px;
    flex-shrink: 0;
    margin-right: 2px;
    vertical-align: middle;
  }

  .gl-itoc-chevron {
    font-size: 22px;
    line-height: 1;
    color: #ffffff;
    transition: transform 200ms ease;
    flex-shrink: 0;
    margin-left: auto;
  }
  #guide-toc[open] .gl-itoc-chevron {
    transform: rotate(90deg);
  }

  .gl-itoc-list {
    list-style: none;
    margin: 10px 0 2px;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .gl-itoc li  { margin: 0 !important; padding: 2px 0 !important; }
  .gl-itoc-item { padding: 2px 0 !important; }
  .gl-itoc-item--sub { padding-left: 16px; padding-top: 2px !important; padding-bottom: 2px !important; }

  .gl-itoc-link {
    display: block;
    padding: 2px 0;
    font-size: 1.15rem;
    font-weight: 600;
    color: #ffffff;
    text-decoration: none;
    line-height: 1.35;
    transition: color 140ms;
  }
  .gl-itoc-link:hover { color: rgba(255, 255, 255, 0.75); }

  .gl-itoc-item--sub .gl-itoc-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: #ffffff;
  }
  .gl-itoc-item--sub .gl-itoc-link:hover { color: rgba(255, 255, 255, 0.75); }

  @media (max-width: 900px) {
    #guide-toc.gl-itoc {
      width: 100%;
      border-radius: 10px;
      background-color: var(--theme-accent) !important;
    }
  }
</style>

<!-- ── Inline collapsible ToC builder (hoisted; gated by the article's data-toc flag) ── -->
<script>
  (function () {
    var article = document.getElementById("post-body");
    if (!article) return;
    /* Reads the boolean set from the showTableOfContents prop. Kept as a runtime
       guard (rather than an Astro {show && …} wrapper) so hoisting can't strip
       or unconditionally include the script. */
    if (article.dataset.toc !== "true") return;

    /* ── PASS 0: Repair headings Markdown left as plain paragraphs ──
       Handles: <p><strong>## Section Title</strong></p>
                <p>## Section Title</p>
                <p>#Section Title</p>       (single hash / missing space)
                <p><strong>1. Section Title</strong></p>
                <p>2) Section Title</p>     (list-style headers a listicle
                                             author intended as sections)
       Maps # / ## / list-number → h2, ### → h3 (h1 is the article title).
       Only <p> nodes are scanned, so real Markdown <ol>/<li> lists (which
       render as list items, never paragraphs) are never disturbed. */
    var pars = Array.prototype.slice.call(article.querySelectorAll("p"));
    pars.forEach(function (p) {
      var raw = (p.textContent || "").replace(/^\s*\*+\s*/, "").trim();
      /* Hash-style: #, ##, ### */
      var hm = raw.match(/^(#{1,3})\s*(\S[\s\S]*?)$/);
      /* List-style: "1. Title" or "2) Title" — keep the number in the heading */
      var lm = !hm && raw.match(/^(\d{1,3}[.)]\s+\S[\s\S]*?)$/);
      if (!hm && !lm) return;
      var level = hm && hm[1].length >= 3 ? "h3" : "h2";
      var cleanText = (hm ? hm[2] : lm[1]).replace(/\*+\s*$/, "").trim();
      if (!cleanText) return;
      var newH = document.createElement(level);
      newH.textContent = cleanText;
      if (p.parentNode) p.parentNode.replaceChild(newH, p);
    });

    /* ── PASS 0b: Repair list-style headers Markdown turned into single-item
       ordered lists ──
       A standalone "1. Title" / "2. Title" line (blank-line separated, the way
       a listicle author writes section headers) is parsed as its OWN
       <ol start="N"><li>Title</li></ol> rather than a paragraph. A genuine
       multi-step list keeps every item under one <ol> with 2+ <li>, so we only
       promote single-item lists whose sole item is a short, single-line,
       block-free heading — leaving real ordered lists untouched. */
    var ols = Array.prototype.slice.call(article.querySelectorAll("ol"));
    ols.forEach(function (ol: HTMLElement) {
      if (ol.children.length !== 1) return;
      var li = ol.children[0];
      if (li.tagName !== "LI") return;
      /* Skip items carrying real block content (nested lists, multi-paragraph,
         hard line breaks) — those are genuine list entries, not headers. */
      if (li.querySelector("ul, ol, p + p, br")) return;
      var text = (li.textContent || "").trim();
      if (!text || text.length > 120 || /[\r\n]/.test(text)) return;
      var start = parseInt(ol.getAttribute("start") || "1", 10);
      var newH = document.createElement("h2");
      newH.textContent = (isNaN(start) ? 1 : start) + ". " + text;
      if (ol.parentNode) ol.parentNode.replaceChild(newH, ol);
    });

    var headings = Array.prototype.slice.call(
      article.querySelectorAll("h2, h3")
    );
    if (headings.length === 0) return;

    /* Assign IDs to headings that lack one */
    headings.forEach(function (h: HTMLElement, i: number) {
      if (!h.id) h.id = "toc-" + i;
    });

    /* Build <details> accordion */
    var details = document.createElement("details");
    details.id        = "guide-toc";
    details.className = "gl-itoc";
    /* Open on desktop (≥900 px), closed on mobile */
    details.open = window.innerWidth >= 900;

    var summary = document.createElement("summary");
    summary.className   = "gl-itoc-summary";
    summary.innerHTML   =
      '<svg class="gl-itoc-hamburger" aria-hidden="true" width="18" height="13" viewBox="0 0 18 13" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="0" y="0" width="18" height="2" rx="1" fill="currentColor"/><rect x="0" y="5.5" width="18" height="2" rx="1" fill="currentColor"/><rect x="0" y="11" width="18" height="2" rx="1" fill="currentColor"/></svg>In this post <span class="gl-itoc-chevron" aria-hidden="true">&#8250;</span>';
    details.appendChild(summary);

    var list = document.createElement("ul");
    list.className = "gl-itoc-list";

    headings.forEach(function (h: HTMLElement) {
      var li = document.createElement("li");
      li.className = h.tagName === "H3"
        ? "gl-itoc-item gl-itoc-item--sub"
        : "gl-itoc-item";

      var a = document.createElement("a");
      a.href        = "#" + h.id;
      a.textContent = h.textContent;
      a.className   = "gl-itoc-link";

      li.appendChild(a);
      list.appendChild(li);
    });

    details.appendChild(list);

    /* Placement: render the ToC immediately below the featured image so the two
       read as one cohesive block. The hero lives in a sibling <figure> just
       above the article body, so we insert after it. When there's no hero,
       fall back to sitting directly above the first content heading. */
    var main = article.closest(".postMain") || article.parentNode;
    var heroFig = main ? main.querySelector(".heroFigure") : null;
    if (heroFig) {
      heroFig.insertAdjacentElement("afterend", details);
    } else {
      headings[0].insertAdjacentElement("beforebegin", details);
    }
  })();
</script>

<style>
  .section { padding: 24px 0; }
  /* matches DiyPill and GuideLayout exactly: 1440px wide, 7fr/3fr, 56px gap */
  .pageWrap { max-width: 1280px; margin: 0 auto; padding: 0 2rem; }
  @media (max-width: 600px) { .pageWrap { padding: 0 1rem; } }

  .postLayout {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(380px, 3fr);
    gap: 56px;
    align-items: start;
    padding-top: 16px;
  }
  @media (max-width: 1150px) {
    .postLayout { grid-template-columns: 1fr; gap: 40px; }
  }

  .postMain { min-width: 0; }

  .catKicker {
    display: flex;
    align-items: center;
    margin-bottom: 10px;
  }
  .catCrumb {
    font-size: 0.8rem;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--brand1);
    text-decoration: none;
    transition: opacity 130ms;
  }
  .catCrumb:hover { opacity: .72; }
  .catDash {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--faint);
    opacity: .55;
    margin: 0 5px;
    letter-spacing: 0;
  }

  .postTitle {
    margin: 0 0 8px;
    font-size: clamp(22px, 2.6vw, 34px);
    font-weight: 800; letter-spacing: -0.3px; line-height: 1.1;
  }
  .byline {
    margin: 0 0 28px;
    font-size: 0.9rem;
    color: var(--faint);
    font-weight: 500;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
  }
  .bylineDate { opacity: .85; }
  .bylineSep  { opacity: .45; margin: 0 6px; }
  .bylineAuthor {
    color: var(--brand1);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 2px;
    font-weight: 700;
    transition: text-decoration-color 130ms;
  }
  .bylineAuthor:hover { text-decoration-color: var(--brand1); }

  /* Article description / hook — professional subtitle above the hero image */
  .postDek {
    margin: 0 0 26px;
    /* Full content-column width — matches the headline above and hero below. */
    width: 100%;
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    line-height: 1.5;
    font-style: italic;
    font-weight: 400;
    color: var(--faint);
  }

  .heroFigure { margin: 0 0 2rem; }
  .heroFull {
    display: block; width: 100%; aspect-ratio: 16/9; max-height: 450px; object-fit: cover;
    border-radius: 16px; border: 1px solid rgba(255,255,255,.10);
    box-shadow: 0 10px 26px rgba(0,0,0,.30);
  }
  .postBody { margin-top: 18px; line-height: 1.65; font-size: 16px; }

  .relatedWrap { margin-top: 32px; border-top: 2px solid var(--brand1); padding-top: 24px; }
  .relatedHeader { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
  .relatedHead { margin: 0; font-size: 13px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; color: var(--brand1); }
  .relatedArrows { display: flex; gap: 6px; }
  .relatedBtn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; border-radius: 50%;
    border: 1px solid var(--pillBorder); background: var(--surface2);
    color: var(--text); font-size: 16px; cursor: pointer; line-height: 1;
    transition: background 120ms, opacity 120ms;
  }
  .relatedBtn:hover { background: var(--pillBg); opacity: .85; }
  .relatedScroll {
    display: flex;
    overflow-x: auto;
    gap: 1.5rem;
    scrollbar-width: none;
    padding-bottom: 8px;
    -webkit-overflow-scrolling: touch;
  }
  .relatedScroll::-webkit-scrollbar { display: none; }
  .relatedCard {
    flex: 0 0 310px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: opacity 140ms, transform 140ms, box-shadow 140ms;
    border-radius: 14px;
  }
  .relatedCard:hover { opacity: .92; transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,.28); }
  .relatedCardThumb {
    width: 310px; aspect-ratio: 16/10;
    border-radius: 12px; overflow: hidden; background: var(--surface2);
  }
  .relatedCardThumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 280ms ease; }
  .relatedCard:hover .relatedCardThumb img { transform: scale(1.04); }
  .relatedCardTitle {
    font-size: 14px; font-weight: 800; line-height: 1.25; color: var(--text);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .relatedRow:hover { border-color: var(--pillBorder); box-shadow: 0 0 0 1px var(--pillBg), 0 10px 26px rgba(0,0,0,.30); }
  .postLinks { margin-top: 24px; display: flex; gap: 10px; flex-wrap: wrap; }
</style>
