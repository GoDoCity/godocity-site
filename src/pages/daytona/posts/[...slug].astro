---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { importFromSheet } from "../../../lib/sheet-import.js";

/* Featured flag normalization */
function isFeatured(post) {
  const v = post?.data?.featured;
  if (v === true) return true;
  if (v === 1) return true;
  const s = String(v ?? "").toLowerCase().trim();
  return s === "true" || s === "yes" || s === "1";
}

/* Tag normalization */
function tagKey(raw) {
  return String(raw ?? "").toLowerCase().trim().replace(/[-_]+/g, " ").replace(/\s+/g, " ");
}
function tagSlugFromKey(key) {
  return String(key ?? "").toLowerCase().trim().replace(/&/g, "and").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
}
function tagLabelFromKey(key) {
  const s = String(key ?? "").trim().replace(/\s+/g, " ");
  if (!s) return "";
  return s.split(" ").filter(Boolean).map((w) => (w ? w.charAt(0).toUpperCase() + w.slice(1) : "")).join(" ");
}

/* Safe date getter */
function getPostDate(post) {
  return post?.data?.pubDate ?? post?.data?.date ?? post?.data?.published ?? post?.data?.updated ?? null;
}
function sortNewestFirst(a, b) {
  return new Date(getPostDate(b) ?? 0).getTime() - new Date(getPostDate(a) ?? 0).getTime();
}

/* Hero image field — checks all common frontmatter aliases */
const FALLBACK_IMG = "/images/gododaytona-bg.png";
function heroImage(post) {
  const v = post?.data?.heroImage ?? post?.data?.heroimage ?? post?.data?.image ?? post?.data?.thumbnail ?? "";
  return String(v).trim() || FALLBACK_IMG;
}

/* Related posts */
const RELATED_LIMIT = 3;
const MAX_FEATURED_IN_RELATED = 1;

function normalizeTags(post) {
  const raw = Array.isArray(post?.data?.tags) ? post.data.tags : [];
  return Array.from(new Set(raw.map(tagKey).filter(Boolean)));
}
function sharedTagScore(aKeys, bKeys) {
  if (!aKeys.length || !bKeys.length) return 0;
  const set = new Set(aKeys);
  let score = 0;
  for (const k of bKeys) if (set.has(k)) score++;
  return score;
}
function buildRelatedPosts(currentPost, allCityPosts) {
  const currentSlug = currentPost?.slug;
  const currentKeys = normalizeTags(currentPost);
  const candidates = allCityPosts
    .filter((p) => p?.slug && p.slug !== currentSlug)
    .map((p) => {
      const keys = normalizeTags(p);
      return { p, score: sharedTagScore(currentKeys, keys), date: new Date(getPostDate(p) ?? 0).getTime() };
    });
  candidates.sort((x, y) => y.score !== x.score ? y.score - x.score : y.date - x.date);
  const withOverlap = candidates.filter((c) => c.score > 0).map((c) => c.p);
  const withoutOverlap = candidates.filter((c) => c.score === 0).map((c) => c.p);
  const ranked = [...withOverlap, ...withoutOverlap];
  const featured = ranked.filter(isFeatured);
  const nonFeatured = ranked.filter((p) => !isFeatured(p));
  const result = [];
  result.push(...featured.slice(0, MAX_FEATURED_IN_RELATED));
  result.push(...nonFeatured.slice(0, RELATED_LIMIT - result.length));
  const remaining = ranked.filter((p) => !result.some((r) => r.slug === p.slug));
  result.push(...remaining.slice(0, RELATED_LIMIT - result.length));
  return result.slice(0, RELATED_LIMIT);
}

/* Build-safe getStaticPaths */
export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const daytonaPosts = posts
    .filter((post) => {
      const city = String(post?.data?.city ?? "daytona").toLowerCase().trim();
      if (city === "daytona") return true;
      return typeof post?.id === "string" && post.id.startsWith("daytona/");
    })
    .sort((a, b) => {
      const da = new Date(a?.data?.pubDate ?? a?.data?.date ?? a?.data?.published ?? a?.data?.updated ?? 0).getTime();
      const db = new Date(b?.data?.pubDate ?? b?.data?.date ?? b?.data?.published ?? b?.data?.updated ?? 0).getTime();
      return db - da;
    });
  return daytonaPosts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

/* Page data */
const { post } = Astro.props;
const title = post.data.title;
const subtitle = post.data.description ?? "GoDo Daytona post";
const { Content } = await post.render();

const all = await getCollection("posts");
const daytonaPosts = all
  .filter((p) => {
    const city = String(p?.data?.city ?? "daytona").toLowerCase().trim();
    if (city === "daytona") return true;
    return typeof p?.id === "string" && p.id.startsWith("daytona/");
  })
  .sort(sortNewestFirst);

const rawTags = Array.isArray(post.data?.tags) ? post.data.tags : [];
const uniqueKeySet = new Set(rawTags.map(tagKey).filter(Boolean));
const tagItems = Array.from(uniqueKeySet).map((key) => ({
  key, label: tagLabelFromKey(key), slug: tagSlugFromKey(key),
}));

const relatedAll = buildRelatedPosts(post, daytonaPosts);
const seen = new Set();
const deduped = relatedAll.filter((p) => { if (seen.has(p.slug)) return false; seen.add(p.slug); return true; });
const relatedPosts = [...deduped.filter(isFeatured), ...deduped.filter((p) => !isFeatured(p))].slice(0, 3);

const pub = getPostDate(post);
const pubText = pub ? new Date(pub).toLocaleDateString("en-US") : "";
const featured = isFeatured(post);
const hero = heroImage(post);

/* Upcoming events — pull from live sheet first, fall back to content collection */
const todayE = new Date();
todayE.setHours(0, 0, 0, 0);
const GREATER_DAYTONA = new Set([
  "daytona", "daytona beach", "port orange", "ormond beach", "holly hill",
  "south daytona", "new smyrna beach", "deland", "edgewater",
]);
let sheetSidebarEvents = [];
try {
  const csvUrl = import.meta.env.SHEET_CSV_URL ?? "";
  if (csvUrl) {
    // No EB token → no Eventbrite API calls (fast); no Mapbox → no geocoding
    const raw = await importFromSheet(csvUrl, "", "");
    sheetSidebarEvents = raw
      .filter(e => {
        const evCity = (e.city ?? "").toLowerCase().trim();
        return GREATER_DAYTONA.has(evCity);
      })
      .filter(e => {
        const evDate = new Date(e.eventDate);
        evDate.setHours(0, 0, 0, 0);
        return evDate >= todayE;
      })
      .sort((a, b) => new Date(a.eventDate).getTime() - new Date(b.eventDate).getTime())
      .slice(0, 4)
      .map(e => ({
        data: { title: e.title, eventDate: e.eventDate, location: e.location, url: e.url },
        slug: `daytona/${(e.title ?? "event").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")}`,
      }));
  }
} catch { sheetSidebarEvents = []; }

let collectionEvents = [];
try { collectionEvents = await getCollection("events"); } catch { collectionEvents = []; }
const collectionUpcoming = collectionEvents
  .filter(e => {
    const evCity = (e.data.city ?? e.slug.split("/")[0]).toLowerCase().trim();
    const evDate = new Date(e.data.eventDate);
    evDate.setHours(0, 0, 0, 0);
    return evCity === "daytona" && evDate >= todayE;
  })
  .sort((a, b) => new Date(a.data.eventDate).getTime() - new Date(b.data.eventDate).getTime())
  .slice(0, 4);

const upcomingEvents = sheetSidebarEvents.length > 0 ? sheetSidebarEvents : collectionUpcoming;
---

<Base title={title} subtitle={subtitle} cityBase="daytona">
  <section class="section">
    <div class="container">
      <div class="postLayout">

        <div class="postMain">
          <h1 class={`postTitle ${featured ? "isFeatured" : ""}`}>{title}</h1>
          {post.data.description && <p class="postLede">{post.data.description}</p>}

          <div class="metaRow">
            {pubText && <span class="metaDate">{pubText}</span>}
            {tagItems.length > 0 && (
              <span class="metaTags" aria-label="Topics">
                {tagItems.map((t) => (
                  <a class="topicPill" href={`/daytona/topic/${t.slug}/`}>{t.label}</a>
                ))}
              </span>
            )}
            {featured && <span class="featuredPill">FEATURED</span>}
          </div>

          <figure class="heroFigure">
            <img class="heroFull" src={hero} alt={post.data.title ?? "Post image"} loading="eager" decoding="async"
              onerror={`this.src='${FALLBACK_IMG}';this.onerror=null;`} />
          </figure>

          <article class="postBody">
            <Content />
          </article>

          {relatedPosts.length > 0 && (
            <div class="relatedWrap">
              <h3 class="relatedHead">Related posts</h3>
              <div class="relatedList">
                {relatedPosts.map((p) => {
                  const t = p.data.title ?? p.slug;
                  const desc = p.data.description ?? "";
                  const d = getPostDate(p);
                  const dateText = d ? new Date(d).toLocaleDateString("en-US") : "";
                  const img = heroImage(p);
                  return (
                    <a class="relatedRow" href={`/daytona/posts/${p.slug}/`}>
                      <div class="relatedThumb">
                        <img class="relatedImg" src={img} alt={t} loading="lazy" decoding="async"
                          onerror={`this.src='${FALLBACK_IMG}';this.onerror=null;`} />
                      </div>
                      <div class="relatedText">
                        <div class="relatedTitle">{t}</div>
                        {desc && <div class="relatedDesc">{desc}</div>}
                        {dateText && <div class="relatedMeta">{dateText}</div>}
                      </div>
                      {isFeatured(p) && <span class="featuredPill featuredPillSmall">FEATURED</span>}
                    </a>
                  );
                })}
              </div>
            </div>
          )}

          <p class="postLinks">
            <a class="pill" href="/daytona/posts/">← All posts</a>
            <a class="pill" href="/daytona/topics/">Topics</a>
          </p>
        </div>

        <aside class="postSidebar">

          <!-- ── Email sign-up banner ── -->
          <div class="newsletterCard">
            <div class="newsletterBadge">FREE DAILY NEWSLETTER</div>
            <div class="newsletterHeadline">Don't miss a beat.</div>
            <div class="newsletterSubtext">Get the best of Daytona in your inbox every morning.</div>
            <form class="newsletterForm" action="/daytona/subscribe/" method="get">
              <input class="newsletterInput" type="email" name="email" placeholder="your@email.com" aria-label="Email address" />
              <button class="newsletterButton" type="submit">SIGN UP FREE →</button>
            </form>
            <div class="newsletterFineprint">100% free. Unsubscribe anytime.</div>
          </div>

          <!-- ── Upcoming events ── -->
          <div class="sidebarCard">
            <div class="sidebarHead">Upcoming Events</div>
            {upcomingEvents.length > 0 ? upcomingEvents.map((e, i) => {
              const d = new Date(e.data.eventDate);
              const dow = d.toLocaleDateString("en-US", { weekday: "short" }).toUpperCase();
              const day = d.getDate();
              const mon = d.toLocaleDateString("en-US", { month: "short" }).toUpperCase();
              return (
                <a class="eventRow"
                   href={e.data.url ?? `/daytona/events/${e.slug.split("/").pop()}/`}
                   target={e.data.url ? "_blank" : "_self"}
                   rel={e.data.url ? "noopener" : ""}>
                  <div class="eventCal">
                    <div class="eDow">{dow}</div>
                    <div class="eDay">{day}</div>
                    <div class="eMon">{mon}</div>
                  </div>
                  <div class="eventInfo">
                    <div class="eName">{e.data.title}</div>
                    <div class="ePlace">{e.data.location}</div>
                  </div>
                </a>
              );
            }) : (
              <p style="color:var(--muted);font-size:14px;margin:0">No upcoming events — check back soon.</p>
            )}
            <a class="seeAll" href="/daytona/events/">See all events →</a>
          </div>

        </aside>

      </div>
    </div>
  </section>
</Base>

<style>
  .postLayout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 32px;
    align-items: start;
    padding-top: 16px;
  }
  @media (max-width: 860px) {
    .postLayout { grid-template-columns: 1fr; }
    .postSidebar {
      position: static;
      display: flex;
      flex-direction: column;
    }
    /* Newsletter always renders before events when sidebar stacks below article */
    .newsletterCard { order: 1; }
    .sidebarCard    { order: 2; }
  }

  .postMain { min-width: 0; }
  .postSidebar { position: sticky; top: 80px; min-width: 0; }

  /* ── Newsletter banner ── */
  .newsletterCard {
    border-radius: 16px;
    background: #f9d900;
    padding: 18px 16px 16px;
    margin-bottom: 16px;
  }
  .newsletterBadge {
    display: inline-block;
    font-size: 9px; font-weight: 900; letter-spacing: .12em;
    text-transform: uppercase; color: rgba(0,0,0,.55);
    background: rgba(0,0,0,.10); border-radius: 999px;
    padding: 3px 9px; margin-bottom: 8px;
  }
  .newsletterHeadline {
    font-size: 20px; font-weight: 950; color: #000;
    line-height: 1.1; letter-spacing: -0.02em; margin-bottom: 5px;
  }
  .newsletterSubtext {
    font-size: 13px; color: rgba(0,0,0,.72); line-height: 1.4; margin-bottom: 12px;
  }
  .newsletterForm { display: grid; gap: 8px; }
  .newsletterInput {
    width: 100%; padding: 11px 12px;
    border-radius: 10px; border: 1.5px solid rgba(0,0,0,.18);
    background: rgba(255,255,255,.85); color: #111;
    font-size: 13.5px; outline: none;
    transition: border-color 140ms ease, box-shadow 140ms ease;
  }
  .newsletterInput:focus {
    border-color: #000;
    box-shadow: 0 0 0 3px rgba(0,0,0,.12);
  }
  .newsletterButton {
    width: 100%; padding: 11px 12px;
    border-radius: 10px; border: none;
    background: #000; color: #f9d900;
    font-size: 13px; font-weight: 900; letter-spacing: .04em;
    cursor: pointer; transition: opacity 140ms ease;
  }
  .newsletterButton:hover { opacity: .88; }
  .newsletterFineprint {
    margin-top: 8px; font-size: 11px; color: rgba(0,0,0,.52); text-align: center;
  }

  .sidebarCard {
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.03);
    border-radius: 16px;
    padding: 14px;
  }
  .sidebarHead {
    font-weight: 900; font-size: 14px; text-transform: uppercase;
    letter-spacing: .1em; color: var(--muted); margin-bottom: 10px;
  }

  .eventRow {
    display: grid; grid-template-columns: 48px 1fr; gap: 10px;
    align-items: center; text-decoration: none;
    padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,.08);
  }
  .eventRow:last-of-type { border-bottom: none; }
  .eventCal {
    width: 48px; height: 48px; border-radius: 10px;
    background: rgba(255,255,255,.06);
    display: grid; place-items: center; text-align: center; line-height: 1;
  }
  .eDow { font-size: 9px; font-weight: 900; color: var(--brand1); text-transform: uppercase; }
  .eDay { font-size: 18px; font-weight: 900; color: var(--text); }
  .eMon { font-size: 8px; font-weight: 700; color: var(--faint); text-transform: uppercase; }
  .eventInfo { display: flex; flex-direction: column; gap: 2px; }
  .eName { font-weight: 800; font-size: 14px; color: var(--text); line-height: 1.2; }
  .ePlace { font-size: 12px; color: var(--faint); }
  .seeAll { display: block; margin-top: 10px; font-size: 13px; font-weight: 700; color: var(--link); text-decoration: none; }

  .postTitle {
    margin: 0 0 8px;
    font-size: clamp(22px, 2.6vw, 34px);
    font-weight: 800; letter-spacing: -0.3px; line-height: 1.1;
  }
  .postLede { margin: 0 0 14px; font-size: clamp(15px, 1.4vw, 18px); line-height: 1.45; color: var(--muted); }
  .heroFigure { margin: 0 0 18px; }
  .heroFull {
    display: block; width: 100%; aspect-ratio: 16/9; object-fit: cover;
    border-radius: 16px; border: 1px solid rgba(255,255,255,.10);
    box-shadow: 0 10px 26px rgba(0,0,0,.30);
  }
  .postBody { margin-top: 18px; line-height: 1.65; font-size: 16px; }
  .metaRow { margin: 0 0 16px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; opacity: .85; }
  .metaDate { opacity: .75; font-size: 13px; }
  .metaTags { display: inline-flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .topicPill {
    display: inline-flex; align-items: center; padding: 4px 10px;
    border-radius: 999px; font-size: 11px; font-weight: 800;
    text-decoration: none; color: #111;
    background: rgba(255,220,80,.65); border: 1px solid rgba(255,220,80,.55);
  }
  .featuredPill {
    font-size: 12px; font-weight: 800; padding: 5px 10px; border-radius: 999px;
    border: 1px solid var(--pillBorder); color: var(--brand1);
    background: var(--pillBg); white-space: nowrap;
  }
  .featuredPillSmall { font-size: 11px; padding: 4px 9px; align-self: start; }

  .relatedWrap { margin-top: 32px; }
  .relatedHead { margin: 0 0 12px; font-size: 15px; font-weight: 800; opacity: .9; }
  .relatedList { display: grid; gap: 12px; }
  .relatedRow {
    text-decoration: none; display: grid;
    grid-template-columns: 96px 1fr auto; gap: 12px; align-items: start;
    border: 1px solid rgba(255,255,255,.10); border-radius: 14px;
    padding: 12px; background: rgba(255,255,255,.03);
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .relatedRow:hover { border-color: var(--pillBorder); box-shadow: 0 0 0 1px var(--pillBg), 0 10px 26px rgba(0,0,0,.30); }
  .relatedThumb { width: 96px; }
  .relatedImg { width: 96px; height: 66px; border-radius: 10px; object-fit: cover; border: 1px solid rgba(255,255,255,.10); display: block; }
  .relatedFallback { background: rgba(255,255,255,.04); }
  .relatedText { min-width: 0; }
  .relatedTitle { font-weight: 800; font-size: 15px; line-height: 1.2; color: var(--text); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .relatedDesc { margin-top: 5px; font-size: 13px; color: var(--muted); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .relatedMeta { margin-top: 6px; font-size: 12px; color: var(--faint); }

  @media (max-width: 520px) {
    .relatedRow { grid-template-columns: 1fr; }
    .relatedThumb { width: 100%; }
    .relatedImg { width: 100%; height: auto; aspect-ratio: 16/9; }
    .featuredPillSmall { justify-self: start; }
  }

  .postLinks { margin-top: 24px; display: flex; gap: 10px; flex-wrap: wrap; }
</style>
