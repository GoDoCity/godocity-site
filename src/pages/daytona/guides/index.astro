---
import Base from "../../../layouts/Base.astro";

/* ── Section data — update hrefs once individual sub-guide pages are live ── */
const sections = [
  {
    id: "live",
    label: "Live",
    emoji: "🏠",
    bg: "white",
    featured: {
      img: "/images/topics/real-estate.jpg",
      title: "Your Ultimate Guide to Daytona — Live: Terrazzo Restoration",
      description:
        "Daytona's homes are full of stunning vintage terrazzo floors — and most of them haven't seen proper care in decades. Here's how to bring yours back to life the right way, from grinding and polishing to long-term sealing.",
      href: "/daytona/guides/live/",
    },
    articles: [
      {
        img: "/images/topics/city.jpg",
        title: "Your Ultimate Guide to Daytona — Live: Ormond Neighborhoods",
        description: "Quiet streets, great schools, and lower price points. Find out which Ormond pockets are worth a closer look.",
        href: "/daytona/guides/live/",
      },
      {
        img: "/images/topics/wellness.jpg",
        title: "Your Ultimate Guide to Daytona — Live: Hurricane Prep",
        description: "Daytona sits in the path of Florida's biggest storms. This is the local checklist that actually gets you ready — not the generic one.",
        href: "/daytona/guides/live/",
      },
      {
        img: "/images/topics/culture.jpg",
        title: "Your Ultimate Guide to Daytona — Live: Local Gardening",
        description: "Growing in Zone 9b is a different game. Discover what thrives in Daytona's soil and exactly when to plant it.",
        href: "/daytona/guides/live/",
      },
    ],
    viewAllHref: "/daytona/guides/live/",
    viewAllLabel: "View All Live Guides",
  },
  {
    id: "work",
    label: "Work",
    emoji: "💼",
    bg: "grey",
    featured: {
      img: "/images/topics/business.jpg",
      title: "Your Ultimate Guide to Daytona — Work: Fleet Maintenance",
      description:
        "From seasonal tourism fleets to marine service rigs, Volusia County's vehicle economy runs deep. Here's who keeps it moving and how to get your operation into compliance without the runaround.",
      href: "/daytona/guides/work/",
    },
    articles: [
      {
        img: "/images/topics/history.jpg",
        title: "Your Ultimate Guide to Daytona — Work: Small Business Insurance",
        description: "Florida's liability landscape is brutal for small operators. Cut through the noise with a guide built for Daytona-area business owners.",
        href: "/daytona/guides/work/",
      },
      {
        img: "/images/topics/culture.jpg",
        title: "Your Ultimate Guide to Daytona — Work: Networking in Volusia",
        description: "The right room changes everything. These are the events, orgs, and meetups where Daytona's business community actually shows up.",
        href: "/daytona/guides/work/",
      },
      {
        img: "/images/topics/real-estate.jpg",
        title: "Your Ultimate Guide to Daytona — Work: Coworking Spaces",
        description: "Skip the coffee-shop WiFi. These Daytona coworking spots offer real desks, fast internet, and people worth meeting.",
        href: "/daytona/guides/work/",
      },
    ],
    viewAllHref: "/daytona/guides/work/",
    viewAllLabel: "View All Work Guides",
  },
  {
    id: "play",
    label: "Play",
    emoji: "🎉",
    bg: "white",
    featured: {
      img: "/images/topics/events.jpg",
      title: "Your Ultimate Guide to Daytona — Play: Date Night Spots",
      description:
        "Forget the chain restaurants on LPGA. Daytona has a genuine date-night scene — and these are the spots that actually deliver on both the vibe and the food, from waterfront dinners to late-night bites.",
      href: "/daytona/guides/play/",
    },
    articles: [
      {
        img: "/images/topics/sports.jpg",
        title: "Your Ultimate Guide to Daytona — Play: Best Surfing Beaches",
        description: "Daytona's waves are more consistent than people give them credit for. Here's where to paddle out depending on swell and season.",
        href: "/daytona/guides/play/",
      },
      {
        img: "/images/topics/wellness.jpg",
        title: "Your Ultimate Guide to Daytona — Play: Hidden Fishing Holes",
        description: "The locals aren't fishing the pier. Find the backwater spots, creek mouths, and tidal flats worth a sunrise trip.",
        href: "/daytona/guides/play/",
      },
      {
        img: "/images/topics/city.jpg",
        title: "Your Ultimate Guide to Daytona — Play: Dog-Friendly Parks",
        description: "Daytona is surprisingly great for dog owners. These parks, trails, and off-leash zones are worth the car ride.",
        href: "/daytona/guides/play/",
      },
    ],
    viewAllHref: "/daytona/guides/play/",
    viewAllLabel: "View All Play Guides",
  },
];
---

<Base
  title="Daytona Guides | GoDoDaytona"
  subtitle="Your local guide to living, working, and playing in Daytona Beach."
  cityBase="daytona"
>
  <div class="ghWrap">

    {/* ── PAGE HERO ── */}
    <div class="ghHero">
      <div class="container">
        <div class="ghHeroBreadcrumb">
          <a href="/daytona/">GoDo Daytona</a>
          <span class="ghCrumbSep">›</span>
          <span>Guides</span>
        </div>
        <h1 class="ghHeroTitle">Daytona Guides</h1>
        <p class="ghHeroLede">
          Your local playbook for Daytona Beach — how to live here, work here,
          and make the most of it.
        </p>
        <div class="ghTopicPills">
          <a class="ghTopicPill" href="/daytona/guides/live/">🏠 Live</a>
          <a class="ghTopicPill" href="/daytona/guides/work/">💼 Work</a>
          <a class="ghTopicPill" href="/daytona/guides/play/">🎉 Play</a>
        </div>
      </div>
    </div>

    {/* ── THREE STACKED SECTIONS ── */}
    {sections.map((s) => (
      <section class={`ghSection ghSection--${s.bg}`} id={s.id}>

        {/* Full-width category banner */}
        <div class="ghCategoryBanner">
          <h2 class="ghCategoryBannerText">{s.label.toUpperCase()}</h2>
        </div>

        <div class="container">

          {/* Sub-header row: just the "View all" link */}
          <div class="ghSecSubHead">
            <a class="ghSecMore" href={s.viewAllHref}>
              View all {s.label} Guides →
            </a>
          </div>

          {/* 1+3 Featured Grid */}
          <div class="ghGrid">

            {/* ── Left: Featured Card ── */}
            <a class="ghFeatCard" href={s.featured.href}>
              <div class="ghFeatImgWrap">
                <img
                  class="ghFeatImg"
                  src={s.featured.img}
                  alt={s.featured.title}
                  loading="lazy"
                  decoding="async"
                  onerror="this.style.display='none';this.nextElementSibling.style.display='block'"
                />
                <div class="ghFeatImgFallback" aria-hidden="true"></div>
              </div>
              <div class="ghFeatBody">
                <div class="ghFeatKicker">
                  <span class="ghFeatKickerEmoji">{s.emoji}</span>
                  {s.label} Guide
                </div>
                <h3 class="ghFeatTitle">{s.featured.title}</h3>
                <p class="ghFeatDesc">{s.featured.description}</p>
                <span class="ghFeatCta">Read the guide →</span>
              </div>
            </a>

            {/* ── Right: 3 Recent Articles ── */}
            <div class="ghArticleList">
              {s.articles.map((art, i) => (
                <a class="ghArticleRow" href={art.href}>
                  <div class="ghThumbWrap">
                    <img
                      class="ghThumb"
                      src={art.img}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      onerror="this.style.display='none';this.nextElementSibling.style.display='block'"
                    />
                    <div class="ghThumbFallback" aria-hidden="true"></div>
                  </div>
                  <div class="ghArticleText">
                    <div class="ghArticleNum">#{i + 1}</div>
                    <div class="ghArticleTitle">{art.title}</div>
                    {art.description && (
                      <p class="ghArticleDesc">{art.description}</p>
                    )}
                  </div>
                </a>
              ))}
            </div>

          </div>{/* end .ghGrid */}

          {/* View All button */}
          <div class="ghViewAllRow">
            <a class="ghViewAllBtn" href={s.viewAllHref}>
              {s.viewAllLabel} →
            </a>
          </div>

        </div>
      </section>
    ))}

  </div>{/* end .ghWrap */}

  <style>
    /* ── Wrap ── */
    .ghWrap {
      min-height: 100vh;
    }

    /* ── Page Hero ── */
    .ghHero {
      padding: 48px 0 40px;
      border-bottom: 2px solid var(--brand1);
    }
    .ghHeroBreadcrumb {
      font-size: 13px;
      font-weight: 600;
      color: var(--faint);
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .ghHeroBreadcrumb a {
      color: var(--brand1);
      text-decoration: none;
    }
    .ghHeroBreadcrumb a:hover { text-decoration: underline; }
    .ghCrumbSep { opacity: .5; }

    .ghHeroTitle {
      font-family: "Montserrat", "Century Gothic", AppleGothic, Arial, sans-serif;
      font-size: clamp(2.4rem, 5vw, 3.6rem);
      font-weight: 900;
      letter-spacing: -0.03em;
      color: var(--text);
      margin: 0 0 10px;
      line-height: 1.05;
    }
    .ghHeroLede {
      font-size: 1.1rem;
      color: var(--muted);
      max-width: 600px;
      margin: 0 0 22px;
      line-height: 1.55;
    }
    .ghTopicPills {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }
    .ghTopicPill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 18px;
      border-radius: 999px;
      border: 1px solid var(--pillBorder);
      background: var(--pillBg);
      color: var(--text);
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      transition: border-color 130ms, box-shadow 130ms, background 130ms;
    }
    .ghTopicPill:hover {
      border-color: var(--brand1);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand1) 18%, transparent);
      background: color-mix(in srgb, var(--brand1) 10%, var(--pillBg));
    }

    /* ── Section shells — alternating backgrounds ── */
    .ghSection {
      padding: 0 0 48px;
    }
    .ghSection--white {
      background: var(--surface);
    }
    .ghSection--grey {
      background: var(--surface2);
      border-bottom: 1px solid var(--border);
    }

    /* ── Full-width category banner ── */
    .ghCategoryBanner {
      width: 100vw !important;
      background: #2E3E52;
      padding: 56px 0;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 28px;
      border-top: 4px solid #FFD700 !important;
      border-bottom: 4px solid #FFD700 !important;
    }
    .ghCategoryBannerText {
      font-family: "Montserrat", "Century Gothic", AppleGothic, Arial, sans-serif;
      font-size: clamp(4.4rem, 8vw, 5.8rem) !important;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #ffffff;
      margin: 0;
      line-height: 1;
      text-align: center;
    }

    /* ── Sub-header row (view-all link) ── */
    .ghSecSubHead {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 20px;
    }
    .ghSecMore {
      font-size: 13px;
      font-weight: 700;
      color: var(--link);
      text-decoration: none;
      white-space: nowrap;
    }
    .ghSecMore:hover { text-decoration: underline; }

    /* ── 1+3 Featured Grid ── */
    .ghGrid {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 28px;
      align-items: start;
    }
    @media (max-width: 900px) {
      .ghGrid {
        grid-template-columns: 1fr;
        gap: 20px;
      }
    }

    /* ── Featured Card (left) ── */
    .ghFeatCard {
      display: block;
      text-decoration: none;
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid var(--border);
      background: var(--panel);
      transition: box-shadow 200ms ease;
    }
    .ghFeatCard:hover {
      box-shadow: 0 8px 32px rgba(0,0,0,.28);
    }
    .ghFeatImgWrap {
      position: relative;
      width: 100%;
      aspect-ratio: 16/9;
      overflow: hidden;
      background: var(--surface2);
    }
    .ghFeatImg {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 320ms ease;
    }
    .ghFeatCard:hover .ghFeatImg { transform: scale(1.04); }
    .ghFeatImgFallback {
      display: none;
      position: absolute;
      inset: 0;
      background: var(--surface2);
    }
    .ghFeatBody {
      padding: 20px 22px 22px;
    }
    .ghFeatKicker {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .09em;
      text-transform: uppercase;
      color: var(--brand1);
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 5px;
    }
    .ghFeatKickerEmoji {
      font-size: 14px;
      letter-spacing: 0;
    }
    .ghFeatTitle {
      font-size: clamp(1.1rem, 1.9vw, 1.45rem);
      font-weight: 900;
      color: var(--text);
      line-height: 1.18;
      letter-spacing: -0.25px;
      margin: 0 0 10px;
      transition: color 130ms;
    }
    .ghFeatCard:hover .ghFeatTitle { color: var(--link); }
    .ghFeatDesc {
      font-size: 15px;
      color: var(--muted);
      line-height: 1.55;
      margin: 0 0 14px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .ghFeatCta {
      display: inline-flex;
      align-items: center;
      height: 34px;
      padding: 0 16px;
      border-radius: 999px;
      background: var(--brand1);
      color: var(--accentText);
      font-size: 13px;
      font-weight: 800;
      text-decoration: none;
      transition: filter 130ms;
    }
    .ghFeatCard:hover .ghFeatCta { filter: brightness(.92); }

    /* ── Article List (right column) ── */
    .ghArticleList {
      display: flex;
      flex-direction: column;
      border: 1px solid var(--border);
      border-radius: 14px;
      overflow: hidden;
      background: var(--panel);
    }
    .ghArticleRow {
      display: grid;
      grid-template-columns: 88px 1fr;
      gap: 12px;
      align-items: center;
      padding: 14px 16px;
      border-bottom: 1px solid var(--border);
      text-decoration: none;
      transition: background 130ms ease;
    }
    .ghArticleRow:last-child { border-bottom: none; }
    .ghArticleRow:hover {
      background: color-mix(in srgb, var(--brand1) 6%, var(--panel));
    }
    .ghThumbWrap {
      width: 88px;
      height: 64px;
      border-radius: 8px;
      overflow: hidden;
      flex-shrink: 0;
      background: var(--surface2);
      position: relative;
    }
    .ghThumb {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 280ms ease;
    }
    .ghArticleRow:hover .ghThumb { transform: scale(1.06); }
    .ghThumbFallback {
      display: none;
      position: absolute;
      inset: 0;
      background: var(--surface2);
    }
    .ghArticleText {
      display: flex;
      flex-direction: column;
      gap: 4px;
      min-width: 0;
    }
    .ghArticleNum {
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .07em;
      color: var(--brand1);
      text-transform: uppercase;
    }
    .ghArticleTitle {
      font-size: 15px;
      font-weight: 700;
      color: var(--text);
      line-height: 1.25;
      letter-spacing: -0.1px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      transition: color 130ms ease;
    }
    .ghArticleRow:hover .ghArticleTitle { color: var(--link); }
    .ghArticleDesc {
      font-size: 12px;
      color: var(--muted);
      line-height: 1.45;
      margin: 2px 0 0;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* ── View All button row ── */
    .ghViewAllRow {
      margin-top: 22px;
      text-align: center;
    }
    .ghViewAllBtn {
      display: inline-flex;
      align-items: center;
      height: 40px;
      padding: 0 24px;
      border-radius: 999px;
      border: 1.5px solid var(--pillBorder);
      background: var(--pillBg);
      color: var(--link);
      font-size: 14px;
      font-weight: 800;
      text-decoration: none;
      letter-spacing: .02em;
      transition: background 140ms, border-color 140ms, box-shadow 140ms;
    }
    .ghViewAllBtn:hover {
      background: color-mix(in srgb, var(--brand1) 14%, var(--pillBg));
      border-color: var(--brand1);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand1) 16%, transparent);
    }

    /* ── Mobile stacks ── */
    @media (max-width: 640px) {
      .ghHero { padding: 32px 0 28px; }
      .ghSection { padding: 0 0 32px; }
      .ghCategoryBanner { padding: 36px 0; }
      .ghCategoryBannerText { font-size: clamp(2.8rem, 8vw, 4rem) !important; }
      .ghSecSubHead { margin-bottom: 16px; }
      .ghGrid { gap: 16px; }
      .ghArticleRow { grid-template-columns: 72px 1fr; gap: 10px; padding: 12px 14px; }
      .ghThumbWrap { width: 72px; height: 52px; }
      .ghFeatBody { padding: 14px 16px 16px; }
      .ghFeatDesc { -webkit-line-clamp: 2; }
    }
  </style>
</Base>
