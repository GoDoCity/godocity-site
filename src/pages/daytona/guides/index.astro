---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";

/* ── Fetch all guides from the Decap collection ── */
const allGuides = await getCollection("guides");

function guideSlug(g: (typeof allGuides)[number]) {
  return g.slug.split("/").pop()!;
}

const fallbackImgs: Record<string, string> = {
  Live: "/images/topics/real-estate.jpg",
  Work: "/images/topics/business.jpg",
  Play: "/images/topics/sports.jpg",
};

type SubcategoryLink = { label: string; href: string };
type ArticleItem = {
  img: string;
  title: string;
  description?: string;
  href: string;
  external?: boolean;
};
type SectionDef = {
  id: string;
  brand: string;
  slug: string;
  bg: "white" | "grey";
  subcategories: SubcategoryLink[];
  articles: ArticleItem[];
  viewAllHref: string;
  viewAllLabel: string;
};

/* ── Subcategory ribbon links per section (link to category page anchors) ── */
const subcategoryLinks: Record<string, SubcategoryLink[]> = {
  live: [
    { label: "Neighborhoods", href: "/daytona/guides/live/#neighborhoods" },
    { label: "Schools",       href: "/daytona/guides/live/#schools"       },
    { label: "Healthcare",    href: "/daytona/guides/live/#healthcare"    },
    { label: "Need to Know",  href: "/daytona/guides/live/#need-to-know"  },
  ],
  work: [
    { label: "Entrepreneurship", href: "/daytona/guides/work/#entrepreneurship" },
    { label: "Industry",         href: "/daytona/guides/work/#industry"         },
    { label: "Networking",       href: "/daytona/guides/work/#networking"       },
    { label: "Coworking",        href: "/daytona/guides/work/#coworking"        },
  ],
  play: [
    { label: "Outdoors",       href: "/daytona/guides/play/#outdoors"      },
    { label: "Arts & Culture", href: "/daytona/guides/play/#arts-culture"  },
    { label: "Dining",         href: "/daytona/guides/play/#dining"        },
    { label: "Attractions",    href: "/daytona/guides/play/#attractions"   },
  ],
  best: [
    { label: "Basics & Pets",  href: "/daytona/guides/best/#basics-pets"   },
    { label: "Health",         href: "/daytona/guides/best/#health"         },
    { label: "Home Services",  href: "/daytona/guides/best/#home-services"  },
    { label: "City & Safety",  href: "/daytona/guides/best/#city-safety"    },
  ],
};

/* ── Hardcoded placeholder articles (shown when collection is empty) ── */
const hardcodedArticles: Record<string, ArticleItem[]> = {
  live: [
    { img: "/images/topics/city.jpg",        title: "Ormond Beach Neighborhoods Guide",      description: "Quiet streets, great schools, and lower price points — find your pocket.",     href: "/daytona/guides/live/" },
    { img: "/images/topics/wellness.jpg",    title: "Hurricane Prep for Daytona Residents",  description: "The local checklist that actually gets you ready for storm season.",             href: "/daytona/guides/live/" },
    { img: "/images/topics/culture.jpg",     title: "Local Gardening in Zone 9b",            description: "Discover what thrives in Daytona's soil and exactly when to plant it.",          href: "/daytona/guides/live/" },
    { img: "/images/topics/real-estate.jpg", title: "Terrazzo Restoration at Home",          description: "Bring vintage floors back to life the right way — from grinding to sealing.",   href: "/daytona/guides/live/" },
  ],
  work: [
    { img: "/images/topics/history.jpg",     title: "Small Business Insurance in Florida",     description: "Cut through the noise with a guide built for Daytona-area business owners.",   href: "/daytona/guides/work/" },
    { img: "/images/topics/culture.jpg",     title: "Networking Events in Volusia County",     description: "The events, orgs, and meetups where Daytona's business community shows up.",    href: "/daytona/guides/work/" },
    { img: "/images/topics/real-estate.jpg", title: "Best Coworking Spaces in Daytona",       description: "Real desks, fast internet, and people worth meeting.",                          href: "/daytona/guides/work/" },
    { img: "/images/topics/business.jpg",    title: "Starting a Business in Volusia County",  description: "The permits, registrations, and resources you actually need to launch.",         href: "/daytona/guides/work/" },
  ],
  play: [
    { img: "/images/topics/sports.jpg",      title: "Best Surfing Beaches in Daytona",        description: "Where to paddle out depending on swell and season.",                            href: "/daytona/guides/play/" },
    { img: "/images/topics/wellness.jpg",    title: "Hidden Fishing Holes in Volusia",         description: "Backwater spots, creek mouths, and tidal flats worth a sunrise trip.",          href: "/daytona/guides/play/" },
    { img: "/images/topics/city.jpg",        title: "Dog-Friendly Parks in Daytona Beach",    description: "Parks, trails, and off-leash zones worth the car ride.",                        href: "/daytona/guides/play/" },
    { img: "/images/topics/culture.jpg",     title: "Arts & Culture Hidden Gems",              description: "Beyond the boardwalk — galleries, studios, and live music venues.",              href: "/daytona/guides/play/" },
  ],
  best: [
    { img: "/images/topics/wellness.jpg",    title: "Basics & Pets: Essential Services Guide", description: "The vets, groomers, and pet stores locals actually recommend.",                  href: "/daytona/guides/best/" },
    { img: "/images/topics/city.jpg",        title: "Health & Wellness in Daytona Beach",      description: "Top clinics, specialists, and wellness centers in Volusia County.",              href: "/daytona/guides/best/" },
    { img: "/images/topics/real-estate.jpg", title: "Home Services You Can Trust",             description: "Plumbers, electricians, and contractors with real local reviews.",               href: "/daytona/guides/best/" },
    { img: "/images/topics/culture.jpg",     title: "City & Safety: Volusia County Resources", description: "Emergency contacts, county resources, and local safety information.",            href: "https://www.volusia.org/services/public-protection/emergency-management/", external: true },
  ],
};

/* ── Build dynamic sections (COAST / DRIVE / SURF) from guides collection ── */
const topicConfig: { topic: "Live" | "Work" | "Play"; slug: string; brand: string; bg: "white" | "grey" }[] = [
  { topic: "Live", slug: "live", brand: "COAST", bg: "white" },
  { topic: "Work", slug: "work", brand: "DRIVE", bg: "grey"  },
  { topic: "Play", slug: "play", brand: "SURF",  bg: "white" },
];

const sections: SectionDef[] = [
  ...topicConfig.map(({ topic, slug, brand, bg }) => {
    const topicGuides = allGuides
      .filter((g) => g.data.topic === topic)
      .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

    const collectionArticles: ArticleItem[] = topicGuides.slice(0, 4).map((g) => ({
      img: g.data.image ?? fallbackImgs[topic],
      title: g.data.title,
      description: g.data.description,
      href: `/daytona/guides/${guideSlug(g)}/`,
    }));

    /* Fill remaining slots with hardcoded placeholders so sections always look full */
    const articles = [
      ...collectionArticles,
      ...hardcodedArticles[slug].slice(collectionArticles.length),
    ].slice(0, 4);

    return {
      id: slug,
      brand,
      slug,
      bg,
      subcategories: subcategoryLinks[slug],
      articles,
      viewAllHref: `/daytona/guides/${slug}/`,
      viewAllLabel: `View More ${brand}`,
    };
  }),
  /* ── ESSENTIALS — hardcoded section (guides collection has no "Best" topic) ── */
  {
    id: "best",
    brand: "ESSENTIALS",
    slug: "best",
    bg: "grey",
    subcategories: subcategoryLinks.best,
    articles: hardcodedArticles.best,
    viewAllHref: "/daytona/guides/best/",
    viewAllLabel: "View More ESSENTIALS",
  },
];
---

<Base
  title="Daytona Guides | GoDoDaytona"
  subtitle="Your local guide to living, working, and playing in Daytona Beach."
  cityBase="daytona"
>
  <div class="ghWrap">

    {/* ── PAGE HERO: 4-BLOCK NAV GRID ── */}
    <div class="ghHeroGrid">

      <div class="ghGridBreadcrumb">
        <a href="/daytona/">GoDo Daytona</a>
        <span class="ghCrumbSep">›</span>
        <span>Guides</span>
      </div>

      <div class="ghBlocks">
        <a class="ghBlock ghBlock--coast" href="/daytona/guides/live/" aria-label="COAST — Live guides">
          <div class="ghBlockOverlay"></div>
          <div class="ghBlockContent">
            <span class="ghBlockAction">COAST</span>
            <span class="ghBlockCategory">[Live]</span>
          </div>
        </a>
        <a class="ghBlock ghBlock--drive" href="/daytona/guides/work/" aria-label="DRIVE — Work guides">
          <div class="ghBlockOverlay"></div>
          <div class="ghBlockContent">
            <span class="ghBlockAction">DRIVE</span>
            <span class="ghBlockCategory">[Work]</span>
          </div>
        </a>
        <a class="ghBlock ghBlock--surf" href="/daytona/guides/play/" aria-label="SURF — Play guides">
          <div class="ghBlockOverlay"></div>
          <div class="ghBlockContent">
            <span class="ghBlockAction">SURF</span>
            <span class="ghBlockCategory">[Play]</span>
          </div>
        </a>
        <a class="ghBlock ghBlock--essentials" href="/daytona/guides/best/" aria-label="ESSENTIALS — Best guides">
          <div class="ghBlockOverlay"></div>
          <div class="ghBlockContent">
            <span class="ghBlockAction">ESSENTIALS</span>
            <span class="ghBlockCategory">[Best]</span>
          </div>
        </a>
      </div>
    </div>{/* end .ghHeroGrid */}

    {/* ── FOUR STACKED SECTIONS ── */}
    {sections.map((s) => (
      <section class={`ghSection ghSection--${s.bg}`} id={s.id}>

        {/* Wide category hero photo banner */}
        <div class={`ghSectionHero ghSectionHero--${s.id}`}>
          <div class="ghSectionHeroOverlay"></div>
          <div class="container ghSectionHeroContent">
            <h2 class="ghSectionHeroTitle">{s.brand}</h2>
          </div>
        </div>

        {/* Subcategory ribbon — links to section anchors on category page */}
        <div class="ghSubRibbonOuter">
          <div class="container">
            <nav class="ghSubRibbon" aria-label={`${s.brand} subcategories`}>
              {s.subcategories.map((sub) => (
                <a class="ghSubRibbonItem" href={sub.href}>{sub.label}</a>
              ))}
            </nav>
          </div>
        </div>

        {/* Uniform 4-article grid */}
        <div class="container">
          <div class="ghArticleGrid">
            {s.articles.map((art) => (
              <a
                class="ghArticleCard"
                href={art.href}
                target={art.external ? "_blank" : undefined}
                rel={art.external ? "noopener noreferrer" : undefined}
              >
                <div class="ghCardImgWrap">
                  <img
                    class="ghCardImg"
                    src={art.img}
                    alt={art.title}
                    loading="lazy"
                    decoding="async"
                    onerror="this.style.display='none';this.nextElementSibling.style.display='block'"
                  />
                  <div class="ghCardImgFallback" aria-hidden="true"></div>
                </div>
                <div class="ghCardBody">
                  <h3 class="ghCardTitle">{art.title}</h3>
                  {art.description && <p class="ghCardDesc">{art.description}</p>}
                  {art.external && <span class="ghCardExternalBadge">↗ External</span>}
                </div>
              </a>
            ))}
          </div>

          {/* View More button */}
          <div class="ghViewMoreRow">
            <a class="ghViewMoreBtn" href={s.viewAllHref}>{s.viewAllLabel} →</a>
          </div>
        </div>

      </section>
    ))}

  </div>{/* end .ghWrap */}

  <style>
    /* ── Wrap ── */
    .ghWrap { min-height: 100vh; }

    /* ══ 4-BLOCK NAV GRID ═══════════════════════════════════════════════ */

    .ghHeroGrid {
      border-bottom: 2px solid var(--brand1, #ffd24a);
    }

    .ghGridBreadcrumb {
      font-size: 13px;
      font-weight: 600;
      color: var(--faint);
      padding: 16px 24px 12px;
      display: flex;
      align-items: center;
      gap: 6px;
      background: var(--surface);
    }
    .ghGridBreadcrumb a { color: var(--brand1, #ffd24a); text-decoration: none; }
    .ghGridBreadcrumb a:hover { text-decoration: underline; }
    .ghCrumbSep { opacity: .5; }

    /* 4×1 nav card row */
    .ghBlocks {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      padding: 14px 20px 18px;
      background: var(--surface);
    }

    .ghBlock {
      position: relative;
      display: flex;
      align-items: flex-end;
      justify-content: flex-start;
      overflow: hidden;
      text-decoration: none;
      background-color: #1c2028;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,0.08);
      min-height: 110px;
      transition: border-color 220ms ease, box-shadow 220ms ease, transform 160ms ease;
    }
    .ghBlock:hover {
      border-color: rgba(255,210,74,0.45);
      box-shadow: 0 6px 24px rgba(0,0,0,0.35);
      transform: translateY(-2px);
    }

    .ghBlock--coast    { --block-bg-img: url('/images/guides/coast-bg.jpg');      background-color: #1e2530; }
    .ghBlock--drive    { --block-bg-img: url('/images/guides/drive-bg.jpg');      background-color: #1a2020; }
    .ghBlock--surf     { --block-bg-img: url('/images/guides/surf-bg.jpg');       background-color: #1c2030; }
    .ghBlock--essentials { --block-bg-img: url('/images/guides/essentials-bg.jpg'); background-color: #201c28; }

    .ghBlockOverlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(160deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.55) 60%, rgba(0,0,0,0.80) 100%);
      transition: background 280ms ease;
    }
    .ghBlock:hover .ghBlockOverlay {
      background: linear-gradient(160deg, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.38) 60%, rgba(0,0,0,0.65) 100%);
    }
    .ghBlock::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: var(--block-bg-img, none);
      background-size: cover;
      background-position: center;
      transition: transform 380ms ease;
    }
    .ghBlock:hover::before { transform: scale(1.04); }

    .ghBlockContent {
      position: relative;
      z-index: 1;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    .ghBlockAction {
      display: block;
      font-family: "Montserrat", "Century Gothic", AppleGothic, Arial, sans-serif;
      font-size: clamp(1.05rem, 1.7vw, 1.45rem);
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #ffffff;
      line-height: 1;
      transition: color 200ms ease;
    }
    .ghBlockCategory {
      display: block;
      font-family: "Montserrat", "Century Gothic", AppleGothic, Arial, sans-serif;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      color: #ffd24a;
      line-height: 1;
    }
    .ghBlock:hover .ghBlockAction   { color: #ffd24a; }
    .ghBlock:hover .ghBlockCategory { color: rgba(255,210,74,0.85); }

    .ghBlock--surf::after {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: #ffd24a;
      z-index: 2;
    }

    @media (max-width: 860px) {
      .ghBlocks { grid-template-columns: 1fr 1fr; gap: 8px; padding: 12px 16px 16px; }
    }
    @media (max-width: 640px) {
      .ghBlocks { grid-template-columns: 1fr 1fr; gap: 6px; padding: 10px 12px 14px; }
      .ghBlock { min-height: 88px; }
      .ghBlockContent { padding: 10px 12px; }
    }

    /* ══ END NAV GRID ════════════════════════════════════════════════════ */

    /* ── Section shells ── */
    .ghSection { padding: 0 0 48px; }
    .ghSection--white { background: var(--surface); }
    .ghSection--grey  { background: var(--surface2); border-bottom: 1px solid var(--border); }

    /* ── Wide category hero photo banner ── */
    .ghSectionHero {
      position: relative;
      width: 100%;
      min-height: 200px;
      display: flex;
      align-items: center;
      background-color: #2E3E52;
      background-size: cover;
      background-position: center;
      border-top: 3px solid #ffd24a;
      border-bottom: 3px solid #ffd24a;
      margin-bottom: 0;
    }

    /* Background images — drop matching files into /public/images/guides/ */
    .ghSectionHero--live { background-image: url('/images/guides/coast-banner.jpg'); }
    .ghSectionHero--work { background-image: url('/images/guides/drive-banner.jpg'); }
    .ghSectionHero--play { background-image: url('/images/guides/surf-banner.jpg');  }
    .ghSectionHero--best { background-image: url('/images/guides/essentials-banner.jpg'); }

    .ghSectionHeroOverlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        100deg,
        rgba(0,0,0,0.72) 0%,
        rgba(0,0,0,0.42) 55%,
        rgba(0,0,0,0.22) 100%
      );
    }

    .ghSectionHeroContent {
      position: relative;
      z-index: 1;
      padding: 36px 0;
    }

    .ghSectionHeroTitle {
      font-family: "Montserrat", "Century Gothic", AppleGothic, Arial, sans-serif;
      font-size: clamp(2.2rem, 5vw, 3.8rem);
      font-weight: 900;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #ffffff;
      margin: 0;
      line-height: 1;
      text-shadow: 0 2px 12px rgba(0,0,0,0.5);
    }

    /* ── Subcategory ribbon (below hero banner) ── */
    .ghSubRibbonOuter {
      background: var(--surface);
      border-bottom: 2px solid var(--border);
      margin-bottom: 28px;
    }
    .ghSection--grey .ghSubRibbonOuter {
      background: var(--surface2);
    }

    .ghSubRibbon {
      display: flex;
      align-items: stretch;
      overflow-x: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .ghSubRibbon::-webkit-scrollbar { display: none; }

    .ghSubRibbonItem {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      padding: 0 20px;
      height: 44px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: var(--muted);
      text-decoration: none;
      border-bottom: 3px solid transparent;
      transition: color 140ms ease, border-color 140ms ease;
      white-space: nowrap;
    }
    .ghSubRibbonItem + .ghSubRibbonItem {
      border-left: 1px solid var(--border);
    }
    .ghSubRibbonItem:hover {
      color: #ffd24a;
      border-bottom-color: #ffd24a;
    }

    /* ── Uniform 4-article grid ── */
    .ghArticleGrid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    @media (max-width: 1024px) {
      .ghArticleGrid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 480px) {
      .ghArticleGrid { grid-template-columns: 1fr; }
    }

    /* ── Article card ── */
    .ghArticleCard {
      display: flex;
      flex-direction: column;
      text-decoration: none;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--border);
      background: var(--panel);
      transition: box-shadow 200ms ease, transform 200ms ease;
    }
    .ghArticleCard:hover {
      box-shadow: 0 8px 28px rgba(0,0,0,0.28);
      transform: translateY(-3px);
    }

    .ghCardImgWrap {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      background: var(--surface2);
      flex-shrink: 0;
    }
    .ghCardImg {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 320ms ease;
    }
    .ghArticleCard:hover .ghCardImg { transform: scale(1.04); }
    .ghCardImgFallback {
      display: none;
      position: absolute;
      inset: 0;
      background: var(--surface2);
    }

    .ghCardBody {
      padding: 14px 16px 18px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      flex: 1;
    }
    .ghCardTitle {
      font-size: 15px;
      font-weight: 700;
      color: var(--text);
      line-height: 1.25;
      margin: 0;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      transition: color 130ms ease;
    }
    .ghArticleCard:hover .ghCardTitle { color: #ffd24a; }
    .ghCardDesc {
      font-size: 13px;
      color: var(--muted);
      line-height: 1.5;
      margin: 0;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .ghCardExternalBadge {
      font-size: 11px;
      font-weight: 700;
      color: #ffd24a;
      letter-spacing: 0.06em;
      margin-top: auto;
      padding-top: 4px;
    }

    /* ── View More button ── */
    .ghViewMoreRow {
      margin-top: 28px;
      text-align: center;
      padding-bottom: 4px;
    }
    .ghViewMoreBtn {
      display: inline-flex;
      align-items: center;
      height: 42px;
      padding: 0 28px;
      border-radius: 999px;
      border: 2px solid #ffd24a;
      background: transparent;
      color: #ffd24a;
      font-size: 14px;
      font-weight: 800;
      text-decoration: none;
      letter-spacing: 0.03em;
      transition: background 140ms ease, color 140ms ease, box-shadow 140ms ease;
    }
    .ghViewMoreBtn:hover {
      background: #ffd24a;
      color: #0b0d10;
      box-shadow: 0 0 0 4px rgba(255,210,74,0.22);
    }

    /* ── Mobile ── */
    @media (max-width: 640px) {
      .ghSection { padding: 0 0 32px; }
      .ghSectionHero { min-height: 140px; }
      .ghSectionHeroContent { padding: 24px 0; }
      .ghSectionHeroTitle { font-size: clamp(1.6rem, 7vw, 2.2rem); }
      .ghSubRibbonItem { padding: 0 14px; font-size: 11px; height: 38px; }
      .ghArticleGrid { gap: 14px; }
      .ghViewMoreRow { margin-top: 20px; }
    }
  </style>
</Base>
