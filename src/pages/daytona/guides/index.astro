---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";

const allGuides = await getCollection("guides");
const sorted = [...allGuides].sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

function guideSlug(g: (typeof allGuides)[number]) {
  return g.slug.split("/").pop()!;
}

function fmtDate(d: Date) {
  return d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
}

const SECTIONS = [
  { topic: "COAST" as const, slug: "coast", accent: "#0E3F6E", neon: "#bf94ff" },
  { topic: "DRIVE" as const, slug: "drive", accent: "#7A2F00", neon: "#00ff9d" },
  { topic: "SURF"  as const, slug: "surf",  accent: "#004E64", neon: "#ff6ad5" },
  { topic: "LOCAL" as const, slug: "local", accent: "#1C3E1F", neon: "#ffef78" },
];

const sections = SECTIONS
  .map(s => ({ ...s, guides: sorted.filter(g => g.data.topic === s.topic) }));
---

<Base title="Guides — GoDo Daytona" cityBase="daytona">
  <div class="gd-page">

    <!-- Breadcrumb -->
    <div class="gd-breadcrumb">
      <a href="/daytona/">GoDo Daytona</a>
      <span aria-hidden="true">›</span>
      <span>Guides</span>
    </div>

    <!-- Page header -->
    <header class="gd-header">
      <div class="gd-header-inner">
        <h1 class="gd-header-title">Daytona's Guide</h1>
        <p class="gd-header-sub">Your definitive local source for coast, culture, and community.</p>
        <nav class="gd-header-nav" aria-label="Guide topic sections">
          {sections.map(s => (
            <a class="gd-nav-link" href={`/daytona/guides/${s.slug}/`}
               style={`--nav-neon: ${s.neon};`}>
              {s.topic}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <!-- Topic sections -->
    {sections.map((s, i) => {
      const feature = s.guides[0] ?? null;
      const grid    = s.guides.slice(1, 4);
      return (
        <section class={`gd-section${i % 2 === 1 ? " gd-section--alt" : ""}`}>

          <!-- Full-width topic bar -->
          <div class="gd-topic-bar" style={`--neon: ${s.neon};`}>
            <span class="gd-topic-label">{s.topic}</span>
          </div>

          <div class="gd-section-body">

            {s.guides.length === 0 ? (
              <!-- Empty state -->
              <div class="gd-empty">
                <p class="gd-empty-msg">{s.topic} guides coming soon — check back shortly.</p>
              </div>
            ) : (
              <>
                <!-- Feature card -->
                <a class="gd-feature" href={`/daytona/guides/${guideSlug(feature)}/`}>
                  <div class="gd-feature-img">
                    {feature.data.image
                      ? <img src={feature.data.image} alt={feature.data.title} loading="lazy" decoding="async" />
                      : <div class="gd-img-fallback" aria-hidden="true" />
                    }
                  </div>
                  <div class="gd-feature-text">
                    <span class="gd-feature-eyebrow" style={`--neon: ${s.neon};`}>{s.topic}</span>
                    <h2 class="gd-feature-title">{feature.data.title}</h2>
                    {feature.data.description && (
                      <p class="gd-feature-desc">{feature.data.description}</p>
                    )}
                    <div class="gd-feature-meta">
                      {feature.data.author && <span class="gd-meta-author">{feature.data.author}</span>}
                      {feature.data.date   && <span class="gd-meta-date">{fmtDate(feature.data.date)}</span>}
                    </div>
                    <span class="gd-feature-cta" style={`color: ${s.neon};`}>Read guide →</span>
                  </div>
                </a>

                <!-- Small cards row -->
                {grid.length > 0 && (
                  <div class="gd-grid">
                    {grid.map(g => (
                      <a class="gd-card" href={`/daytona/guides/${guideSlug(g)}/`}>
                        <div class="gd-card-img">
                          {g.data.image
                            ? <img src={g.data.image} alt={g.data.title} loading="lazy" decoding="async" />
                            : <div class="gd-img-fallback" aria-hidden="true" />
                          }
                        </div>
                        <div class="gd-card-body">
                          <h3 class="gd-card-title">{g.data.title}</h3>
                          {g.data.description && (
                            <p class="gd-card-desc">{g.data.description}</p>
                          )}
                        </div>
                      </a>
                    ))}
                  </div>
                )}

                <!-- View all -->
                <div class="gd-view-more">
                  <a href={`/daytona/guides/${s.slug}/`} class="gd-view-more-link"
                     style={`--va-neon: ${s.neon};`}>
                    View all {s.topic} guides →
                  </a>
                </div>
              </>
            )}

          </div>
        </section>
      );
    })}

  </div>
</Base>

<style>
  /* ─────────────────────────────────────────────
     Page shell
  ───────────────────────────────────────────── */
  .gd-page {
    min-height: 100vh;
    background: var(--surface);
  }

  /* ─────────────────────────────────────────────
     Breadcrumb
  ───────────────────────────────────────────── */
  .gd-breadcrumb {
    max-width: 1300px;
    margin: 0 auto;
    padding: 14px 2rem 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--faint, rgba(232,237,244,.55));
    border-bottom: 1px solid var(--border);
  }
  .gd-breadcrumb a {
    color: var(--text);
    text-decoration: none;
  }
  .gd-breadcrumb a:hover { text-decoration: underline; }

  /* ─────────────────────────────────────────────
     Page header
  ───────────────────────────────────────────── */
  .gd-header {
    background: #000;
    padding: 52px 2rem 40px;
    border-bottom: 3px solid #000;
  }
  .gd-header-inner {
    max-width: 1300px;
    margin: 0 auto;
    text-align: center;
  }
  .gd-header-title {
    font-family: "Montserrat", "Century Gothic", AppleGothic, Arial, sans-serif;
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    margin: 0 0 10px;
    line-height: 1;
  }
  .gd-header-sub {
    font-size: 1rem;
    color: rgba(255,255,255,0.55);
    margin: 0 0 28px;
    font-weight: 400;
    letter-spacing: 0.01em;
  }
  .gd-header-nav {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .gd-nav-link {
    font-family: 'Monoton', cursive;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: #000 !important;
    text-decoration: none;
    padding: 10px 26px;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 999px;
    background: #060810;
    -webkit-font-smoothing: antialiased;
    text-shadow:
      0 0 1px #fff,
      0 0 8px var(--nav-neon, #fff),
      0 0 18px var(--nav-neon, #fff);
    transition: border-color 160ms, box-shadow 160ms;
  }
  .gd-nav-link:hover {
    border-color: var(--nav-neon, rgba(255,255,255,0.5));
    box-shadow: 0 0 18px color-mix(in srgb, var(--nav-neon, #fff) 30%, transparent);
  }

  /* ─────────────────────────────────────────────
     Topic section
  ───────────────────────────────────────────── */
  .gd-section {
    background: var(--surface);
    border-top: 1px solid var(--border);
  }
  .gd-section--alt {
    background: var(--surface2, #161b24);
  }

  /* Full-width header bar — neon identity */
  .gd-topic-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 30px 2rem;
    width: 100%;
    background: #060810;
    border-top: 1px solid rgba(255,255,255,0.06);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .gd-topic-label {
    font-family: 'Monoton', cursive;
    font-size: clamp(2.6rem, 5.5vw, 5rem);
    color: #000 !important;
    line-height: 1;
    text-align: center;
    -webkit-font-smoothing: antialiased;
    text-shadow:
      0 0 2px #fff,
      0 0 10px var(--neon),
      0 0 28px var(--neon),
      0 0 55px var(--neon);
  }

  /* Inner container */
  .gd-section-body {
    max-width: 1300px;
    margin: 0 auto;
    padding: 40px 2rem 56px;
  }

  /* ─────────────────────────────────────────────
     Feature card  (horizontal: image left, text right)
  ───────────────────────────────────────────── */
  .gd-feature {
    display: grid;
    grid-template-columns: 3fr 2fr;
    text-decoration: none;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--panel, var(--surface));
    margin-bottom: 20px;
    transition: box-shadow 200ms ease, transform 200ms ease;
  }
  .gd-feature:hover {
    box-shadow: 0 12px 42px rgba(0,0,0,0.28);
    transform: translateY(-3px);
  }

  .gd-feature-img {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface2);
  }
  .gd-feature-img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 360ms ease;
  }
  .gd-feature:hover .gd-feature-img img { transform: scale(1.04); }

  .gd-feature-text {
    padding: 36px 36px 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    justify-content: center;
  }
  .gd-feature-eyebrow {
    display: inline-block;
    background: #060810;
    color: #000 !important;
    font-family: 'Monoton', cursive;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    padding: 5px 14px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.1);
    -webkit-font-smoothing: antialiased;
    text-shadow:
      0 0 1px #fff,
      0 0 8px var(--neon),
      0 0 18px var(--neon);
    align-self: flex-start;
  }
  .gd-feature-title {
    font-family: "Montserrat", "Century Gothic", AppleGothic, Arial, sans-serif;
    font-size: clamp(1.6rem, 2.6vw, 2.3rem);
    font-weight: 900;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--text);
    margin: 0;
    transition: color 130ms;
  }
  .gd-feature:hover .gd-feature-title { color: var(--brand1); }
  .gd-feature-desc {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .gd-feature-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 4px;
  }
  .gd-meta-author {
    font-size: 13px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.02em;
  }
  .gd-meta-date {
    font-size: 12px;
    color: var(--faint, rgba(232,237,244,.55));
    letter-spacing: 0.02em;
  }
  .gd-feature-cta {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.04em;
    margin-top: 4px;
    transition: opacity 130ms;
  }
  .gd-feature:hover .gd-feature-cta { opacity: 0.75; }

  /* Responsive: stack on smaller screens */
  @media (max-width: 960px) {
    .gd-feature {
      grid-template-columns: 1fr;
    }
    .gd-feature-img { aspect-ratio: 16/9; }
    .gd-feature-text { padding: 22px 24px 28px; gap: 10px; }
  }

  /* ─────────────────────────────────────────────
     Small cards grid (3 columns)
  ───────────────────────────────────────────── */
  .gd-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 24px;
  }
  @media (max-width: 860px) { .gd-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .gd-grid { grid-template-columns: 1fr; gap: 14px; } }

  .gd-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--panel, var(--surface));
    transition: box-shadow 200ms ease, transform 200ms ease;
  }
  .gd-card:hover {
    box-shadow: 0 8px 28px rgba(0,0,0,.22);
    transform: translateY(-2px);
  }

  .gd-card-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface2);
    flex-shrink: 0;
  }
  .gd-card-img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 300ms ease;
  }
  .gd-card:hover .gd-card-img img { transform: scale(1.04); }

  .gd-card-body { padding: 16px 18px 20px; display: flex; flex-direction: column; gap: 8px; }
  .gd-card-title {
    font-size: 17px;
    font-weight: 800;
    line-height: 1.28;
    color: var(--text);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 130ms;
  }
  .gd-card:hover .gd-card-title { color: var(--brand1); }
  .gd-card-desc {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ─────────────────────────────────────────────
     Fallback & view-more
  ───────────────────────────────────────────── */
  .gd-img-fallback { width: 100%; height: 100%; background: var(--surface2); }

  .gd-view-more { text-align: right; }
  .gd-view-more-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
    border-bottom: 2px solid var(--va-neon, var(--brand1));
    padding-bottom: 2px;
    transition: opacity 130ms;
  }
  .gd-view-more-link:hover { opacity: 0.7; }

  /* Empty state */
  .gd-empty {
    padding: 40px 0 16px;
    text-align: center;
  }
  .gd-empty-msg {
    font-size: 1rem;
    color: var(--muted);
    font-style: italic;
    letter-spacing: 0.02em;
    margin: 0;
  }

  /* ─────────────────────────────────────────────
     Mobile
  ───────────────────────────────────────────── */
  @media (max-width: 640px) {
    .gd-header { padding: 36px 1rem 28px; }
    .gd-header-sub { display: none; }
    .gd-topic-bar { padding: 16px 1rem; }
    .gd-section-body { padding: 28px 1rem 40px; }
    .gd-breadcrumb { padding: 12px 1rem; }
  }
</style>
