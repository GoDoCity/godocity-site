---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";

const allGuides = await getCollection("guides");
const sorted = [...allGuides].sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

function guideSlug(g: (typeof allGuides)[number]) {
  return g.slug.split("/").pop()!;
}

const featuredGuides = sorted.filter(g => g.data.featured === true).slice(0, 4);

const SECTIONS = [
  { brand: "COAST", topic: "COAST", mod: "coast", bg: "white" },
  { brand: "DRIVE", topic: "DRIVE", mod: "drive", bg: "grey"  },
  { brand: "SURF",  topic: "SURF",  mod: "surf",  bg: "white" },
  { brand: "LOCAL", topic: "LOCAL", mod: "local", bg: "grey"  },
] as const;

const sectionGuides = SECTIONS.map(s => ({
  ...s,
  guides: sorted.filter(g => g.data.topic === s.topic),
}));
---

<Base
  title="Guides"
  cityBase="daytona"
>
  <div class="ghWrap">

    {/* ── BREADCRUMB ── */}
    <div class="ghGridBreadcrumb">
      <a href="/daytona/">GoDo Daytona</a>
      <span class="ghCrumbSep">›</span>
      <span>Guides</span>
    </div>

    {/* ── PAGE HERO: "Daytona's Guide" banner with 4-block nav inside ── */}
    <div class="ghPageHero">
      <div class="ghPageHeroContent">
        <h1 class="ghPageHeroTitle">Daytona's Guide</h1>
        <div class="ghBlocks">
          <a class="ghBlock ghBlock--coast" href="/daytona/guides/coast/" aria-label="COAST guides">
            <div class="ghBlockOverlay"></div>
            <div class="ghBlockContent">
              <span class="ghBlockAction">COAST</span>
            </div>
          </a>
          <a class="ghBlock ghBlock--drive" href="/daytona/guides/drive/" aria-label="DRIVE guides">
            <div class="ghBlockOverlay"></div>
            <div class="ghBlockContent">
              <span class="ghBlockAction">DRIVE</span>
            </div>
          </a>
          <a class="ghBlock ghBlock--surf" href="/daytona/guides/surf/" aria-label="SURF guides">
            <div class="ghBlockOverlay"></div>
            <div class="ghBlockContent">
              <span class="ghBlockAction">SURF</span>
            </div>
          </a>
          <a class="ghBlock ghBlock--local" href="/daytona/guides/local/" aria-label="LOCAL guides">
            <div class="ghBlockOverlay"></div>
            <div class="ghBlockContent">
              <span class="ghBlockAction">LOCAL</span>
            </div>
          </a>
        </div>
      </div>
    </div>

    {/* ══ FEATURED HUB ══════════════════════════════════════════════════ */}
    {featuredGuides.length > 0 && (
      <section class="hub hubFeatured">
        <div class="hubInner">
          <div class="hubHead">
            <span class="hubHeadLabel">Featured</span>
            <div class="hubHeadLine" aria-hidden="true" />
          </div>

          <div class="hubHeroGrid">

            {/* Primary hero card */}
            <a class="hubHeroCard" href={`/daytona/guides/${guideSlug(featuredGuides[0])}/`}>
              <div class="hubHeroImgWrap">
                {featuredGuides[0].data.image
                  ? <img class="hubHeroImg" src={featuredGuides[0].data.image} alt={featuredGuides[0].data.title} loading="eager" decoding="async" />
                  : <div class="hubHeroImg hubImgFallback" aria-hidden="true" />
                }
              </div>
              <div class="hubHeroBody">
                {featuredGuides[0].data.topic && (
                  <span class="hubCategoryPill">{featuredGuides[0].data.topic}</span>
                )}
                <h2 class="hubHeroTitle">{featuredGuides[0].data.title}</h2>
                {featuredGuides[0].data.description && (
                  <p class="hubHeroDesc">{featuredGuides[0].data.description}</p>
                )}
                <span class="hubReadMore">Read guide →</span>
              </div>
            </a>

            {/* Secondary stack (up to 3) */}
            {featuredGuides.length > 1 && (
              <div class="hubSecondaryStack">
                {featuredGuides.slice(1).map(g => (
                  <a class="hubSecCard" href={`/daytona/guides/${guideSlug(g)}/`}>
                    <div class="hubSecImgWrap">
                      {g.data.image
                        ? <img class="hubSecImg" src={g.data.image} alt={g.data.title} loading="lazy" decoding="async" />
                        : <div class="hubSecImg hubImgFallback" aria-hidden="true" />
                      }
                    </div>
                    <div class="hubSecBody">
                      {g.data.topic && <span class="hubCategoryPill hubCategoryPill--sm">{g.data.topic}</span>}
                      <h3 class="hubSecTitle">{g.data.title}</h3>
                    </div>
                  </a>
                ))}
              </div>
            )}

          </div>
        </div>
      </section>
    )}

    {/* ══ CATEGORY SECTIONS ══════════════════════════════════════════════ */}
    {sectionGuides.map(s => s.guides.length > 0 && (
      <section class={`hub hubCat hubCat--${s.bg}`}>
        <div class="hubInner">

          <div class="hubCatHead hubCatHead--${s.mod}">
            <span class="hubCatBrand">{s.brand}</span>
          </div>

          <div class="hubCatGrid">
            {s.guides.map(g => (
              <a class="hubCatCard" href={`/daytona/guides/${guideSlug(g)}/`}>
                <div class="hubCatImgWrap">
                  {g.data.image
                    ? <img class="hubCatImg" src={g.data.image} alt={g.data.title} loading="lazy" decoding="async" />
                    : <div class="hubCatImg hubImgFallback" aria-hidden="true" />
                  }
                </div>
                <div class="hubCatBody">
                  <h3 class="hubCatTitle">{g.data.title}</h3>
                  {g.data.description && <p class="hubCatDesc">{g.data.description}</p>}
                </div>

              </a>
            ))}
          </div>

        </div>
      </section>
    ))}

  </div>{/* end .ghWrap */}

  <style>
    /* ── Wrap ── */
    .ghWrap { min-height: 100vh; }

    /* ── Breadcrumb (above hero) ── */
    .ghGridBreadcrumb {
      font-size: 13px;
      font-weight: 600;
      color: var(--faint);
      padding: 14px 24px 10px;
      display: flex;
      align-items: center;
      gap: 6px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
    }
    .ghGridBreadcrumb a { color: var(--text); text-decoration: none; }
    .ghGridBreadcrumb a:hover { text-decoration: underline; }
    .ghCrumbSep { opacity: .5; }

    /* ══ PAGE HERO — "Daytona's Guide" banner with nav blocks ══════════ */
    .ghPageHero {
      position: relative;
      width: 100%;
      min-height: 320px;
      display: flex;
      align-items: stretch;
      background: #000000 !important;
      background-color: #000000 !important;
      border-bottom: 3px solid #000;
      box-shadow: none !important;
      overflow: hidden;
    }

    .ghPageHeroContent {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: var(--max, 1360px);
      margin: 0 auto;
      padding: 40px 24px 28px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      text-align: center;
    }

    .ghPageHeroTitle {
      font-family: "Montserrat", "Century Gothic", AppleGothic, Arial, sans-serif;
      font-size: clamp(3.25rem, 6.875vw, 5.25rem);
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #ffffff;
      margin: 0 auto;
      line-height: 1;
      text-shadow: 0 2px 20px rgba(0,0,0,0.7), 0 0 40px rgba(255,210,74,0.18);
      text-align: center;
      width: 100%;
    }

    .ghPageHeroTagline {
      font-size: clamp(0.88rem, 1.5vw, 1.05rem);
      color: rgba(255,255,255,0.72);
      margin: 0 0 18px;
      font-weight: 400;
      text-shadow: 0 1px 6px rgba(0,0,0,0.4);
      text-align: center;
    }

    /* 4-block nav row inside hero */
    .ghBlocks {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      width: 100%;
    }

    .ghBlock {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      text-decoration: none;
      background-color: #1c2028;
      border-radius: 16px;
      border: none;
      min-height: 72px;
      transition: box-shadow 220ms ease, transform 160ms ease;
    }
    .ghBlock:hover {
      box-shadow: 0 6px 24px rgba(0,0,0,0.35);
      transform: translateY(-2px);
    }

    /* Spring Glow pastel neon rings — temporary Easter override */
    .ghBlock--coast    {
      --block-bg-img: url('/images/guides/coast-bg.jpg');
      --pill-color: #bf94ff;
      background-color: #1e2530;
      border-radius: 16px;
      box-shadow:
        0 0 10px rgba(191,148,255,0.5),
        0 0 24px rgba(191,148,255,0.25);
    }
    .ghBlock--coast:hover {
      box-shadow:
        0 0 22px rgba(191,148,255,0.75),
        0 0 45px rgba(191,148,255,0.4),
        0 6px 24px rgba(0,0,0,0.35);
    }
    .ghBlock--drive    {
      --block-bg-img: url('/images/guides/drive-bg.jpg');
      --pill-color: #00ff9d;
      background-color: #1a2020;
      border-radius: 16px;
      box-shadow:
        0 0 10px rgba(0,255,157,0.5),
        0 0 24px rgba(0,255,157,0.25);
    }
    .ghBlock--drive:hover {
      box-shadow:
        0 0 22px rgba(0,255,157,0.75),
        0 0 45px rgba(0,255,157,0.4),
        0 6px 24px rgba(0,0,0,0.35);
    }
    .ghBlock--surf     {
      --block-bg-img: url('/images/guides/surf-bg.jpg');
      --pill-color: #ff6ad5;
      background-color: #1c2030;
      border-radius: 16px;
      box-shadow:
        0 0 10px rgba(255,106,213,0.5),
        0 0 24px rgba(255,106,213,0.25);
    }
    .ghBlock--surf:hover {
      box-shadow:
        0 0 22px rgba(255,106,213,0.75),
        0 0 45px rgba(255,106,213,0.4),
        0 6px 24px rgba(0,0,0,0.35);
    }
    .ghBlock--local {
      --block-bg-img: url('/images/guides/essentials-bg.jpg');
      --pill-color: #ffef78;
      background-color: #201c28;
      border-radius: 16px;
      box-shadow:
        0 0 10px rgba(255,239,120,0.5),
        0 0 24px rgba(255,239,120,0.25);
    }
    .ghBlock--local:hover {
      box-shadow:
        0 0 22px rgba(255,239,120,0.75),
        0 0 45px rgba(255,239,120,0.4),
        0 6px 24px rgba(0,0,0,0.35);
    }

    .ghBlockOverlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(160deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.55) 60%, rgba(0,0,0,0.80) 100%);
      transition: background 280ms ease;
    }
    .ghBlock:hover .ghBlockOverlay {
      background: linear-gradient(160deg, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.38) 60%, rgba(0,0,0,0.65) 100%);
    }
    .ghBlock::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: var(--block-bg-img, none);
      background-size: cover;
      background-position: center;
      transition: transform 380ms ease;
    }
    .ghBlock:hover::before { transform: scale(1.04); }

    .ghBlockContent {
      position: relative;
      z-index: 1;
      padding: 10px 14px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      text-align: center;
    }
    .ghBlockAction {
      display: block;
      font-family: 'Monoton', cursive;
      font-size: clamp(1.4rem, 2.4vw, 2.2rem);
      font-weight: 900;
      letter-spacing: 1px;
      color: #000000 !important;
      line-height: 1.1;
      text-align: center;
      -webkit-font-smoothing: antialiased;
      text-shadow: 0 0 1px #FFFFFF, 0 0 8px var(--pill-color), 0 0 15px var(--pill-color);
      transition: color 200ms ease, text-shadow 200ms ease;
    }
    .ghBlockCategory {
      display: block;
      font-family: "Montserrat", "Century Gothic", AppleGothic, Arial, sans-serif;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      color: var(--text);
      line-height: 1;
      text-align: center;
      width: 100%;
      margin: 2px auto 0;
    }
    .ghBlock:hover .ghBlockAction   { color: #ffffff !important; text-shadow: 0 0 1px rgba(0,0,0,.5), 0 0 8px rgba(0,119,190,.8), 0 0 15px rgba(0,169,206,.6); }
    .ghBlock:hover .ghBlockCategory { color: rgba(255,255,255,0.85); }

    @media (max-width: 860px) {
      .ghBlocks { grid-template-columns: 1fr 1fr; gap: 8px; }
    }
    @media (max-width: 640px) {
      .ghBlocks { grid-template-columns: 1fr 1fr; gap: 6px; }
      .ghBlock { min-height: 58px; }
      .ghBlockContent { padding: 8px 10px; }
      /* +40% neon title scaling on mobile — plenty of horizontal room */
      .ghBlockAction { font-size: clamp(1.96rem, 5vw, 3.08rem); }
      .ghBlockCategory { font-size: 1rem; }
      .ghPageHeroContent { padding: 28px 16px 20px; }
      .ghPageHeroTagline { margin-bottom: 12px; }
      /* Mobile ribbon: no wrap, horizontal swipe */
      .ghSubRibbon {
        flex-wrap: nowrap;
        overflow-x: auto;
        justify-content: flex-start;
        -webkit-overflow-scrolling: touch;
      }
      .ghSubRibbonItem {
        padding: 0 14px;
        font-size: 14px;
        height: 48px;
        flex-shrink: 0;
        white-space: nowrap;
      }
    }

    @media (max-width: 599px) {
      /* Prevent neon words from wrapping on very small screens */
      .ghBlockAction { font-size: clamp(1.1rem, 4vw, 1.5rem) !important; }
      .ghSectionHeroTitle { font-size: clamp(1.6rem, 6.5vw, 2.4rem) !important; }
    }

    /* ══ END PAGE HERO ═══════════════════════════════════════════════════ */

    /* ── Section shells ── */
    .ghSection { padding: 0 0 48px; }
    .ghSection--white { background: var(--surface); }
    .ghSection--grey  { background: var(--surface2); border-bottom: 1px solid var(--border); }

    /* ── Wide category hero photo banner ── */
    .ghSectionHero {
      position: relative;
      width: 100%;
      min-height: 200px;
      display: flex;
      align-items: center;
      background-color: #2E3E52;
      background-size: cover;
      background-position: center;
      border-top: 3px solid #000;
      border-bottom: 3px solid #000;
      margin-bottom: 0;
    }

    /* Background images — drop matching files into /public/images/guides/ */
    .ghSectionHero--live { background-image: url('/images/guides/coast-banner.jpg'); }
    .ghSectionHero--work { background-image: url('/images/guides/drive-banner.jpg'); }
    .ghSectionHero--play { background-image: url('/images/guides/surf-banner.jpg');  }
    .ghSectionHero--best { background-image: url('/images/guides/essentials-banner.jpg'); }

    .ghSectionHeroOverlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        100deg,
        rgba(0,0,0,0.72) 0%,
        rgba(0,0,0,0.42) 55%,
        rgba(0,0,0,0.22) 100%
      );
    }

    .ghSectionHeroContent {
      position: relative;
      z-index: 1;
      padding: 36px 0;
      text-align: center;
    }

    .ghSectionHero--live { --pill-color: #bf94ff; }
    .ghSectionHero--work { --pill-color: #00ff9d; }
    .ghSectionHero--play { --pill-color: #ff6ad5; }
    .ghSectionHero--best { --pill-color: #ffef78; }

    .ghSectionHeroTitle {
      font-family: 'Monoton', cursive;
      font-size: clamp(2.2rem, 5vw, 4rem);
      font-weight: 900;
      letter-spacing: 1px;
      color: #000000 !important;
      margin: 0 auto;
      line-height: 1.1;
      text-align: center;
      -webkit-font-smoothing: antialiased;
      text-shadow: 0 0 1px #FFFFFF, 0 0 8px var(--pill-color), 0 0 15px var(--pill-color);
    }

    /* ── Subcategory ribbon (below hero banner) ── */
    .ghSubRibbonOuter {
      display: flex;
      justify-content: center;
      width: 100%;
      background: var(--surface);
      border-bottom: 2px solid var(--border);
      margin-bottom: 28px;
    }
    .ghSection--grey .ghSubRibbonOuter {
      background: var(--surface2);
    }
    /* Force ribbon inner container to be centered and full-width */
    .ghSubRibbonOuter .container {
      width: 100%;
      display: flex;
      justify-content: center;
    }

    .ghSubRibbon {
      display: flex;
      flex-wrap: nowrap;
      align-items: stretch;
      justify-content: center;
      width: 100%;
      margin: 0 auto;
      overflow-x: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .ghSubRibbon::-webkit-scrollbar { display: none; }

    .ghSubRibbonItem {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      padding: 0 20px;
      height: 56px;
      font-size: 18px;
      font-weight: 800;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: var(--muted);
      text-decoration: none;
      border-bottom: 3px solid transparent;
      transition: color 140ms ease, border-color 140ms ease;
      white-space: nowrap;
    }
    /* Dot separator — replaces border-left */
    .ghSubRibbonItem + .ghSubRibbonItem::before {
      content: "•";
      margin-right: 20px;
      color: var(--muted);
      opacity: 0.5;
      font-weight: 400;
      font-size: 14px;
    }
    .ghSubRibbonItem:hover {
      color: var(--text);
      border-bottom-color: var(--text);
    }

    /* ── 2×2 article grid (4 articles per category section) ── */
    .ghArticleGrid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    @media (max-width: 480px) {
      .ghArticleGrid { grid-template-columns: 1fr; }
    }

    /* ── Article card ── */
    .ghArticleCard {
      display: flex;
      flex-direction: column;
      height: 100%;
      text-decoration: none;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--border);
      background: var(--panel);
      transition: box-shadow 200ms ease, transform 200ms ease;
    }
    .ghArticleCard:hover {
      box-shadow: 0 8px 28px rgba(0,0,0,0.28);
      transform: translateY(-3px);
    }

    .ghCardImgWrap {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 7.26;
      overflow: hidden;
      background: var(--surface2);
      flex-shrink: 0;
    }
    .ghCardImg {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 320ms ease;
    }
    .ghArticleCard:hover .ghCardImg { transform: scale(1.04); }
    .ghCardImgFallback {
      display: none;
      position: absolute;
      inset: 0;
      background: var(--surface2);
    }

    .ghCardBody {
      padding: 3px 22px 5px;
      display: flex;
      flex-direction: column;
      gap: 3px;
      flex: 1;
    }
    .ghCardTitle {
      font-size: 24px;
      font-weight: 700;
      color: var(--text);
      line-height: 1.25;
      margin: 0;
      transition: color 130ms ease;
    }
    .ghArticleCard:hover .ghCardTitle { color: var(--muted); }
    .ghCardDesc {
      font-size: 17px;
      color: var(--color-text-main);
      line-height: 1.5;
      margin: 0;
    }
    .ghCardExternalBadge {
      font-size: 15px;
      font-weight: 700;
      color: var(--text);
      letter-spacing: 0.06em;
      margin-top: auto;
      padding-top: 8px;
    }

    /* ── View More button ── */
    .ghViewMoreRow {
      margin-top: 28px;
      text-align: center;
      padding-bottom: 4px;
    }
    .ghViewMoreBtn {
      display: inline-flex;
      align-items: center;
      height: 42px;
      padding: 0 28px;
      border-radius: 999px;
      border: 2px solid var(--line);
      background: transparent;
      color: var(--text);
      font-size: 14px;
      font-weight: 800;
      text-decoration: none;
      letter-spacing: 0.03em;
      transition: background 140ms ease, color 140ms ease, box-shadow 140ms ease;
    }
    .ghViewMoreBtn:hover {
      background: var(--accent);
      color: var(--text);
      box-shadow: 0 0 0 4px rgba(255,210,74,0.22);
    }

    /* ── Mobile (legacy section styles) ── */
    @media (max-width: 640px) {
      .ghSection { padding: 0 0 32px; }
      .ghSectionHero { min-height: 140px; }
      .ghSectionHeroContent { padding: 24px 0; }
      .ghSectionHeroTitle { font-size: clamp(3.08rem, 9.8vw, 5.6rem); }
      .ghArticleGrid { gap: 14px; }
      .ghViewMoreRow { margin-top: 20px; }
      .ghCardTitle { font-size: 18px; }
      .ghCardDesc { font-size: 16px; }
      .ghCardBody { padding: 4px 14px 6px; gap: 3px; }
    }

    /* ══════════════════════════════════════════════════════════════════
       MEDIA HUB — shared container
    ══════════════════════════════════════════════════════════════════ */
    .hub { padding: 56px 0; }
    .hub + .hub { border-top: 1px solid var(--border); }
    .hubFeatured  { background: var(--surface); }
    .hubCat--white { background: var(--surface); }
    .hubCat--grey  { background: var(--surface2); }

    .hubInner {
      max-width: 1250px;
      margin: 0 auto;
      padding: 0 2.5rem;
    }
    @media (max-width: 768px) { .hubInner { padding: 0 1.25rem; } }

    /* Section heading row */
    .hubHead {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 32px;
    }
    .hubHeadLabel {
      font-size: 11px;
      font-weight: 900;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--brand1);
      white-space: nowrap;
    }
    .hubHeadLine {
      flex: 1;
      height: 2px;
      background: var(--brand1);
      border-radius: 2px;
    }

    /* Category pill */
    .hubCategoryPill {
      display: inline-block;
      font-size: 10px;
      font-weight: 900;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: #000;
      background: var(--brand1);
      padding: 3px 10px;
      border-radius: 999px;
    }
    .hubCategoryPill--sm { font-size: 9px; padding: 2px 8px; }

    /* ── Featured Hub grid ── */
