---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";

/* ── Fetch all guides from the Decap collection ── */
/* Decap saves flat to src/content/guides/ so slugs have no "daytona/" prefix */
const allGuides = await getCollection("guides");

/* ── Return only the filename segment of the slug (strips "daytona/" prefix) ── */
/* Guides live at src/content/guides/daytona/<slug>.md so g.slug is         */
/* "daytona/2026-03-20-my-guide".  The dynamic route [slug].astro captures  */
/* only the last segment, so we must strip everything before the final "/". */
function guideSlug(g: (typeof allGuides)[number]) {
  return g.slug.split("/").pop()!;
}

/* ── Fallback images per topic when a guide has no image ── */
const fallbackImgs: Record<string, string> = {
  Live: "/images/topics/real-estate.jpg",
  Work: "/images/topics/business.jpg",
  Play: "/images/topics/sports.jpg",
};

/* ── Build sections dynamically from collection, with hardcoded fallbacks ── */
type SectionDef = {
  id: string;
  label: string;
  emoji: string;
  bg: "white" | "grey";
  featured: { img: string; title: string; description: string; href: string } | null;
  articles: { img: string; title: string; description: string; href: string }[];
  viewAllHref: string;
  viewAllLabel: string;
};

const topicConfig: { topic: "Live" | "Work" | "Play"; emoji: string; bg: "white" | "grey" }[] = [
  { topic: "Live", emoji: "🏠", bg: "white" },
  { topic: "Work", emoji: "💼", bg: "grey" },
  { topic: "Play", emoji: "🎉", bg: "white" },
];

/* ── Hardcoded placeholders shown when a topic has no published guides yet ── */
const hardcodedFeatured: Record<string, SectionDef["featured"]> = {
  Live: {
    img: "/images/topics/real-estate.jpg",
    title: "Your Ultimate Guide to Daytona — Live: Terrazzo Restoration",
    description: "Daytona's homes are full of stunning vintage terrazzo floors — and most of them haven't seen proper care in decades. Here's how to bring yours back to life the right way, from grinding and polishing to long-term sealing.",
    href: "/daytona/guides/live/",
  },
  Work: {
    img: "/images/topics/business.jpg",
    title: "Your Ultimate Guide to Daytona — Work: Fleet Maintenance",
    description: "From seasonal tourism fleets to marine service rigs, Volusia County's vehicle economy runs deep. Here's who keeps it moving and how to get your operation into compliance without the runaround.",
    href: "/daytona/guides/work/",
  },
  Play: {
    img: "/images/topics/sports.jpg",
    title: "Your Ultimate Guide to Daytona — Play: Date Night Spots",
    description: "From sunset cocktails on the Intracoastal to hidden gem bistros in Ormond, we've scouted the perfect spots for your next night out. Stop guessing and start GoDo-ing.",
    href: "/daytona/guides/play/",
  },
};

const hardcodedArticles: Record<string, SectionDef["articles"]> = {
  Live: [
    { img: "/images/topics/city.jpg", title: "Your Ultimate Guide to Daytona — Live: Ormond Neighborhoods", description: "Quiet streets, great schools, and lower price points. Find out which Ormond pockets are worth a closer look.", href: "/daytona/guides/live/" },
    { img: "/images/topics/wellness.jpg", title: "Your Ultimate Guide to Daytona — Live: Hurricane Prep", description: "Daytona sits in the path of Florida's biggest storms. This is the local checklist that actually gets you ready — not the generic one.", href: "/daytona/guides/live/" },
    { img: "/images/topics/culture.jpg", title: "Your Ultimate Guide to Daytona — Live: Local Gardening", description: "Growing in Zone 9b is a different game. Discover what thrives in Daytona's soil and exactly when to plant it.", href: "/daytona/guides/live/" },
  ],
  Work: [
    { img: "/images/topics/history.jpg", title: "Your Ultimate Guide to Daytona — Work: Small Business Insurance", description: "Florida's liability landscape is brutal for small operators. Cut through the noise with a guide built for Daytona-area business owners.", href: "/daytona/guides/work/" },
    { img: "/images/topics/culture.jpg", title: "Your Ultimate Guide to Daytona — Work: Networking in Volusia", description: "The right room changes everything. These are the events, orgs, and meetups where Daytona's business community actually shows up.", href: "/daytona/guides/work/" },
    { img: "/images/topics/real-estate.jpg", title: "Your Ultimate Guide to Daytona — Work: Coworking Spaces", description: "Skip the coffee-shop WiFi. These Daytona coworking spots offer real desks, fast internet, and people worth meeting.", href: "/daytona/guides/work/" },
  ],
  Play: [
    { img: "/images/topics/sports.jpg", title: "Your Ultimate Guide to Daytona — Play: Best Surfing Beaches", description: "Daytona's waves are more consistent than people give them credit for. Here's where to paddle out depending on swell and season.", href: "/daytona/guides/play/" },
    { img: "/images/topics/wellness.jpg", title: "Your Ultimate Guide to Daytona — Play: Hidden Fishing Holes", description: "The locals aren't fishing the pier. Find the backwater spots, creek mouths, and tidal flats worth a sunrise trip.", href: "/daytona/guides/play/" },
    { img: "/images/topics/city.jpg", title: "Your Ultimate Guide to Daytona — Play: Dog-Friendly Parks", description: "Daytona is surprisingly great for dog owners. These parks, trails, and off-leash zones are worth the car ride.", href: "/daytona/guides/play/" },
  ],
};

const sections: SectionDef[] = topicConfig.map(({ topic, emoji, bg }) => {
  // Sort by date descending so the most recent guide is first
  const topicGuides = allGuides
    .filter((g) => g.data.topic === topic)
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
  // Explicit featured: true wins; otherwise the most recent guide is featured
  const featuredGuide = topicGuides.find((g) => g.data.featured) ?? topicGuides[0] ?? null;
  const articleGuides = topicGuides.filter((g) => g !== featuredGuide).slice(0, 3);

  const featured: SectionDef["featured"] = featuredGuide
    ? {
        img: featuredGuide.data.image ?? fallbackImgs[topic],
        title: featuredGuide.data.title,
        description: featuredGuide.data.description,
        href: `/daytona/guides/${guideSlug(featuredGuide)}/`,
      }
    : hardcodedFeatured[topic];

  const collectionArticles = articleGuides.map((g) => ({
    img: g.data.image ?? fallbackImgs[topic],
    title: g.data.title,
    description: g.data.description,
    href: `/daytona/guides/${guideSlug(g)}/`,
  }));

  // Fill remaining slots with hardcoded articles so sections always look full
  const articles = [
    ...collectionArticles,
    ...hardcodedArticles[topic].slice(collectionArticles.length),
  ].slice(0, 3);

  return {
    id: topic.toLowerCase(),
    label: topic,
    emoji,
    bg,
    featured,
    articles,
    viewAllHref: `/daytona/guides/${topic.toLowerCase()}/`,
    viewAllLabel: `View All ${topic} Guides`,
  };
});
---

<Base
  title="Daytona Guides | GoDoDaytona"
  subtitle="Your local guide to living, working, and playing in Daytona Beach."
  cityBase="daytona"
>
  <div class="ghWrap">

    {/* ── PAGE HERO: 4-BLOCK GRID ── */}
    <div class="ghHeroGrid">

      {/* Breadcrumb above grid */}
      <div class="ghGridBreadcrumb">
        <a href="/daytona/">GoDo Daytona</a>
        <span class="ghCrumbSep">›</span>
        <span>Guides</span>
      </div>

      {/* 2×2 Hero Blocks */}
      <div class="ghBlocks">

        {/* Block 1 — COAST [Live] */}
        <a class="ghBlock ghBlock--coast" href="/daytona/guides/live/" aria-label="COAST — Live guides">
          <div class="ghBlockOverlay"></div>
          <div class="ghBlockContent">
            <span class="ghBlockAction">COAST</span>
            <span class="ghBlockCategory">[Live]</span>
          </div>
        </a>

        {/* Block 2 — DRIVE [Work] */}
        <a class="ghBlock ghBlock--drive" href="/daytona/guides/work/" aria-label="DRIVE — Work guides">
          <div class="ghBlockOverlay"></div>
          <div class="ghBlockContent">
            <span class="ghBlockAction">DRIVE</span>
            <span class="ghBlockCategory">[Work]</span>
          </div>
        </a>

        {/* Block 3 — SURF [Play] */}
        <a class="ghBlock ghBlock--surf" href="/daytona/guides/play/" aria-label="SURF — Play guides">
          <div class="ghBlockOverlay"></div>
          <div class="ghBlockContent">
            <span class="ghBlockAction">SURF</span>
            <span class="ghBlockCategory">[Play]</span>
          </div>
        </a>

        {/* Block 4 — ESSENTIALS [Best] */}
        <a class="ghBlock ghBlock--essentials" href="/daytona/guides/best/" aria-label="ESSENTIALS — Best guides">
          <div class="ghBlockOverlay"></div>
          <div class="ghBlockContent">
            <span class="ghBlockAction">ESSENTIALS</span>
            <span class="ghBlockCategory">[Best]</span>
          </div>
        </a>

      </div>{/* end .ghBlocks */}
    </div>{/* end .ghHeroGrid */}

    {/* ── THREE STACKED SECTIONS ── */}
    {sections.map((s) => (
      <section class={`ghSection ghSection--${s.bg}`} id={s.id}>

        {/* Full-width category banner */}
        <div class="ghCategoryBanner">
          <h2 class="ghCategoryBannerText">{s.label.toUpperCase()}</h2>
        </div>

        <div class="container">

          {/* Sub-header row: just the "View all" link */}
          <div class="ghSecSubHead">
            <a class="ghSecMore" href={s.viewAllHref}>
              View all {s.label} Guides →
            </a>
          </div>

          {/* 1+3 Featured Grid */}
          <div class="ghGrid">

            {/* ── Left: Featured Card ── */}
            {s.featured && (
            <a class="ghFeatCard" href={s.featured.href}>
              <div class="ghFeatImgWrap">
                <img
                  class="ghFeatImg"
                  src={s.featured.img}
                  alt={s.featured.title}
                  loading="lazy"
                  decoding="async"
                  onerror="this.style.display='none';this.nextElementSibling.style.display='block'"
                />
                <div class="ghFeatImgFallback" aria-hidden="true"></div>
              </div>
              <div class="ghFeatBody">
                <div class="ghFeatKicker">
                  <span class="ghFeatKickerEmoji">{s.emoji}</span>
                  {s.label} Guide
                </div>
                <h3 class="ghFeatTitle">{s.featured.title}</h3>
                <p class="ghFeatDesc">{s.featured.description}</p>
                <span class="ghFeatCta">Read the guide →</span>
              </div>
            </a>
            )}

            {/* ── Right: 3 Recent Articles ── */}
            <div class="ghArticleList">
              {s.articles.map((art, i) => (
                <a class="ghArticleRow" href={art.href}>
                  <div class="ghThumbWrap">
                    <img
                      class="ghThumb"
                      src={art.img}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      onerror="this.style.display='none';this.nextElementSibling.style.display='block'"
                    />
                    <div class="ghThumbFallback" aria-hidden="true"></div>
                  </div>
                  <div class="ghArticleText">
                    <div class="ghArticleNum">#{i + 1}</div>
                    <div class="ghArticleTitle">{art.title}</div>
                    {art.description && (
                      <p class="ghArticleDesc">{art.description}</p>
                    )}
                  </div>
                </a>
              ))}
            </div>

          </div>{/* end .ghGrid */}

          {/* View All button */}
          <div class="ghViewAllRow">
            <a class="ghViewAllBtn" href={s.viewAllHref}>
              {s.viewAllLabel} →
            </a>
          </div>

        </div>
      </section>
    ))}

  </div>{/* end .ghWrap */}

  <style>
    /* ── Wrap ── */
    .ghWrap {
      min-height: 100vh;
    }

    /* ══ 4-BLOCK HERO GRID ══════════════════════════════════════════════ */

    .ghHeroGrid {
      border-bottom: 2px solid var(--brand1, #ffd24a);
      margin-bottom: 0;
    }

    /* Breadcrumb above the grid */
    .ghGridBreadcrumb {
      font-size: 13px;
      font-weight: 600;
      color: var(--faint);
      padding: 16px 24px 12px;
      display: flex;
      align-items: center;
      gap: 6px;
      background: var(--surface);
    }
    .ghGridBreadcrumb a {
      color: var(--brand1, #ffd24a);
      text-decoration: none;
    }
    .ghGridBreadcrumb a:hover { text-decoration: underline; }
    .ghCrumbSep { opacity: .5; }

    /* 4×1 nav card row (collapses to 2×2 on tablet) */
    .ghBlocks {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      padding: 14px 20px 18px;
      background: var(--surface);
    }

    /* Individual nav card */
    .ghBlock {
      position: relative;
      display: flex;
      align-items: flex-end;
      justify-content: flex-start;
      overflow: hidden;
      text-decoration: none;
      background-color: #1c2028;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,0.08);
      min-height: 110px;
      transition: border-color 220ms ease, box-shadow 220ms ease, transform 160ms ease;
    }
    .ghBlock:hover {
      border-color: rgba(255,210,74,0.45);
      box-shadow: 0 6px 24px rgba(0,0,0,0.35);
      transform: translateY(-2px);
    }

    /* ── Block background images — drop matching files into /public/images/guides/
         coast-bg.jpg, drive-bg.jpg, surf-bg.jpg, essentials-bg.jpg
         The grey-shade background-color acts as a fallback until images are added. ── */
    .ghBlock--coast {
      --block-bg-img: url('/images/guides/coast-bg.jpg');
      background-color: #1e2530;
    }
    .ghBlock--drive {
      --block-bg-img: url('/images/guides/drive-bg.jpg');
      background-color: #1a2020;
    }
    .ghBlock--surf {
      --block-bg-img: url('/images/guides/surf-bg.jpg');
      background-color: #1c2030;
    }
    .ghBlock--essentials {
      --block-bg-img: url('/images/guides/essentials-bg.jpg');
      background-color: #201c28;
    }

    /* Dark gradient overlay — ensures white text always pops */
    .ghBlockOverlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        160deg,
        rgba(0,0,0,0.15) 0%,
        rgba(0,0,0,0.55) 60%,
        rgba(0,0,0,0.80) 100%
      );
      transition: background 280ms ease;
    }

    /* Hover: slightly lighten overlay + zoom background */
    .ghBlock:hover .ghBlockOverlay {
      background: linear-gradient(
        160deg,
        rgba(0,0,0,0.05) 0%,
        rgba(0,0,0,0.38) 60%,
        rgba(0,0,0,0.65) 100%
      );
    }
    /* Future: when real photos are added, this scales the bg image */
    .ghBlock::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: var(--block-bg-img, none);
      background-size: cover;
      background-position: center;
      transition: transform 380ms ease;
    }
    .ghBlock:hover::before {
      transform: scale(1.04);
    }

    /* Text content — sits above the overlay */
    .ghBlockContent {
      position: relative;
      z-index: 1;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    /* Action word: COAST / DRIVE / SURF / ESSENTIALS */
    .ghBlockAction {
      display: block;
      font-family: "Montserrat", "Century Gothic", AppleGothic, Arial, sans-serif;
      font-size: clamp(1.05rem, 1.7vw, 1.45rem);
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #ffffff;
      line-height: 1;
      transition: color 200ms ease;
    }

    /* Category label: [Live] / [Work] / [Play] / [Best] — gold accent */
    .ghBlockCategory {
      display: block;
      font-family: "Montserrat", "Century Gothic", AppleGothic, Arial, sans-serif;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      color: #ffd24a;
      line-height: 1;
      transition: color 200ms ease;
    }

    /* Hover: action word picks up brand yellow tint */
    .ghBlock:hover .ghBlockAction   { color: #ffd24a; }
    .ghBlock:hover .ghBlockCategory { color: rgba(255,210,74,0.85); }

    /* Gold top accent on SURF card */
    .ghBlock--surf::after {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: #ffd24a;
      z-index: 2;
    }

    /* ── Tablet: 2×2 grid ── */
    @media (max-width: 860px) {
      .ghBlocks {
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        padding: 12px 16px 16px;
      }
    }

    /* ── Mobile: 2×2 compact ── */
    @media (max-width: 640px) {
      .ghBlocks {
        grid-template-columns: 1fr 1fr;
        gap: 6px;
        padding: 10px 12px 14px;
      }
      .ghBlock { min-height: 88px; }
      .ghBlockContent { padding: 10px 12px; }
    }

    /* ══ END HERO GRID ══════════════════════════════════════════════════ */

    /* ── Section shells — alternating backgrounds ── */
    .ghSection {
      padding: 0 0 48px;
    }
    .ghSection--white {
      background: var(--surface);
    }
    .ghSection--grey {
      background: var(--surface2);
      border-bottom: 1px solid var(--border);
    }

    /* ── Section category banner (compact) ── */
    .ghCategoryBanner {
      width: 100vw !important;
      background: #2E3E52;
      padding: 20px 0;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24px;
      border-top: 3px solid #ffd24a;
      border-bottom: 3px solid #ffd24a;
    }
    .ghCategoryBannerText {
      font-family: "Montserrat", "Century Gothic", AppleGothic, Arial, sans-serif;
      font-size: clamp(1.6rem, 3.5vw, 2.2rem) !important;
      font-weight: 900;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #ffffff;
      margin: 0;
      line-height: 1;
      text-align: center;
    }

    /* ── Sub-header row (view-all link) ── */
    .ghSecSubHead {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 20px;
    }
    .ghSecMore {
      font-size: 13px;
      font-weight: 700;
      color: var(--link);
      text-decoration: none;
      white-space: nowrap;
    }
    .ghSecMore:hover { text-decoration: underline; }

    /* ── 1+3 Featured Grid ── */
    .ghGrid {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 28px;
      align-items: start;
    }
    @media (max-width: 900px) {
      .ghGrid {
        grid-template-columns: 1fr;
        gap: 20px;
      }
    }

    /* ── Featured Card (left) ── */
    .ghFeatCard {
      display: block;
      text-decoration: none;
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid var(--border);
      background: var(--panel);
      transition: box-shadow 200ms ease;
    }
    .ghFeatCard:hover {
      box-shadow: 0 8px 32px rgba(0,0,0,.28);
    }
    .ghFeatImgWrap {
      position: relative;
      width: 100%;
      aspect-ratio: 16/9;
      overflow: hidden;
      background: var(--surface2);
    }
    .ghFeatImg {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 320ms ease;
    }
    .ghFeatCard:hover .ghFeatImg { transform: scale(1.04); }
    .ghFeatImgFallback {
      display: none;
      position: absolute;
      inset: 0;
      background: var(--surface2);
    }
    .ghFeatBody {
      padding: 20px 22px 22px;
    }
    .ghFeatKicker {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .09em;
      text-transform: uppercase;
      color: var(--brand1);
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 5px;
    }
    .ghFeatKickerEmoji {
      font-size: 14px;
      letter-spacing: 0;
    }
    .ghFeatTitle {
      font-size: clamp(1.1rem, 1.9vw, 1.45rem);
      font-weight: 900;
      color: var(--text);
      line-height: 1.18;
      letter-spacing: -0.25px;
      margin: 0 0 10px;
      transition: color 130ms;
    }
    .ghFeatCard:hover .ghFeatTitle { color: var(--link); }
    .ghFeatDesc {
      font-size: 15px;
      color: var(--muted);
      line-height: 1.55;
      margin: 0 0 14px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .ghFeatCta {
      display: inline-flex;
      align-items: center;
      height: 34px;
      padding: 0 16px;
      border-radius: 999px;
      background: var(--brand1);
      color: var(--accentText);
      font-size: 13px;
      font-weight: 800;
      text-decoration: none;
      transition: filter 130ms;
    }
    .ghFeatCard:hover .ghFeatCta { filter: brightness(.92); }

    /* ── Article List (right column) ── */
    .ghArticleList {
      display: flex;
      flex-direction: column;
      border: 1px solid var(--border);
      border-radius: 14px;
      overflow: hidden;
      background: var(--panel);
    }
    .ghArticleRow {
      display: grid;
      grid-template-columns: 88px 1fr;
      gap: 12px;
      align-items: center;
      padding: 14px 16px;
      border-bottom: 1px solid var(--border);
      text-decoration: none;
      transition: background 130ms ease;
    }
    .ghArticleRow:last-child { border-bottom: none; }
    .ghArticleRow:hover {
      background: color-mix(in srgb, var(--brand1) 6%, var(--panel));
    }
    .ghThumbWrap {
      width: 88px;
      height: 64px;
      border-radius: 8px;
      overflow: hidden;
      flex-shrink: 0;
      background: var(--surface2);
      position: relative;
    }
    .ghThumb {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 280ms ease;
    }
    .ghArticleRow:hover .ghThumb { transform: scale(1.06); }
    .ghThumbFallback {
      display: none;
      position: absolute;
      inset: 0;
      background: var(--surface2);
    }
    .ghArticleText {
      display: flex;
      flex-direction: column;
      gap: 4px;
      min-width: 0;
    }
    .ghArticleNum {
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .07em;
      color: var(--brand1);
      text-transform: uppercase;
    }
    .ghArticleTitle {
      font-size: 15px;
      font-weight: 700;
      color: var(--text);
      line-height: 1.25;
      letter-spacing: -0.1px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      transition: color 130ms ease;
    }
    .ghArticleRow:hover .ghArticleTitle { color: var(--link); }
    .ghArticleDesc {
      font-size: 12px;
      color: var(--muted);
      line-height: 1.45;
      margin: 2px 0 0;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* ── View All button row ── */
    .ghViewAllRow {
      margin-top: 22px;
      text-align: center;
    }
    .ghViewAllBtn {
      display: inline-flex;
      align-items: center;
