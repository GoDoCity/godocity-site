---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";
import NewsletterBanner from "../../../components/NewsletterBanner.astro";

const allGuides = await getCollection("guides");
const sorted = [...allGuides].sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

function guideSlug(g: (typeof allGuides)[number]) {
  return g.slug.split("/").pop()!;
}
function fmtDate(d: Date) {
  return d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
}
function authorSlug(name: string): string {
  return name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
}
function toAnchor(label: string): string {
  return label.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
}

const SECTIONS = [
  { topic: "COAST" as const, slug: "coast", accent: "#0E3F6E", neon: "#bf94ff", pillColor: "#7B61FF", pillText: "#fff" },
  { topic: "DRIVE" as const, slug: "drive", accent: "#7A2F00", neon: "#00ff9d", pillColor: "#00E676", pillText: "#000" },
  { topic: "SURF"  as const, slug: "surf",  accent: "#004E64", neon: "#ff6ad5", pillColor: "#FF4081", pillText: "#fff" },
  { topic: "LOCAL" as const, slug: "local", accent: "#1C3E1F", neon: "#ffef78", pillColor: "#FFD600", pillText: "#000" },
];

const sections = SECTIONS
  .map(s => ({ ...s, guides: sorted.filter(g => g.data.topic === s.topic) }));
---

<Base title="Guides — GoDo Daytona" cityBase="daytona">
  <div class="gd-page">

    <!-- Breadcrumb hidden for hero-flush layout -->
    <div class="gd-breadcrumb" style="display:none" aria-hidden="true">
      <a href="/daytona/">GoDo Daytona</a>
      <span aria-hidden="true">›</span>
      <span>Guides</span>
    </div>

    <!-- Page header -->
    <header class="gd-header">
      <div class="gd-header-inner">
        <h1 class="gd-header-title">Daytona's Guide</h1>
        <p class="gd-header-sub">Your definitive local source for coast, culture, and community.</p>
        <nav class="gd-header-nav" aria-label="Guide topic sections">
          {sections.map(s => (
            <a class="gd-nav-link" href={`/daytona/guides/${s.slug}/`} style={`--pill-color: ${s.pillColor};`}>{s.topic}</a>
          ))}
        </nav>
      </div>
    </header>

  <!-- ── Premium Ad Inventory Strip (directly below hero) ── -->
  <section class="gd-adStrip">
    <div class="gd-adStripInner">
      <p class="gd-adStripEyebrow">Advertise on GoDo Guides — 2026 Rates</p>
      <div class="gd-adStripSlots">

        <div class="gd-adSlot gd-adSlot--vip">
          <div class="gd-adSlotMeta">
            <span class="gd-adSlotName">★ VIP Headliner</span>
            <span class="gd-adSlotPrice">$375/wk</span>
          </div>
          <p class="gd-adSlotDesc">Top-of-page placement on Daytona's premier Guides hub · 76k+ monthly impressions · Maximum visibility above the fold</p>
          <a href="mailto:ads@godoevents.com?subject=GoDo%20Guides%20%E2%80%94%20VIP%20Headliner%20Slot&body=Hi%20GoDo%20Team%2C%0A%0AI%27m%20interested%20in%20the%20VIP%20Headliner%20slot%20(%24375%2Fwk)%20on%20the%20GoDo%20Guides%20section.%0A%0APlease%20send%20availability%20and%20next%20steps.%0A%0AThanks!"
             class="gd-adSlotCta gd-adSlotCta--vip">Reserve Slot →</a>
        </div>

        <div class="gd-adSlot">
          <div class="gd-adSlotMeta">
            <span class="gd-adSlotName">✦ High-Impact Listing</span>
            <span class="gd-adSlotPrice">$225/wk</span>
          </div>
          <p class="gd-adSlotDesc">Featured mid-page placement inside a Guide section · Priority positioning · Bolded format reaches engaged readers</p>
          <a href="mailto:ads@godoevents.com?subject=GoDo%20Guides%20%E2%80%94%20High-Impact%20Listing&body=Hi%20GoDo%20Team%2C%0A%0AI%27m%20interested%20in%20the%20High-Impact%20Listing%20slot%20(%24225%2Fwk)%20on%20the%20GoDo%20Guides%20section.%0A%0APlease%20send%20availability%20and%20next%20steps.%0A%0AThanks!"
             class="gd-adSlotCta">Reserve Slot →</a>
        </div>

        <div class="gd-adSlot">
          <div class="gd-adSlotMeta">
            <span class="gd-adSlotName">☉ Content Spotlight</span>
            <span class="gd-adSlotPrice">$150/wk</span>
          </div>
          <p class="gd-adSlotDesc">Native in-content placement inside a targeted Guide category · Direct response from local audiences</p>
          <a href="mailto:ads@godoevents.com?subject=GoDo%20Guides%20%E2%80%94%20Content%20Spotlight&body=Hi%20GoDo%20Team%2C%0A%0AI%27m%20interested%20in%20the%20Content%20Spotlight%20slot%20(%24150%2Fwk)%20on%20the%20GoDo%20Guides%20section.%0A%0APlease%20send%20availability%20and%20next%20steps.%0A%0AThanks!"
             class="gd-adSlotCta">Book This Slot →</a>
        </div>

      </div>
    </div>
  </section>

    <!-- Topic sections -->
    {sections.map((s, i) => {
      const feature = s.guides[0] ?? null;
      const grid    = s.guides.slice(1, 4);
      return (
        <section class={`gd-section${i % 2 === 1 ? " gd-section--alt" : ""}`}>

          <!-- Full-width topic bar -->
          <div class="gd-topic-bar" style={`--neon: ${s.neon};`}>
            <span class="gd-topic-label">{s.topic}</span>
          </div>

          <div class="gd-section-body">

            {s.guides.length === 0 ? (
              <!-- Empty state -->
              <div class="gd-empty">
                <p class="gd-empty-msg">{s.topic} guides coming soon — check back shortly.</p>
              </div>
            ) : (
              <>
                <!-- Feature card -->
                <article class="gd-feature">
                  <div class="gd-feature-img">
                    {feature.data.image
                      ? <img src={feature.data.image} alt={feature.data.title} loading="lazy" decoding="async" />
                      : <div class="gd-img-fallback" aria-hidden="true" />
                    }
                  </div>
                  <div class="gd-feature-text">
                    <div class="gd-feature-pills">
                      <a class="gd-pill gd-pill--topic" href={`/daytona/guides/${s.slug}/`}
                         style={`--pill-color: ${s.pillColor}; --pill-text: ${s.pillText};`}>{s.topic}</a>
                      {feature.data.subtopic && (
                        <a class="gd-pill gd-pill--sub" href={`/daytona/guides/${s.slug}/#${toAnchor(feature.data.subtopic)}`}>
                          {feature.data.subtopic}
                        </a>
                      )}
                    </div>
                    <h2 class="gd-feature-title">
                      <a class="gd-cover-link" href={`/daytona/guides/${guideSlug(feature)}/`}>{feature.data.title}</a>
                    </h2>
                    {feature.data.description && (
                      <p class="gd-feature-desc">{feature.data.description}</p>
                    )}
                    <div class="gd-feature-meta">
                      {feature.data.author && (
                        <a class="gd-meta-author" href={`/daytona/journalists/${authorSlug(feature.data.author)}`}>{feature.data.author}</a>
                      )}
                      {feature.data.date && <span class="gd-meta-date">{fmtDate(feature.data.date)}</span>}
                    </div>
                    <span class="gd-feature-cta">Read guide →</span>
                  </div>
                </article>

                <!-- Small cards row -->
                {grid.length > 0 && (
                  <div class="gd-grid">
                    {grid.map(g => (
                      <article class="gd-card">
                        <div class="gd-card-img">
                          {g.data.image
                            ? <img src={g.data.image} alt={g.data.title} loading="lazy" decoding="async" />
                            : <div class="gd-img-fallback" aria-hidden="true" />
                          }
                        </div>
                        <div class="gd-card-body">
                          <div class="gd-card-pills">
                            <a class="gd-pill gd-pill--topic" href={`/daytona/guides/${s.slug}/`}
                               style={`--pill-color: ${s.pillColor}; --pill-text: ${s.pillText};`}>{s.topic}</a>
                            {g.data.subtopic && (
                              <a class="gd-pill gd-pill--sub" href={`/daytona/guides/${s.slug}/#${toAnchor(g.data.subtopic)}`}>
                                {g.data.subtopic}
                              </a>
                            )}
                          </div>
                          <h3 class="gd-card-title">
                            <a class="gd-cover-link" href={`/daytona/guides/${guideSlug(g)}/`}>{g.data.title}</a>
                          </h3>
                          {g.data.description && (
                            <p class="gd-card-desc">{g.data.description}</p>
                          )}
                        </div>
                      </article>
                    ))}
                  </div>
                )}

                <!-- View all -->
                <div class="gd-view-more">
                  <a href={`/daytona/guides/${s.slug}/`} class="gd-view-more-link">
                    View all {s.topic} guides →
                  </a>
                </div>
              </>
            )}

          </div>
        </section>
      );
    })}

  </div>

  <NewsletterBanner city="Daytona" />
</Base>

<style>
  /* ─────────────────────────────────────────────
     Page shell
  ───────────────────────────────────────────── */
  .gd-page {
    min-height: 100vh;
    background: var(--surface);
  }

  /* ─────────────────────────────────────────────
     Breadcrumb
  ───────────────────────────────────────────── */
  .gd-breadcrumb {
    max-width: 1200px;
    margin: 0 auto;
    padding: 14px 2rem 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--faint, rgba(232,237,244,.55));
    border-bottom: 1px solid var(--border);
  }
  .gd-breadcrumb a {
    color: var(--text);
    text-decoration: none;
  }
  .gd-breadcrumb a:hover { text-decoration: underline; }

  /* ─────────────────────────────────────────────
     Page header
  ───────────────────────────────────────────── */
  .gd-header {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    background-color: #060810;
    background-image: url('/images/daytona-guide-hero.png') !important;
    background-size: cover !important;
    background-position: center 35% !important;
    background-repeat: no-repeat !important;
    border-bottom: 3px solid #0055a4;
    margin-top: 0 !important;
    padding-top: 0 !important;
    padding: 52px 2rem 40px;
    overflow: hidden;
  }
  .gd-header::before {
    display: none !important;
    background: transparent !important;
    content: none !important;
  }
  .gd-header-inner {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }
  .gd-header-title {
    display: inline-block !important;
    position: relative !important;
    padding: 10px 28px !important;
    font-family: "Montserrat", "Century Gothic", AppleGothic, Arial, sans-serif;
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 800 !important;
    letter-spacing: 3px !important;
    text-transform: uppercase !important;
    line-height: 1.2 !important;
    margin: 0 0 10px;
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
    background: transparent !important;
    background-image: none !important;
    -webkit-background-clip: unset !important;
    border: 2px solid #ffffff !important;
    border-radius: 6px;
    text-shadow: 2px 2px 0px #0a2b5e !important;
    -webkit-text-stroke: 0px transparent !important;
    box-shadow: none;
  }
  .gd-header-sub {
    color: #ffffff !important;
    font-weight: 600 !important;
    font-size: clamp(1.1rem, 2vw, 1.35rem) !important;
    letter-spacing: 0.5px !important;
    margin: 14px 0 28px;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.5) !important;
  }
  .gd-header-nav {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .gd-nav-link {
    font-family: "Montserrat", "Century Gothic", AppleGothic, Arial, sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #000;
    text-decoration: none;
    padding: 9px 22px;
    border-radius: 999px;
    background: var(--pill-color, #fff);
    border: 1.5px solid #ffffff !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25) !important;
    transition: box-shadow 180ms, filter 180ms;
  }
  .gd-nav-link:hover {
    box-shadow: 0 0 8px var(--pill-color, transparent), 0 0 20px var(--pill-color, transparent);
    filter: brightness(1.12);
  }

  /* ─────────────────────────────────────────────
     Topic section
  ───────────────────────────────────────────── */
  .gd-section {
    background: var(--surface);
    border-top: 1px solid var(--border);
  }
  .gd-section--alt {
    background: var(--surface2, #161b24);
  }

  /* Full-width header bar — neon identity */
  .gd-topic-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 30px 2rem;
    width: 100%;
    background: #060810;
    border-top: 1px solid rgba(255,255,255,0.06);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .gd-topic-label {
    font-family: 'Monoton', cursive;
    font-size: clamp(2.6rem, 5.5vw, 5rem);
    color: var(--neon);
    line-height: 1;
    text-align: center;
    -webkit-font-smoothing: antialiased;
    text-shadow:
      0 0 1px var(--neon),
      0 0 8px var(--neon),
      0 0 18px color-mix(in srgb, var(--neon) 65%, transparent),
      0 1px 4px rgba(0,0,0,0.8);
  }

  /* Inner container */
  .gd-section-body {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 2rem 56px;
  }

  /* ─────────────────────────────────────────────
     Feature card  (horizontal: image left, text right)
  ───────────────────────────────────────────── */
  .gd-feature {
    display: grid;
    grid-template-columns: 0.55fr 0.45fr;
    height: 420px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--panel, var(--surface));
    margin-bottom: 20px;
    transition: box-shadow 200ms ease, transform 200ms ease;
  }
  .gd-feature:hover {
    box-shadow: 0 12px 42px rgba(0,0,0,0.28);
    transform: translateY(-3px);
  }

  .gd-feature-img {
    overflow: hidden;
    background: var(--surface2);
    height: 100%;
  }
  .gd-feature-img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 360ms ease;
  }
  .gd-feature:hover .gd-feature-img img { transform: scale(1.04); }

  .gd-feature-text {
    padding: 32px 36px 32px 32px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    justify-content: center;
  }
  /* ── Dual pills (shared between feature + grid cards) ── */
  .gd-feature-pills,
  .gd-card-pills {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
  }
  .gd-pill {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 999px;
    font-family: "Montserrat", "Century Gothic", AppleGothic, Arial, sans-serif;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1.6;
    transition: opacity 130ms;
  }
  .gd-pill:hover { opacity: 0.75; }
  .gd-pill--topic {
    background: var(--pill-color, #111);
    color: var(--pill-text, #fff);
  }
  .gd-pill--sub {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border);
  }
  .gd-pill--sub:hover { border-color: var(--pill-color, var(--border)); }

  /* ── Cover link (stretches over card, pills/meta sit above via z-index) ── */
  .gd-feature,
  .gd-card { position: relative; }
  .gd-cover-link { color: inherit; text-decoration: none; }
  .gd-cover-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .gd-feature-title {
    font-family: "Montserrat", "Century Gothic", AppleGothic, Arial, sans-serif;
    font-size: 24px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0;
    transition: color 130ms;
  }
  .gd-feature:hover .gd-feature-title { color: var(--brand1); }
  .gd-feature-desc {
    font-size: 16px;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: #000;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .gd-feature-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 4px;
  }
  .gd-meta-author {
    font-size: 13px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.02em;
    text-decoration: none;
    position: relative;
    z-index: 1;
    transition: color 130ms;
  }
  .gd-meta-author:hover { color: var(--brand1); }
  .gd-meta-date {
    font-size: 12px;
    color: var(--faint, rgba(232,237,244,.55));
    letter-spacing: 0.02em;
  }
  .gd-feature-cta {
    font-family: "Montserrat", "Century Gothic", AppleGothic, Arial, sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand1);
    margin-top: 4px;
    transition: opacity 130ms;
  }
  .gd-feature:hover .gd-feature-cta { opacity: 0.75; }

  /* Responsive: stack on smaller screens */
  @media (max-width: 960px) {
    .gd-feature {
      grid-template-columns: 1fr;
      height: auto;
    }
    .gd-feature-img { aspect-ratio: 16/9; height: auto; }
    .gd-feature-text { padding: 22px 24px 28px; gap: 10px; }
  }

  /* ─────────────────────────────────────────────
     Small cards grid (3 columns)
  ───────────────────────────────────────────── */
  .gd-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 24px;
  }
  @media (max-width: 860px) { .gd-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .gd-grid { grid-template-columns: 1fr; gap: 14px; } }

  .gd-card {
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--panel, var(--surface));
    transition: box-shadow 200ms ease, transform 200ms ease;
  }
  .gd-card:hover {
    box-shadow: 0 8px 28px rgba(0,0,0,.22);
    transform: translateY(-2px);
  }

  .gd-card-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface2);
    flex-shrink: 0;
  }
  .gd-card-img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 300ms ease;
  }
  .gd-card:hover .gd-card-img img { transform: scale(1.04); }

  .gd-card-body { padding: 12px 18px 18px; display: flex; flex-direction: column; gap: 6px; }
  .gd-card-title {
    font-size: 22px;
    font-weight: 800;
    line-height: 1.2;
    color: var(--text);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 130ms;
  }
  .gd-card:hover .gd-card-title { color: var(--brand1); }
  .gd-card-desc {
    font-size: 16px;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: #000;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ─────────────────────────────────────────────
     Fallback & view-more
  ───────────────────────────────────────────── */
  .gd-img-fallback { width: 100%; height: 100%; background: var(--surface2); }

  .gd-view-more { text-align: right; }
  .gd-view-more-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
    border-bottom: 2px solid var(--brand1);
    padding-bottom: 2px;
    transition: opacity 130ms;
  }
  .gd-view-more-link:hover { opacity: 0.7; }

  /* Empty state */
  .gd-empty {
    padding: 40px 0 16px;
    text-align: center;
  }
  .gd-empty-msg {
    font-size: 1rem;
    color: var(--muted);
    font-style: italic;
    letter-spacing: 0.02em;
    margin: 0;
  }

  /* ─────────────────────────────────────────────
     Mobile
  ───────────────────────────────────────────── */
  @media (max-width: 640px) {
    .gd-header { padding: 36px 1rem 28px; }
    .gd-header-sub { display: block; font-size: 0.95rem !important; }
    .gd-topic-bar { padding: 16px 1rem; }
    .gd-section-body { padding: 28px 1rem 40px; }
    .gd-breadcrumb { padding: 12px 1rem; }

    /* Compact topic pills so all four fit on one line */
    .gd-header-nav { gap: 6px; flex-wrap: nowrap; overflow-x: auto; -webkit-overflow-scrolling: touch; justify-content: center !important; }
    .gd-nav-link { font-size: 0.6rem; padding: 6px 12px; height: auto; flex-shrink: 0; }
  }

  /* ── Premium Ad Inventory Strip ── */
  .gd-adStrip {
    background: #060810;
    border-top: 1px solid rgba(255,255,255,.08);
    border-bottom: 1px solid rgba(255,255,255,.08);
    padding: 48px 2rem;
  }
  .gd-adStripInner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .gd-adStripEyebrow {
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: rgba(255,255,255,.35);
    margin: 0 0 22px;
    text-align: center;
  }
  .gd-adStripSlots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
