---
/**
 * src/pages/daytona/guides/[slug].astro
 * Renders individual guide pages from the "guides" content collection.
 * Uses GuideLayout which provides the TOC (showToC), sidebar, and 70/30 grid.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const allGuides = await getCollection("guides");
  return allGuides.map((guide) => ({
    params: { slug: guide.slug.split("/").pop() },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await guide.render();

/* Map topic → visual category label used in the ribbon breadcrumb */
const topicToSection: Record<string, string> = {
  Live: "live",
  Work: "work",
  Play: "play",
};
const sectionSlug = topicToSection[guide.data.topic] ?? "play";
---

<GuideLayout
  title={guide.data.title}
  subtitle={guide.data.description}
  cityBase="daytona"
  topic={guide.data.topic}
  showToC={guide.data.showToC}
>
  <!-- Guide hero meta row -->
  <div class="sg-meta">
    <a class="sg-back" href={`/daytona/guides/${sectionSlug}/`}>
      ← {guide.data.topic} Guides
    </a>
    {guide.data.date && (
      <time class="sg-date" datetime={guide.data.date.toISOString()}>
        {guide.data.date.toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
      </time>
    )}
  </div>

  <!-- Featured image (if present) -->
  {guide.data.image && (
    <div class="sg-hero-img-wrap">
      <img
        class="sg-hero-img"
        src={guide.data.image}
        alt={guide.data.title}
        loading="eager"
        decoding="async"
      />
    </div>
  )}

  <!-- Article title -->
  <h1 class="sg-title">{guide.data.title}</h1>

  <!-- Article body — TOC is injected by GuideLayout script before first h2 -->
  <Content />
</GuideLayout>

<style>
  /* ── Guide meta row (back link + date) ── */
  .sg-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }
  .sg-back {
    font-size: 13px;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: opacity 130ms;
  }
  .sg-back:hover { opacity: 0.75; }

  .sg-date {
    font-size: 12px;
    color: var(--faint, rgba(232,237,244,.58));
    letter-spacing: 0.02em;
  }

  /* ── Hero image ── */
  .sg-hero-img-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 28px;
    background: #1c2028;
  }
  .sg-hero-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* ── Guide title ── */
  .sg-title {
    font-family: "Montserrat", "Century Gothic", AppleGothic, Arial, sans-serif;
    font-size: clamp(1.9rem, 4vw, 3.2rem);
    font-weight: 900;
    color: var(--text);
    line-height: 1.12;
    letter-spacing: -0.03em;
    margin: 0 0 28px;
  }

  @media (max-width: 640px) {
    .sg-hero-img-wrap { aspect-ratio: 4/3; }
    .sg-title { margin-bottom: 20px; }
  }
</style>
