---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  return [
    { params: { section: "live" } },
    { params: { section: "work" } },
    { params: { section: "play" } },
    { params: { section: "best" } },
  ];
}

const { section } = Astro.params;

const topicMap: Record<string, string> = {
  live: "Live",
  work: "Work",
  play: "Play",
  best: "Best",
};

const emojiMap: Record<string, string> = {
  live: "🏠",
  work: "💼",
  play: "🎉",
  best: "⭐",
};

const fallbackImgs: Record<string, string> = {
  Live: "/images/topics/real-estate.jpg",
  Work: "/images/topics/business.jpg",
  Play: "/images/topics/sports.jpg",
  Best: "/images/topics/city.jpg",
};

const topic = topicMap[section] ?? "";
const emoji = emojiMap[section] ?? "";

/* ── Jump ribbon configuration per section ── */
type RibbonItem = { label: string; href: string; id: string };
const ribbonConfig: Record<string, RibbonItem[]> = {
  play: [
    { label: "Food & Drink",       href: "#food-drink",       id: "food-drink"       },
    { label: "Outdoors & Trails",  href: "#outdoors-trails",  id: "outdoors-trails"  },
    { label: "Arts & Culture",     href: "#arts-culture",     id: "arts-culture"     },
    { label: "Date Night",         href: "#date-night",       id: "date-night"       },
  ],
  live: [
    { label: "Neighborhoods", href: "#neighborhoods", id: "neighborhoods" },
    { label: "Home & Garden", href: "#home-garden",   id: "home-garden"   },
    { label: "Schools",       href: "#schools",       id: "schools"       },
    { label: "Services",      href: "#services",      id: "services"      },
  ],
  work: [
    { label: "Small Business", href: "#small-business", id: "small-business" },
    { label: "Coworking",      href: "#coworking",      id: "coworking"      },
    { label: "Networking",     href: "#networking",     id: "networking"     },
    { label: "Resources",      href: "#resources",      id: "resources"      },
  ],
};
const ribbonItems: RibbonItem[] = ribbonConfig[section] ?? [];

/* Query the guides collection and filter by topic */
const allGuides = await getCollection("guides");
const topicGuides = allGuides
  .filter((g) => g.data.topic === topic)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

function guideSlug(g: (typeof allGuides)[number]) {
  return g.slug.split("/").pop()!;
}

/* Featured: explicit featured flag wins; otherwise most-recent */
const featuredGuide = topicGuides.find((g) => g.data.featured) ?? topicGuides[0] ?? null;
const articleGuides = topicGuides.filter((g) => g !== featuredGuide);
---

<Base
  title={`${topic} Guides | GoDoDaytona`}
  subtitle={`GoDo guides for ${topic.toLowerCase()} in Daytona Beach.`}
  cityBase="daytona"
>
  <div class="ghWrap">

    {/* ── CATEGORY HEADER + RIBBON (flush together) ── */}
    <div class="ghHeaderStack">

      {/* Breadcrumb */}
      <div class="ghHeaderBreadcrumb container">
        <a href="/daytona/">GoDo Daytona</a>
        <span class="ghCrumbSep">›</span>
        <a href="/daytona/guides/">Guides</a>
        <span class="ghCrumbSep">›</span>
        <span>{topic}</span>
      </div>

      {/* ── PRIMARY HEADER BLOCK ── */}
      <div class="ghCategoryBanner">
        <div class="container">
          <h1 class="ghCategoryBannerText">
            <span class="ghBannerAction">{topic.toUpperCase()}</span>
            {section === "play" && <span class="ghBannerCategory">[Play]</span>}
            {section === "live" && <span class="ghBannerCategory">[Live]</span>}
            {section === "work" && <span class="ghBannerCategory">[Work]</span>}
            {section === "best" && <span class="ghBannerCategory">[Best]</span>}
          </h1>
        </div>
      </div>

      {/* ── STICKY JUMP RIBBON — flush below header ── */}
      {ribbonItems.length > 0 && (
        <div class="ghRibbonOuter" id="ghRibbon">
          <div class="container">
            <nav class="ghRibbon" aria-label={`${topic} sub-categories`}>
              {ribbonItems.map((item) => (
                <a
                  class="ghRibbonItem"
                  href={item.href}
                  data-ribbon-id={item.id}
                >
                  {item.label}
                </a>
              ))}
            </nav>
          </div>
        </div>
      )}

    </div>{/* end .ghHeaderStack */}

    {/* ── GUIDES SECTION ── */}
    <section class="ghSection ghSection--white">
      <div class="container">

        {topicGuides.length === 0 ? (
          <p class="lede">No {topic.toLowerCase()} guides yet — check back soon!</p>
        ) : (
          <div class={`ghGrid${articleGuides.length === 0 ? " ghGrid--single" : ""}`}>

            {/* ── Featured Card ── */}
            {featuredGuide && (
              <a class="ghFeatCard" href={`/daytona/guides/${guideSlug(featuredGuide)}/`}>
                <div class="ghFeatImgWrap">
                  <img
                    class="ghFeatImg"
                    src={featuredGuide.data.image ?? fallbackImgs[topic]}
                    alt={featuredGuide.data.title}
                    loading="lazy"
                    decoding="async"
                    onerror="this.style.display='none';this.nextElementSibling.style.display='block'"
                  />
                  <div class="ghFeatImgFallback" aria-hidden="true"></div>
                </div>
                <div class="ghFeatBody">
                  <div class="ghFeatKicker">
                    <span class="ghFeatKickerEmoji">{emoji}</span>
                    {topic} Guide
                  </div>
                  <h3 class="ghFeatTitle">{featuredGuide.data.title}</h3>
                  <p class="ghFeatDesc">{featuredGuide.data.description}</p>
                  <span class="ghFeatCta">Read the guide →</span>
                </div>
              </a>
            )}

            {/* ── Article List ── */}
            {articleGuides.length > 0 && (
              <div class="ghArticleList">
                {articleGuides.map((g, i) => (
                  <a class="ghArticleRow" href={`/daytona/guides/${guideSlug(g)}/`}>
                    <div class="ghThumbWrap">
                      <img
                        class="ghThumb"
                        src={g.data.image ?? fallbackImgs[topic]}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        onerror="this.style.display='none';this.nextElementSibling.style.display='block'"
                      />
                      <div class="ghThumbFallback" aria-hidden="true"></div>
                    </div>
                    <div class="ghArticleText">
                      <div class="ghArticleNum">#{i + 1}</div>
                      <div class="ghArticleTitle">{g.data.title}</div>
                      {g.data.description && (
                        <p class="ghArticleDesc">{g.data.description}</p>
                      )}
                    </div>
                  </a>
                ))}
              </div>
            )}

          </div>
        )}

        <div class="ghViewAllRow">
          <a class="ghViewAllBtn" href="/daytona/guides/">← All Guides</a>
        </div>

      </div>
    </section>

  </div>{/* end .ghWrap */}

  <style>
    .ghWrap { min-height: 100vh; }

    /* ── Header stack — banner + ribbon as a single flush unit ── */
    .ghHeaderStack {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    /* Breadcrumb inside header */
    .ghHeaderBreadcrumb {
      font-size: 13px;
      font-weight: 600;
      color: var(--faint);
      padding: 14px 0 10px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .ghHeaderBreadcrumb a {
      color: var(--brand1);
      text-decoration: none;
    }
    .ghHeaderBreadcrumb a:hover { text-decoration: underline; }
    .ghCrumbSep { opacity: .5; }

    /* ── Primary Category Header Block ── */
    .ghCategoryBanner {
      width: 100vw !important;
      background: #2E3E52;
      padding: 40px 0 36px;
      margin-bottom: 0;
      border-top: 4px solid #FFD700 !important;
      border-bottom: 4px solid #FFD700 !important;
    }
    .ghCategoryBannerText {
      font-family: "Montserrat", "Century Gothic", AppleGothic, Arial, sans-serif;
      font-weight: 900;
      margin: 0;
      line-height: 1;
      text-align: left;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
    /* Action word: LIVE / WORK / PLAY — bold, uppercase, large */
    .ghBannerAction {
      font-size: clamp(4.4rem, 8vw, 5.8rem);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #ffffff;
      display: block;
    }
    /* Category word: [Live] — lighter, ~20% smaller */
    .ghBannerCategory {
      font-size: clamp(1.8rem, 3.2vw, 2.8rem);
      font-weight: 300;
      letter-spacing: 0.18em;
      color: rgba(255,255,255,0.78);
      display: block;
    }

    /* ── Sticky Jump Ribbon ── */
    .ghRibbonOuter {
      position: sticky;
      top: 0;
      z-index: 100;
      background: #ffffff;
      border-bottom: 1px solid rgba(0,0,0,0.08);
      box-shadow: 0 2px 8px rgba(0,0,0,0.10);
    }
    .ghRibbon {
      display: flex;
      align-items: stretch;
      overflow-x: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .ghRibbon::-webkit-scrollbar { display: none; }

    .ghRibbonItem {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      padding: 0 18px;
      height: 46px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: rgba(46,62,82,0.6);
      text-decoration: none;
      border-bottom: 3px solid transparent;
      transition: color 140ms, border-color 140ms;
      white-space: nowrap;
    }
    .ghRibbonItem:hover {
      color: #2E3E52;
      border-bottom-color: rgba(255,210,74,0.5);
    }
    /* Active ribbon item: 3px Racing Yellow underline */
    .ghRibbonItem.is-active,
    .ghRibbonItem[aria-current="true"] {
      color: #2E3E52;
      border-bottom: 3px solid #ffd24a;
    }

    /* Pipe separators between ribbon items */
    .ghRibbonItem + .ghRibbonItem {
      border-left: 1px solid rgba(0,0,0,0.08);
    }

    /* ── Mobile ribbon ── */
    @media (max-width: 640px) {
      .ghRibbonItem {
        padding: 0 14px;
        font-size: 11px;
        height: 40px;
      }
    }

    /* ── Section ── */
    .ghSection { padding: 28px 0 48px; }
    .ghSection--white { background: var(--surface); }

    .lede {
      font-size: 1.1rem;
      color: var(--muted);
      padding: 32px 0;
    }

    /* ── 1+N Grid ── */
    .ghGrid {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 28px;
      align-items: start;
      padding-top: 4px;
    }
    .ghGrid--single {
      grid-template-columns: 1fr;
      max-width: 720px;
    }
    @media (max-width: 900px) {
      .ghGrid { grid-template-columns: 1fr; gap: 20px; }
    }

    /* ── Featured Card ── */
    .ghFeatCard {
      display: block;
      text-decoration: none;
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid var(--border);
      background: var(--panel);
      transition: box-shadow 200ms ease;
    }
    .ghFeatCard:hover { box-shadow: 0 8px 32px rgba(0,0,0,.28); }
    .ghFeatImgWrap {
      position: relative;
      width: 100%;
      aspect-ratio: 16/9;
      overflow: hidden;
      background: var(--surface2);
    }
    .ghFeatImg {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 320ms ease;
    }
    .ghFeatCard:hover .ghFeatImg { transform: scale(1.04); }
    .ghFeatImgFallback {
      display: none;
      position: absolute;
      inset: 0;
      background: var(--surface2);
    }
    .ghFeatBody { padding: 20px 22px 22px; }
    .ghFeatKicker {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .09em;
      text-transform: uppercase;
      color: var(--brand1);
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 5px;
    }
    .ghFeatKickerEmoji { font-size: 14px; letter-spacing: 0; }
    .ghFeatTitle {
      font-size: clamp(1.1rem, 1.9vw, 1.45rem);
      font-weight: 900;
      color: var(--text);
      line-height: 1.18;
      letter-spacing: -0.25px;
      margin: 0 0 10px;
      transition: color 130ms;
    }
    .ghFeatCard:hover .ghFeatTitle { color: var(--link); }
    .ghFeatDesc {
      font-size: 15px;
      color: var(--muted);
      line-height: 1.55;
      margin: 0 0 14px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .ghFeatCta {
      display: inline-flex;
      align-items: center;
      height: 34px;
      padding: 0 16px;
      border-radius: 999px;
      background: var(--brand1);
      color: var(--accentText);
      font-size: 13px;
      font-weight: 800;
      text-decoration: none;
      transition: filter 130ms;
    }
    .ghFeatCard:hover .ghFeatCta { filter: brightness(.92); }

    /* ── Article List ── */
    .ghArticleList {
      display: flex;
      flex-direction: column;
      border: 1px solid var(--border);
      border-radius: 14px;
      overflow: hidden;
      background: var(--panel);
    }
    .ghArticleRow {
      display: grid;
      grid-template-columns: 88px 1fr;
      gap: 12px;
      align-items: center;
      padding: 14px 16px;
      border-bottom: 1px solid var(--border);
      text-decoration: none;
      transition: background 130ms ease;
    }
    .ghArticleRow:last-child { border-bottom: none; }
    .ghArticleRow:hover {
      background: color-mix(in srgb, var(--brand1) 6%, var(--panel));
    }
    .ghThumbWrap {
      width: 88px;
      height: 64px;
      border-radius: 8px;
      overflow: hidden;
      flex-shrink: 0;
      background: var(--surface2);
      position: relative;
    }
    .ghThumb {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 280ms ease;
    }
    .ghArticleRow:hover .ghThumb { transform: scale(1.06); }
    .ghThumbFallback {
      display: none;
      position: absolute;
      inset: 0;
      background: var(--surface2);
    }
    .ghArticleText {
      display: flex;
      flex-direction: column;
      gap: 4px;
      min-width: 0;
    }
    .ghArticleNum {
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .07em;
      color: var(--brand1);
      text-transform: uppercase;
    }
    .ghArticleTitle {
      font-size: 15px;
      font-weight: 700;
      color: var(--text);
      line-height: 1.25;
      letter-spacing: -0.1px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      transition: color 130ms ease;
    }
    .ghArticleRow:hover .ghArticleTitle { color: var(--link); }
    .ghArticleDesc {
      font-size: 12px;
      color: var(--muted);
      line-height: 1.45;
      margin: 2px 0 0;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* ── View All Row ── */
    .ghViewAllRow { margin-top: 28px; text-align: center; }
    .ghViewAllBtn {
      display: inline-flex;
      align-items: center;
      height: 40px;
      padding: 0 24px;
      border-radius: 999px;
      border: 1.5px solid var(--pillBorder);
      background: var(--pillBg);
      color: var(--link);
      font-size: 14px;
      font-weight: 800;
      text-decoration: none;
      letter-spacing: .02em;
      transition: background 140ms, border-color 140ms, box-shadow 140ms;
    }
    .ghViewAllBtn:hover {
      background: color-mix(in srgb, var(--brand1) 14%, var(--pillBg));
      border-color: var(--brand1);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand1) 16%, transparent);
    }

    /* ── Mobile ── */
    @media (max-width: 640px) {
      .ghHeaderBreadcrumb { padding: 10px 0 8px; font-size: 12px; }
      .ghSection { padding: 20px 0 32px; }
      .ghCategoryBanner { padding: 28px 0 24px; }
      .ghBannerAction { font-size: clamp(2.8rem, 8vw, 4rem); }
      .ghBannerCategory { font-size: clamp(1.2rem, 3vw, 1.8rem); }
      .ghGrid { gap: 16px; }
      .ghArticleRow { grid-template-columns: 72px 1fr; gap: 10px; padding: 12px 14px; }
      .ghThumbWrap { width: 72px; height: 52px; }
      .ghFeatBody { padding: 14px 16px 16px; }
      .ghFeatDesc { -webkit-line-clamp: 2; }
    }
  </style>
</Base>

{/* ── Ribbon active-state script ── */}
<script>
  (function () {
    var ribbon = document.getElementById("ghRibbon");
    if (!ribbon) return;
    var items = Array.prototype.slice.call(ribbon.querySelectorAll(".ghRibbonItem"));
    if (!items.length) return;

    /* Activate the ribbon item whose hash matches the current URL hash */
    function syncActive() {
      var hash = window.location.hash || "";
      var matched = false;
      items.forEach(function (item) {
        var id = item.getAttribute("data-ribbon-id") || "";
        var active = hash === "#" + id;
        item.classList.toggle("is-active", active);
        if (active) {
          matched = true;
          /* Scroll active item into view on mobile */
          item.scrollIntoView({ inline: "nearest", block: "nearest" });
        }
      });
      /* Default: highlight first item when no hash */
      if (!matched && items[0]) {
        items[0].classList.add("is-active");
      }
    }

    syncActive();
    window.addEventListener("hashchange", syncActive);
  })();
</script>
