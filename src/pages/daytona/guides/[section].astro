---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";
import NewsletterBanner from "../../../components/NewsletterBanner.astro";

export async function getStaticPaths() {
  return [
    { params: { section: "coast" } },
    { params: { section: "drive" } },
    { params: { section: "surf"  } },
    { params: { section: "local" } },
  ];
}

const { section } = Astro.params;

const topicMap: Record<string, string> = {
  coast: "COAST",
  drive: "DRIVE",
  surf:  "SURF",
  local: "LOCAL",
};

const colorMap: Record<string, string> = {
  coast: "#7B61FF",
  drive: "#00E676",
  surf:  "#FF4081",
  local: "#FFD600",
};

const textMap: Record<string, string> = {
  coast: "#fff",
  drive: "#000",
  surf:  "#fff",
  local: "#000",
};

const topic      = topicMap[section] ?? "";
const brandColor = colorMap[section] ?? "#ffd24a";
const brandText  = textMap[section]  ?? "#fff";

type RibbonItem = { label: string; href: string; id: string };
const ribbonConfig: Record<string, RibbonItem[]> = {
  coast: [
    { label: "Neighborhoods", href: "#neighborhoods", id: "neighborhoods" },
    { label: "Schools",       href: "#schools",       id: "schools"       },
    { label: "Healthcare",    href: "#healthcare",    id: "healthcare"    },
    { label: "Need to Know",  href: "#need-to-know",  id: "need-to-know"  },
  ],
  drive: [
    { label: "Entrepreneurship", href: "#entrepreneurship", id: "entrepreneurship" },
    { label: "Industry",         href: "#industry",         id: "industry"         },
    { label: "Networking",       href: "#networking",       id: "networking"       },
    { label: "Coworking",        href: "#coworking",        id: "coworking"        },
  ],
  surf: [
    { label: "Outdoors",       href: "#outdoors",     id: "outdoors"     },
    { label: "Arts & Culture", href: "#arts-culture", id: "arts-culture" },
    { label: "Dining",         href: "#dining",       id: "dining"       },
    { label: "Attractions",    href: "#attractions",  id: "attractions"  },
  ],
  local: [
    { label: "Basics & Pets",  href: "#basics-pets",  id: "basics-pets"  },
    { label: "Health",         href: "#health",       id: "health"       },
    { label: "Home Services",  href: "#home-services",id: "home-services"},
    { label: "City & Safety",  href: "#city-safety",  id: "city-safety"  },
  ],
};
const ribbonItems: RibbonItem[] = ribbonConfig[section] ?? [];
const ribbonIds: string[] = ribbonItems.map((r) => r.id);

type ExternalLink = { label: string; href: string; description?: string };
const citySafetyLinks: ExternalLink[] = [
  {
    label: "Volusia County Emergency Management",
    href: "https://www.volusia.org/services/public-protection/emergency-management/",
    description: "Official county emergency preparedness resources, alerts, and evacuation info.",
  },
];

const allGuides = await getCollection("guides");
const topicGuides = allGuides
  .filter((g) => g.data.topic === topic)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const topicSlugSet = new Set(topicGuides.map((g) => g.slug));
const moreGuides = allGuides
  .filter((g) => !topicSlugSet.has(g.slug))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 15);

function guideSlug(g: (typeof allGuides)[number]) {
  return g.slug.split("/").pop()!;
}
function toAnchor(label: string): string {
  return label.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
}
function authorSlug(name: string): string {
  return name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
}
---

<Base
  title={`${topic} Guides | GoDoDaytona`}
  subtitle={`GoDo ${topic} guides for Daytona Beach.`}
  cityBase="daytona"
>
  <div class="ghWrap" style={`--brand-color: ${brandColor}; --brand-text: ${brandText};`}>

    <!-- ── Header stack ── -->
    <div class="ghHeaderStack">

      <div class="ghHeaderBreadcrumb container">
        <a href="/daytona/">GoDoDaytona</a>
        <span class="ghCrumbSep">›</span>
        <a href="/daytona/guides/">Guides</a>
        <span class="ghCrumbSep">›</span>
        <span>{topic}</span>
      </div>

      <div class={`ghCategoryBanner ghCategoryBanner--${section}`}>
        <div class="ghCategoryBannerOverlay"></div>
        <div class="container ghCategoryBannerContent">
          <h1 class="ghCategoryBannerText">
            <span class="ghBannerAction">{topic}</span>
            <span class="ghBannerCategory">[{topic}]</span>
          </h1>
        </div>
      </div>

      {ribbonItems.length > 0 && (
        <div class="ghRibbonOuter" id="ghRibbon">
          <div class="ghRibbonInner">
            <nav class="ghRibbon" aria-label={`${topic} sub-categories`}>
              {ribbonItems.map((item) => (
                <a class="ghRibbonItem" href={item.href} data-ribbon-id={item.id}>
                  {item.label}
                </a>
              ))}
            </nav>
          </div>
        </div>
      )}

    </div>

    <!-- ── Content sections ── -->
    {ribbonItems.length > 0 ? (
      ribbonItems.map((cat, catIdx) => {
        /* Strict subtopic match: a guide lands only in the section whose id
           equals its subtopic anchor. The first section doubles as the
           catch-all for guides with no subtopic (or one that maps to no
           ribbon category), so nothing is orphaned. */
        const catGuides = topicGuides.filter((g) => {
          const sub = g.data.subtopic ? toAnchor(g.data.subtopic) : null;
          if (sub === cat.id) return true;
          if (catIdx === 0 && (!sub || !ribbonIds.includes(sub))) return true;
          return false;
        });
        const hasContent = catGuides.length > 0;
        const isCitySafety = cat.id === "city-safety";

        return (
          <section
            class={`ghSection ghSection--${catIdx % 2 === 0 ? "white" : "alt"}`}
            id={cat.id}
          >
            <div class="container">
              <h2 class="ghCatHeading">{cat.label}</h2>

              {isCitySafety && citySafetyLinks.length > 0 && (
                <div class="ghExtLinksBlock">
                  <p class="ghExtLinksLabel">Official Resources</p>
                  <div class="ghExtLinks">
                    {citySafetyLinks.map((link) => (
                      <a class="ghExtLinkCard" href={link.href} target="_blank" rel="noopener noreferrer">
                        <span class="ghExtLinkArrow">↗</span>
                        <span class="ghExtLinkInner">
                          <span class="ghExtLinkTitle">{link.label}</span>
                          {link.description && <span class="ghExtLinkDesc">{link.description}</span>}
                        </span>
                      </a>
                    ))}
                  </div>
                </div>
              )}

              {!hasContent ? (
                <p class="ghCatEmpty">
                  {catIdx === 0
                    ? `No ${topic.toLowerCase()} guides yet — check back soon!`
                    : `More ${cat.label} guides coming soon.`}
                </p>
              ) : (
                <div class="ghUniformGrid">
                  {catGuides.map((g) => (
                    <article class="ghArticleCard">
                      <div class="ghCardImgWrap">
                        <img
                          class="ghCardImg"
                          src={g.data.image ?? ""}
                          alt={g.data.title}
                          loading="lazy"
                          decoding="async"
                          onerror="this.style.display='none';this.nextElementSibling.style.display='block'"
                        />
                        <div class="ghCardImgFallback" aria-hidden="true"></div>
                      </div>
                      <div class="ghCardBody">
                        <div class="ghCardPills">
                          <a class="ghPill ghPill--topic" href={`/daytona/guides/${section}/`}>{topic}</a>
                          <a class="ghPill ghPill--sub" href={`/daytona/guides/${section}/#${cat.id}`}>{cat.label}</a>
                        </div>
                        <h3 class="ghCardTitle">
                          <a class="ghCardTitleLink" href={`/daytona/guides/${guideSlug(g)}/`}>{g.data.title}</a>
                        </h3>
                        {g.data.description && <p class="ghCardDesc">{g.data.description}</p>}
                        {g.data.author && (
                          <div class="ghCardMeta">
                            <a class="ghCardAuthor" href={`/authors/${authorSlug(g.data.author)}`}>{g.data.author}</a>
                          </div>
                        )}
                        <span class="ghCardCta">Read the guide →</span>
                      </div>
                    </article>
                  ))}
                </div>
              )}
            </div>
          </section>
        );
      })
    ) : (
      <section class="ghSection ghSection--white">
        <div class="container">
          {topicGuides.length === 0 ? (
            <p class="ghCatEmpty">No {topic.toLowerCase()} guides yet — check back soon!</p>
          ) : (
            <div class="ghUniformGrid">
              {topicGuides.map((g) => (
                <article class="ghArticleCard">
                  <div class="ghCardImgWrap">
                    <img
                      class="ghCardImg"
                      src={g.data.image ?? ""}
                      alt={g.data.title}
                      loading="lazy"
                      decoding="async"
                      onerror="this.style.display='none';this.nextElementSibling.style.display='block'"
                    />
                    <div class="ghCardImgFallback" aria-hidden="true"></div>
                  </div>
                  <div class="ghCardBody">
                    <div class="ghCardPills">
                      <a class="ghPill ghPill--topic" href={`/daytona/guides/${section}/`}>{topic}</a>
                      {g.data.subtopic && (
                        <a class="ghPill ghPill--sub" href={`/daytona/guides/${section}/#${toAnchor(g.data.subtopic)}`}>{g.data.subtopic}</a>
                      )}
                    </div>
                    <h3 class="ghCardTitle">
                      <a class="ghCardTitleLink" href={`/daytona/guides/${guideSlug(g)}/`}>{g.data.title}</a>
                    </h3>
                    {g.data.description && <p class="ghCardDesc">{g.data.description}</p>}
                    {g.data.author && (
                      <div class="ghCardMeta">
                        <a class="ghCardAuthor" href={`/authors/${authorSlug(g.data.author)}`}>{g.data.author}</a>
                      </div>
                    )}
                    <span class="ghCardCta">Read the guide →</span>
                  </div>
                </article>
              ))}
            </div>
          )}
        </div>
      </section>
    )}

    <div class="ghBackRow">
      <a class="ghBackBtn" href="/daytona/guides/">← All Guides</a>
    </div>

  </div>

  {moreGuides.length > 0 && (
    <section class="ghMoreSection">
      <div class="container">
        <h2 class="ghMoreHeading">More to Explore</h2>
        <div class="ghMoreGrid">
          {moreGuides.map((g) => {
            const gTopic   = g.data.topic;
            const gColor   = colorMap[gTopic.toLowerCase()] ?? "#111";
            const gText    = textMap[gTopic.toLowerCase()]  ?? "#fff";
            const gSection = gTopic.toLowerCase();
            return (
              <article class="ghMiniCard">
                <div class="ghMiniImgWrap">
                  <img
                    class="ghMiniImg"
                    src={g.data.image ?? ""}
                    alt={g.data.title}
                    loading="lazy"
                    decoding="async"
                    onerror="this.style.display='none';this.nextElementSibling.style.display='block'"
                  />
                  <div class="ghMiniImgFallback" aria-hidden="true"></div>
                </div>
                <div class="ghMiniBody">
                  <a
                    class="ghMiniPill"
                    href={`/daytona/guides/${gSection}/`}
                    style={`background:${gColor};color:${gText};`}
                  >{gTopic}</a>
                  <h3 class="ghMiniTitle">
                    <a class="ghMiniTitleLink" href={`/daytona/guides/${guideSlug(g)}/`}>{g.data.title}</a>
                  </h3>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <style>
    /* ── Smooth scroll globally for this page ── */
    html { scroll-behavior: smooth; }

    /* ── 1200px container override ── */
    .ghWrap .container { max-width: 1200px; }

    .ghWrap { min-height: 100vh; }

    .ghHeaderStack { width: 100%; display: flex; flex-direction: column; gap: 0; }

    /* ── Breadcrumb ── */
    .ghHeaderBreadcrumb {
      font-size: 13px;
      font-weight: 600;
      color: var(--faint);
      padding: 14px 0 10px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .ghHeaderBreadcrumb a { color: var(--brand1); text-decoration: none; }
    .ghHeaderBreadcrumb a:hover { text-decoration: underline; }
    .ghCrumbSep { opacity: .45; }

    /* ── Banner ── */
    .ghCategoryBanner {
      position: relative;
      width: 100%;
      min-height: 220px;
      display: flex;
      align-items: center;
      background-color: #060810;
      background-size: cover;
      background-position: center;
      border-top: 4px solid var(--brand-color, #ffd24a);
      border-bottom: 4px solid var(--brand-color, #ffd24a);
    }
    .ghCategoryBanner--coast { background-image: url('/images/ormond-beach-beach.jpg'); }
    .ghCategoryBanner--drive { background-image: url('/images/the-loop.webp'); }
    .ghCategoryBanner--surf  { background-image: url('/images/ob-loop.jpg'); }
    .ghCategoryBanner--local { background-image: url('/images/old-mural-backup.png'); }

    .ghCategoryBannerOverlay {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.60);
    }
    .ghCategoryBannerContent {
      position: relative;
      z-index: 1;
      padding: 44px 0 38px;
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
    }
    .ghCategoryBannerText {
      margin: 0 auto;
      line-height: 1.1;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      width: 100%;
    }
    .ghBannerAction {
      font-family: 'Monoton', cursive;
      font-size: clamp(2.8rem, 6.5vw, 5rem);
      font-weight: 400;
      color: var(--brand-color, #fff);
      display: block;
      -webkit-font-smoothing: antialiased;
      text-shadow:
        0 0 4px #fff,
        0 0 14px var(--brand-color, #ffd24a),
        0 0 32px var(--brand-color, #ffd24a),
        0 0 60px var(--brand-color, #ffd24a);
    }
    .ghBannerCategory {
      font-family: "Montserrat", "Century Gothic", AppleGothic, Arial, sans-serif;
      font-size: clamp(1rem, 2vw, 1.55rem);
      font-weight: 300;
      letter-spacing: 0.22em;
      color: var(--brand-color, rgba(255,255,255,0.8));
      opacity: 0.7;
      display: block;
    }

    /* ── Sticky sub-nav ribbon ── */
    .ghRibbonOuter {
      position: sticky;
      top: 0;
      z-index: 100;
      width: 100%;
      background: var(--surface);
      border-bottom: 2px solid var(--border);
      box-shadow: 0 2px 12px rgba(0,0,0,0.14);
    }
    .ghRibbonInner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 18px 4px;
    }
    .ghRibbon {
      display: flex;
      flex-wrap: nowrap;
      align-items: stretch;
      justify-content: center;   /* centered on desktop */
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .ghRibbon::-webkit-scrollbar { display: none; }

    .ghRibbonItem {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 22px;
      height: 64px;
      font-family: "Montserrat", "Century Gothic", AppleGothic, Arial, sans-serif;
      font-size: 21px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--muted);
      text-decoration: none;
      border-bottom: 3px solid transparent;
      transition: color 140ms, border-color 140ms;
      white-space: nowrap;
    }
    .ghRibbonItem + .ghRibbonItem::before {
      content: "•";
      margin-right: 22px;
      color: var(--muted);
      opacity: 0.35;
      font-size: 16px;
    }
    .ghRibbonItem:hover {
      color: var(--text);
      border-bottom-color: color-mix(in srgb, var(--brand-color) 55%, transparent);
    }
    @media (max-width: 640px) {
      /* Mobile: left-aligned for swipe */
      .ghRibbon { justify-content: flex-start; }
      .ghRibbonItem { padding: 0 14px; font-size: 14px; height: 48px; }
      .ghRibbonItem + .ghRibbonItem::before { margin-right: 14px; font-size: 11px; }
    }

    /* ── Content sections ── */
    .ghSection {
      padding: 36px 0 52px;
      scroll-margin-top: 70px; /* ribbon height (64px) + 6px buffer */
    }
    .ghSection--white { background: var(--surface); }
    .ghSection--alt   { background: var(--surface2); border-bottom: 1px solid var(--border); }

    .ghCatHeading {
      font-family: "Montserrat", "Century Gothic", AppleGothic, Arial, sans-serif;
      font-size: clamp(1.4rem, 2.8vw, 2rem);
      font-weight: 900;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      text-align: center;
      color: var(--text);
      margin: 0 0 32px;
      padding-bottom: 14px;
      border-bottom: 2px solid var(--brand-color, #ffd24a);
    }
    .ghCatEmpty {
      font-size: 1rem;
      color: var(--muted);
      padding: 16px 0 8px;
      font-style: italic;
    }

    /* ── External resource links (City & Safety) ── */
    .ghExtLinksBlock { margin-bottom: 28px; }
    .ghExtLinksLabel {
      font-size: 11px; font-weight: 800; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--text); margin: 0 0 10px;
    }
    .ghExtLinks { display: flex; flex-direction: column; gap: 10px; }
    .ghExtLinkCard {
      display: flex; align-items: flex-start; gap: 12px; padding: 14px 18px;
      border: 1px solid var(--border); border-left: 4px solid var(--brand-color, #ffd24a);
      border-radius: 10px; background: var(--panel); text-decoration: none;
      transition: box-shadow 160ms;
    }
    .ghExtLinkCard:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.2); }
    .ghExtLinkArrow { font-size: 18px; color: var(--muted); flex-shrink: 0; margin-top: 1px; }
    .ghExtLinkInner { display: flex; flex-direction: column; gap: 3px; }
    .ghExtLinkTitle { font-size: 15px; font-weight: 700; color: var(--text); line-height: 1.2; }
    .ghExtLinkDesc  { font-size: 13px; color: var(--muted); line-height: 1.45; }

    /* ── 3-column article grid ── */
    .ghUniformGrid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    @media (max-width: 900px) { .ghUniformGrid { grid-template-columns: repeat(2, 1fr); gap: 18px; } }
    @media (max-width: 480px) { .ghUniformGrid { grid-template-columns: 1fr; gap: 14px; } }

    /* ── Article card (cover-link pattern) ── */
    .ghArticleCard {
      position: relative;
      display: flex;
      flex-direction: column;
      height: 100%;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--border);
      background: var(--panel);
      transition: box-shadow 200ms, transform 200ms;
    }
    .ghArticleCard:hover {
      box-shadow: 0 8px 28px rgba(0,0,0,0.28);
      transform: translateY(-3px);
    }

    .ghCardImgWrap {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 8;
      overflow: hidden;
      background: var(--surface2);
      flex-shrink: 0;
    }
    .ghCardImg {
      display: block; width: 100%; height: 100%;
      object-fit: cover; object-position: center;
      transition: transform 320ms;
    }
    .ghArticleCard:hover .ghCardImg { transform: scale(1.04); }
    .ghCardImgFallback { display: none; position: absolute; inset: 0; background: var(--surface2); }

    .ghCardBody {
      padding: 14px 18px 16px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      flex: 1;
    }

    /* Dual pills — sit above the cover link via z-index */
    .ghCardPills {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
      position: relative;
      z-index: 1;
    }
    .ghPill {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 999px;
      font-family: "Montserrat", "Century Gothic", AppleGothic, Arial, sans-serif;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
      transition: opacity 130ms;
      line-height: 1.6;
    }
    .ghPill:hover { opacity: 0.75; }
    .ghPill--topic {
      background: var(--brand-color, #111);
      color: var(--brand-text, #fff);
    }
    .ghPill--sub {
      background: transparent;
      color: var(--text);
      border: 1px solid var(--border);
    }
    .ghPill--sub:hover { border-color: var(--brand-color, var(--border)); }

    /* Cover link: ::after stretches over the whole card; pills + meta sit above it */
    .ghCardTitle {
      font-size: 20px;
      font-weight: 700;
      color: var(--text);
      line-height: 1.25;
      margin: 0;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      transition: color 130ms;
    }
    .ghArticleCard:hover .ghCardTitle { color: var(--muted); }
    .ghCardTitleLink { color: inherit; text-decoration: none; }
    .ghCardTitleLink::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 0;
    }

    .ghCardDesc {
      font-size: 14px;
      color: var(--muted);
      line-height: 1.5;
      margin: 0;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .ghCardMeta {
      position: relative;
      z-index: 1;
    }
    .ghCardAuthor {
      font-size: 12px;
      font-weight: 700;
      color: var(--muted);
      text-decoration: none;
      transition: color 130ms;
    }
    .ghCardAuthor:hover { color: var(--brand-color, var(--brand1)); }

    .ghCardCta {
      display: inline-flex;
      align-items: center;
      margin-top: auto;
      padding-top: 6px;
      font-size: 12px;
      font-weight: 800;
      color: var(--text);
      letter-spacing: 0.04em;
    }

    /* ── Back row ── */
    .ghBackRow { text-align: center; padding: 32px 0 48px; }
    .ghBackBtn {
      display: inline-flex; align-items: center; height: 40px; padding: 0 24px;
      border-radius: 999px; border: 1.5px solid var(--border); background: var(--panel);
      color: var(--muted); font-size: 14px; font-weight: 700; text-decoration: none;
      transition: border-color 140ms, color 140ms;
    }
    .ghBackBtn:hover { border-color: var(--brand-color, var(--brand1)); color: var(--text); }

    /* ── More to Explore section ── */
    .ghMoreSection {
      background: var(--surface2);
