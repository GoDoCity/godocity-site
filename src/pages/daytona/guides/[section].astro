---
import GuideLayout from "../../../layouts/GuideLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  return [
    { params: { section: "live" } },
    { params: { section: "work" } },
    { params: { section: "play" } },
    { params: { section: "best" } },
  ];
}

const { section } = Astro.params;

/* Map URL section → display topic label */
const topicMap: Record<string, string> = {
  live: "Live",
  work: "Work",
  play: "Play",
  best: "Best",
};
const topic = topicMap[section] ?? "";

const guide = (
  await getCollection("cityGuides", (g) =>
    g.data.city === "daytona" && g.slug.split("/").pop() === section
  )
)[0];

const rendered = guide ? await guide.render() : null;
---

<GuideLayout
  title={`${guide?.data.title ?? topic} | GoDoDaytona`}
  subtitle={guide?.data.intro ?? "GoDo guides"}
  cityBase="daytona"
  topic={topic}
  showToC={true}
>
  {rendered ? (
    <rendered.Content />
  ) : (
    <p class="lede">
      No guide yet. Add one in <code>src/content/guides/daytona</code>.
    </p>
  )}
</GuideLayout>
