---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

function isDaytonaPost(post) {
  const city = String(post?.data?.city ?? "daytona").toLowerCase().trim();
  if (city === "daytona") return true;
  return typeof post?.id === "string" && post.id.startsWith("daytona/");
}

function isFeatured(post) {
  const v = post?.data?.featured;
  if (v === true) return true;
  if (v === 1) return true;
  const s = String(v ?? "").toLowerCase().trim();
  return s === "true" || s === "yes" || s === "1";
}

function getPostDate(post) {
  return post?.data?.pubDate ?? post?.data?.date ?? post?.data?.published ?? post?.data?.updated ?? null;
}
function sortNewestFirst(a, b) {
  return new Date(getPostDate(b) ?? 0).getTime() - new Date(getPostDate(a) ?? 0).getTime();
}
function dateText(post) {
  const d = getPostDate(post);
  return d ? new Date(d).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" }) : "";
}
function excerpt(post) { return post?.data?.description ?? ""; }
function heroImage(post) {
  const v = post?.data?.heroImage ?? post?.data?.heroimage ?? post?.data?.image ?? post?.data?.thumbnail ?? post?.data?.cover ?? "";
  return typeof v === "string" ? v.trim() : "";
}
function primaryTag(post) {
  const tags = post?.data?.tags;
  if (Array.isArray(tags) && tags.length) return String(tags[0]).trim();
  if (typeof post?.data?.topic === "string") return post.data.topic.trim();
  if (typeof post?.data?.category === "string") return post.data.category.trim();
  return "";
}

const all = await getCollection("posts");
const posts = all.filter(isDaytonaPost).sort(sortNewestFirst);
const hero = posts.find(isFeatured) ?? posts[0] ?? null;
const feed = hero ? posts.filter((p) => p.slug !== hero.slug) : posts;

/* Only 3 articles total on homepage — Nooga style */
const topThree = [hero, ...feed.slice(0, 2)].filter(Boolean).slice(0, 3);

const topics = [
  { label: "Business",          slug: "biz",             img: "/images/topics/business.jpg" },
  { label: "City",              slug: "city",             img: "/images/topics/city.jpg" },
  { label: "Culture",           slug: "culture",          img: "/images/topics/culture.jpg" },
  { label: "Events",            slug: "events",           img: "/images/topics/events.jpg" },
  { label: "Food",              slug: "food",             img: "/images/topics/food.jpg" },
  { label: "History",           slug: "history",          img: "/images/topics/history.jpg" },
  { label: "Real Estate",       slug: "real-estate",      img: "/images/topics/real-estate.jpg" },
  { label: "Sports",            slug: "sports",           img: "/images/topics/sports.jpg" },
  { label: "Travel + Outdoors", slug: "travel-outdoors",  img: "/images/topics/travel-outdoors.jpg" },
];
---

<Base title="GoDo Daytona" subtitle="Good news for Daytona" cityBase="daytona">
  <div class="pageWrap">

    {/* ── NEWSLETTER BAND ── */}
    <div class="nlBand">
      <div class="nlInner">
        <div class="nlCopy">
          <div class="nlEyebrow">Free Newsletter</div>
          <div class="nlHead">Good news for Daytona.</div>
          <div class="nlSub">The best local stories, sent free to your inbox. Unsubscribe anytime.</div>
        </div>
        <form class="nlForm" action="/daytona/subscribe/" method="get">
          <input class="nlInput" type="email" name="email" placeholder="Enter your email address" />
          <button class="nlBtn" type="submit">Sign Up — It's Free</button>
        </form>
      </div>
    </div>

    {/* ── MAIN GRID ── */}
    <div class="container">
      <div class="homeGrid">

        {/* LEFT: FEED */}
        <main class="homeMain">

          <div class="sectionHead">
            <span class="sectionLabel">Latest</span>
            <a class="viewAll" href="/daytona/posts/">View all →</a>
          </div>

          {/* 3 LARGE STACKED ARTICLES */}
          <div class="feedList">
            {topThree.map((p) => (
              <a class="feedRow" href={`/daytona/posts/${p.slug}/`}>
                <div class="feedText">
                  {primaryTag(p) && <div class="feedKicker">{primaryTag(p)}</div>}
                  <div class="feedRowTitle">{p.data.title ?? p.slug}</div>
                  {excerpt(p) && <div class="feedRowDesc">{excerpt(p)}</div>}
                  <div class="feedMeta">{dateText(p)}</div>
                </div>
                <div class="feedThumbWrap">
                  {heroImage(p)
                    ? <img class="feedThumb" src={heroImage(p)} alt="" loading="lazy" decoding="async" />
                    : <div class="feedThumb feedThumbFallback" aria-hidden="true" />
                  }
                </div>
              </a>
            ))}
          </div>

          {/* TOPICS VISUAL GRID */}
          <div class="sectionHead" style="margin-top: 36px">
            <span class="sectionLabel">Topics</span>
          </div>
          <div class="topicsGrid">
            {topics.map((t) => (
              <a class="topicTile" href={`/daytona/topics/${t.slug}/`}>
                <img
                  class="topicImg"
                  src={t.img}
                  alt={t.label}
                  loading="lazy"
                  decoding="async"
                  onerror="this.style.opacity='0'"
                />
                <div class="topicGrad" aria-hidden="true" />
                <span class="topicLabel">{t.label}</span>
              </a>
            ))}
          </div>

        </main>

        {/* RIGHT: SIDEBAR */}
        <aside class="homeRail">

          {/* EVENTS */}
          <div class="railCard">
            <div class="railHead">
              <span class="railTitle">Upcoming Events</span>
              <a class="railMore" href="/daytona/events/">See all</a>
            </div>
            <div class="eventList">
              <a class="eventRow" href="/daytona/events/">
                <div class="eventCal">
                  <div class="eDow">SAT</div>
                  <div class="eDay">15</div>
                </div>
                <div class="eventInfo">
                  <div class="eName">Add your first event</div>
                  <div class="ePlace">Daytona Beach</div>
                </div>
              </a>
              <a class="eventRow" href="/daytona/events/">
                <div class="eventCal">
                  <div class="eDow">SUN</div>
                  <div class="eDay">16</div>
                </div>
                <div class="eventInfo">
                  <div class="eName">Second event placeholder</div>
                  <div class="ePlace">Ormond Beach</div>
                </div>
              </a>
            </div>
          </div>

          {/* CITY GUIDES */}
          <div class="railCard">
            <div class="railHead">
              <span class="railTitle">City Guides</span>
              <a class="railMore" href="/daytona/guides/">See all</a>
            </div>
            <div class="guideList">
              <a class="guideRow" href="/daytona/guides/">Best beaches in Daytona</a>
              <a class="guideRow" href="/daytona/guides/">Where to eat on the strip</a>
              <a class="guideRow" href="/daytona/guides/">Weekend events calendar</a>
            </div>
          </div>

        </aside>
      </div>

      {/* ── ADVERTISE BAND — full width, bottom ── */}
      <div class="adBand">
        <div class="adBandInner">
          <div class="adCopy">
            <div class="adHead">Advertise with GoDo Daytona.</div>
            <div class="adDesc">Reach thousands of Daytona locals with sponsored stories, display ads, and event promotion. Built for local businesses.</div>
          </div>
          <div class="adActions">
            <a class="adBtn" href="/daytona/advertise/">Get started →</a>
            <a class="adBtnGhost" href="/daytona/advertise/">See our rates</a>
          </div>
        </div>
      </div>

    </div>
  </div>

  <style>
    .pageWrap { min-height: 100vh; }

    :global(.container) {
      max-width: 1200px;
      margin: 0 auto;
      padding-left: clamp(16px, 2.5vw, 32px);
      padding-right: clamp(16px, 2.5vw, 32px);
    }

    /* ══ NEWSLETTER BAND ══ */
    .nlBand {
      background: var(--brand1);
      padding: clamp(22px, 3vw, 36px) 0;
      /* Space between pills header and this band */
      margin-top: 20px;
    }
    .nlInner {
      max-width: 860px; /* Narrower — pulled in from edges */
      margin: 0 auto;
      padding: 0 clamp(16px, 2.5vw, 32px);
      display: grid;
      grid-template-columns: 1fr auto;
      gap: clamp(24px, 4vw, 56px);
      align-items: center;
    }
    .nlEyebrow {
      font-size: 10.5px;
      font-weight: 800;
      letter-spacing: .16em;
      text-transform: uppercase;
      color: var(--accentText);
      opacity: .72;
      margin-bottom: 5px;
    }
    .nlHead {
      font-size: clamp(20px, 2.2vw, 26px);
      font-weight: 950;
      color: var(--accentText);
      line-height: 1.08;
      letter-spacing: -0.4px;
    }
    .nlSub {
      margin-top: 6px;
      font-size: 14px;
      color: var(--accentText);
      opacity: .80;
      line-height: 1.45;
    }
    .nlForm {
      display: flex;
      flex-direction: column;
      gap: 8px;
      flex-shrink: 0;
      min-width: 260px;
    }
    .nlInput {
      height: 52px; /* Taller as requested */
      width: 100%;
      border-radius: 12px;
      border: 2px solid rgba(0,0,0,.20);
      background: rgba(255,255,255,.94);
      color: #111;
      padding: 0 16px;
      font-size: 15px;
      outline: none;
      box-sizing: border-box;
    }
    .nlInput::placeholder { color: #999; }
    .nlInput:focus { border-color: rgba(0,0,0,.45); background: #fff; }
    .nlBtn {
      height: 52px; /* Match input */
      width: 100%;
      border-radius: 12px;
      border: 2px solid rgba(0,0,0,.28);
      background: rgba(0,0,0,.22);
      color: var(--accentText);
      font-weight: 900;
      font-size: 15px;
      cursor: pointer;
      transition: background 140ms;
      letter-spacing: .01em;
    }
    .nlBtn:hover { background: rgba(0,0,0,.34); }

    @media (max-width: 720px) {
      .nlInner { grid-template-columns: 1fr; gap: 18px; max-width: 100%; }
      .nlForm { min-width: 0; }
    }

    /* ══ HOME GRID 75/25 ══ */
    .homeGrid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 290px;
      gap: clamp(28px, 3.5vw, 52px);
      align-items: start;
      padding-top: 28px;
      padding-bottom: 12px;
    }
    @media (max-width: 980px) {
      .homeGrid { grid-template-columns: 1fr; }
      .homeRail { order: 2; }
    }

    /* ══ SECTION HEAD ══ */
    .sectionHead {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      padding-bottom: 11px;
      border-bottom: 2px solid var(--brand1);
      margin-bottom: 0;
    }
    .sectionLabel {
      font-size: 11.5px;
      font-weight: 900;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--text);
    }
    .viewAll {
      font-size: 12px;
      font-weight: 700;
      color: var(--link);
      text-decoration: none;
    }
    .viewAll:hover { text-decoration: underline; }

    /* ══ FEED — 3 large stacked rows ══ */
    .feedList { margin-bottom: 0; }

    .feedRow {
      display: grid;
      grid-template-columns: 1fr 160px; /* Larger thumbnail */
      gap: 20px;
      align-items: start;
      padding: 24px 0; /* More breathing room */
      border-bottom: 1px solid var(--border);
      text-decoration: none;
    }
    .feedRow:hover .feedRowTitle { color: var(--link); }

    .feedKicker {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--brand1);
      margin-bottom: 7px;
    }
    .feedRowTitle {
      font-size: clamp(19px, 2vw, 24px); /* Bigger title */
      font-weight: 900;
      line-height: 1.15;
      letter-spacing: -0.3px;
      color: var(--text);
      margin-bottom: 8px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      transition: color 130ms ease;
    }
    .feedRowDesc {
      font-size: 15px; /* Larger description */
      color: var(--muted);
      line-height: 1.5;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin-bottom: 10px;
    }
    .feedMeta {
      font-size: 12.5px;
      color: var(--faint);
    }
    .feedThumbWrap { width: 160px; flex-shrink: 0; }
    .feedThumb {
      display: block;
      width: 160px;
      height: 120px; /* Taller thumbnail */
      object-fit: cover;
      border-radius: 10px;
      background: var(--surface);
    }
    .feedThumbFallback { background: var(--surface2); }

    @media (max-width: 560px) {
      .feedRow { grid-template-columns: 1fr 110px; gap: 14px; padding: 18px 0; }
      .feedThumbWrap { width: 110px; }
      .feedThumb { width: 110px; height: 82px; }
      .feedRowTitle { font-size: 18px; }
      .feedRowDesc { font-size: 13.5px; -webkit-line-clamp: 2; }
    }

    /* ══ TOPICS IMAGE GRID ══ */
    .topicsGrid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-top: 14px;
    }
    @media (max-width: 560px) {
      .topicsGrid { grid-template-columns: repeat(2, 1fr); }
    }

    .topicTile {
      position: relative;
      display: block;
      text-decoration: none;
      border-radius: 10px;
      overflow: hidden;
      aspect-ratio: 3/2;
      background: var(--surface2);
      border: 1px solid var(--border);
    }
    .topicImg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 320ms ease;
    }
    .topicTile:hover .topicImg { transform: scale(1.05); }
    .topicGrad {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,.82) 0%, rgba(0,0,0,.28) 55%, transparent 100%);
    }
    .topicLabel {
      position: absolute;
      bottom: 10px;
      left: 11px;
      right: 11px;
      font-size: 13px;
      font-weight: 900;
      color: #fff;
      line-height: 1.2;
      text-shadow: 0 1px 6px rgba(0,0,0,.6);
    }
    /* Fallback — no image */
    .topicTile:not(:has(img)) .topicGrad { display: none; }
    .topicTile:not(:has(img)) .topicLabel {
      bottom: 50%; transform: translateY(50%);
      color: var(--brand1); text-shadow: none;
      text-align: center;
    }

    /* ══ SIDEBAR ══ */
    .homeRail {
      position: sticky;
      top: 80px;
      display: grid;
      gap: 20px;
    }
    .railCard {
      border: 1px solid var(--border);
      background: var(--surface);
      border-radius: 14px;
      padding: 16px;
    }
    .railHead {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 14px;
    }
    .railTitle {
      font-size: 11px;
      font-weight: 900;
      letter-spacing: .13em;
      text-transform: uppercase;
      color: var(--text);
    }
    .railMore {
      font-size: 11.5px;
      font-weight: 700;
      color: var(--link);
      text-decoration: none;
    }
    .railMore:hover { text-decoration: underline; }

    /* Events */
    .eventList { display: grid; gap: 8px; }
    .eventRow {
      display: grid;
      grid-template-columns: 44px 1fr;
      gap: 10px;
      align-items: center;
      text-decoration: none;
      padding: 8px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--surface2);
      transition: border-color 140ms;
    }
    .eventRow:hover { border-color: var(--pillBorder); }
    .eventCal {
      width: 44px; height: 44px;
      border-radius: 10px;
      background: var(--pillBg);
      border: 1px solid var(--pillBorder);
      display: grid; place-items: center;
      text-align: center; line-height: 1;
    }
    .eDow { font-size: 9px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; color: var(--brand1); }
    .eDay { font-size: 17px; font-weight: 900; color: var(--text); margin-top: 1px; }
    .eName { font-weight: 800; font-size: 13px; color: var(--text); line-height: 1.2; }
    .ePlace { font-size: 11.5px; color: var(--faint); margin-top: 2px; }

    /* Guides */
    .guideList { display: grid; }
    .guideRow {
      display: block;
      text-decoration: none;
      font-size: 13.5px;
      font-weight: 700;
      color: var(--text);
      padding: 9px 0;
      border-bottom: 1px solid var(--border);
      line-height: 1.3;
      transition: color 120ms;
    }
    .guideRow:last-child { border-bottom: none; }
    .guideRow:hover { color: var(--link); }

    /* ══ ADVERTISE BAND — full width bottom ══ */
    .adBand {
      margin: 40px 0 48px;
      border-radius: 16px;
      /* Slightly brighter/bolder than brand1 using color-mix */
      background: linear-gradient(135deg, var(--brand1), var(--brand2));
      padding: clamp(24px, 3vw, 40px);
      box-shadow: 0 8px 32px color-mix(in srgb, var(--brand1) 35%, transparent);
    }
    .adBandInner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
    }
    .adHead {
      font-size: clamp(20px, 2.2vw, 26px);
      font-weight: 950;
      color: var(--accentText);
      letter-spacing: -0.3px;
      margin-bottom: 6px;
    }
    .adDesc {
      font-size: 15px;
      color: var(--accentText);
      opacity: .82;
      line-height: 1.45;
      max-width: 520px;
    }
    .adActions {
      display: flex;
      gap: 10px;
      flex-shrink: 0;
      flex-wrap: wrap;
    }
    .adBtn {
      display: inline-flex;
      align-items: center;
      height: 48px;
      padding: 0 24px;
      border-radius: 12px;
      background: var(--accentText);
      color: var(--brand1);
      font-size: 15px;
      font-weight: 900;
      text-decoration: none;
      transition: opacity 140ms;
      white-space: nowrap;
    }
    .adBtn:hover { opacity: .88; }
    .adBtnGhost {
      display: inline-flex;
      align-items: center;
      height: 48px;
      padding: 0 20px;
      border-radius: 12px;
      border: 2px solid rgba(255,255,255,.45);
      color: var(--accentText);
      font-size: 14px;
      font-weight: 800;
      text-decoration: none;
      transition: border-color 140ms;
      white-space: nowrap;
    }
    .adBtnGhost:hover { border-color: rgba(255,255,255,.80); }
  </style>
</Base>
