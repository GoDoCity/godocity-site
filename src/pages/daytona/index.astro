---
import Base from "../../layouts/Base.astro";
import InteractiveMap from "../../components/InteractiveMap.astro";
import { getCollection } from "astro:content";
import { getGreaterDaytonaEvents, cityDisplayName } from "../../lib/events.js";

function isDaytonaPost(post) {
  const city = String(post?.data?.city ?? "daytona").toLowerCase().trim();
  if (city === "daytona") return true;
  return typeof post?.id === "string" && post.id.startsWith("daytona/");
}
function isFeatured(post) {
  const v = post?.data?.featured;
  if (v === true) return true;
  if (v === 1) return true;
  return ["true","yes","1"].includes(String(v ?? "").toLowerCase().trim());
}
function getPostDate(post) {
  return post?.data?.pubDate ?? post?.data?.date ?? post?.data?.published ?? post?.data?.updated ?? null;
}
function sortNewestFirst(a, b) {
  return new Date(getPostDate(b) ?? 0).getTime() - new Date(getPostDate(a) ?? 0).getTime();
}
function dateText(post) {
  const d = getPostDate(post);
  return d ? new Date(d).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" }) : "";
}
function authorText(post) {
  const a = post?.data?.author ?? post?.data?.authorName ?? post?.data?.by ?? "";
  return typeof a === "string" && a.trim() ? a.trim() : "Charles King";
}
function byline(post) {
  const d = dateText(post);
  const a = authorText(post);
  return d ? `${d} • ${a}` : a;
}
function heroImage(post) {
  const v = post?.data?.heroImage ?? post?.data?.heroimage ?? post?.data?.image ?? post?.data?.thumbnail ?? post?.data?.cover ?? "";
  return typeof v === "string" ? v.trim() : "";
}
function thumbImage(post) {
  const v = post?.data?.thumbnail ?? post?.data?.heroImage ?? post?.data?.heroimage ?? post?.data?.image ?? post?.data?.cover ?? "";
  return typeof v === "string" ? v.trim() : "";
}
function tagSlugFromRaw(raw) {
  return String(raw ?? "").toLowerCase().trim()
    .replace(/\s*&\s*/g, " ")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
}
function kickerParts(post) {
  const cat = typeof post.data?.category === "string" ? post.data.category.trim() : "";
  const catSlug = cat ? tagSlugFromRaw(cat) : "";
  const catLabel = cat ? cat.toUpperCase() : "";
  const sub = typeof post.data?.subtopic === "string" ? post.data.subtopic.trim() : "";
  return { catLabel, catSlug, sub };
}
function primaryTag(post) {
  const tags = post?.data?.tags;
  if (Array.isArray(tags) && tags.length) return String(tags[0]).trim();
  if (typeof post?.data?.topic === "string") return post.data.topic.trim();
  if (typeof post?.data?.category === "string") return post.data.category.trim();
  return "";
}
function excerpt(post) {
  const v = post?.data?.description ?? post?.data?.excerpt ?? post?.data?.summary ?? post?.data?.intro ?? post?.body ?? "";
  if (typeof v !== "string" || !v.trim()) return "";
  const clean = v.replace(/[#*_`>\[\]]/g, " ").replace(/\s+/g, " ").trim();
  return clean.length > 160 ? clean.slice(0, 157).trimEnd() + "…" : clean;
}

const all = await getCollection("posts");
const posts = all.filter(isDaytonaPost).sort(sortNewestFirst);
const hero = posts.find(isFeatured) ?? posts[0] ?? null;
const feed = hero ? posts.filter((p) => p.slug !== hero.slug) : posts;
const latest = feed.slice(0, 3);
const listFeed = feed.slice(3, 7);  /* ── Latest Feed — exactly 4 rows below the 3-card grid (Rule of 4) ── */

/* ── Sheet events via centralised singleton ──────────────────────────────────
   getGreaterDaytonaEvents() shares the same module-level promise as the Events
   page and ArticleSidebar — importFromSheet() runs only ONCE per build.       */
const allDaytona = await getGreaterDaytonaEvents();

/* Home sidebar: sponsored slider (up to 5) + up to 3 regular events */
const homeSponsored = allDaytona.filter((e: any) => e.data.sponsored === true).slice(0, 5);
const homeRegular   = allDaytona.filter((e: any) => !e.data.sponsored).slice(0, 3);

/* Map pins — events with valid non-ocean coordinates */
const homePins = allDaytona
  .filter((e: any) => e.data.lat != null && e.data.lng != null && (e.data.lat !== 0 || e.data.lng !== 0))
  .map((e: any) => {
    const d = new Date(e.data.eventDate);
    const dateStr = d.toLocaleDateString("en-US", { month: "short", day: "numeric" });
    return {
      label:   e.data.title,
      address: `${dateStr} · ${e.data.location ?? ""}`,
      lat:     e.data.lat,
      lng:     e.data.lng,
      image:   e.data.image ?? "/images/daytona-placeholder.jpg",
      url:     e.data.url ?? null,
    };
  });

const featuredAd = {
  tag: "Featured Business",
  title: "Your Business Name Here — Reach Daytona Locals",
  description: "This is where your featured story goes. Up to 75 words, written by our team. Drives real traffic from an engaged local audience who already love Daytona.",
  ctaText: "Learn More",
  ctaHref: "/daytona/advertise/",
  img: "",
};

/* ── 3×3 Topics Grid — strict 9 tiles, no overflow ─────────────────
   Row 1: Biz · City · Culture
   Row 2: Events · Food · History
   Row 3: Real Estate · Sports · Wellness
──────────────────────────────────────────────────────────────────── */
const topics = [
  { label: "Business",    slug: "business",     img: "/images/topics/business.jpg" },
  { label: "City",        slug: "city",         img: "/images/topics/city.jpg" },
  { label: "Culture",     slug: "culture",      img: "/images/topics/culture.jpg" },
  { label: "Events",      slug: "events",       img: "/images/topics/events.jpg" },
  { label: "Food",        slug: "food",         img: "/images/topics/food.jpg" },
  { label: "History",     slug: "history",      img: "/images/topics/history.jpg" },
  { label: "Real Estate", slug: "real-estate",  img: "/images/topics/real-estate.jpg" },
  { label: "Sports",      slug: "sports",       img: "/images/topics/sports.jpg" },
  { label: "Wellness",    slug: "wellness",     img: "/images/topics/wellness.jpg" },
];
/* ── TOPIC IMAGE GUIDE (save to /public/images/topics/) ──────────────
   biz.jpg         → Local storefronts or Main Street Daytona aerial
   city.jpg        → Drone shot of Daytona Beach coastline at golden hour
   culture.jpg     → Neon lights of a local music venue or bold street mural
   events.jpg      → Packed grandstands at Daytona 500 or Bike Week crowd
   food.jpg        → Close-up burger / plated dish / condensation cocktail
   history.jpg     → Historic Daytona boardwalk or vintage B&W race photo
   real-estate.jpg → Modern beachfront balcony or charming historic home
   sports.jpg      → Motion-blur race car or surfer at New Smyrna Beach
   wellness.jpg    → Yoga on the beach, sunrise run, or spa interior
────────────────────────────────────────────────────────────────────── */

/* trendingSpots removed — homepage map now shows Live sheet events only */
---

<Base title="GoDo Daytona" subtitle="Good news for Daytona" cityBase="daytona">
  <div class="pageWrap">

    {/* ── NEWSLETTER BAND — 160px compact utility strip ── */}
    <div class="nlBand" id="nlBand">
      <div class="nlInner">
        <div class="nlContent" id="nlContent">
          <div class="nlHead"><em>Good News <span class="nlCity">Daytona</span>!</em></div>
          <div class="nlSub">Get the best local news &amp; events sent to your inbox, <strong>for free.</strong></div>
          <form class="nlForm" id="nlForm" action="/daytona/subscribe/" method="get">
            <div class="nlRow">
              <input class="nlInput" type="email" name="email" placeholder="Enter your email address" aria-label="Email address" />
              <button class="nlBtn" type="submit">SIGN UP, IT'S FREE!</button>
            </div>
          </form>
          <div class="nlFine">100% free, unsubscribe anytime.</div>
        </div>
        <div class="nlThanks" id="nlThanks" aria-live="polite">Thank you! You're on the list. ✓</div>
      </div>
    </div>
    <script is:inline>
    (function(){
      /* ── Full-bleed fix for nlBand ──────────────────────────────────────
         Reads the actual left offset of the band from the viewport and
         applies negative margin + extra width to reach true screen edges.
         Works regardless of Base.astro's wrapper structure or overflow.   */
      function bleedFix() {
        /* Apply full-bleed to any element that should span screen edges.
           Reads actual pixel offset from viewport and compensates exactly. */
        function makeBleed(el) {
          if (!el) return;
          el.style.marginLeft = '';
          el.style.width = '';
          var rect = el.getBoundingClientRect();
          var leftOffset = rect.left;
          var rightGap = window.innerWidth - rect.right;
          if (leftOffset > 0 || rightGap > 0) {
            el.style.marginLeft = '-' + leftOffset + 'px';
            el.style.width = 'calc(100% + ' + (leftOffset + rightGap) + 'px)';
          }
        }
        makeBleed(document.getElementById('nlBand'));
        makeBleed(document.getElementById('adBand'));
        makeBleed(document.getElementById('alertBand'));
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bleedFix);
      } else {
        bleedFix();
      }
      window.addEventListener('resize', bleedFix);

      var form = document.getElementById('nlForm');
      var content = document.getElementById('nlContent');
      var thanks = document.getElementById('nlThanks');
      if (!form) return;
      form.addEventListener('submit', function(e){
        e.preventDefault();
        content.style.display = 'none';
        thanks.style.display = 'flex';
        /* height: auto — banner shrinks naturally to thank-you text */
      });
    })();
    </script>

    {/* ── COMMUNITY ALERT BAR — thin strip under email band ── */}
    <a class="homeAlertBar" id="alertBand" href="/daytona/vibe-check/">
      🗳️ <strong>Vibe Check:</strong> Who has the best tacos in Ormond? <span class="habVote">Vote Now →</span>
    </a>

    <div class="container">
      <div class="homeGrid">

        <main class="homeMain">

          {/* ── HERO — cinematic wide crop, anchored to sidebar height ── */}
          {hero && (
            <a class="heroCard" href={`/daytona/${hero.slug.split('/').pop()}/`}>
              <div class="heroImgWrap">
                {heroImage(hero)
                  ? <img class="heroImg" src={heroImage(hero)} alt={hero.data.title ?? ""} loading="eager" decoding="async" />
                  : <div class="heroImg heroFallback" aria-hidden="true" />
                }
              </div>
              <div class="heroCopy">
                {(() => { const { catLabel, sub } = kickerParts(hero); const label = catLabel || primaryTag(hero).toUpperCase(); return label && <div class="heroKicker">{label}{sub ? ` — ${sub}` : ""}</div>; })()}
                <h2 class="heroTitle">{hero.data.title ?? hero.slug}</h2>
                {excerpt(hero) && <p class="heroDesc">{excerpt(hero)}</p>}
                <div class="heroMeta">
                  {dateText(hero)}<span class="metaAuthor"> • {authorText(hero)}</span>
                </div>
              </div>
            </a>
          )}

          <div class="feedDivider"></div>

          {/* ── 3 CARDS SIDE BY SIDE ── */}
          <div class="cardGrid">
            {latest.map((p) => (
              <a class="articleCard" href={`/daytona/${p.slug.split('/').pop()}/`}>
                <div class="cardImgWrap">
                  {heroImage(p)
                    ? <img class="cardImg" src={heroImage(p)} alt="" loading="lazy" decoding="async" />
                    : <div class="cardImg cardImgFallback" aria-hidden="true" />
                  }
                </div>
                <div class="cardBody">
                  {(() => { const { catLabel, sub } = kickerParts(p); const label = catLabel || primaryTag(p).toUpperCase(); return label && <div class="cardKicker">{label}{sub ? ` — ${sub}` : ""}</div>; })()}
                  <div class="cardTitle">{p.data.title ?? p.slug}</div>
                  {excerpt(p) && <div class="cardDesc">{excerpt(p)}</div>}
                  <div class="cardMeta">
                    {dateText(p)}<span class="metaAuthor"> • {authorText(p)}</span>
                  </div>
                </div>
              </a>
            ))}
          </div>

          {/* ── TRENDING NOW MAP ── */}
          <div class="masterMapBlock">
            <div class="masterMapHead">
              <span class="masterMapTitle">Go Do Daytona: Live Events</span>
              <span class="masterMapSub">{homePins.length} event{homePins.length !== 1 ? "s" : ""} on the map</span>
            </div>
            <InteractiveMap locations={homePins} height="450px" center={[29.2108, -81.0228]} />
          </div>

          {/* ── FEATURED AD — "FEATURED" label, never "Sponsored" ── */}
          <div class="featuredCard">
            <div class="featuredHeader">
              <span class="featuredStar">★</span>
              <span class="featuredLabel">FEATURED</span>
              <span class="featuredTag">{featuredAd.tag}</span>
            </div>
            <div class="featuredBody">
              {featuredAd.img && (
                <img class="featuredImg" src={featuredAd.img} alt="" loading="lazy" />
              )}
              <div class="featuredText">
                <div class="featuredTitle">{featuredAd.title}</div>
                <div class="featuredDesc">{featuredAd.description}</div>
                <a class="featuredCta" href={featuredAd.ctaHref}>{featuredAd.ctaText} →</a>
              </div>
            </div>
          </div>

          {/* ── LATEST FEED — flat horizontal rows, Nooga style ── */}
          {listFeed.length > 0 && (
            <section class="latestFeed" aria-label="Latest stories">
              <div class="latestHead">
                <span class="latestLabel">Latest</span>
                <a class="latestMore" href="/daytona/posts/">View all →</a>
              </div>

              {listFeed.map((p) => {
                const { catLabel, sub } = kickerParts(p);
                const kickerLabel = catLabel || primaryTag(p).toUpperCase();
                return (
                  <a class="latestRow" href={`/daytona/${p.slug.split('/').pop()}/`}>
                    <div class="latestThumbWrap">
                      {thumbImage(p)
                        ? <img class="latestThumb" src={thumbImage(p)} alt="" loading="lazy" decoding="async" />
                        : <div class="latestThumb latestThumbFallback" aria-hidden="true" />
                      }
                    </div>
                    <div class="latestText">
                      {kickerLabel && (
                        <div class="latestKicker">
                          {kickerLabel}{sub ? ` — ${sub}` : ""}
                        </div>
                      )}
                      <div class="latestTitle">{p.data.title ?? p.slug}</div>
                      <div class="latestByline">{byline(p)}</div>
                    </div>
                  </a>
                );
              })}
            </section>
          )}

          <div class="viewAllRow">
            <a class="viewAllBtn" href="/daytona/posts/">View all stories →</a>
          </div>

          {/* ── TOPICS ── */}
          <div class="topicsHead">
            <span class="topicsLabel">Topics</span>
          </div>
          <div class="topicsGrid">
            {topics.map((t) => (
              <a class="topicTile" href={t.slug === "events" ? `/daytona/events/` : `/daytona/${t.slug}/`}>
                <img class="topicImg" src={t.img} alt={t.label} loading="lazy" decoding="async" onerror="this.style.opacity='0'" />
                <div class="topicGrad" aria-hidden="true" />
                <span class="topicLabel">{t.label}</span>
              </a>
            ))}
          </div>

        </main>

        {/* ── SIDEBAR — aligns top with hero, borderless ── */}
        <aside class="homeRail">

          {/* ── EDITORIAL TEAM — above Upcoming Events ── */}
          <div class="editTeamSection">
            <div class="railHead">
              <span class="railTitle editTeamTitle">GoDoCity Editorial Team</span>
            </div>
            <div class="editTeamRow">
              <img
                class="editHeadshot"
                src="data:image/jpeg;base64,"
                alt="Charles King"
                width="80"
                height="80"
                loading="eager"
                onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
              />
              <div class="editHeadshotFallback" aria-hidden="true">CK</div>
              <div class="editTeamInfo">
                <div class="editName">Charles King</div>
                <div class="editTitle">Newsletter Editor</div>
              </div>
            </div>
          </div>

          <div class="railSection">
            <div class="railHead">
              <span class="railTitle">Upcoming Events</span>
              <a class="railMore" href="/daytona/events/">See all</a>
            </div>

            {(homeSponsored.length === 0 && homeRegular.length === 0) ? (
              <p class="noEvents">No upcoming events — check back soon.</p>
            ) : (
              <div class="eventList">

                {/* ── Smart Slider: sponsored events, fades every 5 s ── */}
                {homeSponsored.length > 0 && (
                  <div class="evSlider" id="homeSlider" aria-label="Featured sponsored events">
                    {homeSponsored.map((e: any, idx: number) => {
                      const d      = new Date(e.data.eventDate);
                      const dow    = d.toLocaleDateString("en-US", { weekday: "short" }).toUpperCase();
                      const day    = d.getDate();
                      const eMon   = d.toLocaleDateString("en-US", { month: "short" }).toUpperCase();
                      const mon    = d.toLocaleDateString("en-US", { month: "short" });
                      const evCity = (e.data.city ?? e.slug.split("/")[0]).toLowerCase().trim();
                      const evSlug = e.slug.split("/").pop();
                      return (
                        <a class={`evSlide${idx === 0 ? " evSlide--active" : ""}`}
                           href={e.data.url ?? `/daytona/events/${evSlug}/`}
                           target={e.data.url ? "_blank" : "_self"}
                           rel={e.data.url ? "noopener" : ""}
                           aria-hidden={idx !== 0 ? "true" : undefined}
                           data-slide-idx={String(idx)}>
                          <div class="eventCal">
                            <div class="eDow">{dow}</div>
                            <div class="eDay">{day}</div>
                            <div class="eMon">{eMon}</div>
                          </div>
                          <div class="eventInfo">
                            <div class="eName">{e.data.title}</div>
                            <div class="ePlace">
                              <span>{mon} {day}</span>
                              <span class="evCitySep">|</span>
                              <span class="evCityName">{cityDisplayName(evCity)}</span>
                              <span class="evSrcBadge evSrcBadge--featured">Sponsored</span>
                            </div>
                          </div>
                        </a>
                      );
                    })}
                    {homeSponsored.length > 1 && (
                      <div class="sbDots" id="homeDots">
                        {homeSponsored.map((_: any, idx: number) => (
                          <button
                            class={`sbDot${idx === 0 ? " sbDot--active" : ""}`}
                            aria-label={`Go to slide ${idx + 1}`}
                            data-sb-dot={String(idx)}
                            type="button"
                          ></button>
                        ))}
                      </div>
                    )}
                  </div>
                )}

                {/* ── Static list: regular upcoming events ── */}
                {homeRegular.map((e: any) => {
                  const d      = new Date(e.data.eventDate);
                  const dow    = d.toLocaleDateString("en-US", { weekday: "short" }).toUpperCase();
                  const day    = d.getDate();
                  const mon    = d.toLocaleDateString("en-US", { month: "short" }).toUpperCase();
                  const evSlug = e.slug.split("/").pop();
                  return (
                    <a class="eventRow"
                       href={e.data.url ?? `/daytona/events/${evSlug}/`}
                       target={e.data.url ? "_blank" : "_self"}
                       rel={e.data.url ? "noopener" : ""}>
                      <div class="eventCal">
                        <div class="eDow">{dow}</div>
                        <div class="eDay">{day}</div>
                        <div class="eMon">{mon}</div>
                      </div>
                      <div class="eventInfo">
                        <div class="eName">{e.data.title}</div>
                        <div class="ePlace">{e.data.location}</div>
                      </div>
                    </a>
                  );
                })}

              </div>
            )}
          </div>

          <div class="displayAdSlot">
            <div class="adSlotLabel">Advertisement</div>
            <a class="displayAdCard" href="/daytona/advertise/">
              <div class="displayAdInner">
                <div class="displayAdIcon">📢</div>
                <div class="displayAdTitle">Your Ad Here</div>
                <div class="displayAdDesc">Reach thousands of Daytona locals</div>
                <div class="displayAdCta">Advertise with us →</div>
              </div>
            </a>
          </div>

          <div class="railSection">
            <div class="railHead">
              <span class="railTitle">City Guides</span>
              <a class="railMore" href="/daytona/guides/">See all</a>
            </div>
            <div class="guideList">
              <a class="guideRow" href="/daytona/guides/live/">🏠 Live in Daytona</a>
              <a class="guideRow" href="/daytona/guides/work/">💼 Work in Daytona</a>
              <a class="guideRow" href="/daytona/guides/play/">🎉 Play in Daytona</a>
            </div>
          </div>

        </aside>
      </div>

    </div>{/* end .container */}

    {/* ── ADVERTISE BAND — outside container so it can go full-width ── */}
    <div class="adBand" id="adBand">
      <div class="adBandInner">
        <div class="adCopy">
          <div class="adEyebrow">Grow your business</div>
          <div class="adHead">Advertise with GoDo Daytona.</div>
          <div class="adDesc">Reach thousands of engaged Daytona locals every day. Featured stories, display ads, event promotion, and newsletter placements — built for local businesses that want real results.</div>
        </div>
        <div class="adActions">
          <a class="adBtnPrimary" href="/daytona/advertise/">Get started →</a>
          <a class="adBtnGhost" href="/daytona/advertise/">See our rates</a>
        </div>
      </div>
    </div>

  </div>{/* end .pageWrap */}

  <style>
    /* ── Century Gothic / Arial fallback across entire site ── */
    :global(html), :global(body) {
      font-family: "Century Gothic", AppleGothic, Arial, sans-serif;
      /* Hard reset — nothing escapes the glass */
      overflow-x: hidden;
      width: 100%;
      position: relative;
    }
    .pageWrap {
      min-height: 100vh;
      overflow-x: hidden;
      width: 100%;
      position: relative;
    }

    /* ── 1280px breath container — equal space both sides on any monitor ── */
    :global(.container) {
      max-width: 1280px;
      margin: 0 auto;
      padding-left: 2.5rem;
      padding-right: 2.5rem;
    }
    @media (max-width: 768px) {
      :global(.container) {
        max-width: 100%;          /* never wider than the viewport */
        padding-left: 1.25rem;    /* 20px each side as specified   */
        padding-right: 1.25rem;
      }
    }

    /* ── Newsletter — breathing room above, alert bar directly below ── */
    .nlBand {
      background: var(--brand1);
      margin: 24px 0 0;   /* 24px gap between nav pills and banner; alert bar sits flush below */
      width: 100%;
      display: flex;
      align-items: stretch;
      overflow: hidden;
      transition: height 350ms ease;
    }
    .nlInner {
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
      padding: 24px 2.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .nlContent {
      max-width: 680px;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 6px;
    }
    .nlHead {
      font-size: clamp(29px, 3.2vw, 38px);
      font-weight: 900;
      font-style: italic;          /* "Speedway" lean — slanted heavy sans */
      color: #000;
      line-height: 1.0;
      letter-spacing: -0.04em;
    }
    /* City name span — swap "Daytona" → "Orlando" etc. without touching the template */
    .nlCity {
      font-style: italic;
      font-weight: 900;
    }
    .nlSub {
      /* Normal weight body, +1pt from 18px → 19px, "for free." stays extra-bold */
      font-size: 19px;
      font-weight: 400;            /* reverted to normal as requested */
      color: rgba(0,0,0,.78);
      line-height: 1.2;
      white-space: nowrap;
    }
    /* "for free." — Extra Bold emphasis, value hook */
    .nlSub strong { font-weight: 900; color: #000; }
    .nlForm { width: 100%; max-width: 480px; }
    .nlRow { display: flex; height: 48px; width: 100%; }
    .nlInput {
      flex: 1; min-width: 0;
      border-radius: 8px 0 0 8px;
      border: 2px solid rgba(0,0,0,.4);
      border-right: none;
      background: #fff; color: #111;
      padding: 0 14px; font-size: 15px; font-weight: 500;
      outline: none;
      transition: border-color 150ms;
    }
    .nlInput::placeholder { color: #999; }
    .nlInput:focus { border-color: rgba(0,0,0,.75); }
    .nlBtn {
      flex-shrink: 0; padding: 0 20px;
      border-radius: 0 8px 8px 0;
      border: none;
      background: #000;
      color: #fff;
      font-weight: 900; font-size: 14px; cursor: pointer;
      white-space: nowrap; letter-spacing: .03em;
      transition: background 140ms;
    }
    .nlBtn:hover { background: #222; }
    .nlFine {
      font-size: 12px; font-weight: 500;
      color: rgba(0,0,0,.48);
      font-style: italic;
    }
    /* Success state */
    .nlThanks {
      display: none;
      align-items: center;
      justify-content: center;
      font-size: clamp(29px, 3.2vw, 38px);
      font-weight: 900;
      color: #000;
      text-align: center;
      padding: 28px 2.5rem;
      width: 100%;
    }
    @media (max-width: 700px) {
      .nlBand { margin-top: 16px; margin-bottom: 0; }
      .nlInner { padding: 20px 1.25rem; justify-content: center; text-align: center; }
      .nlContent { max-width: 100%; align-items: center; text-align: center; }
      .nlSub { white-space: normal; font-size: 15px; text-align: center; }
      .nlRow { flex-direction: column; height: auto; gap: 8px; align-items: center; }
      .nlInput { border-radius: 8px; border-right: 2px solid rgba(0,0,0,.4); height: 46px; }
      .nlBtn { border-radius: 8px; height: 46px; width: 100%; }
    }

    /* ── Home grid 75/25 inside 1280px container ── */
    .homeGrid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 290px;
      gap: clamp(40px, 4vw, 56px);
      align-items: start;
      padding-top: 0;
      padding-bottom: 12px;
    }
    @media (max-width: 980px) {
      .homeGrid { grid-template-columns: 1fr; }
      .homeRail { order: 2; }
    }

    /* ── HERO — 315×178 ×1.45 = 458×259px — 8.3×4.7cm ratio locked, 60px breath above ── */
    .heroCard {
      display: grid;
      grid-template-columns: 458px 1fr;
      gap: 24px;
      align-items: start;
      text-decoration: none;
      padding-bottom: 18px;
    }
    @media (max-width: 640px) { .heroCard { grid-template-columns: 1fr; } }

    .heroImgWrap {
      border-radius: 12px;
      overflow: hidden;
      width: 458px;
      height: 259px;
      flex-shrink: 0;
    }
    .heroImg {
      display: block;
      width: 458px;
      height: 259px;
      object-fit: cover;
      object-position: center;
      background: var(--surface);
    }
    .heroFallback {
      width: 458px;
      height: 259px;
      background: var(--surface2);
    }
    .heroCopy { max-width: 400px; }

    /* ── Hero mobile: fluid image, text wrapping locked ── */
    @media (max-width: 640px) {
      .heroImgWrap {
        width: 100%;
        height: auto;
        aspect-ratio: 16/9;
      }
      .heroImg {
        width: 100%;
        height: auto;
        aspect-ratio: 16/9;
      }
      .heroFallback {
        width: 100%;
        height: 180px;
      }
      .heroCopy {
        max-width: 100%;
        min-width: 0;
        flex-shrink: 1;
      }
      .heroTitle {
        word-wrap: break-word;
        overflow-wrap: break-word;
        white-space: normal;
      }
      .heroDesc {
        word-wrap: break-word;
        overflow-wrap: break-word;
        white-space: normal;
        font-size: 15px;
      }
    }

    .heroKicker {
      font-size: 10.5px; font-weight: 800;
      letter-spacing: .1em; text-transform: uppercase;
      color: var(--brand1); margin-bottom: 9px;
    }
    .heroTitle {
      /* Reduced another 10% from previous — matches Nooga's lighter touch */
      font-size: clamp(20px, 2.1vw, 30px);
      font-weight: 800;
      line-height: 1.09;
      letter-spacing: -0.5px;
      color: var(--text);
      margin: 0 0 11px;
      transition: color 130ms ease;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .heroCard:hover .heroTitle { color: var(--link); }
    .heroDesc {
      color: var(--muted);
      font-size: 18px;
      font-weight: 500;
      line-height: 1.55; margin: 0 0 13px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .heroMeta { font-size: 12.5px; color: var(--faint); }

    /* Single divider + 40px editorial breathing room above triple-threat */
    .feedDivider {
      height: 2px;
      background: var(--brand1);
      margin: 0 0 40px;
    }

    /* ── 3-column cards — gap tightened −25%, images +10% taller ── */
    .cardGrid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 21px;       /* 28px × 0.75 = 21px */
      margin-bottom: 32px;
    }
    @media (max-width: 640px) { .cardGrid { grid-template-columns: 1fr; gap: 0; } }

    .articleCard {
      display: flex; flex-direction: column; text-decoration: none;
    }
    @media (max-width: 640px) {
      .articleCard {
        display: grid; grid-template-columns: 1fr 100px;
        gap: 12px; align-items: start;
        padding: 16px 0; border-bottom: 1px solid var(--border);
      }
    }
    .cardImgWrap {
      border-radius: 11px; overflow: hidden; margin-bottom: 11px;
    }
    @media (max-width: 640px) {
      .cardImgWrap { margin-bottom: 0; order: 2; border-radius: 8px; }
    }
    .cardImg {
      display: block; width: 100%;
      aspect-ratio: 16/12;   /* +10% taller than previous 16/11 */
      object-fit: cover; background: var(--surface);
      transition: transform 280ms ease;
    }
    .articleCard:hover .cardImg { transform: scale(1.03); }
    .cardImgFallback { aspect-ratio: 16/12; background: var(--surface2); }
    @media (max-width: 640px) {
      .cardImg { aspect-ratio: unset; width: 100px; height: 74px; }
      .cardImgFallback { width: 100px; height: 74px; }
    }
    .cardBody { flex: 1; }
    .cardKicker {
      font-size: 10px; font-weight: 800;
      letter-spacing: .08em; text-transform: uppercase;
      color: var(--brand1); margin-bottom: 5px;
    }
    .cardTitle {
      font-size: 22px;
      font-weight: 900; line-height: 1.2;
      letter-spacing: -0.2px; color: var(--text); margin-bottom: 6px;
      display: -webkit-box; -webkit-line-clamp: 3;
      -webkit-box-orient: vertical; overflow: hidden;
      transition: color 130ms ease;
    }
    .articleCard:hover .cardTitle { color: var(--link); }
    .cardDesc {
      font-size: 16px; font-weight: 500;
      color: var(--muted); line-height: 1.45; margin-bottom: 7px;
      display: -webkit-box; -webkit-line-clamp: 2;
      -webkit-box-orient: vertical; overflow: hidden;
    }
    .cardMeta { font-size: 11.5px; color: var(--faint); }

    /* ── FEATURED ad — "FEATURED" all-caps label ── */
    .featuredCard {
      margin: 0 0 20px;
      border: 1.5px solid var(--pillBorder);
      background: var(--surface); border-radius: 14px; overflow: hidden;
    }
    .featuredHeader {
      display: flex; align-items: center; gap: 7px;
      padding: 6px 14px; background: var(--pillBg);
      border-bottom: 1px solid var(--pillBorder);
    }
    .featuredStar { font-size: 11px; color: var(--brand1); }
    .featuredLabel {
      /* All-caps FEATURED — never "Sponsored" */
      font-size: 10px; font-weight: 900;
      letter-spacing: .14em; text-transform: uppercase; color: var(--brand1);
    }
    .featuredTag { font-size: 10px; font-weight: 600; color: var(--muted); letter-spacing: .04em; }
    .featuredBody { padding: 14px 16px; display: grid; gap: 10px; }
    .featuredImg { display: block; width: 100%; height: 150px; object-fit: cover; border-radius: 9px; }
    .featuredTitle {
      font-size: 16.5px; font-weight: 900; color: var(--text);
      line-height: 1.2; margin-bottom: 5px; letter-spacing: -0.2px;
    }
    .featuredDesc { font-size: 13px; color: var(--muted); line-height: 1.45; margin-bottom: 12px; }
    .featuredCta {
      display: inline-flex; align-items: center;
      height: 36px; padding: 0 16px; border-radius: 999px;
      background: var(--brand1); color: var(--accentText);
      font-size: 13px; font-weight: 800;
      text-decoration: none; transition: filter 130ms;
    }
    .featuredCta:hover { filter: brightness(.92); }

    /* Master map section */
    .masterMapBlock { margin: 6px 0 4px; }
    .masterMapHead {
      display: flex;
      align-items: baseline;
      gap: 12px;
      padding-bottom: 10px;
      border-bottom: 2px solid var(--brand1);
      margin-bottom: 16px;
    }
    .masterMapTitle {
      font-size: 17px;
      font-weight: 900;
      letter-spacing: .06em;
      text-transform: uppercase;
      color: var(--text);
    }
    .masterMapSub {
      font-size: 12.5px;
      color: var(--faint);
      font-weight: 500;
    }

    /* ── Home Alert Bar ── */
    .homeAlertBar {
      display: flex; align-items: center; justify-content: center; gap: 8px; flex-wrap: wrap;
      padding: 12px 20px; margin-bottom: 60px;
      background: #2E3E52; color: #E8EDF4;
      font-size: 16px; font-weight: 700; line-height: 1.3;
      text-decoration: none; text-align: center;
      transition: opacity 140ms, background 140ms;
    }
    .homeAlertBar:hover { background: #3a4f68; }
    .homeAlertBar strong { font-weight: 900; color: #FFD24A; }
    .habVote {
      display: inline-flex; align-items: center;
      padding: 4px 13px; border-radius: 999px;
      background: #FFD24A; color: #0B0D10;
      font-size: 13px; font-weight: 900; letter-spacing: .04em;
      white-space: nowrap;
    }

    /* View all */
    .viewAllRow { padding: 4px 0 24px; text-align: center; }
    .viewAllBtn {
      font-size: 13.5px; font-weight: 800; color: var(--link);
      text-decoration: none; border: 1px solid var(--pillBorder);
      background: var(--pillBg); padding: 9px 22px;
      border-radius: 999px; display: inline-flex; align-items: center;
    }
    .viewAllBtn:hover { background: color-mix(in srgb, var(--brand1) 18%, transparent); }

    /* ══════════════════════════════════════════════════════════════════
       LATEST FEED — flat horizontal list rows, Nooga breathing room
       ══════════════════════════════════════════════════════════════════ */

    .latestFeed {
      margin-top: 8px;
      margin-bottom: 8px;
    }

    /* Section header — same visual language as railHead / topicsHead */
    .latestHead {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      padding-bottom: 10px;
      border-bottom: 2px solid var(--brand1);
      margin-bottom: 0;
    }
    .latestLabel {
      font-size: 28px;
      font-weight: 900;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--text);
    }
    .latestMore {
      font-size: 13px;
      font-weight: 700;
      color: var(--link);
      text-decoration: none;
      white-space: nowrap;
    }
    .latestMore:hover { text-decoration: underline; }

    /* ── Each article row — full <a> wrapper, entire card is clickable ── */
    .latestRow {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 18px;
      align-items: center;
      padding: 18px 0;
      border-bottom: 1px solid var(--border);
      text-decoration: none;
      transition: opacity 140ms ease;
    }
    .latestRow:hover { opacity: .78; }
    .latestRow:last-child { border-bottom: none; }

    /* ── Thumbnail ── */
    .latestThumbWrap {
      aspect-ratio: 4/3;
      border-radius: 8px;
      overflow: hidden;
    }
    .latestThumb {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      background: var(--surface);
      transition: transform 280ms ease;
    }
    .latestRow:hover .latestThumb { transform: scale(1.04); }
    .latestThumbFallback {
      background: var(--surface2);
    }

    /* ── Text block ── */
    .latestText {
      display: flex;
      flex-direction: column;
      gap: 5px;
      min-width: 0;
    }
    .latestKicker {
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .09em;
      text-transform: uppercase;
      color: var(--brand1);
      line-height: 1;
    }
    .latestTitle {
      /* 20px Bold Century Gothic per spec */
      font-size: 20px;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: -0.15px;
      color: var(--text);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      transition: color 130ms ease;
    }
    .latestRow:hover .latestTitle { color: var(--link); }
    .latestByline {
      /* Same font-size as cardMeta; semi-bold matches audited .metaAuthor spec */
      font-size: 12px;
      font-weight: 600;
      color: var(--faint);
      line-height: 1;
    }

    /* ─────────────────────────────────────────────────────────────────────
       MOBILE SNAP-BACK  (max-width: 768px)

       CLIP ARCHITECTURE — one guard, not many:
         .latestFeed  → overflow: hidden  ← THE ONLY CLIPPER
         .latestRow   → no overflow       ← safe zone padding protects tags
         .latestText  → no overflow       ← text visible within safe zone
         html/body    → overflow-x hidden ← page-level backstop

       Previous bug: overflow:hidden on .latestRow with padding:20px 0
       (zero horizontal clearance) clipped the kicker right at the flex
       boundary. Fix: move all clipping responsibility to .latestFeed,
       give the row 20px horizontal padding as a "safety zone" buffer.
    ───────────────────────────────────────────────────────────────────── */
    @media (max-width: 768px) {

      /* Single outer guard — the only element that clips */
      .latestFeed {
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
        overflow: hidden;           /* ← sole clipper for the entire feed    */
      }

      .latestRow {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 12px;
        align-items: center;
        padding: 14px 0;
      }
      .latestThumbWrap {
        aspect-ratio: 4/3;
        border-radius: 7px;
      }
      .latestThumb {
        width: 100%;
        height: 100%;
      }
      .latestText {
        min-width: 0;
      }

      /* Kicker: tighter tracking so "Motor Sports" stays single-line */
      .latestKicker {
        font-size: 10px;
        letter-spacing: .05em;      /* tighter than desktop .09em             */
        white-space: nowrap;        /* single line always                     */
        /* no overflow:hidden here — .latestFeed is the guard               */
      }

      .latestTitle {
        font-size: 16px;
        word-break: break-word;
      }
      .latestLabel { font-size: 22px; }
    }

    /* Topics */
    .topicsHead { padding-bottom: 10px; border-bottom: 2px solid var(--brand1); margin-bottom: 13px; margin-top: 60px; }
    .topicsLabel {
      /* 2× from 14px → 28px, Extra Bold Century Gothic */
      font-size: 28px; font-weight: 900;
      letter-spacing: .12em; text-transform: uppercase; color: var(--text);
    }
    .topicsGrid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);   /* strict 3 columns — always 3×3 */
      gap: 10px;
    }
    .topicTile {
      position: relative;
      display: block;
      text-decoration: none;
      border-radius: 12px;
      overflow: hidden;
      aspect-ratio: 4/3;                        /* tighter square feel than 5/3 */
      background: var(--surface2);
      border: 1px solid var(--border);
    }
    .topicImg {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 360ms ease;         /* smooth zoom on hover */
      will-change: transform;
    }
    /* Image zooms in — text wrapper stays perfectly static */
    .topicTile:hover .topicImg { transform: scale(1.07); }
    .topicGrad {
      position: absolute; inset: 0;
      background: rgba(0,0,0,.50);              /* 50% dark overlay per spec */
      /* grad does NOT transition — keeps text contrast constant during zoom */
    }
    .topicLabel {
      position: absolute; inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: "Century Gothic", AppleGothic, Arial, sans-serif;
      font-size: 32px;                          /* 32pt Heavy Bold Century Gothic */
      font-weight: 900;
      color: #fff;
      text-transform: uppercase;
      letter-spacing: .06em;
      text-align: center;
      padding: 10px;
      text-shadow: 0 2px 16px rgba(0,0,0,.85);
      line-height: 1.1;
      /* No transform on label — stays locked while image zooms behind it */
    }
    /* ── Nooga-style mobile topics: full-width edge-to-edge vertical stack ── */
    @media (max-width: 600px) {
      .topicsGrid {
        grid-template-columns: 1fr;
        gap: 0;
        box-sizing: border-box;
        margin-left: -1.25rem;       /* matches container padding exactly */
        margin-right: -1.25rem;
        width: calc(100% + 2.5rem);
      }
      .topicTile {
        aspect-ratio: unset;
        height: 165px;               /* 150–200px spec — 165px hits both legibility and density */
        border-radius: 0;
        border-left: none;
        border-right: none;
        border-top: none;
        border-bottom: 1px solid rgba(255,255,255,.09);
      }
      .topicTile:last-child { border-bottom: none; }
      .topicLabel {
        font-size: 26px;             /* scaled down for mobile per spec (24–28pt) */
        letter-spacing: .08em;
        text-shadow: 0 2px 18px rgba(0,0,0,.92);
      }
    }

    /* ── Editorial Team sidebar block ── */
    .editTeamSection {
      display: grid;
      gap: 0;
      margin-bottom: 40px;   /* 40px breath before Upcoming Events */
    }
    .editTeamRow {
      display: flex;
      align-items: center;
      padding-top: 12px;
      gap: 0;
    }
    .editHeadshot {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
      margin-right: 15px;
      background: var(--surface2);
      border: 2px solid var(--border);
    }
    /* Fallback initials circle — shown via onerror JS if image missing */
    .editHeadshotFallback {
      display: none;
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: var(--brand1);
      color: #000;
      font-size: 22px;
      font-weight: 900;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-right: 15px;
      border: 2px solid var(--border);
    }
    .editTeamInfo {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 3px;
    }
    .editName {
      font-size: 15px;
      font-weight: 700;       /* Bold Century Gothic */
      color: var(--text);
      line-height: 1.2;
    }
    .editTitle {
      font-size: 14px;
      font-weight: 400;       /* Normal weight Century Gothic — muted hierarchy */
      color: var(--faint);
      line-height: 1.3;
    }

    /* ── Byline author — same size as date, semi-bold ── */
    .metaAuthor {
      font-weight: 600;       /* semi-bold, matches date font-size via inheritance */
    }

    /* ── SIDEBAR — sticky, top-aligned with hero, borderless ── */
    .homeRail {
      position: sticky;
      top: 80px;
      display: grid;
      gap: 24px;
      align-self: start; /* ensures it doesn't stretch past its content */
    }
    .railSection { display: grid; gap: 0; }
    .railHead {
      display: flex; justify-content: space-between; align-items: baseline;
      padding-bottom: 10px; border-bottom: 2px solid var(--brand1);
    }
    .railTitle {
      font-size: 16px; font-weight: 900;
      letter-spacing: .08em; text-transform: uppercase; color: var(--text);
    }
    /* Editorial team header — longer label needs nowrap + tighter tracking */
    .editTeamTitle {
      white-space: nowrap;
      letter-spacing: -0.02em;
    }
    .railMore { font-size: 13px; font-weight: 700; color: var(--link); text-decoration: none; }
    .railMore:hover { text-decoration: underline; }

    /* Events — dividers only, no boxes */
    .eventList { display: grid; }
    .eventRow {
      display: grid; grid-template-columns: 48px 1fr;
      gap: 12px; align-items: center; text-decoration: none;
      padding: 13px 0; border-bottom: 1px solid var(--border);
      transition: opacity 140ms;
    }
    .eventRow:hover { opacity: .76; }
    .eventCal {
      width: 48px; height: 48px; border-radius: 10px;
      background: var(--pillBg); border: 1px solid var(--pillBorder);
      display: grid; place-items: center; text-align: center; line-height: 1;
    }
    .eDow { font-size: 10px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; color: var(--brand1); }
    .eDay { font-size: 19px; font-weight: 900; color: var(--text); margin-top: 1px; }
    .eMon { font-size: 8px; font-weight: 700; color: var(--faint); text-transform: uppercase; letter-spacing: .06em; }
    .eName { font-weight: 800; font-size: 15px; color: var(--text); line-height: 1.2; }
    .ePlace { font-size: 13px; color: var(--faint); margin-top: 2px; display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
    .evCitySep { opacity: .4; }
    .evCityName { color: var(--brand1); font-weight: 700; }
    .evSrcBadge {
      display: inline-block;
      font-size: 9px; font-weight: 700; letter-spacing: .04em;
      padding: 1px 6px; border-radius: 999px; white-space: nowrap;
    }
    .evSrcBadge--featured {
      background: rgba(249,217,0,.12); color: var(--brand1);
      border: 1px solid rgba(249,217,0,.3);
    }
    .evSrcBadge--community {
      background: rgba(255,255,255,.06); color: var(--muted);
      border: 1px solid rgba(255,255,255,.12);
    }
    /* ── Upcoming Events Smart Slider ── */
    .evSlider {
      display: grid;
      grid-template-columns: 1fr;
      margin-bottom: 4px;
      border-bottom: 1px solid var(--border);
    }
    .evSlide {
      grid-row: 1;
      grid-column: 1;
      display: grid; grid-template-columns: 48px 1fr; gap: 12px;
      align-items: center; text-decoration: none;
      padding: 13px 10px;
      background: rgba(249,217,0,.06);
      border-radius: 8px;
      margin: 8px -8px 0;
      opacity: 0;
      transition: opacity 500ms ease;
      pointer-events: none;
    }
    .evSlide--active { opacity: 1; pointer-events: auto; }
    .sbDots { grid-row: 2; grid-column: 1; display: flex; gap: 5px; justify-content: center; padding: 8px 0 4px; }
    .sbDot {
      width: 6px; height: 6px; border-radius: 50%;
      border: none; padding: 0;
      background: rgba(128,128,128,.25);
      cursor: pointer; transition: background 200ms, transform 200ms;
    }
    .sbDot--active { background: var(--brand1); transform: scale(1.3); }
    .noEvents { font-size: 13px; color: var(--faint); padding: 12px 0; margin: 0; }

    /* Display ad */
    .displayAdSlot { display: grid; gap: 5px; }
    .adSlotLabel {
      font-size: 8.5px; font-weight: 700; letter-spacing: .12em;
      text-transform: uppercase; color: var(--faint); text-align: center;
    }
    .displayAdCard {
      display: block; text-decoration: none;
      border: 1.5px dashed var(--pillBorder);
      border-radius: 13px; background: var(--pillBg);
      transition: border-color 140ms;
    }
    .displayAdCard:hover { border-color: var(--brand1); }
    .displayAdInner { padding: 22px 14px; text-align: center; display: grid; gap: 5px; place-items: center; }
    .displayAdIcon { font-size: 24px; margin-bottom: 2px; }
    .displayAdTitle { font-size: 16px; font-weight: 900; color: var(--text); }
    .displayAdDesc { font-size: 14px; color: var(--muted); line-height: 1.3; }
    .displayAdCta {
      margin-top: 6px; display: inline-flex; align-items: center;
      height: 30px; padding: 0 13px; border-radius: 999px;
      background: var(--brand1); color: var(--accentText);
      font-size: 11.5px; font-weight: 800;
    }

    /* Guides */
    .guideList { display: grid; }
    .guideRow {
      display: block; text-decoration: none;
      font-size: 15px; font-weight: 700; color: var(--text);
      padding: 11px 0; border-bottom: 1px solid var(--border);
      line-height: 1.3; transition: color 120ms;
    }
    .guideRow:last-child { border-bottom: none; }
    .guideRow:hover { color: var(--link); }

    /* ── Advertise band ── */
    .adBand {
      /* transparent full-width shell — bleedFix JS stretches it to screen edges */
      width: 100%;
      margin: 0;
      padding: 44px 0 52px;
    }
    .adBandInner {
      /* THIS is the visual card — centered inside the full-width shell */
      max-width: calc(100% - 10rem);
      margin: 0 auto;
      border-radius: 18px;
      background: linear-gradient(135deg, var(--brand1), var(--brand2));
      padding: clamp(18px, 2.5vw, 32px) clamp(22px, 3vw, 40px);
      box-shadow: 0 12px 40px color-mix(in srgb, var(--brand1) 40%, transparent);
      display: flex; align-items: center;
      justify-content: space-between; gap: 28px; flex-wrap: wrap;
    }
    .adEyebrow {
      font-size: 11px; font-weight: 800; letter-spacing: .16em;
      text-transform: uppercase; color: var(--accentText); opacity: .82; margin-bottom: 5px;
    }
    .adHead {
      font-size: clamp(18px, 2vw, 24px); font-weight: 950;
      color: var(--accentText); letter-spacing: -0.4px; margin-bottom: 5px; line-height: 1.05;
    }
    .adDesc {
      font-size: clamp(13px, 1.1vw, 14.5px); font-weight: 400;
      color: var(--accentText);
      opacity: .88; line-height: 1.5; max-width: 420px;
    }
    .adActions { display: flex; gap: 10px; flex-shrink: 0; flex-wrap: wrap; }
    .adBtnPrimary {
      display: inline-flex; align-items: center;
      height: 42px; padding: 0 20px; border-radius: 11px;
      background: #000000; color: #ffffff;
      font-size: 13px; font-weight: 900; text-decoration: none;
      white-space: nowrap; transition: opacity 140ms;
      box-shadow: 0 4px 16px rgba(0,0,0,.18);
    }
    .adBtnPrimary:hover { opacity: .88; }
    .adBtnGhost {
      display: inline-flex; align-items: center;
      height: 42px; padding: 0 18px; border-radius: 11px;
      border: 2px solid rgba(255,255,255,.48);
      color: var(--accentText); font-size: 13px; font-weight: 800;
      text-decoration: none; white-space: nowrap; transition: border-color 140ms;
    }
    .adBtnGhost:hover { border-color: rgba(255,255,255,.85); }
    @media (max-width: 640px) {
      .adBand { padding: 16px 0 24px; }
      .adBandInner {
        max-width: calc(100% - 2rem);
        border-radius: 14px;
        padding: 20px 1.25rem;
        flex-direction: column; align-items: center; text-align: center; gap: 12px;
      }
      .adCopy { display: flex; flex-direction: column; align-items: center; text-align: center; }
      .adEyebrow, .adHead, .adDesc { text-align: center; }
      .adDesc { max-width: 100%; }
      .adActions { width: 100%; justify-content: center; gap: 8px; margin-top: 4px; }
      .adBtnPrimary, .adBtnGhost { flex: 1; justify-content: center; }
    }
  </style>

  <script is:inline>
    /* ── Community Pulse poll interaction ── */
    (function () {
      var form = document.querySelector(".cpPollForm");
      var thanks = document.querySelector(".cpThanks");
      var btn = document.querySelector(".cpVoteBtn");
      if (!form || !thanks || !btn) return;

      form.addEventListener("submit", function (e) {
        var checked = form.querySelector('input[type="radio"]:checked');
        if (!checked) {
          e.preventDefault();
          btn.animate(
            [{ transform: "translateX(-4px)" }, { transform: "translateX(4px)" }, { transform: "none" }],
            { duration: 180, iterations: 2 }
          );
          return;
        }
        // Show bars + percentages immediately, then thank-you message
        form.querySelectorAll(".cpBar").forEach(function (b) { b.style.display = "block"; });
        form.querySelectorAll(".cpPct").forEach(function (p) { p.style.display = "block"; });
        setTimeout(function () {
          form.style.display = "none";
          thanks.hidden = false;
        }, 80);
      });
    })();
  </script>
  <script is:inline>
    /* ── Home Sidebar Smart Slider ── */
    (function () {
      var slider = document.getElementById("homeSlider");
      if (!slider) return;
      var slides  = Array.prototype.slice.call(slider.querySelectorAll(".evSlide"));
      var dotsEl  = document.getElementById("homeDots");
      var dots    = dotsEl ? Array.prototype.slice.call(dotsEl.querySelectorAll(".sbDot")) : [];
      var current = 0;
      var total   = slides.length;
      var timer   = null;
      if (total <= 1) return;
      function goTo(idx) {
        slides[current].classList.remove("evSlide--active");
        slides[current].setAttribute("aria-hidden", "true");
        if (dots[current]) { dots[current].classList.remove("sbDot--active"); }
        current = (idx + total) % total;
        slides[current].classList.add("evSlide--active");
        slides[current].removeAttribute("aria-hidden");
        if (dots[current]) { dots[current].classList.add("sbDot--active"); }
      }
      function startAuto() { timer = setInterval(function () { goTo(current + 1); }, 5000); }
      function resetAuto() { if (timer) clearInterval(timer); startAuto(); }
      dots.forEach(function (dot, i) {
        dot.addEventListener("click", function () { goTo(i); resetAuto(); });
      });
      slider.addEventListener("mouseenter", function () { if (timer) clearInterval(timer); });
      slider.addEventListener("mouseleave", startAuto);
      startAuto();
    })();
  </script>
</Base>
