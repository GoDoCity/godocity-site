---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

/** Daytona filter */
function isDaytonaPost(post) {
  const city = String(post?.data?.city ?? "daytona").toLowerCase().trim();
  if (city === "daytona") return true;
  return typeof post?.id === "string" && post.id.startsWith("daytona/");
}

/** Featured flag */
function isFeatured(post) {
  const v = post?.data?.featured;
  if (v === true) return true;
  if (v === 1) return true;
  const s = String(v ?? "").toLowerCase().trim();
  return s === "true" || s === "yes" || s === "1";
}

/** Dates */
function getPostDate(post) {
  return (
    post?.data?.pubDate ??
    post?.data?.date ??
    post?.data?.published ??
    post?.data?.updated ??
    null
  );
}

function sortNewestFirst(a, b) {
  const da = new Date(getPostDate(a) ?? 0).getTime();
  const db = new Date(getPostDate(b) ?? 0).getTime();
  return db - da;
}

function dateText(post) {
  const d = getPostDate(post);
  return d ? new Date(d).toLocaleDateString("en-US") : "";
}

function excerpt(post) {
  return post?.data?.description ?? "";
}

/**
 * IMPORTANT: keep thumbnails working exactly as-is
 * (do not use .src, this is a STRING path)
 */
function heroImage(post) {
  const v =
    post?.data?.heroImage ??
    post?.data?.heroimage ??
    post?.data?.image ??
    post?.data?.thumbnail ??
    post?.data?.cover ??
    "";
  return typeof v === "string" ? v.trim() : "";
}

/** Data (keep logic stable) */
const all = await getCollection("posts");
const posts = all.filter(isDaytonaPost).sort(sortNewestFirst);

const hero = posts.find(isFeatured) ?? posts[0] ?? null;
const feed = hero ? posts.filter((p) => p.slug !== hero.slug) : posts;

// Split for “Featured + Latest” feel (no logic change to content source; just presentation)
const latest = feed.slice(0, 8);
---

<Base title="GoDo Daytona" subtitle="Good news for Daytona" cityBase="daytona" />

<section class="section">
  <div class="container homeWrap">
    <!-- NOTE: The duplicate top “GoDoDaytona is part of the GoDoCity network…” block is NOT rendered in this file.
         If it’s coming from Base/topbar, we hide it via :global selectors in the CSS below. -->

    <!-- MOBILE MENU (CSS-only hamburger / drawer; no JS) -->
    <div class="mNav">
      <input id="mnavToggle" class="mNavToggle" type="checkbox" />
      <div class="mNavBar">
        <div class="mBrand">
          <span class="mBrandDot" aria-hidden="true"></span>
          <span class="mBrandText">GoDo Daytona</span>
        </div>
        <label class="mMenuBtn" for="mnavToggle" aria-label="Open menu">
          <span class="mBurger" aria-hidden="true"><span></span></span>
          <span class="mMenuText">Menu</span>
        </label>
      </div>

      <label class="mBackdrop" for="mnavToggle" aria-hidden="true"></label>

      <div class="mDrawer" role="dialog" aria-label="Site menu">
        <div class="mDrawerHead">
          <div class="mDrawerTitle">GoDo Daytona</div>
          <label class="mCloseBtn" for="mnavToggle" aria-label="Close menu">✕</label>
        </div>

        <nav class="mLinks">
          <a class="mLink" href="/daytona/">Home</a>
          <a class="mLink" href="/daytona/topics/">Topics</a>
          <a class="mLink" href="/daytona/guides/">Guides</a>
          <a class="mLink" href="/daytona/events/">Events</a>
          <a class="mLink" href="/daytona/jobs/">Jobs</a>
          <a class="mLink" href="/daytona/games/">Games</a>
          <a class="mLink" href="/daytona/buy/">The Buy</a>
          <a class="mLink" href="/daytona/advertise/">Advertise</a>

          <div class="mDivider"></div>

          <!-- Subscribe lives inside slide-over menu -->
          <a class="mCTA" href="/daytona/subscribe/">Subscribe</a>
        </nav>
      </div>
    </div>

    <!-- NEWSLETTER SIGNUP BAND (translucent yellow; taller; responsive form; no overflow) -->
    <div class="newsletterBand">
      <div class="newsletterBandInner">
        <div class="newsletterText">
          <div class="newsletterKicker">Good news for Daytona</div>
          <div class="newsletterHeadline">Get the best local posts and events sent to your inbox.</div>
          <div class="newsletterFine">100% free. Unsubscribe anytime.</div>
        </div>

        <form class="newsletterForm" action="/daytona/subscribe/" method="get">
          <input class="newsletterInput" type="email" name="email" placeholder="Enter your email address" />
          <button class="newsletterButton" type="submit">Sign up — it’s free</button>
        </form>
      </div>
    </div>

    <!-- Main grid: left content + right rail -->
    <div class="homeGrid">
      <!-- LEFT -->
      <div class="homeMain">
        {hero && (
          <a class="heroFeature" href={`/daytona/posts/${hero.slug}/`}>
            <div class="heroMedia">
              {heroImage(hero) ? (
                <img
                  class="heroImg"
                  src={heroImage(hero)}
                  alt={hero.data.title ?? "Hero image"}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="heroImg heroImgFallback" aria-hidden="true"></div>
              )}
            </div>

            <div class="heroCopy">
              <div class="heroTitle">{hero.data.title ?? hero.slug}</div>
              {excerpt(hero) && <div class="heroDesc">{excerpt(hero)}</div>}
              <div class="heroMeta">{dateText(hero)}</div>
            </div>
          </a>
        )}

        <div class="sectionHeader">
          <div class="sectionTitle">Explore</div>
        </div>

        <div class="catGrid">
          <a class="catCard" href="/daytona/topics/">
            <div class="catTitle">Topics</div>
            <div class="catDesc">Browse what Daytona is talking about.</div>
          </a>
          <a class="catCard" href="/daytona/guides/">
            <div class="catTitle">City Guides</div>
            <div class="catDesc">Curated guides for locals and visitors.</div>
          </a>
          <a class="catCard" href="/daytona/events/">
            <div class="catTitle">Events</div>
            <div class="catDesc">What’s happening this week.</div>
          </a>
        </div>

        <div class="feedHeader">
          <div class="sectionTitle">Latest</div>
          <a class="viewAllLink" href="/daytona/posts/">View all</a>
        </div>

        <div class="latestGrid" role="list">
          {latest.map((p) => (
            <a class="latestCard" role="listitem" href={`/daytona/posts/${p.slug}/`}>
              <div class="latestMedia">
                {heroImage(p) ? (
                  <img
                    class="latestImg"
                    src={heroImage(p)}
                    alt={p.data.title ?? "Thumbnail"}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="latestImg latestImgFallback" aria-hidden="true"></div>
                )}
              </div>

              <div class="latestBody">
                <div class="latestTitle">{p.data.title ?? p.slug}</div>
                {excerpt(p) && <div class="latestDesc">{excerpt(p)}</div>}
                <div class="latestMeta">{dateText(p)}</div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- RIGHT RAIL -->
      <aside class="homeRail">
        <div class="moduleCard eventsCard">
          <div class="moduleHead">
            <div class="moduleTitle">Upcoming Events</div>
            <a class="viewAllLink viewAllLinkSmall" href="/daytona/events/">See all</a>
          </div>

          <div class="eventsList">
            <div class="eventRow">
              <div class="eventDate">
                <div class="eventDow">SAT</div>
                <div class="eventDay">15</div>
              </div>
              <div class="eventInfo">
                <div class="eventName">Add your first event</div>
                <div class="eventPlace">Daytona Beach</div>
              </div>
            </div>

            <div class="eventRow">
              <div class="eventDate">
                <div class="eventDow">SUN</div>
                <div class="eventDay">16</div>
              </div>
              <div class="eventInfo">
                <div class="eventName">Second event placeholder</div>
                <div class="eventPlace">Ormond Beach</div>
              </div>
            </div>
          </div>

          <div class="railDivider"></div>

          <div class="railLinks">
            <div class="moduleTitle moduleTitleSmall">Resources</div>
            <a class="railLink" href="/daytona/subscribe/">Subscribe</a>
            <a class="railLink" href="/daytona/advertise/">Advertise</a>
            <a class="railLink" href="/daytona/topics/">Topics</a>
            <a class="railLink" href="/daytona/events/">Events</a>
          </div>
        </div>
      </aside>
    </div>

    <div class="promoBand">
      <div class="promoCopy">
        <div class="promoTitle">Advertise with us.</div>
        <div class="promoDesc">Reach locals with sponsored stories, display placements, and event promotion.</div>
      </div>
      <div class="promoActions">
        <a class="btn" href="/daytona/advertise/">Branded Content + Display</a>
        <a class="btn btnGhost" href="/daytona/advertise/">Events</a>
      </div>
    </div>

    <footer class="homeFooter">
      <div class="footerCols">
        <div class="footerCol">
          <div class="footerHead">Resources</div>
          <a class="footerLink" href="/daytona/subscribe/">Subscribe</a>
          <a class="footerLink" href="/daytona/advertise/">Advertise</a>
          <a class="footerLink" href="/daytona/topics/">Topics</a>
          <a class="footerLink" href="/daytona/events/">Events</a>
        </div>

        <div class="footerCol">
          <div class="footerHead">About</div>
          <a class="footerLink" href="/daytona/contact/">Contact</a>
          <a class="footerLink" href="/daytona/legal/">Legal</a>
        </div>

        <div class="footerCol footerColWide">
          <div class="footerHead">GoDoDaytona</div>
          <div class="footerFine">
            GoDoDaytona is part of the GoDoCity network. Built to scale city-by-city with consistent design,
            editorial workflow, and advertising packages.
          </div>
          <div class="footerFine" style="margin-top:10px;">
            © {new Date().getFullYear()} GoDoCity. All rights reserved.
          </div>
        </div>
      </div>
    </footer>
  </div>
</section>

<style>
  /* Wider page like Nooga */
  :global(.container) {
    max-width: 1240px;
    padding-left: clamp(14px, 2vw, 22px);
    padding-right: clamp(14px, 2vw, 22px);
  }
  @media (min-width: 1400px) {
    :global(.container) { max-width: 1280px; }
  }

  .homeWrap {
    --maxMain: 860px;
    --rail: 320px;
    --gridGap: 22px;

    /* Use ONE shared left/right inset that we can reuse to align the rail to the input edge */
    --contentInset: 22px;

    --cardRadius: 16px;
    --cardRadiusSm: 14px;
    --cardBorder: rgba(255,255,255,.10);
    --cardBorderSoft: rgba(255,255,255,.08);
    --cardBg: rgba(255,255,255,.03);

    --shadowSoft: 0 8px 18px rgba(0,0,0,.22);

    --t1: #e8edf4;
    --t2: rgba(232,237,244,.86);
    --t3: rgba(232,237,244,.70);
    --t4: rgba(232,237,244,.58);

    --yellow: #ffd24a;
    --yellowDeep: #ffc400;

    --glow: 0 0 0 1px rgba(255,210,74,.18), 0 10px 26px rgba(0,0,0,.30);
    --glowSoft: 0 0 0 1px rgba(255,210,74,.16), 0 18px 40px rgba(0,0,0,.40);
  }

  /* ================= Daytona-only header cleanup (Base/topbar) =================
     Replace the selector below with the exact class you saw in Inspect.
     I included common candidates; KEEP the one that matches your actual DOM. */

  /* Hide the Base/topbar “GoDoDaytona is part of…” block (Daytona homepage only) */
  :global(body[data-city="daytona"] .cityNetworkBlurb),
  :global(body[data-city="daytona"] .networkBlurb),
  :global(body[data-city="daytona"] .siteNetworkNote),
  :global(body[data-city="daytona"] .topNetworkNote),
  :global(body[data-city="daytona"] .topNetworkBlurb),
  :global(body[data-city="daytona"] [data-network-blurb="top"]) {
    display: none !important;
  }

  /* Hide header Subscribe pill on Daytona page (Base) */
  :global(body[data-city="daytona"] header a.pill[href*="subscribe"]) {
    display: none !important;
  }

  /* (Optional) Hide any top “City Directory” pill if Base renders it */
  :global(body[data-city="daytona"] header a.pill[href*="directory"]),
  :global(body[data-city="daytona"] header a.pill[href*="city-directory"]) {
    display: none !important;
  }

  /* =================== MOBILE DRAWER =================== */
  .mNav { display: none; }
  @media (max-width: 720px) { .mNav { display: block; margin: 2px 0 12px; } }

  .mNavToggle {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .mNavBar {
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.02);
    border-radius: 14px;
    padding: 10px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    box-shadow: var(--shadowSoft);
  }
  .mBrand { display: inline-flex; align-items: center; gap: 10px; min-width: 0; }
  .mBrandDot {
    width: 10px; height: 10px; border-radius: 999px;
    background: rgba(255,210,74,.95);
    box-shadow: 0 0 0 3px rgba(255,210,74,.14);
    flex: 0 0 auto;
  }
  .mBrandText {
    font-weight: 950;
    color: rgba(232,237,244,.92);
    letter-spacing: -0.2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mMenuBtn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 12px;
    padding: 8px 10px;
    border: 1px solid rgba(255,210,74,.40);
    background: rgba(255,210,74,.10);
    color: rgba(232,237,244,.92);
    font-weight: 900;
    cursor: pointer;
    user-select: none;
  }
  .mMenuText { font-size: 12.5px; }

  .mBurger { width: 18px; height: 12px; position: relative; display: inline-block; }
  .mBurger::before,
  .mBurger::after,
  .mBurger span {
    content: "";
    position: absolute;
    left: 0; right: 0;
    height: 2px;
    border-radius: 2px;
    background: rgba(232,237,244,.92);
  }
  .mBurger::before { top: 0; }
  .mBurger span { top: 5px; }
  .mBurger::after { bottom: 0; }

  .mBackdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.55);
    backdrop-filter: blur(2px);
    z-index: 90;
  }
  .mDrawer {
    position: fixed;
    top: 0; right: 0;
    height: 100dvh;
    width: min(86vw, 360px);
    background: #0b0d10;
    border-left: 1px solid rgba(255,255,255,.10);
    box-shadow: -20px 0 60px rgba(0,0,0,.45);
    transform: translateX(100%);
    transition: transform 220ms ease;
    z-index: 100;
    display: grid;
    grid-template-rows: auto 1fr;
  }
  .mDrawerHead {
    padding: 14px 14px 12px;
    border-bottom: 1px solid rgba(255,255,255,.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .mDrawerTitle { font-weight: 950; color: rgba(232,237,244,.92); letter-spacing: -0.2px; }
  .mCloseBtn {
    width: 34px; height: 34px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.03);
    color: rgba(232,237,244,.86);
    cursor: pointer;
    user-select: none;
  }
  .mLinks { padding: 12px 14px 16px; display: grid; gap: 8px; overflow: auto; }
  .mLink {
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
    color: rgba(232,237,244,.86);
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.02);
    border-radius: 12px;
    padding: 12px 12px;
    font-weight: 850;
  }
  .mLink:hover { border-color: rgba(255,210,74,.22); box-shadow: 0 0 0 1px rgba(255,210,74,.12); }
  .mDivider { height: 1px; background: rgba(255,255,255,.10); margin: 8px 0; }
  .mCTA {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 50px;
    border-radius: 12px;
    border: 1px solid rgba(0,0,0,.55);
    background: linear-gradient(180deg, var(--yellow), var(--yellowDeep));
    color: #0b0d10;
    font-weight: 950;
    text-decoration: none;
    letter-spacing: .01em;
    box-shadow: 0 10px 20px rgba(0,0,0,.22);
  }
  .mNavToggle:checked ~ .mBackdrop { display: block; }
  .mNavToggle:checked ~ .mDrawer { transform: translateX(0); }

  /* =================== NEWSLETTER BAND (translucent yellow, taller, readable, no cutoff) =================== */
  .newsletterBand {
    border: 1px solid rgba(255,210,74,.55);
    background:
      radial-gradient(1100px 520px at 20% 0%, rgba(255,210,74,.18), rgba(255,210,74,0) 60%),
      rgba(255,210,74,.12);
    box-shadow: var(--glowSoft);
    border-radius: var(--cardRadius);
    overflow: hidden;
    margin: 10px 0 18px;
  }

  /* IMPORTANT for alignment: consistent inset. This makes input’s left edge = newsletter inset */
  .newsletterBandInner {
    display: grid;
    grid-template-columns: 1fr; /* Keep band content full-width; form never overflows */
    gap: 16px;
    padding: 34px var(--contentInset);
    align-items: start;
  }
  @media (max-width: 520px) {
    .newsletterBandInner { padding: 26px 14px; }
  }

  /* Band text readable on dark theme */
  .newsletterHeadline,
  .newsletterFine { color: rgba(232,237,244,.92); }
  .newsletterHeadline {
    font-size: 22px;
    line-height: 1.12;
    font-weight: 950;
    letter-spacing: -0.3px;
    margin-bottom: 8px;
  }
  .newsletterFine { color: rgba(232,237,244,.72); font-size: 14px; line-height: 1.35; }

  /* Kicker: bright yellow pill with black text */
  .newsletterKicker {
    font-weight: 950;
    letter-spacing: .2px;
    background: rgba(255,210,74,.98);
    color: #0b0d10;
    display: inline-flex;
    padding: 7px 12px;
    border-radius: 999px;
    border: 1px solid rgba(0,0,0,.28);
    margin-bottom: 10px;
    box-shadow: 0 10px 18px rgba(0,0,0,.18);
  }

  /* Form: never overflows; wraps cleanly; with gap */
  .newsletterForm {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    min-width: 0;
    width: 100%;
  }

  .newsletterInput {
    flex: 1 1 360px;
    min-width: min(100%, 280px);
    height: 54px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.18);
    background: rgba(11,13,16,.72);
    color: rgba(232,237,244,.95);
    padding: 0 14px;
    outline: none;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.06);
  }
  .newsletterInput::placeholder { color: rgba(232,237,244,.70); }
  .newsletterInput:focus {
    border-color: rgba(255,210,74,.72);
    box-shadow: 0 0 0 4px rgba(255,210,74,.20);
  }

  .newsletterButton {
    flex: 0 1 auto;
    height: 54px;
    border-radius: 14px;
    border: 1px solid rgba(0,0,0,.55);
    background: linear-gradient(180deg, var(--yellow), var(--yellowDeep));
    color: #0b0d10;
    font-weight: 950;
    letter-spacing: .01em;
    cursor: pointer;
    box-shadow: 0 16px 26px rgba(0,0,0,.22);
    padding: 0 16px;
    white-space: nowrap;
    max-width: 100%;
  }
  @media (max-width: 520px) {
    .newsletterInput, .newsletterButton { height: 50px; border-radius: 13px; }
    .newsletterButton { width: 100%; }
  }

  /* =================== HOME GRID + RAIL NU DGE (align rail to newsletter input edge) =================== */
  /* Key idea:
     - Newsletter input starts at newsletterBandInner left padding (--contentInset)
     - We apply the SAME left/right padding to homeGrid so homeRail column starts at that same x-position */
  .homeGrid {
    display: grid;
    grid-template-columns: minmax(0, var(--maxMain)) minmax(0, var(--rail));
    gap: var(--gridGap);
    align-items: start;
    padding: 0 var(--contentInset); /* aligns rail column start to input edge */
  }
  @media (max-width: 980px) {
    .homeGrid { grid-template-columns: 1fr; padding: 0; }
    .homeRail { order: 2; }
  }
  .homeRail { padding: 0; margin: 0; }
/* =========================
   DAYTONA PAGE OVERRIDES
   ========================= */

/* (A) Kill the TOP GoDoCity blurb block (keep footer version) */
:global(body.city-daytona .topbar .cityIntro),
:global(body.city-daytona .topbar .networkBlurb),
:global(body.city-daytona .topbar .goDoCityBlurb),
:global(body.city-daytona .topbar .topBlurb),
:global(body.city-daytona .topbar .aboutBlock),
:global(body.city-daytona .topbar .cityAbout),
:global(body.city-daytona .topbar .subbar),
:global(body.city-daytona .topbar .topbarSub),
:global(body.city-daytona .topbar .topbarMeta),
:global(body.city-daytona .topbar .topbarBlurb) {
  display: none !important;
}

/* If the block is just "the next row" under the pills in the header,
   this also nukes it safely without killing the whole header. */
:global(body.city-daytona .topbar > *:not(.container)) {
  display: none !important;
}

/* (B) Remove the top Subscribe pill (duplicate CTA) */
:global(body.city-daytona .topbar a[href*="/subscribe"]),
:global(body.city-daytona .topbar button[href*="/subscribe"]),
:global(body.city-daytona .topbar .subscribePill),
:global(body.city-daytona .topbar .pillSubscribe) {
  display: none !important;
}

/* (C) Make the main pill row always visible + “Nooga-style” mobile scroll */
.pagePills{
  display:flex;
  align-items:center;
  gap:10px;
  padding: 12px 0 10px;
  flex-wrap: nowrap;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.pagePills::-webkit-scrollbar{ display:none; }

/* Pills tighter on small screens (closer together) */
@media (max-width: 520px){
  .pagePills{
    gap:8px;
    padding: 10px 0 8px;
  }
  .pagePills .pill{
    padding: 8px 10px;
    font-size: 13px;
    border-radius: 999px;
  }
}

/* =========================
   NEWSLETTER BAND (CTA)
   ========================= */

/* Translucent NASCAR-yellow like your tag pills, but bigger */
.newsletterBand{
  /* translucent yellow wash */
  background: rgba(255, 210, 74, 0.22);
  border: 1px solid rgba(255, 210, 74, 0.35);
  border-radius: 16px;
  padding: 22px 18px;         /* taller */
  margin: 12px 0 18px;
  box-shadow: 0 10px 28px rgba(0,0,0,.25);
}

/* Make it feel ~2× taller than before (without cartoon padding) */
@media (min-width: 740px){
  .newsletterBand{
    padding: 28px 22px;
  }
}

.newsletterKicker{
  display:inline-block;
