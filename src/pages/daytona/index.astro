---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

/** Daytona filter */
function isDaytonaPost(post) {
  const city = String(post?.data?.city ?? "daytona").toLowerCase().trim();
  if (city === "daytona") return true;
  return typeof post?.id === "string" && post.id.startsWith("daytona/");
}

/** Featured flag */
function isFeatured(post) {
  const v = post?.data?.featured;
  if (v === true) return true;
  if (v === 1) return true;
  const s = String(v ?? "").toLowerCase().trim();
  return s === "true" || s === "yes" || s === "1";
}

/** Dates */
function getPostDate(post) {
  return post?.data?.pubDate ?? post?.data?.date ?? post?.data?.published ?? post?.data?.updated ?? null;
}
function sortNewestFirst(a, b) {
  return new Date(getPostDate(b) ?? 0).getTime() - new Date(getPostDate(a) ?? 0).getTime();
}
function dateText(post) {
  const d = getPostDate(post);
  return d ? new Date(d).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" }) : "";
}
function excerpt(post) { return post?.data?.description ?? ""; }
function heroImage(post) {
  const v = post?.data?.heroImage ?? post?.data?.heroimage ?? post?.data?.image ?? post?.data?.thumbnail ?? post?.data?.cover ?? "";
  return typeof v === "string" ? v.trim() : "";
}
function primaryTag(post) {
  const tags = post?.data?.tags;
  if (Array.isArray(tags) && tags.length) return String(tags[0]).trim();
  if (typeof post?.data?.topic === "string") return post.data.topic.trim();
  if (typeof post?.data?.category === "string") return post.data.category.trim();
  return "";
}

/** Data */
const all = await getCollection("posts");
const posts = all.filter(isDaytonaPost).sort(sortNewestFirst);
const hero = posts.find(isFeatured) ?? posts[0] ?? null;
const feed = hero ? posts.filter((p) => p.slug !== hero.slug) : posts;
const latest = feed.slice(0, 10);

/** Topics */
const topics = [
  { label: "Business",          slug: "biz",             img: "/images/topics/business.jpg" },
  { label: "City",              slug: "city",             img: "/images/topics/city.jpg" },
  { label: "Culture",           slug: "culture",          img: "/images/topics/culture.jpg" },
  { label: "Events",            slug: "events",           img: "/images/topics/events.jpg" },
  { label: "Food",              slug: "food",             img: "/images/topics/food.jpg" },
  { label: "History",           slug: "history",          img: "/images/topics/history.jpg" },
  { label: "Real Estate",       slug: "real-estate",      img: "/images/topics/real-estate.jpg" },
  { label: "Sports",            slug: "sports",           img: "/images/topics/sports.jpg" },
  { label: "Travel + Outdoors", slug: "travel-outdoors",  img: "/images/topics/travel-outdoors.jpg" },
];
---

<Base title="GoDo Daytona" subtitle="Good news for Daytona" cityBase="daytona">
  <div class="pageWrap">

    {/* ── NEWSLETTER BAND ── */}
    <div class="nlBand">
      <div class="nlInner">
        <div class="nlCopy">
          <div class="nlEyebrow">Free Newsletter</div>
          <div class="nlHead">Good news for Daytona.</div>
          <div class="nlSub">The best local stories sent to your inbox. 100% free, unsubscribe anytime.</div>
        </div>
        <form class="nlForm" action="/daytona/subscribe/" method="get">
          <input class="nlInput" type="email" name="email" placeholder="Enter your email address" />
          <button class="nlBtn" type="submit">Sign Up — It's Free</button>
        </form>
      </div>
    </div>

    {/* ── MAIN CONTENT ── */}
    <div class="container">
      <div class="homeGrid">

        {/* LEFT: MAIN FEED */}
        <main class="homeMain">

          {/* HERO */}
          {hero && (
            <a class="heroCard" href={`/daytona/posts/${hero.slug}/`}>
              <div class="heroImgWrap">
                {heroImage(hero)
                  ? <img class="heroImg" src={heroImage(hero)} alt={hero.data.title ?? ""} loading="eager" decoding="async" />
                  : <div class="heroImg heroFallback" aria-hidden="true" />
                }
                {primaryTag(hero) && <span class="kicker">{primaryTag(hero)}</span>}
              </div>
              <div class="heroCopy">
                <h2 class="heroTitle">{hero.data.title ?? hero.slug}</h2>
                {excerpt(hero) && <p class="heroDesc">{excerpt(hero)}</p>}
                <div class="postMeta">{dateText(hero)}</div>
              </div>
            </a>
          )}

          {/* LATEST FEED */}
          <div class="sectionHead">
            <span class="sectionLabel">Latest</span>
            <a class="viewAll" href="/daytona/posts/">View all →</a>
          </div>

          <div class="feedList">
            {latest.map((p) => (
              <a class="feedRow" href={`/daytona/posts/${p.slug}/`}>
                <div class="feedText">
                  {primaryTag(p) && <div class="feedKicker">{primaryTag(p)}</div>}
                  <div class="feedRowTitle">{p.data.title ?? p.slug}</div>
                  {excerpt(p) && <div class="feedRowDesc">{excerpt(p)}</div>}
                  <div class="postMeta">{dateText(p)}</div>
                </div>
                <div class="feedThumbWrap">
                  {heroImage(p)
                    ? <img class="feedThumb" src={heroImage(p)} alt="" loading="lazy" decoding="async" />
                    : <div class="feedThumb feedThumbFallback" aria-hidden="true" />
                  }
                </div>
              </a>
            ))}
          </div>

          {/* TOPICS VISUAL GRID */}
          <div class="sectionHead" style="margin-top:8px">
            <span class="sectionLabel">Topics</span>
          </div>
          <div class="topicsGrid">
            {topics.map((t) => (
              <a class="topicTile" href={`/daytona/topics/${t.slug}/`}>
                <img
                  class="topicImg"
                  src={t.img}
                  alt={t.label}
                  loading="lazy"
                  decoding="async"
                  onerror="this.style.opacity='0'"
                />
                <div class="topicGrad" aria-hidden="true" />
                <span class="topicLabel">{t.label}</span>
              </a>
            ))}
          </div>

        </main>

        {/* RIGHT: SIDEBAR */}
        <aside class="homeRail">

          <div class="railCard">
            <div class="railHead">
              <span class="railTitle">Upcoming Events</span>
              <a class="railMore" href="/daytona/events/">See all</a>
            </div>
            <div class="eventList">
              <a class="eventRow" href="/daytona/events/">
                <div class="eventCal">
                  <div class="eDow">SAT</div>
                  <div class="eDay">15</div>
                </div>
                <div class="eventInfo">
                  <div class="eName">Add your first event</div>
                  <div class="ePlace">Daytona Beach</div>
                </div>
              </a>
              <a class="eventRow" href="/daytona/events/">
                <div class="eventCal">
                  <div class="eDow">SUN</div>
                  <div class="eDay">16</div>
                </div>
                <div class="eventInfo">
                  <div class="eName">Second event placeholder</div>
                  <div class="ePlace">Ormond Beach</div>
                </div>
              </a>
            </div>
          </div>

          <div class="railCard">
            <div class="railHead">
              <span class="railTitle">City Guides</span>
              <a class="railMore" href="/daytona/guides/">See all</a>
            </div>
            <div class="guideList">
              <a class="guideRow" href="/daytona/guides/">Best beaches in Daytona</a>
              <a class="guideRow" href="/daytona/guides/">Where to eat on the strip</a>
              <a class="guideRow" href="/daytona/guides/">Weekend events calendar</a>
            </div>
          </div>

          <div class="railCard railFlat">
            <div class="railTitle" style="margin-bottom:12px">Resources</div>
            <div class="resourceList">
              <a class="resourceLink" href="/daytona/advertise/">Advertise with us</a>
              <a class="resourceLink" href="/daytona/topics/">Browse topics</a>
              <a class="resourceLink" href="/daytona/events/">Submit an event</a>
              <a class="resourceLink" href="/daytona/guides/">City guides</a>
            </div>
          </div>

          <div class="railCard adCard">
            <div class="adHead">Advertise with us.</div>
            <div class="adDesc">Reach Daytona locals with sponsored content, display ads, and event promotion.</div>
            <a class="adBtn" href="/daytona/advertise/">Learn more →</a>
          </div>

        </aside>
      </div>
    </div>
  </div>

  <style>
    /* ── Shell ── */
    .pageWrap { min-height: 100vh; }

    :global(.container) {
      max-width: 1200px;
      margin: 0 auto;
      padding-left: clamp(16px, 2.5vw, 32px);
      padding-right: clamp(16px, 2.5vw, 32px);
    }

    /* ── Newsletter band ── */
    .nlBand {
      background: var(--brand1);
      padding: clamp(18px, 2.5vw, 28px) 0;
    }
    .nlInner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 clamp(16px, 2.5vw, 32px);
      display: grid;
      grid-template-columns: 1fr auto;
      gap: clamp(20px, 3vw, 48px);
      align-items: center;
    }
    .nlEyebrow {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--accentText);
      opacity: .75;
      margin-bottom: 4px;
    }
    .nlHead {
      font-size: clamp(18px, 2vw, 24px);
      font-weight: 950;
      color: var(--accentText);
      line-height: 1.1;
      letter-spacing: -0.3px;
    }
    .nlSub {
      margin-top: 4px;
      font-size: 13.5px;
      color: var(--accentText);
      opacity: .82;
      line-height: 1.4;
    }
    .nlForm {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-shrink: 0;
    }
    .nlInput {
      height: 44px;
      width: clamp(180px, 20vw, 280px);
      border-radius: 10px;
      border: 2px solid rgba(0,0,0,.18);
      background: rgba(255,255,255,.92);
      color: #111;
      padding: 0 14px;
      font-size: 14px;
      outline: none;
    }
    .nlInput::placeholder { color: #888; }
    .nlInput:focus { border-color: rgba(0,0,0,.4); background: #fff; }
    .nlBtn {
      height: 44px;
      padding: 0 18px;
      border-radius: 10px;
      border: 2px solid rgba(0,0,0,.22);
      background: rgba(0,0,0,.18);
      color: var(--accentText);
      font-weight: 800;
      font-size: 13.5px;
      cursor: pointer;
      white-space: nowrap;
      transition: background 140ms;
    }
    .nlBtn:hover { background: rgba(0,0,0,.28); }

    @media (max-width: 720px) {
      .nlInner { grid-template-columns: 1fr; gap: 14px; }
      .nlForm { flex-direction: column; }
      .nlInput, .nlBtn { width: 100%; }
    }

    /* ── Home grid 75/25 ── */
    .homeGrid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: clamp(24px, 3vw, 48px);
      align-items: start;
      padding-top: 30px;
      padding-bottom: 48px;
    }
    @media (max-width: 980px) {
      .homeGrid { grid-template-columns: 1fr; }
      .homeRail { order: 2; }
    }

    /* ── Hero ── */
    .heroCard {
      display: block;
      text-decoration: none;
      margin-bottom: 32px;
      padding-bottom: 28px;
      border-bottom: 2px solid var(--brand1);
    }
    .heroImgWrap {
      position: relative;
      border-radius: 12px;
      overflow: hidden;
      margin-bottom: 14px;
    }
    .heroImg {
      display: block;
      width: 100%;
      aspect-ratio: 16/9;
      object-fit: cover;
      background: var(--surface);
    }
    .heroFallback {
      aspect-ratio: 16/9;
      background: var(--surface2);
    }
    .kicker {
      position: absolute;
      top: 12px;
      left: 12px;
      background: var(--brand1);
      color: var(--accentText);
      font-size: 10.5px;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
      padding: 3px 10px;
      border-radius: 999px;
    }
    .heroTitle {
      font-size: clamp(22px, 2.8vw, 34px);
      font-weight: 900;
      line-height: 1.1;
      letter-spacing: -0.4px;
      color: var(--text);
      margin: 0 0 8px;
    }
    .heroDesc {
      color: var(--muted);
      font-size: clamp(14px, 1.3vw, 16px);
      line-height: 1.5;
      margin: 0 0 10px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .postMeta {
      font-size: 12.5px;
      color: var(--faint);
    }

    /* ── Section head ── */
    .sectionHead {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      padding-bottom: 10px;
      border-bottom: 2px solid var(--brand1);
      margin-bottom: 0;
    }
    .sectionLabel {
      font-size: 12px;
      font-weight: 900;
      letter-spacing: .13em;
      text-transform: uppercase;
      color: var(--text);
    }
    .viewAll {
      font-size: 12.5px;
      font-weight: 700;
      color: var(--link);
      text-decoration: none;
    }
    .viewAll:hover { text-decoration: underline; }

    /* ── Feed list ── */
    .feedList { margin-bottom: 36px; }

    .feedRow {
      display: grid;
      grid-template-columns: 1fr 100px;
      gap: 16px;
      align-items: start;
      padding: 16px 0;
      border-bottom: 1px solid var(--border);
      text-decoration: none;
    }
    .feedRow:hover .feedRowTitle { color: var(--link); }

    .feedKicker {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .07em;
      text-transform: uppercase;
      color: var(--brand1);
      margin-bottom: 4px;
    }
    .feedRowTitle {
      font-size: clamp(16px, 1.5vw, 19px);
      font-weight: 800;
      line-height: 1.2;
      letter-spacing: -0.2px;
      color: var(--text);
      margin-bottom: 5px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      transition: color 120ms ease;
    }
    .feedRowDesc {
      font-size: 13.5px;
      color: var(--muted);
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin-bottom: 6px;
    }
    .feedThumbWrap { width: 100px; flex-shrink: 0; }
    .feedThumb {
      display: block;
      width: 100px;
      height: 72px;
      object-fit: cover;
      border-radius: 8px;
      background: var(--surface);
    }
    .feedThumbFallback { background: var(--surface2); }

    @media (max-width: 480px) {
      .feedRow { grid-template-columns: 1fr 80px; }
      .feedThumbWrap { width: 80px; }
      .feedThumb { width: 80px; height: 58px; }
    }

    /* ── Topics image grid ── */
    .topicsGrid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-top: 12px;
      margin-bottom: 8px;
    }
    @media (max-width: 600px) {
      .topicsGrid { grid-template-columns: repeat(2, 1fr); }
    }

    .topicTile {
      position: relative;
      display: block;
      text-decoration: none;
      border-radius: 10px;
      overflow: hidden;
      aspect-ratio: 3/2;
      background: var(--surface2);
      border: 1px solid var(--border);
    }
    .topicImg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 320ms ease;
    }
    .topicTile:hover .topicImg { transform: scale(1.05); }
    .topicGrad {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,.80) 0%, rgba(0,0,0,.25) 55%, transparent 100%);
    }
    .topicLabel {
      position: absolute;
      bottom: 10px;
      left: 11px;
      right: 11px;
      font-size: 13px;
      font-weight: 900;
      color: #fff;
      line-height: 1.2;
      letter-spacing: -0.1px;
      text-shadow: 0 1px 6px rgba(0,0,0,.6);
    }

    /* Fallback when image missing — show brand color tile */
    .topicTile:not(:has(img[src])) { background: var(--pillBg); border-color: var(--pillBorder); }
    .topicTile:not(:has(img[src])) .topicGrad { display: none; }
    .topicTile:not(:has(img[src])) .topicLabel {
      bottom: 50%; transform: translateY(50%);
      color: var(--brand1); text-shadow: none; text-align: center;
    }

    /* ── Sidebar ── */
    .homeRail {
      position: sticky;
      top: 80px;
      display: grid;
      gap: 18px;
    }
    .railCard {
      border: 1px solid var(--border);
      background: var(--surface);
      border-radius: 14px;
      padding: 16px;
    }
    .railFlat { background: transparent; }
    .railHead {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 14px;
    }
    .railTitle {
      font-size: 11px;
      font-weight: 900;
      letter-spacing: .13em;
      text-transform: uppercase;
      color: var(--text);
    }
    .railMore {
      font-size: 11.5px;
      font-weight: 700;
      color: var(--link);
      text-decoration: none;
    }
    .railMore:hover { text-decoration: underline; }

    /* Events */
    .eventList { display: grid; gap: 8px; }
    .eventRow {
      display: grid;
      grid-template-columns: 44px 1fr;
      gap: 10px;
      align-items: center;
      text-decoration: none;
      padding: 8px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--surface2);
      transition: border-color 140ms;
    }
    .eventRow:hover { border-color: var(--pillBorder); }
    .eventCal {
      width: 44px; height: 44px;
      border-radius: 10px;
      background: var(--pillBg);
      border: 1px solid var(--pillBorder);
      display: grid; place-items: center;
      text-align: center; line-height: 1;
    }
    .eDow { font-size: 9px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; color: var(--brand1); }
    .eDay { font-size: 17px; font-weight: 900; color: var(--text); margin-top: 1px; }
    .eName { font-weight: 800; font-size: 13px; color: var(--text); line-height: 1.2; }
    .ePlace { font-size: 11.5px; color: var(--faint); margin-top: 2px; }

    /* Guides */
    .guideList { display: grid; }
    .guideRow {
      display: block;
      text-decoration: none;
      font-size: 13.5px;
      font-weight: 700;
      color: var(--text);
      padding: 9px 0;
      border-bottom: 1px solid var(--border);
      line-height: 1.3;
      transition: color 120ms;
    }
    .guideRow:last-child { border-bottom: none; }
    .guideRow:hover { color: var(--link); }

    /* Resources */
    .resourceList { display: grid; gap: 9px; }
    .resourceLink { font-size: 13px; color: var(--muted); text-decoration: none; transition: color 120ms; }
    .resourceLink:hover { color: var(--link); }

    /* Advertise */
    .adCard { background: var(--pillBg); border-color: var(--pillBorder); }
    .adHead { font-size: 15px; font-weight: 900; color: var(--text); margin-bottom: 5px; }
    .adDesc { font-size: 12.5px; color: var(--muted); line-height: 1.4; margin-bottom: 14px; }
    .adBtn {
      display: inline-flex;
      align-items: center;
      height: 36px;
      padding: 0 14px;
      border-radius: 999px;
      background: var(--brand1);
      color: var(--accentText);
      font-size: 12.5px;
      font-weight: 800;
      text-decoration: none;
      transition: filter 140ms;
    }
    .adBtn:hover { filter: brightness(.92); }
  </style>
</Base>
