---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

/** Daytona filter */
function isDaytonaPost(post) {
  const city = String(post?.data?.city ?? "daytona").toLowerCase().trim();
  if (city === "daytona") return true;
  return typeof post?.id === "string" && post.id.startsWith("daytona/");
}

/** Featured flag */
function isFeatured(post) {
  const v = post?.data?.featured;
  if (v === true) return true;
  if (v === 1) return true;
  const s = String(v ?? "").toLowerCase().trim();
  return s === "true" || s === "yes" || s === "1";
}

/** Dates */
function getPostDate(post) {
  return (
    post?.data?.pubDate ??
    post?.data?.date ??
    post?.data?.published ??
    post?.data?.updated ??
    null
  );
}

function sortNewestFirst(a, b) {
  const da = new Date(getPostDate(a) ?? 0).getTime();
  const db = new Date(getPostDate(b) ?? 0).getTime();
  return db - da;
}

function formatDate(d) {
  if (!d) return "";
  try {
    return new Date(d).toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
    });
  } catch {
    return "";
  }
}

function excerpt(post) {
  return post?.data?.description ?? "";
}

/**
 * FIX (per your note): heroImage is a STRING path (no .src)
 * and it must check multiple common keys.
 */
function heroImage(post) {
  const v =
    post?.data?.heroImage ??
    post?.data?.heroimage ??
    post?.data?.image ??
    post?.data?.thumbnail ??
    post?.data?.cover ??
    "";
  return typeof v === "string" ? v.trim() : "";
}

/** Data (keep getCollection logic) */
const all = await getCollection("posts");
const posts = all.filter(isDaytonaPost).sort(sortNewestFirst);

/** Main hero story: first featured, else newest */
const mainHero = posts.find(isFeatured) ?? posts[0] ?? null;

/** Feed rows (don’t duplicate main hero) */
const feed = mainHero ? posts.filter((p) => p.slug !== mainHero.slug) : posts;

/** Optional: show a few featured first, then the rest */
const featured = feed.filter(isFeatured);
const nonFeatured = feed.filter((p) => !isFeatured(p));
const FEED_LIMIT = 12;
const feedRows = [...featured, ...nonFeatured].slice(0, FEED_LIMIT);
---

<Base title="GoDo Daytona" subtitle="Good news for Daytona" cityBase="daytona" />

<section class="section">
  <div class="container" style="max-width: 1120px;">
    <!-- 1) TOP NEWSLETTER SIGNUP HERO -->
    <div class="newsletterBand">
      <div class="newsletterBandInner">
        <div class="newsletterCopy">
          <div class="newsletterKicker">GODO DAYTONA</div>
          <h1 class="newsletterTitle">Good news for Daytona</h1>
          <p class="newsletterSub">Get the best local posts and events sent to your inbox, for free.</p>
          <div class="newsletterFine">100% free. Unsubscribe anytime.</div>
        </div>

        <form class="newsletterForm" action="/daytona/subscribe/" method="get">
          <label class="srOnly" for="email">Email address</label>
          <input
            id="email"
            name="email"
            class="newsletterInput"
            type="email"
            placeholder="Enter your email address"
            autocomplete="email"
          />
          <button class="newsletterBtn" type="submit">SIGN UP — IT’S FREE!</button>
        </form>
      </div>
    </div>

    <!-- 2) ONE MAIN HERO STORY -->
    {mainHero && (
      <div class="heroWrap">
        <a class="heroCard premiumCard" href={`/daytona/posts/${mainHero.slug}/`}>
          <div class="heroMedia">
            {heroImage(mainHero) ? (
              <img
                class="heroImg"
                src={heroImage(mainHero)}
                alt={mainHero.data.title ?? "Hero image"}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="heroImg heroImgFallback" aria-hidden="true"></div>
            )}
          </div>

          <div class="heroBody">
            <div class="heroEyebrow">
              {isFeatured(mainHero) && <span class="pillTag">FEATURED</span>}
              <span class="heroDate">{formatDate(getPostDate(mainHero))}</span>
            </div>

            <div class="heroTitle">{mainHero.data.title ?? mainHero.slug}</div>

            {excerpt(mainHero) && <div class="heroDesc">{excerpt(mainHero)}</div>}
          </div>
        </a>
      </div>
    )}

    <!-- 3) CATEGORY HIGHLIGHT GRID (3 cards) -->
    <div class="categoryGrid">
      <a class="categoryCard premiumCard" href="/daytona/topics/">
        <div class="categoryLabel">Topics</div>
        <div class="categoryDesc">Browse what Daytona is talking about.</div>
      </a>

      <a class="categoryCard premiumCard" href="/daytona/guides/">
        <div class="categoryLabel">City Guides</div>
        <div class="categoryDesc">Curated guides for locals and visitors.</div>
      </a>

      <a class="categoryCard premiumCard" href="/daytona/events/">
        <div class="categoryLabel">Events</div>
        <div class="categoryDesc">What’s happening this week.</div>
      </a>
    </div>

    <!-- 4 + 5) FEED ROWS + UPCOMING EVENTS MODULE -->
    <div class="mainGrid">
      <div class="feedCol">
        <div class="sectionHeader">
          <h2 class="sectionTitle">Latest</h2>
          <a class="sectionLink" href="/daytona/posts/">View all</a>
        </div>

        <div class="rows">
          {feedRows.map((p) => (
            <a class="row premiumCard" href={`/daytona/posts/${p.slug}/`}>
              <div class="rowText">
                <div class="rowTitle">{p.data.title ?? p.slug}</div>
                {excerpt(p) && <div class="rowDesc">{excerpt(p)}</div>}
                <div class="rowMeta">{formatDate(getPostDate(p))}</div>
              </div>

              {heroImage(p) ? (
                <img
                  class="rowThumb"
                  src={heroImage(p)}
                  alt={p.data.title ?? "Thumbnail"}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="rowThumb rowThumbFallback" aria-hidden="true"></div>
              )}
            </a>
          ))}
        </div>
      </div>

      <aside class="rightCol">
        <div class="moduleCard eventsCard premiumCard">
          <div class="moduleHeader">
            <div class="moduleTitle">Upcoming Events</div>
            <a class="moduleLink" href="/daytona/events/">See all</a>
          </div>

          <div class="eventList">
            <div class="eventRow">
              <div class="eventDate">
                <div class="eventDow">SAT</div>
                <div class="eventDay">15</div>
              </div>
              <div class="eventInfo">
                <div class="eventName">Add your first event</div>
                <div class="eventLoc">Daytona Beach</div>
              </div>
            </div>

            <div class="divider"></div>

            <div class="eventRow">
              <div class="eventDate">
                <div class="eventDow">SUN</div>
                <div class="eventDay">16</div>
              </div>
              <div class="eventInfo">
                <div class="eventName">Second event placeholder</div>
                <div class="eventLoc">Ormond Beach</div>
              </div>
            </div>
          </div>
        </div>

        <div class="moduleCard premiumCard">
          <div class="moduleTitle">Resources</div>
          <div class="resourceList">
            <a class="resourceLink" href="/daytona/subscribe/">Subscribe</a>
            <a class="resourceLink" href="/daytona/advertise/">Advertise</a>
            <a class="resourceLink" href="/daytona/topics/">Topics</a>
            <a class="resourceLink" href="/daytona/events/">Events</a>
          </div>
        </div>
      </aside>
    </div>

    <!-- 6) BOTTOM ADVERTISE BAND -->
    <div class="promoBand">
      <div class="promoInner">
        <div>
          <div class="promoTitle">Advertise with us.</div>
          <div class="promoDesc">
            Reach locals where they actually pay attention — in the inbox and on the site.
          </div>
        </div>

        <div class="promoBtns">
          <a class="promoBtn" href="/daytona/advertise/">Branded Content + Display</a>
          <a class="promoBtn promoBtnGhost" href="/daytona/advertise/">Events</a>
        </div>
      </div>
    </div>

    <!-- 7) FOOTER -->
    <footer class="footer">
      <div class="footerGrid">
        <div>
          <div class="footerHead">Resources</div>
          <a class="footerLink" href="/daytona/subscribe/">Subscribe</a>
          <a class="footerLink" href="/daytona/advertise/">Advertise</a>
          <a class="footerLink" href="/daytona/topics/">Topics</a>
          <a class="footerLink" href="/daytona/events/">Events</a>
        </div>

        <div>
          <div class="footerHead">About</div>
          <a class="footerLink" href="/daytona/contact/">Contact</a>
          <a class="footerLink" href="/daytona/legal/">Legal</a>
        </div>

        <div>
          <div class="footerHead">GoDoCity</div>
          <div class="footerText">
            GoDoDaytona is part of the GoDoCity network. Built to scale city-by-city with consistent design,
            editorial workflow, and advertising packages.
          </div>
        </div>
      </div>

      <div class="footerBottom">
        © {new Date().getFullYear()} GoDoCity. All rights reserved.
      </div>
    </footer>
  </div>
</section>

<style>
  /* -------- Premium card system (reused) -------- */
  :global(body) {
    /* keep your site-wide dark theme; this just ensures our local surfaces fit */
  }

  :root {
    --card-radius: 18px;
    --card-border: rgba(255, 255, 255, 0.10);
    --card-border-hover: rgba(255, 255, 255, 0.16);
    --card-bg: rgba(255, 255, 255, 0.035);
    --card-bg-hover: rgba(255, 255, 255, 0.055);
    --muted: rgba(255, 255, 255, 0.72);
    --muted2: rgba(255, 255, 255, 0.58);
    --muted3: rgba(255, 255, 255, 0.42);
    --lift: translateY(-2px);
    --ease: 160ms ease;
  }

  .premiumCard {
    border: 1px solid var(--card-border);
    background: var(--card-bg);
    border-radius: var(--card-radius);
    transition: transform var(--ease), background var(--ease), border-color var(--ease);
  }
  .premiumCard:hover {
    transform: var(--lift);
    background: var(--card-bg-hover);
    border-color: var(--card-border-hover);
  }

  /* -------- Newsletter band -------- */
  .newsletterBand {
    margin-top: 8px;
    margin-bottom: 22px;
    border-radius: calc(var(--card-radius) + 2px);
    border: 1px solid rgba(120, 255, 180, 0.22);
    background:
      radial-gradient(1200px 300px at 15% 20%, rgba(80, 255, 170, 0.10), transparent 55%),
      radial-gradient(900px 260px at 85% 30%, rgba(90, 180, 255, 0.10), transparent 55%),
      rgba(255, 255, 255, 0.02);
    overflow: hidden;
  }

  .newsletterBandInner {
    padding: 22px 22px;
    display: grid;
    grid-template-columns: 1.2fr 0.9fr;
    gap: 18px;
    align-items: center;
  }

  .newsletterKicker {
    font-weight: 900;
    letter-spacing: 0.12em;
    font-size: 12px;
    text-transform: uppercase;
    color: rgba(255, 220, 80, 0.95);
    margin-bottom: 10px;
  }
  .newsletterTitle {
    margin: 0;
    font-weight: 950;
    font-size: clamp(30px, 3.2vw, 44px);
    line-height: 1.06;
  }
  .newsletterSub {
    margin: 10px 0 8px;
    color: var(--muted);
    line-height: 1.45;
  }
  .newsletterFine {
    color: var(--muted3);
    font-size: 13px;
  }

  .newsletterForm {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .newsletterInput {
    width: 100%;
    border-radius: 12px;
    padding: 12px 12px;
    border: 1px solid rgba(255,255,255,0.14);
    background: rgba(0,0,0,0.18);
    color: rgba(255,255,255,0.92);
    outline: none;
  }
  .newsletterInput:focus {
    border-color: rgba(255,255,255,0.22);
  }

  .newsletterBtn {
    border-radius: 12px;
    padding: 12px 12px;
    border: 1px solid rgba(255, 220, 80, 0.55);
    background: rgba(255, 220, 80, 0.14);
    color: rgba(255, 220, 80, 0.95);
    font-weight: 900;
    letter-spacing: 0.03em;
    cursor: pointer;
  }
  .newsletterBtn:hover {
    filter: brightness(1.03);
  }

  @media (max-width: 860px) {
    .newsletterBandInner {
      grid-template-columns: 1fr;
    }
  }

  /* -------- Hero story -------- */
  .heroWrap { margin-bottom: 18px; }

  .heroCard {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 0;
    text-decoration: none;
    overflow: hidden;
  }

  .heroMedia {
    position: relative;
    min-height: 100%;
  }

  .heroImg {
    width: 100%;
    height: 100%;
    display: block;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: rgba(255,255,255,0.03);
  }

  .heroImgFallback {
    aspect-ratio: 16 / 10;
    background:
      linear-gradient(135deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));
  }

  .heroBody {
    padding: 18px 18px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .heroEyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    color: var(--muted2);
    font-size: 13px;
  }

  .pillTag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid rgba(255,220,80,0.55);
    color: rgba(255,220,80,0.92);
    background: rgba(255,220,80,0.12);
    font-weight: 900;
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  .heroDate { opacity: 0.9; }

  .heroTitle {
    font-weight: 950;
    font-size: clamp(20px, 2.2vw, 30px);
    line-height: 1.10;
    letter-spacing: -0.01em;
  }

  .heroDesc {
    margin-top: 10px;
    color: var(--muted);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 860px) {
    .heroCard { grid-template-columns: 1fr; }
    .heroBody { padding: 16px 16px; }
  }

  /* -------- Category grid -------- */
  .categoryGrid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 16px 0 20px;
  }

  .categoryCard {
    text-decoration: none;
    padding: 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .categoryLabel {
    font-weight: 950;
    font-size: 16px;
    letter-spacing: -0.01em;
  }

  .categoryDesc {
    color: var(--muted2);
    line-height: 1.45;
  }

  @media (max-width: 860px) {
    .categoryGrid { grid-template-columns: 1fr; }
  }

  /* -------- Main grid: feed + right column -------- */
  .mainGrid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 16px;
    align-items: start;
    margin-top: 6px;
  }

  @media (max-width: 980px) {
    .mainGrid { grid-template-columns: 1fr; }
  }

  .sectionHeader {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin: 2px 0 10px;
  }

  .sectionTitle {
    margin: 0;
    font-size: 18px;
    font-weight: 950;
    letter-spacing: -0.01em;
  }

  .sectionLink {
    text-decoration: none;
    color: rgba(255,220,80,0.88);
    font-weight: 900;
    font-size: 13px;
    letter-spacing: 0.03em;
  }

  /* -------- Feed rows (NOOGAtoday-like rows) -------- */
  .rows { display: grid; gap: 10px; }

  .row {
    text-decoration: none;
    padding: 12px 12px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px;
    align-items: center;
  }

  .rowText { min-width: 0; }

  .rowTitle {
    font-weight: 950;
    font-size: 16px;
    line-height: 1.18;
    letter-spacing: -0.01em;
  }

  .rowDesc {
    margin-top: 6px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.42;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rowMeta {
    margin-top: 8px;
    color: var(--muted3);
    font-size: 12.5px;
  }

  .rowThumb {
    width: 92px;
    height: 68px;
    border-radius: 12px;
    object-fit: cover;
    border: 1px solid rgba(255,255,255,0.10);
    background: rgba(255,255,255,0.03);
  }

  /* Make fallback look intentional (not broken) */
  .rowThumbFallback {
    background:
      linear-gradient(135deg, rgba(255,255,255,0.07), rgba(255,255,255,0.02));
    position: relative;
  }
  .rowThumbFallback::after {
    content: "—";
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: rgba(255,255,255,0.25);
    font-weight: 900;
    letter-spacing: 0.1em;
  }

  @media (max-width: 520px) {
    .rowThumb { width: 84px; height: 62px; }
  }

  /* -------- Sidebar modules -------- */
  .rightCol { display: grid; gap: 12px; }

  .moduleCard {
    padding: 14px 14px;
  }

  .moduleHeader {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 10px;
  }

  .moduleTitle {
    font-weight: 950;
    font-size: 15px;
    letter-spacing: -0.01em;
  }

  .moduleLink {
    text-decoration: none;
    color: rgba(255,220,80,0.88);
    font-weight: 900;
    font-size: 12px;
    letter-spacing: 0.04em;
  }

  .eventList { display: grid; gap: 10px; }

  .eventRow {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 10px;
    align-items: center;
  }

  .eventDate {
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.10);
    background: rgba(255,255,255,0.03);
    padding: 8px 6px;
    text-align: center;
  }

  .eventDow {
    font-weight: 900;
    font-size: 11px;
    color: rgba(255,255,255,0.70);
    letter-spacing: 0.08em;
  }

  .eventDay {
    font-weight: 950;
    font-size: 18px;
    line-height: 1.05;
    margin-top: 2px;
  }

  .eventName {
    font-weight: 900;
    font-size: 13.5px;
    line-height: 1.2;
  }

  .eventLoc {
    margin-top: 4px;
    color: var(--muted3);
    font-size: 12.5px;
  }

  .divider {
    height: 1px;
    background: rgba(255,255,255,0.08);
  }

  .resourceList {
    margin-top: 10px;
    display: grid;
    gap: 8px;
  }
  .resourceLink {
    text-decoration: none;
    color: rgba(255,255,255,0.82);
  }
  .resourceLink:hover { color: rgba(255,255,255,0.92); }

  /* -------- Promo band -------- */
  .promoBand {
    margin-top: 22px;
    border-radius: calc(var(--card-radius) + 2px);
    border: 1px solid rgba(255,220,80,0.22);
    background:
      radial-gradient(900px 240px at 20% 30%, rgba(255,220,80,0.14), transparent 55%),
      rgba(255,255,255,0.02);
    overflow: hidden;
  }

  .promoInner {
    padding: 18px 18px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 14px;
    align-items: center;
  }

  .promoTitle {
    font-weight: 950;
    font-size: 20px;
    letter-spacing: -0.01em;
  }

  .promoDesc {
    margin-top: 6px;
    color: var(--muted);
    line-height: 1.45;
  }

  .promoBtns {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .promoBtn {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 12px;
    border-radius: 12px;
    font-weight: 950;
    font-size: 13px;
    border: 1px solid rgba(255,220,80,0.55);
    color: rgba(255,220,80,0.95);
    background: rgba(255,220,80,0.12);
  }

  .promoBtnGhost {
    border-color: rgba(255,255,255,0.14);
    color: rgba(255,255,255,0.88);
    background: rgba(255,255,255,0.03);
  }

  @media (max-width: 860px) {
    .promoInner { grid-template-columns: 1fr; }
    .promoBtns { justify-content: flex-start; }
  }

  /* -------- Footer -------- */
  .footer {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .footerGrid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .footerHead {
    font-weight: 950;
    margin-bottom: 10px;
  }

  .footerLink {
    display: block;
    text-decoration: none;
    color: rgba(255,255,255,0.80);
    margin: 6px 0;
  }
  .footerLink:hover { color: rgba(255,255,255,0.92); }

  .footerText { color: var(--muted2); line-height: 1.5; }

  .footerBottom {
    margin-top: 14px;
    color: var(--muted3);
    font-size: 13px;
  }

  @media (max-width: 860px) {
    .footerGrid { grid-template-columns: 1fr; }
  }

  /* a11y */
  .srOnly {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
