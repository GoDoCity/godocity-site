---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

function isDaytonaPost(post) {
  const city = String(post?.data?.city ?? "daytona").toLowerCase().trim();
  if (city === "daytona") return true;
  return typeof post?.id === "string" && post.id.startsWith("daytona/");
}
function isFeatured(post) {
  const v = post?.data?.featured;
  if (v === true) return true;
  if (v === 1) return true;
  return ["true","yes","1"].includes(String(v ?? "").toLowerCase().trim());
}
function getPostDate(post) {
  return post?.data?.pubDate ?? post?.data?.date ?? post?.data?.published ?? post?.data?.updated ?? null;
}
function sortNewestFirst(a, b) {
  return new Date(getPostDate(b) ?? 0).getTime() - new Date(getPostDate(a) ?? 0).getTime();
}
function dateText(post) {
  const d = getPostDate(post);
  return d ? new Date(d).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" }) : "";
}
function excerpt(post) { return post?.data?.description ?? ""; }
function heroImage(post) {
  const v = post?.data?.heroImage ?? post?.data?.heroimage ?? post?.data?.image ?? post?.data?.thumbnail ?? post?.data?.cover ?? "";
  return typeof v === "string" ? v.trim() : "";
}
function primaryTag(post) {
  const tags = post?.data?.tags;
  if (Array.isArray(tags) && tags.length) return String(tags[0]).trim();
  if (typeof post?.data?.topic === "string") return post.data.topic.trim();
  if (typeof post?.data?.category === "string") return post.data.category.trim();
  return "";
}

const all = await getCollection("posts");
const posts = all.filter(isDaytonaPost).sort(sortNewestFirst);
const hero = posts.find(isFeatured) ?? posts[0] ?? null;
const feed = hero ? posts.filter((p) => p.slug !== hero.slug) : posts;
const latest = feed.slice(0, 3);

const featuredAd = {
  tag: "Featured Business",
  title: "Your Business Name Here — Reach Daytona Locals",
  description: "This is where your featured story goes. Up to 75 words, written by our team. Drives real traffic from an engaged local audience who already love Daytona.",
  ctaText: "Learn More",
  ctaHref: "/daytona/advertise/",
  img: "",
};

const topics = [
  { label: "Business",          slug: "biz",             img: "/images/topics/business.jpg" },
  { label: "City",              slug: "city",             img: "/images/topics/city.jpg" },
  { label: "Culture",           slug: "culture",          img: "/images/topics/culture.jpg" },
  { label: "Events",            slug: "events",           img: "/images/topics/events.jpg" },
  { label: "Food",              slug: "food",             img: "/images/topics/food.jpg" },
  { label: "History",           slug: "history",          img: "/images/topics/history.jpg" },
  { label: "Real Estate",       slug: "real-estate",      img: "/images/topics/real-estate.jpg" },
  { label: "Sports",            slug: "sports",           img: "/images/topics/sports.jpg" },
  { label: "Travel + Outdoors", slug: "travel-outdoors",  img: "/images/topics/travel-outdoors.jpg" },
];
---

<Base title="GoDo Daytona" subtitle="Good news for Daytona" cityBase="daytona">
  <div class="pageWrap">

    {/* ── NEWSLETTER BAND ── */}
    <div class="nlBand">
      <div class="nlInner">
        <div class="nlCopy">
          <div class="nlHead">Good news for Daytona.</div>
          <div class="nlSub">Get the best local news &amp; events sent to your inbox, <strong>for free.</strong></div>
        </div>
        <form class="nlForm" action="/daytona/subscribe/" method="get">
          <div class="nlRow">
            <input class="nlInput" type="email" name="email" placeholder="Enter your email address" aria-label="Email address" />
            <button class="nlBtn" type="submit">SIGN UP, IT'S FREE!</button>
          </div>
          <div class="nlFine">100% free, unsubscribe anytime.</div>
        </form>
      </div>
    </div>

    <div class="container">
      <div class="homeGrid">

        {/* ── MAIN FEED ── */}
        <main class="homeMain">

          {/* HERO — image left, text right, big bold type */}
          {hero && (
            <a class="heroCard" href={`/daytona/posts/${hero.slug}/`}>
              <div class="heroImgWrap">
                {heroImage(hero)
                  ? <img class="heroImg" src={heroImage(hero)} alt={hero.data.title ?? ""} loading="eager" decoding="async" />
                  : <div class="heroImg heroFallback" aria-hidden="true" />
                }
              </div>
              <div class="heroCopy">
                {primaryTag(hero) && <div class="heroKicker">{primaryTag(hero)}</div>}
                <h2 class="heroTitle">{hero.data.title ?? hero.slug}</h2>
                {excerpt(hero) && <p class="heroDesc">{excerpt(hero)}</p>}
                <div class="heroMeta">{dateText(hero)}</div>
              </div>
            </a>
          )}

          {/* Single clean divider */}
          <div class="feedDivider"></div>

          {/* 3 CARDS SIDE BY SIDE */}
          <div class="cardGrid">
            {latest.map((p) => (
              <a class="articleCard" href={`/daytona/posts/${p.slug}/`}>
                <div class="cardImgWrap">
                  {heroImage(p)
                    ? <img class="cardImg" src={heroImage(p)} alt="" loading="lazy" decoding="async" />
                    : <div class="cardImg cardImgFallback" aria-hidden="true" />
                  }
                </div>
                <div class="cardBody">
                  {primaryTag(p) && <div class="cardKicker">{primaryTag(p)}</div>}
                  <div class="cardTitle">{p.data.title ?? p.slug}</div>
                  {excerpt(p) && <div class="cardDesc">{excerpt(p)}</div>}
                  <div class="cardMeta">{dateText(p)}</div>
                </div>
              </a>
            ))}
          </div>

          {/* FEATURED AD */}
          <div class="featuredCard">
            <div class="featuredHeader">
              <span class="featuredStar">★</span>
              <span class="featuredLabel">Featured</span>
              <span class="featuredTag">{featuredAd.tag}</span>
            </div>
            <div class="featuredBody">
              {featuredAd.img && (
                <img class="featuredImg" src={featuredAd.img} alt="" loading="lazy" />
              )}
              <div class="featuredText">
                <div class="featuredTitle">{featuredAd.title}</div>
                <div class="featuredDesc">{featuredAd.description}</div>
                <a class="featuredCta" href={featuredAd.ctaHref}>{featuredAd.ctaText} →</a>
              </div>
            </div>
          </div>

          {/* VIEW ALL */}
          <div class="viewAllRow">
            <a class="viewAllBtn" href="/daytona/posts/">View all stories →</a>
          </div>

          {/* TOPICS GRID */}
          <div class="topicsHead">
            <span class="topicsLabel">Topics</span>
          </div>
          <div class="topicsGrid">
            {topics.map((t) => (
              <a class="topicTile" href={`/daytona/topics/${t.slug}/`}>
                <img class="topicImg" src={t.img} alt={t.label} loading="lazy" decoding="async" onerror="this.style.opacity='0'" />
                <div class="topicGrad" aria-hidden="true" />
                <span class="topicLabel">{t.label}</span>
              </a>
            ))}
          </div>

        </main>

        {/* ── SIDEBAR — clean borderless style ── */}
        <aside class="homeRail">

          {/* EVENTS — borderless, divider-only style */}
          <div class="railSection">
            <div class="railHead">
              <span class="railTitle">Upcoming Events</span>
              <a class="railMore" href="/daytona/events/">See all</a>
            </div>
            <div class="eventList">
              <a class="eventRow" href="/daytona/events/">
                <div class="eventCal"><div class="eDow">SAT</div><div class="eDay">15</div></div>
                <div class="eventInfo"><div class="eName">Add your first event</div><div class="ePlace">Daytona Beach</div></div>
              </a>
              <a class="eventRow" href="/daytona/events/">
                <div class="eventCal"><div class="eDow">SUN</div><div class="eDay">16</div></div>
                <div class="eventInfo"><div class="eName">Second event placeholder</div><div class="ePlace">Ormond Beach</div></div>
              </a>
            </div>
          </div>

          {/* DISPLAY AD SLOT */}
          <div class="displayAdSlot">
            <div class="adSlotLabel">Advertisement</div>
            <a class="displayAdCard" href="/daytona/advertise/">
              <div class="displayAdInner">
                <div class="displayAdIcon">📢</div>
                <div class="displayAdTitle">Your Ad Here</div>
                <div class="displayAdDesc">Reach thousands of Daytona locals</div>
                <div class="displayAdCta">Advertise with us →</div>
              </div>
            </a>
          </div>

          {/* CITY GUIDES — borderless */}
          <div class="railSection">
            <div class="railHead">
              <span class="railTitle">City Guides</span>
              <a class="railMore" href="/daytona/guides/">See all</a>
            </div>
            <div class="guideList">
              <a class="guideRow" href="/daytona/guides/live/">🏠 Live in Daytona</a>
              <a class="guideRow" href="/daytona/guides/work/">💼 Work in Daytona</a>
              <a class="guideRow" href="/daytona/guides/play/">🎉 Play in Daytona</a>
            </div>
          </div>

        </aside>
      </div>

      {/* ── ADVERTISE BAND ── */}
      <div class="adBand">
        <div class="adBandInner">
          <div class="adCopy">
            <div class="adEyebrow">Grow your business</div>
            <div class="adHead">Advertise with GoDo Daytona.</div>
            <div class="adDesc">Reach thousands of engaged Daytona locals every day. Featured stories, display ads, event promotion, and newsletter placements — built for local businesses that want real results.</div>
          </div>
          <div class="adActions">
            <a class="adBtnPrimary" href="/daytona/advertise/">Get started →</a>
            <a class="adBtnGhost" href="/daytona/advertise/">See our rates</a>
          </div>
        </div>
      </div>

    </div>
  </div>

  <style>
    .pageWrap { min-height: 100vh; }

    /* 1400px container as Gemini recommended */
    :global(.container) {
      max-width: 1400px;
      margin: 0 auto;
      padding-left: clamp(16px, 2vw, 28px);
      padding-right: clamp(16px, 2vw, 28px);
    }

    /* ── Newsletter ── */
    .nlBand {
      background: var(--brand1);
      padding: clamp(18px, 2.5vw, 28px) 0;
      margin-top: 16px;
    }
    .nlInner {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 clamp(16px, 2vw, 28px);
      display: grid;
      grid-template-columns: auto 1fr;
      gap: clamp(24px, 4vw, 72px);
      align-items: center;
    }
    .nlHead {
      font-size: clamp(20px, 2.2vw, 26px);
      font-weight: 950;
      color: var(--accentText);
      line-height: 1.05;
      letter-spacing: -0.4px;
      margin-bottom: 5px;
      white-space: nowrap;
    }
    .nlSub {
      font-size: clamp(13px, 1.2vw, 15px);
      color: var(--accentText);
      opacity: .88;
    }
    .nlSub strong { font-weight: 900; opacity: 1; }
    .nlRow { display: flex; height: 52px; }
    .nlInput {
      flex: 1; min-width: 0;
      border-radius: 12px 0 0 12px;
      border: 2px solid rgba(0,0,0,.12);
      border-right: none;
      background: #fff; color: #111;
      padding: 0 18px;
      font-size: 16px; font-weight: 500;
      outline: none;
    }
    .nlInput::placeholder { color: #999; }
    .nlInput:focus { border-color: rgba(0,0,0,.3); }
    .nlBtn {
      flex-shrink: 0;
      padding: 0 22px;
      border-radius: 0 12px 12px 0;
      border: 2px solid rgba(0,0,0,.30);
      background: rgba(0,0,0,.22);
      color: var(--accentText);
      font-weight: 900; font-size: 15px;
      cursor: pointer; white-space: nowrap;
      transition: background 140ms;
      letter-spacing: .02em;
    }
    .nlBtn:hover { background: rgba(0,0,0,.36); }
    .nlFine {
      margin-top: 7px; font-size: 12px;
      color: var(--accentText); opacity: .65;
      font-style: italic;
    }
    @media (max-width: 700px) {
      .nlInner { grid-template-columns: 1fr; gap: 14px; }
      .nlHead { white-space: normal; }
      .nlRow { flex-direction: column; height: auto; gap: 8px; }
      .nlInput { border-radius: 12px; border-right: 2px solid rgba(0,0,0,.12); height: 52px; }
      .nlBtn { border-radius: 12px; height: 52px; }
    }

    /* ── 75/25 grid ── */
    .homeGrid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: clamp(28px, 3vw, 48px);
      align-items: start;
      padding-top: 24px;
      padding-bottom: 12px;
    }
    @media (max-width: 980px) {
      .homeGrid { grid-template-columns: 1fr; }
      .homeRail { order: 2; }
    }

    /* ── Hero — bold editorial type ── */
    .heroCard {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      align-items: start;
      text-decoration: none;
      padding-bottom: 20px;
    }
    @media (max-width: 640px) { .heroCard { grid-template-columns: 1fr; } }

    .heroImgWrap { border-radius: 14px; overflow: hidden; }
    .heroImg {
      display: block; width: 100%;
      aspect-ratio: 4/3; object-fit: cover;
      background: var(--surface);
    }
    .heroFallback { aspect-ratio: 4/3; background: var(--surface2); }

    .heroKicker {
      font-size: 11px; font-weight: 800;
      letter-spacing: .1em; text-transform: uppercase;
      color: var(--brand1); margin-bottom: 10px;
    }
    .heroTitle {
      /* 42-48px on desktop as Gemini recommended */
      font-size: clamp(28px, 3.2vw, 46px);
      font-weight: 800;
      line-height: 1.06;
      letter-spacing: -0.8px;
      color: var(--text);
      margin: 0 0 14px;
      transition: color 130ms ease;
    }
    .heroCard:hover .heroTitle { color: var(--link); }
    .heroDesc {
      color: var(--muted);
      font-size: clamp(14px, 1.2vw, 16px);
      line-height: 1.6;
      margin: 0 0 14px;
      /* Strictly 2-3 lines as Gemini recommended */
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .heroMeta { font-size: 13px; color: var(--faint); }

    /* ── Single divider ── */
    .feedDivider {
      height: 2px;
      background: var(--brand1);
      margin: 0 0 22px;
    }

    /* ── 3-column card grid ── */
    .cardGrid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
      margin-bottom: 24px;
    }
    @media (max-width: 640px) {
      .cardGrid { grid-template-columns: 1fr; gap: 0; }
    }

    .articleCard {
      display: flex;
      flex-direction: column;
      text-decoration: none;
    }
    @media (max-width: 640px) {
      .articleCard {
        display: grid;
        grid-template-columns: 1fr 100px;
        gap: 12px;
        align-items: start;
        padding: 16px 0;
        border-bottom: 1px solid var(--border);
      }
    }

    .cardImgWrap {
      border-radius: 12px;
      overflow: hidden;
      margin-bottom: 12px;
    }
    @media (max-width: 640px) {
      .cardImgWrap { margin-bottom: 0; order: 2; border-radius: 8px; }
    }

    .cardImg {
      display: block; width: 100%;
      aspect-ratio: 16/10;
      object-fit: cover;
      background: var(--surface);
      transition: transform 280ms ease;
    }
    .articleCard:hover .cardImg { transform: scale(1.03); }
    .cardImgFallback { aspect-ratio: 16/10; background: var(--surface2); }

    @media (max-width: 640px) {
      .cardImg { aspect-ratio: unset; width: 100px; height: 74px; }
      .cardImgFallback { width: 100px; height: 74px; }
    }

    .cardBody { flex: 1; }
    .cardKicker {
      font-size: 10.5px; font-weight: 800;
      letter-spacing: .08em; text-transform: uppercase;
      color: var(--brand1); margin-bottom: 6px;
    }
    .cardTitle {
      font-size: clamp(15px, 1.3vw, 18px);
      font-weight: 900; line-height: 1.2;
      letter-spacing: -0.2px; color: var(--text);
      margin-bottom: 7px;
      display: -webkit-box; -webkit-line-clamp: 3;
      -webkit-box-orient: vertical; overflow: hidden;
      transition: color 130ms ease;
    }
    .articleCard:hover .cardTitle { color: var(--link); }
    .cardDesc {
      font-size: 13px; color: var(--muted);
      line-height: 1.4; margin-bottom: 8px;
      display: -webkit-box; -webkit-line-clamp: 2;
      -webkit-box-orient: vertical; overflow: hidden;
    }
    .cardMeta { font-size: 12px; color: var(--faint); }

    /* ── Featured ad ── */
    .featuredCard {
      margin: 0 0 20px;
      border: 1.5px solid var(--pillBorder);
      background: var(--surface);
      border-radius: 14px; overflow: hidden;
    }
    .featuredHeader {
      display: flex; align-items: center;
      gap: 7px; padding: 7px 14px;
      background: var(--pillBg);
      border-bottom: 1px solid var(--pillBorder);
    }
    .featuredStar { font-size: 12px; color: var(--brand1); }
    .featuredLabel {
      font-size: 10.5px; font-weight: 900;
      letter-spacing: .1em; text-transform: uppercase;
      color: var(--brand1);
    }
    .featuredTag { font-size: 10.5px; font-weight: 600; color: var(--muted); }
    .featuredBody { padding: 16px; display: grid; gap: 12px; }
    .featuredImg {
      display: block; width: 100%;
      height: 160px; object-fit: cover; border-radius: 9px;
    }
    .featuredTitle {
      font-size: 17px; font-weight: 900;
      color: var(--text); line-height: 1.2;
      margin-bottom: 6px; letter-spacing: -0.2px;
    }
    .featuredDesc { font-size: 13.5px; color: var(--muted); line-height: 1.45; margin-bottom: 12px; }
    .featuredCta {
      display: inline-flex; align-items: center;
      height: 38px; padding: 0 18px; border-radius: 999px;
      background: var(--brand1); color: var(--accentText);
      font-size: 13.5px; font-weight: 800;
      text-decoration: none; transition: filter 130ms;
    }
    .featuredCta:hover { filter: brightness(.92); }

    /* ── View all ── */
    .viewAllRow { padding: 4px 0 24px; text-align: center; }
    .viewAllBtn {
      font-size: 14px; font-weight: 800;
      color: var(--link); text-decoration: none;
      border: 1px solid var(--pillBorder);
      background: var(--pillBg);
      padding: 10px 24px; border-radius: 999px;
      display: inline-flex; align-items: center;
    }
    .viewAllBtn:hover { background: color-mix(in srgb, var(--brand1) 18%, transparent); }

    /* ── Topics ── */
    .topicsHead {
      padding-bottom: 10px;
      border-bottom: 2px solid var(--brand1);
      margin-bottom: 14px;
    }
    .topicsLabel {
      font-size: 11px; font-weight: 900;
      letter-spacing: .15em; text-transform: uppercase;
      color: var(--text);
    }
    .topicsGrid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }
    @media (max-width: 560px) { .topicsGrid { grid-template-columns: repeat(2, 1fr); } }
    .topicTile {
      position: relative; display: block;
      text-decoration: none; border-radius: 10px;
      overflow: hidden; aspect-ratio: 3/2;
      background: var(--surface2); border: 1px solid var(--border);
    }
    .topicImg {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      object-fit: cover; display: block;
      transition: transform 320ms ease;
    }
    .topicTile:hover .topicImg { transform: scale(1.05); }
    .topicGrad {
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,.82) 0%, rgba(0,0,0,.28) 55%, transparent 100%);
    }
    .topicLabel {
      position: absolute; bottom: 10px; left: 11px; right: 11px;
      font-size: 13px; font-weight: 900; color: #fff;
      line-height: 1.2; text-shadow: 0 1px 6px rgba(0,0,0,.6);
    }

    /* ── SIDEBAR — clean borderless style (Gemini) ── */
    .homeRail {
      position: sticky;
      top: 80px;
      display: grid;
      gap: 28px; /* More breathing room between sections */
    }

    /* No more boxed cards — just clean sections with dividers */
    .railSection {
      display: grid;
      gap: 0;
    }

    .railHead {
      display: flex; justify-content: space-between;
      align-items: baseline;
      padding-bottom: 10px;
      border-bottom: 2px solid var(--brand1);
      margin-bottom: 0;
    }
    .railTitle {
      font-size: 10.5px; font-weight: 900;
      letter-spacing: .14em; text-transform: uppercase; color: var(--text);
    }
    .railMore { font-size: 11px; font-weight: 700; color: var(--link); text-decoration: none; }
    .railMore:hover { text-decoration: underline; }

    /* Events — horizontal dividers only, no boxes */
    .eventList { display: grid; }
    .eventRow {
      display: grid;
      grid-template-columns: 44px 1fr;
      gap: 12px; align-items: center;
      text-decoration: none;
      padding: 12px 0;
      border-bottom: 1px solid var(--border);
      transition: opacity 140ms;
    }
    .eventRow:hover { opacity: .78; }
    .eventCal {
      width: 44px; height: 44px; border-radius: 10px;
      background: var(--pillBg); border: 1px solid var(--pillBorder);
      display: grid; place-items: center; text-align: center; line-height: 1;
      flex-shrink: 0;
    }
    .eDow { font-size: 9px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; color: var(--brand1); }
    .eDay { font-size: 17px; font-weight: 900; color: var(--text); margin-top: 1px; }
    .eName { font-weight: 800; font-size: 13px; color: var(--text); line-height: 1.2; }
    .ePlace { font-size: 11.5px; color: var(--faint); margin-top: 2px; }

    /* Ad slot */
    .displayAdSlot { display: grid; gap: 5px; }
    .adSlotLabel {
      font-size: 9px; font-weight: 700;
      letter-spacing: .12em; text-transform: uppercase;
      color: var(--faint); text-align: center;
    }
    .displayAdCard {
      display: block; text-decoration: none;
      border: 1.5px dashed var(--pillBorder);
      border-radius: 14px; background: var(--pillBg);
      transition: border-color 140ms;
    }
    .displayAdCard:hover { border-color: var(--brand1); }
    .displayAdInner { padding: 24px 16px; text-align: center; display: grid; gap: 5px; place-items: center; }
    .displayAdIcon { font-size: 26px; margin-bottom: 2px; }
    .displayAdTitle { font-size: 15px; font-weight: 900; color: var(--text); }
    .displayAdDesc { font-size: 12.5px; color: var(--muted); line-height: 1.3; }
    .displayAdCta {
      margin-top: 6px; display: inline-flex; align-items: center;
      height: 32px; padding: 0 14px; border-radius: 999px;
      background: var(--brand1); color: var(--accentText);
      font-size: 12px; font-weight: 800;
    }

    /* Guides — borderless list */
    .guideList { display: grid; }
    .guideRow {
