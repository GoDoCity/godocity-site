---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

function isDaytonaPost(post) {
  const city = String(post?.data?.city ?? "daytona").toLowerCase().trim();
  if (city === "daytona") return true;
  return typeof post?.id === "string" && post.id.startsWith("daytona/");
}
function isFeatured(post) {
  const v = post?.data?.featured;
  if (v === true) return true;
  if (v === 1) return true;
  return ["true","yes","1"].includes(String(v ?? "").toLowerCase().trim());
}
function getPostDate(post) {
  return post?.data?.pubDate ?? post?.data?.date ?? post?.data?.published ?? post?.data?.updated ?? null;
}
function sortNewestFirst(a, b) {
  return new Date(getPostDate(b) ?? 0).getTime() - new Date(getPostDate(a) ?? 0).getTime();
}
function dateText(post) {
  const d = getPostDate(post);
  return d ? new Date(d).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" }) : "";
}
function excerpt(post) { return post?.data?.description ?? ""; }
function heroImage(post) {
  const v = post?.data?.heroImage ?? post?.data?.heroimage ?? post?.data?.image ?? post?.data?.thumbnail ?? post?.data?.cover ?? "";
  return typeof v === "string" ? v.trim() : "";
}
function primaryTag(post) {
  const tags = post?.data?.tags;
  if (Array.isArray(tags) && tags.length) return String(tags[0]).trim();
  if (typeof post?.data?.topic === "string") return post.data.topic.trim();
  if (typeof post?.data?.category === "string") return post.data.category.trim();
  return "";
}

const all = await getCollection("posts");
const posts = all.filter(isDaytonaPost).sort(sortNewestFirst);
const hero = posts.find(isFeatured) ?? posts[0] ?? null;
const feed = hero ? posts.filter((p) => p.slug !== hero.slug) : posts;
const latest = feed.slice(0, 3);

const featuredAd = {
  tag: "Featured Business",
  title: "Your Business Name Here — Reach Daytona Locals",
  description: "This is where your featured story goes. Up to 75 words, written by our team. Drives real traffic from an engaged local audience who already love Daytona.",
  ctaText: "Learn More",
  ctaHref: "/daytona/advertise/",
  img: "",
};

const topics = [
  { label: "Biz",              slug: "biz",             img: "/images/topics/biz.jpg" },
  { label: "City",             slug: "city",             img: "/images/topics/city.jpg" },
  { label: "Culture",          slug: "culture",          img: "/images/topics/culture.jpg" },
  { label: "Events",           slug: "events",           img: "/images/topics/events.jpg" },
  { label: "Food",             slug: "food",             img: "/images/topics/food.jpg" },
  { label: "History",          slug: "history",          img: "/images/topics/history.jpg" },
  { label: "Real Estate",      slug: "real-estate",      img: "/images/topics/real-estate.jpg" },
  { label: "Sports",           slug: "sports",           img: "/images/topics/sports.jpg" },
  { label: "Travel & Outdoors",slug: "travel-outdoors",  img: "/images/topics/travel-outdoors.jpg" },
];
/* ── TOPIC IMAGE GUIDE (save to /public/images/topics/) ──────────────
   biz.jpg           → Local storefronts, Main Street Daytona
   city.jpg          → Aerial/drone shot of Daytona Beach coastline
   culture.jpg       → Neon lights from a local music venue or colorful mural
   events.jpg        → Crowds at Bike Week or Daytona 500 grandstands
   food.jpg          → Close-up burger or cocktail with condensation
   history.jpg       → Historic Daytona boardwalk or vintage race photo
   real-estate.jpg   → Modern beachfront balcony or historic Daytona home
   sports.jpg        → Motion-blurred race car or stadium lights at night
   travel-outdoors.jpg → Cinematic sunrise over Daytona pier or surfboard in sand
────────────────────────────────────────────────────────────────────── */
---

<Base title="GoDo Daytona" subtitle="Good news for Daytona" cityBase="daytona">
  <div class="pageWrap">

    {/* ── NEWSLETTER BAND — Method A: text left, image right ── */}
    <div class="nlBand">
      <div class="nlInner">
        <div class="nlContent">
          <div class="nlHead">Good News Daytona!</div>
          <div class="nlSub">Get the best local news &amp; events sent to your inbox, <strong>for free.</strong></div>
          <form class="nlForm" action="/daytona/subscribe/" method="get">
            <div class="nlRow">
              <input class="nlInput" type="email" name="email" placeholder="Enter your email address" aria-label="Email address" />
              <button class="nlBtn" type="submit">SIGN UP, IT'S FREE!</button>
            </div>
          </form>
          <div class="nlFine">100% free, unsubscribe anytime.</div>
        </div>
      </div>
    </div>

    <div class="container">
      <div class="homeGrid">

        <main class="homeMain">

          {/* ── HERO — cinematic wide crop, anchored to sidebar height ── */}
          {hero && (
            <a class="heroCard" href={`/daytona/posts/${hero.slug}/`}>
              <div class="heroImgWrap">
                {heroImage(hero)
                  ? <img class="heroImg" src={heroImage(hero)} alt={hero.data.title ?? ""} loading="eager" decoding="async" />
                  : <div class="heroImg heroFallback" aria-hidden="true" />
                }
              </div>
              <div class="heroCopy">
                {primaryTag(hero) && <div class="heroKicker">{primaryTag(hero)}</div>}
                <h2 class="heroTitle">{hero.data.title ?? hero.slug}</h2>
                {excerpt(hero) && <p class="heroDesc">{excerpt(hero)}</p>}
                <div class="heroMeta">{dateText(hero)}</div>
              </div>
            </a>
          )}

          <div class="feedDivider"></div>

          {/* ── 3 CARDS SIDE BY SIDE ── */}
          <div class="cardGrid">
            {latest.map((p) => (
              <a class="articleCard" href={`/daytona/posts/${p.slug}/`}>
                <div class="cardImgWrap">
                  {heroImage(p)
                    ? <img class="cardImg" src={heroImage(p)} alt="" loading="lazy" decoding="async" />
                    : <div class="cardImg cardImgFallback" aria-hidden="true" />
                  }
                </div>
                <div class="cardBody">
                  {primaryTag(p) && <div class="cardKicker">{primaryTag(p)}</div>}
                  <div class="cardTitle">{p.data.title ?? p.slug}</div>
                  {excerpt(p) && <div class="cardDesc">{excerpt(p)}</div>}
                  <div class="cardMeta">{dateText(p)}</div>
                </div>
              </a>
            ))}
          </div>

          {/* ── FEATURED AD — "FEATURED" label, never "Sponsored" ── */}
          <div class="featuredCard">
            <div class="featuredHeader">
              <span class="featuredStar">★</span>
              <span class="featuredLabel">FEATURED</span>
              <span class="featuredTag">{featuredAd.tag}</span>
            </div>
            <div class="featuredBody">
              {featuredAd.img && (
                <img class="featuredImg" src={featuredAd.img} alt="" loading="lazy" />
              )}
              <div class="featuredText">
                <div class="featuredTitle">{featuredAd.title}</div>
                <div class="featuredDesc">{featuredAd.description}</div>
                <a class="featuredCta" href={featuredAd.ctaHref}>{featuredAd.ctaText} →</a>
              </div>
            </div>
          </div>

          <div class="viewAllRow">
            <a class="viewAllBtn" href="/daytona/posts/">View all stories →</a>
          </div>

          {/* ── TOPICS ── */}
          <div class="topicsHead">
            <span class="topicsLabel">Topics</span>
          </div>
          <div class="topicsGrid">
            {topics.map((t) => (
              <a class="topicTile" href={`/daytona/topics/${t.slug}/`}>
                <img class="topicImg" src={t.img} alt={t.label} loading="lazy" decoding="async" onerror="this.style.opacity='0'" />
                <div class="topicGrad" aria-hidden="true" />
                <span class="topicLabel">{t.label}</span>
              </a>
            ))}
          </div>

        </main>

        {/* ── SIDEBAR — aligns top with hero, borderless ── */}
        <aside class="homeRail">

          <div class="railSection">
            <div class="railHead">
              <span class="railTitle">Upcoming Events</span>
              <a class="railMore" href="/daytona/events/">See all</a>
            </div>
            <div class="eventList">
              <a class="eventRow" href="/daytona/events/">
                <div class="eventCal"><div class="eDow">SAT</div><div class="eDay">15</div></div>
                <div class="eventInfo"><div class="eName">Add your first event</div><div class="ePlace">Daytona Beach</div></div>
              </a>
              <a class="eventRow" href="/daytona/events/">
                <div class="eventCal"><div class="eDow">SUN</div><div class="eDay">16</div></div>
                <div class="eventInfo"><div class="eName">Second event placeholder</div><div class="ePlace">Ormond Beach</div></div>
              </a>
            </div>
          </div>

          <div class="displayAdSlot">
            <div class="adSlotLabel">Advertisement</div>
            <a class="displayAdCard" href="/daytona/advertise/">
              <div class="displayAdInner">
                <div class="displayAdIcon">📢</div>
                <div class="displayAdTitle">Your Ad Here</div>
                <div class="displayAdDesc">Reach thousands of Daytona locals</div>
                <div class="displayAdCta">Advertise with us →</div>
              </div>
            </a>
          </div>

          <div class="railSection">
            <div class="railHead">
              <span class="railTitle">City Guides</span>
              <a class="railMore" href="/daytona/guides/">See all</a>
            </div>
            <div class="guideList">
              <a class="guideRow" href="/daytona/guides/live/">🏠 Live in Daytona</a>
              <a class="guideRow" href="/daytona/guides/work/">💼 Work in Daytona</a>
              <a class="guideRow" href="/daytona/guides/play/">🎉 Play in Daytona</a>
            </div>
          </div>

        </aside>
      </div>

      {/* ── ADVERTISE BAND ── */}
      <div class="adBand">
        <div class="adBandInner">
          <div class="adCopy">
            <div class="adEyebrow">Grow your business</div>
            <div class="adHead">Advertise with GoDo Daytona.</div>
            <div class="adDesc">Reach thousands of engaged Daytona locals every day. Featured stories, display ads, event promotion, and newsletter placements — built for local businesses that want real results.</div>
          </div>
          <div class="adActions">
            <a class="adBtnPrimary" href="/daytona/advertise/">Get started →</a>
            <a class="adBtnGhost" href="/daytona/advertise/">See our rates</a>
          </div>
        </div>
      </div>

    </div>
  </div>

  <style>
    .pageWrap { min-height: 100vh; }

    /* ── Island-style layout: 1400px centered, 3rem generous frame ── */
    :global(.container) {
      max-width: 1400px;
      margin: 0 auto;
      padding-left: 3rem;
      padding-right: 3rem;
    }
    @media (max-width: 600px) {
      :global(.container) { padding-left: 1rem; padding-right: 1rem; }
    }

    /* ── Newsletter — vertical stack, skyline bg, 65% dark overlay ── */
    /* ── Newsletter — image LEFT (35% wide), text RIGHT, gradient fades left→right ── */
    .nlBand {
      position: relative;
      margin-top: 16px;
      overflow: hidden;
      background:
        /* Solid yellow starts at 35% — image visible only in left ~35% of banner */
        linear-gradient(
          to left,
          var(--brand1) 0%,
          var(--brand1) 35%,
          transparent 58%
        ),
        /* Postcard anchored left — "DAY BEA" lettering stays fully visible */
        url('/images/gododaytona-bg.png') left center / cover no-repeat;
      background-color: var(--brand1);
    }
    .nlInner {
      max-width: 1400px;
      margin: 0 auto;
      padding: clamp(28px, 3.5vw, 48px) 3rem;
      display: flex;
      align-items: flex-start;
      justify-content: flex-end;
    }
    .nlContent {
      max-width: 520px;
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .nlHead {
      font-size: clamp(26px, 3vw, 40px);
      font-weight: 950;
      color: var(--accentText);
      line-height: 1.05;
      letter-spacing: -0.5px;
    }
    .nlSub {
      font-size: clamp(15px, 1.3vw, 18px);
      color: var(--accentText);
      opacity: .9;
      line-height: 1.4;
    }
    .nlSub strong { font-weight: 900; opacity: 1; }
    .nlForm { width: 100%; }
    .nlRow { display: flex; height: 52px; width: 100%; }
    .nlInput {
      flex: 1; min-width: 0;
      border-radius: 10px 0 0 10px;
      /* Darker border — obvious click target on yellow bg */
      border: 2.5px solid rgba(0,0,0,.5);
      border-right: none;
      background: #fff; color: #111;
      padding: 0 16px; font-size: 15px; font-weight: 500;
      outline: none;
      transition: border-color 150ms;
    }
    .nlInput::placeholder { color: #888; }
    .nlInput:focus { border-color: rgba(0,0,0,.8); }
    .nlBtn {
      flex-shrink: 0; padding: 0 22px;
      border-radius: 0 10px 10px 0;
      border: none;
      /* Dark button — high contrast against yellow banner */
      background: #111;
      color: #fff;
      font-weight: 900; font-size: 14px; cursor: pointer;
      white-space: nowrap;
      letter-spacing: .04em;
      transition: background 150ms;
    }
    .nlBtn:hover { background: #333; }
    .nlFine {
      font-size: 11.5px; font-weight: 500;
      color: var(--accentText);
      opacity: .6;
      font-style: italic;
    }
    /* Mobile: full-bleed with dark overlay */
    @media (max-width: 700px) {
      .nlBand {
        background:
          linear-gradient(rgba(0,0,0,.72), rgba(0,0,0,.72)),
          url('/images/gododaytona-bg.png') center/cover no-repeat;
        background-color: var(--brand1);
      }
      .nlInner { padding: 28px 1.5rem; justify-content: flex-start; }
      .nlContent { max-width: 100%; }
      .nlHead { color: #fff; }
      .nlSub { color: rgba(255,255,255,.88); }
      .nlFine { color: rgba(255,255,255,.6); }
      .nlRow { flex-direction: column; height: auto; gap: 8px; }
      .nlInput { border-radius: 10px; border-right: 2.5px solid rgba(0,0,0,.5); height: 50px; }
      .nlBtn { border-radius: 10px; height: 50px; }
    }

    /* ── Home grid 75/25, sidebar aligns top with hero ── */
    .homeGrid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 290px;
      gap: clamp(48px, 4vw, 64px);
      /* align-items: start keeps both columns top-aligned */
      align-items: start;
      padding-top: 22px;
      padding-bottom: 12px;
    }
    @media (max-width: 980px) {
      .homeGrid { grid-template-columns: 1fr; }
      .homeRail { order: 2; }
    }

    /* ── HERO — 40/60 split like Nooga, image constrained to 300px ── */
    .heroCard {
      display: grid;
      grid-template-columns: 2fr 3fr;
      gap: 22px;
      align-items: start;
      text-decoration: none;
      padding-bottom: 18px;
    }
    @media (max-width: 640px) { .heroCard { grid-template-columns: 1fr; } }

    .heroImgWrap {
      border-radius: 12px;
      overflow: hidden;
      max-height: 285px;
    }
    .heroImg {
      display: block;
      width: 100%;
      height: 285px;
      max-height: 285px;
      object-fit: cover;
      object-position: center;
      background: var(--surface);
    }
    .heroFallback {
      height: 240px;
      max-height: 285px;
      background: var(--surface2);
    }

    .heroKicker {
      font-size: 10.5px; font-weight: 800;
      letter-spacing: .1em; text-transform: uppercase;
      color: var(--brand1); margin-bottom: 9px;
    }
    .heroTitle {
      /* Reduced another 10% from previous — matches Nooga's lighter touch */
      font-size: clamp(20px, 2.1vw, 30px);
      font-weight: 800;
      line-height: 1.09;
      letter-spacing: -0.5px;
      color: var(--text);
      margin: 0 0 11px;
      transition: color 130ms ease;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .heroCard:hover .heroTitle { color: var(--link); }
    .heroDesc {
      color: var(--muted);
      font-size: 18px;
      font-weight: 500;
      line-height: 1.55; margin: 0 0 13px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .heroMeta { font-size: 12.5px; color: var(--faint); }

    /* Single divider + 40px editorial breathing room above triple-threat */
    .feedDivider {
      height: 2px;
      background: var(--brand1);
      margin: 0 0 40px;
    }

    /* ── 3-column cards ── */
    .cardGrid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-bottom: 22px;
    }
    @media (max-width: 640px) { .cardGrid { grid-template-columns: 1fr; gap: 0; } }

    .articleCard {
      display: flex; flex-direction: column; text-decoration: none;
    }
    @media (max-width: 640px) {
      .articleCard {
        display: grid; grid-template-columns: 1fr 100px;
        gap: 12px; align-items: start;
        padding: 16px 0; border-bottom: 1px solid var(--border);
      }
    }
    .cardImgWrap {
      border-radius: 11px; overflow: hidden; margin-bottom: 11px;
    }
    @media (max-width: 640px) {
      .cardImgWrap { margin-bottom: 0; order: 2; border-radius: 8px; }
    }
    .cardImg {
      display: block; width: 100%;
      aspect-ratio: 16/10;
      object-fit: cover; background: var(--surface);
      transition: transform 280ms ease;
    }
    .articleCard:hover .cardImg { transform: scale(1.03); }
    .cardImgFallback { aspect-ratio: 16/10; background: var(--surface2); }
    @media (max-width: 640px) {
      .cardImg { aspect-ratio: unset; width: 100px; height: 74px; }
      .cardImgFallback { width: 100px; height: 74px; }
    }
    .cardBody { flex: 1; }
    .cardKicker {
      font-size: 10px; font-weight: 800;
      letter-spacing: .08em; text-transform: uppercase;
      color: var(--brand1); margin-bottom: 5px;
    }
    .cardTitle {
      font-size: 22px;
      font-weight: 900; line-height: 1.2;
      letter-spacing: -0.2px; color: var(--text); margin-bottom: 6px;
      display: -webkit-box; -webkit-line-clamp: 3;
      -webkit-box-orient: vertical; overflow: hidden;
      transition: color 130ms ease;
    }
    .articleCard:hover .cardTitle { color: var(--link); }
    .cardDesc {
      font-size: 18px; font-weight: 500;
      color: var(--muted); line-height: 1.45; margin-bottom: 7px;
      display: -webkit-box; -webkit-line-clamp: 2;
      -webkit-box-orient: vertical; overflow: hidden;
    }
    .cardMeta { font-size: 11.5px; color: var(--faint); }

    /* ── FEATURED ad — "FEATURED" all-caps label ── */
    .featuredCard {
      margin: 0 0 20px;
      border: 1.5px solid var(--pillBorder);
      background: var(--surface); border-radius: 14px; overflow: hidden;
    }
    .featuredHeader {
      display: flex; align-items: center; gap: 7px;
      padding: 6px 14px; background: var(--pillBg);
      border-bottom: 1px solid var(--pillBorder);
    }
    .featuredStar { font-size: 11px; color: var(--brand1); }
    .featuredLabel {
      /* All-caps FEATURED — never "Sponsored" */
      font-size: 10px; font-weight: 900;
      letter-spacing: .14em; text-transform: uppercase; color: var(--brand1);
    }
    .featuredTag { font-size: 10px; font-weight: 600; color: var(--muted); letter-spacing: .04em; }
    .featuredBody { padding: 14px 16px; display: grid; gap: 10px; }
    .featuredImg { display: block; width: 100%; height: 150px; object-fit: cover; border-radius: 9px; }
    .featuredTitle {
      font-size: 16.5px; font-weight: 900; color: var(--text);
      line-height: 1.2; margin-bottom: 5px; letter-spacing: -0.2px;
    }
    .featuredDesc { font-size: 13px; color: var(--muted); line-height: 1.45; margin-bottom: 12px; }
    .featuredCta {
      display: inline-flex; align-items: center;
      height: 36px; padding: 0 16px; border-radius: 999px;
      background: var(--brand1); color: var(--accentText);
      font-size: 13px; font-weight: 800;
      text-decoration: none; transition: filter 130ms;
    }
    .featuredCta:hover { filter: brightness(.92); }

    /* View all */
    .viewAllRow { padding: 4px 0 24px; text-align: center; }
    .viewAllBtn {
      font-size: 13.5px; font-weight: 800; color: var(--link);
      text-decoration: none; border: 1px solid var(--pillBorder);
      background: var(--pillBg); padding: 9px 22px;
      border-radius: 999px; display: inline-flex; align-items: center;
    }
    .viewAllBtn:hover { background: color-mix(in srgb, var(--brand1) 18%, transparent); }

    /* Topics */
    .topicsHead { padding-bottom: 10px; border-bottom: 2px solid var(--brand1); margin-bottom: 13px; }
    .topicsLabel {
      font-size: 14px; font-weight: 900;
      letter-spacing: .2em; text-transform: uppercase; color: var(--text);
    }
    .topicsGrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
    @media (max-width: 560px) { .topicsGrid { grid-template-columns: repeat(2, 1fr); } }
    .topicTile {
      position: relative; display: block; text-decoration: none;
      border-radius: 12px; overflow: hidden; aspect-ratio: 3/2;
      background: var(--surface2); border: 1px solid var(--border);
    }
    .topicImg {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover; display: block; transition: transform 320ms ease;
    }
    .topicTile:hover .topicImg { transform: scale(1.05); }
    .topicGrad {
      position: absolute; inset: 0;
      /* 50% black overlay as specified — legibility over any image */
      background: rgba(0,0,0,.50);
    }
    .topicLabel {
      /* Centered in tile, 24pt bold all-caps white */
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      font-weight: 900;
      color: #fff;
      text-transform: uppercase;
      letter-spacing: .08em;
      text-align: center;
      padding: 8px;
      text-shadow: 0 2px 12px rgba(0,0,0,.7);
    }

    /* ── SIDEBAR — sticky, top-aligned with hero, borderless ── */
    .homeRail {
      position: sticky;
      top: 80px;
      display: grid;
      gap: 24px;
      align-self: start; /* ensures it doesn't stretch past its content */
    }
    .railSection { display: grid; gap: 0; }
    .railHead {
      display: flex; justify-content: space-between; align-items: baseline;
      padding-bottom: 10px; border-bottom: 2px solid var(--brand1);
    }
    .railTitle {
      font-size: 10px; font-weight: 900;
      letter-spacing: .14em; text-transform: uppercase; color: var(--text);
    }
    .railMore { font-size: 10.5px; font-weight: 700; color: var(--link); text-decoration: none; }
    .railMore:hover { text-decoration: underline; }

    /* Events — dividers only, no boxes */
    .eventList { display: grid; }
    .eventRow {
      display: grid; grid-template-columns: 44px 1fr;
      gap: 12px; align-items: center; text-decoration: none;
      padding: 11px 0; border-bottom: 1px solid var(--border);
      transition: opacity 140ms;
    }
    .eventRow:hover { opacity: .76; }
    .eventCal {
