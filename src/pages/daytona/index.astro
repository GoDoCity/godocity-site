---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

/** Daytona filter */
function isDaytonaPost(post) {
  const city = String(post?.data?.city ?? "daytona").toLowerCase().trim();
  if (city === "daytona") return true;
  return typeof post?.id === "string" && post.id.startsWith("daytona/");
}

/** Featured flag */
function isFeatured(post) {
  const v = post?.data?.featured;
  if (v === true) return true;
  if (v === 1) return true;
  const s = String(v ?? "").toLowerCase().trim();
  return s === "true" || s === "yes" || s === "1";
}

/** Dates */
function getPostDate(post) {
  return (
    post?.data?.pubDate ??
    post?.data?.date ??
    post?.data?.published ??
    post?.data?.updated ??
    null
  );
}

function sortNewestFirst(a, b) {
  const da = new Date(getPostDate(a) ?? 0).getTime();
  const db = new Date(getPostDate(b) ?? 0).getTime();
  return db - da;
}

function dateText(post) {
  const d = getPostDate(post);
  return d ? new Date(d).toLocaleDateString("en-US") : "";
}

function excerpt(post) {
  return post?.data?.description ?? "";
}

/**
 * IMPORTANT: keep thumbnails working exactly as-is
 * (do not use .src, this is a STRING path)
 */
function heroImage(post) {
  const v =
    post?.data?.heroImage ??
    post?.data?.heroimage ??
    post?.data?.image ??
    post?.data?.thumbnail ??
    post?.data?.cover ??
    "";
  return typeof v === "string" ? v.trim() : "";
}

/** Data (keep logic stable) */
const all = await getCollection("posts");
const posts = all.filter(isDaytonaPost).sort(sortNewestFirst);

const hero = posts.find(isFeatured) ?? posts[0] ?? null;
const feed = hero ? posts.filter((p) => p.slug !== hero.slug) : posts;

// Split for “Featured + Latest” feel (no logic change to content source; just presentation)
const latest = feed.slice(0, 8);
---

<Base title="GoDo Daytona" subtitle="Good news for Daytona" cityBase="daytona" />

<section class="section">
  <div class="container homeWrap">
    <!-- NOTE: The duplicate GoDoCity network block + right-side pills are injected by Base.
         We remove/hide them for Daytona via body.city-daytona CSS overrides below. -->

    <!-- NEWSLETTER SIGNUP BAND (Nooga-ish: tall, yellow, stacked input/button) -->
    <div class="newsletterBand">
      <div class="newsletterBandInner">
        <div class="newsletterText">
          <div class="newsletterKicker">Good news for Daytona</div>
          <div class="newsletterHeadline">Get the best local posts and events sent to your inbox.</div>
          <div class="newsletterFine">100% free. Unsubscribe anytime.</div>
        </div>

        <form class="newsletterForm" action="/daytona/subscribe/" method="get">
          <input class="newsletterInput" type="email" name="email" placeholder="Enter your email address" />
          <button class="newsletterButton" type="submit">Sign up — it’s free</button>
        </form>
      </div>
    </div>

    <!-- Main grid: left content + right rail -->
    <div class="homeGrid">
      <!-- LEFT -->
      <div class="homeMain">
        {hero && (
          <a class="heroFeature" href={`/daytona/posts/${hero.slug}/`}>
            <div class="heroMedia">
              {heroImage(hero) ? (
                <img
                  class="heroImg"
                  src={heroImage(hero)}
                  alt={hero.data.title ?? "Hero image"}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="heroImg heroImgFallback" aria-hidden="true"></div>
              )}
            </div>

            <div class="heroCopy">
              <div class="heroTitle">{hero.data.title ?? hero.slug}</div>
              {excerpt(hero) && <div class="heroDesc">{excerpt(hero)}</div>}
              <div class="heroMeta">{dateText(hero)}</div>
            </div>
          </a>
        )}

        <div class="sectionHeader">
          <div class="sectionTitle">Explore</div>
        </div>

        <div class="catGrid">
          <a class="catCard" href="/daytona/topics/">
            <div class="catTitle">Topics</div>
            <div class="catDesc">Browse what Daytona is talking about.</div>
          </a>
          <a class="catCard" href="/daytona/guides/">
            <div class="catTitle">City Guides</div>
            <div class="catDesc">Curated guides for locals and visitors.</div>
          </a>
          <a class="catCard" href="/daytona/events/">
            <div class="catTitle">Events</div>
            <div class="catDesc">What’s happening this week.</div>
          </a>
        </div>

        <div class="feedHeader">
          <div class="sectionTitle">Latest</div>
          <a class="viewAllLink" href="/daytona/posts/">View all</a>
        </div>

        <div class="latestGrid" role="list">
          {latest.map((p) => (
            <a class="latestCard" role="listitem" href={`/daytona/posts/${p.slug}/`}>
              <div class="latestMedia">
                {heroImage(p) ? (
                  <img
                    class="latestImg"
                    src={heroImage(p)}
                    alt={p.data.title ?? "Thumbnail"}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="latestImg latestImgFallback" aria-hidden="true"></div>
                )}
              </div>

              <div class="latestBody">
                <div class="latestTitle">{p.data.title ?? p.slug}</div>
                {excerpt(p) && <div class="latestDesc">{excerpt(p)}</div>}
                <div class="latestMeta">{dateText(p)}</div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- RIGHT RAIL -->
      <aside class="homeRail">
        <div class="moduleCard eventsCard">
          <div class="moduleHead">
            <div class="moduleTitle">Upcoming Events</div>
            <a class="viewAllLink viewAllLinkSmall" href="/daytona/events/">See all</a>
          </div>

          <div class="eventsList">
            <div class="eventRow">
              <div class="eventDate">
                <div class="eventDow">SAT</div>
                <div class="eventDay">15</div>
              </div>
              <div class="eventInfo">
                <div class="eventName">Add your first event</div>
                <div class="eventPlace">Daytona Beach</div>
              </div>
            </div>

            <div class="eventRow">
              <div class="eventDate">
                <div class="eventDow">SUN</div>
                <div class="eventDay">16</div>
              </div>
              <div class="eventInfo">
                <div class="eventName">Second event placeholder</div>
                <div class="eventPlace">Ormond Beach</div>
              </div>
            </div>
          </div>

          <div class="railDivider"></div>

          <div class="railLinks">
            <div class="moduleTitle moduleTitleSmall">Resources</div>
            <a class="railLink" href="/daytona/subscribe/">Subscribe</a>
            <a class="railLink" href="/daytona/advertise/">Advertise</a>
            <a class="railLink" href="/daytona/topics/">Topics</a>
            <a class="railLink" href="/daytona/events/">Events</a>
          </div>
        </div>
      </aside>
    </div>

    <div class="promoBand">
      <div class="promoCopy">
        <div class="promoTitle">Advertise with us.</div>
        <div class="promoDesc">Reach locals with sponsored stories, display placements, and event promotion.</div>
      </div>
      <div class="promoActions">
        <a class="btn" href="/daytona/advertise/">Branded Content + Display</a>
        <a class="btn btnGhost" href="/daytona/advertise/">Events</a>
      </div>
    </div>

    <footer class="homeFooter">
      <div class="footerCols">
        <div class="footerCol">
          <div class="footerHead">Resources</div>
          <a class="footerLink" href="/daytona/subscribe/">Subscribe</a>
          <a class="footerLink" href="/daytona/advertise/">Advertise</a>
          <a class="footerLink" href="/daytona/topics/">Topics</a>
          <a class="footerLink" href="/daytona/events/">Events</a>
        </div>

        <div class="footerCol">
          <div class="footerHead">About</div>
          <a class="footerLink" href="/daytona/contact/">Contact</a>
          <a class="footerLink" href="/daytona/legal/">Legal</a>
        </div>

        <div class="footerCol footerColWide">
          <div class="footerHead">GoDoDaytona</div>
          <div class="footerFine">
            GoDoDaytona is part of the GoDoCity network. Built to scale city-by-city with consistent design,
            editorial workflow, and advertising packages.
          </div>
          <div class="footerFine" style="margin-top:10px;">
            © {new Date().getFullYear()} GoDoCity. All rights reserved.
          </div>
        </div>
      </div>
    </footer>
  </div>
</section>

<style>
  /* Wider page like Nooga */
  :global(.container) {
    max-width: 1240px;
    padding-left: clamp(14px, 2vw, 22px);
    padding-right: clamp(14px, 2vw, 22px);
  }
  @media (min-width: 1400px) {
    :global(.container) { max-width: 1280px; }
  }

  .homeWrap {
    --maxMain: 860px;
    --rail: 320px;
    --gridGap: 22px;

    /* shared inset for alignment */
    --contentInset: 22px;

    /* rail nudge right (~0.5cm) to match email field edge exactly */
    --railNudge: 19px;

    --cardRadius: 16px;
    --cardRadiusSm: 14px;
    --cardBorder: rgba(255,255,255,.10);
    --cardBorderSoft: rgba(255,255,255,.08);
    --cardBg: rgba(255,255,255,.03);

    --shadowSoft: 0 8px 18px rgba(0,0,0,.22);

    --t1: #e8edf4;
    --t2: rgba(232,237,244,.86);
    --t3: rgba(232,237,244,.70);
    --t4: rgba(232,237,244,.58);

    --yellow: #ffd24a;
    --yellowDeep: #ffc400;

    --glow: 0 0 0 1px rgba(255,210,74,.18), 0 10px 26px rgba(0,0,0,.30);
    --glowSoft: 0 0 0 1px rgba(255,210,74,.18), 0 18px 44px rgba(0,0,0,.45);
  }

  /* ================= Daytona-only Base header overrides =================
     User note: body.city-daytona exists. Use it as the scope so other cities are unaffected. */

  /* 1) Kill the injected top GoDoCity network block + “All rights reserved” */
  :global(body.city-daytona .cityNetworkBlurb),
  :global(body.city-daytona .networkBlurb),
  :global(body.city-daytona .siteNetworkNote),
  :global(body.city-daytona .topNetworkNote),
  :global(body.city-daytona .topNetworkBlurb),
  :global(body.city-daytona [data-network-blurb="top"]),
  :global(body.city-daytona .allRightsReserved),
  :global(body.city-daytona [data-all-rights-reserved]),
  :global(body.city-daytona .networkFooterTop),
  :global(body.city-daytona .topNetworkFooter) {
    display: none !important;
  }

  /* 1) Kill the “Advertise” + “City Directory” pills that sit beside that block (top only) */
  :global(body.city-daytona header a.pill[href*="advertise"]),
  :global(body.city-daytona header a.pill[href*="city-directory"]),
  :global(body.city-daytona header a.pill[href*="directory"]) {
    display: none !important;
  }

  /* 2) Remove the yellow “Subscribe” pill in header (duplicate) */
  :global(body.city-daytona header a.pill[href*="subscribe"]) {
    display: none !important;
  }

  /* 2) Put “Advertise” into the MAIN pill row next to “The Buy”
     (We’re not editing Base markup. We:
       - hide the header's advertise pill above (so it can’t float right),
       - and force the nav-row to include Advertise by showing any non-header advertise pill if Base already renders it in nav row.
     If Base already has Advertise in the row, this does nothing. */
  :global(body.city-daytona nav a.pill[href*="advertise"]) {
    display: inline-flex !important;
  }

  /* 3) Mobile pills missing: keep Base pills visible, tighter, wrapping into 2 rows */
  @media (max-width: 720px) {
    :global(body.city-daytona header .navPills),
    :global(body.city-daytona header .pillRow),
    :global(body.city-daytona header .navRow),
    :global(body.city-daytona header nav .pills),
    :global(body.city-daytona header nav .navPills) {
      display: flex !important;
      flex-wrap: wrap !important;
      gap: 6px !important;
      overflow: visible !important;
      padding-bottom: 0 !important;
    }

    :global(body.city-daytona header a.pill),
    :global(body.city-daytona header .pill) {
      padding: 6px 10px !important;
      font-size: 11.5px !important;
      line-height: 1 !important;
      border-radius: 999px !important;
      white-space: nowrap !important;
    }
  }

  /* =================== NEWSLETTER BAND (Nooga-ish) =================== */
  .newsletterBand {
    border: 1px solid rgba(255,210,74,.58);
    background:
      radial-gradient(1000px 520px at 20% 0%, rgba(255,210,74,.24), rgba(255,210,74,0) 60%),
      rgba(255,210,74,.14);
    box-shadow: var(--glowSoft);
    border-radius: var(--cardRadius);
    overflow: hidden;
    margin: 10px 0 18px;
  }

  .newsletterBandInner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    padding: 36px var(--contentInset); /* ~2x height feel */
    align-items: start;
  }
  @media (max-width: 520px) {
    .newsletterBandInner { padding: 30px 14px; }
  }

  /* All text in band must be WHITE (except the yellow badge) */
  .newsletterHeadline { color: rgba(232,237,244,.96); }
  .newsletterFine { color: rgba(232,237,244,.78); }

  .newsletterHeadline {
    font-size: 22px;
    line-height: 1.12;
    font-weight: 950;
    letter-spacing: -0.3px;
    margin: 0;
  }
  .newsletterFine { font-size: 14px; line-height: 1.35; margin-top: 6px; }

  /* Badge: bright yellow with black text */
  .newsletterKicker {
    font-weight: 950;
    letter-spacing: .2px;
    background: rgba(255,210,74,.98);
    color: #0b0d10;
    display: inline-flex;
    padding: 7px 12px;
    border-radius: 999px;
    border: 1px solid rgba(0,0,0,.30);
    box-shadow: 0 10px 18px rgba(0,0,0,.18);
    width: fit-content;
  }

  /* Stack layout: input full-width, button full-width below */
  .newsletterForm {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    width: 100%;
    min-width: 0;
  }

  .newsletterInput {
    width: 100%;
    height: 54px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.20);
    background: rgba(11,13,16,.72);
    color: rgba(232,237,244,.96); /* input text white */
    padding: 0 14px;
    outline: none;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.06);
  }
  .newsletterInput::placeholder { color: rgba(232,237,244,.72); } /* readable */
  .newsletterInput:focus {
    border-color: rgba(255,210,74,.78);
    box-shadow: 0 0 0 4px rgba(255,210,74,.22);
  }

  .newsletterButton {
    width: 100%;
    height: 54px;
    border-radius: 14px;
    border: 1px solid rgba(0,0,0,.55);
    background: linear-gradient(180deg, var(--yellow), var(--yellowDeep));
    color: #0b0d10;
    font-weight: 950;
    letter-spacing: .01em;
    cursor: pointer;
    box-shadow: 0 16px 26px rgba(0,0,0,.22);
  }
  .newsletterButton:hover { filter: brightness(1.02) contrast(1.02); }
  .newsletterButton:active { transform: translateY(0.5px); }

  @media (max-width: 520px) {
    .newsletterInput, .newsletterButton { height: 50px; border-radius: 13px; }
    .newsletterHeadline { font-size: 20px; }
  }

  /* =================== HOME GRID + RAIL ALIGNMENT =================== */
  .homeGrid {
    display: grid;
    grid-template-columns: minmax(0, var(--maxMain)) minmax(0, var(--rail));
    gap: var(--gridGap);
    align-items: start;

    /* Grid inset = newsletter inset so columns start under same left edge */
    padding: 0 var(--contentInset);
  }
  @media (max-width: 980px) {
    .homeGrid { grid-template-columns: 1fr; padding: 0; }
    .homeRail { order: 2; }
  }

  /* Move Upcoming Events column slightly RIGHT (~0.5cm) to match email field edge precisely */
  .homeRail {
    padding: 0;
    margin: 0;
    transform: translateX(var(--railNudge));
  }
  @media (max-width: 980px) {
    .homeRail { transform: none; }
  }

  /* Hero */
  .heroFeature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    text-decoration: none;
    border: 1px solid var(--cardBorder);
    background: var(--cardBg);
    border-radius: var(--cardRadius);
    overflow: hidden;
    box-shadow: var(--shadowSoft);
    margin-bottom: 16px;
  }
  @media (max-width: 740px) { .heroFeature { grid-template-columns: 1fr; } }
  .heroMedia { background: rgba(255,255,255,.02); }
  .heroImg { width: 100%; height: 100%; min-height: 220px; display: block; object-fit: cover; }
  .heroImgFallback { min-height: 220px; }
  .heroCopy { padding: 16px 16px 14px; }
  .heroTitle { font-size: 26px; line-height: 1.1; font-weight: 950; color: var(--t1); letter-spacing: -0.2px; }
  .heroDesc {
    margin-top: 10px;
    color: var(--t2);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .heroMeta { margin-top: 12px; color: var(--t4); font-size: 13px; }

  /* Section headers */
  .sectionHeader { margin: 6px 0 10px; }
  .sectionTitle { font-weight: 950; font-size: 14px; color: var(--t3); text-transform: uppercase; letter-spacing: .12em; }
  .feedHeader { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin: 16px 0 10px; }

  .viewAllLink { color: rgba(255,210,74,.92); font-weight: 800; font-size: 13px; text-decoration: none; opacity: .95; }
  .viewAllLink:hover { opacity: 1; text-decoration: underline; }
  .viewAllLinkSmall { font-size: 12px; }

  /* Category grid */
  .catGrid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 12px; margin-bottom: 8px; }
  @media (max-width: 740px) { .catGrid { grid-template-columns: 1fr; } }
  .catCard {
    text-decoration: none;
    border: 1px solid var(--cardBorderSoft);
    background: var(--cardBg);
    border-radius: var(--cardRadius);
    padding: 14px 14px 13px;
    box-shadow: var(--shadowSoft);
  }
  .catTitle { font-weight: 950; font-size: 16px; color: var(--t1); }
  .catDesc { margin-top: 6px; color: var(--t4); line-height: 1.25; font-size: 13px; }

  /* Latest grid */
  .latestGrid { display: grid !important; gap: 24px; grid-template-columns: 1fr; }
  @media (min-width: 760px) { .latestGrid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1040px) { .latestGrid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .latestCard {
    display: grid;
    grid-template-rows: auto 1fr;
    text-decoration: none;
    border: 1px solid var(--cardBorderSoft);
    background: rgba(255,255,255,.022);
    border-radius: var(--cardRadiusSm);
    overflow: hidden;
    transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease, transform 160ms ease;
    min-height: 100%;
  }
  .latestCard:hover {
    border-color: rgba(255,210,74,.22);
    box-shadow: var(--glow);
    background: rgba(255,255,255,.03);
    transform: translateY(-2px);
  }

  .latestMedia { aspect-ratio: 16 / 9; background: rgba(255,255,255,.02); overflow: hidden; min-height: 170px; }
  @media (min-width: 760px) { .latestMedia { min-height: 215px; } }
  @media (min-width: 1040px) { .latestMedia { min-height: 235px; } }

  .latestImg { width: 100%; height: 100%; display: block; object-fit: cover; }
  .latestImgFallback {
    background:
      radial-gradient(280px 200px at 25% 25%, rgba(255,255,255,.08), rgba(255,255,255,0)),
      linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.02));
  }

  .latestBody { padding: 15px 16px 14px; min-width: 0; display: grid; align-content: start; }
  .latestTitle {
    font-weight: 950;
    font-size: 18px;
    line-height: 1.15;
    color: var(--t1);
    letter-spacing: -0.2px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .latestDesc {
    margin-top: 8px;
    color: var(--t3);
    font-size: 14.5px;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .latestMeta { margin-top: 10px; color: var(--t4); font-size: 12.5px; }

  /* Rail module */
  .moduleCard {
    border: 1px solid var(--cardBorder);
    background: var(--cardBg);
    border-radius: var(--cardRadius);
    padding: 14px;
    box-shadow: var(--shadowSoft);
  }
  .moduleHead { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; margin-bottom: 10px; }
  .moduleTitle { font-weight: 950; color: var(--t1); letter-spacing: -0.1px; }
  .moduleTitleSmall { font-size: 13px; margin-bottom: 8px; opacity: .9; }

  .eventsList { display: grid; gap: 10px; }
  .eventRow {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 10px;
    align-items: center;
    padding: 10px 10px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.08);
    background: rgba(255,255,255,.02);
  }
  .eventDate {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(0,0,0,.18);
    display: grid;
    place-items: center;
    line-height: 1.05;
  }
  .eventDow { font-size: 11px; color: var(--t4); font-weight: 900; letter-spacing: .08em; }
  .eventDay { font-size: 16px; color: var(--t1); font-weight: 950; margin-top: 2px; }
  .eventName { font-weight: 900; color: var(--t1); line-height: 1.15; }
  .eventPlace { margin-top: 4px; color: var(--t4); font-size: 12.5px; }

  .railDivider { height: 1px; background: rgba(255,255,255,.08); margin: 14px 0 12px; }
  .railLinks { display: grid; gap: 8px; }
  .railLink { color: rgba(232,237,244,.78); text-decoration: none; font-size: 13px; }
  .railLink:hover { color: rgba(255,210,74,.92); }

  /* Promo band */
  .promoBand {
    margin: 18px 0 0;
    border: 1px solid var(--cardBorder);
    background: linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.02));
    border-radius: var(--cardRadius);
    padding: 16px;
    display: flex;
    justify-content: space-between;
    gap: 14px;
    align-items: center;
    box-shadow: var(--shadowSoft);
    flex-wrap: wrap;
  }
  .promoTitle { font-weight: 950; font-size: 18px; color: var(--t1); }
  .promoDesc { margin-top: 6px; color: var(--t3); line-height: 1.3; }
  .promoActions { display: flex; gap: 10px; flex-wrap: wrap; }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding: 0 12px;
    border-radius: 12px;
    border: 1px solid rgba(255,210,74,.38);
