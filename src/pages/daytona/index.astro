---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

function isDaytonaPost(post) {
  const city = String(post?.data?.city ?? "daytona").toLowerCase().trim();
  if (city === "daytona") return true;
  return typeof post?.id === "string" && post.id.startsWith("daytona/");
}
function isFeatured(post) {
  const v = post?.data?.featured;
  if (v === true) return true;
  if (v === 1) return true;
  return ["true","yes","1"].includes(String(v ?? "").toLowerCase().trim());
}
function getPostDate(post) {
  return post?.data?.pubDate ?? post?.data?.date ?? post?.data?.published ?? post?.data?.updated ?? null;
}
function sortNewestFirst(a, b) {
  return new Date(getPostDate(b) ?? 0).getTime() - new Date(getPostDate(a) ?? 0).getTime();
}
function dateText(post) {
  const d = getPostDate(post);
  return d ? new Date(d).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" }) : "";
}
function excerpt(post) { return post?.data?.description ?? ""; }
function heroImage(post) {
  const v = post?.data?.heroImage ?? post?.data?.heroimage ?? post?.data?.image ?? post?.data?.thumbnail ?? post?.data?.cover ?? "";
  return typeof v === "string" ? v.trim() : "";
}
function primaryTag(post) {
  const tags = post?.data?.tags;
  if (Array.isArray(tags) && tags.length) return String(tags[0]).trim();
  if (typeof post?.data?.topic === "string") return post.data.topic.trim();
  if (typeof post?.data?.category === "string") return post.data.category.trim();
  return "";
}

const all = await getCollection("posts");
const posts = all.filter(isDaytonaPost).sort(sortNewestFirst);
const hero = posts.find(isFeatured) ?? posts[0] ?? null;
const feed = hero ? posts.filter((p) => p.slug !== hero.slug) : posts;
const latest = feed.slice(0, 3);

/* ── PLACEHOLDER AD DATA ─────────────────────────────────
   Replace these with real advertiser content later.
   In production these would come from a CMS or content collection.
────────────────────────────────────────────────────── */
const sponsoredArticle = {
  label: "Sponsored",
  tag: "Branded Content",
  title: "Your Business Name Here — Reach Daytona Locals",
  description: "This is where your sponsored story goes. Up to 75 words, written by our team or yours. Drives real traffic from an engaged local audience who already love Daytona.",
  ctaText: "Get Started",
  ctaHref: "/daytona/advertise/",
  img: "", // Add sponsor image path here
};

const topics = [
  { label: "Business",          slug: "biz",             img: "/images/topics/business.jpg" },
  { label: "City",              slug: "city",             img: "/images/topics/city.jpg" },
  { label: "Culture",           slug: "culture",          img: "/images/topics/culture.jpg" },
  { label: "Events",            slug: "events",           img: "/images/topics/events.jpg" },
  { label: "Food",              slug: "food",             img: "/images/topics/food.jpg" },
  { label: "History",           slug: "history",          img: "/images/topics/history.jpg" },
  { label: "Real Estate",       slug: "real-estate",      img: "/images/topics/real-estate.jpg" },
  { label: "Sports",            slug: "sports",           img: "/images/topics/sports.jpg" },
  { label: "Travel + Outdoors", slug: "travel-outdoors",  img: "/images/topics/travel-outdoors.jpg" },
];
---

<Base title="GoDo Daytona" subtitle="Good news for Daytona" cityBase="daytona">
  <div class="pageWrap">

    {/* ══ NEWSLETTER BAND ══ */}
    <div class="nlBand">
      <div class="nlInner">
        <div class="nlCopy">
          <div class="nlEyebrow">✉ Free Daily Newsletter</div>
          <div class="nlHead">Good news for Daytona.</div>
          <div class="nlSub">The best local stories, events, and things to do — sent free to your inbox every morning.</div>
        </div>
        <form class="nlForm" action="/daytona/subscribe/" method="get">
          <input
            class="nlInput"
            type="email"
            name="email"
            placeholder="Enter your email address"
            aria-label="Email address"
          />
          <button class="nlBtn" type="submit">Sign Up — It's Free →</button>
          <div class="nlFine">100% free. Unsubscribe anytime.</div>
        </form>
      </div>
    </div>

    {/* ══ MAIN CONTENT ══ */}
    <div class="container">
      <div class="homeGrid">

        {/* ── LEFT: MAIN FEED ── */}
        <main class="homeMain">

          {/* HERO — large featured article */}
          {hero && (
            <a class="heroCard" href={`/daytona/posts/${hero.slug}/`}>
              <div class="heroImgWrap">
                {heroImage(hero)
                  ? <img class="heroImg" src={heroImage(hero)} alt={hero.data.title ?? ""} loading="eager" decoding="async" />
                  : <div class="heroImg heroFallback" aria-hidden="true" />
                }
                {primaryTag(hero) && <span class="heroKicker">{primaryTag(hero)}</span>}
              </div>
              <div class="heroCopy">
                <h2 class="heroTitle">{hero.data.title ?? hero.slug}</h2>
                {excerpt(hero) && <p class="heroDesc">{excerpt(hero)}</p>}
                <div class="heroMeta">
                  {dateText(hero)}
                  <span class="featBadge">Featured</span>
                </div>
              </div>
            </a>
          )}

          {/* LATEST — section header */}
          <div class="sectionHead">
            <span class="sectionLabel">Latest</span>
            <a class="viewAll" href="/daytona/posts/">View all →</a>
          </div>

          {/* 3 STACKED ARTICLES + 1 SPONSORED SLOT after #2 */}
          <div class="feedList">
            {latest.map((p, i) => (
              <>
                <a class="feedRow" href={`/daytona/posts/${p.slug}/`}>
                  <div class="feedText">
                    {primaryTag(p) && <div class="feedKicker">{primaryTag(p)}</div>}
                    <div class="feedRowTitle">{p.data.title ?? p.slug}</div>
                    {excerpt(p) && <div class="feedRowDesc">{excerpt(p)}</div>}
                    <div class="feedMeta">{dateText(p)}</div>
                  </div>
                  <div class="feedThumbWrap">
                    {heroImage(p)
                      ? <img class="feedThumb" src={heroImage(p)} alt="" loading="lazy" decoding="async" />
                      : <div class="feedThumb feedThumbFallback" aria-hidden="true" />
                    }
                  </div>
                </a>

                {/* SPONSORED MINI ARTICLE — appears after article #2 */}
                {i === 1 && (
                  <div class="sponsoredCard">
                    <div class="sponsoredHeader">
                      <span class="sponsoredLabel">★ Sponsored</span>
                      <span class="sponsoredTag">{sponsoredArticle.tag}</span>
                    </div>
                    <div class="sponsoredBody">
                      {sponsoredArticle.img && (
                        <div class="sponsoredImgWrap">
                          <img class="sponsoredImg" src={sponsoredArticle.img} alt="" loading="lazy" />
                        </div>
                      )}
                      <div class="sponsoredText">
                        <div class="sponsoredTitle">{sponsoredArticle.title}</div>
                        <div class="sponsoredDesc">{sponsoredArticle.description}</div>
                        <a class="sponsoredCta" href={sponsoredArticle.ctaHref}>
                          {sponsoredArticle.ctaText} →
                        </a>
                      </div>
                    </div>
                  </div>
                )}
              </>
            ))}
          </div>

          {/* TOPICS VISUAL GRID */}
          <div class="sectionHead" style="margin-top:40px">
            <span class="sectionLabel">Topics</span>
          </div>
          <div class="topicsGrid">
            {topics.map((t) => (
              <a class="topicTile" href={`/daytona/topics/${t.slug}/`}>
                <img
                  class="topicImg"
                  src={t.img}
                  alt={t.label}
                  loading="lazy"
                  decoding="async"
                  onerror="this.style.opacity='0'"
                />
                <div class="topicGrad" aria-hidden="true" />
                <span class="topicLabel">{t.label}</span>
              </a>
            ))}
          </div>

        </main>

        {/* ── RIGHT: SIDEBAR ── */}
        <aside class="homeRail">

          {/* EVENTS */}
          <div class="railCard">
            <div class="railHead">
              <span class="railTitle">Upcoming Events</span>
              <a class="railMore" href="/daytona/events/">See all</a>
            </div>
            <div class="eventList">
              <a class="eventRow" href="/daytona/events/">
                <div class="eventCal">
                  <div class="eDow">SAT</div>
                  <div class="eDay">15</div>
                </div>
                <div class="eventInfo">
                  <div class="eName">Add your first event</div>
                  <div class="ePlace">Daytona Beach</div>
                </div>
              </a>
              <a class="eventRow" href="/daytona/events/">
                <div class="eventCal">
                  <div class="eDow">SUN</div>
                  <div class="eDay">16</div>
                </div>
                <div class="eventInfo">
                  <div class="eName">Second event placeholder</div>
                  <div class="ePlace">Ormond Beach</div>
                </div>
              </a>
            </div>
          </div>

          {/* DISPLAY AD SLOT */}
          <div class="displayAdSlot">
            <div class="adSlotLabel">Advertisement</div>
            <a class="displayAdCard" href="/daytona/advertise/">
              <div class="displayAdPlaceholder">
                <div class="displayAdIcon">📢</div>
                <div class="displayAdTitle">Your Ad Here</div>
                <div class="displayAdDesc">Reach thousands of Daytona locals</div>
                <div class="displayAdCta">Advertise with us →</div>
              </div>
            </a>
          </div>

          {/* CITY GUIDES */}
          <div class="railCard">
            <div class="railHead">
              <span class="railTitle">City Guides</span>
              <a class="railMore" href="/daytona/guides/">See all</a>
            </div>
            <div class="guideList">
              <a class="guideRow" href="/daytona/guides/">Best beaches in Daytona</a>
              <a class="guideRow" href="/daytona/guides/">Where to eat on the strip</a>
              <a class="guideRow" href="/daytona/guides/">Weekend events calendar</a>
            </div>
          </div>

        </aside>
      </div>

      {/* ══ ADVERTISE BAND — full width bottom ══ */}
      <div class="adBand">
        <div class="adBandInner">
          <div class="adCopy">
            <div class="adEyebrow">Grow your business</div>
            <div class="adHead">Advertise with GoDo Daytona.</div>
            <div class="adDesc">Reach thousands of engaged Daytona locals every day. Sponsored stories, display ads, event promotion, and newsletter placements — built for local businesses that want real results.</div>
          </div>
          <div class="adActions">
            <a class="adBtnPrimary" href="/daytona/advertise/">Get started →</a>
            <a class="adBtnGhost" href="/daytona/advertise/">See our rates</a>
          </div>
        </div>
      </div>

    </div>
  </div>

  <style>
    .pageWrap { min-height: 100vh; }

    :global(.container) {
      max-width: 1200px;
      margin: 0 auto;
      padding-left: clamp(16px, 2.5vw, 32px);
      padding-right: clamp(16px, 2.5vw, 32px);
    }

    /* ══ NEWSLETTER BAND ══ */
    .nlBand {
      background: var(--brand1);
      padding: clamp(28px, 4vw, 48px) 0;
      margin-top: 24px; /* Space between pills and band */
    }
    .nlInner {
      max-width: 900px;
      margin: 0 auto;
      padding: 0 clamp(16px, 2.5vw, 32px);
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(28px, 4vw, 60px);
      align-items: center;
    }
    .nlEyebrow {
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--accentText);
      opacity: .78;
      margin-bottom: 8px;
    }
    .nlHead {
      font-size: clamp(24px, 2.8vw, 34px);
      font-weight: 950;
      color: var(--accentText);
      line-height: 1.05;
      letter-spacing: -0.5px;
      margin-bottom: 10px;
    }
    .nlSub {
      font-size: clamp(14px, 1.3vw, 16px);
      color: var(--accentText);
      opacity: .85;
      line-height: 1.5;
    }
    .nlForm {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .nlInput {
      height: 58px; /* Tall and prominent */
      width: 100%;
      border-radius: 14px;
      border: 3px solid rgba(0,0,0,.15);
      background: #fff;
      color: #111;
      padding: 0 20px;
      font-size: 17px; /* Larger, bolder text */
      font-weight: 600;
      outline: none;
      box-sizing: border-box;
      transition: border-color 150ms, box-shadow 150ms;
    }
    .nlInput::placeholder {
      color: #999;
      font-weight: 500;
    }
    .nlInput:focus {
      border-color: rgba(0,0,0,.35);
      box-shadow: 0 0 0 4px rgba(255,255,255,.3);
    }
    .nlBtn {
      height: 58px; /* Match input height */
      width: 100%;
      border-radius: 14px;
      border: 3px solid rgba(0,0,0,.25);
      background: rgba(0,0,0,.22);
      color: var(--accentText);
      font-weight: 900;
      font-size: 17px; /* Larger button text */
      cursor: pointer;
      transition: background 140ms;
      letter-spacing: .01em;
    }
    .nlBtn:hover { background: rgba(0,0,0,.35); }
    .nlFine {
      font-size: 12px;
      color: var(--accentText);
      opacity: .65;
      text-align: center;
    }

    @media (max-width: 700px) {
      .nlInner { grid-template-columns: 1fr; gap: 20px; }
    }

    /* ══ HOME GRID ══ */
    .homeGrid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 290px;
      gap: clamp(28px, 3.5vw, 52px);
      align-items: start;
      padding-top: 30px;
      padding-bottom: 12px;
    }
    @media (max-width: 980px) {
      .homeGrid { grid-template-columns: 1fr; }
      .homeRail { order: 2; }
    }

    /* ══ HERO ARTICLE ══ */
    .heroCard {
      display: block;
      text-decoration: none;
      margin-bottom: 32px;
      padding-bottom: 28px;
      border-bottom: 2px solid var(--brand1);
    }
    .heroImgWrap {
      position: relative;
      border-radius: 14px;
      overflow: hidden;
      margin-bottom: 18px;
    }
    .heroImg {
      display: block;
      width: 100%;
      aspect-ratio: 16/8;
      object-fit: cover;
      background: var(--surface);
    }
    .heroFallback {
      aspect-ratio: 16/8;
      background: var(--surface2);
    }
    .heroKicker {
      position: absolute;
      top: 14px; left: 14px;
      background: var(--brand1);
      color: var(--accentText);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
      padding: 4px 12px;
      border-radius: 999px;
    }
    .heroTitle {
      font-size: clamp(24px, 3vw, 38px);
      font-weight: 950;
      line-height: 1.08;
      letter-spacing: -0.5px;
      color: var(--text);
      margin: 0 0 12px;
    }
    .heroDesc {
      color: var(--muted);
      font-size: clamp(15px, 1.4vw, 17px);
      line-height: 1.55;
      margin: 0 0 14px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .heroMeta {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      color: var(--faint);
    }
    .featBadge {
      background: var(--pillBg);
      border: 1px solid var(--pillBorder);
      color: var(--brand1);
      font-size: 10.5px;
      font-weight: 800;
      padding: 2px 8px;
      border-radius: 999px;
      letter-spacing: .05em;
      text-transform: uppercase;
    }

    /* ══ SECTION HEAD ══ */
    .sectionHead {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      padding-bottom: 11px;
      border-bottom: 2px solid var(--brand1);
      margin-bottom: 0;
    }
    .sectionLabel {
      font-size: 11.5px;
      font-weight: 900;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--text);
    }
    .viewAll {
      font-size: 12px;
      font-weight: 700;
      color: var(--link);
      text-decoration: none;
    }
    .viewAll:hover { text-decoration: underline; }

    /* ══ FEED ROWS ══ */
    .feedList { margin-bottom: 0; }

    .feedRow {
      display: grid;
      grid-template-columns: 1fr 150px;
      gap: 18px;
      align-items: start;
      padding: 22px 0;
      border-bottom: 1px solid var(--border);
      text-decoration: none;
    }
    .feedRow:hover .feedRowTitle { color: var(--link); }

    .feedKicker {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--brand1);
      margin-bottom: 6px;
    }
    .feedRowTitle {
      font-size: clamp(18px, 1.8vw, 22px);
      font-weight: 900;
      line-height: 1.15;
      letter-spacing: -0.3px;
      color: var(--text);
      margin-bottom: 7px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      transition: color 130ms ease;
    }
    .feedRowDesc {
      font-size: 14.5px;
      color: var(--muted);
      line-height: 1.5;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin-bottom: 8px;
    }
    .feedMeta { font-size: 12px; color: var(--faint); }

    .feedThumbWrap { width: 150px; flex-shrink: 0; }
    .feedThumb {
      display: block;
      width: 150px;
      height: 110px;
      object-fit: cover;
      border-radius: 10px;
      background: var(--surface);
    }
    .feedThumbFallback { background: var(--surface2); }

    @media (max-width: 540px) {
      .feedRow { grid-template-columns: 1fr 100px; gap: 12px; padding: 16px 0; }
      .feedThumbWrap { width: 100px; }
      .feedThumb { width: 100px; height: 74px; }
      .feedRowTitle { font-size: 17px; }
    }

    /* ══ SPONSORED MINI ARTICLE ══ */
    .sponsoredCard {
      margin: 4px 0;
      border: 1.5px solid var(--pillBorder);
      background: var(--surface);
      border-radius: 14px;
      overflow: hidden;
    }
    .sponsoredHeader {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      background: var(--pillBg);
      border-bottom: 1px solid var(--pillBorder);
    }
    .sponsoredLabel {
      font-size: 10.5px;
      font-weight: 900;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--brand1);
    }
    .sponsoredTag {
      font-size: 10.5px;
      font-weight: 700;
      color: var(--muted);
      letter-spacing: .05em;
    }
    .sponsoredBody {
      padding: 16px;
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .sponsoredBody:has(.sponsoredImgWrap) {
      grid-template-columns: 120px 1fr;
    }
    .sponsoredImgWrap { width: 120px; flex-shrink: 0; }
    .sponsoredImg {
      display: block;
      width: 120px;
      height: 90px;
      object-fit: cover;
      border-radius: 8px;
    }
    .sponsoredTitle {
      font-size: 17px;
      font-weight: 900;
      color: var(--text);
      line-height: 1.2;
      margin-bottom: 6px;
      letter-spacing: -0.2px;
    }
    .sponsoredDesc {
      font-size: 13.5px;
      color: var(--muted);
      line-height: 1.45;
      margin-bottom: 12px;
    }
    .sponsoredCta {
      display: inline-flex;
      align-items: center;
      height: 36px;
      padding: 0 16px;
      border-radius: 999px;
      background: var(--brand1);
      color: var(--accentText);
      font-size: 13px;
      font-weight: 800;
      text-decoration: none;
      transition: filter 130ms;
    }
    .sponsoredCta:hover { filter: brightness(.92); }

    /* ══ TOPICS GRID ══ */
    .topicsGrid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-top: 14px;
    }
    @media (max-width: 560px) {
      .topicsGrid { grid-template-columns: repeat(2, 1fr); }
    }
    .topicTile {
      position: relative;
      display: block;
      text-decoration: none;
      border-radius: 10px;
      overflow: hidden;
      aspect-ratio: 3/2;
      background: var(--surface2);
      border: 1px solid var(--border);
    }
    .topicImg {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      object-fit: cover; display: block;
      transition: transform 320ms ease;
    }
    .topicTile:hover .topicImg { transform: scale(1.05); }
    .topicGrad {
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,.82) 0%, rgba(0,0,0,.28) 55%, transparent 100%);
    }
    .topicLabel {
      position: absolute;
      bottom: 10px; left: 11px; right: 11px;
      font-size: 13px; font-weight: 900;
      color: #fff; line-height: 1.2;
      text-shadow: 0 1px 6px rgba(0,0,0,.6);
    }

    /* ══ SIDEBAR ══ */
    .homeRail {
      position: sticky;
      top: 80px;
      display: grid;
      gap: 20px;
    }
    .railCard {
      border: 1px solid var(--border);
      background: var(--surface);
      border-radius: 14px;
      padding: 16px;
    }
    .railHead {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 14px;
    }
    .railTitle {
      font-size: 11px;
      font-weight: 900;
      letter-spacing: .13em;
      text-transform: uppercase;
      color: var(--text);
    }
    .railMore {
      font-size: 11.5px; font-weight: 700;
      color: var(--link); text-decoration: none;
    }
    .railMore:hover { text-decoration: underline; }

    /* Events */
    .eventList { display: grid; gap: 8px; }
    .eventRow {
      display: grid;
      grid-template-columns: 44px 1fr;
      gap: 10px; align-items: center;
      text-decoration: none; padding: 8px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--surface2);
      transition: border-color 140ms;
    }
    .eventRow:hover { border-color: var(--pillBorder); }
    .eventCal {
      width: 44px; height: 44px; border-radius: 10px;
      background: var(--pillBg); border: 1px solid var(--pillBorder);
      display: grid; place-items: center;
      text-align: center; line-height: 1;
    }
    .eDow { font-size: 9px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; color: var(--brand1); }
    .eDay { font-size: 17px; font-weight: 900; color: var(--text); margin-top: 1px; }
    .eName { font-weight: 800; font-size: 13px; color: var(--text); line-height: 1.2; }
    .ePlace { font-size: 11.5px; color: var(--faint); margin-top: 2px; }

    /* Display Ad Slot */
    .displayAdSlot {
      display: grid;
      gap: 6px;
    }
    .adSlotLabel {
      font-size: 9.5px;
