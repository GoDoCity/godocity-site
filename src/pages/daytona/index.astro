---
import Base from "../../layouts/Base.astro";
import InteractiveMap from "../../components/InteractiveMap.astro";
import NewsletterBanner from "../../components/NewsletterBanner.astro";
import AdSlot from "../../components/AdSlot.astro";
import SidebarEventsList from "../../components/SidebarEventsList.astro";
import { getCollection } from "astro:content";
import { cityDisplayName, GREATER_DAYTONA, isStrictlyFuture, resolveEngineEventUrl } from "../../lib/events.js";
import { getCityConfig } from "../../lib/cityConfigs.js";
const daytonaConfig = getCityConfig("daytona");

function isDaytonaPost(post) {
  const city = String(post?.data?.city ?? "daytona").toLowerCase().trim();
  if (city === "daytona") return true;
  return typeof post?.id === "string" && post.id.startsWith("daytona/");
}
function isFeatured(post) {
  const v = post?.data?.featured;
  if (v === true) return true;
  if (v === 1) return true;
  return ["true","yes","1"].includes(String(v ?? "").toLowerCase().trim());
}
function getPostDate(post) {
  return post?.data?.pubDate ?? post?.data?.date ?? post?.data?.published ?? post?.data?.updated ?? null;
}
function sortNewestFirst(a, b) {
  return new Date(getPostDate(b) ?? 0).getTime() - new Date(getPostDate(a) ?? 0).getTime();
}
function dateText(post) {
  const d = getPostDate(post);
  return d ? new Date(d).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" }) : "";
}
function authorText(post) {
  const a = post?.data?.author ?? post?.data?.authorName ?? post?.data?.by ?? "";
  return typeof a === "string" && a.trim() ? a.trim() : "Charles King";
}
function byline(post) {
  const d = dateText(post);
  const a = authorText(post);
  return d ? `${d} • ${a}` : a;
}
function heroImage(post) {
  const v = post?.data?.heroImage ?? post?.data?.heroimage ?? post?.data?.image ?? post?.data?.thumbnail ?? post?.data?.cover ?? "";
  return typeof v === "string" ? v.trim() : "";
}
function thumbImage(post) {
  const v = post?.data?.thumbnail ?? post?.data?.heroImage ?? post?.data?.heroimage ?? post?.data?.image ?? post?.data?.cover ?? "";
  return typeof v === "string" ? v.trim() : "";
}
function tagSlugFromRaw(raw) {
  return String(raw ?? "").toLowerCase().trim()
    .replace(/\s*&\s*/g, " ")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
}
function kickerParts(post) {
  const cat = typeof post.data?.category === "string" ? post.data.category.trim() : "";
  const catSlug = cat ? tagSlugFromRaw(cat) : "";
  const catLabel = cat ? cat.toUpperCase() : "";
  const sub = typeof post.data?.subtopic === "string" ? post.data.subtopic.trim() : "";
  return { catLabel, catSlug, sub };
}
function primaryTag(post) {
  const tags = post?.data?.tags;
  if (Array.isArray(tags) && tags.length) return String(tags[0]).trim();
  if (typeof post?.data?.topic === "string") return post.data.topic.trim();
  if (typeof post?.data?.category === "string") return post.data.category.trim();
  return "";
}
function excerpt(post) {
  const v = post?.data?.description ?? post?.data?.excerpt ?? post?.data?.summary ?? post?.data?.intro ?? post?.body ?? "";
  if (typeof v !== "string" || !v.trim()) return "";
  const clean = v.replace(/[#*_`>\[\]]/g, " ").replace(/\s+/g, " ").trim();
  return clean.length > 160 ? clean.slice(0, 157).trimEnd() + "…" : clean;
}

const all = await getCollection("posts");
const posts = all.filter(isDaytonaPost).sort(sortNewestFirst);
const hero = posts.find(isFeatured) ?? posts[0] ?? null;
const feed = hero ? posts.filter((p) => p.slug !== hero.slug) : posts;
const latest = feed.slice(0, 3);
const listFeed = feed.slice(3, 7);  /* ── Latest Feed — exactly 4 rows below the 3-card grid (Rule of 4) ── */

/* ── Live engine events for homepage sidebar ─────────────────────────────────
   Fetches up to 50 upcoming events from the GoDoEVENTS engine at build time.
   Replaces the Google Sheets singleton for the sidebar slider and map pins.   */
function _hpExtractCity(addr: string): string {
  const lc = (addr ?? "").toLowerCase();
  if (lc.includes("ormond beach"))         return "ormond beach";
  if (lc.includes("port orange"))          return "port orange";
  if (lc.includes("daytona beach shores")) return "daytona beach shores";
  if (lc.includes("south daytona"))        return "south daytona";
  if (lc.includes("holly hill"))           return "holly hill";
  if (lc.includes("new smyrna beach"))     return "new smyrna beach";
  if (lc.includes("new smyrna"))           return "new smyrna beach";
  if (lc.includes("flagler beach"))        return "flagler beach";
  if (lc.includes("daytona"))             return "daytona beach";
  return "daytona beach";
}
function _hpHasFeatured(tags: string | null): boolean {
  if (!tags) return false;
  try { const t = JSON.parse(tags); return Array.isArray(t) && t.includes("featured"); } catch { return false; }
}

let allDaytona: any[] = [];
try {
  const _hpToday = new Date();
  _hpToday.setUTCHours(0, 0, 0, 0);
  const _hpRes = await fetch(
    `https://godoevents-engine.yellowcabking.workers.dev/api/events?market=daytona&limit=50&from=${encodeURIComponent(_hpToday.toISOString())}`
  );
  if (_hpRes.ok) {
    const _hpJson: any = await _hpRes.json();
    allDaytona = (_hpJson.events ?? []).map((e: any) => ({
      slug: `daytona/engine-${e.id}`,
      data: {
        title:     e.title      ?? "Untitled Event",
        eventDate: e.start_datetime,
        location:  e.venue_name ?? (e.venue_address?.split(",")[0] ?? ""),
        city:      _hpExtractCity(e.venue_address ?? ""),
        url:       resolveEngineEventUrl(e.event_url) ?? "https://www.daytonabeach.com/events/",
        image:     e.image_url || e.image_medium || null,
        lat:       e.latitude  ?? null,
        lng:       e.longitude ?? null,
        sponsored: _hpHasFeatured(e.partner_tags),
      },
    }));
  }
} catch (err) {
  console.warn("[homepage] Engine fetch failed:", err);
}

/* Pull local Sveltia CMS events and merge them in — normalise featured→sponsored.
   The engine API fetch above only returns third-party aggregated events; local CMS
   events (e.g. "GoDo 4th of July") live in getCollection("events") and must be
   prepended so they surface in the Upcoming Events sidebar slider. */
let _homeCmsEvents: any[] = [];
try {
  const _allLocal = await getCollection("events");
  _homeCmsEvents = (_allLocal as any[])
    .filter((e: any) => {
      const evCity = (e.data.city ?? "").toLowerCase().trim();
      return GREATER_DAYTONA.has(evCity);
    })
    .map((e: any) => ({
      ...e,
      data: { ...e.data, sponsored: e.data.sponsored === true || e.data.featured === true || e.data.isSponsored === true },
    }));
} catch {}

/* CMS-sponsored first → CMS-regular → engine events; title-based dedup.
   isStrictlyFuture drops anything older than yesterday (EST) so the widget
   can never surface stale rows the engine's `from` filter let through. */
const _homeSeenTitles = new Set<string>();
const allDaytonaMerged: any[] = [
  ..._homeCmsEvents.filter((e: any) => e.data.sponsored === true),
  ..._homeCmsEvents.filter((e: any) => !e.data.sponsored),
  ...allDaytona,
].filter((e: any) => {
  if (!isStrictlyFuture(e.data.eventDate, e.data.sponsored === true)) return false;
  const t = (e.data.title ?? "").toLowerCase().trim();
  if (_homeSeenTitles.has(t)) return false;
  _homeSeenTitles.add(t);
  return true;
});

/* Home sidebar events — passed directly to SidebarEventsList (slices to 6 internally) */

/* Map pins — events with valid non-ocean coordinates */
const homePins = allDaytona
  .filter((e: any) => e.data.lat != null && e.data.lng != null && (e.data.lat !== 0 || e.data.lng !== 0))
  .map((e: any) => {
    const d = new Date(e.data.eventDate);
    const dateStr = d.toLocaleDateString("en-US", { month: "short", day: "numeric" });
    return {
      label:        e.data.title,
      address:      `${dateStr} · ${e.data.location ?? ""}`,
      lat:          e.data.lat,
      lng:          e.data.lng,
      image:        e.data.image ?? "/images/daytona-placeholder.jpg",
      url:          e.data.url ?? null,
      isAdvertiser: e.data.sponsored === true,
      // advertiserIcon: e.data.advertiserIcon ?? undefined,
    };
  });

const featuredAd = {
  tag: "Featured Business",
  title: "Your Business Name Here — Reach Daytona Locals",
  description: "This is where your featured story goes. Up to 75 words, written by our team. Drives real traffic from an engaged local audience who already love Daytona.",
  ctaText: "Learn More",
  ctaHref: "/daytona/advertise/",
  img: "",
};

/* ── 3×3 Topics Grid ─────────────────────────────────────────────────────────
   Loads from the Decap 'topics' CMS collection (city=daytona, sorted by order).
   Falls back to the hardcoded 9-tile set when no CMS entries exist yet.
   Row 1: Biz · City · Culture  |  Row 2: Events · Food · History
   Row 3: Real Estate · Sports · Wellness
──────────────────────────────────────────────────────────────────────────── */
// Each entry specifies its own extension so you can freely mix .jpg, .webp, .png, etc.
const _hardcodedTopics = [
  { label: "Business",    slug: "business",     img: "/images/topics/business.jpg" },
  { label: "City",        slug: "city",         img: "/images/topics/city.jpg" },
  { label: "Culture",     slug: "culture",      img: "/images/topics/culture.jpg" },
  { label: "Events",      slug: "events",       img: "/images/topics/events.jpg" },
  { label: "Food",        slug: "food",         img: "/images/topics/food.jpg" },
  { label: "History",     slug: "history",      img: "/images/topics/history.webp" },
  { label: "Real Estate", slug: "real-estate",  img: "/images/topics/real-estate.jpg" },
  { label: "Sports",      slug: "sports",       img: "/images/topics/sports.jpg" },
  { label: "Wellness",    slug: "wellness",     img: "/images/topics/wellness.jpg" },
];

let _cmsTopics: { label: string; slug: string; img: string }[] = [];
try {
  const _topicsRaw = await getCollection("topics");
  const _filtered = _topicsRaw
    .filter((t: any) => (t.data.city ?? "daytona") === "daytona")
    .sort((a: any, b: any) => (a.data.order ?? 0) - (b.data.order ?? 0));
  if (_filtered.length > 0) {
    _cmsTopics = _filtered.map((t: any) => ({
      label: t.data.label,
      slug:  t.data.slug,
      img:   t.data.img || `/images/topics/${t.data.slug}.jpg`,
    }));
  }
} catch {
  /* topics collection not yet populated — use hardcoded fallback */
}

const topics = _cmsTopics.length > 0 ? _cmsTopics : _hardcodedTopics;
/* ── TOPIC IMAGE GUIDE (save to /public/images/topics/) ──────────────
   Each img path in _hardcodedTopics includes its own extension, so you
   can upload any format (.jpg, .webp, .png, .avif) per image.
   To change an image's format, just update the extension in the array above.

   business.jpg    → Local storefronts or Main Street Daytona aerial
   city.jpg        → Drone shot of Daytona Beach coastline at golden hour
   culture.jpg     → Neon lights of a local music venue or bold street mural
   events.jpg      → Packed grandstands at Daytona 500 or Bike Week crowd
   food.jpg        → Close-up burger / plated dish / condensation cocktail
   history.webp    → Historic Daytona boardwalk or vintage B&W race photo
   real-estate.jpg → Modern beachfront balcony or charming historic home
   sports.jpg      → Motion-blur race car or surfer at New Smyrna Beach
   wellness.jpg    → Yoga on the beach, sunrise run, or spa interior
────────────────────────────────────────────────────────────────────── */

/* trendingSpots removed — homepage map now shows Live sheet events only */

/* ── Guides Section (main column) ────────────────────────────────────────────
   Fetch all guides, filter to Daytona, sort newest-first.
   guideHero  = featured: true guide, or most recent
   guideCards = up to 3 non-hero guides for the 3-card row                   */
const featuredJournalists = (await getCollection("journalists"))
  .filter(j => j.data.featured === true)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const allGuides = await getCollection("guides");
const daytonaGuides = allGuides
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
function guideSlug(g: (typeof allGuides)[number]) {
  return g.slug.split("/").pop()!;
}
const guideHero = daytonaGuides.find((g) => g.data.featured) ?? daytonaGuides[0] ?? null;
const guideCards = guideHero
  ? daytonaGuides.filter((g) => g !== guideHero).slice(0, 3)
  : daytonaGuides.slice(0, 3);
---

<Base title="GoDoDay" subtitle="Good News Daytona" cityBase="daytona">
  <NewsletterBanner
    city="Daytona"
    vibeCheckText={daytonaConfig?.vibeCheckText}
    accentColor={daytonaConfig?.accentColor}
  />
  <script is:inline>
  (function(){
    function bleedFix() {
      function makeBleed(el) {
        if (!el) return;
        el.style.marginLeft = '';
        el.style.width = '';
        var rect = el.getBoundingClientRect();
        var leftOffset = rect.left;
        var rightGap = window.innerWidth - rect.right;
        if (leftOffset > 0 || rightGap > 0) {
          el.style.marginLeft = '-' + leftOffset + 'px';
          el.style.width = 'calc(100% + ' + (leftOffset + rightGap) + 'px)';
        }
      }
      makeBleed(document.getElementById('adBand'));
      makeBleed(document.getElementById('alertBarLine'));
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bleedFix);
    } else {
      bleedFix();
    }
    window.addEventListener('resize', bleedFix);
  })();
  </script>

  <div class="pageWrap">
    <div class="alertBarLine" id="alertBarLine"></div>

    <div class="container">
      <div class="homeGrid">

        <main class="homeMain">

          {/* ── HERO — cinematic wide crop, anchored to sidebar height ── */}
          {hero && (
            <a class="heroCard" href={`/daytona/posts/${hero.slug.split('/').pop()}/`}>
              <div class="heroImgWrap">
                {heroImage(hero)
                  ? <img class="heroImg" src={heroImage(hero)} alt={hero.data.title ?? ""} loading="eager" decoding="async" />
                  : <div class="heroImg heroFallback" aria-hidden="true" />
                }
              </div>
              <div class="heroCopy">
                {(() => { const { catLabel, sub } = kickerParts(hero); const label = catLabel || primaryTag(hero).toUpperCase(); return label && <div class="heroKicker">{label}{sub ? ` — ${sub}` : ""}</div>; })()}
                <h2 class="heroTitle">{hero.data.title ?? hero.slug}</h2>
                {excerpt(hero) && <p class="heroDesc">{excerpt(hero)}</p>}
                <div class="heroMeta">
                  {dateText(hero)}<span class="metaAuthor"> • {authorText(hero)}</span>
                </div>
              </div>
            </a>
          )}

          <div class="feedDivider"></div>

          {/* ── 3 CARDS SIDE BY SIDE ── */}
          <div class="cardGrid">
            {latest.map((p) => (
              <a class="articleCard" href={`/daytona/posts/${p.slug.split('/').pop()}/`}>
                <div class="cardImgWrap">
                  {heroImage(p)
                    ? <img class="cardImg" src={heroImage(p)} alt="" loading="lazy" decoding="async" />
                    : <div class="cardImg cardImgFallback" aria-hidden="true" />
                  }
                </div>
                <div class="cardBody">
                  {(() => { const { catLabel, sub } = kickerParts(p); const label = catLabel || primaryTag(p).toUpperCase(); return label && <div class="cardKicker">{label}{sub ? ` — ${sub}` : ""}</div>; })()}
                  <div class="cardTitle">{p.data.title ?? p.slug}</div>
                  {excerpt(p) && <div class="cardDesc">{excerpt(p)}</div>}
                  <div class="cardMeta">
                    {dateText(p)}<span class="metaAuthor"> • {authorText(p)}</span>
                  </div>
                </div>
              </a>
            ))}
          </div>

          {/* ── TRENDING NOW MAP ── */}
          <div class="masterMapBlock">
            <div class="masterMapHead">
              <span class="masterMapTitle">Go Do Daytona: Live Events</span>
              <span class="masterMapSub">{homePins.length} event{homePins.length !== 1 ? "s" : ""} on the map</span>
            </div>
            <InteractiveMap locations={homePins} height="450px" center={[29.2108, -81.0228]} />
          </div>

          {/* ── FEATURED AD — "FEATURED" label, never "Sponsored" ── */}
          <div class="featuredCard">
            <div class="featuredHeader">
              <span class="featuredStar">★</span>
              <span class="featuredLabel">FEATURED</span>
              <span class="featuredTag">{featuredAd.tag}</span>
            </div>
            <div class="featuredBody">
              {featuredAd.img && (
                <img class="featuredImg" src={featuredAd.img} alt="" loading="lazy" />
              )}
              <div class="featuredText">
                <div class="featuredTitle">{featuredAd.title}</div>
                <div class="featuredDesc">{featuredAd.description}</div>
                <a class="featuredCta" href={featuredAd.ctaHref}>{featuredAd.ctaText} →</a>
              </div>
            </div>
          </div>

          {/* ── LATEST FEED — flat horizontal rows, Nooga style ── */}
          {listFeed.length > 0 && (
            <section class="latestFeed" aria-label="Latest stories">
              <div class="latestHead">
                <span class="latestLabel">Latest</span>
                <a class="latestMore" href="/daytona/posts/">View all →</a>
              </div>

              {listFeed.map((p, idx) => {
                const { catLabel, sub } = kickerParts(p);
                const kickerLabel = catLabel || primaryTag(p).toUpperCase();
                return (
                  <>
                    <a class="latestRow" href={`/daytona/posts/${p.slug.split('/').pop()}/`}>
                      <div class="latestThumbWrap">
                        {thumbImage(p)
                          ? <img class="latestThumb" src={thumbImage(p)} alt="" loading="lazy" decoding="async" />
                          : <div class="latestThumb latestThumbFallback" aria-hidden="true" />
                        }
                      </div>
                      <div class="latestText">
                        {kickerLabel && (
                          <div class="latestKicker">
                            {kickerLabel}{sub ? ` — ${sub}` : ""}
                          </div>
                        )}
                        <div class="latestTitle">{p.data.title ?? p.slug}</div>
                        <div class="latestByline">{byline(p)}</div>
                      </div>
                    </a>
                    {(idx + 1) % 4 === 0 && <AdSlot type="in-feed" city="daytona" />}
                  </>
                );
              })}
            </section>
          )}

          <div class="viewAllRow">
            <a class="viewAllBtn" href="/daytona/posts/">View all stories →</a>
          </div>

          {/* ── TOPICS ── */}
          <div class="topicsHead">
            <span class="topicsLabel">Topics</span>
          </div>
          <div class="topicsGrid">
            {topics.map((t) => (
              <a class="topicTile" href={t.slug === "events" ? `/daytona/events/` : `/daytona/${t.slug}/`}>
                <div class="topicBg" style={`background-image: url('${t.img}')`} aria-hidden="true" />
                <div class="topicGrad" aria-hidden="true" />
                <span class="topicLabel">{t.label}</span>
              </a>
            ))}
          </div>

          {/* ── GUIDES — 1 hero + 3 cards, matches Top Stories layout ── */}
          <div class="guidesHead">
            <span class="topicsLabel">Daytona's Guide</span>
            <a class="guidesMoreLink" href="/daytona/guides/">More Guides →</a>
          </div>

          {guideHero && (
            <a class="heroCard guideHeroCard" href={`/daytona/guides/${guideSlug(guideHero)}/`}>
              <div class="heroImgWrap">
                {guideHero.data.image
                  ? <img class="heroImg" src={guideHero.data.image} alt={guideHero.data.title ?? ""} loading="lazy" decoding="async" />
                  : <div class="heroImg heroFallback" aria-hidden="true" />
                }
              </div>
              <div class="heroCopy">
                <div class="heroKicker">GUIDE — {guideHero.data.topic?.toUpperCase()}</div>
                <h2 class="heroTitle">{guideHero.data.title}</h2>
                {guideHero.data.description && <p class="heroDesc">{guideHero.data.description}</p>}
              </div>
            </a>
          )}

          {guideHero && <hr class="guideDivider" />}

          {guideCards.length > 0 && (
            <div class="cardGrid guideGrid">
              {guideCards.map((g) => (
                <a class="articleCard" href={`/daytona/guides/${guideSlug(g)}/`}>
                  <div class="cardImgWrap">
                    {g.data.image
                      ? <img class="cardImg" src={g.data.image} alt="" loading="lazy" decoding="async" />
                      : <div class="cardImg cardImgFallback" aria-hidden="true" />
                    }
                  </div>
                  <div class="cardBody">
                    <div class="cardKicker">GUIDE — {g.data.topic?.toUpperCase()}</div>
                    <div class="cardTitle">{g.data.title}</div>
                    {g.data.description && <div class="cardDesc">{g.data.description}</div>}
                  </div>
                </a>
              ))}
            </div>
          )}

          <div class="guidesMoreRow">
            <a class="viewAllBtn" href="/daytona/guides/">More Guides →</a>
          </div>

        </main>

        {/* ── SIDEBAR — aligns top with hero, borderless ── */}
        <aside class="homeRail">

          {/* ── EDITORIAL TEAM — dynamically pulled from journalists CMS ── */}
          {featuredJournalists.length > 0 && (
            <div class="editTeamSection">
              <div class="railHead">
                <span class="railTitle editTeamTitle">GoDoCity Editorial Team</span>
              </div>
              {featuredJournalists.map(j => {
                const initials = j.data.name.split(" ")
                  .filter((w: string) => w.length > 1)
                  .map((w: string) => w[0])
                  .join("").slice(0, 2).toUpperCase();
                return (
                  <div class="editTeamRow">
                    <a class="editPhotoLink" href={`/journalists/${j.slug}/`} aria-label={`Profile: ${j.data.name}`}>
                      {j.data.photo
                        ? <img
                            class="editHeadshot"
                            src={j.data.photo}
                            alt={j.data.name}
                            width="80" height="80"
                            loading="eager"
                            onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                          />
                        : null
                      }
                      <div class="editHeadshotFallback" aria-hidden="true">{initials}</div>
                    </a>
                    <div class="editTeamInfo">
                      <a class="editName editNameLink" href={`/journalists/${j.slug}/`}>{j.data.name}</a>
                      <div class="editTitle">{j.data.role}</div>
                    </div>
                  </div>
                );
              })}
            </div>
          )}

          <div class="railSection">
            <div class="railHead">
              <span class="railTitle">Upcoming Events</span>
              <a class="railMore" href="/daytona/events/">See all</a>
            </div>

            <SidebarEventsList events={allDaytonaMerged} city="daytona" />
          </div>

          <div class="displayAdSlot">
            <div class="adSlotLabel">Advertisement</div>
            <a class="displayAdCard" href="/daytona/advertise/">
              <div class="displayAdInner">
                <div class="displayAdIcon">📢</div>
                <div class="displayAdTitle">Your Ad Here</div>
                <div class="displayAdDesc">Reach thousands of Daytona locals</div>
                <div class="displayAdCta">Advertise with us →</div>
              </div>
            </a>
          </div>

        </aside>
      </div>

    </div>{/* end .container */}

    {/* ── ADVERTISE BAND — outside container so it can go full-width ── */}
    <div class="adBand" id="adBand">
      <div class="adBandInner">
        <div class="adCopy">
          <div class="adEyebrow">Grow your business</div>
          <div class="adHead">Advertise with GoDo Daytona.</div>
          <div class="ad-description">Reach thousands of engaged Daytona locals every day. Featured stories, display ads, event promotion, and newsletter placements — built for local businesses that want real results.</div>
          <div class="adActions">
