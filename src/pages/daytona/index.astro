  <script is:inline>
    /* ── Community Pulse poll interaction ── */
    (function () {
      var form = document.querySelector(".cpPollForm");
      var thanks = document.querySelector(".cpThanks");
      var btn = document.querySelector(".cpVoteBtn");
      if (!form || !thanks || !btn) return;

      form.addEventListener("submit", function (e) {
        var checked = form.querySelector('input[type="radio"]:checked');
        if (!checked) {
          e.preventDefault();
          btn.animate(
            [{ transform: "translateX(-4px)" }, { transform: "translateX(4px)" }, { transform: "none" }],
            { duration: 180, iterations: 2 }
          );
          return;
        }
        // Show bars + percentages immediately, then thank-you message
        form.querySelectorAll(".cpBar").forEach(function (b) { b.style.display = "block"; });
        form.querySelectorAll(".cpPct").forEach(function (p) { p.style.display = "block"; });
        setTimeout(function () {
          form.style.display = "none";
          thanks.hidden = false;
        }, 80);
      });
    })();
  </script>
