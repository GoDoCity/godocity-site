---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

/** Daytona filter */
function isDaytonaPost(post) {
  const city = String(post?.data?.city ?? "daytona").toLowerCase().trim();
  if (city === "daytona") return true;
  return typeof post?.id === "string" && post.id.startsWith("daytona/");
}

/** Featured flag */
function isFeatured(post) {
  const v = post?.data?.featured;
  if (v === true) return true;
  if (v === 1) return true;
  const s = String(v ?? "").toLowerCase().trim();
  return s === "true" || s === "yes" || s === "1";
}

/** Dates */
function getPostDate(post) {
  return (
    post?.data?.pubDate ??
    post?.data?.date ??
    post?.data?.published ??
    post?.data?.updated ??
    null
  );
}

function sortNewestFirst(a, b) {
  const da = new Date(getPostDate(a) ?? 0).getTime();
  const db = new Date(getPostDate(b) ?? 0).getTime();
  return db - da;
}

function dateText(post) {
  const d = getPostDate(post);
  return d ? new Date(d).toLocaleDateString("en-US") : "";
}

function excerpt(post) {
  return post?.data?.description ?? "";
}

/**
 * IMPORTANT: keep thumbnails working exactly as-is
 * (do not use .src, this is a STRING path)
 */
function heroImage(post) {
  const v =
    post?.data?.heroImage ??
    post?.data?.heroimage ??
    post?.data?.image ??
    post?.data?.thumbnail ??
    post?.data?.cover ??
    "";
  return typeof v === "string" ? v.trim() : "";
}

/** Data (keep logic stable) */
const all = await getCollection("posts");
const posts = all.filter(isDaytonaPost).sort(sortNewestFirst);

const hero = posts.find(isFeatured) ?? posts[0] ?? null;
const feed = hero ? posts.filter((p) => p.slug !== hero.slug) : posts;

// Split for “Featured + Latest” feel (no logic change to content source; just presentation)
const latest = feed.slice(0, 8);
---

<Base title="GoDo Daytona" subtitle="Good news for Daytona" cityBase="daytona">
  <section class="section">
    <div class="container homeWrap">

     {/* Newsletter / Email Signup (Nooga-style) */}
     <div class="newsletterBand">
  <div class="newsletterInner">

    <!-- LEFT IMAGE (city-specific) -->
    <div class="nlArt" aria-hidden="true">
      <img
        class="nlArtImg"
        src={`/images/cities/${Astro.props.cityBase ?? "daytona"}/newsletter.png`}
        alt=""
        loading="lazy"
        decoding="async"
        onerror="this.onerror=null;this.src='/images/cities/default/newsletter.png';"
      />
    </div>

    <!-- RIGHT CONTENT -->
    <div class="nlContent">
      <div class="newsletterCopy">
        <div class="nlHeadline">Good News Daytona</div>
        <div class="nlSubhead">Daytona Pulse: your FREE local insider.</div>
      </div>

      <form class="nlForm" action="/daytona/subscribe/" method="get">
        <input class="nlInput" type="email" name="email" placeholder="Enter your email address" />
        <button class="nlButton" type="submit">SIGN UP, IT’S FREE!</button>
      </form>

      <div class="nlFine">Sent straight to your inbox, 100% FREE! Unsubscribe anytime.</div>
    </div>

  </div>
</div>

      <div class="homeGrid">

        <div class="homeMain">

          {hero && (
            <a class="heroFeature" href={`/daytona/posts/${hero.slug}/`}>
              <div class="heroMedia">
                {heroImage(hero) ? (
                  <img class="heroImg" src={heroImage(hero)} alt={hero.data.title ?? "Hero image"} loading="lazy" decoding="async" />
                ) : (
                  <div class="heroImg heroImgFallback" aria-hidden="true"></div>
                )}
              </div>

              <div class="heroCopy">
                <div class="heroTitle">{hero.data.title ?? hero.slug}</div>
                {excerpt(hero) && <div class="heroDesc">{excerpt(hero)}</div>}
                <div class="heroMeta">{dateText(hero)}</div>
              </div>
            </a>
          )}

          <div class="sectionHeader">
            <div class="sectionTitle">Explore</div>
          </div>

          <div class="catGrid">
            <a class="catCard" href="/daytona/topics/">
              <div class="catTitle">Topics</div>
              <div class="catDesc">Browse what Daytona is talking about.</div>
            </a>
            <a class="catCard" href="/daytona/guides/">
              <div class="catTitle">City Guides</div>
              <div class="catDesc">Curated guides for locals and visitors.</div>
            </a>
            <a class="catCard" href="/daytona/events/">
              <div class="catTitle">Events</div>
              <div class="catDesc">What’s happening this week.</div>
            </a>
          </div>

          <div class="feedHeader">
            <div class="sectionTitle">Latest</div>
            <a class="viewAllLink" href="/daytona/posts/">View all</a>
          </div>

          <div class="latestGrid" role="list">
            {latest.map((p) => (
              <a class="latestCard" role="listitem" href={`/daytona/posts/${p.slug}/`}>
                <div class="latestMedia">
                  {heroImage(p) ? (
                    <img class="latestImg" src={heroImage(p)} alt={p.data.title ?? "Thumbnail"} loading="lazy" decoding="async" />
                  ) : (
                    <div class="latestImg latestImgFallback" aria-hidden="true"></div>
                  )}
                </div>

                <div class="latestBody">
                  <div class="latestTitle">{p.data.title ?? p.slug}</div>
                  {excerpt(p) && <div class="latestDesc">{excerpt(p)}</div>}
                  <div class="latestMeta">{dateText(p)}</div>
                </div>
              </a>
            ))}
          </div>

        </div>

        <aside class="homeRail">
          <div class="moduleCard eventsCard">
            <div class="moduleHead">
              <div class="moduleTitle">Upcoming Events</div>
              <a class="viewAllLink viewAllLinkSmall" href="/daytona/events/">See all</a>
            </div>

            <div class="eventsList">
              <div class="eventRow">
                <div class="eventDate">
                  <div class="eventDow">SAT</div>
                  <div class="eventDay">15</div>
                </div>
                <div class="eventInfo">
                  <div class="eventName">Add your first event</div>
                  <div class="eventPlace">Daytona Beach</div>
                </div>
              </div>

              <div class="eventRow">
                <div class="eventDate">
                  <div class="eventDow">SUN</div>
                  <div class="eventDay">16</div>
                </div>
                <div class="eventInfo">
                  <div class="eventName">Second event placeholder</div>
                  <div class="eventPlace">Ormond Beach</div>
                </div>
              </div>
            </div>

            <div class="railDivider"></div>

            <div class="railLinks">
              <div class="moduleTitle moduleTitleSmall">Resources</div>
              <a class="railLink" href="/daytona/advertise/">Advertise</a>
              <a class="railLink" href="/daytona/topics/">Topics</a>
              <a class="railLink" href="/daytona/events/">Events</a>
            </div>
          </div>
        </aside>

      </div>

      <div class="promoBand">
        <div class="promoCopy">
          <div class="promoTitle">Advertise with us.</div>
          <div class="promoDesc">Reach locals with sponsored stories, display placements, and event promotion.</div>
        </div>
        <div class="promoActions">
          <a class="btn" href="/daytona/advertise/">Branded Content + Display</a>
          <a class="btn btnGhost" href="/daytona/advertise/">Events</a>
        </div>
      </div>

    </div>
  </section>

  <style>
    :global(.container) {
      max-width: 1240px;
      padding-left: clamp(14px, 2vw, 22px);
      padding-right: clamp(14px, 2vw, 22px);
    }
    @media (min-width: 1400px) {
      :global(.container) { max-width: 1280px; }
    }

    .homeWrap {
      --maxMain: 860px;
      --rail: 320px;
      --gridGap: clamp(18px, 2vw, 26px);

      /* “~4.3cm inset feel” translated to responsive padding */
      --inset: clamp(18px, 3.4vw, 52px);

      /* tiny rail nudge so events aligns with newsletter inset edge */
      --railNudge: 19px;

      --cardRadius: 16px;
      --cardRadiusSm: 14px;
      --cardBorder: rgba(255,255,255,.10);
      --cardBorderSoft: rgba(255,255,255,.08);
      --cardBg: rgba(255,255,255,.03);

      --shadowSoft: 0 8px 18px rgba(0,0,0,.22);

      --t1: #e8edf4;
      --t2: rgba(232,237,244,.86);
      --t3: rgba(232,237,244,.70);
      --t4: rgba(232,237,244,.58);

      --yellow: #ffd24a;
      --yellowDeep: #ffc400;

      --glow: 0 0 0 1px rgba(255,210,74,.18), 0 10px 26px rgba(0,0,0,.30);
      --glowSoft: 0 0 0 1px rgba(255,210,74,.22), 0 18px 44px rgba(0,0,0,.45);
    }

   /* Newsletter band */
.newsletterBand {
  border: 1px solid rgba(255,210,74,.68);
  background:
    radial-gradient(900px 420px at 18% 0%, rgba(255,210,74,.34), rgba(255,210,74,0) 62%),
    rgba(255,210,74,.22);
  box-shadow: var(--glowSoft);
  border-radius: var(--cardRadius);
  overflow: hidden;
  margin: 10px 0 18px;
}

/* Layout: image left, content right */
.newsletterInner{
  padding: clamp(16px, 2vw, 22px) var(--inset);
  display: grid;
  grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
  gap: clamp(14px, 2vw, 22px);
  align-items: center;
}

.nlArt{
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.nlArtImg{
  width: 100%;
  max-width: 280px;
  height: auto;
  display: block;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,.10);
  box-shadow: 0 10px 26px rgba(0,0,0,.25);
}

.nlContent{
  min-width: 0;
  display: grid;
  gap: 10px;
  align-content: center;
  justify-items: start;
}

.nlHeadline {
  color: rgba(232,237,244,.96);
  font-weight: 950;
  letter-spacing: -0.3px;
  font-size: clamp(22px, 2.2vw, 28px);
  line-height: 1.05;
}

.nlSubhead {
  margin-top: 6px;
  color: rgba(232,237,244,.90);
  font-size: 15.5px;
  line-height: 1.35;
  font-weight: 700;
}

.nlForm {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10px;
  width: 100%;
  min-width: 0;
  margin-top: 6px;
}

.nlInput {
  width: 100%;
  height: 44px;
  max-width: 380px;
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,.20);
  background: rgba(11,13,16,.78);
  color: rgba(232,237,244,.96);
  padding: 0 14px;
  outline: none;
  box-shadow: inset 0 0 0 1px rgba(255,255,255,.06);
}
.nlInput::placeholder { color: rgba(232,237,244,.70); }
.nlInput:focus {
  border-color: rgba(255,210,74,.84);
  box-shadow: 0 0 0 4px rgba(255,210,74,.22);
}

.nlButton {
  height: 44px;
  border-radius: 12px;
  border: 1px solid rgba(0,0,0,.55);
  background: linear-gradient(180deg, var(--brand1), var(--brand2));
  color: var(--accentText);
  font-weight: 950;
  letter-spacing: .02em;
  cursor: pointer;
  box-shadow: 0 14px 22px rgba(0,0,0,.22);
  padding: 0 16px;
  width: 100%;
  white-space: nowrap;
}

.nlFine {
  color: rgba(232,237,244,.74);
  font-size: 13.5px;
  line-height: 1.35;
  margin-top: 2px;
}

/* Desktop: input + button in one row */
@media (min-width: 900px) {
  .nlForm {
    grid-template-columns: minmax(260px, 380px) auto;
    align-items: center;
  }
  .nlInput { max-width: none; }
  .nlButton { width: auto; }
}

/* Mobile: stack + center + prevent overflow */
@media (max-width: 720px){
  .newsletterInner{
    grid-template-columns: 1fr;
    gap: 12px;
    padding: 16px 14px;
    text-align: center;
  }

  .nlContent{
    justify-items: center;
  }

  .nlArtImg{
    max-width: 240px;
    margin: 0 auto;
  }

  .nlForm{
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
  }

  .nlInput,
  .nlButton{
    width: 100%;
  }
}

    .homeGrid {
      display: grid;
      grid-template-columns: minmax(0, var(--maxMain)) minmax(0, var(--rail));
      gap: var(--gridGap);
      align-items: start;
      padding: 0 var(--inset);
    }

    .homeRail {
      padding: 0;
      margin: 0;
      transform: translateX(var(--railNudge));
    }

    @media (max-width: 980px) {
      .homeGrid { grid-template-columns: 1fr; padding: 0; }
      .homeRail { order: 2; transform: none; }
    }

    .heroFeature {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      text-decoration: none;
      border: 1px solid var(--cardBorder);
      background: var(--cardBg);
      border-radius: var(--cardRadius);
      overflow: hidden;
      box-shadow: var(--shadowSoft);
      margin-bottom: 16px;
    }
    @media (max-width: 740px) { .heroFeature { grid-template-columns: 1fr; } }
    .heroMedia { background: rgba(255,255,255,.02); }
    .heroImg { width: 100%; height: 100%; min-height: 220px; display: block; object-fit: cover; }
    .heroImgFallback { min-height: 220px; }
    .heroCopy { padding: 16px 16px 14px; }
    .heroTitle { font-size: 26px; line-height: 1.1; font-weight: 950; color: var(--t1); letter-spacing: -0.2px; }
    .heroDesc {
      margin-top: 10px;
      color: var(--t2);
      line-height: 1.35;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .heroMeta { margin-top: 12px; color: var(--t4); font-size: 13px; }

    .sectionHeader { margin: 6px 0 10px; }
    .sectionTitle { font-weight: 950; font-size: 14px; color: var(--t3); text-transform: uppercase; letter-spacing: .12em; }
    .feedHeader { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin: 16px 0 10px; }
    .viewAllLink { color: rgba(255,210,74,.92); font-weight: 800; font-size: 13px; text-decoration: none; opacity: .95; }
    .viewAllLink:hover { opacity: 1; text-decoration: underline; }
    .viewAllLinkSmall { font-size: 12px; }

    .catGrid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 12px; margin-bottom: 8px; }
    @media (max-width: 740px) { .catGrid { grid-template-columns: 1fr; } }
    .catCard {
      text-decoration: none;
      border: 1px solid var(--cardBorderSoft);
      background: var(--cardBg);
      border-radius: var(--cardRadius);
      padding: 14px 14px 13px;
      box-shadow: var(--shadowSoft);
    }
    .catTitle { font-weight: 950; font-size: 16px; color: var(--t1); }
    .catDesc { margin-top: 6px; color: var(--t4); line-height: 1.25; font-size: 13px; }

   /* =========================
   LATEST — Nooga-style list
   ========================= */

.latestGrid{
  display: grid !important;
  grid-template-columns: 1fr !important;
  gap: 0 !important;
  border-top: 1px solid rgba(255,255,255,.10);
}

/* Row item */
.latestCard{
  display: grid;
  grid-template-columns: 96px 1fr;   /* thumbnail LEFT */
  gap: 14px;
  align-items: start;

  padding: 16px 0;
  text-decoration: none;

  border: 0;
  border-bottom: 1px solid rgba(255,255,255,.10);
  background: transparent;
  border-radius: 0;
  box-shadow: none;
  transform: none;
}

.latestCard:hover{
  background: rgba(255,255,255,.02);
}

/* Right-side thumbnail */
.latestMedia{
  width: 96px;
  height: 72px;
  min-height: 0;
  aspect-ratio: auto;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.12);
  background: rgba(255,255,255,.03);
}

.latestImg{
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Left-side text block */
.latestBody{
  padding: 0;
  min-width: 0;
  display: grid;
  align-content: start;
}

/* Title + description scale like Nooga */
.latestTitle{
  font-weight: 950;
  font-size: 20px;
  line-height: 1.12;
  letter-spacing: -0.2px;
  color: var(--t1);

  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.latestDesc{
  margin-top: 8px;
  color: var(--t3);
  font-size: 14.5px;
  line-height: 1.35;

  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.latestMeta{
  margin-top: 10px;
  color: var(--t4);
  font-size: 13px;
}

/* Make the thumbnail a little smaller on very small phones */
@media (max-width: 420px){
  .latestCard{ grid-template-columns: 84px 1fr; }
  .latestMedia{ width: 84px; height: 64px; }
}
  .latestTitle{ font-size: 19px; }
}
    .moduleCard { border: 1px solid var(--cardBorder); background: var(--cardBg); border-radius: var(--cardRadius); padding: 14px; box-shadow: var(--shadowSoft); }
    .moduleHead { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; margin-bottom: 10px; }
    .moduleTitle { font-weight: 950; color: var(--t1); letter-spacing: -0.1px; }
    .moduleTitleSmall { font-size: 13px; margin-bottom: 8px; opacity: .9; }

    .eventsList { display: grid; gap: 10px; }
    .eventRow { display: grid; grid-template-columns: 44px 1fr; gap: 10px; align-items: center; padding: 10px 10px; border-radius: 14px; border: 1px solid rgba(255,255,255,.08); background: rgba(255,255,255,.02); }
    .eventDate { width: 44px; height: 44px; border-radius: 12px; border: 1px solid rgba(255,255,255,.10); background: rgba(0,0,0,.18); display: grid; place-items: center; line-height: 1.05; }
    .eventDow { font-size: 11px; color: var(--t4); font-weight: 900; letter-spacing: .08em; }
    .eventDay { font-size: 16px; color: var(--t1); font-weight: 950; margin-top: 2px; }
    .eventName { font-weight: 900; color: var(--t1); line-height: 1.15; }
    .eventPlace { margin-top: 4px; color: var(--t4); font-size: 12.5px; }

    .railDivider { height: 1px; background: rgba(255,255,255,.08); margin: 14px 0 12px; }
    .railLinks { display: grid; gap: 8px; }
    .railLink { color: rgba(232,237,244,.78); text-decoration: none; font-size: 13px; }
    .railLink:hover { color: rgba(255,210,74,.92); }

    .promoBand { margin: 18px 0 0; border: 1px solid var(--cardBorder); background: linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.02)); border-radius: var(--cardRadius); padding: 16px; display: flex; justify-content: space-between; gap: 14px; align-items: center; box-shadow: var(--shadowSoft); flex-wrap: wrap; }
    .promoTitle { font-weight: 950; font-size: 18px; color: var(--t1); }
    .promoDesc { margin-top: 6px; color: var(--t3); line-height: 1.3; }
    .promoActions { display: flex; gap: 10px; flex-wrap: wrap; }
    .btn { display: inline-flex; align-items: center; justify-content: center; height: 40px; padding: 0 12px; border-radius: 12px; border: 1px solid rgba(255,210,74,.38); background: rgba(255,210,74,.14); color: var(--t1); font-weight: 900; text-decoration: none; }
    .btn:hover { background: rgba(255,210,74,.18); }
    .btnGhost { border-color: rgba(255,255,255,.14); background: rgba(255,255,255,.03); }
    .btnGhost:hover { background: rgba(255,255,255,.05); }
  </style>
</Base>
