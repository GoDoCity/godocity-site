---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";

/** Daytona filter */
function isDaytonaPost(post) {
  const city = String(post?.data?.city ?? "daytona").toLowerCase().trim();
  if (city === "daytona") return true;
  return typeof post?.id === "string" && post.id.startsWith("daytona/");
}

/** Tag normalization */
function tagKey(raw) {
  return String(raw ?? "")
    .toLowerCase()
    .trim()
    .replace(/[-_]+/g, " ")
    .replace(/\s+/g, " ");
}

function tagSlugFromKey(key) {
  return String(key ?? "")
    .toLowerCase()
    .trim()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
}

function tagLabelFromKey(key) {
  const s = String(key ?? "").trim().replace(/\s+/g, " ");
  if (!s) return "";
  return s
    .split(" ")
    .filter(Boolean)
    .map((w) => (w ? w.charAt(0).toUpperCase() + w.slice(1) : ""))
    .join(" ");
}

const all = await getCollection("posts");
const daytona = all.filter(isDaytonaPost);

const counts = new Map();
for (const p of daytona) {
  const tags = Array.isArray(p?.data?.tags) ? p.data.tags : [];
  for (const t of tags) {
    const k = tagKey(t);
    if (!k) continue;
    counts.set(k, (counts.get(k) ?? 0) + 1);
  }
}

const topics = Array.from(counts.entries())
  .map(([key, count]) => ({
    key,
    count,
    slug: tagSlugFromKey(key),
    label: tagLabelFromKey(key),
  }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));
---

<Base title="Topics | GoDo Daytona" subtitle="Browse topics" cityBase="daytona" />

<section class="section">
  <div class="container" style="max-width: 780px;">
    <h1 class="h1">Topics</h1>
    <p style="opacity:.7;margin-top:6px;">{topics.length} total</p>

    <div class="grid">
      {topics.map((t) => (
        <!-- Decision #3: topic detail route is singular -->
        <a class="topicCard" href={`/daytona/topic/${t.slug}/`}>
          <div class="topicName">{t.label}</div>
          <div class="topicCount">{t.count} post{t.count === 1 ? "" : "s"}</div>
        </a>
      ))}
    </div>

    <p style="margin-top:18px;display:flex;gap:10px;flex-wrap:wrap;">
      <a class="pill" href="/daytona/posts/">← Latest posts</a>
    </p>
  </div>
</section>

<style>
  .grid {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr; }
  }

  .topicCard {
    text-decoration: none;
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.03);
    border-radius: 14px;
    padding: 14px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .topicCard:hover { background: rgba(255,255,255,.04); }

  .topicName { font-weight: 900; font-size: 16px; line-height: 1.2; }
  .topicCount { opacity: .7; font-size: 13px; }
</style>
