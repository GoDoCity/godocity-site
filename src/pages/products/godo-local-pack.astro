---
import Base from "../../layouts/Base.astro";
---

<Base
  title="The GoDo Local Pack | $450/month Bundle | GoDoDaytona"
  subtitle="1 GoDo VIP Headliner + 2 Newsletter Mentions — full-funnel coverage of the Daytona events audience at one bundled rate."
  cityBase="daytona"
>

  <!-- ═══════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════ -->
  <section class="glpHero">
    <div class="glpHeroOverlay" aria-hidden="true"></div>
    <div class="glpHeroInner">
      <a href="/daytona/advertise" class="glpBack">← Media Kit</a>
      <span class="glpEyebrow">GoDo Studio · Best Value Bundle</span>
      <h1 class="glpTitle">The GoDo Local Pack</h1>
      <p class="glpSub">Full-funnel event promotion — one GoDo VIP Headliner placement plus two dedicated newsletter mentions, bundled into a single monthly package that saves you $225.</p>
      <div class="glpHeroCtas">
        <a href="#buy" class="glpBtnPrimary">Buy This Package →</a>
        <a href="#whats-included" class="glpBtnGhost">See What's Included ↓</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       PRICING BADGE
  ═══════════════════════════════════════════ -->
  <div class="glpPricingBar">
    <div class="glpPricingBarInner">
      <div class="glpPriceBlock">
        <span class="glpPriceLabel">Bundle Price</span>
        <span class="glpPriceMain">$450</span>
        <span class="glpPriceUnit">/ month</span>
      </div>
      <div class="glpPriceSavings">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M7 1l1.5 3.5 3.8.3-2.8 2.5.9 3.7L7 9.3l-3.4 1.7.9-3.7L1.7 4.8l3.8-.3L7 1z" fill="#34d399"/>
        </svg>
        Save $225 vs. buying separately · $675 combined value
      </div>
    </div>
  </div>

  <div class="glpBody">

    <!-- ═══════════════════════════════════════════
         WHAT'S INCLUDED
    ═══════════════════════════════════════════ -->
    <section class="glpSection" id="whats-included">
      <div class="glpWrap">
        <div class="glpSectionHead">
          <span class="glpSectionEyebrow">Package Breakdown</span>
          <h2 class="glpSectionTitle">What's Included</h2>
          <p class="glpSectionSub">Two proven placements. One audience. Every week of the month.</p>
        </div>

        <div class="glpLineItems">

          <!-- Line Item 1: GoDo VIP Headliner -->
          <div class="glpLineItem glpLineItem--vip">
            <div class="glpLineItemHeader">
              <div class="glpLineItemNum">01</div>
              <div class="glpLineItemMeta">
                <span class="glpLineItemBadge glpLineItemBadge--vip">★ VIP · Only 3 Slots</span>
                <h3 class="glpLineItemName">GoDo VIP Headliner</h3>
                <p class="glpLineItemWhere">Events Hub · GoDo Picks — Above The Fold, Every Visit</p>
              </div>
              <div class="glpLineItemPrice">
                <span class="glpLineItemPriceVal">$375</span>
                <span class="glpLineItemPriceNote">individual value / wk</span>
              </div>
            </div>

            <!-- Mock preview -->
            <div class="glpMockWrap glpMockWrap--vip">
              <div class="glpMockLabel">Live Placement Preview</div>
              <div class="glpMockEvHub">
                <div class="glpMockEvHeader">
                  <div class="glpMockEvLogo">GoDo<strong>Daytona</strong></div>
                  <div class="glpMockEvNav">
                    <span class="glpMockEvNavItem">Home</span>
                    <span class="glpMockEvNavItem glpMockEvNavActive">Events</span>
                    <span class="glpMockEvNavItem">Guides</span>
                  </div>
                </div>
                <div class="glpMockPicksLabel">⭐ GoDo Picks — Editor's Selections</div>
                <div class="glpMockPicksGrid">
                  <div class="glpMockPickCard glpMockPickCard--active">
                    <div class="glpMockPickImg">
                      <span class="glpMockPickBadge">★ VIP</span>
                      <span class="glpMockPickAd">YOUR EVENT</span>
                      <span class="glpMockPickTrend">👁 Trending · 1.2k</span>
                    </div>
                    <div class="glpMockPickBody">
                      <div class="glpMockSkel glpMockSkel--title"></div>
                      <div class="glpMockSkel glpMockSkel--sub"></div>
                    </div>
                  </div>
                  <div class="glpMockPickCard glpMockPickCard--dim">
                    <div class="glpMockPickImg glpMockPickImg--dim"></div>
                    <div class="glpMockPickBody">
                      <div class="glpMockSkel glpMockSkel--title"></div>
                      <div class="glpMockSkel glpMockSkel--sub"></div>
                    </div>
                  </div>
                  <div class="glpMockPickCard glpMockPickCard--dim">
                    <div class="glpMockPickImg glpMockPickImg--dim"></div>
                    <div class="glpMockPickBody">
                      <div class="glpMockSkel glpMockSkel--title"></div>
                      <div class="glpMockSkel glpMockSkel--sub"></div>
                    </div>
                  </div>
                </div>
                <div class="glpMockCallout glpMockCallout--vip">
                  <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M5 1v4l2.5 2.5" stroke="#0077be" stroke-width="1.5" stroke-linecap="round"/><circle cx="5" cy="5" r="4" stroke="#0077be" stroke-width="1.2"/></svg>
                  Your event pulses at the top of GoDo Picks with live view counts — the single most-coveted slot on the page.
                </div>
              </div>
            </div>

            <div class="glpLineItemDesc">
              <p><strong>Who It's For:</strong> Concert promoters, venue managers, and regional event brands who need maximum turnout. The GoDo VIP Headliner pins your event to the editorial top of the most-visited section of GoDoDaytona — the GoDo Picks carousel — with an animated blue border that immediately signals priority to every visitor.</p>
              <p><strong>Why It Works:</strong> GoDo Picks is the first thing an engaged reader scans after the hero. Your event card gets a pulsing Blueprint Blue border, a live Trending view counter, and an "Editor's Choice" badge that signals editorial endorsement. Across 76k+ monthly impressions, that visual priority translates directly into ticket sales and foot traffic.</p>
            </div>
          </div>

          <!-- Line Item 2: Newsletter Mentions -->
          <div class="glpLineItem glpLineItem--news">
            <div class="glpLineItemHeader">
              <div class="glpLineItemNum">02</div>
              <div class="glpLineItemMeta">
                <span class="glpLineItemBadge glpLineItemBadge--news">✉ 2× per month</span>
                <h3 class="glpLineItemName">Dedicated Newsletter Mentions</h3>
                <p class="glpLineItemWhere">Morning Briefing · 5,000+ Daily Inboxes · 42% Open Rate</p>
              </div>
              <div class="glpLineItemPrice">
                <span class="glpLineItemPriceVal">$300</span>
                <span class="glpLineItemPriceNote">combined value ($150 × 2)</span>
              </div>
            </div>

            <!-- Mock preview -->
            <div class="glpMockWrap glpMockWrap--news">
              <div class="glpMockLabel">Live Placement Preview</div>
              <div class="glpMockEmail">
                <div class="glpMockEmailHeader">
                  <div class="glpMockEmailLogo">GoDo<strong>Daytona</strong> · Morning Briefing</div>
                  <div class="glpMockEmailDate">Weekly · 6:00 AM</div>
                </div>
                <div class="glpMockEmailBody">
                  <div class="glpMockSkel glpMockSkel--headline"></div>
                  <div class="glpMockSkel glpMockSkel--para"></div>
                  <div class="glpMockSkel glpMockSkel--para glpMockSkel--short"></div>
                  <div class="glpMockEmailMention">
                    <span class="glpMockMentionTag">Sponsored</span>
                    <div class="glpMockMentionText">
                      <strong>Your Event Name Here</strong> — This is where your native mention lives, written in the editorial voice of GoDoDaytona and linked directly to your event page. Feels like a recommendation, not an ad.
                    </div>
                    <a class="glpMockMentionCta" href="#buy" tabindex="-1" aria-hidden="true">Get Tickets →</a>
                  </div>
                  <div class="glpMockSkel glpMockSkel--para"></div>
                  <div class="glpMockSkel glpMockSkel--para glpMockSkel--short"></div>
                </div>
                <div class="glpMockCallout glpMockCallout--news">
                  <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><rect x="1" y="2" width="8" height="6" rx="1.5" stroke="#0077be" stroke-width="1.2"/><path d="M1 4l4 2.5L9 4" stroke="#0077be" stroke-width="1.2"/></svg>
                  Your mention appears twice per month — woven into the editorial flow where 5,000+ locals trust what they read.
                </div>
              </div>
            </div>

            <div class="glpLineItemDesc">
              <p><strong>Who It's For:</strong> Any brand that wants recurring presence in the daily routine of Daytona's most engaged residents. Two mentions per month means you stay visible even between events — building name recognition and cultivating repeat attendance.</p>
              <p><strong>Why It Works:</strong> With a 42% open rate, the GoDoDaytona morning briefing reaches people when they're actively planning their week. A native editorial mention in that context carries far more weight than a display ad — it reads as a recommendation, not an interruption. Two placements spaced through the month keeps your event top-of-mind from announcement to show night.</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         BUNDLE VALUE TABLE
    ═══════════════════════════════════════════ -->
    <section class="glpSection glpSection--tinted">
      <div class="glpWrap">
        <div class="glpSectionHead">
          <span class="glpSectionEyebrow">Value Breakdown</span>
          <h2 class="glpSectionTitle">The Numbers</h2>
        </div>
        <div class="glpValueTable">
          <div class="glpValueRow glpValueRow--header">
            <span>Placement</span>
            <span>Reach</span>
            <span>Individual Price</span>
          </div>
          <div class="glpValueRow">
            <span class="glpValueRowName">★ GoDo VIP Headliner <em>(Events Hub)</em></span>
            <span>76k+ monthly impressions</span>
            <span class="glpValueRowPrice">$375 / week</span>
          </div>
          <div class="glpValueRow">
            <span class="glpValueRowName">✉ Newsletter Mention × 2 <em>(Morning Briefing)</em></span>
            <span>5,000+ inboxes · 42% open rate</span>
            <span class="glpValueRowPrice">$300 total</span>
          </div>
          <div class="glpValueRow glpValueRow--subtotal">
            <span>Combined Value</span>
            <span></span>
            <span>$675</span>
          </div>
          <div class="glpValueRow glpValueRow--total">
            <span>GoDo Local Pack Price</span>
            <span></span>
            <span class="glpValueBundle">$450 / month <span class="glpValueSave">Save $225</span></span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         CTA / BUY
    ═══════════════════════════════════════════ -->
    <section class="glpSection glpSection--dark" id="buy">
      <div class="glpWrap">
        <div class="glpBuyBlock">
          <div class="glpBuyLeft">
            <span class="glpSectionEyebrow glpSectionEyebrow--onDark">Ready to Book</span>
            <h2 class="glpBuyTitle">Reserve The GoDo<br>Local Pack</h2>
            <p class="glpBuySub">Slots are limited to 3 concurrent VIP advertisers. Contact us to confirm availability and lock in your monthly package.</p>
            <ul class="glpBuyPerks">
              <li>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7l3.5 3.5 6.5-6.5" stroke="#34d399" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Dedicated account rep for creative review
              </li>
              <li>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7l3.5 3.5 6.5-6.5" stroke="#34d399" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                48-hour activation after contract sign
              </li>
              <li>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7l3.5 3.5 6.5-6.5" stroke="#34d399" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Monthly performance report included
              </li>
              <li>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7l3.5 3.5 6.5-6.5" stroke="#34d399" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Cancel or pause with 30 days' notice
              </li>
            </ul>
          </div>
          <div class="glpBuyRight">
            <div class="glpBuyCard">
              <div class="glpBuyCardTop">
                <span class="glpBuyCardBadge">Best Value</span>
                <div class="glpBuyCardPrice">
                  <span class="glpBuyCardAmount">$450</span>
                  <span class="glpBuyCardUnit">/ month</span>
                </div>
                <p class="glpBuyCardSaving">Saves $225 vs. à la carte</p>
              </div>
              <ul class="glpBuyCardItems">
                <li>
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M1.5 6l3 3 6-6" stroke="var(--brand1,#0077be)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  1× GoDo VIP Headliner (Events Hub)
                </li>
                <li>
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M1.5 6l3 3 6-6" stroke="var(--brand1,#0077be)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  2× Newsletter Mentions (Morning Briefing)
                </li>
                <li>
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M1.5 6l3 3 6-6" stroke="var(--brand1,#0077be)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  Performance report + creative review
                </li>
              </ul>
              <a href="mailto:ads@godocity.com?subject=GoDo Local Pack — Reserve" class="glpBuyCardBtn">
                Reserve This Package →
              </a>
              <p class="glpBuyCardNote">Or call <strong>(386) 555-0142</strong> · Mon–Fri 9–5 ET</p>
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>{/* /.glpBody */}

</Base>

<style>
  /* ─── Tokens ─────────────────────────────────────────────── */
  :root {
    --glp-blue: var(--brand1, #0077be);
    --glp-dark: #080a10;
  }

  /* ─── Hero ───────────────────────────────────────────────── */
  .glpHero {
    position: relative;
    min-height: 380px;
    display: flex;
    align-items: center;
    background: linear-gradient(160deg, #0a1628 0%, #0f2240 60%, #091830 100%);
    overflow: hidden;
  }
  .glpHeroOverlay {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at 30% 50%, rgba(0,119,190,.18) 0%, transparent 65%);
    pointer-events: none;
  }
  .glpHeroInner {
    position: relative;
    max-width: 860px;
    margin: 0 auto;
    padding: 64px 2rem 56px;
  }
  .glpBack {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    color: rgba(255,255,255,.55);
    text-decoration: none;
    letter-spacing: .06em;
    margin-bottom: 18px;
    transition: color .15s;
  }
  .glpBack:hover { color: #fff; }
  .glpEyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--glp-blue);
    background: rgba(0,119,190,.12);
    border: 1px solid rgba(0,119,190,.3);
    border-radius: 999px;
    padding: 4px 12px;
    margin-bottom: 16px;
  }
  .glpTitle {
    font-size: clamp(34px, 5.5vw, 64px);
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -1px;
    line-height: 1.06;
    margin: 0 0 16px;
  }
  .glpSub {
    font-size: clamp(15px, 1.8vw, 18px);
    color: rgba(255,255,255,.7);
    line-height: 1.6;
    max-width: 580px;
    margin: 0 0 32px;
  }
  .glpHeroCtas { display: flex; gap: 12px; flex-wrap: wrap; }
  .glpBtnPrimary {
    display: inline-block;
    background: var(--glp-blue);
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    padding: 13px 26px;
    border-radius: 8px;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(0,119,190,.35);
    transition: background .15s;
  }
  .glpBtnPrimary:hover { background: #005f99; }
  .glpBtnGhost {
    display: inline-block;
    color: rgba(255,255,255,.8);
    border: 1.5px solid rgba(255,255,255,.3);
    font-size: 15px;
    font-weight: 600;
    padding: 13px 26px;
    border-radius: 8px;
    text-decoration: none;
    transition: border-color .15s, color .15s;
  }
  .glpBtnGhost:hover { border-color: rgba(255,255,255,.7); color: #fff; }

  /* ─── Pricing Bar ────────────────────────────────────────── */
  .glpPricingBar {
    background: #0a1628;
    border-bottom: 3px solid var(--glp-blue);
    padding: 18px 0;
  }
  .glpPricingBarInner {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .glpPriceBlock { display: flex; align-items: baseline; gap: 6px; }
  .glpPriceLabel {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: rgba(255,255,255,.5);
  }
  .glpPriceMain {
    font-size: 32px;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -1px;
  }
  .glpPriceUnit {
    font-size: 14px;
    color: rgba(255,255,255,.55);
  }
  .glpPriceSavings {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: #34d399;
    background: rgba(52,211,153,.1);
    border: 1px solid rgba(52,211,153,.2);
    border-radius: 999px;
    padding: 4px 12px;
  }

  /* ─── Body ───────────────────────────────────────────────── */
  .glpBody { background: #fff; }
  .glpWrap { max-width: 860px; margin: 0 auto; padding: 0 2rem; }
  .glpSection { padding: 72px 0; }
  .glpSection--tinted { background: #f7f8fa; }
  .glpSection--dark { background: #080a10; }

  .glpSectionHead { margin-bottom: 48px; }
  .glpSectionEyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--glp-blue);
    margin-bottom: 10px;
  }
  .glpSectionEyebrow--onDark { color: var(--glp-blue); }
  .glpSectionTitle {
    font-size: clamp(26px, 3.5vw, 42px);
    font-weight: 900;
    color: #0a0f1e;
    letter-spacing: -0.5px;
    margin: 0 0 10px;
  }
  .glpSection--dark .glpSectionTitle { color: #fff; }
  .glpSectionSub {
    font-size: 16px;
    color: #555;
    line-height: 1.6;
    max-width: 520px;
  }

  /* ─── Line Items ─────────────────────────────────────────── */
  .glpLineItems { display: flex; flex-direction: column; gap: 56px; }

  .glpLineItem {
    border: 1.5px solid #e5e7eb;
    border-radius: 14px;
    overflow: hidden;
  }
  .glpLineItem--vip { border-color: rgba(0,119,190,.3); }

  .glpLineItemHeader {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    padding: 24px 28px;
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }
  .glpLineItem--vip .glpLineItemHeader {
    background: linear-gradient(135deg, rgba(0,119,190,.06) 0%, rgba(0,119,190,.02) 100%);
    border-bottom-color: rgba(0,119,190,.15);
  }

  .glpLineItemNum {
    font-size: 40px;
    font-weight: 900;
    color: rgba(0,119,190,.18);
    line-height: 1;
    min-width: 46px;
    flex-shrink: 0;
    margin-top: 4px;
  }
  .glpLineItemMeta { flex: 1; }
  .glpLineItemBadge {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    border-radius: 999px;
    padding: 3px 9px;
    margin-bottom: 8px;
    background: #f0f4f8;
    color: #555;
    border: 1px solid #d0d8e0;
  }
  .glpLineItemBadge--vip {
    background: rgba(0,119,190,.1);
    color: var(--glp-blue);
    border-color: rgba(0,119,190,.25);
  }
  .glpLineItemBadge--news {
    background: rgba(52,211,153,.1);
    color: #059669;
    border-color: rgba(52,211,153,.3);
  }
  .glpLineItemName {
    font-size: 20px;
    font-weight: 800;
    color: #0a0f1e;
    margin: 0 0 4px;
  }
  .glpLineItemWhere {
    font-size: 12px;
    color: #888;
    margin: 0;
  }
  .glpLineItemPrice {
    text-align: right;
    flex-shrink: 0;
  }
  .glpLineItemPriceVal {
    display: block;
    font-size: 26px;
    font-weight: 900;
    color: #0a0f1e;
    letter-spacing: -0.5px;
    text-decoration: line-through;
    color: #aaa;
  }
  .glpLineItemPriceNote {
    font-size: 11px;
    color: #aaa;
  }

  /* ─── Mockup Previews ────────────────────────────────────── */
  .glpMockWrap {
    padding: 20px 28px;
    background: #f0f4f8;
    border-bottom: 1px solid #e5e7eb;
  }
  .glpMockWrap--vip {
    background: linear-gradient(160deg, #0a1628 0%, #0f2240 100%);
    border-bottom-color: rgba(0,119,190,.2);
  }
  .glpMockWrap--news { background: #f7f8fa; }

  .glpMockLabel {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: rgba(255,255,255,.45);
    margin-bottom: 12px;
  }
  .glpMockWrap--news .glpMockLabel { color: #aaa; }

  /* Events Hub mock */
  .glpMockEvHub {
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    max-width: 520px;
    box-shadow: 0 4px 24px rgba(0,0,0,.3);
  }
  .glpMockEvHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #080a10;
    padding: 7px 12px;
  }
  .glpMockEvLogo {
    font-size: 11px;
    color: rgba(255,255,255,.8);
    letter-spacing: .5px;
  }
  .glpMockEvLogo strong { color: var(--glp-blue); }
  .glpMockEvNav { display: flex; gap: 10px; }
  .glpMockEvNavItem { font-size: 9px; color: rgba(255,255,255,.45); }
  .glpMockEvNavActive { color: var(--glp-blue) !important; font-weight: 700; }

  .glpMockPicksLabel {
    font-size: 9px;
