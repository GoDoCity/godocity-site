---
/**
 * /admin/deploy — Cloudflare Pages Deploy Hook Trigger
 *
 * Internal utility, not linked from the public site.
 *
 * SETUP (one-time, ~2 minutes):
 *   1. Open Cloudflare Dashboard → Pages → godocity-site
 *   2. Settings → Builds & Deployments → Deploy Hooks → "Add Deploy Hook"
 *   3. Name it "Sheet Update", select branch "main", click Save
 *   4. Copy the hook URL (looks like:
 *        https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/xxxxxxxx-…)
 *   5. Paste it into this page and click "Save & Trigger" — it's stored
 *      in your browser's localStorage, never sent anywhere except Cloudflare.
 *
 * USAGE:
 *   • Bookmark this page: /admin/deploy
 *   • After updating the Google Sheet, open the bookmark and click "Trigger Build"
 *   • A new Cloudflare Pages build will start within ~10 seconds
 *   • You can watch it at: https://dash.cloudflare.com → Pages → godocity-site → Deployments
 */
import Base from "../../layouts/Base.astro";
---

<Base title="Deploy Trigger — Admin" description="">
  <style>
    body { background: #0d0d0d; color: #eee; font-family: system-ui, sans-serif; }
    .wrap {
      max-width: 560px; margin: 60px auto; padding: 0 20px;
      display: flex; flex-direction: column; gap: 24px;
    }
    h1 { font-size: 22px; font-weight: 900; margin: 0; color: #FFD700; }
    p  { margin: 0; font-size: 14px; line-height: 1.6; color: #aaa; }
    label { font-size: 12px; font-weight: 700; text-transform: uppercase;
            letter-spacing: .08em; color: #888; display: block; margin-bottom: 6px; }
    input[type="url"] {
      width: 100%; box-sizing: border-box;
      padding: 10px 12px; border-radius: 6px;
      border: 1px solid rgba(255,255,255,.15);
      background: rgba(255,255,255,.06); color: #eee;
      font-size: 13px;
    }
    input[type="url"]:focus { outline: 2px solid #FFD700; border-color: transparent; }
    .row { display: flex; gap: 10px; }
    button {
      flex: 1; height: 42px; border-radius: 6px; border: none;
      font-size: 14px; font-weight: 800; cursor: pointer; transition: opacity 140ms;
    }
    button:disabled { opacity: .4; cursor: default; }
    #btnSave    { background: rgba(255,255,255,.1); color: #eee; }
    #btnTrigger { background: #FFD700; color: #000; }
    #status {
      padding: 12px 16px; border-radius: 6px; font-size: 14px;
      font-weight: 700; display: none;
    }
    #status.ok  { background: rgba(0,200,100,.15); color: #00c864; border: 1px solid rgba(0,200,100,.3); }
    #status.err { background: rgba(255,60,60,.12);  color: #ff6060; border: 1px solid rgba(255,60,60,.25); }
    .hint { font-size: 12px; color: #555; line-height: 1.5; }
    a { color: #FFD700; }
  </style>

  <div class="wrap">
    <div>
      <h1>Deploy Trigger</h1>
      <p style="margin-top:6px">Trigger a fresh Cloudflare Pages build after updating the Google Sheet.</p>
    </div>

    <div>
      <label for="hookUrl">Cloudflare Deploy Hook URL</label>
      <input id="hookUrl" type="url"
             placeholder="https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/…" />
      <p class="hint" style="margin-top:8px">
        Stored in your browser only (localStorage). Never leaves your machine except to Cloudflare.
      </p>
    </div>

    <div class="row">
      <button id="btnSave">Save URL</button>
      <button id="btnTrigger" disabled>Trigger Build</button>
    </div>

    <div id="status"></div>

    <p class="hint">
      <strong style="color:#eee">Don't have a hook URL yet?</strong><br>
      Cloudflare Dashboard → Pages → <em>godocity-site</em> → Settings →
      Builds &amp; Deployments → Deploy Hooks → <strong>Add Deploy Hook</strong>
      → name it "Sheet Update", branch "main" → copy the URL above.
      <br><br>
      After triggering, watch the build at
      <a href="https://dash.cloudflare.com" target="_blank" rel="noopener">dash.cloudflare.com</a>
      → Pages → godocity-site → Deployments.
    </p>
  </div>

  <script>
    const input   = document.getElementById("hookUrl");
    const btnSave = document.getElementById("btnSave");
    const btnTrig = document.getElementById("btnTrigger");
    const status  = document.getElementById("status");
    const KEY     = "cf-deploy-hook";

    function setStatus(msg, ok) {
      status.textContent = msg;
      status.className   = ok ? "ok" : "err";
      status.style.display = "block";
    }

    function loadSaved() {
      const saved = localStorage.getItem(KEY);
      if (saved) { input.value = saved; btnTrig.disabled = false; }
    }

    btnSave.addEventListener("click", () => {
      const url = input.value.trim();
      if (!url.startsWith("https://api.cloudflare.com/")) {
        setStatus("That doesn't look like a Cloudflare hook URL.", false);
        return;
      }
      localStorage.setItem(KEY, url);
      btnTrig.disabled = false;
      setStatus("Saved! Click Trigger Build to deploy.", true);
    });

    btnTrig.addEventListener("click", async () => {
      const url = localStorage.getItem(KEY);
      if (!url) { setStatus("No hook URL saved.", false); return; }
      btnTrig.disabled = true;
      btnTrig.textContent = "Triggering…";
      try {
        const res = await fetch(url, { method: "POST" });
        if (res.ok) {
          setStatus("Build triggered! Check the Cloudflare dashboard in ~30s.", true);
        } else {
          setStatus(`Cloudflare returned HTTP ${res.status}. Check the hook URL.`, false);
        }
      } catch (e) {
        setStatus(`Request failed: ${e.message}`, false);
      } finally {
        btnTrig.disabled = false;
        btnTrig.textContent = "Trigger Build";
      }
    });

    loadSaved();
  </script>
</Base>
