---
/**
 * src/layouts/GuideLayout.astro
 * Layout for guide pages (Live / Work / Play / Best).
 *
 * Props
 *  title       – page <title>
 *  subtitle    – meta description
 *  cityBase    – city slug, e.g. "daytona"
 *  topic       – "Live" | "Work" | "Play" | "Best" (displayed as branding label)
 *  showToC     – when true, a Table of Contents is built from h2/h3 in the article
 *
 * Grid (desktop): 70 % content column | 30 % sticky sidebar
 * Sidebar:  mini newsletter sign-up (sticky) + upcoming events list
 */
import Base from "./Base.astro";
import { getMergedCityEvents } from "../lib/getMergedCityEvents.ts";
import { getShortName } from "../lib/cityConfigs.js";
import SidebarEventsList from "../components/SidebarEventsList.astro";

interface Props {
  title: string;
  subtitle?: string;
  cityBase?: string;
  topic?: string;
  showToC?: boolean;
  hideHeader?: boolean;
}

const { title, subtitle, cityBase = "daytona", topic = "", showToC = false, hideHeader = false } = Astro.props;

/* ── Events for sidebar ── */
const eventList = (await getMergedCityEvents(cityBase)).slice(0, 6);
const hasEvents = eventList.length > 0;

/* Topic emoji map */
const topicEmoji: Record<string, string> = {
  Live: "🏠",
  Work: "💼",
  Play: "🎉",
  Best: "⭐",
};
const emoji = topicEmoji[topic] ?? "📖";
---

<Base title={title} subtitle={subtitle} cityBase={cityBase}>

  <section class="gl-wrap">

    <!-- ── Branding header (suppressed on full article pages) ───────────── -->
    {!hideHeader && (
      <header class="gl-header">
        <a class="gl-pill" href={`/${cityBase}/guides/`}>Guides</a>
        {topic && (
          <span class="gl-topic">
            <span class="gl-topic-emoji">{emoji}</span>
            {topic}
          </span>
        )}
      </header>
    )}

    <!-- ── Main grid ──────────────────────────────────────────────────── -->
    <div class="gl-grid">

      <!-- Left / Center: article (inline ToC injected by script when showToC=true) -->
      <div class="gl-main">

        <article class="gl-article" id="guide-article">
          <slot />
        </article>

      </div>

      <!-- Right: sticky sidebar ─────────────────────────────────────── -->
      <aside class="gl-sidebar">

        <!-- 1 — Mini newsletter (sticky) -->
        <div class="gl-sticky-top">
          <div class="gl-nl">
            <div class="gl-nl-head">
              <em>Good News <strong>{getShortName(cityBase)}!</strong></em>
            </div>
            <div class="gl-nl-sub">Join GoDo{getShortName(cityBase)} for the daily brief on local news, fresh openings, and must-see events.</div>
            <form class="gl-nl-form" action={`/${cityBase}/subscribe/`} method="get">
              <input
                class="gl-nl-input"
                type="email"
                name="email"
                placeholder="your@email.com"
                required
                autocomplete="email"
              />
              <button class="gl-nl-btn" type="submit">SIGN UP</button>
            </form>
          </div>
        </div>

        <!-- 2 — Upcoming Events -->
        <div class="gl-events">
          <div class="gl-ev-head">
            <span class="gl-ev-title">Upcoming Events</span>
            <a class="gl-ev-more" href={`/${cityBase}/events/`}>See all</a>
          </div>

          <SidebarEventsList events={eventList} city={cityBase} />
          <a class="gl-submit-ev" href="/submit-event/">+ Submit an event →</a>
        </div>

      </aside>
    </div>
  </section>
</Base>

<!-- ══ GLOBAL styles: ToC box ════════════════════════════════════════════ -->
<style is:global>
  /* ── Inline collapsible ToC ── */
  #guide-toc.gl-itoc {
    background-color: var(--theme-accent) !important;
    border: 2px solid var(--line) !important;
    border-radius: 12px;
    padding: 16px 20px;
    margin-bottom: 32px;
    width: 100%;
    box-sizing: border-box;
    color: white;
  }

  .gl-itoc-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: white;
    cursor: pointer;
    list-style: none;
    user-select: none;
    gap: 8px;
  }
  .gl-itoc-summary::-webkit-details-marker { display: none !important; }
  summary.gl-itoc-summary::-webkit-details-marker { display: none !important; }
  .gl-itoc-summary::marker { display: none !important; }
  summary.gl-itoc-summary { list-style: none; }

  .gl-itoc-hamburger {
    display: inline-block;
    width: 18px;
    height: 13px;
    flex-shrink: 0;
    margin-right: 2px;
    vertical-align: middle;
  }

  .gl-itoc-chevron {
    font-size: 22px;
    line-height: 1;
    color: var(--muted);
    transition: transform 200ms ease;
    flex-shrink: 0;
    margin-left: auto;
  }
  #guide-toc[open] .gl-itoc-chevron {
    transform: rotate(90deg);
  }

  .gl-itoc-list {
    list-style: none;
    margin: 10px 0 2px;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .gl-itoc li  { margin: 0 !important; padding: 2px 0 !important; }
  .gl-itoc-item { padding: 2px 0 !important; }
  .gl-itoc-item--sub { padding-left: 16px; padding-top: 2px !important; padding-bottom: 2px !important; }

  .gl-itoc-link {
    display: block;
    padding: 2px 0;
    font-size: 1.15rem;
    font-weight: 600;
    color: white;
    text-decoration: none;
    line-height: 1.35;
    transition: color 140ms;
  }
  .gl-itoc-link:hover { color: var(--text); }

  .gl-itoc-item--sub .gl-itoc-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
  }
  .gl-itoc-item--sub .gl-itoc-link:hover { color: var(--text); }

  @media (max-width: 900px) {
    #guide-toc.gl-itoc {
      width: 100%;
      border-radius: 10px;
      background-color: var(--theme-accent) !important;
    }
  }
</style>

<!-- ── Inline collapsible ToC builder (runs only when showToC is true) ── -->
{showToC && (
  <script>
    (function () {
      var article = document.getElementById("guide-article");
      if (!article) return;

      /* ── PASS 0: Repair headings buried in ** bold / * italic markers ──────
         Handles: <p><strong>## Section Title</strong></p>
                  <p>## Section Title</p>
         e.g. when author writes **## Heading** in Decap CMS editor            */
      var pars = Array.prototype.slice.call(article.querySelectorAll("p"));
      pars.forEach(function (p) {
        var raw = (p.textContent || "").replace(/^\s*\*+\s*/, "").trim();
        var h3m = raw.match(/^###\s+([\s\S]+)/);
        var h2m = !h3m && raw.match(/^##\s+([\s\S]+)/);
        if (!h2m && !h3m) return;
        var level = h3m ? "h3" : "h2";
        var cleanText = ((h3m || h2m)[1] || "").replace(/\*+\s*$/, "").trim();
        if (!cleanText) return;
        var newH = document.createElement(level);
        newH.textContent = cleanText;
        if (p.parentNode) p.parentNode.replaceChild(newH, p);
      });

      var headings = Array.prototype.slice.call(
        article.querySelectorAll("h2, h3")
      );
      if (headings.length === 0) return;

      /* Assign IDs to headings that lack one */
      headings.forEach(function (h: HTMLElement, i: number) {
        if (!h.id) h.id = "toc-" + i;
      });

      /* Build <details> accordion */
      var details = document.createElement("details");
      details.id        = "guide-toc";
      details.className = "gl-itoc";
      /* Open on desktop (≥900 px), closed on mobile */
      details.open = window.innerWidth >= 900;

      var summary = document.createElement("summary");
      summary.className   = "gl-itoc-summary";
      summary.innerHTML   =
        '<svg class="gl-itoc-hamburger" aria-hidden="true" width="18" height="13" viewBox="0 0 18 13" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="0" y="0" width="18" height="2" rx="1" fill="currentColor"/><rect x="0" y="5.5" width="18" height="2" rx="1" fill="currentColor"/><rect x="0" y="11" width="18" height="2" rx="1" fill="currentColor"/></svg>In this guide <span class="gl-itoc-chevron" aria-hidden="true">&#8250;</span>';
      details.appendChild(summary);

      var list = document.createElement("ul");
      list.className = "gl-itoc-list";

      headings.forEach(function (h: HTMLElement) {
        var li = document.createElement("li");
        li.className = h.tagName === "H3"
          ? "gl-itoc-item gl-itoc-item--sub"
          : "gl-itoc-item";

        var a = document.createElement("a");
        a.href        = "#" + h.id;
        a.textContent = h.textContent;
        a.className   = "gl-itoc-link";

        li.appendChild(a);
        list.appendChild(li);
      });

      details.appendChild(list);

      /* Inject immediately before the first h2 (keeps intro text above ToC) */
      var firstH2 = article.querySelector("h2");
      if (firstH2) {
        article.insertBefore(details, firstH2);
      } else {
        article.insertBefore(details, article.firstChild);
      }
    })();
  </script>
)}

<!-- ── Image caption builder (wraps article images in <figure> with <figcaption>) ── -->
<script>
  (function () {
    var article = document.getElementById("guide-article");
    if (!article) return;
    var imgs = Array.prototype.slice.call(article.querySelectorAll("img"));
    imgs.forEach(function (img: HTMLImageElement) {
      var alt = (img.getAttribute("alt") || "").trim();
      if (!alt) return;
      /* Skip if already inside a <figure> */
      if (img.parentElement && img.parentElement.tagName === "FIGURE") return;
      var figure = document.createElement("figure");
      img.parentNode!.insertBefore(figure, img);
      figure.appendChild(img);
      var caption = document.createElement("figcaption");
      caption.textContent = alt;
      figure.appendChild(caption);
    });
  })();
</script>


<style>
  /* ── Wrapper ── */
  .gl-wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 40px 2rem 80px;
  }

  /* ── Branding header ── */
  .gl-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 32px;
  }

  .gl-pill {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 0 14px;
    border-radius: 999px;
    background: var(--pillBg, color-mix(in srgb, var(--theme-accent) 14%, transparent));
    border: 1px solid var(--pillBorder, color-mix(in srgb, var(--theme-accent) 55%, transparent));
    color: var(--text);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 140ms;
  }
  .gl-pill:hover { opacity: 0.78; color: var(--text); }

  .gl-topic {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-head, "Manrope", sans-serif);
    font-size: 18px;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.02em;
  }
  .gl-topic-emoji { font-size: 20px; }

  /* ── Two-column grid ── */
  .gl-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(380px, 3fr);
    gap: 56px;
    align-items: start;
  }

  /* ── Main column ── */
  .gl-main {
    display: grid;
    gap: 32px;
    min-width: 0;
  }

  /* ── Article body ── */
  .gl-article {
    min-width: 0;
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--text);
  }

  .gl-article :global(h1) {
    font-family: var(--font-head, "Manrope", sans-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 1rem;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  .gl-article :global(h2) {
    font-family: var(--font-head, "Manrope", sans-serif);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 2rem 0 1rem;
    letter-spacing: -0.03em;
    scroll-margin-top: 80px;
  }
  .gl-article :global(h3) {
    font-family: var(--font-head, "Manrope", sans-serif);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 700;
    color: var(--text-primary);
    margin: 28px 0 8px;
    scroll-margin-top: 80px;
  }
  .gl-article :global(p) { margin: 0 0 18px; }

  /* ── Auto editorial-bold for ***…*** blocks ── */
  .gl-article :global(p > em:first-child > strong),
  .gl-article :global(p > strong:first-child > em) {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.01em;
    font-style: normal;
  }

  /* Images — :global() required so slot/markdown content images match */
  .gl-article :global(img) {
    max-width: 100% !important;
    width: auto !important;
    height: auto !important;
    display: block;
    margin: 1.5rem auto;
    border-radius: 0.5rem;
  }

  /* Auto-generated image captions from alt text */
  .gl-article :global(figure) {
    margin: 0 0 24px;
    text-align: center;
  }
  .gl-article :global(figure img) {
    max-width: 100% !important;
    width: auto !important;
    height: auto !important;
    border-radius: 0.5rem;
    margin: 0 auto;
  }
  .gl-article :global(figcaption) {
    margin-top: 8px;
    font-size: 13px;
    font-style: italic;
    color: var(--muted);
    text-align: center;
    line-height: 1.4;
  }
  .gl-article ul,
  .gl-article ol { margin: 0 0 18px; padding-left: 24px; }
  .gl-article li { margin-bottom: 6px; }

  /* Allow .editorial-bold class on any element inside the article */
  .gl-article :global(.editorial-bold) {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  /* ── Sidebar column ── */
  .gl-sidebar {
    display: grid;
    gap: 28px;
    align-self: start;
    min-width: 0;
  }

  /* Sticky top wrapper keeps the newsletter box pinned */
  .gl-sticky-top {
    position: sticky;
    top: 80px;          /* clear fixed header */
    z-index: 10;
    margin-bottom: 2.5rem;
  }

  /* ── Mini Newsletter ── */
  .gl-nl {
    position: relative;
    background: var(--theme-gradient);
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    overflow: hidden;
    border: none !important;
    text-align: center;
  }
  .gl-nl::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('/images/geometric-pattern-master.svg');
    background-repeat: repeat;
    background-size: 150px 150px;
    opacity: 0.3;
    pointer-events: none;
  }

  .gl-nl-head {
    font-size: 1.75rem;
    font-weight: 900;
    font-style: italic;
    color: white;
    line-height: 1.1;
    letter-spacing: -0.04em;
    text-align: center;
  }
  .gl-nl-head strong { font-weight: 900; }

  .gl-nl-sub {
    font-size: 1.1rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.4;
    text-align: center;
    max-width: 280px;
    margin: 0 auto;
  }

  .gl-nl-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 12px;
    width: 100%;
  }

  .gl-nl-input {
    width: 100%;
    box-sizing: border-box;
    padding: 12px 14px;
    border-radius: 10px;
    border: none;
    background: white;
    font-size: 14px;
    color: var(--text-primary);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    outline: 2px solid transparent;
    transition: outline-color 150ms;
  }
  .gl-nl-input:focus { outline-color: var(--text-primary); }
  .gl-nl-input::placeholder { color: var(--muted); }

  .gl-nl-btn {
    width: 100%;
    padding: 12px 0;
    border-radius: 999px;
    border: none;
    background: #000;
    color: #fff;
    font-family: "Century Gothic", AppleGothic, Arial, sans-serif;
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 0.1em;
    cursor: pointer;
    box-sizing: border-box;
    transition: opacity 150ms;
  }
  .gl-nl-btn:hover { opacity: 0.82; }

  /* ── Events section ── */
  .gl-events { display: grid; gap: 0; }

  .gl-ev-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--theme-accent);
    margin-bottom: 0;
  }

  .gl-ev-title {
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
  }

  .gl-ev-more {
    font-size: 12px;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
  }
  .gl-ev-more:hover { text-decoration: underline; }

  .gl-submit-ev {
    display: block;
    margin-top: 10px;
    font-size: 12px;
    font-weight: 700;
    color: var(--muted);
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 120ms;
  }
  .gl-submit-ev:hover { opacity: 1; }

  /* ── Responsive ─────────────────────────────────────────────────────── */
  @media (max-width: 1150px) {
    .gl-grid {
      display: flex;
      flex-direction: column;
      gap: 40px;
    }

    /* Article content first, sidebar stack below */
    .gl-main    { order: 1; }
    .gl-sidebar { order: 2; display: flex; flex-direction: column; }

    /* Within sidebar on mobile: events before newsletter */
    .gl-events     { order: 1; }
    .gl-sticky-top { order: 2; position: static; }
  }

  @media (max-width: 600px) {
    .gl-wrap { padding: 24px 1rem 60px; }
    .gl-header { margin-bottom: 20px; }
  }
</style>
