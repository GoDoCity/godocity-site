---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { title, subtitle, cityBase } = Astro.props;
const theme = cityBase === "Daytona" ? "godo-blue" : "clean-white";
---
<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Manrope:wght@400;500;600;700;800&family=Montserrat:wght@400;700;900&family=Neonderthaw&family=Yellowtail&family=Monoton&family=Roboto:wght@400;900&family=Roboto+Condensed:wght@400;900&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={subtitle ?? "GoDoCity – multi-city local content platform"} />
    <link rel="stylesheet" href="/styles/themes.css?v=1.2" />
  </head>
  <body class={cityBase ? `city city-${cityBase}` : "city"}>
    <Header title={title} subtitle={subtitle} cityBase={cityBase} />
    <main>
      <slot />
    </main>
    <Footer cityBase={cityBase} title={title} />
  </body>
</html>
