---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const urlTheme = Astro.url?.searchParams?.get("theme")?.trim() || "";

const m = new Date().getMonth() + 1;
const monthThemeMap = {
  7: "patriotic",
  10: "halloween",
  11: "thanksgiving",
  12: "christmas",
};

const seasonalTheme = monthThemeMap[m] ?? "dark-yellow";
const activeTheme = urlTheme || seasonalTheme;

const { title, subtitle, cityBase } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme={activeTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content={activeTheme.startsWith("light-") ? "light" : "dark"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={subtitle ?? "GoDoCity – multi-city local content platform"} />
    <link rel="stylesheet" href="/styles/themes.css" />
<script is:inline>
  (function() {
    var p = new URLSearchParams(window.location.search).get("theme");
    if (p) {
      localStorage.setItem("godoTheme", p);
      document.documentElement.setAttribute("data-theme", p);
    } else {
      var saved = localStorage.getItem("godoTheme");
      if (saved) {
        document.documentElement.setAttribute("data-theme", saved);
      }
    }
  })();
</script>
</script>
  </head>
  <body class={cityBase ? `city city-${cityBase}` : "city"}>
    <Header title={title} subtitle={subtitle} cityBase={cityBase} />
    <main>
      <slot />
    </main>
    <Footer cityBase={cityBase} title={title} />
  </body>
</html>
