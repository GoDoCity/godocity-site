---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// Theme selection: URL param wins, otherwise month-based seasonal theme.
// Example demos:
//   ?theme=light-black
//   ?theme=light-blue
//   ?theme=dark-yellow
//   ?theme=halloween

const urlTheme = Astro.url?.searchParams?.get("theme")?.trim() || "";

// Month-long seasonal switching (1st -> end of month automatically)
const m = new Date().getMonth() + 1; // 1..12
const monthThemeMap = {
  2: "valentine",
  7: "patriotic",
  10: "halloween",
  11: "thanksgiving",
  12: "christmas",
};

// Default if no month match:
const seasonalTheme = monthThemeMap[m] ?? "dark-yellow";

// Final theme:
const activeTheme = urlTheme || seasonalTheme;

const { title, subtitle, cityBase } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme={activeTheme}>
  <head>
   <head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="color-scheme" content={activeTheme.startsWith("light-") ? "light" : "dark"} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
  <title>{title}</title>
  <meta name="description" content={subtitle ?? "GoDoCity – multi-city local content platform"} />
  <link rel="stylesheet" href="/styles/themes.css" />
</head>
     (function () {
    const params = new URLSearchParams(window.location.search);
    const urlTheme = (params.get("theme") || "").trim();

    // Month-long seasonal switching (1st -> end of month automatically)
    const monthThemeMap = {
      2: "valentine",
      7: "patriotic",
      10: "halloween",
      11: "thanksgiving",
      12: "christmas",
    };

    const m = new Date().getMonth() + 1;
    const seasonalTheme = monthThemeMap[m] || "dark-yellow";

    // Priority: URL param -> saved preference -> seasonal
    const saved = (localStorage.getItem("godoTheme") || "").trim();
    const active = urlTheme || saved || seasonalTheme;

    document.documentElement.setAttribute("data-theme", active);

    // Persist choice if coming from URL
    if (urlTheme) localStorage.setItem("godoTheme", urlTheme);

    // Optional: update color-scheme meta for light themes
    const meta = document.querySelector('meta[name="color-scheme"]');
    if (meta) {
      const isLight = active.startsWith("light");
      meta.setAttribute("content", isLight ? "light" : "dark");
    }
  })();
</script>
    <title>{title}</title>
    <meta name="description" content={subtitle ?? "GoDoCity – multi-city local content platform"} />
  </head>
  <body class={cityBase ? `city city-${cityBase}` : "city"}>
    <Header title={title} subtitle={subtitle} cityBase={cityBase} />
    <main>
      <slot />
    </main>
    <Footer cityBase={cityBase} title={title} />
  </body>
</html>
