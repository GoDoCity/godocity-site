---
/**
 * src/components/ArticleSidebar.astro
 * Unified article sidebar — used by every article/post layout.
 *
 * Upcoming Events section:
 *  - Slot 1: Smart Slider — top 5 Sponsored events, cycles every 5 s
 *  - Below:  Static list of next 4–5 regular (non-sponsored) events
 *
 * Event filtering:
 *  - Greater Daytona area only (never filtered by article topic/category)
 *  - UTC-safe past-event filter: events before today (midnight UTC) are hidden
 *  - Date badges always show actual month + day (never "Today")
 */
import SidebarPoll from "./SidebarPoll.astro";
import { getCollection } from "astro:content";
import { importFromSheet } from "../lib/sheet-import.js";

interface Props {
  city: string;
}

const { city } = Astro.props;
const cityCap = city.charAt(0).toUpperCase() + city.slice(1);

const GREATER_DAYTONA = new Set([
  "daytona", "daytona beach",
  "ormond beach", "ormond",
  "port orange",
  "daytona beach shores",
  "south daytona",
  "holly hill",
  "new smyrna beach", "new smyrna",
  "flagler beach", "flagler",
  "deland", "edgewater",
]);

const CITY_DISPLAY_NAMES: Record<string, string> = {
  "daytona": "Daytona Beach",
  "daytona beach": "Daytona Beach",
  "ormond beach": "Ormond Beach",
  "ormond": "Ormond Beach",
  "port orange": "Port Orange",
  "daytona beach shores": "Daytona Beach Shores",
  "south daytona": "South Daytona",
  "holly hill": "Holly Hill",
  "new smyrna beach": "New Smyrna Beach",
  "new smyrna": "New Smyrna Beach",
  "flagler beach": "Flagler Beach",
  "flagler": "Flagler Beach",
  "deland": "DeLand",
  "edgewater": "Edgewater",
};

/* UTC-safe "today" — compare YYYY-MM-DD strings to avoid timezone drift.
   Strict: events ON today are hidden; only future dates (> today) appear.  */
const todayStr = new Date().toISOString().split("T")[0]; // e.g. "2026-03-16"

function isUpcoming(eventDateRaw: string): boolean {
  if (!eventDateRaw) return false;
  const dateStr = String(eventDateRaw).split("T")[0]; // strip time if present
  return dateStr > todayStr;  // strictly future: today's events are excluded
}

let sponsoredSlides: any[] = [];  // top 5 sponsored — for the slider
let regularList: any[]    = [];   // next 5 regular   — for the static list

// Primary: Google Sheet CSV — pass same tokens as the main Events page so
// Eventbrite API dates are fetched correctly (empty token → today fallback).
try {
  const csvUrl      = import.meta.env.SHEET_CSV_URL          ?? "";
  const ebToken     = import.meta.env.EVENTBRITE_TOKEN        ?? "";
  const mapboxToken = import.meta.env.MAPBOX_ACCESS_TOKEN     ?? "";
  if (csvUrl) {
    const raw = await importFromSheet(csvUrl, ebToken, mapboxToken);
    const upcoming = (raw as any[])
      .filter(e => {
        const evCity = (e.city ?? "").toLowerCase().trim();
        return GREATER_DAYTONA.has(evCity) || evCity === city.toLowerCase().trim();
      })
      .filter(e => isUpcoming(e.eventDate))
      .sort((a, b) => {
        const da = String(a.eventDate ?? "").split("T")[0];
        const db = String(b.eventDate ?? "").split("T")[0];
        return da < db ? -1 : da > db ? 1 : 0;
      });

    sponsoredSlides = upcoming
      .filter(e => e.status === "Sponsored")
      .slice(0, 5)
      .map(e => ({
        data: {
          title:     e.title,
          eventDate: e.eventDate,
          location:  e.location,
          url:       e.url,
          city:      e.city,
          image:     e.image ?? null,
          sponsored: true,
        },
        slug: `${e.city ?? city}/${(e.title ?? "event").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")}`,
      }));

    regularList = upcoming
      .filter(e => e.status !== "Sponsored")
      .slice(0, 5)
      .map(e => ({
        data: {
          title:     e.title,
          eventDate: e.eventDate,
          location:  e.location,
          url:       e.url,
          city:      e.city,
          sponsored: false,
        },
        slug: `${e.city ?? city}/${(e.title ?? "event").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")}`,
      }));
  }
} catch { /* fall through to collection */ }

// Fallback: Astro events content collection
if (sponsoredSlides.length === 0 && regularList.length === 0) {
  try {
    const allEvents = await getCollection("events");
    const upcoming = (allEvents as any[])
      .filter(e => {
        const evCity = (e.data.city ?? e.slug.split("/")[0]).toLowerCase().trim();
        const areaMatch = GREATER_DAYTONA.has(city.toLowerCase().trim())
          ? GREATER_DAYTONA.has(evCity)
          : evCity === city.toLowerCase().trim();
        return areaMatch && isUpcoming(e.data.eventDate);
      })
      .sort((a: any, b: any) => {
        const da = String(a.data.eventDate ?? "").split("T")[0];
        const db = String(b.data.eventDate ?? "").split("T")[0];
        return da < db ? -1 : da > db ? 1 : 0;
      });

    sponsoredSlides = upcoming.filter((e: any) => e.data.sponsored === true).slice(0, 5);
    regularList     = upcoming.filter((e: any) => !e.data.sponsored).slice(0, 5);
  } catch {
    sponsoredSlides = [];
    regularList     = [];
  }
}

const hasSlider = sponsoredSlides.length > 0;
const hasList   = regularList.length > 0;
const hasEvents = hasSlider || hasList;
---

<aside class="articleSidebar">

  <!-- 1 — Newsletter -->
  <div class="nlStickyWrap">
    <div class="nlBox">
      <div class="nlBoxHead"><em>Good News <strong>{cityCap}!</strong></em></div>
      <div class="nlBoxSub">Get the best local stories delivered free every morning.</div>
      <form class="nlForm" action={`/${city}/subscribe/`} method="get">
        <input class="nlInput" type="email" name="email"
          placeholder="your@email.com" required autocomplete="email" />
        <button class="nlSubmit" type="submit">SIGN UP</button>
      </form>
    </div>
  </div>

  <!-- 2 — Upcoming Events -->
  <div class="railSection">
    <div class="railHead">
      <span class="railTitle">Upcoming Events</span>
      <a class="railMore" href={`/${city}/events/`}>See all</a>
    </div>

    {!hasEvents ? (
      <p class="noEvents">No upcoming events yet.</p>
    ) : (
      <div class="eventList">

        {/* ── Smart Slider: top 5 sponsored events, fades every 5 s ── */}
        {hasSlider && (
          <div class="evSlider" id="sbSlider" aria-label="Featured sponsored events">
            {sponsoredSlides.map((e: any, idx: number) => {
              const d      = new Date(e.data.eventDate);
              const dow    = d.toLocaleDateString("en-US", { weekday: "short" }).toUpperCase();
              const day    = d.getDate();
              const eMon   = d.toLocaleDateString("en-US", { month: "short" }).toUpperCase();
              const mon    = d.toLocaleDateString("en-US", { month: "short" });
              const evCity = (e.data.city ?? e.slug.split("/")[0]).toLowerCase().trim();
              const cityLabel = CITY_DISPLAY_NAMES[evCity] ?? evCity;
              return (
                <a class={`evSlide${idx === 0 ? " evSlide--active" : ""}`}
                   href={e.data.url ?? `/${e.data.city ?? evCity}/events/${e.slug.split("/").pop()}/`}
                   target={e.data.url ? "_blank" : "_self"}
                   rel={e.data.url ? "noopener" : ""}
                   aria-hidden={idx !== 0 ? "true" : undefined}
                   data-slide-idx={String(idx)}>
                  <span class="sponsoredBadge">SPONSORED</span>
                  <div class="eventCal">
                    <div class="eDow">{dow}</div>
                    <div class="eDay">{day}</div>
                    <div class="eMon">{eMon}</div>
                  </div>
                  <div class="eventInfo">
                    <div class="eName">{e.data.title}</div>
                    <div class="ePlace">
                      <span>{mon} {day}</span>
                      <span class="evCitySep">|</span>
                      <span class="evCityName">{cityLabel}</span>
                    </div>
                  </div>
                </a>
              );
            })}
            {/* Dots for slider */}
            {sponsoredSlides.length > 1 && (
              <div class="sbDots" id="sbDots">
                {sponsoredSlides.map((_: any, idx: number) => (
                  <button
                    class={`sbDot${idx === 0 ? " sbDot--active" : ""}`}
                    aria-label={`Go to slide ${idx + 1}`}
                    data-sb-dot={String(idx)}
                    type="button"
                  ></button>
                ))}
              </div>
            )}
          </div>
        )}

        {/* ── Static list: regular upcoming events ── */}
        {hasList && regularList.map((e: any) => {
          const d       = new Date(e.data.eventDate);
          const dow     = d.toLocaleDateString("en-US", { weekday: "short" }).toUpperCase();
          const day     = d.getDate();
          const eMon    = d.toLocaleDateString("en-US", { month: "short" }).toUpperCase();
          const mon     = d.toLocaleDateString("en-US", { month: "short" });
          const evCity  = (e.data.city ?? e.slug.split("/")[0]).toLowerCase().trim();
          const cityLabel = CITY_DISPLAY_NAMES[evCity] ?? evCity;
          return (
            <a class="eventRow"
               href={e.data.url ?? `/${e.data.city ?? evCity}/events/${e.slug.split("/").pop()}/`}
               target={e.data.url ? "_blank" : "_self"}
               rel={e.data.url ? "noopener" : ""}>
              <div class="eventCal">
                <div class="eDow">{dow}</div>
                <div class="eDay">{day}</div>
                <div class="eMon">{eMon}</div>
              </div>
              <div class="eventInfo">
                <div class="eName">{e.data.title}</div>
                <div class="ePlace">
                  <span>{mon} {day}</span>
                  <span class="evCitySep">|</span>
                  <span class="evCityName">{cityLabel}</span>
                </div>
              </div>
            </a>
          );
        })}

      </div>
    )}
    <a class="submitEventLink" href="/submit-event/">+ Submit an event →</a>
  </div>

  <!-- 3 — Advertisement -->
  <div class="displayAdSlot">
    <div class="adSlotLabel">Advertisement</div>
    <a class="displayAdCard" href={`/${city}/advertise/`}>
      <div class="displayAdInner">
        <div class="displayAdIcon">📢</div>
        <div class="displayAdTitle">Your Ad Here</div>
        <div class="displayAdDesc">Reach thousands of {cityCap} locals</div>
        <div class="displayAdCta">Advertise with us →</div>
      </div>
    </a>
  </div>

  <!-- 4 — Vibe Check poll -->
  <SidebarPoll />

  <!-- 5 — City Guides -->
  <div class="railSection">
    <div class="railHead">
      <span class="railTitle">City Guides</span>
      <a class="railMore" href={`/${city}/guides/`}>See all</a>
    </div>
    <div class="guideList">
      <a class="guideRow" href={`/${city}/guides/live/`}>🏠 Live in {cityCap}</a>
      <a class="guideRow" href={`/${city}/guides/work/`}>💼 Work in {cityCap}</a>
      <a class="guideRow" href={`/${city}/guides/play/`}>🎉 Play in {cityCap}</a>
      <a class="guideRow" href={`/${city}/guides/best-restaurants/`}>🍽️ Best Restaurants</a>
    </div>
  </div>

</aside>

<script>
  /* ── Sidebar Smart Slider ── */
  (function () {
    var slider = document.getElementById("sbSlider");
    if (!slider) return;

    var slides  = Array.prototype.slice.call(slider.querySelectorAll(".evSlide"));
    var dotsEl  = document.getElementById("sbDots");
    var dots    = dotsEl ? Array.prototype.slice.call(dotsEl.querySelectorAll(".sbDot")) : [];
    var current = 0;
    var total   = slides.length;
    var timer: ReturnType<typeof setInterval> | null = null;

    if (total <= 1) return;

    function goTo(idx: number) {
      slides[current].classList.remove("evSlide--active");
      slides[current].setAttribute("aria-hidden", "true");
      if (dots[current]) { dots[current].classList.remove("sbDot--active"); }

      current = (idx + total) % total;

      slides[current].classList.add("evSlide--active");
      slides[current].removeAttribute("aria-hidden");
      if (dots[current]) { dots[current].classList.add("sbDot--active"); }
    }

    function startAuto() {
      timer = setInterval(function () { goTo(current + 1); }, 5000);
    }
    function resetAuto() {
      if (timer) clearInterval(timer);
      startAuto();
    }

    dots.forEach(function (dot, i) {
      dot.addEventListener("click", function () { goTo(i); resetAuto(); });
    });

    /* Pause on hover */
    slider.addEventListener("mouseenter", function () { if (timer) clearInterval(timer); });
    slider.addEventListener("mouseleave", startAuto);

    startAuto();
  })();
</script>

<style>
  .articleSidebar {
    display: grid;
    gap: 24px;
    align-self: start;
    min-width: 0;
  }

  /* ── Newsletter ── */
  .nlStickyWrap { position: -webkit-sticky; position: sticky; top: 20px; z-index: 10; }
  .nlBox {
    padding: 40px 26px;
    border-radius: 16px;
    background: #f9d900;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .nlBoxHead {
    font-size: 28px; font-weight: 900; font-style: italic;
    color: #000; line-height: 1.05; letter-spacing: -0.04em;
  }
  .nlBoxHead strong { font-weight: 900; }
  .nlBoxSub { font-size: 15px; color: rgba(0,0,0,.8); line-height: 1.45; }
  .nlForm { display: flex; flex-direction: column; gap: 10px; margin-top: 6px; }
  .nlInput {
    width: 100%; box-sizing: border-box;
    padding: 14px 16px; border-radius: 10px;
    border: none; background: #fff;
    font-size: 15px; color: #111;
    box-shadow: 0 2px 8px rgba(0,0,0,.12);
    outline: 2px solid transparent; transition: outline-color 150ms;
  }
  .nlInput:focus { outline-color: #000; }
  .nlInput::placeholder { color: #aaa; }
  .nlSubmit {
    width: 100%; padding: 14px 0; border-radius: 999px;
    border: none; background: #000; color: #f9d900;
    font-family: "Century Gothic", AppleGothic, Arial, sans-serif;
    font-size: 15px; font-weight: 900; letter-spacing: .08em;
    cursor: pointer; transition: opacity 150ms;
  }
  .nlSubmit:hover { opacity: .82; }

  /* ── Rail sections ── */
  .railSection { display: grid; gap: 0; }
  .railHead {
    display: flex; justify-content: space-between; align-items: baseline;
    padding-bottom: 10px; border-bottom: 2px solid var(--brand1);
  }
  .railTitle {
    font-size: 16px; font-weight: 900; letter-spacing: .08em;
    text-transform: uppercase; color: var(--text);
  }
  .railMore { font-size: 13px; font-weight: 700; color: var(--link); text-decoration: none; }
  .railMore:hover { text-decoration: underline; }

  /* ── Events list ── */
  .eventList { display: grid; }

  /* ── Smart Slider (sponsored) ── */
  /* CSS grid overlap trick: all slides share one cell → container auto-sizes */
  .evSlider {
    display: grid;
    grid-template-columns: 1fr;
    margin-bottom: 4px;
    border-bottom: 1px solid var(--border);
  }
  .evSlide {
    grid-row: 1;
    grid-column: 1;
    display: grid; grid-template-columns: 48px 1fr; gap: 12px;
    align-items: center; text-decoration: none;
    padding: 13px 10px;
    background: rgba(249,217,0,.06);
    border-radius: 8px;
    margin: 8px -8px 0;
    opacity: 0;
    transition: opacity 500ms ease;
    pointer-events: none;
    position: relative; /* for .sponsoredBadge */
  }
  .evSlide--active {
    opacity: 1;
    pointer-events: auto;
  }
  /* Dots row is a separate grid row, not overlapping */
  .sbDots { grid-row: 2; grid-column: 1; }

  /* Dots for slider */
  .sbDots {
    display: flex; gap: 5px; justify-content: center;
    padding: 8px 0 4px;
  }
  .sbDot {
    width: 6px; height: 6px; border-radius: 50%;
    border: none; padding: 0;
    background: rgba(255,255,255,.25);
    cursor: pointer;
    transition: background 200ms, transform 200ms;
  }
  .sbDot--active {
    background: var(--brand1);
    transform: scale(1.3);
  }

  .eventRow {
    display: grid; grid-template-columns: 48px 1fr; gap: 12px;
    align-items: center; text-decoration: none;
    padding: 13px 0; border-bottom: 1px solid var(--border);
    transition: opacity 140ms;
  }
  .eventRow:last-child { border-bottom: none; }
  .eventRow:hover { opacity: .76; }

  .eventCal {
    width: 48px; height: 48px; border-radius: 10px;
    background: var(--pillBg); border: 1px solid var(--pillBorder);
    display: grid; place-items: center; text-align: center; line-height: 1;
  }
  .eDow { font-size: 10px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; color: var(--brand1); }
  .eDay { font-size: 19px; font-weight: 900; color: var(--text); margin-top: 1px; }
  .eMon { font-size: 8px; font-weight: 700; letter-spacing: .08em; color: var(--faint); text-transform: uppercase; }
  .eventInfo { display: flex; flex-direction: column; gap: 2px; }
  .eName { font-weight: 800; font-size: 15px; color: var(--text); line-height: 1.2; }
  .ePlace { font-size: 12px; color: var(--faint); display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
  .evCitySep { opacity: .4; }
  .evCityName { color: var(--brand1); font-weight: 700; }
  .noEvents { font-size: 13px; color: var(--faint); padding: 12px 0; margin: 0; }

  .sponsoredBadge {
    position: absolute;
    top: 6px; right: 8px;
    font-size: 9px; font-weight: 900; letter-spacing: .08em;
    background: var(--brand1); color: #000;
    padding: 2px 6px; border-radius: 999px;
  }
  .submitEventLink {
    display: block; margin-top: 12px;
    font-size: 12.5px; font-weight: 700;
    color: var(--brand1); text-decoration: none;
    opacity: .85; transition: opacity 120ms;
  }
  .submitEventLink:hover { opacity: 1; }

  /* ── Ad slot ── */
  .displayAdSlot { display: grid; gap: 5px; }
  .adSlotLabel {
    font-size: 8.5px; font-weight: 700; letter-spacing: .12em;
    text-transform: uppercase; color: var(--faint); text-align: center;
  }
  .displayAdCard {
    display: block; text-decoration: none; border-radius: 13px; overflow: hidden;
    background: #f9d900; transition: opacity 140ms;
  }
  .displayAdCard:hover { opacity: .9; }
  .displayAdInner { padding: 22px 14px; text-align: center; display: grid; gap: 5px; place-items: center; }
  .displayAdIcon { font-size: 24px; margin-bottom: 2px; }
  .displayAdTitle { font-size: 16px; font-weight: 900; color: #000; }
  .displayAdDesc { font-size: 14px; color: rgba(0,0,0,.78); line-height: 1.3; }
  .displayAdCta {
    margin-top: 6px; display: inline-flex; align-items: center;
    height: 30px; padding: 0 13px; border-radius: 999px;
    background: #000; color: #f9d900; font-size: 11.5px; font-weight: 800;
  }

  /* ── City Guides ── */
  .guideList { display: grid; }
  .guideRow {
    display: block; text-decoration: none; font-size: 15px; font-weight: 700;
    color: var(--text); padding: 11px 0; border-bottom: 1px solid var(--border);
    line-height: 1.3; transition: color 120ms;
  }
  .guideRow:last-child { border-bottom: none; }
  .guideRow:hover { color: var(--link); }
</style>
