---
/**
 * NavMenu: single source of truth for pills + drawer links.
 * - No Subscribe CTA here (subscribe happens via the newsletter module).
 * - Advertise sits in the main pill row next to The Buy.
 * - Mobile pills: horizontal scroll, never clipped/hidden.
 */
const base = Astro.props?.cityBase ? `/${Astro.props.cityBase}` : "";
const cityBase = base || "/daytona";

const pills = [
  { label: "Home", href: `${cityBase}/` },
  { label: "Topics", href: `${cityBase}/topics/` },
  { label: "Guides", href: `${cityBase}/guides/` },
  { label: "Events", href: `${cityBase}/events/` },
  { label: "Jobs", href: `${cityBase}/jobs/` },
  { label: "Games", href: `${cityBase}/games/` },
  { label: "The Buy", href: `${cityBase}/buy/` },
  { label: "Advertise", href: `${cityBase}/advertise/` },
];

// Drawer links should match pills exactly (no duplicates beyond this list)
const drawerLinks = pills;
---

<nav class="navMenu" aria-label="Primary navigation">
  <div class="pillRow" role="navigation" aria-label="Site sections">
    {pills.map((p) => (
      <a class="pill" href={p.href}>{p.label}</a>
    ))}
  </div>

  <!-- Drawer (checkbox/label pattern, no JS) -->
  <input id="navToggle" class="navToggle" type="checkbox" />
  <label class="menuBtn" for="navToggle" aria-label="Open menu">
    <span class="burger" aria-hidden="true"><span></span></span>
    <span class="menuText">Menu</span>
  </label>

  <label class="backdrop" for="navToggle" aria-hidden="true"></label>

  <aside class="drawer" aria-label="Site menu">
    <div class="drawerHead">
      <div class="drawerTitle">Menu</div>
      <label class="closeBtn" for="navToggle" aria-label="Close menu">✕</label>
    </div>

    <!-- ONE clean nav list only -->
    <div class="drawerLinks">
      {drawerLinks.map((p) => (
        <a class="drawerLink" href={p.href}>{p.label}</a>
      ))}
    </div>
  </aside>
</nav>

<style>
  .navMenu {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Main pills row */
  .pillRow {
  display: flex;
  gap: 12px;
  align-items: center;
  flex: 1 1 auto;

  justify-content: center; /* centers the pills */
}

  .pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  height: 40px;
  padding: 0 16px;

  border-radius: 999px;

  border: 1px solid rgba(255,210,74,.55);
  background: rgba(255,210,74,.14);

  color: rgba(255,210,74,.95);

  font-weight: 950;
  font-size: 14px;

  text-decoration: none;
  white-space: nowrap;

  transition: transform 140ms ease, background 140ms ease;
}

.pill:hover {
  background: rgba(255,210,74,.22);
  transform: translateY(-1px);
}

  /* Mobile pills: NEVER disappear; allow scroll instead of clipping */
  @media (max-width: 760px) {
    .pillRow {
      gap: 6px;                    /* closer together first */
      overflow-x: auto;            /* scroll if too many */
      overflow-y: visible;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 2px;
      scrollbar-width: none;
    }
    .pillRow::-webkit-scrollbar { display: none; }

    .pill {
      height: 32px;
      padding: 0 10px;
      font-size: 12px;
    }
  }

  /* Drawer */
  .navToggle { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }

  .menuBtn {
    display: none;
    align-items: center;
    gap: 8px;
    border-radius: 12px;
    padding: 8px 10px;
    border: 1px solid rgba(255,210,74,.40);
    background: rgba(255,210,74,.10);
    color: rgba(232,237,244,.92);
    font-weight: 900;
    cursor: pointer;
    user-select: none;
  }
  .menuText { font-size: 12.5px; }

  .burger { width: 18px; height: 12px; position: relative; display: inline-block; }
  .burger::before, .burger::after, .burger span {
    content: "";
    position: absolute;
    left: 0; right: 0;
    height: 2px;
    border-radius: 2px;
    background: rgba(232,237,244,.92);
  }
  .burger::before { top: 0; }
  .burger span { top: 5px; }
  .burger::after { bottom: 0; }

  .backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.55);
    backdrop-filter: blur(2px);
    z-index: 90;
  }
  .drawer {
    position: fixed;
    top: 0; right: 0;
    height: 100dvh;
    width: min(86vw, 360px);
    background: #0b0d10;
    border-left: 1px solid rgba(255,255,255,.10);
    box-shadow: -20px 0 60px rgba(0,0,0,.45);
    transform: translateX(100%);
    transition: transform 220ms ease;
    z-index: 100;
    display: grid;
    grid-template-rows: auto 1fr;
  }
  .drawerHead {
    padding: 14px 14px 12px;
    border-bottom: 1px solid rgba(255,255,255,.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .drawerTitle { font-weight: 950; color: rgba(232,237,244,.92); }
  .closeBtn {
    width: 34px; height: 34px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.03);
    color: rgba(232,237,244,.86);
    cursor: pointer;
    user-select: none;
  }
  .drawerLinks { padding: 12px 14px 16px; display: grid; gap: 8px; overflow: auto; }
  .drawerLink {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: rgba(232,237,244,.86);
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.02);
    border-radius: 12px;
    padding: 12px 12px;
    font-weight: 850;
  }

  /* Only show hamburger when needed */
  @media (max-width: 760px) {
    .menuBtn { display: inline-flex; }
  }

  .navToggle:checked ~ .backdrop { display: block; }
  .navToggle:checked ~ .drawer { transform: translateX(0); }
</style>
