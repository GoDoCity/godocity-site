---
/**
 * NavMenu: single source of truth for pills + drawer links.
 * - No Subscribe CTA here (subscribe happens via the newsletter module).
 * - Advertise sits in the main pill row next to The Buy.
 * - Mobile pills: horizontal scroll, never clipped/hidden.
 */
const base = Astro.props?.cityBase ? `/${Astro.props.cityBase}` : "";
const cityBase = base || "/daytona";

const pills = [
  { label: "Home", href: `${cityBase}/` },
  { label: "Topics", href: `${cityBase}/topics/` },
  { label: "Guides", href: `${cityBase}/guides/` },
  { label: "Events", href: `${cityBase}/events/` },
  { label: "Jobs", href: `${cityBase}/jobs/` },
  { label: "Games", href: `${cityBase}/games/` },
  { label: "The Buy", href: `${cityBase}/buy/` },
  { label: "Advertise", href: `${cityBase}/advertise/` },
];

// Drawer links should match pills exactly (no duplicates beyond this list)
const drawerLinks = pills;
---

<nav class="navMenu" aria-label="Primary navigation">
  <div class="pillRow" role="navigation" aria-label="Site sections">
    {pills.map((p) => (
      <a class="pill" href={p.href}>{p.label}</a>
    ))}
  </div>

  <!-- Drawer (checkbox/label pattern, no JS) -->
  <input id="navToggle" class="navToggle" type="checkbox" />
  <label class="menuBtn" for="navToggle" aria-label="Open menu">
    <span class="burger" aria-hidden="true"><span></span></span>
    <span class="menuText">Menu</span>
  </label>

  <label class="backdrop" for="navToggle" aria-hidden="true"></label>

  <aside class="drawer" aria-label="Site menu">
    <div class="drawerHead">
      <div class="drawerTitle">Menu</div>
      <label class="closeBtn" for="navToggle" aria-label="Close menu">✕</label>
    </div>

    <!-- ONE clean nav list only -->
    <div class="drawerLinks">
      {drawerLinks.map((p) => (
        <a class="drawerLink" href={p.href}>{p.label}</a>
      ))}
    </div>
  </aside>
</nav>

<style>
  .navMenu {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
  }

  /* Main pills row */
  .pillRow {
    display: flex;
    gap: 12px;
    align-items: center;
    flex: 1 1 auto;
    justify-content: center;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid var(--pillBorder);
    background: var(--pillBg);
    color: var(--brand1);
    font-weight: 950;
    font-size: 14px;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 140ms ease, background 140ms ease;
  }

  .pill:hover {
    border-color: color-mix(in srgb, var(--brand2) 70%, transparent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand2) 18%, transparent);
    transform: translateY(-1px);
  }

  /* ── Hamburger button: HIDDEN on desktop ── */
  .menuBtn {
    display: none;   /* hidden by default; shown only on mobile below */
    align-items: center;
    gap: 8px;
    border-radius: 12px;
    padding: 8px 10px;
    border: 1px solid var(--pillBorder);
    background: var(--pillBg);
    color: var(--text);
    font-weight: 900;
    cursor: pointer;
    user-select: none;
    flex-shrink: 0;
  }
  .menuText { font-size: 12.5px; }

  .burger {
    width: 18px; height: 12px;
    position: relative;
    display: inline-block;
  }
  .burger::before, .burger::after, .burger span {
    content: "";
    position: absolute;
    left: 0; right: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--text);
  }
  .burger::before { top: 0; }
  .burger span { top: 5px; }
  .burger::after { bottom: 0; }

  /* Checkbox: always hidden */
  .navToggle {
    position: absolute;
    width: 1px; height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  /* Backdrop: hidden until drawer opens */
  .backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.55);
    backdrop-filter: blur(2px);
    z-index: 90;
  }

  /* Drawer: always off-screen to the right */
  .drawer {
    position: fixed;
    top: 0; right: 0;
    height: 100dvh;
    width: min(86vw, 320px);
    background: var(--bg, #0b0d10);
    border-left: 1px solid var(--border, rgba(255,255,255,.10));
    box-shadow: -20px 0 60px rgba(0,0,0,.45);
    transform: translateX(110%);   /* 110% guarantees fully hidden */
    transition: transform 220ms ease;
    z-index: 100;
    display: grid;
    grid-template-rows: auto 1fr;
    visibility: hidden;            /* also hide from accessibility tree */
  }

  .drawerHead {
    padding: 14px 14px 12px;
    border-bottom: 1px solid rgba(255,255,255,.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .drawerTitle { font-weight: 950; color: var(--text); }
  .closeBtn {
    width: 34px; height: 34px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.03);
    color: var(--text);
    cursor: pointer;
    user-select: none;
  }
  .drawerLinks {
    padding: 12px 14px 16px;
    display: grid;
    gap: 8px;
    overflow: auto;
  }
  .drawerLink {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--text);
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.02);
    border-radius: 12px;
    padding: 12px;
    font-weight: 700;
  }
  .drawerLink:hover {
    border-color: var(--pillBorder);
    background: var(--pillBg);
  }

  /* ── Mobile: show hamburger, allow pill scroll ── */
  @media (max-width: 760px) {
    .menuBtn { display: inline-flex; }

    .pillRow {
      gap: 6px;
      overflow-x: auto;
      overflow-y: visible;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 2px;
      scrollbar-width: none;
      justify-content: flex-start;
    }
    .pillRow::-webkit-scrollbar { display: none; }

    .pill {
      height: 36px;
      padding: 0 14px;
      font-size: 13px;
    }
  }

  /* ── Drawer open state ── */
  .navToggle:checked ~ .backdrop { display: block; }
  .navToggle:checked ~ .drawer {
    transform: translateX(0);
    visibility: visible;
  }
</style>
