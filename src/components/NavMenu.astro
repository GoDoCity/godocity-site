---
/**
 * NavMenu — pills + dropdowns + mobile drawer
 * Topics: 2-column pill grid dropdown
 * Guides: simple 3-item dropdown
 * Hover on desktop opens dropdown; click also toggles (JS inline)
 * Fix: invisible padding bridge on dropdown prevents gap-flicker
 * Fix: 100ms close delay so pills are clickable before menu hides
 */
const base = Astro.props?.cityBase ? `/${Astro.props.cityBase}` : "";
const cityBase = base || "/daytona";

const topicItems = [
  { label: "Biz",               href: `${cityBase}/biz/` },
  { label: "City",              href: `${cityBase}/city/` },
  { label: "Culture",           href: `${cityBase}/culture/` },
  { label: "Food",              href: `${cityBase}/food/` },
  { label: "History",           href: `${cityBase}/history/` },
  { label: "Real Estate",       href: `${cityBase}/real-estate/` },
  { label: "Sports",            href: `${cityBase}/sports/` },
  { label: "Travel & Outdoors", href: `${cityBase}/travel-outdoors/` },
  { label: "Wellness",          href: `${cityBase}/wellness/` },
];

const guideItems = [
  { label: "Live", emoji: "🏠", href: `${cityBase}/guides/live/` },
  { label: "Work", emoji: "💼", href: `${cityBase}/guides/work/` },
  { label: "Play", emoji: "🎉", href: `${cityBase}/guides/play/` },
];

const pills = [
  { label: "Home",      href: `${cityBase}/`,           dropdown: null },
  { label: "Topics",    href: `${cityBase}/topics/`,    dropdown: "topics" },
  { label: "Guides",    href: `${cityBase}/guides/`,    dropdown: "guides" },
  { label: "Events",    href: `${cityBase}/events/`,    dropdown: null },
  { label: "Jobs",      href: `${cityBase}/jobs/`,      dropdown: null },
  { label: "Advertise", href: `${cityBase}/advertise/`, dropdown: null },
];
---

<nav class="navMenu" aria-label="Primary navigation">

  <div class="pillRow" role="navigation" aria-label="Site sections">
    {pills.map((p) => (
      p.dropdown ? (
        <div class="dropWrap" data-drop={p.dropdown}>
          <a class="pill pillDrop" href={p.href} aria-haspopup="true" aria-expanded="false">
            {p.label}
            <svg class="dropArrow" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
              <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </a>

          {p.dropdown === "topics" && (
            <div class="dropdown topicsDropdown" role="menu">
              {/* Invisible bridge fills the gap so cursor stays in hover zone */}
              <div class="dropBridge" aria-hidden="true"></div>
              <div class="dropInner">
                <div class="dropGrid">
                  {topicItems.map((t) => (
                    <a class="dropPill" href={t.href} role="menuitem">{t.label}</a>
                  ))}
                </div>
                <a class="dropFooter" href={`${cityBase}/topics/`}>Browse all topics →</a>
              </div>
            </div>
          )}

          {p.dropdown === "guides" && (
            <div class="dropdown guidesDropdown" role="menu">
              <div class="dropBridge" aria-hidden="true"></div>
              <div class="dropInner">
                <div class="guideList">
                  {guideItems.map((g) => (
                    <a class="guideDropItem" href={g.href} role="menuitem">
                      <span class="guideIcon">{g.emoji}</span>
                      <span class="guideItemLabel">{g.label}</span>
                    </a>
                  ))}
                </div>
                <a class="dropFooter" href={`${cityBase}/guides/`}>All city guides →</a>
              </div>
            </div>
          )}
        </div>
      ) : (
        <a class="pill" href={p.href}>{p.label}</a>
      )
    ))}
  </div>

  <!-- Mobile hamburger -->
  <input id="navToggle" class="navToggle" type="checkbox" />
  <label class="menuBtn" for="navToggle" aria-label="Open menu">
    <span class="burger" aria-hidden="true"><span></span></span>
    <span class="menuText">Menu</span>
  </label>

  <label class="backdrop" for="navToggle" aria-hidden="true"></label>

  <aside class="drawer" aria-label="Site menu">
    <div class="drawerHead">
      <div class="drawerTitle">Menu</div>
      <label class="closeBtn" for="navToggle" aria-label="Close menu">✕</label>
    </div>
    <div class="drawerLinks">
      <a class="drawerLink" href={`${cityBase}/`}>Home</a>
      <div class="drawerSection">
        <div class="drawerSectionLabel">Topics</div>
        <div class="drawerPillGrid">
          {topicItems.map((t) => (
            <a class="drawerPill" href={t.href}>{t.label}</a>
          ))}
        </div>
      </div>
      <div class="drawerSection">
        <div class="drawerSectionLabel">Guides</div>
        {guideItems.map((g) => (
          <a class="drawerLink" href={g.href}>{g.emoji} {g.label}</a>
        ))}
      </div>
      <a class="drawerLink" href={`${cityBase}/events/`}>Events</a>
      <a class="drawerLink" href={`${cityBase}/jobs/`}>Jobs</a>
      <a class="drawerLink drawerAdvertise" href={`${cityBase}/advertise/`}>Advertise</a>
    </div>
  </aside>
</nav>

<script is:inline>
(function () {
  function init() {
    var closeTimers = {};

    document.querySelectorAll(".dropWrap").forEach(function (wrap) {
      var key = wrap.dataset.drop;
      var pill = wrap.querySelector(".pillDrop");

      function openWrap() {
        clearTimeout(closeTimers[key]);
        closeAll(key);
        wrap.classList.add("open");
        pill.setAttribute("aria-expanded", "true");
      }

      function scheduleClose() {
        /* 100ms delay — gives user time to move into the dropdown */
        closeTimers[key] = setTimeout(function () {
          wrap.classList.remove("open");
          pill.setAttribute("aria-expanded", "false");
        }, 100);
      }

      function cancelClose() {
        clearTimeout(closeTimers[key]);
      }

      /* Hover */
      wrap.addEventListener("mouseenter", openWrap);
      wrap.addEventListener("mouseleave", scheduleClose);

      var drop = wrap.querySelector(".dropdown");
      if (drop) {
        drop.addEventListener("mouseenter", cancelClose);
        drop.addEventListener("mouseleave", scheduleClose);
      }

      /* Click toggle */
      pill.addEventListener("click", function (e) {
        e.preventDefault();
        if (wrap.classList.contains("open")) {
          wrap.classList.remove("open");
          pill.setAttribute("aria-expanded", "false");
        } else {
          openWrap();
        }
      });
    });

    /* Close on outside click */
    document.addEventListener("click", function (e) {
      if (!e.target.closest(".dropWrap")) closeAll();
    });

    /* Close on Escape */
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") closeAll();
    });

    function closeAll(except) {
      document.querySelectorAll(".dropWrap.open").forEach(function (w) {
        if (w.dataset.drop === except) return;
        w.classList.remove("open");
        var p = w.querySelector(".pillDrop");
        if (p) p.setAttribute("aria-expanded", "false");
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>

<style>
  .navMenu {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
  }

  .pillRow {
    display: flex;
    gap: 10px;
    align-items: center;
    flex: 1 1 auto;
    justify-content: center;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid var(--pillBorder);
    background: var(--pillBg);
    color: var(--brand1);
    font-family: "Century Gothic", AppleGothic, Arial, sans-serif;
    font-weight: 950;
    font-size: 14px;
    letter-spacing: -0.02em;  /* tighter tracking for Century Gothic width */
    text-decoration: none;
    white-space: nowrap;
    transition: transform 140ms ease, background 140ms ease, border-color 140ms ease;
  }
  .pill:hover {
    border-color: color-mix(in srgb, var(--brand2) 70%, transparent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand2) 18%, transparent);
    transform: translateY(-1px);
  }

  .dropArrow {
    flex-shrink: 0;
    transition: transform 200ms ease;
  }

  /* ── Dropdown wrapper ── */
  .dropWrap { position: relative; }

  /* Hover open */
  @media (hover: hover) {
    .dropWrap:hover > .dropdown {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
      visibility: visible;
    }
    .dropWrap:hover > .pillDrop .dropArrow {
      transform: rotate(180deg);
    }
  }

  /* JS .open class */
  .dropWrap.open > .dropdown {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    visibility: visible;
  }
  .dropWrap.open > .pillDrop .dropArrow {
    transform: rotate(180deg);
  }

  /* ── Dropdown panel — left-edge anchored to pill ── */
  .dropdown {
    position: absolute;
    top: 100%;           /* flush below pill */
    left: 0;             /* anchors to left edge of pill — no centre-drift */
    transform: translateY(-4px);
    z-index: 200;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 180ms ease, transform 180ms ease;
    min-width: 280px;
    padding-top: 8px;
  }

  /* The visible panel lives inside dropInner */
  .dropInner {
    background: var(--bg, #0b0d10);
    border: 1px solid var(--border, rgba(255,255,255,.12));
    border-radius: 16px;
    box-shadow: 0 16px 48px rgba(0,0,0,.45), 0 2px 8px rgba(0,0,0,.3);
    overflow: hidden;
  }

  /* Invisible bridge: fills the padding-top area so hover is continuous */
  .dropBridge {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 8px; /* matches padding-top */
    background: transparent;
  }

  .topicsDropdown { min-width: 340px; }
  .dropGrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    padding: 16px 16px 12px;
  }
  .dropPill {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    border-radius: 999px;
    border: 1px solid var(--pillBorder);
    background: var(--pillBg);
    color: var(--brand1);
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    transition: background 140ms, border-color 140ms, transform 120ms;
  }
  .dropPill:hover {
    border-color: var(--brand1);
    transform: translateY(-1px);
    background: color-mix(in srgb, var(--brand1) 14%, transparent);
  }

  .guidesDropdown { min-width: 200px; }
  .guideList { padding: 12px 12px 8px; display: grid; gap: 4px; }
  .guideDropItem {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 12px; border-radius: 10px;
    text-decoration: none; color: var(--text);
    font-size: 15px; font-weight: 800;
    transition: background 140ms;
  }
  .guideDropItem:hover { background: var(--pillBg); color: var(--brand1); }
  .guideIcon { font-size: 18px; flex-shrink: 0; }

  .dropFooter {
    display: block;
    padding: 10px 16px;
    border-top: 1px solid var(--border, rgba(255,255,255,.08));
    font-size: 12.5px; font-weight: 700;
    color: var(--brand1); text-decoration: none;
    text-align: center; transition: background 140ms;
  }
  .dropFooter:hover { background: var(--pillBg); }

  /* ── Hamburger ── */
  .menuBtn {
    display: none;
    align-items: center; gap: 8px;
    border-radius: 12px; padding: 8px 10px;
    border: 1px solid var(--pillBorder);
    background: var(--pillBg); color: var(--text);
    font-weight: 900; cursor: pointer;
    user-select: none; flex-shrink: 0;
  }
  .menuText { font-size: 12.5px; }
  .burger { width: 18px; height: 12px; position: relative; display: inline-block; }
  .burger::before, .burger::after, .burger span {
    content: ""; position: absolute;
    left: 0; right: 0; height: 2px;
    border-radius: 2px; background: var(--text);
  }
  .burger::before { top: 0; }
  .burger span { top: 5px; }
  .burger::after { bottom: 0; }

  .navToggle {
    position: absolute; width: 1px; height: 1px;
    opacity: 0; pointer-events: none;
  }

  .backdrop {
    display: none; position: fixed; inset: 0;
    background: rgba(0,0,0,.55);
    backdrop-filter: blur(2px); z-index: 90;
  }

  .drawer {
    position: fixed; top: 0; right: 0;
    height: 100dvh; width: min(86vw, 320px);
    background: var(--bg, #0b0d10);
    border-left: 1px solid var(--border, rgba(255,255,255,.10));
    box-shadow: -20px 0 60px rgba(0,0,0,.45);
    transform: translateX(110%);
    transition: transform 220ms ease;
    z-index: 100;
    display: grid; grid-template-rows: auto 1fr;
    visibility: hidden;
  }
  .drawerHead {
    padding: 14px 14px 12px;
    border-bottom: 1px solid rgba(255,255,255,.08);
    display: flex; align-items: center;
    justify-content: space-between; gap: 10px;
  }
  .drawerTitle { font-weight: 950; color: var(--text); }
  .closeBtn {
    width: 34px; height: 34px; border-radius: 10px;
    display: grid; place-items: center;
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.03);
    color: var(--text); cursor: pointer; user-select: none;
  }
  .drawerLinks {
    padding: 12px 14px 24px;
    display: grid; gap: 6px;
    overflow-y: auto; align-content: start;
  }
  .drawerLink {
    display: flex; align-items: center;
    text-decoration: none; color: var(--text);
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.02);
    border-radius: 12px; padding: 12px;
    font-weight: 700;
    transition: border-color 140ms, background 140ms;
  }
  .drawerLink:hover { border-color: var(--pillBorder); background: var(--pillBg); }
  .drawerAdvertise {
    background: var(--pillBg); border-color: var(--pillBorder);
    color: var(--brand1); font-weight: 900; margin-top: 4px;
  }
  .drawerSection { display: grid; gap: 6px; padding: 10px 0 4px; border-top: 1px solid rgba(255,255,255,.07); }
  .drawerSectionLabel {
    font-size: 10px; font-weight: 900;
    letter-spacing: .14em; text-transform: uppercase;
    color: var(--brand1); padding: 0 2px;
  }
  .drawerPillGrid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .drawerPill {
    display: flex; align-items: center; justify-content: center;
    height: 34px; border-radius: 999px;
    border: 1px solid var(--pillBorder); background: var(--pillBg);
    color: var(--brand1); font-size: 12.5px; font-weight: 800;
    text-decoration: none; text-align: center;
    transition: background 140ms;
  }
  .drawerPill:hover { background: color-mix(in srgb, var(--brand1) 18%, transparent); }

  @media (max-width: 760px) {
    .menuBtn { display: inline-flex; }
    /* Hide pill row on mobile — drawer handles all navigation */
    .pillRow { display: none; }
    .dropdown { display: none; }
  }

  .navToggle:checked ~ .backdrop { display: block; }
  .navToggle:checked ~ .drawer { transform: translateX(0); visibility: visible; }
</style>
