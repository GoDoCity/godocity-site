---
export interface Props {
  title?: string;
  question?: string;
  options?: { label: string; votes: number }[];
  pollId?: string;
  formAction?: string;
}

const {
  title = "Vibe Check: Best of Ormond",
  question = "Who has the best tacos in Ormond?",
  options = [
    { label: "La Fiesta",         votes: 112 + Math.floor(Math.random() * 36) },
    { label: "Tortilla Republic", votes: 112 + Math.floor(Math.random() * 36) },
    { label: "Cabo's Mexican",    votes: 112 + Math.floor(Math.random() * 36) },
    { label: "Other",             votes: 112 + Math.floor(Math.random() * 36) },
  ],
  pollId = "ormond-tacos",
  formAction = "#",
} = Astro.props;

const total = options.reduce((s, o) => s + o.votes, 0);
---

<div class="pollCard" data-poll-id={pollId} data-question={question}>
  <div class="pollTitle">{title}</div>
  <div class="pollQuestion">{question}</div>

  <!-- Voting form -->
  <form class="pollForm" data-poll-form action={formAction} method="POST">
    {options.map((opt) => (
      <label class="pollOption" data-option>
        <input
          class="pollRadio"
          type="radio"
          name={`poll-${pollId}`}
          value={opt.label}
        />
        <span class="pollLabel">{opt.label}</span>
      </label>
    ))}
    <button class="pollBtn" type="submit">Cast My Vote</button>
  </form>

  <!-- Loading state -->
  <div class="pollLoading" data-poll-loading hidden>
    <div class="pollSpinner"></div>
  </div>

  <!-- Results view (shown after voting) -->
  <div class="pollResults" data-poll-results hidden>
    {options.map((opt) => (
      <div class="pollResultRow" data-result-row data-label={opt.label}>
        <div class="pollResultHeader">
          <span class="pollResultLabel">{opt.label}</span>
          <span class="pollResultPct" data-result-pct>—</span>
        </div>
        <div class="pollResultBar">
          <div class="pollResultFill" data-result-fill style="width: 0%"></div>
        </div>
      </div>
    ))}
  </div>

  <div class="pollThanks" data-poll-thanks hidden>
    <span class="pollThanksIcon">✓</span> Thanks for voting!
  </div>

  <div class="pollFooter" data-poll-footer>{total.toLocaleString()} votes cast</div>
</div>

<script>
  import { createClient } from "@supabase/supabase-js";

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  function updateResultsView(
    card: Element,
    counts: Record<string, number>,
    combinedTotal: number,
    realVotes: number
  ) {
    card.querySelectorAll<HTMLElement>("[data-result-row]").forEach((row) => {
      const label = row.dataset.label ?? "";
      const pct =
        combinedTotal > 0
          ? Math.round(((counts[label] ?? 0) / combinedTotal) * 100)
          : 0;
      const fill = row.querySelector<HTMLElement>("[data-result-fill]");
      const pctEl = row.querySelector<HTMLElement>("[data-result-pct]");
      if (fill) fill.style.width = `${pct}%`;
      if (pctEl) pctEl.textContent = `${pct}%`;
    });
    const footer = card.querySelector<HTMLElement>("[data-poll-footer]");
    if (footer)
      footer.textContent = `${combinedTotal.toLocaleString()} votes cast`;
  }

  function showResultsView(card: Element) {
    const form = card.querySelector<HTMLFormElement>("[data-poll-form]");
    const results = card.querySelector<HTMLElement>("[data-poll-results]");
    const loading = card.querySelector<HTMLElement>("[data-poll-loading]");
    const thanks = card.querySelector<HTMLElement>("[data-poll-thanks]");
    if (loading) { loading.hidden = true; loading.style.display = "none"; }
    if (form) form.remove();
    if (results) results.hidden = false;
    if (thanks) thanks.hidden = false;
  }

  async function fetchAndShowResults(card: Element, pollId: string) {
    const loading = card.querySelector<HTMLElement>("[data-poll-loading]");
    const form = card.querySelector<HTMLFormElement>("[data-poll-form]");
    if (form) form.style.display = "none";
    if (loading) loading.hidden = false;

    // Generate random base: 101–501
    const randomBase = Math.floor(Math.random() * 401) + 101;

    const { data, error } = await supabase
      .from("vibe_check_votes")
      .select("option_selected")
      .eq("question_text", "ormond-tacos");

    // Kill spinner immediately when data arrives
    if (loading) { loading.hidden = true; loading.style.display = "none"; }

    console.log("[SidebarPoll] fetchAndShowResults — pollId:", pollId);
    console.log("[SidebarPoll] data:", data, "| error:", error);

    if (data && data.length > 0) {
      const realVotes = data.length;
      const combinedTotal = realVotes + randomBase;
      const counts: Record<string, number> = {};
      data.forEach((row) => {
        counts[row.option_selected] = (counts[row.option_selected] ?? 0) + 1;
      });
      updateResultsView(card, counts, combinedTotal, realVotes);
    } else {
      // Zero votes or Supabase error — show 0% for all options
      updateResultsView(card, {}, randomBase, 0);
    }
    showResultsView(card);
  }

  async function initPoll(card: Element) {
    const form = card.querySelector<HTMLFormElement>("[data-poll-form]");
    const loading = card.querySelector<HTMLElement>("[data-poll-loading]");
    const btn = card.querySelector<HTMLButtonElement>(".pollBtn");
    if (!form || !loading || !btn) return;

    const pollId = (card as HTMLElement).dataset.pollId ?? "poll";
    const storageKey = `poll-voted-${pollId}`;

    // STRESS-TEST MODE: localStorage check disabled — allows voting multiple times
    // Re-enable this block when done testing:
    // if (localStorage.getItem(storageKey)) {
    //   await fetchAndShowResults(card, pollId);
    //   return;
    // }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const checked = form.querySelector<HTMLInputElement>(
        'input[type="radio"]:checked'
      );
      if (!checked) {
        btn.animate(
          [
            { transform: "translateX(-4px)" },
            { transform: "translateX(4px)" },
            { transform: "none" },
          ],
          { duration: 180, iterations: 2 }
        );
        return;
      }

      const selectedOption = checked.value;
      localStorage.setItem(storageKey, selectedOption);

      // Show loading immediately
      form.style.display = "none";
      loading.hidden = false;

      // INSERT vote with hardcoded poll ID, then immediately fetch live counts
      const { error: insertError } = await supabase.from("vibe_check_votes").insert({
        option_selected: selectedOption,
        question_text: "ormond-tacos",
      });
      console.log("[SidebarPoll] insert — option:", selectedOption, "| pollId: ormond-tacos | error:", insertError);

      await fetchAndShowResults(card, "ormond-tacos");
    });
  }

  document.querySelectorAll(".pollCard").forEach(initPoll);
</script>

<style>
  .pollCard {
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.035);
    padding: 16px;
    max-width: 680px;
  }

  .pollTitle {
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand1);
    margin-bottom: 8px;
  }

  .pollQuestion {
    font-weight: 950;
    font-size: 18px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--text);
    margin-bottom: 14px;
  }

  .pollForm {
    display: grid;
    gap: 6px;
  }

  .pollOption {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 8px;
    cursor: pointer;
    padding: 8px 10px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(255, 255, 255, 0.02);
    transition: background 120ms, border-color 120ms;
    align-items: center;
  }
  .pollOption:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 220, 80, 0.18);
  }
  .pollOption:has(input:checked) {
    background: rgba(255, 220, 80, 0.08);
    border-color: rgba(255, 220, 80, 0.3);
  }

  .pollRadio {
    /* visually hidden but accessible */
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .pollLabel {
    font-size: 16.5px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.2;
  }

  .pollBtn {
    margin-top: 6px;
    width: 100%;
    padding: 11px 14px;
    border-radius: 12px;
    border: 2px solid var(--brand1);
    background: var(--brand1);
    color: #000;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.04em;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 2px;
    transition: background 140ms, color 140ms, text-decoration-color 140ms,
      box-shadow 140ms;
  }
  .pollBtn:hover {
    background: #fff;
    color: #000;
    text-decoration-color: #000;
    box-shadow: 0 0 0 3px var(--brand1), 0 2px 10px rgba(0, 0, 0, 0.18);
  }

  /* ── Loading spinner ── */
  .pollLoading {
    display: flex;
    justify-content: center;
    padding: 20px 0;
  }
  .pollSpinner {
    width: 24px;
    height: 24px;
    border: 3px solid rgba(255, 210, 74, 0.2);
    border-top-color: #ffd24a;
    border-radius: 50%;
    animation: pollSpin 0.6s linear infinite;
  }
  @keyframes pollSpin {
    to {
      transform: rotate(360deg);
    }
  }

  /* ── Results view ── */
  .pollResults {
    display: grid;
    gap: 10px;
  }

  .pollResultRow {
    display: grid;
    gap: 5px;
  }

  .pollResultHeader {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .pollResultLabel {
    font-size: 16.5px;
    font-weight: 700;
    color: var(--text);
  }

  .pollResultPct {
    font-size: 13px;
    font-weight: 800;
    color: #ffd24a;
    white-space: nowrap;
    margin-left: 8px;
  }

  .pollResultBar {
    height: 8px;
    border-radius: 999px;
    background: rgba(16, 24, 36, 0.75);
    overflow: hidden;
  }

  .pollResultFill {
    height: 100%;
    background: #ffd24a;
    border-radius: 999px;
    transition: width 600ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* ── Thank you confirmation ── */
  .pollThanks {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--brand1);
    padding: 12px 4px 4px;
  }
  .pollThanksIcon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--brand1);
    color: #000;
    font-size: 11px;
    font-weight: 900;
    flex-shrink: 0;
  }

  /* ── Footer ── */
  .pollFooter {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 12.5px;
    font-weight: 700;
    opacity: 1;
    color: var(--muted);
  }
</style>
