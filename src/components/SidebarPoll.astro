---
export interface Props {
  title?: string;
  question?: string;
  options?: { label: string; votes: number }[];
  pollId?: string;
}

const {
  title = "Vibe Check: Best of Daytona",
  question = "Best Beachside Burger?",
  options = [
    { label: "Hyde Park", votes: 41 },
    { label: "31 Supper Club", votes: 29 },
    { label: "Burger Ten", votes: 19 },
    { label: "Other", votes: 11 },
  ],
  pollId = "beachside-burger",
} = Astro.props;

// Seed votes provide social proof — randomised at build time (112–147)
const seedVotes = 112 + Math.floor(Math.random() * 36);
const total = options.reduce((s, o) => s + o.votes, 0);
const displayTotal = total + seedVotes;
---

<div class="pollCard" data-poll-id={pollId}>
  <div class="pollTitle">{title}</div>
  <div class="pollQuestion">{question}</div>

  <form class="pollForm" data-poll-form>
    {options.map((opt, i) => (
      <label class="pollOption" data-option>
        <input
          class="pollRadio"
          type="radio"
          name={`poll-${pollId}`}
          value={i}
        />
        <span class="pollLabel">{opt.label}</span>
        <span class="pollBar" aria-hidden="true">
          <span
            class="pollFill"
            style={`width: ${Math.round((opt.votes / total) * 100)}%`}
          ></span>
        </span>
        <span class="pollPct">{Math.round((opt.votes / total) * 100)}%</span>
      </label>
    ))}

    <button class="pollBtn" type="submit">Vote</button>
  </form>

  <div class="pollThanks" data-poll-thanks hidden>
    <span class="pollThanksIcon">✓</span> Thanks for voting!
  </div>

  <div class="pollFooter">{displayTotal.toLocaleString()} votes cast</div>
</div>

<script>
  function initPoll(card: Element) {
    const form = card.querySelector<HTMLFormElement>("[data-poll-form]");
    const thanks = card.querySelector<HTMLElement>("[data-poll-thanks]");
    const btn = card.querySelector<HTMLButtonElement>(".pollBtn");
    if (!form || !thanks || !btn) return;

    const pollId = (card as HTMLElement).dataset.pollId ?? "poll";
    const storageKey = `poll-voted-${pollId}`;

    // If already voted this session, skip form and show thanks directly
    if (sessionStorage.getItem(storageKey)) {
      form.replaceWith(thanks!);
      thanks!.hidden = false;
      return;
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const checked = form.querySelector<HTMLInputElement>(
        'input[type="radio"]:checked'
      );
      if (!checked) {
        btn.animate(
          [{ transform: "translateX(-4px)" }, { transform: "translateX(4px)" }, { transform: "none" }],
          { duration: 180, iterations: 2 }
        );
        return;
      }
      sessionStorage.setItem(storageKey, checked.value);
      revealResults(card);
      form.replaceWith(thanks!);
      thanks!.hidden = false;
    });
  }

  function revealResults(card: Element) {
    card.querySelectorAll<HTMLElement>(".pollBar").forEach((bar) => {
      bar.style.display = "block";
    });
    card.querySelectorAll<HTMLElement>(".pollPct").forEach((pct) => {
      pct.style.display = "block";
    });
    card.querySelector<HTMLElement>(".pollBtn")?.remove();
  }

  document.querySelectorAll(".pollCard").forEach(initPoll);
</script>

<style>
  .pollCard {
    border-radius: 18px;
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.035);
    padding: 16px;
  }

  .pollTitle {
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .10em;
    text-transform: uppercase;
    color: var(--brand1);
    margin-bottom: 8px;
  }

  .pollQuestion {
    font-weight: 950;
    font-size: 15px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--text);
    margin-bottom: 14px;
  }

  .pollForm {
    display: grid;
    gap: 6px;
  }

  .pollOption {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    column-gap: 8px;
    row-gap: 4px;
    cursor: pointer;
    padding: 8px 10px;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,.07);
    background: rgba(255,255,255,.02);
    transition: background 120ms, border-color 120ms;
    align-items: center;
  }
  .pollOption:hover {
    background: rgba(255,255,255,.05);
    border-color: rgba(255,220,80,.18);
  }
  .pollOption:has(input:checked) {
    background: rgba(255,220,80,.08);
    border-color: rgba(255,220,80,.30);
  }

  .pollRadio {
    /* visually hidden but accessible */
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .pollLabel {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.2;
    grid-column: 1;
    grid-row: 1;
  }

  .pollBar {
    display: none; /* shown after vote */
    grid-column: 1 / -1;
    grid-row: 2;
    height: 4px;
    border-radius: 999px;
    background: rgba(255,255,255,.08);
    overflow: hidden;
    margin-top: 2px;
  }

  .pollFill {
    display: block;
    height: 100%;
    background: var(--brand1);
    border-radius: 999px;
    transition: width 500ms cubic-bezier(.4,0,.2,1);
  }

  .pollPct {
    display: none; /* shown after vote */
    grid-column: 2;
    grid-row: 1;
    font-size: 12px;
    font-weight: 800;
    color: var(--brand1);
    white-space: nowrap;
  }

  .pollBtn {
    margin-top: 6px;
    width: 100%;
    padding: 11px 14px;
    border-radius: 12px;
    border: 2px solid var(--brand1);
    background: var(--brand1);
    color: #000;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: .04em;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 2px;
    transition: background 140ms, color 140ms, text-decoration-color 140ms, box-shadow 140ms;
  }
  .pollBtn:hover {
    background: #fff;
    color: #000;
    text-decoration-color: #000;
    box-shadow: 0 0 0 3px var(--brand1), 0 2px 10px rgba(0,0,0,.18);
  }

  .pollThanks {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--brand1);
    padding: 10px 4px 4px;
  }
  .pollThanksIcon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--brand1);
    color: #000;
    font-size: 11px;
    font-weight: 900;
    flex-shrink: 0;
  }

  .pollFooter {
    margin-top: 10px;
    font-size: 11.5px;
    opacity: .50;
    color: var(--faint);
  }
</style>
