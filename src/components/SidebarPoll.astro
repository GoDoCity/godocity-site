---
export interface Props {
  title?: string;
  question?: string;
  options?: { label: string; votes: number }[];
  pollId?: string;
  formAction?: string;
}

const {
  title = "Vibe Check: Best of Ormond",
  question = "Who has the best tacos in Ormond?",
  options = [
    { label: "La Fiesta",       votes: 112 + Math.floor(Math.random() * 36) },
    { label: "Tortilla Republic", votes: 112 + Math.floor(Math.random() * 36) },
    { label: "Cabo's Mexican",  votes: 112 + Math.floor(Math.random() * 36) },
    { label: "Other",           votes: 112 + Math.floor(Math.random() * 36) },
  ],
  pollId = "ormond-tacos",
  formAction = "#",
} = Astro.props;

// Display total seeded for social proof — sum of the randomised option counts
const total = options.reduce((s, o) => s + o.votes, 0);
const displayTotal = total;
---

<div class="pollCard" data-poll-id={pollId} data-question={question}>
  <div class="pollTitle">{title}</div>
  <div class="pollQuestion">{question}</div>

  <form class="pollForm" data-poll-form action={formAction} method="POST">
    {options.map((opt, i) => (
      <label class="pollOption" data-option>
        <input
          class="pollRadio"
          type="radio"
          name={`poll-${pollId}`}
          value={opt.label}
        />
        <span class="pollLabel">{opt.label}</span>
        <span class="pollBar" aria-hidden="true">
          <span
            class="pollFill"
            style={`width: ${Math.round((opt.votes / total) * 100)}%`}
          ></span>
        </span>
        <span class="pollPct">{Math.round((opt.votes / total) * 100)}%</span>
      </label>
    ))}

    <button class="pollBtn" type="submit">Vote</button>
  </form>

  <div class="pollThanks" data-poll-thanks hidden>
    <span class="pollThanksIcon">✓</span> Thanks for voting!
  </div>

  <div class="pollFooter">{displayTotal.toLocaleString()} votes cast</div>
</div>

<script>
  import { createClient } from "@supabase/supabase-js";

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  function revealResults(card: Element) {
    card.querySelectorAll<HTMLElement>(".pollBar").forEach((bar) => {
      bar.style.display = "block";
    });
    card.querySelectorAll<HTMLElement>(".pollPct").forEach((pct) => {
      pct.style.display = "block";
    });
  }

  function updateResultsInDOM(card: Element, counts: Record<string, number>, totalVotes: number) {
    card.querySelectorAll<HTMLElement>("[data-option]").forEach((optEl) => {
      const label = optEl.querySelector<HTMLElement>(".pollLabel")?.textContent?.trim();
      if (!label) return;
      const pct = totalVotes > 0 ? Math.round(((counts[label] ?? 0) / totalVotes) * 100) : 0;
      const fill = optEl.querySelector<HTMLElement>(".pollFill");
      const pctEl = optEl.querySelector<HTMLElement>(".pollPct");
      if (fill) fill.style.width = `${pct}%`;
      if (pctEl) pctEl.textContent = `${pct}%`;
    });
    const footer = card.querySelector<HTMLElement>(".pollFooter");
    if (footer) footer.textContent = `${totalVotes.toLocaleString()} votes cast`;
  }

  async function initPoll(card: Element) {
    const form = card.querySelector<HTMLFormElement>("[data-poll-form]");
    const thanks = card.querySelector<HTMLElement>("[data-poll-thanks]");
    const btn = card.querySelector<HTMLButtonElement>(".pollBtn");
    if (!form || !thanks || !btn) return;

    const pollId = (card as HTMLElement).dataset.pollId ?? "poll";
    const questionText = (card as HTMLElement).dataset.question ?? "";
    const storageKey = `poll-voted-${pollId}`;

    // Already voted this session — show results immediately
    if (sessionStorage.getItem(storageKey)) {
      revealResults(card);
      thanks.hidden = false;
      form.style.display = "none";
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const checked = form.querySelector<HTMLInputElement>('input[type="radio"]:checked');
      if (!checked) {
        btn.animate(
          [{ transform: "translateX(-4px)" }, { transform: "translateX(4px)" }, { transform: "none" }],
          { duration: 180, iterations: 2 }
        );
        return;
      }

      const selectedOption = checked.value;
      sessionStorage.setItem(storageKey, selectedOption);

      // Optimistically show UI before the async calls finish
      revealResults(card);
      setTimeout(() => {
        thanks!.hidden = false;
        form.style.display = "none";
      }, 80);

      // INSERT the vote
      await supabase.from("vibe_check_votes").insert({
        option_selected: selectedOption,
        question_text: questionText,
      });

      // SELECT live counts for this question and update the bars
      const { data } = await supabase
        .from("vibe_check_votes")
        .select("option_selected")
        .eq("question_text", questionText);

      if (data && data.length > 0) {
        const counts: Record<string, number> = {};
        data.forEach((row) => {
          counts[row.option_selected] = (counts[row.option_selected] ?? 0) + 1;
        });
        updateResultsInDOM(card, counts, data.length);
      }
    });
  }

  document.querySelectorAll(".pollCard").forEach(initPoll);
</script>

<style>
  .pollCard {
    border-radius: 18px;
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.035);
    padding: 16px;
  }

  .pollTitle {
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .10em;
    text-transform: uppercase;
    color: var(--brand1);
    margin-bottom: 8px;
  }

  .pollQuestion {
    font-weight: 950;
    font-size: 15px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--text);
    margin-bottom: 14px;
  }

  .pollForm {
    display: grid;
    gap: 6px;
  }

  .pollOption {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    column-gap: 8px;
    row-gap: 4px;
    cursor: pointer;
    padding: 8px 10px;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,.07);
    background: rgba(255,255,255,.02);
    transition: background 120ms, border-color 120ms;
    align-items: center;
  }
  .pollOption:hover {
    background: rgba(255,255,255,.05);
    border-color: rgba(255,220,80,.18);
  }
  .pollOption:has(input:checked) {
    background: rgba(255,220,80,.08);
    border-color: rgba(255,220,80,.30);
  }

  .pollRadio {
    /* visually hidden but accessible */
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .pollLabel {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.2;
    grid-column: 1;
    grid-row: 1;
  }

  .pollBar {
    display: none; /* shown after vote */
    grid-column: 1 / -1;
    grid-row: 2;
    height: 4px;
    border-radius: 999px;
    background: rgba(255,255,255,.08);
    overflow: hidden;
    margin-top: 2px;
  }

  .pollFill {
    display: block;
    height: 100%;
    background: var(--brand1);
    border-radius: 999px;
    transition: width 500ms cubic-bezier(.4,0,.2,1);
  }

  .pollPct {
    display: none; /* shown after vote */
    grid-column: 2;
    grid-row: 1;
    font-size: 12px;
    font-weight: 800;
    color: var(--brand1);
    white-space: nowrap;
  }

  .pollBtn {
    margin-top: 6px;
    width: 100%;
    padding: 11px 14px;
    border-radius: 12px;
    border: 2px solid var(--brand1);
    background: var(--brand1);
    color: #000;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: .04em;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 2px;
    transition: background 140ms, color 140ms, text-decoration-color 140ms, box-shadow 140ms;
  }
  .pollBtn:hover {
    background: #fff;
    color: #000;
    text-decoration-color: #000;
    box-shadow: 0 0 0 3px var(--brand1), 0 2px 10px rgba(0,0,0,.18);
  }

  .pollThanks {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--brand1);
    padding: 10px 4px 4px;
  }
  .pollThanksIcon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--brand1);
    color: #000;
    font-size: 11px;
    font-weight: 900;
    flex-shrink: 0;
  }

  .pollFooter {
    margin-top: 10px;
    font-size: 11.5px;
    opacity: .50;
    color: var(--faint);
  }
</style>
