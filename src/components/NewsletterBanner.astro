---
interface Props {
  city: string;           // e.g. "Daytona" — rendered in "Good News {city}!"
  subscribeUrl?: string;  // defaults to /{city}/subscribe/
  vibeCheckUrl?: string;  // defaults to /{city}/vibe-check/
  vibeCheckText?: string; // the question shown in the alert bar
  accentColor?: string;   // pill/highlight color for the Vibe Check bar
  showVibeCheck?: boolean; // render the bottom Vibe Check strip. Default FALSE —
                           // the poll now lives as an interactive SidebarPoll in
                           // the right rail across every city. Pass true to opt a
                           // page back into the legacy full-width bar.
}

const {
  city,
  subscribeUrl = `/${city.toLowerCase()}/subscribe/`,
  vibeCheckUrl  = `/${city.toLowerCase()}/vibe-check/`,
  vibeCheckText = `What's on in ${city} this weekend?`,
  accentColor,
  showVibeCheck = false,
} = Astro.props;
---

<div class="nlBand" id="nlBand"
     style={accentColor ? `--accent-color: ${accentColor};` : undefined}>
  <div class="nlInner">
    <div class="nlContent" id="nlContent">
      <div class="nlHead"><em>Good News <span class="nlCity">{city}</span>!</em></div>
      <div class="nlSub">
        Join GoDo{city} for the daily brief on local news, fresh openings, and must-see events.
      </div>
      <form class="nlForm" id="nlForm" action={subscribeUrl} method="get">
        <div class="nlRow">
          <input
            class="nlInput"
            type="email"
            name="email"
            placeholder="Enter your email address"
            aria-label="Email address"
          />
          <button class="nlBtn" type="submit">SIGN UP, IT'S FREE!</button>
        </div>
      </form>
      <div class="nlFine">100% free, unsubscribe anytime.</div>
    </div>
    <div class="nlThanks" id="nlThanks" aria-live="polite">Thank you! You're on the list. ✓</div>
  </div>
  {showVibeCheck && (
    <a class="homeAlertBar" id="alertBand" href={vibeCheckUrl}>
      🗳️ <strong>Vibe Check:</strong> {vibeCheckText} <span class="habVote">Vote Now →</span>
    </a>
  )}
</div>

<script is:inline>
(function () {
  var form    = document.getElementById('nlForm');
  var content = document.getElementById('nlContent');
  var thanks  = document.getElementById('nlThanks');
  if (!form) return;
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    content.style.display = 'none';
    thanks.style.display  = 'flex';
  });
})();
</script>

<style>
  /* ── Band shell ── */
  .nlBand {
    position: relative;
    background: var(--theme-gradient);
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
    padding-top: 20px;
    margin-top: 20px;
  }
  /* Pattern layer — sits behind all content */
  .nlBand::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/images/geometric-pattern-master.svg');
    background-size: 240px 240px;
    opacity: 0.25;
    z-index: 0;
    pointer-events: none;
  }
  /* Pulse line at top edge — color follows --accent-color prop */
  .nlBand::before {
    content: "";
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 4px;
    background: var(--accent-color, #00FFFF);
    animation: nlPulseLine 2s ease-in-out infinite;
    z-index: 100;
  }
  @keyframes nlPulseLine {
    0%   { opacity: 0.4; box-shadow: 0 0 2px var(--accent-color, #00FFFF); }
    50%  { opacity: 1;   box-shadow: 0 0 15px var(--accent-color, #00FFFF), 0 0 25px var(--accent-color, #00FFFF); }
    100% { opacity: 0.4; box-shadow: 0 0 2px var(--accent-color, #00FFFF); }
  }

  /* ── Content wrapper ── */
  .nlInner {
    position: relative;
    z-index: 1;
    width: 90%;
    max-width: 600px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    background: transparent !important;
  }
  .nlContent {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 6px;
  }
  .nlHead {
    font-family: 'Archivo Black', sans-serif;
    font-size: 2.8rem;
    font-weight: 900;
    font-style: italic;
    color: #fff !important;
    line-height: 1.0;
    letter-spacing: -0.04em;
    white-space: nowrap;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.8);
  }
  .nlCity { font-style: italic; font-weight: 900; }

  /* ── "Daytona" — Florida sunset gradient ──
   * Scoped to godo-blue (Daytona) on purpose. NewsletterBanner is shared, and
   * the band is var(--theme-gradient): Asheville is lime (#76FF03), Macon is
   * magenta (#FF00FF). A warm coral/gold reads well on Daytona's blue but goes
   * muddy on those, so every other city keeps the crisp white.
   * "Good News" is untouched and stays white.
   *
   * Coral (#ff6b6b) only clears WCAG AA large-text (3:1) because of the scrim
   * on .nlBand below — on the raw band it measures 1.73:1, and 1.0:1 against
   * the cyan end. Weakening the scrim makes this word unreadable.
   */
  html[data-theme="godo-blue"] .nlCity {
    /* Solid gold fallback — used if background-clip:text is unsupported, so the
       word can never render invisible. */
    color: #ffa800;
    /* .nlHead's text-shadow is inherited and would show through the clipped
       glyphs as a smudge. drop-shadow applies to the painted result instead. */
    text-shadow: none;
    filter: drop-shadow(0 2px 5px rgba(0, 0, 0, .5));
  }

  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    html[data-theme="godo-blue"] .nlCity {
      background-image: linear-gradient(95deg, #ff6b6b 0%, #ff8a3c 52%, #ffa800 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
      /* Double-width gradient so there's somewhere to drift to. Both ends of the
         ramp already clear 3:1 over the scrim, so no drift position can push the
         word below the contrast floor. */
      background-size: 200% auto;
      animation: sunset-shimmer 6s ease-in-out infinite;
    }
  }

  @keyframes sunset-shimmer {
    0%   { background-position:   0% 50%; }
    50%  { background-position: 100% 50%; }
    100% { background-position:   0% 50%; }
  }

  /* An infinite background drift is exactly what reduced-motion is for — the
     gradient stays, only the movement stops. */
  @media (prefers-reduced-motion: reduce) {
    html[data-theme="godo-blue"] .nlCity { animation: none; }
  }

  /* Sunset scrim — darkens the band under the content so the coral reads.
   * Layered into .nlBand's own background rather than a pseudo-element: ::after
   * is the geometric pattern and ::before is the pulse line, both already taken.
   * Sits above --theme-gradient, below the pattern and content, and fades to
   * fully transparent at the edges so the blue is untouched there. */
  html[data-theme="godo-blue"] .nlBand {
    --sunset-scrim: radial-gradient(
      ellipse 85% 78% at 50% 38%,
      rgba(0, 0, 0, .58) 0%,
      rgba(0, 0, 0, .44) 55%,
      rgba(0, 0, 0, .14) 85%,
      rgba(0, 0, 0, 0) 100%
    );
    background: var(--sunset-scrim), var(--theme-gradient);
  }

  /* Windows high-contrast: hand the word back to the system palette. */
  @media (forced-colors: active) {
    html[data-theme="godo-blue"] .nlCity {
      background-image: none;
      -webkit-text-fill-color: revert;
      color: revert;
      filter: none;
    }
  }
  .nlSub {
    font-size: 1.1rem;
    font-weight: 400;
    color: rgba(255,255,255,.85);
    line-height: 1.4;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
    text-align: center;
    max-width: 480px;
    margin: 0 auto;
  }
  .nlSub strong { font-weight: 900; color: #ffffff; }
  .nlForm { width: 100%; max-width: 480px; margin: 0; }
  .nlRow {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 100%;
  }
  .nlInput {
    width: 350px !important;
    height: 44px !important;
    border-radius: 4px 0 0 4px;
    border: 2px solid rgba(255,255,255,.3);
    border-right: none;
    background: #fff; color: #000;
    padding: 0 14px; font-size: 15px; font-weight: 500;
    outline: none;
    transition: border-color 150ms;
  }
  .nlInput::placeholder { color: #888; }
  .nlInput:focus { border-color: rgba(255,255,255,.7); }
  .nlBtn {
    width: auto !important;
    padding: 0 25px;
    height: 44px !important;
    border-radius: 0 4px 4px 0;
    border: 2px solid #fff;
    background: #000; color: #fff;
    font-weight: 900; font-size: 14px; cursor: pointer;
    white-space: nowrap; letter-spacing: .03em;
    text-shadow: none;
    transition: background 140ms, color 140ms;
    margin-left: 5px;
  }
  .nlBtn:hover { background: #fff; color: #000; }
  .nlFine {
    font-size: 12px; font-weight: 500;
    color: rgba(255,255,255,.65);
    font-style: italic;
    margin: 0;
  }
  .nlThanks {
    display: none;
    align-items: center;
    justify-content: center;
    font-size: clamp(29px, 3.2vw, 38px);
    font-weight: 900;
    color: #000;
    text-align: center;
    padding: 28px 2.5rem;
    width: 100%;
  }

  /* ── Vibe Check bar — full-width bottom strip ── */
  .homeAlertBar {
    position: relative;
    z-index: 2;
    display: flex; align-items: center; justify-content: center; gap: 8px; flex-wrap: wrap;
    width: 100%;
    padding: 10px 20px;
    margin: 0;
    margin-top: auto;
    background: #1e2d3d;
    color: #E8EDF4;
    font-size: 15px; font-weight: 700; line-height: 1.3;
    text-decoration: none; text-align: center;
    transition: opacity 140ms;
  }
  .homeAlertBar:hover { opacity: 0.85; }
  .homeAlertBar strong { font-weight: 900; color: #ffffff; }
  .habVote {
    display: inline-flex; align-items: center;
    padding: 4px 13px; border-radius: 999px;
    background: var(--accent-color, var(--accent)); color: #ffffff;
    font-size: 13px; font-weight: 900; letter-spacing: .04em;
    white-space: nowrap;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    #nlBand {
      display: flex;
      flex-direction: column;
      width: 100%;
      height: auto;
      min-height: 0;
      background: var(--theme-gradient);
      padding-bottom: 0;
    }
    /* The #nlBand rule above outranks the class-based scrim and would strip it
       on mobile, dropping the coral to 1.73:1. Re-apply it at ID specificity. */
    html[data-theme="godo-blue"] #nlBand {
      background: var(--sunset-scrim), var(--theme-gradient);
    }
    .nlInner {
      flex: 0 1 auto;
      padding: 20px 0;
    }
    .homeAlertBar {
      width: 100%;
      margin-top: 0;
      flex-shrink: 0;
    }
    .nlContent { max-width: 100%; }
    .nlHead {
      font-family: 'Montserrat', sans-serif !important;
      font-weight: 900 !important;
      /* 2.2rem + nowrap measured 386px wide at a 375px viewport and was clipped
         by .nlBand's overflow:hidden. Scale with the viewport and allow a wrap
         so longer city names (Jacksonville) stay inside the band too.
         Wrapping is safe for the gradient: .nlCity holds the single word
         "Daytona", so background-clip:text can't fragment across lines. */
      font-size: clamp(1.55rem, 8.4vw, 2.2rem) !important;
      letter-spacing: -0.02em !important;
      white-space: normal !important;
      text-wrap: balance;
      max-width: 100%;
    }
    .nlSub { display: block; white-space: normal; font-size: 1.2rem; width: 100%; max-width: 90%; margin: 0 auto; }
    .nlSub strong { font-weight: 900 !important; }
    .nlForm { display: flex; flex-direction: column; width: 100%; max-width: 100%; }
    .nlRow { flex-direction: column; gap: 0.75rem; width: 100%; align-items: stretch; }
    /* global.css has `input[type="email"] { flex: 1 }` (= flex: 1 1 0%). Once
       .nlRow flips to a column, that 0% basis governs the MAIN axis — height —
       and flex-basis beats `height`, which is why the field collapsed to 25px
       despite `height: 48px !important`. Reset flex so the box sizes itself;
       min-height then holds the 48px touch target. */
    .nlInput {
      flex: 0 0 auto;
      border-radius: 8px !important;
      height: auto !important;
      min-height: 48px;
      width: 100% !important;
      max-width: none;
      font-size: 1.1rem;
      padding: 12px 16px !important;
      border-right: 2px solid rgba(255,255,255,.3);
      box-sizing: border-box;
    }
    .nlBtn {
      flex: 0 0 auto;
      border-radius: 8px !important;
      height: auto !important;
      min-height: 48px;
      width: 100% !important;
      max-width: none;
      margin-left: 0 !important;
    }
  }

  /* ── Clean White theme overrides ── */
  :global(html[data-theme="clean-white"]) .nlBand {
    border-top: 1px solid #111111;
    border-bottom: 1px solid #111111;
  }
  :global(html[data-theme="clean-white"]) .nlHead { color: #000000 !important; }
</style>
