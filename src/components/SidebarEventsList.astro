---
/**
 * SidebarEventsList.astro
 *
 * Single source of truth for sidebar event rows across every layout.
 * Callers pass the already-merged array; this component slices to 6,
 * renders each row, and applies the tinted-blue card style for sponsored
 * events — identical on every page that uses it.
 *
 * featureTop (default ON — unified across every sidebar site-wide):
 *   Turns the top slot into an auto-rotating showcase that cycles the
 *   sponsored / featured events every 4.5 s, falling back to the curated
 *   GoDo Picks (nearest-upcoming) when no paid ads are in the stream so the
 *   space never sits idle. The rows below stay standard static chronological
 *   listings. A light blueprint-blue tint sets the rotating slot apart.
 *
 * Live sync: for ENGINE_CITIES the server-rendered rows are only a
 * build-time snapshot (this site is fully static). A client script
 * re-fetches the GoDoEVENTS engine API on every page view and replaces
 * the rows (and rebuilds the rotating slot), so the rail always matches the
 * unified events hub even when the last deploy is days old. If the fetch
 * fails, the build-time snapshot stays in place and keeps rotating.
 *
 * Usage:
 *   <SidebarEventsList events={mergedEvents} city={city} />
 *   <SidebarEventsList events={mergedEvents} city={city} featureTop />
 */
import {
  cityDisplayName,
  CITY_DISPLAY,
  ENGINE_CITIES,
  ENGINE_API_BASE,
  EVENTS_HUB_BASE,
} from "../lib/events.js";

interface Props {
  events: any[];
  city: string;
  /** Rotate the top slot through featured ads / GoDo Picks. Default true so
      every sidebar on the site shows the rotating blue slot; pass featureTop={false}
      to opt a rail back into a plain flat list. */
  featureTop?: boolean;
}

const { events, city, featureTop = true } = Astro.props;

const marketSlug = String(city ?? "").toLowerCase().trim();
const isLive = ENGINE_CITIES.has(marketSlug);

// Split the feed when featureTop is on: sponsored events lead the rotating
// slot; with none in the stream, fall back to the nearest-upcoming picks so
// the showcase always has something live to cycle. The remaining events drop
// into the static list below — no event appears in both zones.
const sponsored  = events.filter((e: any) => e.data?.sponsored);
const rotating   = featureTop ? (sponsored.length ? sponsored : events).slice(0, 5) : [];
const rotKeys    = new Set(rotating.map((e: any) => e.slug ?? e.data?.title));
const staticList = featureTop
  ? events.filter((e: any) => !rotKeys.has(e.slug ?? e.data?.title)).slice(0, 6)
  : events.slice(0, 6);

const hasAny = rotating.length > 0 || staticList.length > 0;

// Shared row-field derivation (server render) — used by both zones.
function rowFields(e: any) {
  const d       = new Date(e.data.eventDate);
  const evCity  = (e.data.city ?? (e.slug?.split("/")[0] ?? city)).toLowerCase().trim();
  const evSlug  = e.slug?.split("/").pop() ?? "";
  return {
    dow:     d.toLocaleDateString("en-US", { weekday: "short" }).toUpperCase(),
    day:     d.getDate(),
    mon:     d.toLocaleDateString("en-US", { month: "short" }).toUpperCase(),
    monFull: d.toLocaleDateString("en-US", { month: "short" }),
    href:    e.data.url ?? `/${evCity}/events/${evSlug}/`,
    cityLbl: cityDisplayName(evCity),
    isExt:   !!e.data.url,
  };
}
---

<div
  class="sel-wrap"
  data-sel-live={isLive ? "1" : undefined}
  data-sel-engine={isLive ? ENGINE_API_BASE : undefined}
  data-sel-market={isLive ? marketSlug : undefined}
  data-sel-hub={isLive ? EVENTS_HUB_BASE : undefined}
  data-sel-city-display={isLive ? JSON.stringify(CITY_DISPLAY) : undefined}
  data-sel-feature-top={featureTop ? "1" : undefined}
>
{featureTop && rotating.length > 0 && (
  <div class="sel-feature" aria-label="Featured events">
    {rotating.map((e: any, i: number) => {
      const f = rowFields(e);
      return (
        <a
          class={`sel-fslide${i === 0 ? " sel-fslide--active" : ""}`}
          href={f.href}
          target={f.isExt ? "_blank" : "_self"}
          rel={f.isExt ? "noopener" : ""}
        >
          <div class="sel-cal">
            <div class="sel-dow">{f.dow}</div>
            <div class="sel-day">{f.day}</div>
            <div class="sel-mon">{f.mon}</div>
          </div>
          <div class="sel-info">
            <span class="sel-fbadge">{e.data.sponsored ? "FEATURED" : "GODO PICK"}</span>
            <div class="sel-name">{e.data.title}</div>
            <div class="sel-meta">
              <span>{f.monFull} {f.day}</span>
              <span class="sel-sep">|</span>
              <span class="sel-city">{f.cityLbl}</span>
            </div>
          </div>
        </a>
      );
    })}
    {rotating.length > 1 && (
      <div class="sel-fdots">
        {rotating.map((_: any, i: number) => (
          <button
            class={`sel-fdot${i === 0 ? " sel-fdot--active" : ""}`}
            type="button"
            aria-label={`Go to featured event ${i + 1}`}
          />
        ))}
      </div>
    )}
  </div>
)}

{!hasAny ? (
  <p class="sel-empty">No upcoming events yet.</p>
) : (
  <div class="sel-list">
    {staticList.map((e: any) => {
      const f = rowFields(e);
      return (
        <a
          class={`sel-row${e.data.sponsored ? " is-sponsored" : ""}`}
          href={f.href}
          target={f.isExt ? "_blank" : "_self"}
          rel={f.isExt ? "noopener" : ""}
        >
          <div class="sel-cal">
            <div class="sel-dow">{f.dow}</div>
            <div class="sel-day">{f.day}</div>
            <div class="sel-mon">{f.mon}</div>
          </div>
          <div class="sel-info">
            <div class="sel-name">{e.data.title}</div>
            <div class="sel-meta">
              <span>{f.monFull} {f.day}</span>
              <span class="sel-sep">|</span>
              <span class="sel-city">{f.cityLbl}</span>
              {e.data.sponsored && <span class="sel-badge">SPONSORED</span>}
            </div>
          </div>
        </a>
      );
    })}
  </div>
)}
</div>

<script>
  /* Client-side live sync — engine cities only (wrapper carries data-sel-live).
     Mirrors the server pipeline in events.js: map engine rows → drop past
     events (yesterday EST cutoff, sponsored always pass) → chronological
     sort. One fetch per market is shared by every rail on the page.
     When the wrapper is data-sel-feature-top, the top slot is rebuilt as a
     rotating carousel (sponsored → GoDo Picks fallback) + static rows below. */

  const PLACEHOLDER_HOSTS = new Set([
    "godocity.com", "www.godocity.com",
    "godoevents.com", "www.godoevents.com",
  ]);

  const marketFetches = new Map<string, Promise<any[] | null>>();

  function fetchMarket(engine: string, market: string): Promise<any[] | null> {
    let p = marketFetches.get(market);
    if (!p) {
      p = (async () => {
        try {
          const today = new Date();
          today.setUTCHours(0, 0, 0, 0);
          const res = await fetch(
            `${engine}/api/events?market=${encodeURIComponent(market)}&limit=50&from=${encodeURIComponent(today.toISOString())}`
          );
          if (!res.ok) return null;
          const json = await res.json();
          return json.events ?? [];
        } catch {
          return null;
        }
      })();
      marketFetches.set(market, p);
    }
    return p;
  }

  /* Yesterday in EST/EDT — same HARD_CUTOFF rule as events.js */
  const cutoff = new Date(Date.now() - 86_400_000)
    .toLocaleDateString("en-CA", { timeZone: "America/New_York" });

  function dateKey(raw: unknown): string {
    return String(raw ?? "").split("T")[0];
  }

  function isSponsored(tags: unknown): boolean {
    if (!tags) return false;
    try {
      const t = JSON.parse(String(tags));
      return Array.isArray(t) && t.includes("featured");
    } catch {
      return false;
    }
  }

  /* Ticket URL if real and external, else the hub's event detail page —
     same behaviour as the unified events hub itself. */
  function liveUrl(raw: unknown, id: unknown, hub: string): string {
    const url = String(raw ?? "").trim();
    if (url && url !== "#") {
      try {
        const u = new URL(url);
        if ((u.protocol === "http:" || u.protocol === "https:") &&
            !PLACEHOLDER_HOSTS.has(u.hostname.toLowerCase())) {
          return url;
        }
      } catch {}
    }
    return `${hub}/events/${id}`;
  }

  /* Longest CITY_DISPLAY key found in the venue address wins, so
     "daytona beach shores" beats "daytona beach" beats "daytona". */
  function cityLabel(addr: unknown, map: Record<string, string>, market: string): string {
    const lc = String(addr ?? "").toLowerCase();
    let best = "";
    for (const key of Object.keys(map)) {
      if (key.length > best.length && lc.includes(key)) best = key;
    }
    return best ? map[best] : (map[market] ?? market);
  }

  function el(tag: string, cls: string, text?: string): HTMLElement {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text != null) n.textContent = text;
    return n;
  }

  function calBlock(dow: string, day: string, mon: string): HTMLElement {
    const cal = el("div", "sel-cal");
    cal.append(el("div", "sel-dow", dow), el("div", "sel-day", day), el("div", "sel-mon", mon));
    return cal;
  }

  function fmt(e: any) {
    const d = new Date(e.start_datetime);
    const ok = !isNaN(d.getTime());
    return {
      dow: ok ? d.toLocaleDateString("en-US", { weekday: "short" }).toUpperCase() : "",
      day: ok ? String(d.getDate()) : "",
      mon: ok ? d.toLocaleDateString("en-US", { month: "short" }).toUpperCase() : "",
      monFull: ok ? d.toLocaleDateString("en-US", { month: "short" }) : "",
    };
  }

  function buildRow(e: any, map: Record<string, string>, hub: string, market: string): HTMLElement {
    const { dow, day, mon, monFull } = fmt(e);
    const sponsored = isSponsored(e.partner_tags);

    const a = el("a", `sel-row${sponsored ? " is-sponsored" : ""}`) as HTMLAnchorElement;
    a.href = liveUrl(e.event_url, e.id, hub);
    a.target = "_blank";
    a.rel = "noopener";

    const info = el("div", "sel-info");
    info.append(el("div", "sel-name", e.title ?? "Untitled Event"));
    const meta = el("div", "sel-meta");
    meta.append(el("span", "", `${monFull} ${day}`));
    meta.append(el("span", "sel-sep", "|"));
    meta.append(el("span", "sel-city", cityLabel(e.venue_address, map, market)));
    if (sponsored) meta.append(el("span", "sel-badge", "SPONSORED"));
    info.append(meta);

    a.append(calBlock(dow, day, mon), info);
    return a;
  }

  function buildSlide(e: any, map: Record<string, string>, hub: string, market: string, active: boolean): HTMLElement {
    const { dow, day, mon, monFull } = fmt(e);
    const sponsored = isSponsored(e.partner_tags);

    const a = el("a", `sel-fslide${active ? " sel-fslide--active" : ""}`) as HTMLAnchorElement;
    a.href = liveUrl(e.event_url, e.id, hub);
    a.target = "_blank";
    a.rel = "noopener";

    const info = el("div", "sel-info");
    info.append(el("span", "sel-fbadge", sponsored ? "FEATURED" : "GODO PICK"));
    info.append(el("div", "sel-name", e.title ?? "Untitled Event"));
    const meta = el("div", "sel-meta");
    meta.append(el("span", "", `${monFull} ${day}`));
    meta.append(el("span", "sel-sep", "|"));
    meta.append(el("span", "sel-city", cityLabel(e.venue_address, map, market)));
    info.append(meta);

    a.append(calBlock(dow, day, mon), info);
    return a;
  }

  function buildFeature(rotating: any[], map: Record<string, string>, hub: string, market: string): HTMLElement {
    const feature = el("div", "sel-feature");
    feature.setAttribute("aria-label", "Featured events");
    rotating.forEach((e, i) => feature.append(buildSlide(e, map, hub, market, i === 0)));
    if (rotating.length > 1) {
      const dots = el("div", "sel-fdots");
      rotating.forEach((_, i) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = `sel-fdot${i === 0 ? " sel-fdot--active" : ""}`;
        b.setAttribute("aria-label", `Go to featured event ${i + 1}`);
        dots.append(b);
      });
      feature.append(dots);
    }
    return feature;
  }

  /* Auto-rotate a .sel-feature every 4.5 s; pause on hover, dots jump.
     Returns a stop() so a rebuild can clear the old timer. */
  function startCarousel(feature: HTMLElement): () => void {
    const slides = Array.from(feature.querySelectorAll<HTMLElement>(".sel-fslide"));
    const dots   = Array.from(feature.querySelectorAll<HTMLElement>(".sel-fdot"));
    if (slides.length <= 1) return () => {};
    let cur = 0;

    function goTo(idx: number) {
      slides[cur].classList.remove("sel-fslide--active");
      if (dots[cur]) dots[cur].classList.remove("sel-fdot--active");
      cur = (idx + slides.length) % slides.length;
      slides[cur].classList.add("sel-fslide--active");
      if (dots[cur]) dots[cur].classList.add("sel-fdot--active");
    }

    let timer = window.setInterval(() => goTo(cur + 1), 4500);
    const restart = () => { timer = window.setInterval(() => goTo(cur + 1), 4500); };

    dots.forEach((dot, i) => dot.addEventListener("click", (ev) => {
      ev.preventDefault();
      window.clearInterval(timer);
      goTo(i);
      restart();
    }));
    feature.addEventListener("mouseenter", () => window.clearInterval(timer));
    feature.addEventListener("mouseleave", restart);

    return () => window.clearInterval(timer);
  }

  async function hydrate(wrap: HTMLElement): Promise<void> {
    const engine = wrap.dataset.selEngine ?? "";
    const market = wrap.dataset.selMarket ?? "";
    const hub = wrap.dataset.selHub ?? "";
    if (!engine || !market) return;

    let map: Record<string, string> = {};
    try { map = JSON.parse(wrap.dataset.selCityDisplay ?? "{}"); } catch {}

    const events = await fetchMarket(engine, market);
    if (!events) return; // fetch failed — keep the build-time snapshot (still rotating)

    const upcoming = events
      .filter((e: any) => isSponsored(e.partner_tags) || dateKey(e.start_datetime) >= cutoff)
      .sort((a: any, b: any) => dateKey(a.start_datetime).localeCompare(dateKey(b.start_datetime)));
    if (upcoming.length === 0) return; // empty feed — keep the snapshot

    if (wrap.dataset.selFeatureTop) {
      const sponsored = upcoming.filter((e: any) => isSponsored(e.partner_tags));
      const rotating  = (sponsored.length ? sponsored : upcoming).slice(0, 5);
      const rotIds    = new Set(rotating.map((e: any) => e.id));
      const rest      = upcoming.filter((e: any) => !rotIds.has(e.id)).slice(0, 6);

      const feature = buildFeature(rotating, map, hub, market);
      const listDiv = el("div", "sel-list");
      for (const e of rest) listDiv.append(buildRow(e, map, hub, market));

      const w = wrap as any;
      if (typeof w._selStop === "function") w._selStop(); // clear the snapshot's timer
      wrap.replaceChildren(feature, listDiv);
      w._selStop = startCarousel(feature);
      return;
    }

    const listDiv = el("div", "sel-list");
    for (const e of upcoming.slice(0, 6)) listDiv.append(buildRow(e, map, hub, market));
    wrap.replaceChildren(listDiv);
  }

  // Start any server-rendered carousels immediately, so the slot keeps
  // rotating even before the fetch resolves (or if it fails). hydrate()
  // clears this timer and restarts on a fresh rebuild.
  document.querySelectorAll<HTMLElement>(".sel-wrap[data-sel-feature-top]").forEach((wrap) => {
    const feature = wrap.querySelector<HTMLElement>(".sel-feature");
    if (feature) (wrap as any)._selStop = startCarousel(feature);
  });

  document
    .querySelectorAll<HTMLElement>(".sel-wrap[data-sel-live]")
    .forEach((wrap) => { void hydrate(wrap); });
</script>

{/* is:global — rows rebuilt by the live-sync script have no Astro scope
    attribute, so scoped selectors would miss them. All classes are
    sel- prefixed, so the global reach is effectively component-local. */}
<style is:global>
  /* Breathing room below the section header's blue divider line so the
     rotating featured card (and the rows) don't run into it. Applies to
     every sidebar site-wide since this component is the single source. */
  .sel-wrap { margin-top: 12px; }

  .sel-list { display: grid; }

  .sel-row {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 12px;
    align-items: center;
    text-decoration: none;
    padding: 13px 0;
    border-bottom: 1px solid var(--border, #e5e7eb);
    transition: opacity 140ms;
    border-radius: 0;
    color: inherit;
  }
  .sel-row:last-child { border-bottom: none; }
  .sel-row:hover { opacity: 0.76; }

  /* Tinted blue card for sponsored rows — matches the homepage slider style */
  .sel-row.is-sponsored {
    background: #f0f7ff;
    border: 1px solid rgba(0, 119, 190, 0.22);
    border-radius: 8px;
    padding: 12px 10px;
    margin: 4px 0 8px;
  }
  .sel-row.is-sponsored:last-child { border-bottom: 1px solid rgba(0, 119, 190, 0.22); }

  /* ── Featured rotating top slot (featureTop) ──────────────────────────
     Distinct light blueprint-blue card so the rotating ad showcase reads as
     clearly elevated above the plain static rows underneath it. */
  .sel-feature {
    position: relative;
    background: color-mix(in srgb, var(--brand1, #0077be) 11%, #fff);
    border: 1.5px solid color-mix(in srgb, var(--brand1, #0077be) 34%, transparent);
    border-radius: 12px;
    margin-bottom: 12px;
    box-shadow: 0 3px 14px color-mix(in srgb, var(--brand1, #0077be) 16%, transparent);
  }
  .sel-fslide {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 12px;
    align-items: center;
    padding: 14px 12px;
    text-decoration: none;
    color: inherit;
    transition: opacity 400ms ease;
  }
  .sel-fslide:not(.sel-fslide--active) {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }
  .sel-fslide--active { position: relative; opacity: 1; }
  .sel-fslide:hover { opacity: 0.82; }

  .sel-fbadge {
    justify-self: start;
    display: inline-block;
    font-size: 8px; font-weight: 900; letter-spacing: .1em;
    background: var(--brand1, #0077be); color: #fff;
    padding: 2px 7px; border-radius: 999px;
    margin-bottom: 4px;
  }

  .sel-fdots {
    display: flex; justify-content: center; gap: 6px;
    padding: 2px 0 10px;
  }
  .sel-fdot {
    width: 6px; height: 6px; border-radius: 999px;
    border: none; padding: 0; cursor: pointer;
    background: color-mix(in srgb, var(--brand1, #0077be) 30%, transparent);
    transition: background 140ms, transform 140ms;
  }
  .sel-fdot--active { background: var(--brand1, #0077be); transform: scale(1.35); }

  /* Calendar block */
  .sel-cal {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    background: transparent;
    border: 1.5px solid var(--brand1, #0077be);
    display: grid;
    place-items: center;
    text-align: center;
    line-height: 1;
    flex-shrink: 0;
  }
  .sel-dow { font-size: 10px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; color: var(--brand1, #0077be); }
  .sel-day { font-size: 19px; font-weight: 900; color: var(--brand1, #0077be); margin-top: 1px; }
  .sel-mon { font-size: 8px;  font-weight: 700; letter-spacing: .08em; color: var(--brand1, #0077be); text-transform: uppercase; }

  /* Text block */
  .sel-info { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .sel-name {
    font-weight: 800;
    font-size: 14px;
    line-height: 1.2;
    color: var(--text, #111);
    /* Prevent very long titles overflowing */
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .sel-meta {
    font-size: 11.5px;
    color: var(--faint, #6b7280);
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
  }
  .sel-sep   { opacity: 0.4; }
  .sel-city  { color: var(--brand1, #0077be); font-weight: 700; }

  /* SPONSORED pill badge */
  .sel-badge {
    display: inline-block;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: .08em;
    background: rgba(0, 119, 190, 0.14);
    color: var(--brand1, #0077be);
    border: 1px solid rgba(0, 119, 190, 0.32);
    padding: 1px 5px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .sel-empty { font-size: 13px; color: var(--faint, #6b7280); padding: 10px 0; margin: 0; }
</style>
