---
/**
 * src/components/DiyPill.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Universal DIY "Pill" layout component.
 *
 * Layout: 75/25 grid split — 1260px max-width, 80px column gap (matches site standard).
 *   75% Main column : Title kicker, Intro (≥2 paragraphs, ≤200 words), numbered Steps,
 *                     Community Note (styled blockquote).
 *   25% Sidebar     : Materials list with distinct brand-accent background + border.
 *
 * Usage (from a page route):
 *   import DiyPill from "../../components/DiyPill.astro";
 *   <DiyPill {...entry.data} city={city} />
 * ─────────────────────────────────────────────────────────────────────────────
 */

export interface Props {
  title:          string;
  intro:          string;       // Plain text; \n\n = paragraph break; max 200 words
  materials:      string[];
  steps:          string[];
  community_note?: string;
  city:           string;
  author?:        string;
  pubDate?:       Date;
  heroImage?:     string;
}

const {
  title,
  intro,
  materials,
  steps,
  community_note,
  city,
  author   = "Charles King",
  pubDate,
  heroImage,
} = Astro.props;

/* ── Smart-list normalisation — belt-and-suspenders for CMS textarea input ──
 *  Schema transform in config.ts handles the canonical case; this guards
 *  against any raw string that slips through (e.g. direct component usage). */
const normMaterials: string[] = Array.isArray(materials)
  ? materials
  : String(materials).split("\n").map((s) => s.trim()).filter(Boolean);
const normSteps: string[] = Array.isArray(steps)
  ? steps
  : String(steps).split("\n").map((s) => s.trim()).filter(Boolean);

/* ── Intro: enforce ≤200 words, then split into paragraphs (min 2) ── */
const words   = intro.split(/\s+/).filter(Boolean);
const trimmed = words.length > 200 ? words.slice(0, 200).join(" ") + "\u2026" : intro;
const paras   = trimmed.split(/\n\n+/).map((p) => p.trim()).filter(Boolean);
// Guarantee at least 2 rendered paragraphs
while (paras.length < 2) paras.push("");

const cityLabel  = city.charAt(0).toUpperCase() + city.slice(1);
const pubDateStr = pubDate
  ? new Date(pubDate).toLocaleDateString("en-US", { month: "long", year: "numeric" })
  : "";
---

<div class="diyWrap">


  <div class="container">

    {/* ══ PAGE HEADER ══ */}
    <header class="diyHeader">
      <div class="diyKicker">
        <span class="kPill kCity">{cityLabel}</span>
        <span class="kPill kCat">DIY</span>
      </div>
      <h1 class="diyTitle">{title}</h1>
      {(author || pubDateStr) && (
        <div class="diyMeta">
          {author && <span class="diyAuthor">By {author}</span>}
          {author && pubDateStr && <span class="diyDot" aria-hidden="true">·</span>}
          {pubDateStr && <span class="diyDate">{pubDateStr}</span>}
        </div>
      )}
    </header>

    {/* ══ 75 / 25 CONTENT GRID ══ */}
    <div class="diyGrid">

      {/* ── 75% MAIN COLUMN ── */}
      <main class="diyMain">

        {/* Hero image — rendered at top of main column */}
        {heroImage && (
          <div class="diyHeroBanner">
            <img class="diyHeroImg" src={heroImage} alt={title} loading="eager" decoding="async" />
          </div>
        )}

        {/* Intro — ≥2 paragraphs, ≤200 words */}
        <div class="diyIntro">
          {paras.map((p) => p && <p class="diyPara">{p}</p>)}
        </div>

        {/* Steps — numbered list */}
        <section class="diySteps" aria-labelledby="steps-heading">
          <h2 class="sectionHead" id="steps-heading">Step-by-Step</h2>
          <ol class="stepList">
            {normSteps.map((step, i) => (
              <li class="stepItem">
                <div class="stepNum" aria-label={`Step ${i + 1}`}>{i + 1}</div>
                <p class="stepText">{step}</p>
              </li>
            ))}
          </ol>
        </section>

        {/* Community Note — expert tip / warning blockquote */}
        {community_note && (
          <blockquote class="communityNote">
            <span class="cnLabel" aria-label="Community Note">
              <span class="cnIcon" aria-hidden="true">💬</span>
              Community Note
            </span>
            <p class="cnText">{community_note}</p>
          </blockquote>
        )}

      </main>

      {/* ── 25% SIDEBAR — Materials List ── */}
      <aside class="diySidebar" aria-label="Materials list">
        <div class="sidebarInner">
          <div class="sidebarHead">What You'll Need</div>
          <ul class="materialList">
            {normMaterials.map((m) => (
              <li class="materialItem">
                <span class="materialDot" aria-hidden="true">✓</span>
                <span>{m}</span>
              </li>
            ))}
          </ul>
          <div class="sidebarFoot">
            <a class="sidebarCta" href={`/${city}/diy/`}>More DIY guides →</a>
          </div>
        </div>
      </aside>

    </div>{/* end .diyGrid */}
  </div>{/* end .container */}
</div>{/* end .diyWrap */}

<style>
  /* ── Container — scoped to .diyWrap so global containers are unaffected ── */
  :global(.diyWrap .container) {
    max-width: 1260px !important;
    margin: 0 auto !important;
    padding: 0 2rem !important;
  }
  @media (max-width: 768px) {
    :global(.diyWrap .container) { max-width: 100% !important; padding: 0 1.25rem !important; }
  }

  .diyWrap { min-height: 60vh; padding-bottom: 64px; }

  /* ── Hero Image — top of 75% main column ── */
  .diyHeroBanner {
    width: 100%; border-radius: 14px; overflow: hidden;
    max-height: 380px;
  }
  .diyHeroImg {
    display: block; width: 100%; height: 380px;
    object-fit: cover; object-position: center;
  }

  /* ── Header ── */
  .diyHeader {
    padding: 48px 0 32px;
    border-bottom: 2px solid var(--brand1);
    margin-bottom: 40px;
  }

  .diyKicker {
    display: flex; align-items: center; gap: 10px; margin-bottom: 14px;
  }
  .kPill {
    font-size: 10.5px; font-weight: 800; letter-spacing: .11em;
    text-transform: uppercase; padding: 3px 10px; border-radius: 999px;
  }
  .kCity { background: var(--brand1); color: var(--accentText, #000); }
  .kCat  {
    background: var(--pillBg); color: var(--brand1);
    border: 1px solid var(--pillBorder);
  }

  .diyTitle {
    font-size: clamp(26px, 3.8vw, 52px); font-weight: 800;
    font-family: 'Manrope', sans-serif;
    line-height: 1.06; letter-spacing: -0.02em; color: var(--text);
    margin: 0 0 18px; max-width: 820px;
  }

  .diyMeta {
    display: flex; align-items: center; gap: 8px;
    font-size: 13px; color: var(--faint);
  }
  .diyAuthor { font-weight: 700; color: var(--text); }
  .diyDot    { opacity: .45; }

  /* ── 75 / 25 Grid — 80px gap ── */
  .diyGrid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
    gap: 80px;
    align-items: start;
  }
  @media (max-width: 980px) {
    .diyGrid { grid-template-columns: 1fr; gap: 40px; }
    .diySidebar { order: -1; } /* materials above steps on mobile */
  }

  /* ── Main Column ── */
  .diyMain { display: grid; gap: 40px; }

  /* Intro */
  .diyIntro { display: grid; gap: 16px; }
  .diyPara  {
    font-size: clamp(16px, 1.2vw, 18px); color: var(--muted);
    font-family: 'Manrope', sans-serif; font-weight: 400;
    line-height: 1.72; margin: 0; max-width: 680px;
  }

  /* Steps — dark slate container */
  .diySteps {
    background: #1e293b;
    border-radius: 13px;
    padding: 1.75rem 2rem;
  }

  .sectionHead {
    font-size: 20px; font-weight: 900; letter-spacing: .06em;
    text-transform: uppercase; color: var(--text);
    margin: 0 0 24px; padding-bottom: 10px;
    border-bottom: 2px solid var(--brand1);
    font-family: 'Manrope', sans-serif;
  }
  .stepList  { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }

  .stepItem  {
    display: flex; align-items: flex-start; gap: 18px;
    padding: 12px 0; border-bottom: 1px solid rgba(255, 210, 74, 0.2);
  }
  .stepItem:last-child { border-bottom: none; }

  .stepNum {
    flex-shrink: 0; width: 44px; height: 44px; border-radius: 12px;
    background: var(--brand1); color: var(--accentText, #000);
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; font-weight: 900; letter-spacing: -0.5px;
    font-family: 'Manrope', sans-serif;
    margin-top: 2px;
  }

  .stepText  {
    font-size: 17px; color: #ffffff; line-height: 1.65; margin: 0;
    padding-top: 10px; font-family: 'Manrope', sans-serif;
  }

  /* Community Note blockquote */
  .communityNote {
    margin: 0; padding: 20px 22px;
    border-left: 4px solid var(--brand1);
    border-radius: 0 14px 14px 0;
    background: rgba(255, 210, 74, 0.07);
    display: grid; gap: 10px;
  }

  .cnLabel {
    display: flex; align-items: center; gap: 7px;
    font-size: 10px; font-weight: 900; letter-spacing: .12em;
    text-transform: uppercase; color: var(--brand1);
    line-height: 1;
  }
  .cnIcon  { font-size: 15px; line-height: 1; }
  .cnText  {
    margin: 0; font-size: 15px; color: var(--text);
    line-height: 1.65; font-style: italic;
  }

  /* ── 25% Sidebar — "Utility / Ad" look ── */
  .diySidebar { position: sticky; top: 80px; align-self: start; }

  .sidebarInner {
    background: rgba(255, 210, 74, 0.07);   /* soft brand-accent tint */
    border: 1.5px solid var(--brand1);
    border-radius: 16px;
    overflow: hidden;
  }

  .sidebarHead {
    padding: 16px 20px 14px;
    background: var(--brand1);
    color: var(--accentText, #000);
    font-size: 13px; font-weight: 900;
    letter-spacing: .1em; text-transform: uppercase;
  }

  .materialList  {
    list-style: none; margin: 0; padding: 16px 20px;
    display: grid; gap: 0;
  }
  .materialItem  {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 9px 0; border-bottom: 1px solid rgba(255,210,74,.15);
    font-size: 14px; color: var(--text); font-weight: 600; line-height: 1.4;
  }
  .materialItem:last-child { border-bottom: none; }
  .materialDot   { color: var(--brand1); font-size: 13px; flex-shrink: 0; margin-top: 2px; }

  .sidebarFoot {
    padding: 14px 20px;
    border-top: 1px solid rgba(255,210,74,.2);
    text-align: center;
  }
  .sidebarCta {
    font-size: 12.5px; font-weight: 800; color: var(--brand1);
    text-decoration: none; letter-spacing: .04em;
    transition: opacity 130ms;
  }
  .sidebarCta:hover { opacity: .75; text-decoration: underline; }

  /* ── Mobile adjustments ── */
  @media (max-width: 768px) {
    .diyHeader  { padding: 28px 0 24px; margin-bottom: 28px; }
    .diyTitle   { font-size: clamp(22px, 5vw, 36px); }
    .diyPara    { font-size: 16px; max-width: 100%; }
    .diySteps   { padding: 1.25rem 1.25rem; border-radius: 10px; }
    .stepText   { font-size: 15px; }
    .stepNum    { width: 38px; height: 38px; font-size: 17px; border-radius: 10px; }
    .diySidebar { position: static; }
    .diyHeroBanner { max-height: 220px; border-radius: 10px; }
    .diyHeroImg { height: 220px; }
  }
</style>
