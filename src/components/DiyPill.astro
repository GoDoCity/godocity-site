---
import { getCollection } from "astro:content";
import { getDisplayName } from "../lib/cityConfigs.js";

export interface Props {
  title:          string;
  intro:          string;
  materials:      string[];
  steps:          string[];
  community_note?: string;
  city?:          string;
  topic?:         string;
  author?:        string;
  pubDate?:       Date;
  heroImage?:     string;
}

const {
  title,
  intro,
  materials,
  steps,
  community_note,
  city,
  topic,
  author   = "Charles King",
  pubDate,
  heroImage,
} = Astro.props;

/* ── Normalise list fields ── */
const normMaterials: string[] = Array.isArray(materials)
  ? materials
  : String(materials).split("\n").map((s) => s.trim()).filter(Boolean);
const normSteps: string[] = Array.isArray(steps)
  ? steps
  : String(steps).split("\n").map((s) => s.trim()).filter(Boolean);

/* ── Intro: enforce ≤200 words, split into paragraphs ── */
const words   = intro.split(/\s+/).filter(Boolean);
const trimmed = words.length > 200 ? words.slice(0, 200).join(" ") + "…" : intro;
const paras   = trimmed.split(/\n\n+/).map((p) => p.trim()).filter(Boolean);
while (paras.length < 2) paras.push("");

const pubDateStr = pubDate
  ? new Date(pubDate).toLocaleDateString("en-US", { month: "long", year: "numeric" })
  : "";

const authorSlug = author
  ? author.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")
  : "";

/* ── City helpers ── */
const citySlug    = (city ?? "daytona").toLowerCase().trim();
const cityDisplay = getDisplayName(citySlug);

/* ── Upcoming events for sidebar ── */
const today = new Date(); today.setHours(0, 0, 0, 0);
let sidebarEvents: any[] = [];
try {
  const allEvents = await getCollection("events");
  sidebarEvents = allEvents
    .filter((e: any) => {
      const evCity = String(e.data.city ?? e.slug.split("/")[0]).toLowerCase().trim();
      const evDate = new Date(e.data.eventDate); evDate.setHours(0, 0, 0, 0);
      return evCity === citySlug && evDate >= today;
    })
    .sort((a: any, b: any) => new Date(a.data.eventDate).getTime() - new Date(b.data.eventDate).getTime())
    .slice(0, 3);
} catch { sidebarEvents = []; }

const eventsHref = `/${citySlug}/events/`;
---

<div class="diyWrap">
  <div class="diyContainer">

    {/* ── LEFT: main content column ── */}
    <div class="diyMain">

      {/* 1 — Headline + meta */}
      <header class="diyHeader">
        <div class="diyKicker">
          <span class="kPill kCat">DIY</span>
          {topic && <span class="kPill kTopic">{topic}</span>}
        </div>
        <h1 class="diyTitle">{title}</h1>
        {(author || pubDateStr) && (
          <div class="diyMeta">
            {author && (
              authorSlug
                ? <a class="diyAuthor diyAuthorLink" href={`/${citySlug}/journalists/${authorSlug}/`}>By {author}</a>
                : <span class="diyAuthor">By {author}</span>
            )}
            {author && pubDateStr && <span class="diyDot" aria-hidden="true">·</span>}
            {pubDateStr && <span class="diyDate">{pubDateStr}</span>}
          </div>
        )}
      </header>

      {/* 2 — Featured photo (16:9) */}
      {heroImage && (
        <div class="diyHeroBanner">
          <img class="diyHeroImg" src={heroImage} alt={title} loading="eager" decoding="async" />
        </div>
      )}

      {/* 3 — What You'll Need (materials) */}
      <section class="diyMaterials" aria-labelledby="materials-heading">
        <div class="diyBlockHead" id="materials-heading">
          <span class="diyBlockIcon" aria-hidden="true">🛒</span>
          What You'll Need
        </div>
        <ul class="materialGrid">
          {normMaterials.map((m) => (
            <li class="materialItem">
              <span class="materialCheck" aria-hidden="true">✓</span>
              <span>{m}</span>
            </li>
          ))}
        </ul>
      </section>

      {/* 4 — Intro / description */}
      <div class="diyIntro">
        {paras.map((p) => p && <p class="diyPara">{p}</p>)}
      </div>

      {/* 5 — Step-by-Step */}
      <section class="diySteps" aria-labelledby="steps-heading">
        <h2 class="sectionHead" id="steps-heading">Step-by-Step</h2>
        <ol class="stepList">
          {normSteps.map((step, i) => (
            <li class="stepItem">
              <div class="stepNum" aria-label={`Step ${i + 1}`}>{i + 1}</div>
              <p class="stepText">{step}</p>
            </li>
          ))}
        </ol>
      </section>

      {/* 6 — Community Notes */}
      {community_note && (
        <blockquote class="communityNote">
          <span class="cnLabel" aria-label="Community Note">
            <span class="cnIcon" aria-hidden="true">💬</span>
            Community Note
          </span>
          <p class="cnText">{community_note}</p>
        </blockquote>
      )}

      <div class="diyFootNav">
        <a class="diyFootLink" href="/diy/">← More DIY guides</a>
      </div>

    </div>{/* /.diyMain */}

    {/* ── RIGHT: sidebar ── */}
    <aside class="diySidebar">

      {/* 1 — Newsletter banner (matches Guide sidebar exactly) */}
      <div class="diyNl">
        <div class="diyNlHead">
          <em>Good News <strong>{cityDisplay}!</strong></em>
        </div>
        <div class="diyNlSub">Free local stories, every morning.</div>
        <form class="diyNlForm" action={`/${citySlug}/subscribe/`} method="get">
          <input
            class="diyNlInput"
            type="email"
            name="email"
            placeholder="your@email.com"
            required
            autocomplete="email"
          />
          <button class="diyNlBtn" type="submit">SIGN UP</button>
        </form>
      </div>

      {/* 2 — Upcoming Events */}
      <div class="sideSection">
        <div class="sideSectionHead">
          <span class="sideSectionTitle">Upcoming Events</span>
          <a class="sideSectionMore" href={eventsHref}>See all</a>
        </div>
        {sidebarEvents.length > 0 ? (
          <div class="evList">
            {sidebarEvents.map((e: any) => {
              const d   = new Date(e.data.eventDate);
              const dow = d.toLocaleDateString("en-US", { weekday: "short" }).toUpperCase();
              const day = d.getDate();
              const mon = d.toLocaleDateString("en-US", { month: "short" }).toUpperCase();
              const evSlug = e.slug.split("/").pop();
              return (
                <a class="evRow"
                   href={e.data.url ?? `/${citySlug}/events/${evSlug}/`}
                   target={e.data.url ? "_blank" : "_self"}
                   rel={e.data.url ? "noopener" : ""}>
                  <div class="evCal">
                    <div class="evDow">{dow}</div>
                    <div class="evDay">{day}</div>
                    <div class="evMon">{mon}</div>
                  </div>
                  <div class="evInfo">
                    <div class="evName">{e.data.title}</div>
                    <div class="evPlace">{e.data.location}</div>
                  </div>
                </a>
              );
            })}
          </div>
        ) : (
          <p class="noEvents">No upcoming events — check back soon.</p>
        )}
        <a class="submitEv" href="/submit-event/">+ Submit an event →</a>
      </div>

      {/* 3 — Ad slot */}
      <div class="sideSection adSection">
        <div class="adLabel">Advertisement</div>
        <div class="adSlot" aria-label="Advertisement placeholder">
          <span class="adSlotText">Your Ad Here</span>
          <a class="adCta" href={`/${citySlug}/advertise/`}>Learn more →</a>
        </div>
      </div>

      {/* 4 — Vibe Check */}
      <div class="sideSection vibeSection">
        <div class="sideSectionHead">
          <span class="sideSectionTitle">Vibe Check</span>
        </div>
        <p class="vibeText">Got a suggestion, tip, or local story? We want to hear it.</p>
        <a class="vibeBtn" href={`/${citySlug}/contact/`}>Contact Us →</a>
      </div>

    </aside>

  </div>{/* /.diyContainer */}
</div>

<style>
  /* ── Wrapper: extra top clearance below fixed nav ── */
  .diyWrap { min-height: 60vh; padding: 40px 0 64px; }

  /* ── Two-column grid: 4:1 up to 1440px ── */
  .diyContainer {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: 4fr 1fr;
    gap: 52px;
    align-items: start;
  }
  @media (max-width: 1060px) {
    .diyContainer { grid-template-columns: 3fr 1fr; gap: 40px; }
  }
  @media (max-width: 900px) {
    .diyContainer { grid-template-columns: 1fr; gap: 40px; }
  }
  @media (max-width: 600px) {
    .diyContainer { padding: 0 1rem; }
  }

  /* ── 1 — Header ── */
  .diyHeader {
    padding: 12px 0 32px;
    border-bottom: 2px solid var(--brand1);
    margin-bottom: 36px;
  }
  .diyKicker { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
  .kPill {
    font-size: 10.5px; font-weight: 800; letter-spacing: .11em;
    text-transform: uppercase; padding: 3px 10px; border-radius: 999px;
  }
  .kCat { background: var(--pillBg); color: var(--brand1); border: 1px solid var(--pillBorder); }
  .kTopic {
    background: rgba(255,210,74,.12); color: var(--brand1);
    border: 1px solid rgba(255,210,74,.35);
  }
  .diyTitle {
    font-size: clamp(26px, 3.8vw, 48px);
    font-weight: 900;
    font-family: 'Manrope', sans-serif;
    line-height: 1.06; letter-spacing: -0.02em; color: var(--text);
    margin: 0 0 18px;
  }
  .diyMeta { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--faint); }
  .diyAuthor { font-weight: 700; color: var(--text); }
  .diyAuthorLink {
    text-decoration: underline; text-decoration-color: transparent;
    text-underline-offset: 2px; transition: color 130ms, text-decoration-color 130ms;
  }
  .diyAuthorLink:hover { color: var(--brand1); text-decoration-color: var(--brand1); }
  .diyDot { opacity: .45; }

  /* ── 2 — Hero image 16:9, no stretch ── */
  .diyHeroBanner {
    width: 100%; border-radius: 14px; overflow: hidden;
    aspect-ratio: 16 / 9; margin-bottom: 36px;
    background: var(--surface2, #1a1f2e);
  }
  .diyHeroImg {
    display: block; width: 100%; height: 100%;
    object-fit: cover; object-position: center;
  }

  /* ── 3 — Materials: full left-column width with accent bg ── */
  .diyMaterials {
    width: 100%;
    border: 1.5px solid var(--brand1);
    border-radius: 13px; overflow: hidden;
    margin-bottom: 36px;
  }
  .diyBlockHead {
    display: flex; align-items: center; gap: 10px;
    background: #1e293b; color: #fff;
    font-size: 13px; font-weight: 900; letter-spacing: .1em;
    text-transform: uppercase; padding: 16px 20px; margin: 0;
  }
  .diyBlockIcon { font-size: 16px; line-height: 1; }
  .materialGrid {
    list-style: none; margin: 0;
    padding: 12px 20px 16px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 24px;
    background: rgba(255,210,74,.08);
  }
  @media (max-width: 540px) { .materialGrid { grid-template-columns: 1fr; } }
  .materialItem {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 9px 0; border-bottom: 1px solid rgba(255,210,74,.18);
    font-size: 14px; color: var(--text); font-weight: 600; line-height: 1.4;
  }
  .materialItem:last-child { border-bottom: none; }
  .materialCheck { color: var(--brand1); font-size: 13px; flex-shrink: 0; margin-top: 2px; }

  /* ── 4 — Intro ── */
  .diyIntro { display: grid; gap: 16px; margin-bottom: 36px; }
  .diyPara {
    font-size: clamp(16px, 1.2vw, 18px); color: var(--muted);
    font-family: 'Manrope', sans-serif; font-weight: 400;
    line-height: 1.72; margin: 0;
  }

  /* ── 5 — Steps ── */
  .diySteps {
    background: rgba(255,210,74,.07);
    border: 1.5px solid var(--brand1);
    border-radius: 13px; padding: 0; overflow: hidden;
    margin-bottom: 36px;
  }
  .sectionHead {
    background: #1e293b; color: #fff;
    font-size: 13px; font-weight: 900; letter-spacing: .1em;
    text-transform: uppercase; font-family: 'Manrope', sans-serif;
    padding: 16px 20px; margin: 0;
  }
  .stepList { list-style: none; margin: 0; padding: 8px 20px 4px; display: grid; gap: 0; }
  .stepItem {
    display: flex; align-items: flex-start; gap: 18px;
    padding: 12px 0; border-bottom: 1px solid rgba(255,210,74,.2);
  }
  .stepItem:last-child { border-bottom: none; }
  .stepNum {
    flex-shrink: 0; width: 44px; height: 44px; border-radius: 12px;
    background: var(--brand1); color: var(--accentText, #000);
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; font-weight: 900; letter-spacing: -0.5px;
    font-family: 'Manrope', sans-serif; margin-top: 2px;
  }
  .stepText {
    font-size: 17px; color: var(--text); line-height: 1.65; margin: 0;
    padding-top: 10px; font-family: 'Manrope', sans-serif;
  }

  /* ── 6 — Community Note ── */
  .communityNote {
    margin: 0 0 36px; padding: 0;
    border: 1.5px solid var(--brand1); border-radius: 13px;
    background: rgba(255,210,74,.07); overflow: hidden; display: block;
  }
  .cnLabel {
    display: flex; align-items: center; gap: 7px;
    background: #1e293b; color: #fff;
    font-size: 10px; font-weight: 900; letter-spacing: .12em;
    text-transform: uppercase; line-height: 1; padding: 16px 20px;
  }
  .cnIcon { font-size: 15px; line-height: 1; }
  .cnText {
    margin: 0; padding: 16px 20px;
    font-size: 15px; color: var(--text); line-height: 1.65; font-style: italic;
  }

  /* Footer nav */
  .diyFootNav { padding: 8px 0 16px; }
  .diyFootLink {
    font-size: 13px; font-weight: 700; color: var(--brand1);
    text-decoration: none; transition: opacity 130ms;
  }
  .diyFootLink:hover { opacity: .75; text-decoration: underline; }

  /* ══════════════════════════════════════════
     SIDEBAR
  ══════════════════════════════════════════ */
  .diySidebar {
    display: flex;
    flex-direction: column;
    gap: 28px;
    position: sticky;
    top: 90px;
    align-self: start;
  }
  @media (max-width: 900px) {
    .diySidebar { position: static; gap: 24px; }
  }

  /* ── Newsletter banner (identical to GuideLayout .gl-nl) ── */
  .diyNl {
    position: relative;
    background: var(--theme-gradient);
    border-radius: 16px;
    padding: 28px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow: hidden;
  }
  .diyNl::after {
    content: '';
    position: absolute; top: 0; left: 0;
    width: 100%; height: 100%;
    background-image: url('/images/geometric-pattern-master.svg');
    background-repeat: repeat;
    background-size: 150px 150px;
    opacity: 0.3;
    pointer-events: none;
  }
  .diyNlHead {
    font-size: 1.75rem; font-weight: 900; font-style: italic;
    color: white; line-height: 1.1; letter-spacing: -0.04em;
  }
  .diyNlHead strong { font-weight: 900; }
  .diyNlSub { font-size: 13.5px; color: rgba(255,255,255,.85); line-height: 1.4; }
  .diyNlForm { display: flex; flex-direction: column; gap: 8px; margin-top: 4px; }
  .diyNlInput {
    width: 100%; box-sizing: border-box;
    padding: 12px 14px; border-radius: 10px;
    border: none; background: white;
    font-size: 14px; color: var(--text-primary);
    box-shadow: 0 2px 8px rgba(0,0,0,.12);
    outline: 2px solid transparent; transition: outline-color 150ms;
  }
  .diyNlInput:focus { outline-color: var(--text-primary); }
  .diyNlInput::placeholder { color: var(--muted); }
  .diyNlBtn {
    width: 100%; padding: 12px 0;
    border-radius: 999px; border: none;
    background: #ffffff !important;
    color: #0077be !important;
    font-family: "Century Gothic", AppleGothic, Arial, sans-serif;
    font-size: 14px; font-weight: 900; letter-spacing: .1em;
    cursor: pointer; box-sizing: border-box;
    transition: opacity 150ms;
  }
  .diyNlBtn:hover { opacity: .82; }

  /* ── Generic sidebar section ── */
  .sideSection {
    display: grid;
    gap: 0;
  }
  .sideSectionHead {
    display: flex; justify-content: space-between; align-items: baseline;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--theme-accent, var(--brand1));
    margin-bottom: 0;
  }
  .sideSectionTitle {
    font-size: 14px; font-weight: 900;
    letter-spacing: .08em; text-transform: uppercase; color: var(--text);
  }
  .sideSectionMore {
    font-size: 12px; font-weight: 700; color: var(--text);
    text-decoration: none;
  }
  .sideSectionMore:hover { text-decoration: underline; }

  /* Events list */
  .evList { display: grid; }
  .evRow {
    display: grid; grid-template-columns: 48px 1fr;
    gap: 10px; align-items: center;
    text-decoration: none;
    padding: 11px 0;
    border-bottom: 1px solid var(--border, rgba(255,255,255,.10));
    transition: opacity 140ms;
  }
  .evRow:last-child { border-bottom: none; }
  .evRow:hover { opacity: .76; }
  .evCal {
    width: 48px; height: 48px; border-radius: 10px;
    background: transparent;
    border: 1px solid var(--brand1);
    display: grid; place-items: center;
    text-align: center; line-height: 1;
  }
  .evDow { font-size: 10px; font-weight: 900; letter-spacing: .08em; color: var(--brand1); }
  .evDay { font-size: 19px; font-weight: 900; color: var(--brand1); margin-top: 1px; }
  .evMon { font-size: 8px; font-weight: 700; letter-spacing: .08em; color: var(--brand1); text-transform: uppercase; }
  .evInfo { display: flex; flex-direction: column; gap: 2px; }
  .evName { font-weight: 800; font-size: 13px; color: var(--text); line-height: 1.25; }
  .evPlace { font-size: 11px; color: var(--faint); }
  .noEvents { font-size: 12px; color: var(--faint); padding: 10px 0; margin: 0; }
  .submitEv {
    display: block; margin-top: 10px;
    font-size: 12px; font-weight: 700;
    color: var(--muted); text-decoration: none;
    opacity: .85; transition: opacity 120ms;
  }
  .submitEv:hover { opacity: 1; }

  /* Ad slot */
  .adSection { }
  .adLabel {
    font-size: 9px; font-weight: 700; letter-spacing: .12em;
    text-transform: uppercase; color: var(--faint); margin-bottom: 8px;
  }
  .adSlot {
    border: 1.5px dashed rgba(255,255,255,.15);
    border-radius: 10px; min-height: 140px;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 8px;
    background: rgba(255,255,255,.015);
  }
  .adSlotText { font-size: 12px; color: var(--faint); font-weight: 700; }
  .adCta {
    font-size: 11.5px; font-weight: 800; color: var(--brand1);
    text-decoration: none; letter-spacing: .02em;
    border: 1px solid color-mix(in srgb, var(--brand1) 40%, transparent);
    padding: 5px 12px; border-radius: 999px;
    transition: background 140ms;
  }
  .adCta:hover { background: color-mix(in srgb, var(--brand1) 14%, transparent); }

  /* Vibe Check */
  .vibeText { font-size: 13.5px; color: var(--muted); line-height: 1.5; margin: 10px 0 12px; }
  .vibeBtn {
    display: inline-flex; align-items: center;
    font-size: 13px; font-weight: 800; color: var(--brand1);
    border: 1px solid color-mix(in srgb, var(--brand1) 45%, transparent);
    border-radius: 999px; padding: 7px 14px;
    text-decoration: none; transition: background 140ms;
  }
  .vibeBtn:hover { background: color-mix(in srgb, var(--brand1) 12%, transparent); }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .diyWrap    { padding-top: 24px; }
    .diyHeader  { padding: 12px 0 24px; margin-bottom: 24px; }
    .diyTitle   { font-size: clamp(22px, 5vw, 36px); }
    .diyPara    { font-size: 16px; }
    .diySteps, .diyMaterials, .communityNote { border-radius: 10px; }
    .stepList   { padding: 6px 14px 2px; }
    .stepText   { font-size: 15px; }
    .stepNum    { width: 38px; height: 38px; font-size: 17px; border-radius: 10px; }
    .diyHeroBanner { border-radius: 10px; margin-bottom: 24px; }
  }
</style>
