---
export interface MapLocation {
  label: string;
  address?: string;
  lat?: number;
  lng?: number;
  articleHref?: string;
  articleTitle?: string;
}

export interface Props {
  locations: MapLocation[];
  height?: string;
}

const { locations = [], height = "360px" } = Astro.props;

/* Filter to only pins that have coordinates */
const pins = locations.filter((l) => l.lat != null && l.lng != null);

if (pins.length === 0) return;

/* Unique ID so multiple maps on a page don't collide */
const mapId = `imap-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="imapWrap" style={`height: ${height}`}>
  <div id={mapId} class="imapEl"></div>
</div>

<!-- Leaflet CSS -->
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<script define:vars={{ mapId, pins }}>
  (function () {
    function initMap() {
      const CartoDB = "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png";
      const attribution =
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/">CARTO</a>';

      const container = document.getElementById(mapId);
      if (!container || typeof window.L === "undefined") return;
      if (container._leaflet_id) return;

      const map = window.L.map(mapId, { scrollWheelZoom: false, zoomControl: true });

      window.L.tileLayer(CartoDB, {
        attribution,
        subdomains: "abcd",
        maxZoom: 19,
      }).addTo(map);

      /* ── Custom yellow pin ── */
      const yellowPin = window.L.divIcon({
        className: "",
        html: `<div class="imap-pin" aria-hidden="true"></div>`,
        iconSize: [22, 22],
        iconAnchor: [11, 11],
        popupAnchor: [0, -14],
      });

      /* ── Add markers ── */
      const bounds = [];
      pins.forEach((pin) => {
        const latlng = [pin.lat, pin.lng];
        bounds.push(latlng);

        /* Build popup: label + optional address + optional "Read Guide" link */
        let popup = `<strong style="font-size:14px;">${pin.label}</strong>`;
        if (pin.address) {
          popup += `<br><span style="font-size:12px;color:#666;line-height:1.4;">${pin.address}</span>`;
        }
        if (pin.articleHref) {
          const linkLabel = pin.articleTitle
            ? `Read: ${pin.articleTitle}`
            : "Read Guide →";
          popup += `<br><a href="${pin.articleHref}"
            style="display:inline-block;margin-top:8px;font-size:12.5px;font-weight:700;
                   color:#000;background:#f9d900;padding:4px 10px;border-radius:6px;
                   text-decoration:none;line-height:1.4;"
            >${linkLabel}</a>`;
        }

        window.L.marker(latlng, { icon: yellowPin })
          .bindPopup(popup, { maxWidth: 240 })
          .addTo(map);
      });

      /* ── Fit map to show all pins ── */
      if (bounds.length === 1) {
        map.setView(bounds[0], 15);
      } else {
        map.fitBounds(bounds, { padding: [36, 36] });
      }
    }

    if (typeof window.L !== "undefined") {
      initMap();
    } else {
      const script = document.createElement("script");
      script.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
      script.integrity = "sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV/XN/sp38=";
      script.crossOrigin = "";
      script.onload = initMap;
      document.head.appendChild(script);
    }
  })();
</script>

<style>
  .imapWrap {
    width: 100%;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.10);
    margin: 0 0 28px;
    position: relative;
  }

  .imapEl {
    width: 100%;
    height: 100%;
  }

  :global(.imap-pin) {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #f9d900;
    border: 3px solid #000;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
    transition: transform 120ms ease;
  }

  :global(.leaflet-marker-icon:hover .imap-pin) {
    transform: scale(1.25);
  }

  :global(.leaflet-popup-content-wrapper) {
    border-radius: 10px !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.18) !important;
    font-family: inherit !important;
    padding: 4px 2px !important;
  }

  :global(.leaflet-popup-content) {
    margin: 10px 14px !important;
    font-size: 13.5px !important;
    line-height: 1.45 !important;
  }

  :global(.leaflet-popup-tip) {
    box-shadow: none !important;
  }

  :global(.leaflet-container:focus) {
    outline: none;
  }
</style>
