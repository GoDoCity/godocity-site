---
/**
 * src/components/LegalDisclaimer.astro
 * Advertiser policy / legal disclosure block.
 * Used in the footer of /daytona/advertise/ and linked from every AdSlot.
 * Must include id="ad-policy" so AdSlot's "Advertiser Disclosure" links work.
 */
---

<section class="legalDisclaimer" id="ad-policy" aria-labelledby="ldHeading">
  <p class="ldEyebrow" id="ldHeading">Advertiser Policy</p>
  <div class="ldGrid">

    <div class="ldItem">
      <div class="ldIconWrap" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M9 2L3 6v9h4v-5h4v5h4V6L9 2z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
        </svg>
      </div>
      <h3 class="ldItemTitle">Editorial Independence</h3>
      <p class="ldItemText">GoDo City maintains full editorial control over all content. Sponsored and branded content is clearly labeled. Our editorial team's opinions and coverage are never influenced by advertising relationships.</p>
    </div>

    <div class="ldItem">
      <div class="ldIconWrap" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M9 1L2 4v5c0 4.55 3.05 8.74 7 9.93C13 17.74 16 13.55 16 9V4L9 1z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
          <path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <h3 class="ldItemTitle">Right to Refuse</h3>
      <p class="ldItemText">GoDo City reserves the right to refuse, cancel, or remove any advertisement at our sole discretion. We do not accept ads that are misleading, deceptive, or inconsistent with our community standards.</p>
    </div>

    <div class="ldItem">
      <div class="ldIconWrap" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 14l4-8 3 5 2-3 3 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M1 17h16" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity=".4"/>
        </svg>
      </div>
      <h3 class="ldItemTitle">No Guaranteed ROI</h3>
      <p class="ldItemText">Advertising results vary based on market conditions, creative quality, and audience behavior. GoDo City makes no guarantee of specific traffic volumes, leads, sales, or return on investment from any placement.</p>
    </div>

  </div>
  <p class="ldNote">
    All advertising relationships are disclosed in accordance with FTC guidelines.
    Questions? Email <a href="mailto:ads@godocity.com">ads@godocity.com</a>
  </p>
</section>

<style>
  .legalDisclaimer {
    padding: 40px 0 24px;
    border-top: 1px solid var(--border, #e5e7eb);
  }

  .ldEyebrow {
    font-size: 10px; font-weight: 900; letter-spacing: .16em;
    text-transform: uppercase; color: var(--faint, #999);
    margin: 0 0 24px;
  }

  .ldGrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-bottom: 20px;
  }
  @media (max-width: 720px) { .ldGrid { grid-template-columns: 1fr; gap: 18px; } }

  .ldItem { display: flex; flex-direction: column; gap: 7px; }

  .ldIconWrap {
    width: 34px; height: 34px; border-radius: 9px;
    background: color-mix(in srgb, var(--brand1, #0077be) 10%, transparent);
    color: var(--brand1, #0077be);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; margin-bottom: 2px;
  }

  .ldItemTitle {
    font-size: 13px; font-weight: 800;
    color: var(--text, #111); margin: 0;
  }

  .ldItemText {
    font-size: 12.5px; line-height: 1.65;
    color: var(--faint, #666); margin: 0;
  }

  .ldNote {
    font-size: 12px; line-height: 1.6;
    color: var(--faint, #999); margin: 0;
    padding-top: 16px;
    border-top: 1px solid var(--border, #f0f0f0);
  }
  .ldNote a {
    color: var(--brand1, #0077be);
    text-decoration: underline; text-underline-offset: 2px;
  }
</style>
